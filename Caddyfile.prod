# Point d'entrée UNIQUE de la stack Memory Line — PRODUCTION.
#
# Même routage qu'en développement, pour que ce qui marche en local marche
# aussi en ligne :
#
#   /api/*  -> API Hono      préfixe RETIRÉ  (l'API ne connaît pas /api)
#   /bo/*   -> back-office   préfixe GARDÉ   (Astro est servi avec base=/bo)
#   /*      -> site public
#
# La différence tient en une ligne : le nom de domaine remplace « :80 ». Caddy
# demande alors le certificat à Let's Encrypt tout seul, le renouvelle tout
# seul, et redirige http vers https tout seul. Rien à installer, rien à
# programmer dans une tâche planifiée.

{
	admin off
	# L'adresse qui reçoit les avertissements d'expiration de certificat. Le
	# renouvellement est automatique ; ce courriel sert le jour où il échoue.
	email {$COURRIEL_TLS}
}

# {$DOMAINE_WWW} : le nom en « www. », FACULTATIF.
#
# memoryline.fr est aujourd'hui joignable aussi en www.memoryline.fr (Shopify
# le redirige vers le domaine nu) : des liens et des favoris portent cette
# forme. Le jour de la bascule, DOMAINE_WWW=www.memoryline.fr dans le .env
# fait demander à Caddy un certificat pour ce nom aussi, et la règle « @www »
# ci-dessous le renvoie, en 301 et en un seul saut, vers la même adresse sur
# le domaine nu — chemin et requête compris.
#
# Absente ou vide (le serveur de test), la variable disparaît de la ligne :
# Caddy ne sert et ne certifie que {$DOMAINE}, exactement comme avant, et la
# règle « @www » ne peut rien attraper. Vérifié avec `caddy adapt` dans les
# deux cas. Ne la remplir qu'une fois l'enregistrement DNS « www » pointé vers
# ce serveur : sinon Caddy redemanderait le certificat en boucle.
{$DOMAINE} {$DOMAINE_WWW} {
	@www not host {$DOMAINE}
	redir @www https://{$DOMAINE}{uri} permanent

	# Compression : la liste des affiches passe de 316 Ko à 25 Ko de HTML.
	encode zstd gzip

	# En-têtes de sécurité, posés une fois pour les trois applications.
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Le navigateur refuse de revenir en clair pendant six mois. À ne
		# mettre qu'une fois le certificat en place et le site accessible :
		# revenir en arrière ensuite demande d'attendre l'expiration.
		Strict-Transport-Security "max-age=15552000"
		-Server
	}

	# Aucune page ne s'affiche dans le cadre d'un autre site (frame-ancestors
	# 'none')… sauf le module de personnalisation du back-office (20/11,
	# BO › Affiches IA › « Créer une affiche ») : le back-office l'ouvre dans
	# une fenêtre, depuis CE domaine seulement ('self'). Deux règles qui ne se
	# recouvrent pas, plutôt qu'une règle générale qu'une autre écraserait :
	# deux en-têtes CSP envoyés ensemble s'appliquent TOUS LES DEUX, et le
	# plus strict gagnerait.
	@encadrableParLeBo path /atelier-affiche
	header @encadrableParLeBo Content-Security-Policy "frame-ancestors 'self'"
	@nonEncadrable not path /atelier-affiche
	header @nonEncadrable Content-Security-Policy "frame-ancestors 'none'"

	# --- Ce que le navigateur a le droit de garder -----------------------
	#
	# Sans en-tête de cache, un navigateur décide TOUT SEUL combien de temps
	# garder une page. Chrome s'autorise alors à resservir la sienne pendant
	# toute la session : on déploie un correctif, le site le sert, et la
	# visiteuse continue de voir l'ancienne version sans comprendre pourquoi.
	# C'est arrivé, et c'est ce que ces deux règles évitent.
	#
	# « no-cache » ne veut pas dire « ne garde rien » : le navigateur garde la
	# page mais demande au serveur si elle a changé avant de la réafficher.
	# Une page inchangée coûte alors un aller-retour de quelques octets.
	@pages not path /api/* /_astro/* /fonts/* /*.png /*.ico /*.svg
	header @pages Cache-Control "no-cache"

	# Les fichiers construits par Astro portent une empreinte dans leur nom :
	# un contenu qui change change aussi d'adresse. Ceux-là peuvent être
	# gardés un an sans risque, et c'est autant de moins à retélécharger. Le
	# logo de l'en-tête en fait partie (src/assets, voir Base.astro).
	@construits path /_astro/*
	header @construits Cache-Control "public, max-age=31536000, immutable"

	# Les fichiers fixes du site (apps/web/public) : les polices des
	# affiches, les icônes, l'image de partage, le logo d'origine. Ils
	# tombaient sous la règle des pages : à chaque page, le navigateur
	# redemandait au serveur si les 1,6 Mo de polices avaient changé.
	#
	# Une semaine, et pas un an : leur nom NE change PAS quand on les
	# remplace — la police « Another Shabby » sous licence gardera le sien
	# le jour où elle sera achetée. Un fichier remplacé met donc au plus huit jours
	# à atteindre tout le monde ; c'est sans conséquence pour une police ou
	# une icône, et c'est la seule raison de ne pas les garder plus longtemps.
	# (Une de ces adresses qui manquerait au serveur répond 404 pour la même
	# semaine : déposer le fichier AVANT de mettre en ligne la page qui le
	# demande, comme on le fait déjà.)
	#
	# « /*.png » ne désigne que les fichiers posés à la racine du site : les
	# visuels de l'API (/api/assets/…), qui ont leurs propres règles, et le
	# back-office (/bo/…) n'en sont pas. `defer` : le site envoie lui-même
	# « public, max-age=0 » pour ces fichiers ; sans `defer`, les deux
	# en-têtes partaient ensemble et se contredisaient.
	@statiques path /fonts/* /*.png /*.ico /*.svg
	header @statiques {
		Cache-Control "public, max-age=604800"
		defer
	}

	# --- Page de maintenance pendant une mise en ligne ----------------------
	#
	# Demande d'Alexandra (8/11) : « une page de maintenance pendant qu'on
	# commence une mise en prod, et quand on l'a finie ça remet le site ».
	# mettre-en-ligne.sh pose le fichier maintenance/ACTIVE en commençant et
	# le retire en finissant — même si la mise en ligne échoue. Tant qu'il
	# existe, les visiteuses voient maintenance/index.html (qui se recharge
	# seule toutes les 30 s), en 503 avec « Retry-After » : Google comprend
	# que c'est passager et ne retire aucune page de son index.
	#
	# Ni l'API (le webhook de Stripe, le retour d'un paiement) ni le
	# back-office n'y passent : ils continuent de répondre tant que leur
	# service tourne, et la boutique peut vérifier son BO juste après.
	@enMaintenance {
		file {
			root /srv/maintenance
			try_files /ACTIVE
		}
		not path /api/* /bo /bo/*
	}
	handle @enMaintenance {
		root * /srv/maintenance
		rewrite * /index.html
		header Cache-Control "no-store"
		header Retry-After "120"
		file_server {
			status 503
		}
	}

	handle_path /api/* {
		reverse_proxy api:3000
	}

	redir /bo /bo/

	handle /bo/* {
		reverse_proxy admin:4322
	}

	handle {
		reverse_proxy web:4321
	}
}
