# Point d'entrée UNIQUE de la stack Memory Line.
#
# Un seul hôte sert les trois services, séparés par le chemin (choix retenu
# pour l'environnement de test) :
#
#   /api/*  -> API Hono      préfixe RETIRÉ  (l'API ne connaît pas /api)
#   /bo/*   -> back-office   préfixe GARDÉ   (Astro est servi avec base=/bo)
#   /*      -> site public
#
# En local : http://localhost:8080. Derrière le tunnel Cloudflare : le même
# routage, cloudflared ne parlant qu'à ce proxy. Les deux chemins sont donc
# identiques, ce qui évite les surprises entre local et ligne.

{
	admin off
	auto_https off

	# Le tunnel termine le TLS et annonce le schéma d'origine dans
	# X-Forwarded-Proto. Sans cette ligne, Caddy ne fait pas confiance au
	# proxy amont et réécrit l'en-tête en « http » : les applications
	# derrière croient alors servir une page en clair, et posent leurs
	# cookies sans l'attribut Secure. Seul le tunnel nous parle.
	servers {
		trusted_proxies static private_ranges
	}
}

:80 {
	# Compression, et c'est la correction la moins chère de tout le projet.
	# Sans elle, la liste des affiches partait en 316 Ko de HTML ; compressée,
	# elle en fait 25. Le JSON de l'API en profite autant. Les images, déjà
	# compressées dans leur format, sont laissées tranquilles par Caddy.
	encode zstd gzip

	# En-têtes de sécurité, posés une fois pour les trois applications.
	# « frame-ancestors 'none' » empêche qu'un autre site encadre le
	# back-office pour faire cliquer quelqu'un sur « rembourser » sans qu'il
	# le voie. « Referrer-Policy » évite que l'adresse du stand, qui porte son
	# code d'accès, parte dans l'en-tête du premier lien sortant.
	header {
		Content-Security-Policy "frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	handle_path /api/* {
		reverse_proxy api:3000
	}

	# LE BACK-OFFICE, EN DÉVELOPPEMENT, VIT SUR SON PROPRE PORT.
	#
	# Ses pages étaient servies ici sous « /bo », mais Astro réclame ses
	# fichiers à la racine (« /src/… ») et un fichier qui en appelle un autre
	# ne dit pas de quelle page il vient : impossible, ici, de savoir s'ils
	# sont pour la boutique ou pour le back-office. Ils partaient donc à la
	# boutique, qui ne les connaît pas (« No cached compile metadata found »).
	#
	# On renvoie donc le back-office vers son serveur, où pages, fichiers et
	# API sont sur la même adresse. En ligne, rien de tout cela : les fichiers
	# du back-office y sont construits avec leur préfixe.
	redir /bo http://localhost:4322/bo/
	redir /bo/* http://localhost:4322{uri}

	handle {
		reverse_proxy web:4321
	}
}
