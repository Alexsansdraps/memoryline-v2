# Dockerfile DEV pour l'API (hot-reload via tsx watch).
# Contexte de build = racine du monorepo (pnpm workspace).
FROM node:24-alpine

# pnpm via corepack (version épinglée par le champ packageManager du package.json racine)
RUN corepack enable

# Polices de la charte — mêmes que l'image de production (cf. Dockerfile).
# sharp rend le titre et le sous-titre de l'affiche avec les polices SYSTÈME :
# sans elles, les PDF de recette sortent dans une police de repli, et ce qu'on
# montre à la cliente ne correspond pas à ce qui sera imprimé.
RUN apk add --no-cache fontconfig
COPY apps/api/fonts/ /usr/share/fonts/memoryline/
RUN fc-cache -f

WORKDIR /app

# 1) Manifests d'abord pour profiter du cache de couches Docker.
#    On copie les package.json du workspace utilisés par l'API.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/package.json
COPY packages/types/package.json packages/types/package.json

# 2) Installe toutes les deps du workspace (dev incluses : tsx, drizzle-kit…).
RUN pnpm install --frozen-lockfile

# 3) Le code source est monté en volume au runtime (cf. docker-compose).
#    On expose le port de l'API.
EXPOSE 3000

# Démarre l'API en watch (hot-reload). Le code vient du volume monté.
# Au démarrage, les dépendances sont d'abord remises en accord avec le
# lockfile. Les node_modules vivent dans des volumes anonymes (cf.
# docker-compose.yml), et Docker les REPREND d'un conteneur au suivant,
# même après une reconstruction de l'image : un vieux volume masquait alors
# les dépendances neuves (« tsx: not found », « Failed to resolve import
# @memoryline/types »). Quand rien n'a changé, c'est « Already up to date »
# en une seconde ; le magasin pnpm est dans le dépôt monté (.pnpm-store).
# Le filtre « ... » installe ce paquet ET ses dépendances du workspace, et
# rien d'autre : les node_modules des autres applis sont sur le disque de
# l'hôte, et ce n'est pas à ce conteneur d'y écrire.
CMD ["sh", "-c", "pnpm install --frozen-lockfile --prefer-offline --filter @memoryline/api... && exec pnpm --filter @memoryline/api run dev"]
