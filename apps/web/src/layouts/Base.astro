            {tr("pied.credit.avant")} <span class="text-terracotta">♥</span>
            {tr("pied.credit.apres")}{" "}
            <a
              href="https://alexandraporhansl.com"
              target="_blank"
              rel="noopener"
              class="underline-offset-2 transition-colors hover:text-terracotta hover:underline"
