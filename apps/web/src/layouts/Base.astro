---
import { apiInterne } from "../lib/api-interne.ts";
import "../styles/global.css";
import Seo from "../components/Seo.astro";
import AnnouncementBanner from "../components/AnnouncementBanner.astro";
import CookieBanner from "../components/CookieBanner.astro";
import CartBadge from "../islands/CartBadge.tsx";
import {
  LANGUE_DEFAUT,
  autresVersions,
  cheminSansLangue,
  lien,
  t,
  type Langue,
} from "../i18n/utils.ts";
import { api, instagramDeLaBoutique, type EntreeMenuPublique } from "../lib/api.ts";
import { languesDuContenu } from "../lib/referencement.ts";
/*
 * Le logo de l'en-tête et du pied, à la taille où il s'affiche.
 *
 * C'était l'original, 500 × 222 et 48 Ko, pour 108 × 48 px à l'écran : la
 * plus grosse image de l'en-tête, sur chaque page. Celui-ci fait 324 × 144
 * (trois fois la hauteur de l'en-tête, pour les écrans de densité 3), en
 * PNG à palette : 3,7 Ko, sans différence visible (écart moyen de 0,4 sur
 * 255 au bord des lettres). Importé plutôt que posé dans public/, il sort de
 * la construction sous un nom à empreinte (/_astro/…) : le proxy le laisse
 * garder un an, et un nouveau logo changera de nom tout seul.
 *
 * L'original reste dans public/ : les courriers, le logo de Google
 * (index.astro) et les anciennes adresses du site (lib/anciennes-adresses.ts)
 * le demandent à cette adresse. La signature des affiches, elle, ne passe
 * plus par le site : le fichier d'impression la prend dans apps/api/marque/.
 */
import logoEnTete from "../assets/logo-memory-line-en-tete.png";
interface Props {
  /** Langue de la page — pilote les libellés, les liens et le hreflang. */
  langue?: Langue;
  title?: string;
  description?: string;
  /**
   * L'adresse canonique de la page, préfixe de langue et requête compris
   * (« /en/affiches?genre=personnalisable&collection=villes »). Les versions
   * dans les autres langues (hreflang, sélecteur de langue) en sont tirées.
   * Absente : le chemin demandé, sans sa requête.
   */
  path?: string;
  image?: string;
  /** Les dimensions et le texte de `image`, annoncés aux réseaux (Seo.astro). */
  imageInfos?: { largeur: number; hauteur: number; alt: string };
  type?: "website" | "product" | "article";
  /** Page à garder hors de Google (« noindex, follow ») : panier, compte… */
  noindex?: boolean;
  /**
   * Les langues où le CONTENU de la page est vraiment écrit — celles que
   * l'API donne pour une fiche, un rayon, une page libre. Absent : toutes,
   * c'est le cas des pages dont le texte n'est que de l'interface.
   *
   * Hors de ces langues, la page reste visitable (en français) mais se met
   * en « noindex, follow » et ne se déclare plus comme une traduction : sans
   * cela, chaque fiche existait aux yeux de Google en cinq exemplaires dont
   * quatre en français étiquetés anglais, allemand…
   */
  languesTraduites?: readonly string[];
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /**
   * Page précédente et page suivante d'une liste paginée.
   *
   * Google ne lit plus ces balises depuis 2019 (Bing, si) : ce qui garde la
   * page 4 d'un rayon dans l'index, c'est son adresse canonique à elle —
   * numéro de page compris — et les liens « Page suivante » qui y mènent.
   * Elles restent, inoffensives, pour les autres moteurs.
   */
  precedente?: string | null;
  suivante?: string | null;
}
const {
  langue = LANGUE_DEFAUT,
  title,
  description,
  path,
  image,
  imageInfos,
  type,
  noindex,
  languesTraduites,
  jsonLd,
  precedente,
  suivante,
} = Astro.props;

const tr = t(langue);

/**
 * Le menu du haut, tel que le back-office l'a rangé.
 *
 * Le repli n'est pas un luxe : une boutique dont la navigation disparaît
 * parce qu'une route est tombée est une boutique fermée. Ces deux entrées
 * sont celles qui vivaient en dur ici avant que le menu devienne modifiable.
 */
const MENU_DE_SECOURS: EntreeMenuPublique[] = [
  {
    id: -1,
    label: tr("nav.personnalisables"),
    href: "/affiches?genre=personnalisable",
    enfants: [
      // Vers les personnalisables, et non « /affiches » : on ne crée qu'une
      // affiche personnalisable, et c'est cette page qui suit l'ordre réglé
      // au back-office. « /affiches » mêlait les prêtes à imprimer, par
      // nouveautés. La même adresse est posée en base par la migration 0050.
      { id: -6, label: tr("nav.creer"), href: "/affiches?genre=personnalisable" },
      { id: -2, label: tr("nav.tout_voir"), href: "/affiches?genre=personnalisable" },
      {
        id: -3,
        label: tr("nav.villes"),
        href: "/affiches?genre=personnalisable&collection=villes",
      },
      {
        id: -4,
        label: tr("nav.themes_paysages"),
        href: "/affiches?genre=personnalisable&collection=balades-paysages",
      },
    ],
  },
  {
    id: -5,
    label: tr("nav.pretes"),
    href: "/affiches?genre=prete_a_imprimer",
    enfants: [],
  },
];

/*
 * Le menu, le pied de page et sa baseline partent ENSEMBLE.
 *
 * Ils étaient demandés l'un après l'autre, à trente lignes d'écart : deux
 * allers-retours pour deux informations qui ne dépendent pas l'une de
 * l'autre, sur CHAQUE page du site. Ensemble, ils n'en coûtent qu'un. Les
 * colonnes du pied de page (BO › Menu du site › Pied de page, 17/11) partent
 * avec eux : un appel de plus, mais dans le même aller-retour.
 *
 * Chacun garde son repli : un menu qui ne répond pas laisse celui d'origine,
 * une baseline absente laisse celle du dictionnaire. Une page publique ne
 * tombe jamais parce qu'un ornement n'a pas pu être lu.
 */
const [reponseMenu, reponsePied, reponseReglages, reglagesFrancais] = await Promise.all([
  api.menu(langue, Astro.locals.stand).catch(() => null),
  api.menu(langue, Astro.locals.stand, "pied").catch(() => null),
  // La baseline dans la langue de la page : l'écran « Contenu du site » la
  // fait traduire, comme les textes de l'accueil. En français, la lecture
  // est exactement celle d'avant.
  langue === LANGUE_DEFAUT
    ? api.settings("footer").catch(() => null)
    : api.settings("footer", langue).catch(() => null),
  // Ailleurs, le français aussi, pour reconnaître une baseline NON traduite :
  // l'API rend alors le français à sa place (voir plus bas).
  langue === LANGUE_DEFAUT
    ? Promise.resolve(null)
    : api.settings("footer").catch(() => null),
]);

let entreesMenu: EntreeMenuPublique[] = MENU_DE_SECOURS;
if (reponseMenu?.entrees.length) entreesMenu = reponseMenu.entrees;

/**
 * La tablette d'un stand qui a sa page (BO › Ventes stand) : le logo y mène,
 * et elle vient EN TÊTE du menu. Le reste du menu, la recherche et le pied de
 * page restent ceux du site (19/11, Margaux : « sur tous les stands ils
 * doivent voir toutes les pages du site du menu »).
 */
const pageDuStand = Astro.locals.pageDuStand;
if (pageDuStand) {
  const adresseDuStand = `/pages/${pageDuStand.slug}`;
  entreesMenu = [
    { id: 0, label: pageDuStand.titre, href: adresseDuStand, enfants: [] },
    ...entreesMenu.filter((e) => e.href !== adresseDuStand),
  ];
}

/**
 * Une adresse de menu, prête à être cliquée.
 *
 * Une adresse interne reçoit le préfixe de langue : sans lui, un visiteur
 * anglais serait renvoyé sur la page française au premier clic. Une adresse
 * absolue désigne un autre site et part telle quelle.
 */
function adresseMenu(href: string): string {
  if (/^https?:\/\//i.test(href)) return href;
  const [chemin, requete] = href.split("?");
  return lien(langue, chemin || "/") + (requete ? `?${requete}` : "");
}

const chemin = cheminSansLangue(Astro.url.pathname);

/**
 * La même page dans chaque langue, tirée de son adresse CANONIQUE.
 *
 * Elle était tirée du seul chemin demandé, sans sa requête : le rayon
 * « Villes » (/affiches?genre=personnalisable&collection=villes) se
 * déclarait l'équivalent anglais de /en/affiches, le catalogue entier — des
 * hreflang qui contredisaient la canonique, que Google ignore, et un
 * sélecteur de langue qui faisait sortir du rayon. La requête canonique
 * (genre, collection, lieu, page) suit donc dans chaque langue ; le tri, qui
 * n'est pas dans la canonique, non.
 */
const [cheminCanonique, requeteCanonique] = (path ?? Astro.url.pathname).split("?");
const suiteCanonique = requeteCanonique ? `?${requeteCanonique}` : "";
const versions = autresVersions(langue, cheminSansLangue(cheminCanonique || "/")).map(
  (v) => ({ ...v, href: v.href + suiteCanonique }),
);

/*
 * Les versions qu'on déclare à Google (hreflang), et si la page s'indexe.
 *
 * Seulement les langues où le contenu est vraiment écrit. La version non
 * traduite d'une fiche (/en/… servie en français) reste visitable — le
 * sélecteur y mène toujours, l'interface y est traduite — mais elle se met
 * en « noindex, follow » et n'est déclarée nulle part. Une page qu'on garde
 * hors de l'index ne déclare pas de versions non plus : Google les
 * ignorerait. Et une seule langue n'a pas de « versions » à déclarer.
 */
const traduites = languesDuContenu(languesTraduites);
const horsIndex = !!noindex || !traduites.includes(langue);
const versionsDeclarees =
  !horsIndex && traduites.length > 1
    ? versions.filter((v) => traduites.includes(v.langue))
    : [];
const versionParDefaut = versionsDeclarees.find((v) => v.langue === LANGUE_DEFAUT);
const absolue = (href: string) =>
  new URL(href, Astro.site ?? "https://memoryline.fr").toString();

/**
 * Ce que le champ de l'en-tête affiche déjà.
 *
 * Sur la page de résultats, il reprend la saisie : le vider ferait croire que
 * la recherche a été oubliée, et obligerait à tout retaper pour corriger une
 * lettre. Ailleurs, il est vide.
 */
const rechercheEnCours =
  chemin === "/recherche" ? (Astro.url.searchParams.get("q") ?? "") : "";
const titre = title ?? tr("meta.titre");
const desc = description ?? tr("meta.description");

/**
 * La baseline du pied de page, telle que le back-office la règle.
 *
 * Le champ « Baseline » de l'écran « Contenu du site » était enregistré et
 * jamais lu : le site affichait une constante du dictionnaire, et la
 * propriétaire pouvait écrire ce qu'elle voulait sans que rien ne bouge.
 *
 * Dans les autres langues, la traduction saisie sur ce même écran — et
 * SEULEMENT elle. Non traduite, l'API rend la baseline française à sa place
 * (repli de /settings) : la reprendre remplacerait la phrase traduite du
 * dictionnaire par du français. Une valeur identique au français compte donc
 * pour « pas traduite », et la visiteuse allemande garde celle du
 * dictionnaire. Seul cas perdu : une baseline volontairement la même dans
 * les deux langues (un slogan en anglais, par exemple), qui s'affiche alors
 * dans la version du dictionnaire.
 */
let baseline = tr("pied.baseline");
{
  const saisie = reponseReglages?.["footer.baseline"];
  const texte = typeof saisie === "string" ? saisie.trim() : "";
  const francais = reglagesFrancais?.["footer.baseline"];
  // Le français illisible (API muette) : impossible de savoir si c'est une
  // traduction, on garde le dictionnaire plutôt que risquer du français.
  const nonTraduite =
    langue !== LANGUE_DEFAUT &&
    (!reglagesFrancais ||
      texte === (typeof francais === "string" ? francais.trim() : ""));
  if (texte && !nonTraduite) baseline = texte;
}

/** Le compte Instagram de la boutique, s'il est réglé : un lien sous cette phrase. */
const instagram = await instagramDeLaBoutique();

/** Une colonne de liens du pied de page : son titre, puis ses liens. */
interface ColonnePied {
  titre: string;
  /** Vide le plus souvent : le titre nomme la colonne, il ne mène nulle part. */
  href: string;
  liens: { href: string; texte: string }[];
}

/**
 * Les colonnes d'origine du pied de page, écrites ici avant que le
 * back-office les règle (17/11). Elles restent en repli, et la migration 0086
 * les a recopiées en base telles quelles.
 *
 * Les pages libres du site vivent sous « /pages/{adresse} » — préfixe
 * volontaire, documenté dans pages/[...lang]/pages/[slug].astro : posée à la
 * racine, cette route se glissait devant les accueils traduits. « Contact »
 * fait exception, c'est une page à elle.
 *
 * Un lien qui pointe vers l'une d'elles avant qu'elle existe ne casse rien :
 * la route rend une page introuvable, qui porte le menu, le pied de page et
 * de quoi rebondir.
 */
const liensBoutique = [
  { href: "/affiches", texte: tr("nav.affiches") },
  { href: "/affiches?genre=personnalisable", texte: tr("nav.personnalisables") },
  { href: "/affiches?genre=prete_a_imprimer", texte: tr("nav.pretes") },
  { href: "/recherche", texte: tr("recherche.titre") },
];
const liensAide = [
  { href: "/contact", texte: tr("pied.contact") },
  { href: "/pages/conditions-de-vente", texte: tr("pied.conditions") },
  { href: "/pages/mentions-legales", texte: tr("pied.mentions") },
  { href: "/pages/confidentialite", texte: tr("pied.confidentialite") },
  { href: "/pages/cookies", texte: tr("pied.cookies") },
];
const PIED_DE_SECOURS: ColonnePied[] = [
  { titre: tr("pied.navigation"), href: "", liens: liensBoutique },
  { titre: tr("pied.aide"), href: "", liens: liensAide },
];

/**
 * Les colonnes du pied de page, telles que le back-office les range (Menu du
 * site › Pied de page) : une par entrée de premier niveau, son titre puis
 * ses liens, libellés déjà traduits par l'API.
 *
 * Quatre au plus, à côté du logo et de « Compte » : c'est ce que la grille
 * met en page, et l'API refuse d'en enregistrer davantage. Une colonne sans
 * lien ni adresse n'aurait qu'un titre : elle n'est pas dessinée. S'il ne
 * reste rien (pied de page vidé, API muette), les colonnes d'origine
 * reviennent : le site n'a jamais un pied de page vide.
 *
 * Seule une réponse qui se dit « pied » compte : une API d'avant le pied de
 * page (le temps d'une mise en ligne) rendrait le menu du haut à sa place.
 */
const COLONNES_PIED_MAX = 4;
const colonnesDuBo: ColonnePied[] = (
  reponsePied?.emplacement === "pied" ? reponsePied.entrees : []
)
  .map((e) => ({
    titre: e.label,
    href: e.href,
    liens: e.enfants.map((l) => ({ href: l.href, texte: l.label })),
  }))
  .filter((c) => c.liens.length > 0 || c.href !== "")
  .slice(0, COLONNES_PIED_MAX);
const colonnesPied: ColonnePied[] = colonnesDuBo.length ? colonnesDuBo : PIED_DE_SECOURS;

/**
 * La grille du pied de page : le logo, les colonnes, puis « Compte », soit
 * de trois à six blocs. Un bloc par ligne sur téléphone, deux sur tablette.
 * Sur ordinateur, jusqu'à quatre côte à côte ; à cinq ou six, deux rangées
 * de trois, puis une seule rangée sur un grand écran. Les classes sont
 * écrites en entier : Tailwind ne génère que celles qu'il lit.
 */
const GRILLE_PIED: Record<number, string> = {
  3: "lg:grid-cols-3",
  4: "lg:grid-cols-4",
  5: "lg:grid-cols-3 xl:grid-cols-5",
  6: "lg:grid-cols-3 xl:grid-cols-6",
};
const grillePied = GRILLE_PIED[colonnesPied.length + 2] ?? "lg:grid-cols-4";

/**
 * Destination du lien « Compte » : le tableau de bord si une session est
 * ouverte, la page de connexion sinon.
 *
 * On se contente de repérer le cookie — le valider coûterait un appel à l'API
 * sur CHAQUE page du site. Une session périmée mène à /compte, qui renvoie
 * alors vers la connexion : le visiteur atterrit au bon endroit dans tous les
 * cas. Le court-circuit sur `isPrerendered` évite l'avertissement d'Astro sur
 * les pages générées au build, où aucune requête n'existe.
 */
const connecte =
  !Astro.isPrerendered &&
  (Astro.request.headers.get("cookie") ?? "").includes("ml_client=");
const lienCompte = lien(langue, connecte ? "/compte" : "/compte/connexion");

/**
 * Le pied de page renvoie vers le même compte que l'en-tête — sauf au stand,
 * où le compte n'existe pas : il n'y reste que le panier.
 */
const liensCompte = Astro.locals.stand
  ? [{ href: "/panier", texte: tr("nav.panier") }]
  : [
      {
        href: connecte ? "/compte" : "/compte/connexion",
        texte: tr("nav.compte"),
      },
      // Plus de page panier sur le site (17/11) : le récapitulatif se modifie
      // dans /commande. Au stand, la tablette garde sa page /panier.
      { href: "/commande", texte: tr("nav.panier") },
    ];

/**
 * Raccourci vers le back-office, pour qui y est déjà connecté.
 *
 * La session est VRAIMENT validée, contrairement au lien « Compte » plus
 * haut : afficher l'entrée du back-office sur la foi d'un cookie périmé
 * indiquerait à n'importe quel visiteur d'un poste partagé qu'il y a une
 * porte, et laquelle. Le coût est nul pour un vrai client — sans le cookie,
 * aucun appel n'est fait — et d'un aller-retour interne pour la boutique.
 */
// Résolue par le middleware, une fois par requête. La redemander ici
// coûtait un aller-retour de plus à l'API pour la même réponse. Une page
// figée au build n'a pas de session : `locals` y est vide, et le raccourci
// ne s'affiche pas — ce qui est exactement ce qu'on veut.
const admin = Astro.isPrerendered ? null : (Astro.locals.admin ?? null);
/** Le back-office vit sous /bo derrière le proxy ; surchargeable en prod. */
const lienBackOffice = import.meta.env.PUBLIC_BO_URL ?? "/bo";
---

<!doctype html>
<html
  lang={langue}
  data-stand={Astro.locals.stand ? "1" : undefined}
  data-stand-valeur={Astro.locals.standValeur ?? undefined}
  data-mdp-afficher={tr("compte.mdp_afficher")}
  data-mdp-masquer={tr("compte.mdp_masquer")}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* La police du site (« ML Inter », global.css), demandée avant tout le
        reste : le texte l'attend au lieu de s'afficher dans celle du
        système puis de changer (18/11). Le seul fichier dont chaque page a
        besoin ; le latin étendu et l'italique viennent s'ils servent. */}
    <link rel="preload" href="/fonts/Inter-latin.woff2" as="font" type="font/woff2" crossorigin />

    {/* Google Tag Manager (17/11), sur le site en production seulement : en
        local, il mesurerait nos propres essais. Le consentement passe AVANT
        (« Consent Mode » de Google) : tout est refusé tant que la visiteuse
        n'a pas cliqué « Accepter » dans le bandeau cookies (CookieBanner.astro,
        choix gardé dans localStorage, évènement « ml:consent »). GTM ne pose
        lui-même aucun cookie ; les balises Google qu'il charge attendent
        l'accord. Une balise d'un autre éditeur ajoutée dans GTM doit, elle,
        y être réglée pour attendre le consentement. */}
    {import.meta.env.PROD && (
      <>
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          (function () {
            var refuse = { ad_storage: "denied", ad_user_data: "denied", ad_personalization: "denied", analytics_storage: "denied" };
            var accorde = { ad_storage: "granted", ad_user_data: "granted", ad_personalization: "granted", analytics_storage: "granted" };
            gtag("consent", "default", Object.assign({ wait_for_update: 500 }, refuse));
            var choix = null;
            try { choix = localStorage.getItem("ml_cookie_consent"); } catch (e) {}
            if (choix === "accept") gtag("consent", "update", accorde);
            document.addEventListener("ml:consent", function (e) {
              gtag("consent", "update", e.detail && e.detail.consent === "accept" ? accorde : refuse);
            });
          })();
          gtag("js", new Date());
          // Tag Manager se charge APRÈS la page (17/11, PageSpeed) : environ
          // 75 Ko de JavaScript tiers ne retardent plus l'affichage, surtout
          // en 4G. Le consentement, lui, est posé plus haut, avant tout.
          (function () {
            function charger() {
              var s = document.createElement("script");
              s.async = true;
              s.src = "https://www.googletagmanager.com/gtm.js?id=GTM-PJ2BFXCB";
              document.head.appendChild(s);
            }
            if (document.readyState === "complete") setTimeout(charger, 0);
            else window.addEventListener("load", function () { setTimeout(charger, 0); });
          })();
        </script>
      </>
    )}
    <meta name="generator" content={Astro.generator} />
    <link rel="sitemap" href="/sitemap.xml" />
    {/* Les icônes du site : l'onglet, l'écran d'accueil d'un téléphone, et
        le petit logo que Google montre à côté de chaque résultat. Il n'y en
        avait aucune — /favicon.ico répondait 404. Ce sont les initiales « ML »
        du logo, en bleu sur blanc (public/, tirées de logo-memory-line.png) :
        le logo entier, très large, serait illisible à 16 px. Google demande
        un carré multiple de 48 px : c'est l'icône de 192. */}
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {/* Le nom et l'icône d'un « Ajouter à l'écran d'accueil » sur Android
        (AUDIT-SEO.md, PWA-1). Sans effet sur le référencement. */}
    <link rel="manifest" href="/manifest.webmanifest" />
    {/* Versions traduites : chaque page se declare aux moteurs comme
        l'equivalent des autres, pour eviter d'etre vue comme du contenu
        duplique. Le code de langue seul (« en », pas « en-GB ») : le texte
        n'a rien de regional, et la version anglaise vaut aussi bien pour
        l'Irlande ou les Etats-Unis, la francaise pour la Belgique ou la
        Suisse. */}
    {versionsDeclarees.map((v) => (
      <link rel="alternate" hreflang={v.langue} href={absolue(v.href)} />
    ))}
    {versionParDefaut && (
      <link rel="alternate" hreflang="x-default" href={absolue(versionParDefaut.href)} />
    )}
    {/* Les morceaux d'une liste paginée se tiennent par la main. */}
    {precedente && <link rel="prev" href={absolue(precedente)} />}
    {suivante && <link rel="next" href={absolue(suivante)} />}
    {/* Marque la page comme animée avant qu'elle ne s'affiche : la règle
        d'apparition ne s'applique que sous cette classe, donc sans
        JavaScript rien n'est masqué. */}
    <script is:inline>
      document.documentElement.classList.add("ml-js");
      // Safari sur iPad et iPhone n'applique l'état « appuyé » (:active) d'un
      // bouton que si la page écoute les contacts du doigt. Sans cet
      // écouteur vide, l'effet d'appui des boutons noirs (global.css) ne
      // s'affichait jamais sur la tablette du stand — précisément là où il
      // sert. `passive` : il ne ralentit pas le défilement.
      document.addEventListener("touchstart", function () {}, { passive: true });
    </script>
    {/* Les chargements (18/11 : « le site manque de loadings placeholders,
        splash screen y'a pas non plus »). Trois choses, sans attendre aucun
        autre script, d'où leur place ici :
        - l'écran d'accueil (#ml-accueil, en tête du <body>) : le logo et une
          barre qui file, au PREMIER affichage de la visite seulement (mémoire
          de l'onglet). Il part quand la police du site est là, jamais avant
          une demi-seconde (sinon il clignote), jamais après 6 s (une 4G à bout
          de souffle). Il est caché tant que ce script ne l'a pas
          demandé (.ml-avec-accueil) : sans JavaScript, il n'existe pas. (Un
          <noscript> ne convient pas : Astro en sort les <style>.) ;
        - la barre de navigation (#ml-navigation) : un lien suivi ou un
          formulaire envoyé la fait avancer en haut de l'écran jusqu'à ce que
          la page suivante s'affiche. Avant, rien ne bougeait pendant 1 à 2 s
          en 4G, et on recliquait ;
        - le reflet des images en attente (global.css, ml-squelette et
          ml-image-attente) s'arrête dès que l'image arrive, ou échoue, sur
          toute la page, îlots compris : « load » ne remonte pas, mais se
          capte. */}
    <script is:inline>
      (function () {
        var html = document.documentElement;
        var deja = true;
        try {
          deja = sessionStorage.getItem("ml_accueil") === "1";
          sessionStorage.setItem("ml_accueil", "1");
        } catch (e) {}
        if (!deja) {
          html.classList.add("ml-avec-accueil");
          var debut = Date.now();
          var fini = false;
          var lever = function () {
            if (fini) return;
            fini = true;
            setTimeout(function () {
              var ecran = document.getElementById("ml-accueil");
              if (!ecran) {
                html.classList.remove("ml-avec-accueil");
                return;
              }
              ecran.classList.add("ml-accueil-part");
              setTimeout(function () {
                html.classList.remove("ml-avec-accueil");
                if (ecran.parentNode) ecran.parentNode.removeChild(ecran);
              }, 450);
            }, Math.max(0, 500 - (Date.now() - debut)));
          };
          // Il attend la police du site (« ML Inter », global.css), pas les
          // images, qui ont leur reflet d'attente : le texte ne se montre
          // jamais dans une autre police, même en 4G lente, où elle partage
          // le débit avec les premières images (2 à 5 s, mesuré le 18/11).
          var pret = function () {
            var p = null;
            try {
              p = document.fonts && document.fonts.load('1em "ML Inter"');
            } catch (e) {}
            if (p && p.then) p.then(lever, lever);
            else lever();
          };
          // Lancé juste après l'écran, en tête du <body> : la feuille de
          // style y est lue, la police y est déclarée. (Attendre la fin de
          // la lecture de la page ferait aussi attendre tous les scripts.)
          window.mlAccueilPret = pret;
          setTimeout(lever, 6000);
        }

        function arrivee(e) {
          var t = e.target;
          if (!t || t.tagName !== "IMG") return;
          t.classList.add("est-charge");
          var cadre = t.parentElement && t.parentElement.closest(".ml-squelette");
          if (cadre) cadre.classList.add("est-charge");
        }
        document.addEventListener("load", arrivee, true);
        document.addEventListener("error", arrivee, true);

        var barre = null;
        var garde = 0;
        function enRoute() {
          barre = barre || document.getElementById("ml-navigation");
          if (!barre) return;
          barre.classList.remove("ml-en-route");
          void barre.offsetWidth;
          barre.classList.add("ml-en-route");
          clearTimeout(garde);
          // Un lien qui télécharge un fichier ne quitte pas la page.
          garde = setTimeout(arrivePage, 12000);
        }
        function arrivePage() {
          if (barre) barre.classList.remove("ml-en-route");
        }
        document.addEventListener("click", function (e) {
          if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
          var a = e.target && e.target.closest ? e.target.closest("a[href]") : null;
          if (!a || a.hasAttribute("download")) return;
          var cible = a.getAttribute("target");
          if (cible && cible !== "_self") return;
          var u;
          try {
            u = new URL(a.href, window.location.href);
          } catch (x) {
            return;
          }
          if (u.origin !== window.location.origin || u.pathname.indexOf("/api/") === 0) return;
          // Un endroit de la même page (« #… ») : on ne la quitte pas.
          var brut = a.getAttribute("href") || "";
          if (
            brut.charAt(0) === "#" ||
            (u.pathname === window.location.pathname &&
              u.search === window.location.search &&
              brut.indexOf("#") !== -1)
          )
            return;
          setTimeout(function () {
            if (!e.defaultPrevented) enRoute();
          }, 0);
        });
        document.addEventListener("submit", function (e) {
          setTimeout(function () {
            if (!e.defaultPrevented) enRoute();
          }, 0);
        });
        // Retour arrière : la page revient telle qu'on l'a quittée, barre
        // comprise. On la range.
        window.addEventListener("pageshow", arrivePage);
      })();
    </script>
    {/* Le code du stand, arrivé par l'adresse que donne le back-office
        (« /?stand=1&code=… »). Il est rangé dans la tablette — c'est là que
        la dernière étape le relit (CommandeStand.tsx) — puis retiré aussitôt
        de la barre d'adresse : un code affiché devant le client, et gardé
        dans l'historique d'une tablette qui passe de main en main, n'est plus
        un code. Rien n'est vérifié ici : l'étape de validation le soumet au
        stand avant de s'en servir. */}
    {/* Le mode stand vit dans l'adresse (?stand=1), sans cookie (17/11) :
        chaque lien et chaque formulaire de la page le garde, au moment où on
        le suit. Les îlots qui changent de page par programme passent par
        avecStand() (lib/api-navigateur.ts). Un lien vers un autre site, ou
        qui dit déjà « stand=0 » pour en sortir, ne change pas. */}
    {
      Astro.locals.stand && (
        <script is:inline>
          (function () {
            // La valeur de l'adresse (le numéro du stand, 18/11) : la
            // tablette reste sur SON stand, donc sur sa page.
            var valeur = document.documentElement.getAttribute("data-stand-valeur") || "1";
            function garder(adresse) {
              try {
                var u = new URL(adresse, window.location.href);
                if (u.origin !== window.location.origin) return null;
                if (u.searchParams.has("stand")) return null;
                u.searchParams.set("stand", valeur);
                return u.href;
              } catch (e) {
                return null;
              }
            }
            function surLien(e) {
              var a = e.target && e.target.closest ? e.target.closest("a[href]") : null;
              if (!a || a.hasAttribute("download")) return;
              var brut = a.getAttribute("href") || "";
              if (!brut || brut.charAt(0) === "#" || /^(mailto|tel|javascript):/i.test(brut)) return;
              var nouvelle = garder(a.href);
              if (nouvelle) a.href = nouvelle;
            }
            document.addEventListener("click", surLien, true);
            document.addEventListener("auxclick", surLien, true);
            document.addEventListener(
              "submit",
              function (e) {
                var f = e.target;
                if (!f || f.tagName !== "FORM") return;
                var methode = (f.getAttribute("method") || "get").toLowerCase();
                if (methode === "get") {
                  if (!f.querySelector('input[name="stand"]')) {
                    var champ = document.createElement("input");
                    champ.type = "hidden";
                    champ.name = "stand";
                    champ.value = valeur;
                    f.appendChild(champ);
                  }
                } else {
                  var action = garder(f.action || window.location.href);
                  if (action) f.action = action;
                }
              },
              true,
            );
          })();
        </script>
      )
    }
    {
      Astro.locals.stand && (
        <script is:inline>
          (function () {
            try {
              var adresse = new URL(window.location.href);
              var code = (adresse.searchParams.get("code") || "").trim();
              if (!code) return;
              localStorage.setItem("ml_salon_code", code);
              adresse.searchParams.delete("code");
              history.replaceState(
                history.state,
                "",
                adresse.pathname + adresse.search + adresse.hash,
              );
            } catch (e) {
              // Stockage refusé (navigation privée) : le code se saisira à la
              // main, à la dernière étape.
            }
          })();
        </script>
      )
    }
    <Seo
      langue={langue}
      title={titre}
      description={desc}
      path={path}
      image={image}
      imageInfos={imageInfos}
      type={type}
      noindex={horsIndex}
      alternatives={versionsDeclarees.map((v) => v.langue)}
      jsonLd={jsonLd}
    />
  </head>
  <body class="min-h-screen flex flex-col bg-paper text-ink">
    {/* L'écran d'accueil et la barre de navigation : voir le script du <head>. */}
    <div id="ml-accueil" aria-hidden="true">
      <img
        src={logoEnTete.src}
        alt=""
        width={logoEnTete.width}
        height={logoEnTete.height}
        class="ml-accueil-logo"
      />
      <span class="ml-accueil-barre"><span></span></span>
    </div>
    <script is:inline>
      if (window.mlAccueilPret) window.mlAccueilPret();
    </script>
    <div id="ml-navigation" aria-hidden="true"></div>
    {/* Le bandeau d'annonce, au stand AUSSI (19/11, Alexandra : « il faut
        même la bannière, sur toutes les pages » ; la tablette est le site,
        sauf les prix et la caisse). */}
    <AnnouncementBanner langue={langue} />
    {/* En-tête calquée sur memoryline.fr : logo à gauche, navigation au
        centre, actions à droite, sur 1200 px de large. */}
    <header class="border-b border-ink/10 bg-paper sticky top-0 z-10">
      {/* LE MODE STAND SE VOIT (Alexandra, 13/11 : « qu'on voie visuellement
          qu'on est en mode stand, dans le menu au milieu »). Une bande au
          centre, en haut de l'en-tête, qui le suit quand on défile : sur la
          tablette, la vendeuse sait d'un coup d'œil qu'elle n'est pas sur le
          site des clients (prix cachés, pages du stand, liens du stand). */}
      {Astro.locals.stand && (
        <p
          class="bg-terracotta py-1 text-center text-xs font-semibold uppercase tracking-[0.2em] text-paper"
          role="status"
        >
          <span aria-hidden="true">●</span> {tr("stand.mode")}
        </p>
      )}
      {/* Stand fermé : dit juste sous la bande, et seulement dans ce cas
          (lib/stand-etat.ts). Stand ouvert : rien. */}
      {Astro.locals.stand && (
        <p
          id="ml-stand-ferme"
          hidden
          class="bg-ink py-1.5 text-center text-xs font-semibold uppercase tracking-[0.15em] text-paper"
          role="alert"
        >
          {tr("stand.ferme")}
        </p>
      )}
      {/*
        UNE rangée : logo · menu · « Créer mon affiche » · RECHERCHE · actions.

        Toute la largeur, sans conteneur centré : le contenu des pages garde
        sa largeur de lecture, mais un en-tête serré au milieu d'un grand
        écran se lit mal alors qu'il reste de la place de chaque côté.

        LE CHAMP DE RECHERCHE EST À DROITE, avec les icônes.

        Il a d'abord été centré au pixel, ce qui demandait une grille à trois
        pistes dont les deux côtés faisaient la même largeur. C'était ce qui
        bridait tout le reste : le côté droit ne portant que trois icônes, le
        côté gauche recevait la même largeur qu'elles — et le logo plus le
        menu n'y tenaient qu'à peine, les libellés se coupant en deux lignes.

        À droite, cette contrainte tombe. La rangée redevient une simple
        ligne, le champ peut être plus large ET apparaître plus tôt : dès
        1024 px au lieu de 1290.
      */}
      <div
        class="flex w-full items-center gap-4 px-4 py-4 max-[359px]:gap-3 sm:gap-6 sm:px-6 lg:px-10"
      >
        {/* Le logo et le menu, à leur largeur naturelle. `shrink-0` est ce
            qui empêche les libellés de se couper : sans lui, le navigateur
            comprime ce groupe dès que la rangée est chargée. */}
        <div class="mr-auto flex min-w-0 items-center gap-3 max-[359px]:gap-2 sm:gap-5 lg:shrink-0 lg:gap-6">
          {/* LE MENU SUR TÉLÉPHONE.

              Sous 768 px, la barre de menu est masquée (`hidden md:flex`,
              plus bas) : il n'y avait RIEN à sa place, et un visiteur sur
              téléphone ne pouvait atteindre ni les rayons, ni les
              collections, ni les pages — retour de la boutique.

              Le bouton ☰ ouvre un panneau sous la barre, avec les MÊMES
              entrées que le menu de bureau (celles du back-office) ; une
              entrée à sous-liens se déplie sur place. Des <details> natifs,
              comme le menu de bureau : il s'ouvre même sans JavaScript, et le
              script plus bas ajoute la fermeture au clic ailleurs et à Échap.
              Le panneau se positionne sur l'en-tête, qui est `sticky`.

              Sous 360 px (les plus petits téléphones), le ☰ en plus ne
              laissait plus d'espace entre le logo et la loupe : le logo
              passe de 48 à 40 px de haut et les espacements se resserrent
              (les `max-[359px]:` de cette rangée), rien qu'à cette taille. */}
          <details class="ml-menu-mobile md:hidden">
            <summary
              class="-ml-2 flex h-10 w-10 cursor-pointer list-none items-center justify-center hover:text-terracotta transition-colors"
              aria-label={tr("nav.menu")}
            >
              <svg
                class="ml-burger-ouvrir"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                aria-hidden="true"
              >
                <path d="M4 7h16M4 12h16M4 17h16" />
              </svg>
              <svg
                class="ml-burger-fermer"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linecap="round"
                aria-hidden="true"
