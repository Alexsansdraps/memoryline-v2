          </div>
          <form
            method="get"
            action={lien(langue, "/recherche")}
            role="search"
            class="ml-recherche flex w-full items-center"
          >
            <label for="ml-q" class="sr-only">{tr("recherche.champ")}</label>
            <input
              id="ml-q"
              type="search"
              name="q"
              value={rechercheEnCours}
              autocomplete="off"
              placeholder={tr("recherche.champ")}
              class="ml-recherche-champ w-full min-w-0 bg-transparent px-3 py-2 text-[13px] focus:outline-none"
            />
            <button
              type="submit"
              class="px-2 py-1.5 text-ink/60 hover:text-terracotta transition-colors"
