    <style is:global>
      /* Le triangle par défaut de <details> n'a rien à faire dans un menu. */
      .ml-menu > summary::-webkit-details-marker {
        display: none;
      }
      .ml-menu[open] .ml-menu-fleche {
        transform: rotate(180deg);
      }
      /* Le menu du téléphone : ☰ fermé, ✕ ouvert ; ses groupes se déplient. */
      .ml-menu-mobile > summary::-webkit-details-marker,
      .ml-menu-mobile-groupe > summary::-webkit-details-marker {
        display: none;
      }
      .ml-menu-mobile[open] .ml-burger-ouvrir,
      .ml-menu-mobile:not([open]) .ml-burger-fermer {
        display: none;
      }
      .ml-menu-mobile-groupe[open] .ml-menu-fleche {
        transform: rotate(180deg);
      }
    </style>

    <script is:inline>
      // Le menu du téléphone se referme quand on touche ailleurs ou qu'on
      // appuie sur Échap — comme celui du bureau. Un toucher DANS le panneau
      // (ouvrir un groupe) le laisse ouvert.
      (function () {
        var menu = document.querySelector("details.ml-menu-mobile");
        if (!menu) return;
        function fermer() {
          menu.removeAttribute("open");
          menu.querySelectorAll("details[open]").forEach(function (d) {
            d.removeAttribute("open");
          });
        }
        document.addEventListener("click", function (e) {
          if (!menu.open || !(e.target instanceof Element)) return;
          // Ailleurs, ou sur un LIEN du panneau : on s'en va, le menu se
          // ferme (sinon le retour arrière le retrouverait ouvert).
          if (!menu.contains(e.target) || e.target.closest("nav a")) fermer();
        });
        // Au clavier, quitter le panneau le ferme : resté ouvert, il cachait
        // les champs qui recevaient le focus ensuite (WCAG 2.4.11). Un focus
        // qui ne va nulle part (toucher sur le fond du panneau) ne compte pas.
        menu.addEventListener("focusout", function (e) {
          if (menu.open && e.relatedTarget instanceof Node && !menu.contains(e.relatedTarget))
            fermer();
        });
        document.addEventListener("keydown", function (e) {
          if (e.key !== "Escape" || !menu.open) return;
          // Le focus ne revient sur ☰ que s'il était DANS le menu : Échap
          // tapé dans un champ de la page ne doit pas l'y arracher.
          var dedans = menu.contains(document.activeElement);
          fermer();
          var bouton = menu.querySelector("summary");
          if (dedans && bouton) bouton.focus();
        });
        // Le navigateur garde la page telle quelle pour le retour arrière :
        // on la range menu fermé.
        window.addEventListener("pagehide", fermer);
      })();
    </script>

    <script is:inline>
      // Un menu ouvert doit se fermer quand on clique ailleurs ou qu'on appuie
      // sur Échap : <details> ne le fait pas tout seul, et un menu resté
      // ouvert par-dessus la page passe pour un bogue.
      (function () {
        var menus = document.querySelectorAll("details.ml-menu");
        if (!menus.length) return;
        function fermerSauf(garde) {
          menus.forEach(function (m) {
            if (m !== garde) m.removeAttribute("open");
          });
        }
        menus.forEach(function (m) {
          m.addEventListener("toggle", function () {
            if (m.open) fermerSauf(m);
          });
        });
        document.addEventListener("click", function (e) {
          var dedans = e.target instanceof Node && e.target;
          menus.forEach(function (m) {
            if (dedans && m.contains(dedans)) return;
            m.removeAttribute("open");
          });
        });
        document.addEventListener("keydown", function (e) {
          if (e.key === "Escape") fermerSauf(null);
        });
      })();
    </script>

