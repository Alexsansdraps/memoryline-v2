---
import "../styles/global.css";
import Seo from "../components/Seo.astro";
import AnnouncementBanner from "../components/AnnouncementBanner.astro";
import CookieBanner from "../components/CookieBanner.astro";
import CartBadge from "../islands/CartBadge.tsx";
import {
  LANGUE_DEFAUT,
  LOCALE_COMPLETE,
  autresVersions,
  cheminSansLangue,
  lien,
  t,
  type Langue,
} from "../i18n/utils.ts";
interface Props {
  /** Langue de la page — pilote les libellés, les liens et le hreflang. */
  langue?: Langue;
  title?: string;
  description?: string;
  path?: string;
  image?: string;
  type?: "website" | "product" | "article";
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const {
  langue = LANGUE_DEFAUT,
  title,
  description,
  path,
  image,
  type,
  noindex,
  jsonLd,
} = Astro.props;

const tr = t(langue);
const chemin = cheminSansLangue(Astro.url.pathname);
const versions = autresVersions(langue, chemin);
const titre = title ?? tr("meta.titre");
const desc = description ?? tr("meta.description");
---

<!doctype html>
<html lang={langue}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {/* Versions traduites : chaque page se declare aux moteurs comme
        l'equivalent des autres, pour eviter d'etre vue comme du contenu
        duplique. */}
    {versions.map((v) => (
      <link
        rel="alternate"
        hreflang={LOCALE_COMPLETE[v.langue]}
        href={new URL(v.href, Astro.site ?? "https://memoryline.fr").toString()}
      />
    ))}
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(chemin, Astro.site ?? "https://memoryline.fr").toString()}
    />
    {/* Marque la page comme animée avant qu'elle ne s'affiche : la règle
        d'apparition ne s'applique que sous cette classe, donc sans
        JavaScript rien n'est masqué. */}
    <script is:inline>
      document.documentElement.classList.add("ml-js");
    </script>
    <Seo
      title={titre}
      description={desc}
      path={path}
      image={image}
      type={type}
      noindex={noindex}
      jsonLd={jsonLd}
    />
  </head>
  <body class="min-h-screen flex flex-col bg-paper text-ink">
    <AnnouncementBanner />
    {/* En-tête calquée sur memoryline.fr : logo à gauche, navigation au
        centre, actions à droite, sur 1200 px de large. */}
    <header class="border-b border-ink/10 bg-paper sticky top-0 z-10">
      <nav
        class="mx-auto flex max-w-[1200px] items-center justify-between gap-6 px-6 py-5 lg:px-12"
      >
        <a
          href={lien(langue, "/")}
          class="inline-flex shrink-0 items-center"
          aria-label={tr("nav.accueil")}
        >
          <img
            src="/logo-memory-line.png"
            alt="Memory Line"
            width="500"
            height="222"
            class="h-12 w-auto"
          />
        </a>
        <div class="hidden md:flex items-center gap-8 text-[17px] font-semibold">
          <a
            href={lien(langue, "/affiches")}
            class="hover:text-terracotta transition-colors">{tr("nav.affiches")}</a
          >
        </div>
        <div class="flex items-center gap-5 text-sm">
          <a
            href={lien(langue, "/panier")}
            class="ml-panier-lien inline-flex items-center gap-2 hover:text-terracotta transition-colors"
            aria-label={tr("nav.panier")}
          >
            {/* Panier en icône, comme sur le site actuel : le mot prend de la
                place et l'icône se reconnaît d'un coup d'œil. */}
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M6 8h12l-1 12H7L6 8Z" />
              <path d="M9 8V6a3 3 0 0 1 6 0v2" />
            </svg>
            <span class="sr-only">{tr("nav.panier")}</span>
            <CartBadge client:load />
          </a>
          <a
            href={lien(langue, "/affiches")}
            class="bg-ink px-5 py-2.5 text-paper hover:bg-ink/85 transition-colors"
            >{tr("nav.creer")}</a
          >

          {/* Sélecteur de langue, en haut à droite. Ce sont de vrais liens :
              chaque langue a son URL, indexable et partageable. */}
          <div class="ml-langues">
            <button
              type="button"
              class="ml-langues-bouton"
              aria-haspopup="true"
              aria-expanded="false"
              aria-label={tr("nav.langue")}
            >
              {langue.toUpperCase()}
              <span aria-hidden="true">▾</span>
            </button>
            <ul class="ml-langues-liste">
              {versions.map((v) => (
                <li>
                  <a
                    href={v.href}
                    hreflang={v.langue}
                    aria-current={v.actuelle ? "true" : undefined}
                    class={v.actuelle ? "est-actuelle" : ""}
                  >
                    {v.nom}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </nav>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-ink/10 mt-16">
      <div
        class="mx-auto flex max-w-[1200px] flex-col justify-between gap-2 px-6 py-9 text-sm text-ink-soft sm:flex-row lg:px-12"
      >
        <p>© {new Date().getFullYear()} {tr("pied.droits")}</p>
        <p>{tr("pied.baseline")}</p>
      </div>
    </footer>
    <CookieBanner langue={langue} />

    <script is:inline>
      // Apparition au défilement : chaque élément marqué se révèle quand il
      // entre dans l'écran. On s'arrête de l'observer une fois révélé — inutile
      // de recalculer pour cent quatre-vingts affiches à chaque pixel scrollé.
      (() => {
        const cibles = document.querySelectorAll(".ml-apparition");
        if (!cibles.length) return;
        const tout = () =>
          cibles.forEach((c) => c.classList.add("est-visible"));
        if (!("IntersectionObserver" in window)) {
          tout();
          return;
        }
        const observateur = new IntersectionObserver(
          (entrees) => {
            for (const e of entrees) {
              if (!e.isIntersecting) continue;
              e.target.classList.add("est-visible");
              observateur.unobserve(e.target);
            }
          },
          // Un peu avant le bord bas : l'affiche est déjà en place quand elle
          // arrive vraiment sous les yeux.
          { rootMargin: "0px 0px -10% 0px", threshold: 0.05 },
        );
        cibles.forEach((c) => observateur.observe(c));
        // Filet : dans un onglet en arrière-plan, l'observateur peut ne jamais
        // se déclencher. Au bout d'une seconde et demie, on montre tout ce qui
        // reste caché — une grille vide serait bien pire qu'une animation
        // manquée.
        setTimeout(tout, 1500);
      })();
    </script>
  </body>
</html>
