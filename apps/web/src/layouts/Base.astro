---
import "../styles/global.css";
import Seo from "../components/Seo.astro";
import AnnouncementBanner from "../components/AnnouncementBanner.astro";
import CookieBanner from "../components/CookieBanner.astro";
import CartBadge from "../islands/CartBadge.tsx";
import {
  LANGUE_DEFAUT,
  LOCALE_COMPLETE,
  autresVersions,
  cheminSansLangue,
  lien,
  t,
  type Langue,
} from "../i18n/utils.ts";
interface Props {
  /** Langue de la page — pilote les libellés, les liens et le hreflang. */
  langue?: Langue;
  title?: string;
  description?: string;
  path?: string;
  image?: string;
  type?: "website" | "product" | "article";
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const {
  langue = LANGUE_DEFAUT,
  title,
  description,
  path,
  image,
  type,
  noindex,
  jsonLd,
} = Astro.props;

const tr = t(langue);
const chemin = cheminSansLangue(Astro.url.pathname);
const versions = autresVersions(langue, chemin);
const titre = title ?? tr("meta.titre");
const desc = description ?? tr("meta.description");
---

<!doctype html>
<html lang={langue}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {/* Versions traduites : chaque page se declare aux moteurs comme
        l'equivalent des autres, pour eviter d'etre vue comme du contenu
        duplique. */}
    {versions.map((v) => (
      <link
        rel="alternate"
        hreflang={LOCALE_COMPLETE[v.langue]}
        href={new URL(v.href, Astro.site ?? "https://memoryline.fr").toString()}
      />
    ))}
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(chemin, Astro.site ?? "https://memoryline.fr").toString()}
    />
    <Seo
      title={titre}
      description={desc}
      path={path}
      image={image}
      type={type}
      noindex={noindex}
      jsonLd={jsonLd}
    />
  </head>
  <body class="min-h-screen flex flex-col bg-paper text-ink">
    <AnnouncementBanner />
    <header
      class="border-b border-ink/10 bg-paper/80 backdrop-blur sticky top-0 z-10"
    >
      <nav
        class="mx-auto max-w-6xl flex items-center justify-between px-6 py-4"
      >
        <a
          href={lien(langue, "/")}
          class="inline-flex items-center"
          aria-label={tr("nav.accueil")}
        >
          <img
            src="/logo-memory-line.png"
            alt="Memory Line"
            width="500"
            height="222"
            class="h-11 w-auto"
          />
        </a>
        <div class="flex items-center gap-6 text-sm">
          <a
            href={lien(langue, "/affiches")}
            class="hover:text-terracotta transition-colors">{tr("nav.affiches")}</a
          >
          <a
            href={lien(langue, "/panier")}
            class="ml-panier-lien hover:text-terracotta transition-colors"
            >{tr("nav.panier")}<CartBadge client:load /></a
          >
          <a
            href={lien(langue, "/affiches")}
            class="rounded-full bg-ink px-4 py-2 text-paper hover:bg-terracotta-deep transition-colors"
            >{tr("nav.creer")}</a
          >

          {/* Sélecteur de langue, en haut à droite. Ce sont de vrais liens :
              chaque langue a son URL, indexable et partageable. */}
          <div class="ml-langues">
            <button
              type="button"
              class="ml-langues-bouton"
              aria-haspopup="true"
              aria-expanded="false"
              aria-label={tr("nav.langue")}
            >
              {langue.toUpperCase()}
              <span aria-hidden="true">▾</span>
            </button>
            <ul class="ml-langues-liste">
              {versions.map((v) => (
                <li>
                  <a
                    href={v.href}
                    hreflang={v.langue}
                    aria-current={v.actuelle ? "true" : undefined}
                    class={v.actuelle ? "est-actuelle" : ""}
                  >
                    {v.nom}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </nav>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-ink/10 mt-16">
      <div
        class="mx-auto max-w-6xl px-6 py-8 text-sm text-ink-soft flex flex-col sm:flex-row justify-between gap-2"
      >
        <p>© {new Date().getFullYear()} {tr("pied.droits")}</p>
        <p>{tr("pied.baseline")}</p>
      </div>
    </footer>
    <CookieBanner />
  </body>
</html>
