---
import "../styles/global.css";
import Seo from "../components/Seo.astro";
import AnnouncementBanner from "../components/AnnouncementBanner.astro";
import CookieBanner from "../components/CookieBanner.astro";
import CartBadge from "../islands/CartBadge.tsx";
import {
  LANGUE_DEFAUT,
  LOCALE_COMPLETE,
  autresVersions,
  cheminSansLangue,
  lien,
  t,
  type Langue,
} from "../i18n/utils.ts";
import { api, type EntreeMenuPublique } from "../lib/api.ts";
interface Props {
  /** Langue de la page — pilote les libellés, les liens et le hreflang. */
  langue?: Langue;
  title?: string;
  description?: string;
  path?: string;
  image?: string;
  type?: "website" | "product" | "article";
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /**
   * Page précédente et page suivante d'une liste paginée.
   *
   * Elles disent à un moteur que ces adresses sont les morceaux d'une SEULE
   * suite : sans elles, la page 4 d'un rayon passe pour une page isolée,
   * pauvre en texte et sans lien entrant, et sort de l'index avec les
   * quarante-huit affiches qu'elle porte.
   */
  precedente?: string | null;
  suivante?: string | null;
}
const {
  langue = LANGUE_DEFAUT,
  title,
  description,
  path,
  image,
  type,
  noindex,
  jsonLd,
  precedente,
  suivante,
} = Astro.props;

const tr = t(langue);

/**
 * Le menu du haut, tel que le back-office l'a rangé.
 *
 * Le repli n'est pas un luxe : une boutique dont la navigation disparaît
 * parce qu'une route est tombée est une boutique fermée. Ces deux entrées
 * sont celles qui vivaient en dur ici avant que le menu devienne modifiable.
 */
const MENU_DE_SECOURS: EntreeMenuPublique[] = [
  {
    id: -1,
    label: tr("nav.personnalisables"),
    href: "/affiches?genre=personnalisable",
    enfants: [
      { id: -2, label: tr("nav.tout_voir"), href: "/affiches?genre=personnalisable" },
      {
        id: -3,
        label: tr("nav.villes"),
        href: "/affiches?genre=personnalisable&collection=villes",
      },
      {
        id: -4,
        label: tr("nav.themes_paysages"),
        href: "/affiches?genre=personnalisable&collection=balades-paysages",
      },
    ],
  },
  {
    id: -5,
    label: tr("nav.pretes"),
    href: "/affiches?genre=prete_a_imprimer",
    enfants: [],
  },
];

let entreesMenu: EntreeMenuPublique[] = MENU_DE_SECOURS;
try {
  const rendu = await api.menu(langue);
  if (rendu.entrees.length) entreesMenu = rendu.entrees;
} catch {
  /* API injoignable : le menu d'origine reste, la boutique reste ouverte */
}

/**
 * Une adresse de menu, prête à être cliquée.
 *
 * Une adresse interne reçoit le préfixe de langue : sans lui, un visiteur
 * anglais serait renvoyé sur la page française au premier clic. Une adresse
 * absolue désigne un autre site et part telle quelle.
 */
function adresseMenu(href: string): string {
  if (/^https?:\/\//i.test(href)) return href;
  const [chemin, requete] = href.split("?");
  return lien(langue, chemin || "/") + (requete ? `?${requete}` : "");
}

const chemin = cheminSansLangue(Astro.url.pathname);
const versions = autresVersions(langue, chemin);

/**
 * Ce que le champ de l'en-tête affiche déjà.
 *
 * Sur la page de résultats, il reprend la saisie : le vider ferait croire que
 * la recherche a été oubliée, et obligerait à tout retaper pour corriger une
 * lettre. Ailleurs, il est vide.
 */
const rechercheEnCours =
  chemin === "/recherche" ? (Astro.url.searchParams.get("q") ?? "") : "";
const titre = title ?? tr("meta.titre");
const desc = description ?? tr("meta.description");

/**
 * La baseline du pied de page, telle que le back-office la règle.
 *
 * Le champ « Baseline » de l'écran « Contenu du site » était enregistré et
 * jamais lu : le site affichait une constante du dictionnaire, et la
 * propriétaire pouvait écrire ce qu'elle voulait sans que rien ne bouge.
 *
 * Il ne s'applique qu'au FRANÇAIS, et c'est délibéré : le réglage est une
 * chaîne unique, sans colonne de traduction, alors que le dictionnaire porte
 * les cinq langues. Le servir partout remplacerait quatre phrases traduites
 * par une phrase française. La visiteuse allemande garde donc la sienne, et
 * la boutiquière retrouve la sienne là où elle l'a écrite.
 */
let baseline = tr("pied.baseline");
if (langue === LANGUE_DEFAUT) {
  try {
    const reglages = await api.settings("footer");
    const saisie = reglages["footer.baseline"];
    if (typeof saisie === "string" && saisie.trim()) baseline = saisie.trim();
  } catch {
    // API muette : la phrase du dictionnaire tient. Un pied de page n'a
    // jamais de raison de faire tomber une page.
  }
}

/**
 * Les liens du pied de page.
 *
 * Les pages libres du site vivent sous « /pages/{adresse} » — préfixe
 * volontaire, documenté dans pages/[...lang]/pages/[slug].astro : posée à la
 * racine, cette route se glissait devant les accueils traduits. « Contact »
 * fait exception, c'est une page à elle.
 *
 * Ces pages sont en cours d'écriture au back-office. Un lien qui pointe vers
 * l'une d'elles avant qu'elle existe ne casse rien : la route rend une page
 * introuvable, qui porte le menu, le pied de page et de quoi rebondir. C'est
 * le seul comportement possible ici — aucune route publique ne dit quelles
 * pages sont publiées, et interroger les cinq une par une coûterait cinq
 * allers-retours sur CHAQUE page du site.
 */
const liensBoutique = [
  { href: "/affiches", texte: tr("nav.affiches") },
  { href: "/affiches?genre=personnalisable", texte: tr("nav.personnalisables") },
  { href: "/affiches?genre=prete_a_imprimer", texte: tr("nav.pretes") },
  { href: "/recherche", texte: tr("recherche.titre") },
];
const liensAide = [
  { href: "/contact", texte: tr("pied.contact") },
  { href: "/pages/conditions-de-vente", texte: tr("pied.conditions") },
  { href: "/pages/mentions-legales", texte: tr("pied.mentions") },
  { href: "/pages/confidentialite", texte: tr("pied.confidentialite") },
  { href: "/pages/cookies", texte: tr("pied.cookies") },
];

/**
 * Destination du lien « Compte » : le tableau de bord si une session est
 * ouverte, la page de connexion sinon.
 *
 * On se contente de repérer le cookie — le valider coûterait un appel à l'API
 * sur CHAQUE page du site. Une session périmée mène à /compte, qui renvoie
 * alors vers la connexion : le visiteur atterrit au bon endroit dans tous les
 * cas. Le court-circuit sur `isPrerendered` évite l'avertissement d'Astro sur
 * les pages générées au build, où aucune requête n'existe.
 */
const connecte =
  !Astro.isPrerendered &&
  (Astro.request.headers.get("cookie") ?? "").includes("ml_client=");
const lienCompte = lien(langue, connecte ? "/compte" : "/compte/connexion");

/** Le pied de page renvoie vers le même compte que l'en-tête. */
const liensCompte = [
  { href: connecte ? "/compte" : "/compte/connexion", texte: tr("nav.compte") },
  { href: "/panier", texte: tr("nav.panier") },
];

/**
 * Raccourci vers le back-office, pour qui y est déjà connecté.
 *
 * La session est VRAIMENT validée, contrairement au lien « Compte » plus
 * haut : afficher l'entrée du back-office sur la foi d'un cookie périmé
 * indiquerait à n'importe quel visiteur d'un poste partagé qu'il y a une
 * porte, et laquelle. Le coût est nul pour un vrai client — sans le cookie,
 * aucun appel n'est fait — et d'un aller-retour interne pour la boutique.
 */
const cookies = Astro.isPrerendered
  ? ""
  : (Astro.request.headers.get("cookie") ?? "");
let admin: { email: string; role: string } | null = null;
if (cookies.includes("ml_admin_session=")) {
  try {
    const base =
      import.meta.env.API_URL_INTERNAL ??
      import.meta.env.PUBLIC_API_URL ??
      "http://localhost:3000";
    const res = await fetch(`${base}/auth/me`, { headers: { cookie: cookies } });
    if (res.ok) admin = (await res.json()).user ?? null;
  } catch {
    // API injoignable : on n'affiche simplement pas le raccourci. Une page
    // publique ne doit jamais tomber parce qu'un lien d'administration
    // n'a pas pu être calculé.
  }
}
/** Le back-office vit sous /bo derrière le proxy ; surchargeable en prod. */
const lienBackOffice = import.meta.env.PUBLIC_BO_URL ?? "/bo";
---

<!doctype html>
<html lang={langue}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {/* Versions traduites : chaque page se declare aux moteurs comme
        l'equivalent des autres, pour eviter d'etre vue comme du contenu
        duplique. */}
    {versions.map((v) => (
      <link
        rel="alternate"
        hreflang={LOCALE_COMPLETE[v.langue]}
        href={new URL(v.href, Astro.site ?? "https://memoryline.fr").toString()}
      />
    ))}
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(chemin, Astro.site ?? "https://memoryline.fr").toString()}
    />
    {/* Les morceaux d'une liste paginée se tiennent par la main. */}
    {precedente && (
      <link
        rel="prev"
        href={new URL(precedente, Astro.site ?? "https://memoryline.fr").toString()}
      />
    )}
    {suivante && (
      <link
        rel="next"
        href={new URL(suivante, Astro.site ?? "https://memoryline.fr").toString()}
      />
    )}
    {/* Marque la page comme animée avant qu'elle ne s'affiche : la règle
        d'apparition ne s'applique que sous cette classe, donc sans
        JavaScript rien n'est masqué. */}
    <script is:inline>
      document.documentElement.classList.add("ml-js");
    </script>
    <Seo
      title={titre}
      description={desc}
      path={path}
      image={image}
      type={type}
      noindex={noindex}
      jsonLd={jsonLd}
    />
  </head>
  <body class="min-h-screen flex flex-col bg-paper text-ink">
    <AnnouncementBanner />
    {/* En-tête calquée sur memoryline.fr : logo à gauche, navigation au
        centre, actions à droite, sur 1200 px de large. */}
    <header class="border-b border-ink/10 bg-paper sticky top-0 z-10">
      <nav
        class="mx-auto flex max-w-[1200px] items-center justify-between gap-6 px-6 py-5 lg:px-12"
      >
        <a
          href={lien(langue, "/")}
          class="inline-flex shrink-0 items-center"
          aria-label={tr("nav.accueil")}
        >
          <img
            src="/logo-memory-line.png"
            alt="Memory Line"
            width="500"
            height="222"
            class="h-12 w-auto"
          />
        </a>
        <div class="hidden md:flex items-center gap-8 text-[17px] font-semibold">
          {/* Le menu vient du back-office. Une entrée sans sous-lien est un
              simple lien ; les autres se déroulent au clic, et se referment au
              clic ailleurs ou avec Échap — un survol seul laisserait les
              écrans tactiles sans porte d'entrée. */}
          {
            entreesMenu.map((entree) =>
              entree.enfants.length === 0 ? (
                <a
                  href={adresseMenu(entree.href)}
                  class="hover:text-terracotta transition-colors"
                >
                  {entree.label}
                </a>
              ) : (
                <details class="ml-menu relative">
                  <summary class="hover:text-terracotta flex cursor-pointer list-none items-center gap-1 transition-colors">
                    {entree.label}
                    <svg
                      width="12"
                      height="12"
                      viewBox="0 0 12 12"
                      aria-hidden="true"
                      class="ml-menu-fleche transition-transform"
                    >
                      <path
                        d="M2 4.5 6 8.5 10 4.5"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </summary>
                  <div class="border-ink/10 bg-paper absolute top-full left-0 z-20 mt-3 min-w-56 rounded-lg border py-2 text-[15px] font-medium shadow-lg">
                    {entree.enfants.map((enfant) => (
                      <a
                        href={adresseMenu(enfant.href)}
                        class="hover:bg-ink/5 hover:text-terracotta block px-4 py-2 transition-colors"
                      >
                        {enfant.label}
                      </a>
                    ))}
                  </div>
                </details>
              ),
            )
          }
        </div>
        <div class="flex items-center gap-4 text-sm">
          {/* La recherche de la boutique.
              Un vrai formulaire en GET vers /recherche : la saisie finit dans
              l'adresse, donc un résultat se recopie dans un message et le
              bouton « précédent » ramène la liste qu'on quittait. Sur les
              petits écrans le champ céderait toute la place à l'en-tête : on
              y met la loupe seule, qui mène à la page de recherche et à son
              grand champ. */}
          <form
            method="get"
            action={lien(langue, "/recherche")}
            role="search"
            class="ml-recherche hidden lg:flex items-center border border-ink/20 focus-within:border-ink transition-colors"
          >
            <label for="ml-q" class="sr-only">{tr("recherche.champ")}</label>
            <input
              id="ml-q"
              type="search"
              name="q"
              value={rechercheEnCours}
              autocomplete="off"
              placeholder={tr("recherche.champ")}
              class="w-40 bg-transparent px-3 py-1.5 text-[13px] focus:outline-none xl:w-52"
            />
            <button
              type="submit"
              class="px-2 py-1.5 text-ink/60 hover:text-terracotta transition-colors"
              aria-label={tr("recherche.bouton")}
            >
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                aria-hidden="true"
              >
                <circle cx="11" cy="11" r="7" />
                <path d="m20 20-3.5-3.5" />
              </svg>
            </button>
          </form>
          <a
            href={lien(langue, "/recherche")}
            class="inline-flex lg:hidden items-center hover:text-terracotta transition-colors"
            aria-label={tr("recherche.titre")}
          >
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <circle cx="11" cy="11" r="7" />
              <path d="m20 20-3.5-3.5" />
            </svg>
            <span class="sr-only">{tr("recherche.titre")}</span>
          </a>
          {/* Raccourci d'administration. Volontairement discret : il ne
              s'affiche que pour une session de back-office valide, et ne doit
              pas concurrencer le panier dans l'œil du client. */}
          {admin && (
            <a
              href={lienBackOffice}
              rel="nofollow"
              title={`Back-office — ${admin.email} (${
                admin.role === "owner" ? "propriétaire" : "vendeur"
              })`}
              class="hidden sm:inline-flex items-center gap-1.5 border border-ink/15 px-2.5 py-1 text-[12px] text-ink/55 hover:text-terracotta hover:border-terracotta/40 transition-colors"
            >
              <svg
                width="13"
                height="13"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M3 4h18v16H3z" />
                <path d="M3 9h18" />
                <path d="M8 9v11" />
              </svg>
              Back-office
            </a>
          )}
          {/* Compte : même traitement que le panier — une icône, le mot en
              lecture d'écran seulement, pour ne pas charger l'en-tête. */}
          <a
            href={lienCompte}
            class="inline-flex items-center gap-2 hover:text-terracotta transition-colors"
            aria-label={tr("nav.compte")}
          >
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z" />
              <path d="M4.5 20a7.5 7.5 0 0 1 15 0" />
            </svg>
            <span class="sr-only">{tr("nav.compte")}</span>
          </a>
          <a
            href={lien(langue, "/panier")}
            class="ml-panier-lien inline-flex items-center gap-2 hover:text-terracotta transition-colors"
            aria-label={tr("nav.panier")}
          >
            {/* Panier en icône, comme sur le site actuel : le mot prend de la
                place et l'icône se reconnaît d'un coup d'œil. */}
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M6 8h12l-1 12H7L6 8Z" />
              <path d="M9 8V6a3 3 0 0 1 6 0v2" />
            </svg>
            <span class="sr-only">{tr("nav.panier")}</span>
            <CartBadge client:load />
          </a>
          <a
            href={lien(langue, "/affiches")}
            class="bg-ink px-5 py-2.5 text-paper hover:bg-ink/85 transition-colors"
            >{tr("nav.creer")}</a
          >

          {/* Sélecteur de langue, en haut à droite. Ce sont de vrais liens :
              chaque langue a son URL, indexable et partageable. */}
          <div class="ml-langues">
            <button
              type="button"
              class="ml-langues-bouton"
              aria-haspopup="true"
              aria-expanded="false"
              aria-label={tr("nav.langue")}
            >
              {langue.toUpperCase()}
              <span aria-hidden="true">▾</span>
            </button>
            <ul class="ml-langues-liste">
              {versions.map((v) => (
                <li>
                  <a
                    href={v.href}
                    hreflang={v.langue}
                    aria-current={v.actuelle ? "true" : undefined}
                    class={v.actuelle ? "est-actuelle" : ""}
                  >
                    {v.nom}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </nav>
    </header>

    <style is:global>
      /* Le triangle par défaut de <details> n'a rien à faire dans un menu. */
      .ml-menu > summary::-webkit-details-marker {
        display: none;
      }
      .ml-menu[open] .ml-menu-fleche {
        transform: rotate(180deg);
      }
    </style>

    <script is:inline>
      // Un menu ouvert doit se fermer quand on clique ailleurs ou qu'on appuie
      // sur Échap : <details> ne le fait pas tout seul, et un menu resté
      // ouvert par-dessus la page passe pour un bogue.
      (function () {
        var menus = document.querySelectorAll("details.ml-menu");
        if (!menus.length) return;
        function fermerSauf(garde) {
          menus.forEach(function (m) {
            if (m !== garde) m.removeAttribute("open");
          });
        }
        menus.forEach(function (m) {
          m.addEventListener("toggle", function () {
            if (m.open) fermerSauf(m);
          });
        });
        document.addEventListener("click", function (e) {
          var dedans = e.target instanceof Node && e.target;
          menus.forEach(function (m) {
            if (dedans && m.contains(dedans)) return;
            m.removeAttribute("open");
          });
        });
        document.addEventListener("keydown", function (e) {
          if (e.key === "Escape") fermerSauf(null);
        });
      })();
    </script>

    <main class="flex-1">
      <slot />
    </main>

    {/* Le pied de page ne contenait AUCUN lien : deux phrases, et rien pour
        aller aux conditions de vente, au contact ou à la livraison — c'est
        pourtant là qu'on les cherche, tout en bas, après avoir fait défiler. */}
    <footer class="border-t border-ink/10 mt-16">
      <div class="mx-auto max-w-[1200px] px-6 py-12 lg:px-12">
        <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
          <div>
            <img
              src="/logo-memory-line.png"
              alt="Memory Line"
              width="500"
              height="222"
              class="h-10 w-auto"
            />
            <p class="mt-4 text-sm text-ink-soft">{baseline}</p>
          </div>

          <nav aria-labelledby="pied-boutique">
            <h2 id="pied-boutique" class="text-sm font-semibold">
              {tr("pied.navigation")}
            </h2>
            <ul class="mt-4 space-y-2 text-sm text-ink-soft">
              {liensBoutique.map((l) => (
                <li>
                  <a
                    href={adresseMenu(l.href)}
                    class="hover:text-terracotta transition-colors">{l.texte}</a
                  >
                </li>
              ))}
            </ul>
          </nav>

          <nav aria-labelledby="pied-aide">
            <h2 id="pied-aide" class="text-sm font-semibold">
              {tr("pied.aide")}
            </h2>
            <ul class="mt-4 space-y-2 text-sm text-ink-soft">
              {liensAide.map((l) => (
                <li>
                  <a
                    href={adresseMenu(l.href)}
                    class="hover:text-terracotta transition-colors">{l.texte}</a
                  >
                </li>
              ))}
            </ul>
          </nav>

          <nav aria-labelledby="pied-compte">
            <h2 id="pied-compte" class="text-sm font-semibold">
              {tr("nav.compte")}
            </h2>
            <ul class="mt-4 space-y-2 text-sm text-ink-soft">
              {liensCompte.map((l) => (
                <li>
                  <a
                    href={adresseMenu(l.href)}
                    class="hover:text-terracotta transition-colors">{l.texte}</a
                  >
                </li>
              ))}
            </ul>
          </nav>
        </div>

        <p class="mt-12 border-t border-ink/10 pt-6 text-sm text-ink-soft">
          © {new Date().getFullYear()} {tr("pied.droits")}
        </p>
      </div>
    </footer>
    <CookieBanner langue={langue} />

    <script is:inline>
      // Apparition au défilement : chaque élément marqué se révèle quand il
      // entre dans l'écran. On s'arrête de l'observer une fois révélé — inutile
      // de recalculer pour cent quatre-vingts affiches à chaque pixel scrollé.
      (() => {
        const cibles = document.querySelectorAll(".ml-apparition");
        if (!cibles.length) return;
        const tout = () =>
          cibles.forEach((c) => c.classList.add("est-visible"));
        if (!("IntersectionObserver" in window)) {
          tout();
          return;
        }
        const observateur = new IntersectionObserver(
          (entrees) => {
            for (const e of entrees) {
              if (!e.isIntersecting) continue;
              e.target.classList.add("est-visible");
              observateur.unobserve(e.target);
            }
          },
          // Un peu avant le bord bas : l'affiche est déjà en place quand elle
          // arrive vraiment sous les yeux.
          { rootMargin: "0px 0px -10% 0px", threshold: 0.05 },
        );
        cibles.forEach((c) => observateur.observe(c));
        // Filet : dans un onglet en arrière-plan, l'observateur peut ne jamais
        // se déclencher. Au bout d'une seconde et demie, on montre tout ce qui
        // reste caché — une grille vide serait bien pire qu'une animation
        // manquée.
        setTimeout(tout, 1500);
      })();
    </script>
  </body>
</html>
