---
/**
 * L'ancienne adresse du stand.
 *
 * Le mot « salon » a laissé la place à « stand » partout où on le lit. Cette
 * adresse-ci survit parce qu'elle est peut-être ouverte sur une tablette en
 * ce moment même, et parce qu'un code d'accès envoyé par message ne se
 * réécrit pas. Elle emmène au même endroit, code compris.
 */
export const prerender = false;
const suite = Astro.url.search;
return Astro.redirect(`/stand${suite}`, 301);
---
