---
import Base from "../layouts/Base.astro";
import CheckoutIsland from "../islands/CheckoutIsland.tsx";
---

<Base
  title="Commander — Memory Line"
  description="Finalisez votre commande d'affiches personnalisées Memory Line."
  path="/commande"
  noindex={true}
>
  <section class="mx-auto max-w-4xl px-4 sm:px-6 pt-12 pb-16">
    <nav class="text-sm text-ink-soft">
      <a href="/" class="hover:text-terracotta">Accueil</a> ·
      <a href="/panier" class="hover:text-terracotta">Panier</a>
    </nav>
    <h1 class="font-serif text-4xl sm:text-5xl mt-4 mb-8">Commander</h1>

    <CheckoutIsland client:only="solid-js" />
  </section>
</Base>
