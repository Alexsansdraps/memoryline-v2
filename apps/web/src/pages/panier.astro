---
import Base from "../layouts/Base.astro";
import CartIsland from "../islands/CartIsland.tsx";
---

<Base
  title="Votre panier — Memory Line"
  description="Votre panier d'affiches personnalisées Memory Line."
  path="/panier"
  noindex={true}
>
  <section class="mx-auto max-w-4xl px-4 sm:px-6 pt-12 pb-16">
    <nav class="text-sm text-ink-soft">
      <a href="/" class="hover:text-terracotta">Accueil</a> ·
      <a href="/affiches" class="hover:text-terracotta">Affiches</a>
    </nav>
    <h1 class="font-serif text-4xl sm:text-5xl mt-4 mb-8">Votre panier</h1>

    <CartIsland client:only="solid-js" />
  </section>
</Base>
