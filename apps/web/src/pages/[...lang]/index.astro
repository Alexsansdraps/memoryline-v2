---
import Base from "../../layouts/Base.astro";
import {
  api,
  setting,
  formatPrice,
  assetUrl,
  type Product,
} from "../../lib/api.ts";
import {
  estLangue,
  langueDepuisParam,
  lien,
  t,
  type Langue,
} from "../../i18n/utils.ts";

/**
 * Rendue À LA DEMANDE : cette page liste le catalogue, qui change dès qu'une
 * affiche est créée au back-office. Générée au build, elle aurait ignoré les
 * nouveautés jusqu'au build suivant.
 */
export const prerender = false;

// Préfixe de langue inconnu : 404 plutôt que du français à une adresse qui
// n'existe pas.
if (Astro.params.lang !== undefined && !estLangue(Astro.params.lang))
  return new Response(null, { status: 404 });
const langue: Langue = langueDepuisParam(Astro.params.lang);
const tr = t(langue);

/**
 * Page d'accueil.
 *
 * Chaque section est PILOTÉE DEPUIS LE BACK-OFFICE : titre, texte et
 * affichage (on/off) viennent de la table `setting`. Les valeurs passées en
 * second argument de `setting()` sont les replis — le site reste donc complet
 * même si rien n'a jamais été saisi.
 */

let stats = null;
try {
  stats = await api.stats();
} catch {
  // API non joignable au build/SSR -> on dégrade proprement
}

// Les affiches mises en avant : c'est ce qui manquait à l'accueil.
let products: Product[] = [];
try {
  products = await api.products(60, langue);
} catch {
  // Sans API, la vitrine s'efface plutôt que d'afficher une grille vide.
}

/** Un réglage vaut « activé » sauf s'il est explicitement à "off"/"non"/"0". */
async function visible(cle: string): Promise<boolean> {
  const v = (await setting(cle, "on")).trim().toLowerCase();
  return !["off", "non", "no", "0", "false"].includes(v);
}

const vitrineVisible = await visible("home.vitrine.visible");
const vitrineTitre = await setting("home.vitrine.title", "Nos best-sellers ❤️");
/**
 * Texte d'introduction de la vitrine : une ligne par ligne saisie au
 * back-office. Celles qui commencent par un tiret deviennent une puce, les
 * autres restent des phrases — c'est ce que fait la boutique actuelle, et ça
 * laisse la cliente écrire ce qu'elle veut sans passer par un développeur.
 */
const vitrineTexte = await setting(
  "home.vitrine.subtitle",
  "- Choisissez votre fond\n- Personnalisez votre texte\n- Choisissez vos personnages et personnalisez-les\nVotre affiche prête en 2 minutes !",
);
const vitrineLignes = vitrineTexte
  .split(/\r?\n/)
  .map((l) => l.trim())
  .filter(Boolean)
  .map((l) => ({ puce: /^[-–•]\s*/.test(l), texte: l.replace(/^[-–•]\s*/, "") }));
const vitrineNombre = Math.max(
  1,
  Math.min(24, Number(await setting("home.vitrine.count", "8")) || 8),
);

const chiffresVisible = await visible("home.chiffres.visible");

const vitrine = products.slice(0, vitrineNombre);

function fourchette(p: Product): string {
  const prix = p.variants.map((v) => v.priceCents).filter((c) => c > 0);
  if (prix.length === 0) return formatPrice(p.basePriceCents);
  const min = Math.min(...prix);
  const max = Math.max(...prix);
  return min === max
    ? formatPrice(min)
    : `${formatPrice(min)} – ${formatPrice(max)}`;
}

/** Retire le suffixe « - Affiche personnalisée » des noms importés. */
const titreCourt = (nom: string) => nom.replace(/\s*[-–]\s*Affiche.*$/i, "");
---

<Base langue={langue}>
  {/* ---------------- Les affiches ---------------- */}
  {
    vitrineVisible && vitrine.length > 0 && (
      <section class="w-full px-6 pt-12 pb-4 lg:px-12">
        <div class="mb-8 flex flex-wrap items-end justify-between gap-3">
          <div>
            {/* Devenu le titre de la page depuis que le bandeau d'accroche
                a été retiré : une page sans h1 se présente mal aux moteurs
                de recherche. */}
            <h1 class="text-2xl sm:text-3xl">{vitrineTitre}</h1>
            <div class="mt-2 space-y-0.5 text-ink-soft">
              {vitrineLignes.map((l) =>
                l.puce ? (
                  <p class="flex gap-2">
                    <span aria-hidden="true">–</span>
                    <span>{l.texte}</span>
                  </p>
                ) : (
                  <p>{l.texte}</p>
                ),
              )}
            </div>
          </div>
          <a
            href={lien(langue, "/affiches")}
            class="text-terracotta hover:text-terracotta-deep font-medium whitespace-nowrap"
          >
            {tr("catalogue.titre")} →
          </a>
        </div>

        <ul class="grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 2xl:grid-cols-6">
          {vitrine.map((p) => (
            <li class="group">
              <a href={lien(langue, `/affiches/${p.slug}`)} class="block">
                <div
                  class="flex items-center justify-center overflow-hidden bg-paper-deep"
                  style="aspect-ratio:1020/1400"
                >
                  {assetUrl(p.image) ? (
                    <img
                      src={assetUrl(p.image)}
                      alt={p.name}
                      loading="lazy"
                      class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
                    />
                  ) : (
                    <span class="px-4 text-center text-lg text-ink-soft">
                      {titreCourt(p.name)}
                    </span>
                  )}
                </div>
                <h3 class="mt-4 text-[17px] leading-snug group-hover:underline underline-offset-4">
                  {titreCourt(p.name)}
                </h3>
                <p class="mt-1 text-ink-soft">{fourchette(p)}</p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {/* ---------------- Chiffres ---------------- */}
  {
    chiffresVisible && stats && (
      <section class="mx-auto max-w-[1200px] px-6 py-16">
        <dl class="grid grid-cols-2 sm:grid-cols-4 gap-px bg-ink/10 rounded-2xl overflow-hidden border border-ink/10">
          {[
            [tr("accueil.stat.affiches"), stats.products],
            [tr("accueil.stat.collections"), stats.collections],
            ["Formats", "A4 · A3"],
            ["Prêtes en", "2 min"],
          ].map(([label, value]) => (
            <div class="bg-paper px-6 py-5">
              <dt class="text-sm text-ink-soft">{label}</dt>
              <dd class="font-serif text-3xl mt-1">{value}</dd>
            </div>
          ))}
        </dl>
      </section>
    )
  }
</Base>
