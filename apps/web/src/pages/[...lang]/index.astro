---
import Base from "../../layouts/Base.astro";
import {
  api,
  setting,
  formatPrice,
  assetUrl,
  type Product,
} from "../../lib/api.ts";
import { cheminsLangues, lien, t, type Langue } from "../../i18n/utils.ts";

export const getStaticPaths = cheminsLangues;

const { langue } = Astro.props as { langue: Langue };
const tr = t(langue);

/**
 * Page d'accueil.
 *
 * Chaque section est PILOTÉE DEPUIS LE BACK-OFFICE : titre, texte et
 * affichage (on/off) viennent de la table `setting`. Les valeurs passées en
 * second argument de `setting()` sont les replis — le site reste donc complet
 * même si rien n'a jamais été saisi.
 */

let stats = null;
try {
  stats = await api.stats();
} catch {
  // API non joignable au build/SSR -> on dégrade proprement
}

// Les affiches mises en avant : c'est ce qui manquait à l'accueil.
let products: Product[] = [];
try {
  products = await api.products(60, langue);
} catch {
  // Sans API, la vitrine s'efface plutôt que d'afficher une grille vide.
}

/** Un réglage vaut « activé » sauf s'il est explicitement à "off"/"non"/"0". */
async function visible(cle: string): Promise<boolean> {
  const v = (await setting(cle, "on")).trim().toLowerCase();
  return !["off", "non", "no", "0", "false"].includes(v);
}

const heroSurtitre = await setting("home.hero.eyebrow", tr("accueil.surtitre"));
const heroTitle = await setting("home.hero.title", tr("accueil.titre"));
const heroSubtitle = await setting("home.hero.subtitle", tr("accueil.soustitre"));
const heroCta = await setting("home.hero.cta", tr("accueil.cta"));

const vitrineVisible = await visible("home.vitrine.visible");
const vitrineTitre = await setting("home.vitrine.title", tr("catalogue.titre"));
const vitrineTexte = await setting("home.vitrine.subtitle", tr("produit.aide"));
const vitrineNombre = Math.max(
  1,
  Math.min(24, Number(await setting("home.vitrine.count", "8")) || 8),
);

const etapesVisible = await visible("home.etapes.visible");
const etapesTitre = await setting("home.etapes.title", "Comment ça marche");

const chiffresVisible = await visible("home.chiffres.visible");

const vitrine = products.slice(0, vitrineNombre);

function fourchette(p: Product): string {
  const prix = p.variants.map((v) => v.priceCents).filter((c) => c > 0);
  if (prix.length === 0) return formatPrice(p.basePriceCents);
  const min = Math.min(...prix);
  const max = Math.max(...prix);
  return min === max
    ? formatPrice(min)
    : `${formatPrice(min)} – ${formatPrice(max)}`;
}

/** Retire le suffixe « - Affiche personnalisée » des noms importés. */
const titreCourt = (nom: string) => nom.replace(/\s*[-–]\s*Affiche.*$/i, "");
---

<Base langue={langue}>
  {/* ---------------- Bandeau d'accroche ---------------- */}
  <section class="mx-auto max-w-6xl px-6 pt-16 pb-10">
    <p class="text-terracotta font-medium tracking-wide uppercase text-sm">
      {heroSurtitre}
    </p>
    <h1 class="font-serif text-5xl sm:text-6xl leading-[1.05] mt-3 max-w-3xl">
      {heroTitle}
    </h1>
    <p class="mt-6 text-lg text-ink-soft max-w-xl">{heroSubtitle}</p>
    <div class="mt-8 flex flex-wrap gap-4">
      <a
        href={lien(langue, "/affiches")}
        class="rounded-full bg-terracotta px-6 py-3 text-paper font-medium hover:bg-terracotta-deep transition-colors"
        >{heroCta}</a
      >
    </div>
  </section>

  {/* ---------------- Les affiches ---------------- */}
  {
    vitrineVisible && vitrine.length > 0 && (
      <section class="mx-auto max-w-6xl px-6 pb-4">
        <div class="flex flex-wrap items-end justify-between gap-3 mb-6">
          <div>
            <h2 class="font-serif text-3xl sm:text-4xl">{vitrineTitre}</h2>
            <p class="mt-2 text-ink-soft">{vitrineTexte}</p>
          </div>
          <a
            href={lien(langue, "/affiches")}
            class="text-terracotta hover:text-terracotta-deep font-medium whitespace-nowrap"
          >
            {tr("catalogue.titre")} →
          </a>
        </div>

        <ul class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-6">
          {vitrine.map((p) => (
            <li class="group">
              <a href={lien(langue, `/affiches/${p.slug}`)} class="block">
                <div class="aspect-[3/4] rounded-xl bg-paper-deep border border-ink/10 flex items-center justify-center overflow-hidden group-hover:border-terracotta/40 transition-colors">
                  {assetUrl(p.image) ? (
                    <img
                      src={assetUrl(p.image)}
                      alt={p.name}
                      loading="lazy"
                      class="h-full w-full object-cover group-hover:scale-[1.02] transition-transform"
                    />
                  ) : (
                    <span class="font-serif text-lg text-ink-soft px-4 text-center">
                      {titreCourt(p.name)}
                    </span>
                  )}
                </div>
                <h3 class="font-medium leading-snug mt-3">{titreCourt(p.name)}</h3>
                <p class="text-ink-soft mt-1">{fourchette(p)}</p>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {/* ---------------- Comment ça marche ---------------- */}
  {
    etapesVisible && (
      <section class="bg-paper-deep mt-16">
        <div class="mx-auto max-w-6xl px-6 py-16">
          <h2 class="font-serif text-3xl sm:text-4xl mb-8">{etapesTitre}</h2>
          <div class="grid sm:grid-cols-3 gap-8">
            {[
              ["1 · Choisissez votre fond", "Villes françaises, paysages, thèmes."],
              [
                "2 · Personnalisez",
                "Titre, sous-titre, personnages et leurs tenues.",
              ],
              ["3 · Recevez", "Imprimée en A4 ou A3, livrée chez vous."],
            ].map(([t, d]) => (
              <div>
                <h3 class="font-serif text-2xl">{t}</h3>
                <p class="mt-2 text-ink-soft">{d}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {/* ---------------- Chiffres ---------------- */}
  {
    chiffresVisible && stats && (
      <section class="mx-auto max-w-6xl px-6 py-16">
        <dl class="grid grid-cols-2 sm:grid-cols-4 gap-px bg-ink/10 rounded-2xl overflow-hidden border border-ink/10">
          {[
            [tr("accueil.stat.affiches"), stats.products],
            [tr("accueil.stat.collections"), stats.collections],
            ["Formats", "A4 · A3"],
            ["Prêtes en", "2 min"],
          ].map(([label, value]) => (
            <div class="bg-paper px-6 py-5">
              <dt class="text-sm text-ink-soft">{label}</dt>
              <dd class="font-serif text-3xl mt-1">{value}</dd>
            </div>
          ))}
        </dl>
      </section>
    )
  }
</Base>
