---
import Base from "../../layouts/Base.astro";
import BandeauxVisuels from "../../components/BandeauxVisuels.astro";
import VignetteAffiche from "../../components/VignetteAffiche.astro";
import { grilleProduits, sizesGrille, styleGrille } from "../../lib/grille.ts";
/** Colonnes réglées au back-office (Contenu du site › Affichage des produits) :
 *  celles de l'accueil s'il en a, le réglage général sinon. */
const grille = await grilleProduits("accueil");
import Newsletter from "../../islands/Newsletter.tsx";
import {
  api,
  setting,
  assetUrl,
  assetSrcset,
  type Product,
} from "../../lib/api.ts";
import { PAGE_ACCUEIL } from "@memoryline/types";
import {
  estLangue,
  langueDepuisParam,
  lien,
  t,
  type Langue,
} from "../../i18n/utils.ts";

/**
 * Rendue À LA DEMANDE : cette page liste le catalogue, qui change dès qu'une
 * affiche est créée au back-office. Générée au build, elle aurait ignoré les
 * nouveautés jusqu'au build suivant.
 */
export const prerender = false;

// Préfixe de langue inconnu : 404 plutôt que du français à une adresse qui
// n'existe pas.
if (Astro.params.lang !== undefined && !estLangue(Astro.params.lang))
  return new Response(null, { status: 404 });
const langue: Langue = langueDepuisParam(Astro.params.lang);
const tr = t(langue);

/**
 * Page d'accueil.
 *
 * Chaque section est PILOTÉE DEPUIS LE BACK-OFFICE : titre, texte et
 * affichage (on/off) viennent de la table `setting`. Les valeurs passées en
 * second argument de `setting()` sont les replis — le site reste donc complet
 * même si rien n'a jamais été saisi.
 */

let stats = null;
try {
  stats = await api.stats();
} catch {
  // API non joignable au build/SSR -> on dégrade proprement
}

/** Un réglage vaut « activé » sauf s'il est explicitement à "off"/"non"/"0". */
async function visible(cle: string): Promise<boolean> {
  // Un interrupteur ne se traduit pas : on le lit toujours en français, la
  // langue de référence. Sans quoi masquer une section en français la
  // laisserait visible sur /de.
  const v = (await setting(cle, "on")).trim().toLowerCase();
  return !["off", "non", "no", "0", "false"].includes(v);
}

/**
 * Un texte réglable, dans la langue de la page.
 *
 * Le repli vient du dictionnaire, dans la langue de la page : il ne sert que
 * si rien n'a été saisi au back-office, ni dans cette langue ni en français.
 */
const texte = (cle: string, defaut: string) => setting(cle, defaut, langue);

const vitrineVisible = await visible("home.vitrine.visible");
const vitrineTitre = await texte("home.vitrine.title", tr("accueil.vitrine_titre"));
/**
 * Texte d'introduction de la vitrine : une ligne par ligne saisie au
 * back-office. Celles qui commencent par un tiret deviennent une puce, les
 * autres restent des phrases — c'est ce que fait la boutique actuelle, et ça
 * laisse la cliente écrire ce qu'elle veut sans passer par un développeur.
 */
const vitrineTexte = await texte(
  "home.vitrine.subtitle",
  tr("accueil.vitrine_texte"),
);
const vitrineLignes = vitrineTexte
  .split(/\r?\n/)
  .map((l) => l.trim())
  .filter(Boolean)
  .map((l) => ({ puce: /^[-–•]\s*/.test(l), texte: l.replace(/^[-–•]\s*/, "") }));
const vitrineNombre = Math.max(
  1,
  Math.min(24, Number(await setting("home.vitrine.count", "8")) || 8),
);

/**
 * La collection que montre la vitrine, choisie au back-office (« Accueil et
 * pied de page »). Vide : les plus récentes, comme avant que le réglage
 * existe. Ce n'est pas un texte : il vaut pour les cinq langues, et se lit
 * donc en français, la langue de référence.
 */
const vitrineCollection = (
  await setting("home.vitrine.collection", "")
).trim();

/**
 * Les affiches de la vitrine, et elles seules : la page n'en demande que le
 * nombre réglé, là où elle en chargeait soixante pour en garder huit.
 *
 * Une collection se présente dans l'ordre que la propriétaire lui a donné au
 * glisser-déposer — c'est tout l'intérêt de la choisir. « Les plus
 * récentes » demande EXPLICITEMENT les nouveautés : sans tri, l'API sert
 * l'ordre des pages de genre, qui intercale le rang 1 des personnalisables et
 * celui des prêtes à imprimer — un ordre que personne n'a réglé, et que le
 * libellé du back-office démentirait.
 *
 * Une collection qui ne rend rien — désactivée, vidée, supprimée depuis —
 * laisse la place aux plus récentes. La vitrine porte le titre de la page :
 * elle ne doit pas disparaître parce qu'un rayon a été fermé ailleurs.
 */
async function affichesDeLaVitrine(): Promise<Product[]> {
  if (vitrineCollection) {
    try {
      const rayon = await api.catalogue({
        langue,
        collection: vitrineCollection,
        tri: "manuel",
        limite: vitrineNombre,
      });
      if (rayon.items.length) return rayon.items;
    } catch {
      // API muette sur ce rayon : on tente les plus récentes ci-dessous.
    }
  }
  try {
    const rayon = await api.catalogue({
      langue,
      tri: "nouveautes",
      limite: vitrineNombre,
    });
    return rayon.items;
  } catch {
    // Sans API, la vitrine s'efface plutôt que d'afficher une grille vide.
    return [];
  }
}

/*
 * Au stand, la vitrine se montre sans prix : c'est la vignette du rayon
 * (VignetteAffiche.astro) qui s'en charge, comme partout ailleurs — l'accueil
 * est ce qui s'ouvre en premier sur la tablette, et la vendeuse y annonce ses
 * tarifs de salon.
 */
const vitrine = vitrineVisible ? await affichesDeLaVitrine() : [];

/** Intitulé de la lettre d'information, réglable au back-office. */
/**
 * Mise en avant de l'affiche tirée d'une photo.
 *
 * Le bloc ne s'affiche QUE si une image lui a été donnée au back-office :
 * une mise en avant sans visuel est un trou au milieu de la page, et ce
 * produit-là se vend précisément par l'image. Tout le reste — titre, texte,
 * libellé du bouton — se règle sans développeur, comme la vitrine.
 */
const iaVisible = await visible("home.ia.visible");
const iaImage = (await setting("home.ia.image", "")).trim();
const iaTitre = await texte("home.ia.title", tr("accueil.ia_titre"));
const iaTexte = await texte("home.ia.text", tr("accueil.ia_texte"));
const iaBouton = await texte("home.ia.cta", tr("accueil.ia_bouton"));
const iaLien = await setting(
  "home.ia.link",
  "/affiches/affiche-ia-a-partir-de-votre-photo",
);

/*
 * L'ancien ENCART D'ACCUEIL (image, titre, texte, bouton) est devenu le
 * premier des bandeaux visuels, réglés dans l'écran « Bandeaux visuels » du
 * back-office : BandeauxVisuels.astro le montre comme avant tant que la
 * boutique n'a rien enregistré dans cet écran (bandeauDepuisEncart).
 */

const lettreTitre = await texte(
  "home.newsletter.title",
  tr("accueil.lettre_titre"),
);
---

<Base langue={langue}>
  {/* ---------------- Bandeaux visuels ----------------
      Tout en haut, sous l'en-tête et AVANT les affiches — et surtout HORS de
      la condition de la vitrine : à l'intérieur, ils disparaîtraient le jour
      où la cliente masque la vitrine, ou simplement quand l'API ne renvoie
      rien. L'ancien encart d'accueil y est repris (voir plus haut). */}
  <BandeauxVisuels pages={[PAGE_ACCUEIL]} langue={langue} />

  {/* ---------------- Les affiches ---------------- */}
  {
    vitrineVisible && vitrine.length > 0 && (
      <section class="w-full px-4 pt-12 pb-4 sm:px-6 lg:px-12">
        <div class="mb-8 flex flex-wrap items-end justify-between gap-3">
          <div>
            {/* Devenu le titre de la page depuis que le bandeau d'accroche
                a été retiré : une page sans h1 se présente mal aux moteurs
                de recherche. */}
            <h1 class="text-2xl sm:text-3xl">{vitrineTitre}</h1>
            <div class="mt-2 space-y-0.5 text-ink-soft">
              {vitrineLignes.map((l) =>
                l.puce ? (
                  <p class="flex gap-2">
                    <span aria-hidden="true">–</span>
                    <span>{l.texte}</span>
                  </p>
                ) : (
                  <p>{l.texte}</p>
                ),
              )}
            </div>
          </div>
          <a
            href={lien(langue, "/affiches")}
            class="whitespace-nowrap font-medium text-terracotta hover:text-terracotta-deep"
          >
            {tr("catalogue.titre")} →
          </a>
        </div>

        {/* La vignette du rayon, et ses gouttières (affiches.astro) : la
            vitrine avait sa propre copie, avec 24 px entre les affiches, un
            nom en grand et une image chargée en pleine taille, sans choix de
            résolution. Les colonnes, elles, restent celles de l'accueil — la
            page est pleine largeur —, d'où un `sizes` écrit ici, calculé sur
            ces colonnes et ces marges. */}
        <ul
          class="ml-grille-produits -mx-2 gap-x-1 gap-y-5 sm:mx-0 sm:gap-x-2 sm:gap-y-8"
          style={styleGrille(grille)}
        >
          {vitrine.map((p, rang) => (
            <VignetteAffiche
              affiche={p}
              langue={langue}
              prioritaire={rang < 4}
              sizes={sizesGrille(grille)}
            />
          ))}
        </ul>

        {/* La vitrine ne montre qu'une partie du catalogue : le bouton dit
            où trouver le reste, sans avoir à remonter en haut de page. */}
        <div class="mt-12 flex justify-center">
          <a
            href={lien(langue, "/affiches")}
            class="border border-ink px-8 py-3 font-medium hover:bg-ink hover:text-paper transition-colors"
          >
            {tr("accueil.tout_afficher")}
          </a>
        </div>
      </section>
    )
  }

  {
    /* ---------------- L'affiche à partir d'une photo ---------------- */
    iaVisible && iaImage && (
      <section class="mt-16 border-t border-ink/10">
        <div
          class="mx-auto grid max-w-[1200px] items-center gap-10 px-6 py-14 lg:grid-cols-2 lg:px-12"
        >
          {/* `assetUrl` et pas l'adresse brute : « /assets/… » se
              résoudrait sinon sur l'origine du site, qui ne sert aucun
              /assets — l'image serait cassée dès que la cliente en pose une.
              Le srcset laisse un téléphone télécharger la version qu'il
              affiche, pas celle d'un grand écran. */}
          <img
            src={assetUrl(iaImage) ?? iaImage}
            srcset={assetSrcset(iaImage, [400, 600, 900, 1400])}
            sizes="(min-width: 1024px) 50vw, 100vw"
            alt={iaTitre}
            loading="lazy"
            class="w-full object-cover"
          />
          <div>
            <h2 class="text-3xl leading-tight">{iaTitre}</h2>
            <p class="mt-4 text-lg leading-relaxed text-ink-soft">{iaTexte}</p>
            <a
              href={iaLien.startsWith("http") ? iaLien : lien(langue, iaLien)}
              class="mt-8 inline-block bg-ink px-8 py-3 font-medium text-paper transition-colors hover:bg-ink/85"
            >
              {iaBouton}
            </a>
          </div>
        </div>
      </section>
    )
  }

  {/* ---------------- Lettre d'information ---------------- */}
  <section class="mt-16 border-t border-ink/10">
    <div class="mx-auto max-w-[1200px] px-6 py-14 text-center lg:px-12">
      <h2 class="text-2xl">{lettreTitre}</h2>
      <Newsletter client:visible langue={langue} />
    </div>
  </section>
</Base>
