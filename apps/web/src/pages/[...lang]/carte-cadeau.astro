---
/**
 * La carte cadeau, vendue sur le site (17/11).
 *
 * Pas une fiche du catalogue : le montant est LIBRE (5 € au moins, en euros
 * ronds, sans plafond annoncé depuis le 18/11), il n'y a ni format, ni prix
 * à régler, ni stock, et la carte ne se
 * range parmi aucune affiche. Une ligne de la table des produits aurait
 * traîné partout la logique des affiches — formats, cadres, poids, fichiers
 * d'impression, listes, référencement — avec autant d'exceptions à écrire.
 * La page existe donc dès la mise en ligne, dans les cinq langues, et la
 * boutique y mène depuis son menu (BO › Menu) : « /carte-cadeau ».
 *
 * Ce qu'elle dit, et ce que le serveur fait : la carte part par e-mail dès le
 * paiement, sans frais de port ; elle s'utilise en une ou plusieurs fois, le
 * solde restant reste sur le même code. Le destinataire, son prénom et le
 * petit mot se donnent à la caisse.
 *
 * Au stand, la carte ne se vend pas (le stand encaisse de la main à la main,
 * la carte part après un paiement en ligne) : la page le dit, sans bouton.
 */
import Base from "../../layouts/Base.astro";
import { titreDePage } from "../../lib/textes-seo.ts";
import { setting } from "../../lib/api.ts";
import { montantsProposes } from "@memoryline/types";
import CarteCadeauIsland, { LIBELLES_CARTE } from "../../islands/CarteCadeauIsland.tsx";
import {
  LOCALE_COMPLETE,
  estLangue,
  langueDepuisParam,
  libelles,
  lien,
  t,
  type Langue,
} from "../../i18n/utils.ts";

export const prerender = false;

if (Astro.params.lang !== undefined && !estLangue(Astro.params.lang))
  return new Response(null, { status: 404 });
const langue: Langue = langueDepuisParam(Astro.params.lang);
const tr = t(langue);
const auStand = Astro.locals.stand;

/*
 * Les textes et les montants proposés se règlent au BO (18/11, Contenu du
 * site › Carte cadeau) ; un texte laissé vide garde celui du dictionnaire,
 * dans la langue de la page.
 */
const reglage = (cle: string, defaut: string) => setting(`carte_cadeau.${cle}`, defaut, langue);
const [titre, intro, point1, point2, point3, description, montantsSaisis] = await Promise.all([
  reglage("titre", tr("carte.page.titre")),
  reglage("intro", tr("carte.page.intro")),
  reglage("point1", tr("carte.page.envoi")),
  reglage("point2", tr("carte.page.solde")),
  reglage("point3", tr("carte.page.destinataire")),
  reglage("description", tr("carte.page.description")),
  setting("carte_cadeau.montants", ""),
]);
const montants = montantsProposes(montantsSaisis);
---

<Base
  langue={langue}
  title={titreDePage(titre)}
  description={description}
  path={lien(langue, "/carte-cadeau")}
  image="/carte-cadeau/partage.jpg"
  imageInfos={{ largeur: 1200, hauteur: 630, alt: `${tr("carte.titre")} Memory Line` }}
>
  <section class="mx-auto max-w-[1200px] px-4 sm:px-6 pt-12 pb-16">
    <nav class="text-sm text-ink-soft">
      <a href={lien(langue, "/")} class="hover:text-terracotta">Memory Line</a> ·
      <a href={lien(langue, "/affiches")} class="hover:text-terracotta">{tr("nav.affiches")}</a>
    </nav>
    <div class="mt-6 grid items-start gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
      {/* La carte elle-même : l'image faite par Alexandra (18/11), déclinée
          en WebP léger dans public/carte-cadeau/ (480, 800 et 1200 px). */}
      <img
        src="/carte-cadeau/carte-cadeau-800.webp"
        srcset="/carte-cadeau/carte-cadeau-480.webp 480w, /carte-cadeau/carte-cadeau-800.webp 800w, /carte-cadeau/carte-cadeau-1200.webp 1200w"
        sizes="(min-width: 1024px) 560px, calc(100vw - 32px)"
        width="1200"
        height="1200"
        alt={`${titre} Memory Line`}
        fetchpriority="high"
        class="ml-image-attente mx-auto w-full max-w-[560px] rounded-2xl border border-ink/10 shadow-sm"
      />

      <div>
        <h1 class="text-3xl sm:text-4xl">{titre}</h1>
        <p class="mt-4 whitespace-pre-line text-lg text-ink-soft">{intro}</p>
        <ul class="mt-6 space-y-2 text-sm">
          {[point1, point2, point3].filter((p) => p.trim()).map((point) => (
            <li class="flex gap-3">
              <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-terracotta" aria-hidden="true" />
              <span>{point}</span>
            </li>
          ))}
        </ul>
        <div class="mt-8">
          <CarteCadeauIsland
            client:load
            langue={langue}
            locale={LOCALE_COMPLETE[langue]}
            libelles={libelles(langue, LIBELLES_CARTE)}
            montants={montants}
            adresseCommande={lien(langue, "/commande")}
            adressePanier={lien(langue, "/panier")}
            stand={auStand}
          />
        </div>
      </div>
    </div>
  </section>
</Base>
