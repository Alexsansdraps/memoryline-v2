---
/**
 * Ancienne adresse du ciel étoilé (26/11) : il a désormais sa propre fiche,
 * /affiches/ciel-etoile (« c'est 2 produits différents »). On y renvoie.
 */
import { estLangue, langueDepuisParam, lien, type Langue } from "../../i18n/utils.ts";

export const prerender = false;

if (Astro.params.lang !== undefined && !estLangue(Astro.params.lang))
  return new Response(null, { status: 404 });
const langue: Langue = langueDepuisParam(Astro.params.lang);
return Astro.redirect(lien(langue, "/affiches/ciel-etoile"), 301);
---
