---
/**
 * Les pages écrites depuis le back-office.
 *
 * C'est la sortie du contenu éditable : la boutique crée « Magnets », y pose
 * un texte, une image et une grille de produits, et cette page l'affiche. Elle
 * ne connaît que cinq formes de bloc, et refuse tout le reste en silence
 * plutôt que d'afficher un morceau de page cassé.
 *
 * L'adresse porte le préfixe « /pages/ », et ce n'est pas un choix esthétique.
 * Posée à la racine, cette route se glissait devant les accueils traduits :
 * pour « /en », le routeur préfère un segment nommé à un segment de reste, et
 * l'anglais tombait en page introuvable. Le préfixe lève l'ambiguïté sans
 * toucher à l'accueil, qui est la page qu'on casse en dernier.
 *
 * Une adresse inconnue rend une page introuvable, jamais une page vide.
 */
import Base from "../../../layouts/Base.astro";
import BandeauxVisuels from "../../../components/BandeauxVisuels.astro";
import VignetteAffiche from "../../../components/VignetteAffiche.astro";
import { api, assetSrcset, assetUrl, codeErreurApi, type PageCms } from "../../../lib/api.ts";
import { pageLibre } from "@memoryline/types";
import {
  grilleProduits,
  sizesGrille,
  sizesGrilleColonne,
  styleGrille,
} from "../../../lib/grille.ts";
/** Colonnes réglées au back-office (Contenu du site › Affichage des produits) :
 *  celles des pages du site s'il y en a, le réglage général sinon. */
const grille = await grilleProduits("pages");
/**
 * La page d'un stand, sur sa tablette (18/11 : « les pages stands doivent être
 * en grand ») : toute la largeur de l'écran et de grandes vignettes, deux par
 * ligne sur une tablette tenue en hauteur, trois en largeur. Hors du stand, la
 * page garde sa colonne de lecture et les colonnes réglées au back-office.
 */
const enGrand = !!Astro.locals.stand;
const grilleAffichee = enGrand ? { mobile: 2, tablette: 2, ordinateur: 3 } : grille;
const sizesVignettes = enGrand ? sizesGrille(grilleAffichee) : sizesGrilleColonne(grille);
import { htmlSur } from "../../../lib/html-sur.ts";
import { languesDuContenu } from "../../../lib/referencement.ts";
import {
  descriptionMeta,
  separateurDuSite,
  texteBrut,
  titreDePage,
} from "../../../lib/textes-seo.ts";
import {
  estLangue,
  langueDepuisParam,
  lien,
  t,
  type Langue,
} from "../../../i18n/utils.ts";

/** Le contenu vient de la base : le figer au build le gèlerait. */
export const prerender = false;

if (Astro.params.lang !== undefined && !estLangue(Astro.params.lang))
  return new Response(null, { status: 404 });
const langue: Langue = langueDepuisParam(Astro.params.lang);
const tr = t(langue);

const slug = Astro.params.slug ?? "";

/** La personne du back-office qui regarde, résolue par le middleware. */
const admin = Astro.locals.admin ?? null;
/** Le back-office vit sous /bo derrière le proxy ; surchargeable en prod. */
const lienBackOffice = import.meta.env.PUBLIC_BO_URL ?? "/bo";
let page: PageCms | null = null;
try {
  page = await api.page(slug, langue, Astro.locals.stand);
} catch (e) {
  // Page absente ou brouillon : elle n'existe pas pour le visiteur, et le
  // dire est plus honnête qu'un cadre vide qui laisserait croire à une panne
  // d'affichage. API muette, en revanche, ce n'est pas « introuvable » : un
  // 404 ferait sortir de Google, en quelques passages de robot, une page
  // légale bien vivante. 503 — « reviens plus tard ».
  if (codeErreurApi(e) !== 404) {
    Astro.locals.statutErreur = 503;
    return Astro.rewrite("/404");
  }
  page = null;
}
if (!page) return new Response(null, { status: 404 });

/** Une adresse écrite dans un bloc, prête à être cliquée. */
function adresse(href: string): string {
  if (/^https?:\/\//i.test(href)) return href;
  const [chemin, requete] = href.split("?");
  return lien(langue, chemin || "/") + (requete ? `?${requete}` : "");
}

/**
 * Une affiche d'un bloc « produits », dans la forme qu'attend la vignette du
 * site (VignetteAffiche.astro) — celle du rayon, de l'accueil et de la
 * recherche.
 *
 * La rangée d'une page avait sa vignette à elle : rapport 3/4, nom avec son
 * suffixe « - Affiche personnalisée », image en pleine taille, prix en maigre.
 * Elle ne suivait donc aucune des retouches des autres grilles, la police
 * des produits comprise. Au stand, la vignette tait les prix d'elle-même,
 * comme partout ailleurs sur la tablette.
 */
function enVignette(p: Record<string, unknown>) {
  return {
    slug: String(p.slug ?? ""),
    name: String(p.name ?? ""),
    image: typeof p.image === "string" ? p.image : null,
    basePriceCents: Number(p.basePriceCents) || 0,
    variants: Array.isArray(p.variants)
      ? (p.variants as { priceCents: number }[])
      : [],
  };
}

/** Sans accents ni capitales : « Ribeauvillé » se trouve en tapant « ribeauville ». */
function aplatir(texte: string): string {
  return texte
    .normalize("NFD")
    .replace(/[̀-ͯ]/g, "")
    .toLowerCase()
    .trim();
}

/** Une affiche d'une rangée « affiches », telle que l'API la rend. */
type AfficheChoisie = Record<string, unknown> & { id?: unknown; lieu?: unknown; rayons?: unknown };

/**
 * Ce que les filtres de la page lisent sur une vignette (18/11) : le nom
 * (dans la langue de la page) et le lieu, aplatis pour la recherche ; le lieu
 * exact pour la liste des lieux ; les rayons de l'affiche.
 */
function donneesDuFiltre(p: AfficheChoisie): Record<string, string> {
  const lieu = String(p.lieu ?? "");
  return {
    nom: aplatir(`${String(p.name ?? "")} ${lieu}`),
    lieu,
    rayons: Array.isArray(p.rayons) ? p.rayons.map(String).join(" ") : "",
  };
}

/** Les lieux d'une rangée, avec leur nombre d'affiches, par ordre alphabétique. */
function lieuxDe(produits: AfficheChoisie[]): { nom: string; nombre: number }[] {
  const comptes = new Map<string, number>();
  for (const p of produits) {
    const lieu = String(p.lieu ?? "").trim();
    if (lieu) comptes.set(lieu, (comptes.get(lieu) ?? 0) + 1);
  }
  return [...comptes.entries()]
    .map(([nom, nombre]) => ({ nom, nombre }))
    .sort((a, b) => a.nom.localeCompare(b.nom, "fr"));
}

/*
 * Le titre et la description SEO arrivent dans la langue de la page : la
 * boutique les traduit au back-office comme le titre et les blocs. Hors du
 * français, non traduits, l'API les rend null — jamais le français. Le titre
 * traduit fait alors l'onglet, et la description du site (dans la langue de
 * la page) remplace celle qui serait restée en français.
 *
 * Sans description SEO, la page n'a plus la phrase générique du site — la
 * même que l'accueil et les rayons — mais le début de son propre texte, coupé
 * à la fin d'une phrase ou d'un mot. Seulement quand ce texte est dans la
 * langue de la page : une page légale non traduite sous /en garde la phrase
 * anglaise du site plutôt que du français.
 */
const titreOnglet = page.seoTitle?.trim()
  ? separateurDuSite(page.seoTitle.trim())
  : titreDePage(page.title);
const premierTexte = languesDuContenu(page.languesTraduites).includes(langue)
  ? texteBrut(
      page.blocks
        .filter((b) => b.type === "texte")
        .map((b) => String(b.html ?? ""))
        .join(" "),
    )
  : "";
// La description SEO saisie passe elle aussi par la coupe à 155 caractères :
// celle que Shopify générait pour ses pages (reprise telle quelle pour
// « Affiches personnalisables ») fait 321 caractères, coupée en plein mot.
// Une description qui tient dans la limite passe intacte.
const descriptionPage =
  descriptionMeta(page.seoDescription) || descriptionMeta(premierTexte) || undefined;
---

<Base
  langue={langue}
  title={titreOnglet}
  description={descriptionPage}
  path={lien(langue, `/pages/${page.slug}`)}
  languesTraduites={page.languesTraduites}
>
  {/* Les bandeaux visuels choisis pour cette page, bord à bord sous
      l'en-tête, hors de la colonne de lecture. */}
  <BandeauxVisuels pages={[pageLibre(page.slug)]} langue={langue} />
  <article
    class={enGrand
      ? "mx-auto max-w-[1600px] px-2 py-8 sm:px-6 lg:px-10"
      : "mx-auto max-w-[1000px] px-6 py-12 lg:px-12"}
  >
    <div class="flex flex-wrap items-center justify-between gap-3">
      <h1 class="text-3xl sm:text-4xl">{page.title}</h1>
      {/* Le raccourci d'édition, pour la boutique seulement.
          Lire une coquille sur une page légale et devoir ouvrir le
          back-office, trouver la liste des pages, retrouver la bonne : trois
          écrans pour corriger un mot. Ce crayon-ci mène droit à l'éditeur.
          Un visiteur ne le voit pas, et n'apprend pas qu'il existe. */}
      {admin && (
        <a
          href={`${lienBackOffice}/pages/${page.id}`}
          rel="nofollow"
          class="inline-flex shrink-0 items-center gap-1.5 border border-ink/15 px-3 py-1.5 text-[13px] text-ink/60 transition-colors hover:border-terracotta/40 hover:text-terracotta"
        >
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M12 20h9" />
            <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" />
          </svg>
          Modifier cette page
        </a>
      )}
    </div>

    {
      page.blocks.map((bloc, rang) => {
        if (bloc.type === "titre") {
          const texte = String(bloc.texte ?? "");
          return bloc.niveau === 3 ? (
            <h3 class="mt-10 text-xl font-medium">{texte}</h3>
          ) : (
            <h2 class="mt-12 text-2xl font-medium">{texte}</h2>
          );
        }

        if (bloc.type === "texte") {
          return (
            <div
              class="ml-page-texte mt-6 leading-relaxed text-ink-soft"
              set:html={htmlSur(String(bloc.html ?? ""))}
            />
          );
        }

        if (bloc.type === "image") {
          /*
           * L'image servie à la taille de la colonne, comme partout ailleurs
           * sur le site : c'était l'original, jusqu'à un mégaoctet et demi,
           * même sur un téléphone. La colonne fait 1000 px au plus, moins
           * ses marges (24 px de chaque côté, 48 dès 1024 px d'écran).
           *
           * Ses dimensions réelles viennent de l'API (dimensions-visuels.ts) :
           * la place est réservée avant que l'image arrive. Sans elles, une
           * image chargée au fil du défilement faisait sauter le texte qui la
           * suit — un décalage que Google compte (CLS). Une image venue
           * d'un autre site n'en a pas : elle s'affiche en entier, comme
           * avant.
           */
          const url = String(bloc.url ?? "");
          const src = assetUrl(url, 1400);
          if (!src) return null;
          const mesuree = typeof bloc.largeur === "number" && typeof bloc.hauteur === "number";
          const largeur = mesuree ? Number(bloc.largeur) : undefined;
          const hauteur = mesuree ? Number(bloc.hauteur) : undefined;
          const jeu = assetSrcset(url, [600, 900, 1400], largeur);
          const legende = String(bloc.legende ?? "");
          return (
            <figure class="mt-10">
              <img
                src={src}
                srcset={jeu}
                sizes={
                  jeu
                    ? "(min-width: 1024px) 904px, (min-width: 1000px) 952px, calc(100vw - 48px)"
                    : undefined
                }
                width={largeur}
                height={hauteur}
                alt={String(bloc.alt ?? "")}
                loading="lazy"
                decoding="async"
                class="ml-image-attente h-auto w-full rounded-lg"
              />
              {legende && (
                <figcaption class="mt-2 text-sm text-ink-soft">
                  {legende}
                </figcaption>
              )}
            </figure>
          );
        }

        if (bloc.type === "bouton") {
          return (
            <p class="mt-8">
              <a
                href={adresse(String(bloc.href ?? "/"))}
                class="inline-block rounded-full bg-ink px-6 py-3 text-paper transition-opacity hover:opacity-90"
              >
                {String(bloc.texte ?? "")}
              </a>
            </p>
          );
        }

        /*
         * Des affiches choisies une à une (18/11) — la page d'un stand : la
         * grille dans l'ordre choisi, en une liste ou par collection, et des
         * filtres au-dessus (recherche par nom ou lieu, lieu, collection).
         * Les filtres travaillent dans la page, sans la recharger : la
         * tablette a toutes ses affiches sous la main.
         */
        if (bloc.type === "produits" && bloc.source === "affiches") {
          const produits = (Array.isArray(bloc.produits) ? bloc.produits : []) as AfficheChoisie[];
          if (!produits.length) return null;
          const parId = new Map(produits.map((p) => [Number(p.id), p]));
          const groupes = (Array.isArray(bloc.groupes) ? bloc.groupes : []) as {
            collection: string;
            titre: string | null;
            produits: number[];
          }[];
          const rayons = (Array.isArray(bloc.rayons) ? bloc.rayons : []) as {
            slug: string;
            nom: string;
          }[];
          const lieux = lieuxDe(produits);
          const titresDeSection = groupes.some((g) => !!g.titre);
          const intertitreAuDessus =
            titresDeSection ||
            page!.blocks
              .slice(0, rang)
              .some(
                (b) =>
                  b.type === "titre" ||
                  (b.type === "texte" && /<h2[\s>]/i.test(String(b.html ?? ""))),
              );
          const vignette = (p: AfficheChoisie) => (
            <VignetteAffiche
              affiche={enVignette(p)}
              langue={langue}
              sizes={sizesVignettes}
              titre={intertitreAuDessus ? "h3" : "h2"}
              donnees={donneesDuFiltre(p)}
            />
          );
          const classeGrille =
            "ml-grille-produits -mx-2 gap-x-1 gap-y-5 sm:mx-0 sm:gap-x-2 sm:gap-y-8";
          const unSeul = new Intl.PluralRules(langue).select(produits.length) === "one";
          return (
            <div
              class="mt-8"
              data-affiches-page
              data-compte-un={tr("catalogue.compte_un")}
              data-compte={tr("catalogue.compte_simple")}
            >
              {produits.length > 1 && (
                <div class="flex flex-wrap items-center gap-x-4 gap-y-2 border-y border-ink/10 py-3">
                  <input
                    type="search"
                    data-filtre-texte
                    autocomplete="off"
                    placeholder={tr("page.filtre.chercher")}
                    aria-label={tr("page.filtre.chercher")}
                    class="min-w-0 flex-1 basis-72 border border-ink/20 bg-paper px-3 py-2 text-sm"
                  />
                  {lieux.length > 1 && (
                    <label class="flex items-center gap-2 text-sm text-ink-soft">
                      {tr("catalogue.ville")}
                      <select
                        data-filtre-lieu
                        class="min-w-0 max-w-[min(14rem,60vw)] border border-ink/20 bg-paper px-3 py-2 text-sm text-ink"
                      >
                        <option value="">{tr("catalogue.toutes_villes")}</option>
                        {lieux.map((l) => (
                          <option value={l.nom}>
                            {l.nom} ({l.nombre})
                          </option>
                        ))}
                      </select>
                    </label>
                  )}
                  {rayons.length > 1 && (
                    <label class="flex items-center gap-2 text-sm text-ink-soft">
                      {tr("page.filtre.rayon")}
                      <select
                        data-filtre-rayon
                        class="min-w-0 max-w-[min(14rem,60vw)] border border-ink/20 bg-paper px-3 py-2 text-sm text-ink"
                      >
                        <option value="">{tr("page.filtre.tous_rayons")}</option>
                        {rayons.map((r) => (
                          <option value={r.slug}>{r.nom}</option>
                        ))}
                      </select>
                    </label>
                  )}
                  <button
                    type="button"
                    data-filtre-effacer
                    hidden
                    class="border border-ink/20 px-3 py-2 text-sm transition-colors hover:border-ink"
                  >
                    {tr("page.filtre.effacer")}
                  </button>
                  <p data-filtre-compte class="ml-auto text-sm text-ink-soft" aria-live="polite">
                    {produits.length} {unSeul ? tr("catalogue.compte_un") : tr("catalogue.compte_simple")}
                  </p>
                </div>
              )}
              {groupes.length ? (
                groupes.map((g) => (
                  <section data-section class="mt-8">
                    {g.titre && <h2 class="text-2xl font-medium">{g.titre}</h2>}
                    <ul class={`${classeGrille} mt-6`} style={styleGrille(grilleAffichee)}>
                      {g.produits
                        .map((id) => parId.get(Number(id)))
                        .filter((p): p is AfficheChoisie => !!p)
                        .map(vignette)}
                    </ul>
                  </section>
                ))
              ) : (
                <ul class={`${classeGrille} mt-6`} style={styleGrille(grilleAffichee)}>
                  {produits.map(vignette)}
                </ul>
              )}
              <p data-filtre-vide hidden class="mt-6 text-ink-soft">
                {tr("recherche.aucun")}
              </p>
            </div>
          );
        }

        if (bloc.type === "produits") {
          const produits = Array.isArray(bloc.produits) ? bloc.produits : [];
          if (!produits.length) return null;
          // Le nom de chaque affiche se range sous l'intertitre qui précède
          // la rangée (h3) ; sans intertitre au-dessus, directement sous le
          // titre de la page (h2) — un h3 sans h2 ferait sauter un niveau.
          const intertitreAuDessus = page!.blocks
            .slice(0, rang)
            .some(
              (b) =>
                b.type === "titre" ||
                (b.type === "texte" && /<h2[\s>]/i.test(String(b.html ?? ""))),
            );
          // Les gouttières des autres grilles du site (affiches.astro), et
          // leur nombre de colonnes : celui des pages du site, réglé au
          // back-office.
          return (
            <ul
              class="ml-grille-produits mt-10 -mx-2 gap-x-1 gap-y-5 sm:mx-0 sm:gap-x-2 sm:gap-y-8"
              style={styleGrille(grilleAffichee)}
            >
              {produits.map((p) => (
                <VignetteAffiche
                  affiche={enVignette(p)}
                  langue={langue}
                  sizes={sizesVignettes}
                  titre={intertitreAuDessus ? "h3" : "h2"}
                />
              ))}
            </ul>
          );
        }

        // Un genre de bloc que cette version du site ne sait pas dessiner :
        // on le saute. Mieux vaut une page incomplète qu'une page en erreur.
        return null;
      })
    }
  </article>

  <script is:inline>
    // Les filtres d'une page d'affiches choisies (18/11) : la recherche par
    // nom ou lieu (accents et capitales mis de côté, chaque mot doit s'y
    // trouver), le lieu, la collection. Les vignettes écartées se cachent ;
    // une section vidée aussi. Sans JavaScript, toutes restent visibles.
    (function () {
      function aplatir(s) {
        return String(s || "").normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase().trim();
      }
      var langue = document.documentElement.lang || "fr";
      var regles;
      try {
        regles = new Intl.PluralRules(langue);
      } catch (e) {
        regles = new Intl.PluralRules("fr");
      }
      document.querySelectorAll("[data-affiches-page]").forEach(function (bloc) {
        var texte = bloc.querySelector("[data-filtre-texte]");
        if (!texte) return;
        var lieu = bloc.querySelector("[data-filtre-lieu]");
        var rayon = bloc.querySelector("[data-filtre-rayon]");
        var effacer = bloc.querySelector("[data-filtre-effacer]");
        var compte = bloc.querySelector("[data-filtre-compte]");
        var vide = bloc.querySelector("[data-filtre-vide]");
        var vignettes = Array.prototype.slice.call(bloc.querySelectorAll("li[data-nom]"));
        var sections = Array.prototype.slice.call(bloc.querySelectorAll("[data-section]"));
        var un = bloc.getAttribute("data-compte-un") || "";
        var plusieurs = bloc.getAttribute("data-compte") || "";
        function appliquer() {
          var mots = aplatir(texte.value).split(/\s+/).filter(Boolean);
          var l = lieu ? lieu.value : "";
          var r = rayon ? rayon.value : "";
          var n = 0;
          vignettes.forEach(function (li) {
            var cle = li.getAttribute("data-nom") || "";
            var ok =
              mots.every(function (m) {
                return cle.indexOf(m) !== -1;
              }) &&
              (!l || li.getAttribute("data-lieu") === l) &&
              (!r || (" " + (li.getAttribute("data-rayons") || "") + " ").indexOf(" " + r + " ") !== -1);
            li.hidden = !ok;
            if (ok) n++;
          });
          sections.forEach(function (s) {
            s.hidden = !s.querySelector("li[data-nom]:not([hidden])");
          });
          if (compte) compte.textContent = n + " " + (regles.select(n) === "one" ? un : plusieurs);
          if (vide) vide.hidden = n > 0;
          if (effacer) effacer.hidden = !(mots.length || l || r);
        }
        texte.addEventListener("input", appliquer);
        if (lieu) lieu.addEventListener("change", appliquer);
        if (rayon) rayon.addEventListener("change", appliquer);
        if (effacer)
          effacer.addEventListener("click", function () {
            texte.value = "";
            if (lieu) lieu.value = "";
            if (rayon) rayon.value = "";
            appliquer();
            texte.focus();
          });
        // Un retour arrière peut rendre la page avec les champs déjà remplis.
        appliquer();
      });
    })();
  </script>
</Base>

<style is:global>
  /* Le texte vient de l'éditeur visuel : paragraphes, listes, gras, italique,
     liens, images — et, pour les pages qui sont de vrais documents, deux
     niveaux de titre.

     Ces deux règles-là reprennent au mot près l'allure qu'avaient les anciens
     blocs « titre » (mt-12 text-2xl / mt-10 text-xl, en font-medium) : les
     conditions de vente ne doivent pas changer d'aspect le jour où leurs
     quatorze intertitres cessent d'être des blocs pour devenir du texte. La
     couleur, elle, est rendue explicitement : le cadre porte « text-ink-soft »
     pour le corps, et un titre qui en hériterait paraîtrait effacé. */
  .ml-page-texte h2 {
    margin: 3rem 0 0;
    font-size: 1.5rem;
    line-height: 2rem;
    font-weight: 500;
    color: var(--color-ink, currentColor);
  }
  .ml-page-texte h3 {
    margin: 2.5rem 0 0;
    font-size: 1.25rem;
    line-height: 1.75rem;
    font-weight: 500;
    color: var(--color-ink, currentColor);
  }
  /* Un titre suivi de son paragraphe ne doit pas cumuler les deux marges :
     l'espace au-dessus du titre sépare les sections, celui du paragraphe
