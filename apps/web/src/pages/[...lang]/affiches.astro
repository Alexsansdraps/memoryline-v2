---
import Base from "../../layouts/Base.astro";
import BandeauxVisuels from "../../components/BandeauxVisuels.astro";
import VignetteAffiche from "../../components/VignetteAffiche.astro";
import VignetteCarteCadeau from "../../components/VignetteCarteCadeau.astro";
import { api, assetUrl, bandeauxVisuels, type Collection, type Product } from "../../lib/api.ts";
import { RAYONS_FUSIONNES } from "../../lib/anciennes-adresses.ts";
import { htmlSur } from "../../lib/html-sur.ts";
import { adresseDuRayon, estGenre, languesDuContenu } from "../../lib/referencement.ts";
import {
  DESCRIPTION_MAX,
  descriptionMeta,
  nommeDejaUneAffiche,
  texteBrut,
  titreDePage,
} from "../../lib/textes-seo.ts";
import { clesPageAffiches, filDAriane, pageDeRayon } from "@memoryline/types";
import { grilleProduits, sizesGrille, styleGrille } from "../../lib/grille.ts";
/** Colonnes réglées au back-office (Contenu du site › Affichage des produits) :
 *  celles de la boutique s'il y en a — tous les rayons et collections —, le
 *  réglage général sinon. */
const grille = await grilleProduits("boutique", { stand: Astro.locals.stand });
import {
  LOCALE_COMPLETE,
  estLangue,
  langueDepuisParam,
  lien,
  t,
  type Langue,
} from "../../i18n/utils.ts";

/**
 * Rendue À LA DEMANDE : cette page liste le catalogue, qui change dès qu'une
 * affiche est créée au back-office. Générée au build, elle aurait ignoré les
 * nouveautés jusqu'au build suivant.
 */
export const prerender = false;

// Préfixe de langue inconnu : 404 plutôt que du français à une adresse qui
// n'existe pas.
if (Astro.params.lang !== undefined && !estLangue(Astro.params.lang))
  return new Response(null, { status: 404 });
const langue: Langue = langueDepuisParam(Astro.params.lang);
const tr = t(langue);

/**
 * Le rayon demandé, lu dans l'adresse.
 *
 * « genre » sépare les affiches à composer des affiches prêtes à imprimer,
 * « collection » découpe les premières en villes et en paysages. Les deux sont
 * facultatifs : sans eux, la page montre tout, comme avant.
 *
 * Un genre inconnu (« ?genre=foo ») ne filtre rien : il est ignoré ici, et
 * l'adresse est redressée plus bas vers la forme qui ne le porte pas — sans
 * quoi elle se déclarait canonique, doublon exact du catalogue.
 */
const genreDemande = Astro.url.searchParams.get("genre") ?? "";
const genre = estGenre(genreDemande) ? genreDemande : "";
const collectionDemandee = Astro.url.searchParams.get("collection") ?? "";

/*
 * Les rayons techniques de Shopify (« Page d'accueil / En vedette », « Tout
 * voir », « Personnages de dos »…) et celui qui double la page d'un genre :
 * leur page ferait doublon avec une page qui existe déjà, elle y mène donc
 * pour de bon. La liste, et ce que chacun devient, est dans
 * lib/anciennes-adresses.ts.
 */
const fusion = collectionDemandee ? RAYONS_FUSIONNES[collectionDemandee] : undefined;
if (fusion) return Astro.redirect(lien(langue, fusion), 301);

/**
 * Combien d'affiches par page.
 *
 * Quarante-huit, soit douze rangées de quatre sur un grand écran et vingt-quatre
 * de deux sur un téléphone : assez pour qu'on ait envie de faire défiler,
 * assez peu pour que la page arrive vite. Cinq cents d'un coup, c'était près de
 * cinq cents images à charger pour voir la première.
 */
const PAR_PAGE = 48;

/**
 * Les tris proposés, dans l'ordre où ils s'offrent.
 *
 * « manuel » est l'ordre que la propriétaire a réglé au back-office (Produits
 * › Ordre d'affichage). Il est le tri par défaut — elle range ses affiches
 * pour que ce rangement se voie.
 */
const TRIS = ["nouveautes", "prix_asc", "prix_desc", "alpha"] as const;
/*
 * « Ordre de la boutique » est proposé — et choisi par défaut — sur TOUTES les
 * pages de liste : une collection, les pages d'un genre (« Affiches
 * personnalisables », « prêtes à imprimer ») et « Toutes les affiches », lieu
 * filtré compris. Chacune a son ordre, réglé au back-office ; tant que rien
 * n'y est rangé, cet ordre EST celui des nouveautés, et rien ne change pour
 * les clientes. (Cette page n'a pas de recherche par mots : une recherche,
 * elle, se trierait par pertinence, pas par un rangement fait pour une page.)
 */
const pageRangeable = true;
/*
 * Au stand, pas de tri par prix : les vignettes n'en montrent aucun, et un
 * rayon rangé « du moins cher au plus cher » sans un chiffre à l'écran ne se
 * comprend pas — il trahirait en plus l'écart que la vendeuse ne dit pas.
 */
const trisDuMode: readonly string[] = Astro.locals.stand
  ? TRIS.filter((t) => t !== "prix_asc" && t !== "prix_desc")
  : TRIS;
const trisOfferts: readonly string[] = pageRangeable
  ? ["manuel", ...trisDuMode]
  : trisDuMode;
const triParDefaut = pageRangeable ? "manuel" : "nouveautes";

/**
 * La ville demandée.
 *
 * Elle vient du nom de l'affiche, où la boutique l'écrit en capitales depuis
 * toujours — « AMIENS Cathédrale », « BAIE DE SOMME Phoques ». Aucune
 * validation ici : une ville inconnue ne trouve simplement rien, et l'écran
 * le dit, plutôt que de renvoyer une erreur sur une adresse qu'un visiteur
 * peut avoir recopiée de travers.
 */
const villeDemandee = Astro.url.searchParams.get("ville") ?? "";
/**
 * Le lieu qui filtre vraiment : aucun sur les prêtes à imprimer, qui ne sont
 * pas des affiches de lieu — le filtre n'y existe pas, une adresse recopiée
 * à la main ne doit pas le faire réapparaître, ni dans la grille ni dans
 * l'adresse canonique.
 */
const villeEffective = genre === "prete_a_imprimer" ? "" : villeDemandee;

const triDemande = Astro.url.searchParams.get("tri") ?? "";
const tri = trisOfferts.includes(triDemande)
  ? triDemande
  : triParDefaut;

/**
 * La page demandée. Une valeur illisible ou négative vaut la première : c'est
 * une adresse, un visiteur a le droit de l'avoir tapée de travers.
 */
const pageDemandee = Math.max(
  Math.trunc(Number(Astro.url.searchParams.get("page") ?? 1)) || 1,
  1,
);

let products: Product[] = [];
let total = 0;
let collections: Collection[] = [];
let villes: { nom: string; nombre: number }[] = [];
let error: string | null = null;
try {
  const [rayon, listeCollections, listeVilles] = await Promise.all([
    api.catalogue({
      langue,
      genre: genre || undefined,
      collection: collectionDemandee || undefined,
      ville: villeEffective || undefined,
      tri,
      limite: PAR_PAGE,
      offset: (pageDemandee - 1) * PAR_PAGE,
    }),
    // Sert à nommer le rayon en titre : le nom vient de la boutique, pas
    // d'une table de correspondance écrite en dur ici — et dans la langue de
    // la page, quand elle l'a traduit (le français sinon).
    //
    // Sur la page d'un genre, elle donne le texte de présentation de
    // l'ancienne collection Shopify fondue dans cette page (plus bas). Ce
    // n'est qu'un ornement : muette, l'API laisse la page sans texte, elle
    // ne la fait pas tomber.
    collectionDemandee
      ? api.collections(langue)
      : genre
        ? api.collections(langue).catch(() => [])
        : Promise.resolve([]),
    /*
     * Les lieux partent avec le reste plutôt qu'après.
     *
     * Ils étaient demandés une fois la grille reçue : un aller-retour de plus
     * en file, alors que la liste des lieux ne dépend pas des affiches
     * affichées. Elle est vide sur les prêtes à imprimer — ce ne sont pas des
     * affiches de lieu, leur titre entier est en capitales et le filtre y
     * lisait quinze « lieux » qui n'en étaient pas.
     */
    genre === "prete_a_imprimer"
      ? Promise.resolve([])
      : api
          .villes(genre || undefined, collectionDemandee || undefined)
          .catch(() => []),
  ]);
  products = rayon.items;
  total = rayon.total;
  collections = listeCollections;
  villes = listeVilles;
} catch (e) {
  error = String(e);
}

/**
 * Un rayon qui n'existe plus : page introuvable, pas grille vide.
 *
 * `/collections` ne rend que les collections ACTIVES qui contiennent au moins
 * une affiche en vente. Une adresse qui ne s'y trouve pas désigne donc une
 * collection désactivée, supprimée, ou vidée : lui répondre « Toutes les
 * affiches — 0 affiche » laisserait croire à une panne, et laisserait un
 * moteur indexer une page sans contenu. Le repli sur `error` est volontaire :
 * quand l'API n'a pas répondu, on ne sait rien, et on ne prononce pas
 * l'inexistence d'un rayon sur un silence.
 */
const collection = collections.find((c) => c.slug === collectionDemandee);
if (!error && collectionDemandee && !collection)
  return new Response(null, { status: 404 });

/*
 * UNE adresse par rayon : celle du menu.
 *
 * « Villes » répondait sous /affiches?collection=villes (où menait l'ancienne
 * adresse Shopify) ET sous /affiches?genre=personnalisable&collection=villes
 * (le lien du menu) : la même grille, deux adresses qui se déclaraient
 * chacune canonique. Un rayon dont toutes les affiches sont du même genre
 * n'a plus que la forme qui porte ce genre ; l'autre y mène en 301, réglages
 * (tri, lieu, page) et suivi de campagne compris.
 *
 * Un rayon qui mêle les deux genres (« Accessoires ») n'a, lui, que l'adresse
 * SANS genre — la seule du plan du site. Son filtre par genre
 * (?collection=accessoires&genre=personnalisable) restait une page à part,
 * indexable et canonique, avec le titre et la description du rayon : un
 * doublon que rien sur le site ne propose (aucun lien, aucun menu), mais
 * qu'une adresse recopiée suffisait à créer. Il mène maintenant au rayon
 * entier, en 301, comme un genre inconnu.
 *
 * Un genre VALIDE qui contredit celui du rayon (des prêtes à imprimer dans
 * « Villes ») ne trouve rien : c'est le cas du rayon vide, juste en dessous.
 * Et quand l'API n'a pas répondu, on ne connaît pas le genre du rayon : on
 * ne redresse rien sur un silence.
 */
const genreDuRayon = collection?.genre ?? null;
const genreAttendu = collection ? (genreDuRayon ?? "") : genre;
const contradiction = !!genreDuRayon && !!genre && genre !== genreDuRayon;
if (!contradiction && genreDemande !== genreAttendu && !(collectionDemandee && error)) {
  const p = new URLSearchParams();
  if (genreAttendu) p.set("genre", genreAttendu);
  if (collectionDemandee) p.set("collection", collectionDemandee);
  for (const [cle, valeur] of Astro.url.searchParams)
    if (cle !== "genre" && cle !== "collection") p.append(cle, valeur);
  const requete = p.toString();
  return Astro.redirect(lien(langue, "/affiches") + (requete ? `?${requete}` : ""), 301);
}

/*
 * Un rayon vide n'existe pas : un filtre qui ne trouve rien (un lieu
 * inconnu, un genre que le rayon n'a pas, une page de genre sans affiche)
 * répond 404, comme un rayon inconnu. Une grille vide en 200 est ce que
 * Google appelle une « soft 404 » : une page sans contenu qui se déclare
 * canonique. Le catalogue entier, lui, reste une page même vide.
 */
if (!error && total === 0 && (genre || collectionDemandee || villeEffective))
  return new Response(null, { status: 404 });

/*
 * L'API n'a pas répondu : la page s'affiche avec son message d'erreur, mais
 * répond 503 — « reviens plus tard » — et non 200 : un robot qui passe à ce
 * moment ne doit pas prendre une grille vide pour le contenu du rayon.
 */
if (error) {
  Astro.response.status = 503;
  Astro.response.headers.set("Retry-After", "120");
}

const pages = Math.max(Math.ceil(total / PAR_PAGE), 1);
/**
 * La carte cadeau en dernière vignette (18/11) : sur la première page d'un
 * rayon qui montre des affiches, hors stand (la carte ne s'y vend pas) et
 * hors filtre de lieu (on y cherche un endroit, pas un cadeau).
 */
const montrerCarteCadeau =
  !Astro.locals.stand && pageDemandee === 1 && !villeEffective && products.length > 0;
/**
 * Une page au-delà de la dernière n'est pas une erreur de serveur mais une
 * adresse périmée — un lien vers la page 4 d'un rayon qui n'en a plus que
 * deux. On renvoie vers la première plutôt que d'afficher une grille vide,
 * et en 301 : l'adresse ne reviendra pas.
 */
if (!error && pageDemandee > pages && total > 0) {
  const vers = new URL(Astro.url);
  vers.searchParams.delete("page");
  return Astro.redirect(vers.pathname + vers.search, 301);
}

/** Le titre de la page : le nom du rayon, ou celui du catalogue entier. */
const titrePage = (() => {
  if (collectionDemandee) {
    const trouvee = collections.find((c) => c.slug === collectionDemandee);
    if (trouvee) return trouvee.name;
  }
  if (genre === "personnalisable") return tr("nav.personnalisables");
  if (genre === "prete_a_imprimer") return tr("nav.pretes");
  return tr("catalogue.titre");
})();

/*
 * Le titre et la description que Google montre pour cette liste.
 *
 * Tous les rayons portaient le même titre maigre (« Villes — Memory Line »)
 * et la description générique du site, celle de l'accueil, du panier et de
 * la recherche : six pages au moins disaient la même chose à Google. Chaque
 * liste a maintenant les siens, dans la langue de la page.
 *
 * - Un rayon : son nom et la nature de ses affiches (« Villes – Affiches
 *   personnalisées ») ; en description, le texte de présentation de la
 *   collection quand elle en a un dans cette langue (c'est celui que
 *   memoryline.fr donne à Google), sinon une phrase faite de son nom.
 * - Une page de genre ou le catalogue entier : un titre et une phrase à eux.
 * - Un filtre par lieu (hors index) commence par le lieu, une page 2 et
 *   suivantes finissent par leur numéro : deux pages, deux titres.
 */
const natureDuRayon =
  collection?.genre === "personnalisable" || collection?.genre === "prete_a_imprimer"
    ? collection.genre
    : "mixte";
const titreListe = collection
  ? [
      collection.name,
      nommeDejaUneAffiche(collection.name) ? null : tr(`seo.natures.${natureDuRayon}`),
    ]
  : genre
    ? [tr(`seo.titre.${genre}`)]
    : [tr("seo.titre.catalogue")];
const numeroDePage = pageDemandee > 1 ? tr("seo.page_n").replace("{n}", String(pageDemandee)) : null;
const titreOnglet = titreDePage(villeEffective || null, ...titreListe, numeroDePage);

/*
 * Un bandeau visuel en tête du rayon (première page seulement, voir plus
 * bas) ? C'est alors lui l'image la plus grande, et il part déjà en
 * priorité ; sinon, c'est la première vignette (VignetteAffiche.astro,
 * `premiere`). Mêmes réglages que ceux que BandeauxVisuels.astro relit,
 * gardés deux secondes (api.ts) : pas d'appel de plus.
 */
const bandeauEnTete =
  pageDemandee === 1 &&
  (await bandeauxVisuels(clesPageAffiches(genre, collectionDemandee), langue)).length > 0;

/*
 * Le texte de présentation du rayon, sous son titre.
 *
 * memoryline.fr l'affiche en tête de chaque collection, et c'est souvent le
 * seul texte de la page : le site le recevait de l'API et ne s'en servait
 * pas — sous le titre, il n'y avait que le nombre d'affiches et la grille.
 *
 * Une page de genre n'est pas une collection, mais une ancienne collection
 * Shopify peut s'y être fondue (lib/anciennes-adresses.ts) : « Affiches
 * prêtes à imprimer » (affiches-diverses) y mène en 301, avec ses quinze
 * affiches. Son texte la suit — c'est celui que Google a indexé sous
 * l'ancienne adresse.
 *
 * Seulement dans une langue où il est écrit : la page anglaise d'un genre
 * est traduite de bout en bout, un paragraphe français au milieu la
 * démentirait. Et sur la première page seulement : la suite d'un rayon, on
 * y arrive en le parcourant.
 */
const collectionDuTexte =
  collection ??
  (genre && !collectionDemandee
    ? collections.find((c) => RAYONS_FUSIONNES[c.slug] === adresseDuRayon(genre))
    : undefined);
const htmlDuRayon =
  collectionDuTexte && languesDuContenu(collectionDuTexte.languesTraduites).includes(langue)
    ? htmlSur(collectionDuTexte.description)
    : "";
const texteDuRayon = texteBrut(htmlDuRayon);

const descriptionListe = (() => {
  // Le texte de présentation passe devant la phrase type : c'est celui que
  // memoryline.fr donne aujourd'hui à Google pour ce rayon.
  if (texteDuRayon) return texteDuRayon;
  if (collection)
    return tr(`seo.description.rayon.${natureDuRayon}`).replace("{rayon}", collection.name);
  if (genre) return tr(`seo.description.${genre}`);
  return tr("seo.description.catalogue");
})();
const suiteDescription = numeroDePage ? ` (${numeroDePage})` : "";
const descriptionPage =
  descriptionMeta(descriptionListe, DESCRIPTION_MAX - suiteDescription.length) + suiteDescription;

/**
 * Une adresse de ce même rayon, avec un réglage changé.
 *
 * Tout passe par l'adresse — le rayon, le tri, la page —, et c'est ce qui rend
 * un résultat partageable par message et lisible par un moteur. Le tri par
 * défaut et la première page ne s'écrivent PAS : une seule adresse doit
 * désigner une seule grille, sinon la même page existe en trois exemplaires
 * pour Google.
 */
function adresseRayon(changements: { tri?: string; page?: number }): string {
  const p = new URLSearchParams();
  if (genre) p.set("genre", genre);
  if (collectionDemandee) p.set("collection", collectionDemandee);
  if (villeEffective) p.set("ville", villeEffective);
  const triVoulu = changements.tri ?? tri;
  if (triVoulu !== triParDefaut) p.set("tri", triVoulu);
  const pageVoulue = changements.page ?? pageDemandee;
  if (pageVoulue > 1) p.set("page", String(pageVoulue));
  const requete = p.toString();
  return lien(langue, "/affiches") + (requete ? `?${requete}` : "");
}

/**
 * L'adresse canonique de CETTE page.
 *
 * Elle porte le numéro de page : sans lui, les quatre pages d'un rayon se
 * déclareraient toutes comme étant la première, et trois quarts des affiches
 * sortiraient de l'index. Le tri, lui, n'y figure pas — c'est le même rayon
 * regardé autrement, pas un autre contenu.
 *
 * Les versions dans les autres langues (hreflang, sélecteur de langue) en
 * sont tirées par Base.astro : la page 2 de « Villes » en anglais est la page
 * 2 de « Villes », et non plus le catalogue entier.
 */
const canonique = (() => {
  const p = new URLSearchParams();
  if (genre) p.set("genre", genre);
  if (collectionDemandee) p.set("collection", collectionDemandee);
  if (villeEffective) p.set("ville", villeEffective);
  if (pageDemandee > 1) p.set("page", String(pageDemandee));
  const requete = p.toString();
  return lien(langue, "/affiches") + (requete ? `?${requete}` : "");
})();

/*
 * Ce qui s'indexe.
 *
 * Un rayon de collection n'est présenté comme traduit que si son nom (et son
 * texte) l'est : « Villes » sous /en, titré en français, reste visitable
 * mais se met en « noindex, follow ». Le catalogue et les pages de genre
 * n'ont que des libellés d'interface, traduits partout.
 *
 * Un filtre par LIEU (?ville=AMIENS) n'est pas indexé : ce sont une centaine
 * de pages par rayon et par langue, au titre et au texte identiques à ceux
 * du rayon — des doublons. Le jour où ces pages auront leur propre titre et
 * leur propre texte (« Affiches personnalisées d'Amiens »), il suffira de
 * retirer cette condition pour en faire de vraies pages d'entrée.
 */
const languesDuRayon = collection?.languesTraduites;
const filtreParLieu = !!villeEffective;

/*
 * Ce que Google lit du rayon (AUDIT-SEO.md, DS-3) : le fil d'Ariane, le même
 * que celui des fiches (Accueil › Affiches personnalisables › Villes), et la
 * liste des affiches de CETTE page, dans l'ordre de la grille. Avant, aucune
 * donnée structurée : rien ne disait à Google où un rayon se range.
 *
 * L'image de partage est la première affiche de la page, au lieu du logo
 * par défaut : un rayon partagé montre ce qu'il contient.
 */
const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "https://memoryline.fr";
const absolue = (chemin: string) => new URL(chemin, siteUrl + "/").toString();
const genreDuFil = collection
  ? collection.genre === "personnalisable" || collection.genre === "prete_a_imprimer"
    ? collection.genre
    : null
  : genre || null;
const etapesDuFil = [
  { nom: tr("seo.fil_accueil"), url: absolue(lien(langue, "/")) },
  ...(genreDuFil
    ? [
        {
          nom: genreDuFil === "personnalisable" ? tr("nav.personnalisables") : tr("nav.pretes"),
          url: absolue(lien(langue, adresseDuRayon(genreDuFil))),
        },
      ]
    : []),
  ...(collection
    ? [{ nom: collection.name, url: absolue(lien(langue, adresseDuRayon(genreDuFil, collection.slug))) }]
    : []),
  ...(!genreDuFil && !collection
    ? [{ nom: tr("catalogue.titre"), url: absolue(lien(langue, "/affiches")) }]
    : []),
];
const donneesDuRayon =
  error || products.length === 0
    ? undefined
    : [
        filDAriane(etapesDuFil),
        pageDeRayon(
          titrePage,
          absolue(canonique),
          products.map((p) => ({ nom: p.name, url: absolue(lien(langue, `/affiches/${p.slug}`)) })),
          (pageDemandee - 1) * PAR_PAGE + 1,
        ),
      ];
const imageDuRayon = assetUrl(products[0]?.image ?? null, 900) ?? undefined;

const precedente = pageDemandee > 1 ? adresseRayon({ page: pageDemandee - 1 }) : null;
const suivante = pageDemandee < pages ? adresseRayon({ page: pageDemandee + 1 }) : null;

/**
 * Le nombre d'affiches s'accorde : « 1 affiche », et non « 1 affiches »
 * (le rayon « À partir de photos » n'en a qu'une). Chaque langue a sa règle
 * — en français, zéro et un sont au singulier ; en anglais, un seul —, et
 * Intl.PluralRules la connaît : rien à écrire langue par langue.
 */
const unSeul = new Intl.PluralRules(LOCALE_COMPLETE[langue]).select(total) === "one";

/** Le libellé de chaque tri, écrit une fois plutôt que composé à la volée. */
const libelleTri: Record<string, string> = {
  manuel: tr("catalogue.tri.manuel"),
  nouveautes: tr("catalogue.tri.nouveautes"),
  prix_asc: tr("catalogue.tri.prix_asc"),
  prix_desc: tr("catalogue.tri.prix_desc"),
  alpha: tr("catalogue.tri.alpha"),
};
---

<Base
  langue={langue}
  title={titreOnglet}
  description={descriptionPage}
  path={canonique}
  languesTraduites={languesDuRayon}
  noindex={filtreParLieu}
  image={imageDuRayon}
  jsonLd={donneesDuRayon}
  precedente={precedente}
  suivante={suivante}
>
  {/* Les bandeaux visuels de ce rayon (« Bandeaux visuels » au back-office),
      sous l'en-tête. Sur la première page seulement : la suite d'un rayon,
      on y arrive en le parcourant, et un bandeau de 480 px à chaque page
      repousserait les affiches qu'on était venu voir. */}
  {
    pageDemandee === 1 && (
      <BandeauxVisuels
        pages={clesPageAffiches(genre, collectionDemandee)}
        langue={langue}
      />
    )
  }
  <section class="mx-auto max-w-[1600px] px-4 pt-12 pb-8 sm:px-6 lg:px-10">
    <h1 class="text-3xl sm:text-4xl">{titrePage}</h1>
    {
      pageDemandee === 1 && texteDuRayon && (
        <div
          class="mt-4 max-w-3xl leading-relaxed text-ink-soft [&_a]:underline [&_p+p]:mt-3"
          set:html={htmlDuRayon}
        />
      )
    }
    <div class="mt-3 space-y-3">
      {/* Le nombre d'affiches est l'intertitre de la grille qui suit. Le nom
          de chaque vignette en était un, de même niveau : 48 titres de
          second rang par page, et rien pour dire où commence la liste. Les
          vignettes passent un cran en dessous (VignetteAffiche.astro) ; à
          l'écran, rien ne change. */}
      <h2 class="text-base text-ink-soft">
        {total}{" "}
        {unSeul
          ? tr("catalogue.compte_un")
          : genre || collectionDemandee
            ? tr("catalogue.compte_simple")
            : tr("catalogue.compte")}
      </h2>

      {/* Le tri est un FORMULAIRE en GET : sans JavaScript, le bouton
          « Appliquer » suffit ; avec, le menu déroulant envoie tout seul.
          Les autres réglages du rayon suivent en champs cachés, sinon
          changer de tri ferait sortir du rayon. Le numéro de page, lui, ne
          suit pas : trier autrement, c'est repartir du début. */}
      <form
        method="get"
        action={lien(langue, "/affiches")}
        class="ml-tri flex w-full flex-wrap items-center gap-x-4 gap-y-2"
      >
        {genre && <input type="hidden" name="genre" value={genre} />}
        {
          collectionDemandee && (
            <input type="hidden" name="collection" value={collectionDemandee} />
          )
        }
        {/* Le filtre par ville. Cent une entrées : un menu déroulant, où
            l'on cherche un nom — pas une rangée de pastilles à parcourir.
            Il part avec le formulaire du tri, qui marche déjà sans
            JavaScript. */}
        {/* À GAUCHE, demandé par la boutique : c'est le premier réglage
            qu'on cherche des yeux ; le tri vient après, à droite. */}
        {villes.length > 0 && (
          <div class="flex items-center gap-2">
            <label for="ville" class="text-sm text-ink-soft">
              {tr("catalogue.ville")}
            </label>
            <select
              id="ville"
              name="ville"
              class="ml-filtre-ville min-w-0 max-w-[min(14rem,60vw)] border border-ink/20 bg-paper px-3 py-2 text-sm"
            >
              <option value="">{tr("catalogue.toutes_villes")}</option>
              {villes.map((v) => (
                <option value={v.nom} selected={v.nom === villeDemandee}>
                  {v.nom} ({v.nombre})
                </option>
              ))}
            </select>
            {/* Le même choix, en tapant pour chercher (17/11 : « pouvoir taper
                pour chercher dans la liste »). Caché tant que le script ne l'a
                pas branché : sans JavaScript, le menu ci-dessus suffit. */}
            <div
              class="ml-lieux relative hidden"
              data-aucun={tr("catalogue.aucun_lieu")}
            >
              <input
                id="ville-recherche"
                type="text"
                role="combobox"
                aria-autocomplete="list"
                aria-expanded="false"
                aria-controls="ville-liste"
                autocomplete="off"
                spellcheck="false"
                value={villeDemandee ?? ""}
                placeholder={tr("catalogue.chercher_lieu")}
                class="w-[min(14rem,60vw)] border border-ink/20 bg-paper px-3 py-2 text-sm"
              />
              <ul
                id="ville-liste"
                role="listbox"
                hidden
                class="absolute left-0 z-30 mt-1 max-h-72 w-[min(16rem,80vw)] overflow-auto border border-ink/20 bg-paper py-1 text-sm shadow-lg"
              ></ul>
            </div>
          </div>
        )}
        <div class="ml-auto flex items-center gap-2">
          <label for="tri" class="text-sm text-ink-soft">{tr("catalogue.tri")}</label>
          <select
            id="tri"
            name="tri"
            class="min-w-0 max-w-[min(12rem,50vw)] border border-ink/20 bg-paper px-3 py-2 text-sm"
          >
            {
              trisOfferts.map((valeur) => (
                <option value={valeur} selected={valeur === tri}>
                  {libelleTri[valeur]}
                </option>
              ))
            }
          </select>
        </div>
        <noscript>
          <button
            type="submit"
            class="border border-ink/20 px-3 py-2 text-sm hover:border-ink transition-colors"
            >{tr("catalogue.trier_bouton")}</button
          >
        </noscript>
      </form>
    </div>
  </section>

  {
    error && (
      <p class="mx-auto max-w-[1600px] px-4 text-terracotta-deep sm:px-6 lg:px-10">
        {tr("catalogue.erreur")} ({error}).
      </p>
    )
  }

  <section class="mx-auto max-w-[1600px] px-4 pb-16 sm:px-6 lg:px-10">
    {
      !error && products.length === 0 && (
        <p class="text-ink-soft">{tr("catalogue.vide")}</p>
      )
    }
    {/* UNE COLONNE DE MOINS À CHAQUE PALIER, et le cadre passe de 1200 à
        1600 px : sur un écran large, on avait quatre affiches par ligne dans
        un couloir de 1200 px, soit des vignettes plus petites que sur
        l'ancien site alors que l'écran était plus grand.

        Le blanc qu'on voit autour des affiches n'est pas d'ici : les
        vignettes sont remplies bord à bord, sans rognage. Il est DANS les
        photos — ce sont des mises en situation où l'affiche n'occupe qu'une
        partie de l'image. Agrandir la vignette agrandit donc aussi ce blanc ;
        seule une photo recadrée le supprimerait.

        LES GOUTTIÈRES SONT CELLES DE MEMORYLINE.FR : 4 px sur téléphone,
        8 px au-delà. À 20 et 24 px, le blanc entre les affiches se voyait
        autant que les affiches. Sur téléphone, la grille déborde en plus de
        8 px sur la marge de la page (`-mx-2`) : chaque vignette y gagne une
        dizaine de pixels, et les noms, rentrés d'autant, restent alignés sur
        le titre. La vitrine de l'accueil et les résultats de recherche
        reprennent ces mêmes réglages — et si on les change ici, `sizes`
        dans VignetteAffiche.astro doit suivre. */}
    <ul
      class="ml-grille-produits -mx-2 gap-x-1 gap-y-5 sm:mx-0 sm:gap-x-2 sm:gap-y-8"
      style={styleGrille(grille)}
    >
      {
        products.map((p, rang) => (
          <VignetteAffiche
            affiche={p}
            langue={langue}
            prioritaire={rang < 4}
            premiere={rang === 0 && !bandeauEnTete}
            sizes={sizesGrille(grille)}
          />
        ))
      }
      {/* La carte cadeau, en dernière vignette de la première page (18/11) :
          pas au stand, qui ne la vend pas, ni quand un lieu est choisi. */}
      {montrerCarteCadeau && <VignetteCarteCadeau langue={langue} sizes={sizesGrille(grille)} />}
    </ul>

    {/* La pagination : de VRAIS liens, pour qu'on puisse les ouvrir dans un
        onglet, les copier, et qu'un moteur les suive. */}
    {
      pages > 1 && (
        <nav
          class="mt-14 flex items-center justify-center gap-6 text-sm"
          aria-label={tr("catalogue.page")}
        >
          {precedente ? (
            <a
              href={precedente}
              rel="prev"
              class="border border-ink/20 px-4 py-2 hover:border-ink transition-colors"
            >
              ← {tr("catalogue.precedente")}
            </a>
          ) : (
            <span class="border border-ink/10 px-4 py-2 text-ink/30">
              ← {tr("catalogue.precedente")}
            </span>
          )}
          <span class="text-ink-soft">
            {tr("catalogue.page")} {pageDemandee} {tr("catalogue.page_sur")}{" "}
            {pages}
          </span>
          {suivante ? (
            <a
              href={suivante}
              rel="next"
              class="border border-ink/20 px-4 py-2 hover:border-ink transition-colors"
            >
              {tr("catalogue.suivante")} →
            </a>
          ) : (
            <span class="border border-ink/10 px-4 py-2 text-ink/30">
              {tr("catalogue.suivante")} →
            </span>
          )}
        </nav>
      )
    }
  </section>

  <script is:inline>
    // La liste des lieux, en tapant pour chercher : on tape « col », il ne
    // reste que Colmar. Accents et majuscules ne comptent pas. Le menu
    // d'origine reste dans la page, caché, et porte toujours la valeur : le
    // choix passe par lui, et le script plus bas envoie le formulaire.
    (function () {
      var boite = document.querySelector(".ml-lieux");
      var menu = document.getElementById("ville");
      if (!boite || !menu) return;
      var champ = boite.querySelector("input");
      var liste = boite.querySelector("ul");
      var aucun = boite.getAttribute("data-aucun") || "";
      var simple = function (s) {
        return String(s || "").normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase().trim();
      };
      var lieux = Array.prototype.map.call(menu.options, function (o) {
        return { valeur: o.value, texte: o.textContent.trim(), cle: simple(o.textContent) };
      });
      var actuel = menu.value;
      var visibles = [];
      var actif = -1;

      menu.hidden = true;
      menu.tabIndex = -1;
      boite.classList.remove("hidden");
      var etiquette = document.querySelector('label[for="ville"]');
      if (etiquette) etiquette.htmlFor = "ville-recherche";

      function fermer() {
        liste.hidden = true;
        champ.setAttribute("aria-expanded", "false");
        champ.removeAttribute("aria-activedescendant");
        actif = -1;
      }
      function marquer(i) {
        actif = i;
        Array.prototype.forEach.call(liste.children, function (li, k) {
          li.setAttribute("aria-selected", k === i ? "true" : "false");
          li.classList.toggle("bg-ink/10", k === i);
        });
        var li = liste.children[i];
        if (li && li.id) {
          champ.setAttribute("aria-activedescendant", li.id);
          li.scrollIntoView({ block: "nearest" });
        }
      }
      function ouvrir(filtre) {
        var f = simple(filtre);
        visibles = lieux.filter(function (l) {
          return !f || l.valeur === "" || l.cle.indexOf(f) !== -1;
        });
        liste.innerHTML = "";
        visibles.forEach(function (l, i) {
          var li = document.createElement("li");
          li.id = "ville-option-" + i;
          li.setAttribute("role", "option");
          li.className = "cursor-pointer px-3 py-1.5 hover:bg-ink/10" + (l.valeur === actuel ? " font-semibold" : "");
          li.textContent = l.texte;
          li.addEventListener("mousedown", function (e) {
            e.preventDefault();
            choisir(l);
          });
          liste.appendChild(li);
        });
        if (visibles.length <= 1 && f) {
          var vide = document.createElement("li");
          vide.className = "px-3 py-1.5 text-ink-soft";
          vide.textContent = aucun;
          liste.appendChild(vide);
        }
        liste.hidden = false;
        champ.setAttribute("aria-expanded", "true");
        // Une seule ville trouvée (plus « Tous les lieux ») : déjà en surbrillance.
        marquer(f && visibles.length === 2 ? 1 : -1);
      }
      function choisir(l) {
        fermer();
        champ.value = l.valeur;
        if (l.valeur === actuel) return;
        menu.value = l.valeur;
        menu.dispatchEvent(new Event("change"));
      }

      champ.addEventListener("focus", function () {
        champ.select();
        ouvrir("");
      });
      champ.addEventListener("input", function () {
        ouvrir(champ.value);
      });
      champ.addEventListener("keydown", function (e) {
        if (e.key === "ArrowDown" || e.key === "ArrowUp") {
          e.preventDefault();
          if (liste.hidden) ouvrir(champ.value);
          var n = visibles.length;
          if (!n) return;
          marquer(e.key === "ArrowDown" ? (actif + 1) % n : (actif - 1 + n) % n);
        } else if (e.key === "Enter") {
          e.preventDefault();
          if (actif >= 0 && visibles[actif]) choisir(visibles[actif]);
        } else if (e.key === "Escape") {
          champ.value = actuel;
          fermer();
        }
      });
      champ.addEventListener("blur", function () {
        champ.value = actuel;
        fermer();
      });
    })();
  </script>
  <script is:inline>
    // Les menus de la barre envoient le formulaire dès qu'on choisit : un
    // bouton de plus à cliquer pour ranger une grille se paie en abandons.
    // Sans JavaScript, le <noscript> ci-dessus rend ce bouton — la page
    // reste utilisable dans tous les cas.
    //
    // TOUS les menus, et non le seul tri. Le filtre par ville s'est ajouté à
    // côté, et comme rien ne l'écoutait, en changer ne faisait rien du tout :
    // pas de rechargement, pas même une requête. Écouter la barre entière
    // couvre aussi le prochain filtre qu'on y mettra.
    (function () {
      var form = document.querySelector("form.ml-tri");
      if (!form) return;
      var menus = form.querySelectorAll("select");
      if (!menus.length) return;
      menus.forEach(function (menu) {
        menu.addEventListener("change", function () {
          // Changer de filtre repart de la première page : une page 3 n'a
          // aucun sens quand la grille change de contenu.
          var page = form.querySelector("input[name=page]");
          if (page) page.remove();
          form.submit();
        });
      });
    })();
  </script>
</Base>
