---
import Base from "../../layouts/Base.astro";
import { api, formatPrice, assetUrl, type Product } from "../../lib/api.ts";
import { cheminsLangues, lien, t, type Langue } from "../../i18n/utils.ts";

export const getStaticPaths = cheminsLangues;

const { langue } = Astro.props as { langue: Langue };
const tr = t(langue);

let products: Product[] = [];
let error: string | null = null;
try {
  products = await api.products(120, langue);
} catch (e) {
  error = String(e);
}

function priceRange(p: Product): string {
  const prices = p.variants.map((v) => v.priceCents).filter((c) => c > 0);
  if (prices.length === 0) return formatPrice(p.basePriceCents);
  const min = Math.min(...prices);
  const max = Math.max(...prices);
  return min === max
    ? formatPrice(min)
    : `${formatPrice(min)} – ${formatPrice(max)}`;
}

const kindLabel: Record<string, string> = {
  personnalisable: tr("genre.personnalisable"),
  prete_a_imprimer: tr("genre.prete_a_imprimer"),
};
---

<Base langue={langue} title={`${tr("catalogue.titre")} — Memory Line`}>
  <section class="mx-auto max-w-6xl px-6 pt-12 pb-8">
    <h1 class="font-serif text-4xl sm:text-5xl">{tr("catalogue.titre")}</h1>
    <p class="mt-3 text-ink-soft">
      {products.length} {tr("catalogue.compte")}
    </p>
  </section>

  {
    error && (
      <p class="mx-auto max-w-6xl px-6 text-terracotta-deep">
        {tr("catalogue.erreur")} ({error}).
      </p>
    )
  }

  <section class="mx-auto max-w-6xl px-6 pb-16">
    <ul class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-6">
      {
        products.map((p) => (
          <li class="group">
            <a href={lien(langue, `/affiches/${p.slug}`)} class="block">
              <div class="aspect-[3/4] rounded-xl bg-paper-deep border border-ink/10 flex items-center justify-center overflow-hidden group-hover:border-terracotta/40 transition-colors">
                {
                  assetUrl(p.image) ? (
                    <img
                      src={assetUrl(p.image)}
                      alt={p.name}
                      loading="lazy"
                      class="h-full w-full object-cover group-hover:scale-[1.02] transition-transform"
                    />
                  ) : (
                    <span class="font-serif text-xl text-ink-soft px-4 text-center">
                      {p.name.replace(/\s*[-–]\s*Affiche.*$/i, "")}
                    </span>
                  )
                }
              </div>
              <div class="mt-3">
                <p class="text-xs uppercase tracking-wide text-terracotta">
                  {kindLabel[p.kind] ?? p.kind}
                </p>
                <h2 class="font-medium leading-snug mt-1">
                  {p.name.replace(/\s*[-–]\s*Affiche.*$/i, "")}
                </h2>
                <p class="text-ink-soft mt-1">{priceRange(p)}</p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
