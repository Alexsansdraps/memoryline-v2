---
import Base from "../../layouts/Base.astro";
import { api, formatPrice, assetUrl, type Product } from "../../lib/api.ts";
import {
  estLangue,
  langueDepuisParam,
  lien,
  t,
  type Langue,
} from "../../i18n/utils.ts";

/**
 * Rendue À LA DEMANDE : cette page liste le catalogue, qui change dès qu'une
 * affiche est créée au back-office. Générée au build, elle aurait ignoré les
 * nouveautés jusqu'au build suivant.
 */
export const prerender = false;

// Préfixe de langue inconnu : 404 plutôt que du français à une adresse qui
// n'existe pas.
if (Astro.params.lang !== undefined && !estLangue(Astro.params.lang))
  return new Response(null, { status: 404 });
const langue: Langue = langueDepuisParam(Astro.params.lang);
const tr = t(langue);

let products: Product[] = [];
let error: string | null = null;
try {
  // Tout le catalogue : plafonné à 120, la boutique masquait les dernières
  // affiches créées.
  products = await api.products(500, langue);
} catch (e) {
  error = String(e);
}

function priceRange(p: Product): string {
  const prices = p.variants.map((v) => v.priceCents).filter((c) => c > 0);
  if (prices.length === 0) return formatPrice(p.basePriceCents);
  const min = Math.min(...prices);
  const max = Math.max(...prices);
  return min === max
    ? formatPrice(min)
    : `${formatPrice(min)} – ${formatPrice(max)}`;
}

const kindLabel: Record<string, string> = {
  personnalisable: tr("genre.personnalisable"),
  prete_a_imprimer: tr("genre.prete_a_imprimer"),
};
---

<Base langue={langue} title={`${tr("catalogue.titre")} — Memory Line`}>
  <section class="mx-auto max-w-[1200px] px-6 pt-12 pb-8 lg:px-12">
    <h1 class="text-3xl sm:text-4xl">{tr("catalogue.titre")}</h1>
    <p class="mt-3 text-ink-soft">
      {products.length} {tr("catalogue.compte")}
    </p>
  </section>

  {
    error && (
      <p class="mx-auto max-w-[1200px] px-6 text-terracotta-deep lg:px-12">
        {tr("catalogue.erreur")} ({error}).
      </p>
    )
  }

  <section class="mx-auto max-w-[1200px] px-6 pb-16 lg:px-12">
    {/* Grille des affiches : l'image porte tout, le texte se fait discret
        dessous — comme sur memoryline.fr. Le rapport 1020/1400 est celui des
        visuels de la boutique. */}
    <ul class="grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-3 lg:grid-cols-4">
      {
        products.map((p) => (
          <li class="group ml-apparition">
            <a href={lien(langue, `/affiches/${p.slug}`)} class="block">
              <div class="flex items-center justify-center overflow-hidden bg-paper-deep" style="aspect-ratio:1020/1400">
                {
                  assetUrl(p.image) ? (
                    <img
                      src={assetUrl(p.image)}
                      alt={p.name}
                      loading="lazy"
                      class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
                    />
                  ) : (
                    <span class="px-4 text-center text-lg text-ink-soft">
                      {p.name.replace(/\s*[-–]\s*Affiche.*$/i, "")}
                    </span>
                  )
                }
              </div>
              <div class="mt-4">
                <h2 class="text-[17px] leading-snug group-hover:underline underline-offset-4">
                  {p.name.replace(/\s*[-–]\s*Affiche.*$/i, "")}
                </h2>
                <p class="mt-1 text-ink-soft">{priceRange(p)}</p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
