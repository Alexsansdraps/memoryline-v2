---
import AfficheVide from "../../components/AfficheVide.astro";
import Base from "../../layouts/Base.astro";
import {
  api,
  formatPrice,
  assetUrl,
  type Collection,
  type Product,
} from "../../lib/api.ts";
import {
  estLangue,
  langueDepuisParam,
  lien,
  t,
  type Langue,
} from "../../i18n/utils.ts";

/**
 * Rendue À LA DEMANDE : cette page liste le catalogue, qui change dès qu'une
 * affiche est créée au back-office. Générée au build, elle aurait ignoré les
 * nouveautés jusqu'au build suivant.
 */
export const prerender = false;

// Préfixe de langue inconnu : 404 plutôt que du français à une adresse qui
// n'existe pas.
if (Astro.params.lang !== undefined && !estLangue(Astro.params.lang))
  return new Response(null, { status: 404 });
const langue: Langue = langueDepuisParam(Astro.params.lang);
const tr = t(langue);

/**
 * Le rayon demandé, lu dans l'adresse.
 *
 * « genre » sépare les affiches à composer des affiches prêtes à imprimer,
 * « collection » découpe les premières en villes et en paysages. Les deux sont
 * facultatifs : sans eux, la page montre tout, comme avant.
 */
const genre = Astro.url.searchParams.get("genre") ?? "";
const collectionDemandee = Astro.url.searchParams.get("collection") ?? "";

let products: Product[] = [];
let collections: Collection[] = [];
let error: string | null = null;
try {
  // Tout le catalogue : plafonné à 120, la boutique masquait les dernières
  // affiches créées.
  [products, collections] = await Promise.all([
    api.products(500, langue, {
      genre: genre || undefined,
      collection: collectionDemandee || undefined,
    }),
    // Sert seulement à nommer le rayon en titre : le nom vient de la boutique,
    // pas d'une table de correspondance écrite en dur ici.
    collectionDemandee ? api.collections() : Promise.resolve([]),
  ]);
} catch (e) {
  error = String(e);
}

/** Le titre de la page : le nom du rayon, ou celui du catalogue entier. */
const titrePage = (() => {
  if (collectionDemandee) {
    const trouvee = collections.find((c) => c.slug === collectionDemandee);
    if (trouvee) return trouvee.name;
  }
  if (genre === "personnalisable") return tr("nav.personnalisables");
  if (genre === "prete_a_imprimer") return tr("nav.pretes");
  return tr("catalogue.titre");
})();

function priceRange(p: Product): string {
  const prices = p.variants.map((v) => v.priceCents).filter((c) => c > 0);
  if (prices.length === 0) return formatPrice(p.basePriceCents);
  const min = Math.min(...prices);
  const max = Math.max(...prices);
  return min === max
    ? formatPrice(min)
    : `${formatPrice(min)} – ${formatPrice(max)}`;
}

const kindLabel: Record<string, string> = {
  personnalisable: tr("genre.personnalisable"),
  prete_a_imprimer: tr("genre.prete_a_imprimer"),
};
---

<Base langue={langue} title={`${titrePage} — Memory Line`}>
  <section class="mx-auto max-w-[1200px] px-6 pt-12 pb-8 lg:px-12">
    <h1 class="text-3xl sm:text-4xl">{titrePage}</h1>
    <p class="mt-3 text-ink-soft">
      {products.length}{" "}
      {genre || collectionDemandee
        ? tr("catalogue.compte_simple")
        : tr("catalogue.compte")}
    </p>
  </section>

  {
    error && (
      <p class="mx-auto max-w-[1200px] px-6 text-terracotta-deep lg:px-12">
        {tr("catalogue.erreur")} ({error}).
      </p>
    )
  }

  <section class="mx-auto max-w-[1200px] px-6 pb-16 lg:px-12">
    {/* Grille des affiches : l'image porte tout, le texte se fait discret
        dessous — comme sur memoryline.fr. Le rapport 1020/1400 est celui des
        visuels de la boutique. */}
    <ul class="grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-3 lg:grid-cols-4">
      {
        products.map((p) => (
          <li class="group ml-apparition">
            <a href={lien(langue, `/affiches/${p.slug}`)} class="block">
              <div class="flex items-center justify-center overflow-hidden bg-paper-deep" style="aspect-ratio:1020/1400">
                {
                  assetUrl(p.image) ? (
                    <img
                      src={assetUrl(p.image)}
                      alt={p.name}
                      loading="lazy"
                      class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
                    />
                  ) : (
                    <AfficheVide nom={p.name.replace(/\s*[-–]\s*Affiche.*$/i, "")} />
                  )
                }
              </div>
              <div class="mt-4">
                <h2 class="text-[17px] leading-snug group-hover:underline underline-offset-4">
                  {p.name.replace(/\s*[-–]\s*Affiche.*$/i, "")}
                </h2>
                <p class="mt-1 text-ink-soft">{priceRange(p)}</p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
