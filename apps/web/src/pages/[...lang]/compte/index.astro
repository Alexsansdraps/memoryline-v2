---
import CompteCadre from "../../../components/CompteCadre.astro";
import { formatPrice } from "../../../lib/api.ts";
import {
  commandes,
  deconnexion,
  exigerSession,
  formatDate,
  libelleStatut,
  rediriger,
  type CommandeResume,
} from "../../../lib/compte.ts";
import {
  estLangue,
  langueDepuisParam,
  lien,
  t,
  type CleUi,
  type Langue,
} from "../../../i18n/utils.ts";

export const prerender = false;

if (Astro.params.lang !== undefined && !estLangue(Astro.params.lang))
  return new Response(null, { status: 404 });
const langue: Langue = langueDepuisParam(Astro.params.lang);
const tr = t(langue);

// Le menu de TOUTES les pages du compte poste sa déconnexion ici : une seule
// page à traiter, plutôt que le même bloc recopié six fois.
if (Astro.request.method === "POST") {
  const formulaire = await Astro.request.formData();
  if (formulaire.get("action") === "deconnexion") {
    await deconnexion(Astro);
    return rediriger(Astro, lien(langue, "/"));
  }
}

const session = await exigerSession(Astro, langue);
if (session.etat === "anonyme") return session.redirection;

let liste: CommandeResume[] = [];
let erreur: CleUi | null =
  session.etat === "indisponible" ? session.erreur : null;

if (session.etat === "connecte") {
  const r = await commandes(Astro);
  if (r.ok) liste = r.donnees ?? [];
  else erreur = r.erreur;
}
---

<CompteCadre
  langue={langue}
  titre={tr("compte.commandes.titre")}
  chemin="/compte"
  menu={session.etat === "connecte"}
>
  {
    erreur && (
      <p class="border border-terracotta/40 bg-terracotta/5 px-4 py-3 text-terracotta-deep">
        {tr(erreur)}
      </p>
    )
  }

  {
    session.etat === "connecte" && (
      <p class="mb-6 text-ink-soft">
        {session.client.name || session.client.email}
      </p>
    )
  }

  {
    !erreur && liste.length === 0 && (
      <div class="border border-ink/10 bg-paper-deep/40 px-6 py-10 text-center">
        <p class="text-ink-soft">{tr("compte.commandes.vide")}</p>
        <a
          href={lien(langue, "/affiches")}
          class="mt-6 inline-block rounded-full bg-ink px-6 py-3 font-medium text-paper transition-colors hover:bg-ink/85"
        >
          {tr("compte.commandes.decouvrir")}
        </a>
      </div>
    )
  }

  <ul class="space-y-4">
    {
      liste.map((c) => (
        <li class="border border-ink/10 p-5">
          <div class="flex flex-wrap items-baseline justify-between gap-3">
            <a
              href={lien(langue, `/compte/commande/${c.id}`)}
              class="text-lg underline-offset-4 hover:text-terracotta hover:underline"
            >
              {tr("compte.commandes.numero")} {c.number}
            </a>
            <span class="text-ink-soft">{formatDate(c.createdAt, langue)}</span>
          </div>

          <p class="mt-2 text-sm text-ink-soft">
            {c.articles}{" "}
            {c.articles > 1 ? tr("compte.articles") : tr("compte.article")} ·{" "}
            {formatPrice(c.totalCents)}
          </p>

          <p class="mt-3 flex flex-wrap gap-2 text-sm">
            <span class="border border-ink/15 bg-paper-deep px-3 py-1">
              {libelleStatut(tr, "financier", c.statutFinancier)}
            </span>
            <span class="border border-ink/15 bg-paper-deep px-3 py-1">
              {libelleStatut(tr, "expedition", c.statutExpedition)}
            </span>
          </p>

          {c.suivi
            ?.filter((s) => s.trackingUrl || s.trackingNumber)
            .map((s) => (
              <p class="mt-2 text-sm">
                {s.trackingUrl ? (
                  <a
                    href={s.trackingUrl}
                    rel="noopener noreferrer"
                    target="_blank"
                    class="underline underline-offset-4 hover:text-terracotta"
                  >
                    {tr("compte.commandes.suivre")}
                    {s.carrier ? ` — ${s.carrier}` : ""}
                  </a>
                ) : (
                  <span class="text-ink-soft">
                    {s.carrier ? `${s.carrier} — ` : ""}
                    {s.trackingNumber}
                  </span>
                )}
              </p>
            ))}

          <p class="mt-4">
            <a
              href={lien(langue, `/compte/commande/${c.id}`)}
              class="text-sm underline underline-offset-4 hover:text-terracotta"
            >
              {tr("compte.commandes.voir")}
            </a>
          </p>
        </li>
      ))
    }
  </ul>
</CompteCadre>
