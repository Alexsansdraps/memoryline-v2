---
import CompteCadre from "../../../components/CompteCadre.astro";
import {
  estLangue,
  langueDepuisParam,
  lien,
  t,
  type CleUi,
  type Langue,
} from "../../../i18n/utils.ts";
import { inscription, moi, rediriger } from "../../../lib/compte.ts";

export const prerender = false;

if (Astro.params.lang !== undefined && !estLangue(Astro.params.lang))
  return new Response(null, { status: 404 });
const langue: Langue = langueDepuisParam(Astro.params.lang);
const tr = t(langue);

let erreur: CleUi | null = null;
let email = "";
let nom = "";
let marketing = false;

if (Astro.request.method === "POST") {
  const formulaire = await Astro.request.formData();
  email = String(formulaire.get("email") ?? "").trim();
  nom = String(formulaire.get("name") ?? "").trim();
  marketing = formulaire.get("acceptsMarketing") !== null;
  const motDePasse = String(formulaire.get("password") ?? "");

  if (!email || !motDePasse) {
    erreur = "compte.err.champs";
  } else if (motDePasse.length < 8) {
    // Contrôlé ici aussi : autant le dire avant l'aller-retour réseau.
    erreur = "compte.err.mdp_court";
  } else {
    const r = await inscription(Astro, {
      email,
      password: motDePasse,
      name: nom || undefined,
      acceptsMarketing: marketing,
    });
    if (r.ok) return rediriger(Astro, lien(langue, "/compte"));
    // Le seul 400 que l'API renvoie ici concerne la longueur du mot de passe.
    erreur = r.statut === 400 ? "compte.err.mdp_court" : r.erreur;
  }
} else {
  const session = await moi(Astro);
  if (session.ok) return rediriger(Astro, lien(langue, "/compte"), 302);
}

const champ =
  "mt-1 w-full rounded-lg border border-ink/20 bg-paper px-4 py-3 focus:border-terracotta focus:outline-none";
---

<CompteCadre
  langue={langue}
  titre={tr("compte.inscription.titre")}
  chemin="/compte/inscription"
  menu={false}
>
  <p class="text-ink-soft">{tr("compte.inscription.intro")}</p>

  {
    erreur && (
      <p class="mt-6 border border-terracotta/40 bg-terracotta/5 px-4 py-3 text-terracotta-deep">
        {tr(erreur)}
      </p>
    )
  }

  <form method="post" class="mt-6 space-y-4">
    <label class="block">
      <span class="text-sm font-medium">{tr("compte.nom")}</span>
      <input
        type="text"
        name="name"
        value={nom}
        autocomplete="name"
        class={champ}
      />
    </label>
    <label class="block">
      <span class="text-sm font-medium">{tr("compte.email")}</span>
      <input
        type="email"
        name="email"
        value={email}
        required
        autocomplete="email"
        class={champ}
      />
    </label>
    <label class="block">
      <span class="text-sm font-medium">{tr("compte.mdp")}</span>
      <input
        type="password"
        name="password"
        required
        minlength="8"
        autocomplete="new-password"
        class={champ}
      />
      <span class="mt-1 block text-xs text-ink-soft">{tr("compte.mdp_aide")}</span>
    </label>
    <label class="flex items-start gap-3 text-sm">
      <input
        type="checkbox"
        name="acceptsMarketing"
        checked={marketing}
        class="mt-1"
      />
      <span>{tr("compte.marketing")}</span>
    </label>
    <button
      type="submit"
      class="w-full rounded-full bg-ink px-6 py-3 font-medium text-paper transition-colors hover:bg-ink/85"
    >
      {tr("compte.inscription.bouton")}
    </button>
  </form>

  <p class="mt-8 border-t border-ink/10 pt-6 text-sm text-ink-soft">
    {tr("compte.inscription.deja")}{" "}
    <a
      href={lien(langue, "/compte/connexion")}
      class="text-ink underline underline-offset-4 hover:text-terracotta"
    >
      {tr("compte.connexion.bouton")}
    </a>
  </p>
</CompteCadre>
