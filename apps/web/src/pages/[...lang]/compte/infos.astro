---
import CompteCadre from "../../../components/CompteCadre.astro";
import {
  changerMotDePasse,
  exigerSession,
  majInfos,
  rediriger,
  type Client,
} from "../../../lib/compte.ts";
import {
  estLangue,
  langueDepuisParam,
  lien,
  t,
  type CleUi,
  type Langue,
} from "../../../i18n/utils.ts";

export const prerender = false;

if (Astro.params.lang !== undefined && !estLangue(Astro.params.lang))
  return new Response(null, { status: 404 });
const langue: Langue = langueDepuisParam(Astro.params.lang);
const tr = t(langue);

const session = await exigerSession(Astro, langue);
if (session.etat === "anonyme") return session.redirection;

let erreur: CleUi | null =
  session.etat === "indisponible" ? session.erreur : null;
let client: Client | null =
  session.etat === "connecte" ? session.client : null;

if (session.etat === "connecte" && Astro.request.method === "POST") {
  const formulaire = await Astro.request.formData();
  const texte = (nom: string) => String(formulaire.get(nom) ?? "").trim();

  if (formulaire.get("action") === "mot-de-passe") {
    const ancien = String(formulaire.get("ancien") ?? "");
    const nouveau = String(formulaire.get("nouveau") ?? "");
    const confirmation = String(formulaire.get("confirmation") ?? "");
    if (!ancien || !nouveau) erreur = "compte.err.champs";
    else if (nouveau !== confirmation) erreur = "compte.err.mdp_different";
    else if (nouveau.length < 8) erreur = "compte.err.mdp_court";
    else {
      const r = await changerMotDePasse(Astro, { ancien, nouveau });
      if (r.ok)
        return rediriger(
          Astro,
          `${lien(langue, "/compte/infos")}?enregistre=mdp`,
        );
      // L'API refuse par un 400, sans distinguer le mauvais mot de passe
      // actuel d'un nouveau trop court — celui-ci étant déjà écarté plus
      // haut, il ne reste que le premier cas.
      erreur = r.statut === 400 ? "compte.err.mdp_actuel" : r.erreur;
    }
  } else {
    const r = await majInfos(Astro, {
      name: texte("name"),
      phone: texte("phone"),
      acceptsMarketing: formulaire.get("acceptsMarketing") !== null,
    });
    if (r.ok)
      return rediriger(
        Astro,
        `${lien(langue, "/compte/infos")}?enregistre=infos`,
      );
    erreur = r.erreur;
  }
}

const enregistre = Astro.url.searchParams.get("enregistre");
const champ =
  "mt-1 w-full rounded-lg border border-ink/20 bg-paper px-4 py-3 focus:border-terracotta focus:outline-none";
---

<CompteCadre
  langue={langue}
  titre={tr("compte.infos.titre")}
  chemin="/compte/infos"
  menu={session.etat === "connecte"}
>
  {
    erreur && (
      <p class="mb-6 border border-terracotta/40 bg-terracotta/5 px-4 py-3 text-terracotta-deep">
        {tr(erreur)}
      </p>
    )
  }

  {
    enregistre && (
      <p class="mb-6 border border-sage/50 bg-sage/10 px-4 py-3">
        {enregistre === "mdp"
          ? tr("compte.infos.mdp_change")
          : tr("compte.infos.enregistre")}
      </p>
    )
  }

  {
    client && (
      <div class="max-w-lg space-y-12">
        <form method="post" class="space-y-4">
          <label class="block">
            <span class="text-sm font-medium">{tr("compte.email")}</span>
            {/* L'adresse identifie le compte : elle se change au back-office,
                pas ici. */}
            <input
              type="email"
              value={client.email}
              disabled
              class={`${champ} opacity-60`}
            />
          </label>
          <label class="block">
            <span class="text-sm font-medium">{tr("compte.nom")}</span>
            <input
              type="text"
              name="name"
              value={client.name ?? ""}
              autocomplete="name"
              class={champ}
            />
          </label>
          <label class="block">
            <span class="text-sm font-medium">{tr("compte.telephone")}</span>
            <input
              type="tel"
              name="phone"
              value={client.phone ?? ""}
              autocomplete="tel"
              class={champ}
            />
          </label>
          <label class="flex items-start gap-3 text-sm">
            <input
              type="checkbox"
              name="acceptsMarketing"
              checked={client.acceptsMarketing}
              class="mt-1"
            />
            <span>{tr("compte.marketing")}</span>
          </label>
          <button
            type="submit"
            class="rounded-full bg-ink px-6 py-3 font-medium text-paper transition-colors hover:bg-ink/85"
          >
            {tr("compte.infos.enregistrer")}
          </button>
        </form>

        <section class="border-t border-ink/10 pt-8">
          <h2 class="mb-4 text-2xl">{tr("compte.infos.mdp_titre")}</h2>
          <form method="post" class="space-y-4">
            <input type="hidden" name="action" value="mot-de-passe" />
            <label class="block">
              <span class="text-sm font-medium">{tr("compte.infos.mdp_ancien")}</span>
              <input
                type="password"
                name="ancien"
                required
                autocomplete="current-password"
                class={champ}
              />
            </label>
            <label class="block">
              <span class="text-sm font-medium">{tr("compte.infos.mdp_nouveau")}</span>
              <input
                type="password"
                name="nouveau"
                required
                minlength="8"
                autocomplete="new-password"
                class={champ}
              />
              <span class="mt-1 block text-xs text-ink-soft">
                {tr("compte.mdp_aide")}
              </span>
            </label>
            <label class="block">
              <span class="text-sm font-medium">
                {tr("compte.infos.mdp_confirmer")}
              </span>
              <input
                type="password"
                name="confirmation"
                required
                minlength="8"
                autocomplete="new-password"
                class={champ}
              />
            </label>
            <button
              type="submit"
              class="rounded-full bg-ink px-6 py-3 font-medium text-paper transition-colors hover:bg-ink/85"
            >
              {tr("compte.infos.mdp_bouton")}
            </button>
          </form>
        </section>
      </div>
    )
  }
</CompteCadre>
