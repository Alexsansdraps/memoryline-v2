---
/**
 * La caisse, et depuis le 17/11 le panier du site : il n'y a plus de page
 * /panier hors du stand (elle redirige ici). Le récapitulatif s'y modifie —
 * quantités, retraits, « Modifier » —, et le champ « Code promo ou carte
 * cadeau » y vit.
 *
 * La page s'ouvre SANS compte, et depuis le 18/11 on y COMMANDE sans compte,
 * en invitée (Alexandra). Le formulaire est le même pour toutes ; un bandeau
 * propose de se connecter pour retrouver ses adresses, et l'adresse de
 * retour ramène ici, panier intact.
 *
 * Une invitée ne fait pas une fiche par achat (le défaut d'avant le 17/11) :
 * le serveur rattache la commande à la fiche qui porte déjà son e-mail, et
 * n'en crée une qu'en dernier recours. Il ne lit ni n'écrit aucun carnet
 * d'adresses pour elle : sa facturation est l'adresse qu'elle saisit.
 *
 * Le retour de la banque (paiement Stripe à redirection) arrive ici avec ses
 * paramètres, connecté ou non — une session a pu expirer pendant que la
 * cliente était chez sa banque. La caisse le traite sans formulaire : le
 * serveur relit le paiement chez Stripe (POST /payments/stripe/retour), sans
 * avoir besoin de la session.
 *
 * Le compte et le carnet d'adresses sont lus ici, côté serveur, et passés au
 * tunnel : la cliente retrouve son nom et son adresse déjà remplis.
 *
 * Rien du contenu ne s'affiche tant que la caisse n'est pas prête (panier lu,
 * récapitulatif calculé, polices chargées) : un rond qui tourne à la place,
 * puis tout d'un coup (.ml-attente, global.css). Huit secondes au plus.
 */
import Base from "../../layouts/Base.astro";
import { titreDePage } from "../../lib/textes-seo.ts";
import CheckoutIsland from "../../islands/CheckoutIsland.tsx";
import { lien, t, type Langue } from "../../i18n/utils.ts";
import { adresses as lireAdresses, moi, type Adresse } from "../../lib/compte.ts";
import { estLangue, langueDepuisParam } from "../../i18n/utils.ts";

/** Rendu à la demande : la page dépend de qui est connectée. */
export const prerender = false;

if (Astro.params.lang !== undefined && !estLangue(Astro.params.lang))
  return new Response(null, { status: 404 });
const langue: Langue = langueDepuisParam(Astro.params.lang);
const tr = t(langue);

const ici = lien(langue, "/commande");

/*
 * Au stand, ce tunnel n'existe pas.
 *
 * Le client paie sur place : ni compte, ni adresse, ni carte bancaire. Sa
 * dernière étape est le récapitulatif du panier, où il laisse son nom et son
 * adresse e-mail (CartIsland + CommandeStand). Une tablette qui arrive quand
 * même ici — un lien gardé, un retour arrière — le lit, avec de quoi revenir
 * au panier du stand ou quitter le mode stand.
 */
const auStand = Astro.locals.stand;

// Une session qui ne répond pas, ou pas de session : la caisse s'ouvre sans
// compte, le bloc de connexion prend la place du formulaire.
const session = auStand ? null : await moi(Astro).catch(() => null);
const client = session?.ok ? (session.donnees ?? null) : null;
// Le carnet est un confort : s'il ne répond pas, le tunnel s'ouvre quand même
// avec des champs vides plutôt que de refuser la commande.
let carnet: Adresse[] = [];
if (client) {
  try {
    const r = await lireAdresses(Astro);
    if (r.ok && Array.isArray(r.donnees)) carnet = r.donnees;
  } catch {
    carnet = [];
  }
}
---

<Base
  langue={langue}
  title={titreDePage(tr("commande.titre"))}
  path={ici}
  noindex={true}
>
  <section class="mx-auto max-w-[1200px] px-4 sm:px-6 pt-12 pb-16">
    {/* Sans JavaScript, rien n'attend : le contenu se montre tel quel. */}
    <noscript>
      <style>
        .ml-attente > .ml-attente-contenu { visibility: visible !important; }
        .ml-attente > .ml-attente-roue { display: none !important; }
      </style>
    </noscript>
    <div id="ml-attente" class="ml-attente" data-pret={auStand ? "" : undefined}>
      <div class="ml-attente-roue" role="status" aria-label={tr("panier.chargement")}>
        <span class="ml-spinner" aria-hidden="true"></span>
      </div>
      <div class="ml-attente-contenu">
        <nav class="text-sm text-ink-soft">
          <a href={lien(langue, "/")} class="hover:text-terracotta">Memory Line</a> ·
          <a href={lien(langue, "/affiches")} class="hover:text-terracotta"
            >{tr("nav.affiches")}</a
          >
        </nav>
        <h1 class="text-3xl sm:text-4xl mt-4 mb-8">
          {tr("commande.titre")}
        </h1>

        {auStand ? (
          <div class="max-w-xl rounded-2xl border border-ink/10 bg-paper-deep p-6">
            <h2 class="text-xl font-medium">{tr("commande.stand.titre")}</h2>
            <p class="mt-3 text-ink-soft">{tr("commande.stand.texte")}</p>
            <div class="mt-6 flex flex-wrap gap-3">
              <a
                href={`${lien(langue, "/commande")}?stand=0`}
                class="inline-flex items-center justify-center rounded-full bg-ink px-5 py-3 text-paper"
              >
                {tr("commande.stand.quitter")}
              </a>
              <a
                href={`${lien(langue, "/panier")}?stand=${encodeURIComponent(Astro.locals.standValeur ?? "1")}`}
                class="inline-flex items-center justify-center rounded-full border-2 border-ink px-5 py-3 hover:bg-ink hover:text-paper"
              >
                {tr("commande.stand.panier")}
              </a>
            </div>
          </div>
        ) : (
          <CheckoutIsland
            client:only="solid-js"
            langue={langue}
            compte={client
              ? {
                  nom: client.name ?? "",
                  prenom: client.firstName ?? undefined,
                  nomFamille: client.lastName ?? undefined,
                  email: client.email,
                  telephone: client.phone ?? "",
                }
              : undefined}
            carnet={carnet.map((a) => ({
              id: a.id,
              label: a.label,
              name: a.name,
              line1: a.line1,
              line2: a.line2,
              postalCode: a.postalCode,
              city: a.city,
              country: a.country,
              phone: a.phone,
              // L'adresse par défaut est celle de la FACTURATION (18/11), et
              // la première proposée pour la livraison.
              parDefaut: a.isDefaultBilling || a.isDefaultShipping,
            }))}
          />
        )}
      </div>
    </div>
    {/* La sécurité : au bout de 8 s, la page se montre quoi qu'il arrive. */}
    <script is:inline>
      setTimeout(function () {
        var attente = document.getElementById("ml-attente");
        if (attente) attente.setAttribute("data-pret", "");
      }, 8000);
    </script>
  </section>
</Base>
