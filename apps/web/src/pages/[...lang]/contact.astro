const tr = (cle: Cle): string => TEXTES[langue][cle] ?? TEXTES.fr[cle];

/* -------------------------------------------------------------------------- */
/*  Envoi                                                                     */
/* -------------------------------------------------------------------------- */

/**
 * Même exigence que celle de l'API : une adresse sans espace, avec une arobase
 * et un point après. Ce qui est refusé ici l'aurait été là-bas, mais en
 * français et après un aller-retour.
 */
const EMAIL_VALIDE = /^[^\s@,;<>"]+@[^\s@,;<>"]+\.[a-z]{2,}$/i;

let erreur: string | null = null;
let saisie = { nom: "", email: "", sujet: "", message: "", commande: "" };

if (Astro.request.method === "POST") {
  const f = await Astro.request.formData();
  saisie = {
    nom: String(f.get("nom") ?? "").trim(),
    email: String(f.get("email") ?? "").trim(),
    sujet: String(f.get("sujet") ?? "").trim(),
    message: String(f.get("message") ?? "").trim(),
    commande: String(f.get("commande") ?? "").trim(),
  };
  // Le champ piège part tel quel : c'est l'API qui tranche, pour que la règle
  // vive à un seul endroit.
  const piege = String(f.get("societe") ?? "");

  if (saisie.nom.length < 2) erreur = tr("errNom");
  else if (!EMAIL_VALIDE.test(saisie.email)) erreur = tr("errEmail");
  else if (saisie.sujet.length < 2) erreur = tr("errSujet");
  else if (saisie.message.length < 10) erreur = tr("errMessage");

  if (!erreur) {
    // L'adresse du visiteur, recopiée telle que le proxy l'a écrite : voir
    // l'en-tête de ce fichier.
    const entetes: Record<string, string> = { "Content-Type": "application/json" };
    const transmise = Astro.request.headers.get("x-forwarded-for");
    const reelle = Astro.request.headers.get("x-real-ip");
    if (transmise) entetes["x-forwarded-for"] = transmise;
    else if (reelle) entetes["x-real-ip"] = reelle;
    // Le cookie de session, recopié comme le fait l'espace client : une
    // personne connectée reçoit son accusé de réception dans la langue de son
    // compte, et non dans celle de la page d'où elle écrit.
    const cookie = Astro.request.headers.get("cookie");
    if (cookie) entetes["cookie"] = cookie;

    try {
      const reponse = await fetch(`${API_URL}/contact`, {
        method: "POST",
        headers: entetes,
        body: JSON.stringify({ ...saisie, societe: piege, langue }),
      });
      const corps = (await reponse.json().catch(() => ({}))) as {
        ok?: boolean;
        error?: string;
      };
      if (reponse.ok) {
        // Redirection après envoi : sans elle, un rafraîchissement de la page
        // renverrait le même message une seconde fois.
        return Astro.redirect(`${lien(langue, "/contact")}?envoye=1`, 303);
      }
      if (reponse.status === 429) erreur = tr("errTrop");
      // Un refus de saisie que cette page n'avait pas prévu. La phrase de
      // l'API est plus précise, mais elle est en français : elle sert telle
      // quelle à la page française, les autres langues reçoivent la leur.
      else if (reponse.status === 400 && corps.error)
        erreur = langue === LANGUE_DEFAUT ? corps.error : tr("errIllisible");
      else erreur = tr("errEnvoi");
    } catch {
      erreur = tr("errEnvoi");
    }
  }
}

const envoye = Astro.url.searchParams.get("envoye") === "1";

const champ =
  "mt-1 w-full rounded-lg border border-ink/20 bg-paper px-4 py-3 focus:border-terracotta focus:outline-none";
---

<Base
  langue={langue}
  title={titreDePage(tr("titre"))}
  description={descriptionMeta(tr("intro"))}
  path={lien(langue, "/contact")}
>
  <section class="mx-auto max-w-[680px] px-6 pt-12 pb-16 lg:px-12">
    <nav class="text-sm text-ink-soft">
      <a href={lien(langue, "/")} class="hover:text-terracotta">Memory Line</a>
    </nav>
    <h1 class="mt-4 text-3xl sm:text-4xl">{tr("titre")}</h1>

    {
      envoye ? (
        <Fragment>
          <p class="mt-8 border border-sage/50 bg-sage/10 px-4 py-4">
            <strong class="block">{tr("merciTitre")}</strong>
            <span class="mt-1 block text-ink-soft">{tr("merciTexte")}</span>
          </p>
          <p class="mt-6">
            <a
              href={lien(langue, "/contact")}
              class="underline underline-offset-4 hover:text-terracotta"
            >
              {tr("autreMessage")}
            </a>
          </p>
        </Fragment>
      ) : (
        <Fragment>
          <p class="mt-4 text-ink-soft">{tr("intro")}</p>

          {erreur && (
            <p class="mt-6 border border-terracotta/40 bg-terracotta/5 px-4 py-3 text-terracotta-deep">
              {erreur}
            </p>
          )}

          <form method="post" class="mt-8 space-y-4" id="form-contact">
            <label class="block">
              <span class="text-sm font-medium">{tr("nom")}</span>
              <input
                type="text"
                name="nom"
                value={saisie.nom}
                required
                maxlength="100"
                autocomplete="name"
                class={champ}
              />
            </label>

            <label class="block">
              <span class="text-sm font-medium">{tr("email")}</span>
              <input
                type="email"
                name="email"
                value={saisie.email}
                required
                maxlength="200"
                autocomplete="email"
                class={champ}
              />
            </label>

            <label class="block">
              <span class="text-sm font-medium">{tr("sujet")}</span>
              <input
                type="text"
                name="sujet"
                value={saisie.sujet}
                required
                maxlength="150"
                class={champ}
              />
            </label>

            <label class="block">
              <span class="text-sm font-medium">{tr("commande")}</span>
              <input
                type="text"
                name="commande"
                value={saisie.commande}
                maxlength="40"
                class={champ}
              />
              <span class="mt-1 block text-sm text-ink-soft">
                {tr("commandeAide")}
              </span>
            </label>

            <label class="block">
              <span class="text-sm font-medium">{tr("message")}</span>
              {/* La valeur COLLÉE aux balises, sans retour à la ligne : tout
                  ce qui se trouve entre les deux balises d'un « textarea » en
                  fait partie, y compris l'indentation du code. */}
              <textarea
                name="message"
                rows="8"
                required
                maxlength="5000"
                class={champ}>{saisie.message}</textarea>
            </label>

            {/* Le champ piège.
                Il est sorti de l'écran plutôt que masqué par « display:none » :
                les robots les plus soignés ignorent ce qui est caché ainsi,
                mais remplissent tout de même un champ nommé « société ».
                aria-hidden et tabindex le retirent des lecteurs d'écran et du
                parcours au clavier : une personne ne peut pas le remplir par
                accident. */}
            <div
              aria-hidden="true"
              class="pointer-events-none absolute -left-[9999px] h-0 w-0 overflow-hidden"
            >
              <label>
                Société
                <input
                  type="text"
                  name="societe"
                  value=""
                  tabindex="-1"
                  autocomplete="off"
                />
              </label>
            </div>

            <button
              type="submit"
              data-envoi={tr("envoiEnCours")}
              class="w-full rounded-full bg-ink px-6 py-3 font-medium text-paper transition-colors hover:bg-ink/85"
            >
              {tr("envoyer")}
            </button>
          </form>

          <p class="mt-6 border-t border-ink/10 pt-6 text-sm text-ink-soft">
            <a
              href={lien(langue, "/pages/confidentialite")}
              class="underline underline-offset-4 hover:text-terracotta"
            >
              {tr("confidentialite")}
            </a>
          </p>
        </Fragment>
      )
    }
  </section>

  {/* Sans JavaScript le formulaire marche déjà ; ce script n'ajoute qu'un
      garde-fou contre le double clic, qui enverrait le message deux fois. */}
  <script is:inline>
    document.getElementById("form-contact")?.addEventListener("submit", (ev) => {
      const bouton = ev.currentTarget.querySelector("button[type=submit]");
      if (!bouton) return;
      if (bouton.disabled) {
        ev.preventDefault();
        return;
      }
      // Désactivé APRÈS l'envoi du formulaire : un bouton désactivé pendant
      // que le navigateur compose la requête n'est pas transmis.
      setTimeout(() => {
        bouton.disabled = true;
        bouton.textContent = bouton.getAttribute("data-envoi") || bouton.textContent;
      }, 0);
    });
  </script>
</Base>
