  | "intro"
  | "nom"
  | "email"
  | "sujet"
  | "message"
  | "commande"
  | "commandeAide"
  | "envoyer"
  | "envoiEnCours"
  | "merciTitre"
  | "merciTexte"
  | "autreMessage"
  | "errNom"
  | "errEmail"
  | "errSujet"
  | "errMessage"
  | "errEnvoi"
  | "errTrop"
  | "errIllisible"
  | "confidentialite";

/* Allégés le 27/11 (Alexandra : « supprimer les phrases côté client qui sont
   inutiles », « ça fait bcop trop IA ») : l'intro, les aides et les erreurs
