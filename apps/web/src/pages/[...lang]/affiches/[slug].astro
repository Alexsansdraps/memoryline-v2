---
import AfficheVide from "../../../components/AfficheVide.astro";
import ActionEnAttente from "../../../components/ActionEnAttente.astro";
import { dimensionsFormat } from "@memoryline/types";
import Base from "../../../layouts/Base.astro";
import {
  api,
  assetSrcset,
  assetUrl,
  codeErreurApi,
  cadresSurLeSite,
  prixDesCadresSurLeSite,
  encartVideoDuSite,
  formatPrice,
  promotion,
  varianteLaMoinsChere,
  type ProductDetail,
} from "../../../lib/api.ts";
import ProductConfigurator from "../../../islands/ProductConfigurator.tsx";
import AddToCartButton from "../../../islands/AddToCartButton.tsx";
import AfficheIA from "../../../islands/AfficheIA.tsx";
import { signatureDesCreations } from "../../../lib/signature.ts";
import { htmlSur } from "../../../lib/html-sur.ts";
import { languesDuContenu } from "../../../lib/referencement.ts";
import {
  descriptionMeta,
  nommeDejaUneAffiche,
  phraseSeo,
  sansPhraseSeo,
  separateurDuSite,
  texteBrut,
  titreDePage,
} from "../../../lib/textes-seo.ts";
import {
  LANGUE_DEFAUT,
  LOCALE_COMPLETE,
  estLangue,
  langueDepuisParam,
  lien,
  t,
  type Langue,
} from "../../../i18n/utils.ts";

/**
 * Rendue À LA DEMANDE, pas au build : une affiche créée au back-office doit
 * répondre tout de suite. Générée d'avance, son adresse renvoyait 404 jusqu'au
 * build suivant — il fallait un développeur pour publier une affiche.
 */
export const prerender = false;

const { slug } = Astro.params;
// Préfixe inconnu (« /zz/affiches/… ») : 404, plutôt que de servir le
// français sous une adresse qui n'existe pas.
if (Astro.params.lang !== undefined && !estLangue(Astro.params.lang))
  return new Response(null, { status: 404 });
const langue: Langue = langueDepuisParam(Astro.params.lang);
const tr = t(langue);
const locale = LOCALE_COMPLETE[langue];

/*
 * Au stand, aucun montant sur la fiche.
 *
 * Ni le prix de l'affiche, ni celui de chaque taille, ni la remise : la
 * vendeuse annonce ses tarifs de salon, et un chiffre affiché la
 * contredirait devant le client. Le configurateur sait déjà se taire — il
 * porte une option `sansPrix` depuis le premier stand —, et l'affiche tirée
 * d'une photo reçoit la même, puisqu'elle se vend aussi au stand.
 */
const sansPrix = Astro.locals.stand;

/*
 * Les cadres : toujours au stand, où l'affiche repart sous le bras ; sur le
 * site, seulement si la boutique les propose (page Cadres du back-office) —
 * elle ne sait pas encore les expédier. Sans eux, le configurateur n'affiche
 * pas du tout la rubrique.
 */
const cadresProposes = Astro.locals.stand || (await cadresSurLeSite());

/*
 * Le supplément de chaque cadre, sous sa vignette : la boutique peut le
 * taire (page Cadres du back-office). Le prix du cadre reste dans le total.
 * Au stand, `sansPrix` cache déjà tout montant : le réglage n'y est pas lu.
 */
const prixCadres = Astro.locals.stand || (await prixDesCadresSurLeSite());

/*
 * L'encart vidéo de la personnalisation.
 *
 * Au stand, jamais : la vidéo remplace une vendeuse absente, et au stand la
 * vendeuse est là, debout à côté du client — une minute de vidéo sur le wifi
 * d'un salon est la dernière chose à charger sur une tablette. C'est
 * l'inverse exact des cadres, qui eux sont TOUJOURS proposés au stand, d'où
 * deux lignes qui se ressemblent et disent le contraire.
 *
 * Aucune requête de plus : les réglages sont déjà lus une fois par page.
 */
const encartVideo = Astro.locals.stand ? null : await encartVideoDuSite(langue);

/*
 * La signature de la boutique, posée en bas à droite de l'affiche.
 *
 * Lue ICI, sur le serveur, et passée aux îlots : c'est le même réglage que
 * celui du fichier d'impression, et l'aperçu doit en porter la marque dès son
 * premier dessin. Au stand comme sur le site — l'affiche vendue sur le salon
 * s'imprime avec sa signature elle aussi.
 *
 * Aucune requête de plus : les réglages de la page sont déjà lus une fois.
 */
const signature = await signatureDesCreations();

/*
 * Une affiche introuvable n'est PLUS une redirection vers le catalogue.
 *
 * C'était un 302 vers /affiches dans tous les cas — affiche inconnue,
 * archivée, ou API en panne. Google lit cette redirection comme une page
 * vide (« soft 404 ») : l'ancienne fiche perdait son référencement sans que
 * rien ne le dise, et une panne de quelques secondes suffisait à lui montrer
 * des fiches bien vivantes comme disparues. Chaque cas a maintenant sa
 * réponse : 404 pour une adresse inconnue, 410 pour une affiche archivée
 * (partie pour de bon), 503 pour une API qui ne répond pas — Google retente
 * plus tard sans rien retirer. Les trois affichent la page d'erreur du site,
 * avec le menu et de quoi rebondir.
 *
 * Une affiche RETIRÉE qui a une remplaçante n'arrive jamais ici : le
 * middleware la redirige avant (lib/anciennes-adresses.ts, ou la table
 * « Redirections » du back-office).
 */
let product: ProductDetail | null = null;
try {
  product = await api.product(slug!, langue);
} catch (e) {
  const code = codeErreurApi(e);
  if (code === 404) return new Response(null, { status: 404 });
  Astro.locals.statutErreur = code === 410 ? 410 : 503;
  return Astro.rewrite("/404");
}
if (!product) return new Response(null, { status: 404 });

const cleanName = product.name.replace(/\s*[-–]\s*Affiche.*$/i, "");
// La fiche montre l'affiche en grand, mais pas en taille d'impression :
// neuf cents pixels suffisent à l'écran, et le navigateur prend plus petit
// s'il est sur un téléphone.
const image = assetUrl(product.images[0] ?? null, 900);
const imageJeu = assetSrcset(product.images[0] ?? null, [400, 600, 900, 1400]);
const prices = product.variants.map((v) => v.priceCents).filter((c) => c > 0);
const minPrice = prices.length ? Math.min(...prices) : product.basePriceCents;

/**
 * La promotion annoncée en tête de fiche : celle du format le moins cher.
 *
 * C'est le prix que la fiche affiche en gros, donc c'est le sien qu'on barre.
 * Chaque format porte le sien plus bas, dans sa case — un A3 peut être en
 * promotion sans que le A4 le soit.
 */
const moinsChere = varianteLaMoinsChere(product.variants);
const promoPrincipale = moinsChere
  ? promotion(moinsChere.priceCents, moinsChere.compareAtCents)
  : null;

const kindLabel =
  product.kind === "personnalisable"
    ? tr("genre.personnalisable")
    : tr("genre.prete_a_imprimer");

/**
 * La nature de l'affiche en toutes lettres : « Affiche personnalisée »,
 * « Affiche prête à imprimer », dans la langue de la page.
 *
 * C'est ce que les clientes tapent (« affiche personnalisée Vieux Moulin »),
 * et memoryline.fr la porte dans le titre de chaque fiche : le nom importé
 * finit par « - Affiche personnalisée ». Le site l'avait retirée partout avec
 * ce suffixe — titre Google, titre de la page, texte de l'image —, et les 177
 * fiches perdaient leur mot-clé le jour de la bascule. Le nom court reste ce
 * qu'on lit en grand ; la nature revient dans ce que Google lit. Un nom qui
 * dit déjà « affiche » (« Affiche à partir de votre photo ») ne la répète pas.
 */
const natureAuNom = nommeDejaUneAffiche(cleanName)
  ? null
  : product.kind === "personnalisable"
    ? tr("seo.nature.personnalisable")
    : tr("seo.nature.prete_a_imprimer");
/** « VIEUX MOULIN – Affiche personnalisée » : le titre et le nom du produit pour Google. */
const nomComplet = natureAuNom ? `${cleanName} – ${natureAuNom}` : cleanName;
/** « Affiche personnalisée VIEUX MOULIN » : le texte de l'image principale. */
const texteImage = natureAuNom ? `${natureAuNom} ${cleanName}` : cleanName;

/*
 * La fiche est-elle vraiment écrite dans la langue de la page ? Hors des
 * langues où elle est traduite (referencement.ts), l'API rend le texte
 * français : on l'affiche, faute de mieux, mais on ne le présente pas à
 * Google comme une description anglaise ou allemande.
 */
const ficheTraduite = languesDuContenu(product.languesTraduites).includes(langue);

/*
 * La description affichée, sans la ligne « Phrase SEO : … » que 44 fiches
 * importées de Shopify portaient en dernière ligne — une note de travail
 * bourrée de mots-clés, lue par les clientes (lib/textes-seo.ts). Une
 * description qui ne contient rien à lire — cinquante-huit valent
 * « <p><img></p> » — ne s'affiche pas, intertitre compris.
 */
const descriptionAffichee = htmlSur(sansPhraseSeo(product.description));
const texteDescription = texteBrut(descriptionAffichee);
const descriptionVisible =
  texteDescription !== "" || /<img\s[^>]*src=/i.test(descriptionAffichee);

/*
 * Le titre et la description SEO arrivent DANS LA LANGUE DE LA PAGE : la
 * boutique les traduit au back-office, et l'API les rend tels quels. Hors du
 * français, non traduits, ils valent null — jamais le français, qui mettrait
 * du français dans les résultats Google de /en ou /de.
 *
 * La description sous le lien Google, dans l'ordre :
 * 1. celle que la boutique a écrite (champ SEO de la fiche) ;
 * 2. en français, la « Phrase SEO » retirée de l'affichage : c'est, à
 *    quelques mots près, la description que memoryline.fr donne aujourd'hui
 *    à Google pour ces 44 fiches ;
 * 3. le début du texte de la fiche, s'il est dans la langue de la page,
 *    coupé à la fin d'une phrase ou d'un mot — plus jamais en plein mot ni
 *    avec ses retours à la ligne ;
 * 4. une phrase de repli, dans la langue de la page.
 */
const description =
  texteBrut(product.seoDescription) ||
  (langue === LANGUE_DEFAUT ? descriptionMeta(phraseSeo(product.description)) : "") ||
  (ficheTraduite ? descriptionMeta(texteDescription) : "") ||
  descriptionMeta(
    // L'affiche tirée d'une photo n'a ni personnages ni texte à ajouter :
    // sa phrase est celle qui la présente déjà sur la fiche.
    product.aiEnabled
      ? tr("ia.intro")
      : tr(
          product.kind === "personnalisable"
            ? "produit.meta_repli.personnalisable"
            : "produit.meta_repli.prete_a_imprimer",
        ).replace("{nom}", cleanName),
  );
/** Le titre de l'onglet et du résultat Google, quand la boutique en a écrit un. */
const titreSeo = product.seoTitle?.trim() ? separateurDuSite(product.seoTitle.trim()) : null;

// --- Données structurées Schema.org (SEO riche) ------------------------
const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "https://memoryline.fr";
/** Une adresse du site, complète : les données structurées n'en lisent pas d'autres. */
const absolue = (chemin: string) => new URL(chemin, siteUrl + "/").toString();
const urlFiche = absolue(lien(langue, `/affiches/${product.slug}`));

/**
 * Une offre par format, telle que Google Shopping la lit.
 *
 * C'était une fourchette (« AggregateOffer », de 23 à 29 €), qui ne rend pas
 * la fiche éligible aux fiches marchandes de Google : il lui faut chaque
 * format avec SON prix, sa disponibilité et son adresse. Rien n'y est
 * inventé : le prix, le prix barré et la référence sont ceux du back-office.
 * L'affiche est imprimée à la commande, donc toujours disponible, et neuve.
 *
 * La référence (sku) est celle que la boutique a saisie pour ce format ; il
 * n'y en a encore aucune (l'import Shopify ne les a pas reprises). À défaut,
 * l'identifiant que le site donne lui-même à ce format — le numéro de
 * l'affiche et son format, ceux qui désignent la ligne du panier —, stable
 * tant que l'affiche existe.
 */
function offre(v: {
  format: string;
  priceCents: number;
  compareAtCents?: number | null;
  sku?: string | null;
}) {
  const remise = promotion(v.priceCents, v.compareAtCents);
  return {
    "@type": "Offer",
    sku: v.sku?.trim() || `ML-${product!.id}${v.format ? `-${v.format}` : ""}`,
    price: (v.priceCents / 100).toFixed(2),
    priceCurrency: "EUR",
    availability: "https://schema.org/InStock",
    itemCondition: "https://schema.org/NewCondition",
    url: urlFiche,
    seller: { "@type": "Organization", name: "Memory Line" },
    // Le prix barré, quand la boutique en a réglé un : Google l'affiche
    // barré à côté du prix, comme la fiche.
    ...(remise
      ? {
          priceSpecification: {
            "@type": "UnitPriceSpecification",
            priceType: "https://schema.org/StrikethroughPrice",
            price: (remise.avantCents / 100).toFixed(2),
            priceCurrency: "EUR",
          },
        }
      : {}),
  };
}
const formatsTarifes = product.variants.filter((v) => v.priceCents > 0);
const offres = formatsTarifes.length
  ? formatsTarifes.map(offre)
  : [offre({ format: "", priceCents: product.basePriceCents })];

const productLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  "@id": `${urlFiche}#affiche`,
  name: nomComplet,
  // Le texte entier, sans troncature, quand il est dans la langue de la
  // page ; sinon la description de la page, elle dans la bonne langue.
  description: (ficheTraduite && texteDescription) || description,
  url: urlFiche,
  // Toutes les vues de l'affiche, en grand et en adresse complète : Google
  // ne lit pas une image relative (« /api/assets/… »).
  image: product.images
    .map((i) => assetUrl(i, 1400))
    .filter((u): u is string => !!u)
    .map(absolue),
  brand: { "@type": "Brand", name: "Memory Line" },
  offers: offres,
};
// Le fil d'Ariane que Google affiche sous le résultat : dans la langue de la
// page, et vers les adresses de cette langue.
const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: tr("seo.fil_accueil"),
      item: siteUrl + lien(langue, "/"),
    },
    {
      "@type": "ListItem",
      position: 2,
      name: tr("nav.affiches"),
      item: siteUrl + lien(langue, "/affiches"),
    },
    {
      "@type": "ListItem",
      position: 3,
      name: cleanName,
      item: siteUrl + lien(langue, `/affiches/${product.slug}`),
    },
  ],
};
---

<Base
  langue={langue}
  title={titreSeo ?? titreDePage(nomComplet)}
  description={description}
  path={lien(langue, `/affiches/${product.slug}`)}
  languesTraduites={product.languesTraduites}
  type="product"
  image={image ?? undefined}
  jsonLd={[productLd, breadcrumbLd]}
>
  {/* L'affiche prend plus de place que le texte : c'est elle qu'on vient
      voir. Trois réglages, et chacun compte.

      La largeur du cadre monte de 1200 à 1320 px, les marges tombent de 24 à
      16 px sur petit écran, et la gouttière de 40 à 32 : mesuré à 1024 px,
      l'affiche passe de 461 px à près de 600.

      Les colonnes ne sont plus égales : 1,3 contre 1. Deux colonnes de même
      largeur donnaient autant de place à la description qu'au produit.

      `self-start` enfin, avec `h-auto` sur l'image : le cadre prenait la
      hauteur de la colonne de texte, et `object-cover` ROGNAIT l'affiche pour
      la remplir. On perdait un morceau du dessin sans que rien ne le signale.

      Sur tablette et ordinateur, l'image est bornée à la HAUTEUR de l'écran
      (retour de la boutique : « les photos s'affichent en trop gros ») : pleine
      largeur, une affiche en hauteur faisait 1 300 px et il fallait défiler
      pour la voir entière. Largeur automatique, donc jamais rognée ni
      déformée ; le fond de la carte comble les côtés. */}
  <article class="mx-auto grid max-w-[1500px] gap-8 px-4 py-6 sm:px-6 md:grid-cols-[1.7fr_1fr]">
    <div class="self-start overflow-hidden rounded-2xl border border-ink/10 bg-paper-deep">
      {
        image ? (
          <img
            src={image}
            srcset={imageJeu}
            sizes="(min-width: 1280px) 900px, (min-width: 768px) 62vw, 100vw"
            alt={texteImage}
            width="1020"
            height="1400"
            class="h-auto w-full md:mx-auto md:max-h-[calc(100svh-9rem)] md:w-auto md:max-w-full"
          />
        ) : (
          <div class="aspect-[3/4]">
            <AfficheVide nom={cleanName} />
          </div>
        )
      }
    </div>

    <div>
      <nav class="text-sm text-ink-soft">
        <a href={lien(langue, "/")} class="hover:text-terracotta">Memory Line</a> ·
        <a href={lien(langue, "/affiches")} class="hover:text-terracotta"
          >{tr("nav.affiches")}</a
        >
      </nav>
      {/* La typographie de la fiche reprend celle de memoryline.fr (retour
          de la boutique : « police des produits un peu plus grasse, plus
          petite, comme sur le site actuel »). Relevé sur le site actuel : un
          titre de 30 px sur téléphone (36 px ici dès la tablette, la colonne
          de texte y est étroite) ; un prix de 16 à 18 px en demi-gras, un peu
          espacé, là où celui-ci faisait 24 px en maigre ; « Format » en
          13 px demi-gras ; la description, enfin, en demi-gras (global.css,
          `.ml-description-produit`).

          La petite ligne rouge au-dessus du nom dit la nature de l'affiche
          (« Affiche personnalisée ») et fait PARTIE du titre : le titre de la
          page se lit « Affiche personnalisée VIEUX MOULIN », comme on le
          cherche, et non plus « VIEUX MOULIN » seul. À l'écran, rien ne
          bouge — deux lignes, la petite puis la grande. Un nom qui dit déjà
          « affiche » garde l'ancienne ligne, hors du titre. */}
      {
        natureAuNom ? (
          <h1 class="mt-4">
            <span class="block text-xs uppercase tracking-wide text-terracotta">
              {natureAuNom}
            </span>
            <span class="font-serif mt-1 block text-[30px] leading-tight md:text-4xl">
              {cleanName}
            </span>
          </h1>
        ) : (
          <Fragment>
            <p class="mt-4 text-xs uppercase tracking-wide text-terracotta">
              {kindLabel}
            </p>
            <h1 class="font-serif mt-1 text-[30px] leading-tight md:text-4xl">{cleanName}</h1>
          </Fragment>
        )
      }
      {
        /* Le prix barré : saisi au back-office et jamais servi jusqu'ici, la
           fiche taisait une remise pourtant décidée. Rien ne s'affiche quand
           il est vide, nul ou déjà rattrapé par une baisse de prix. */
        sansPrix ? null : promoPrincipale ? (
          <p class="mt-4 flex flex-wrap items-baseline gap-3">
            <span class="text-base font-semibold tracking-[1.3px] text-terracotta-deep md:text-lg">
              {formatPrice(minPrice, locale)}
            </span>
            <s class="text-sm text-ink/45 md:text-base">
              <span class="sr-only">{tr("promo.ancien_prix")} </span>
              {formatPrice(promoPrincipale.avantCents, locale)}
            </s>
            <span class="bg-terracotta px-2 py-0.5 text-sm font-semibold text-paper">
              −{promoPrincipale.pourcent} %
            </span>
          </p>
        ) : (
          <p class="mt-4 text-base font-semibold tracking-[1.3px] md:text-lg">
            {formatPrice(minPrice, locale)}
          </p>
        )
      }

      {/* Le choix de la taille.
          C'étaient des cases inertes : on lisait « A3, 29 € », on cliquait
          dessus sans effet, et il fallait rechoisir son format à l'étape 3 du
          configurateur. Ce sont maintenant de vrais boutons, et le format
          choisi arrive déjà coché là-bas. */}
      <div class="mt-6 space-y-2">
        <p class="text-[13px] font-semibold tracking-[0.4px]" id="titre-format">
          {tr("produit.format")}
        </p>
        <div class="flex gap-3" role="radiogroup" aria-labelledby="titre-format">
          {
            product.variants.map((v, i) => {
              // Chaque format a son propre prix barré : la boutique peut
              // solder le A3 sans toucher au A4.
              const promo = promotion(v.priceCents, v.compareAtCents);
              return (
                <button
                  type="button"
                  role="radio"
                  class="js-format ml-choix border border-ink/20 px-4 py-3 text-left text-sm hover:border-ink/45"
                  data-format={v.format}
                  aria-checked={i === 0 ? "true" : "false"}
                >
                  <div class="font-semibold">{v.format}</div>
                  <div class="text-ink-soft text-xs">{dimensionsFormat(v.format, locale)}</div>
                  {sansPrix ? null : promo ? (
                    <div class="flex flex-wrap items-baseline gap-2">
                      <span class="font-semibold text-terracotta-deep">
                        {formatPrice(v.priceCents, locale)}
                      </span>
                      <s class="text-ink/45">
                        <span class="sr-only">{tr("promo.ancien_prix")} </span>
                        {formatPrice(promo.avantCents, locale)}
                      </s>
                    </div>
                  ) : (
                    <div class="font-semibold text-ink-soft">{formatPrice(v.priceCents, locale)}</div>
                  )}
                </button>
              );
            })
          }
        </div>
      </div>

      {/* Le choix voyage jusqu'au configurateur par un événement du
          navigateur : cette fiche est rendue par le serveur, le
          configurateur est un îlot monté après coup, et un événement est la
          seule chose qu'ils partagent sans que l'un ait à connaître
          l'autre. */}
      <script is:inline>
        (function () {
          var cases = document.querySelectorAll(".js-format");
          if (!cases.length) return;
          function choisir(bouton) {
            // Seul `aria-checked` change : le cadre noir et la coche de la
            // case choisie en découlent (`ml-choix`, global.css).
            cases.forEach(function (c) {
              c.setAttribute("aria-checked", c === bouton ? "true" : "false");
            });
            window.dispatchEvent(
              new CustomEvent("ml:format", {
                detail: { format: bouton.dataset.format },
              }),
            );
          }
          cases.forEach(function (c) {
            c.addEventListener("click", function () {
              choisir(c);
            });
          });
          // Le premier est coché d'emblée : c'est le format le moins cher, et
          // c'est déjà celui sur lequel le configurateur s'ouvre. Sans ce
          // premier appel, la case cochée et le configurateur diraient la
          // même chose sans le montrer.
          choisir(cases[0]);
        })();
      </script>

      {
        /* Une affiche IA n'est pas un autre genre de produit : c'est une
           affiche ordinaire dont la fiche remplace le configurateur par
           l'envoi d'une photo. Le drapeau prime donc sur le genre. */
        product.aiEnabled ? (
          <AfficheIA
            langue={langue}
            client:only="solid-js"
            sansPrix={sansPrix}
            stand={Astro.locals.stand}
            signature={signature}
            product={{
              id: product.id,
              name: cleanName,
              basePriceCents: minPrice,
            }}
            formats={product.variants.map((v) => ({
              format: v.format,
              priceCents: v.priceCents,
            }))}
          >
            <ActionEnAttente
              slot="fallback"
              libelle={tr("produit.personnaliser")}
              note={tr("ia.intro")}
            />
          </AfficheIA>
        ) : product.kind === "personnalisable" ? (
          <ProductConfigurator
            langue={langue}
            client:only="solid-js"
            sansPrix={sansPrix}
            cadresProposes={cadresProposes}
            prixCadres={prixCadres}
            signature={signature}
            video={encartVideo}
            product={{
              id: product.id,
              name: cleanName,
              basePriceCents: minPrice,
            }}
            prices={Object.fromEntries(
              product.variants.map((v) => [v.format, v.priceCents]),
            )}
            foregroundUrl={product.foregroundUrl ?? null}
            formatInitial={product.variants[0]?.format}
            defaults={{
              lignes: [
                product.defaultTitle ?? null,
                product.defaultSubtitle ?? null,
                product.defaultLine3 ?? null,
              ],
              view: product.defaultView ?? null,
            }}
          >
            {/* En modification depuis le panier, l'îlot n'affiche pas la
                quantité : sa silhouette non plus. */}
            <ActionEnAttente
              slot="fallback"
              libelle={tr("produit.personnaliser")}
              quantite={!Astro.url.searchParams.has("edit")}
            />
          </ProductConfigurator>
        ) : (
          <AddToCartButton
            langue={langue}
            client:only="solid-js"
            product={{
              id: product.id,
              name: cleanName,
              basePriceCents: minPrice,
              defaultView: product.defaultView ?? null,
            }}
            formatInitial={product.variants[0]?.format}
          >
            <ActionEnAttente slot="fallback" libelle={tr("produit.ajouter")} quantite />
          </AddToCartButton>
        )
      }

      {
        /* La description, dans la typographie de memoryline.fr : demi-gras,
           légèrement espacée, interligne aéré (`.ml-description-produit`,
           global.css). Les classes « prose » qu'elle portait ne faisaient
           rien — le greffon de typographie n'est pas installé — et le texte
           sortait en 16 px maigre. */
        /* Un intertitre la précède : sans lui, la fiche passait du titre de
           la page aux titres du pied de page, sans rien entre les deux pour
           dire ce qu'est ce texte. Même allure que « Format ». */
        descriptionVisible && (
          <section class="mt-8" aria-labelledby="titre-description">
            <h2
              id="titre-description"
              class="ml-intertitre-fiche text-[13px]"
            >
              {tr("produit.description_titre")}
            </h2>
            <div class="ml-description-produit mt-2" set:html={descriptionAffichee} />
          </section>
        )
      }
    </div>
  </article>
</Base>
