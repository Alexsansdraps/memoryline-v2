---
import Base from "../../../layouts/Base.astro";
import {
  api,
  assetUrl,
  formatPrice,
  type Product,
  type ProductDetail,
} from "../../../lib/api.ts";
import ProductConfigurator from "../../../islands/ProductConfigurator.tsx";
import AddToCartButton from "../../../islands/AddToCartButton.tsx";
import {
  estLangue,
  langueDepuisParam,
  lien,
  t,
  type Langue,
} from "../../../i18n/utils.ts";

/**
 * Rendue À LA DEMANDE, pas au build : une affiche créée au back-office doit
 * répondre tout de suite. Générée d'avance, son adresse renvoyait 404 jusqu'au
 * build suivant — il fallait un développeur pour publier une affiche.
 */
export const prerender = false;

const { slug } = Astro.params;
// Préfixe inconnu (« /zz/affiches/… ») : 404, plutôt que de servir le
// français sous une adresse qui n'existe pas.
if (Astro.params.lang !== undefined && !estLangue(Astro.params.lang))
  return new Response(null, { status: 404 });
const langue: Langue = langueDepuisParam(Astro.params.lang);
const tr = t(langue);

let product: ProductDetail | null = null;
try {
  product = await api.product(slug!, langue);
} catch {
  return Astro.redirect(lien(langue, "/affiches"));
}
if (!product) return Astro.redirect(lien(langue, "/affiches"));

const cleanName = product.name.replace(/\s*[-–]\s*Affiche.*$/i, "");
const image = assetUrl(product.images[0] ?? null);
const prices = product.variants.map((v) => v.priceCents).filter((c) => c > 0);
const minPrice = prices.length ? Math.min(...prices) : product.basePriceCents;

const kindLabel =
  product.kind === "personnalisable"
    ? tr("genre.personnalisable")
    : tr("genre.prete_a_imprimer");

const description =
  product.description?.replace(/<[^>]+>/g, "").slice(0, 160) ||
  `Affiche ${cleanName} — ${kindLabel.toLowerCase()}, imprimée en A4 ou A3. Memory Line.`;

// --- Données structurées Schema.org (SEO riche) ------------------------
const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "https://memoryline.fr";
const productLd = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: cleanName,
  description,
  image: image ? [image] : [],
  brand: { "@type": "Brand", name: "Memory Line" },
  offers: {
    "@type": "AggregateOffer",
    priceCurrency: "EUR",
    lowPrice: (minPrice / 100).toFixed(2),
    highPrice: (
      Math.max(...(prices.length ? prices : [product.basePriceCents])) / 100
    ).toFixed(2),
    offerCount: product.variants.length,
    availability: "https://schema.org/InStock",
  },
};
const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Accueil", item: siteUrl + "/" },
    {
      "@type": "ListItem",
      position: 2,
      name: "Affiches",
      item: siteUrl + "/affiches",
    },
    {
      "@type": "ListItem",
      position: 3,
      name: cleanName,
      item: `${siteUrl}/affiches/${product.slug}`,
    },
  ],
};
---

<Base
  langue={langue}
  title={`${cleanName} | Memory Line`}
  description={description}
  path={lien(langue, `/affiches/${product.slug}`)}
  type="product"
  image={image ?? undefined}
  jsonLd={[productLd, breadcrumbLd]}
>
  <article class="mx-auto max-w-[1200px] px-6 py-10 grid md:grid-cols-2 gap-10">
    <div class="rounded-2xl bg-paper-deep border border-ink/10 overflow-hidden">
      {
        image ? (
          <img src={image} alt={cleanName} class="w-full h-full object-cover" />
        ) : (
          <div class="aspect-[3/4] flex items-center justify-center text-2xl text-ink-soft">
            {cleanName}
          </div>
        )
      }
    </div>

    <div>
      <nav class="text-sm text-ink-soft">
        <a href={lien(langue, "/")} class="hover:text-terracotta">Memory Line</a> ·
        <a href={lien(langue, "/affiches")} class="hover:text-terracotta"
          >{tr("nav.affiches")}</a
        >
      </nav>
      <p class="mt-4 text-xs uppercase tracking-wide text-terracotta">
        {kindLabel}
      </p>
      <h1 class="font-serif text-4xl mt-1">{cleanName}</h1>
      <p class="mt-4 text-2xl">{formatPrice(minPrice)}</p>

      <div class="mt-6 space-y-2">
        <p class="text-sm font-medium">{tr("produit.format")}</p>
        <div class="flex gap-3">
          {
            product.variants.map((v) => (
              <div class="rounded-lg border border-ink/20 px-4 py-3 text-sm">
                <div class="font-medium">{v.format}</div>
                <div class="text-ink-soft">{formatPrice(v.priceCents)}</div>
              </div>
            ))
          }
        </div>
      </div>

      {
        product.kind === "personnalisable" ? (
          <ProductConfigurator
            langue={langue}
            client:only="solid-js"
            product={{
              id: product.id,
              name: cleanName,
              basePriceCents: minPrice,
            }}
            prices={Object.fromEntries(
              product.variants.map((v) => [v.format, v.priceCents]),
            )}
            foregroundUrl={product.foregroundUrl ?? null}
            defaults={{
              title: product.defaultTitle ?? null,
              subtitle: product.defaultSubtitle ?? null,
              view: product.defaultView ?? null,
            }}
          />
        ) : (
          <AddToCartButton
            langue={langue}
            client:only="solid-js"
            product={{
              id: product.id,
              name: cleanName,
              basePriceCents: minPrice,
              defaultView: product.defaultView ?? null,
            }}
          />
        )
      }

      {
        product.description && (
          <div
            class="mt-8 prose prose-sm text-ink-soft max-w-none"
            set:html={product.description}
          />
        )
      }
    </div>
  </article>
</Base>
