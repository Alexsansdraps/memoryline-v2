---
/**
 * La page introuvable.
 *
 * Il n'y en avait aucune : une adresse fautive tombait sur l'écran nu d'Astro,
 * sans menu, sans pied de page, sans même le logo — un cul-de-sac dont on ne
 * sort qu'en fermant l'onglet. Elle sert bien plus souvent qu'on ne le croit :
 * une affiche retirée de la vente, un lien de courrier vieux d'un an, une page
 * du back-office pas encore écrite.
 *
 * Elle est posée à la RACINE et non sous « [...lang] », parce que c'est ce que
 * Astro rend quand plus aucune route ne correspond — y compris pour une
 * adresse préfixée d'une langue. La langue est donc relue dans l'adresse
 * demandée, et non reçue en paramètre.
 */
import Base from "../layouts/Base.astro";
import { titreDePage } from "../lib/textes-seo.ts";
import {
  LANGUE_DEFAUT,
  estLangue,
  lien,
  t,
  type Langue,
} from "../i18n/utils.ts";

/** Rendue à la demande : sans cela, l'adresse demandée serait inconnue. */
export const prerender = false;

/**
 * La langue du visiteur, lue dans l'adresse qui a échoué.
 *
 * « /de/nimportequoi » doit répondre en allemand : quelqu'un qui lit le site
 * en allemand n'a pas à recevoir du français au moment précis où il est déjà
 * perdu. Un préfixe inconnu vaut le français, comme partout ailleurs.
 */
// L'adresse d'ORIGINE : une fiche qui se réécrit ici (voir plus bas) laisse
// « /404 » dans Astro.url, et la langue se lit dans ce que le visiteur a
// demandé, pas dans ce détour.
const premierSegment = Astro.originPathname.split("/")[1] ?? "";
const langue: Langue = estLangue(premierSegment) ? premierSegment : LANGUE_DEFAUT;
const tr = t(langue);

/**
 * Le code 404 est REDIT ici.
 *
 * Astro rend bien cette page pour une adresse sans route, mais elle est aussi
 * rendue par les routes qui refusent elles-mêmes ce qu'on leur demande. Sans
 * cette ligne, certaines de ces réponses partiraient en 200 : le visiteur
 * verrait la bonne page, et un moteur indexerait « Cette page n'existe pas »
 * comme un contenu ordinaire.
 *
 * Deux autres codes passent par cette page, posés par la fiche qui s'y
 * réécrit (Astro.locals.statutErreur) : 410 pour une affiche archivée — même
 * texte, elle n'existe plus — et 503 quand l'API ne répond pas, avec un texte
 * qui dit de réessayer et un délai que les robots respectent. Astro force 404
 * sur cette route quoi qu'on écrive ici : c'est le middleware qui rétablit
 * le 410 ou le 503, une fois la page rendue.
 */
const statut = Astro.locals.statutErreur ?? 404;
Astro.response.status = statut;
const indisponible = statut === 503;
if (indisponible) Astro.response.headers.set("Retry-After", "120");
const titre = indisponible ? tr("503.titre") : tr("404.titre");
// Le chemin demandé, sans la barre finale qu'Astro ajoute en se réécrivant :
// c'est lui que le sélecteur de langue propose dans les autres langues.
const cheminDemande = Astro.originPathname.replace(/(.)\/+$/, "$1");
---

<Base langue={langue} title={titreDePage(titre)} path={cheminDemande} noindex>
  <section
    class="mx-auto flex max-w-[720px] flex-col items-start px-6 pt-20 pb-24 lg:px-12"
  >
    <p class="text-sm uppercase tracking-wide text-terracotta">{statut}</p>
    <h1 class="mt-2 text-3xl sm:text-4xl">{titre}</h1>
    <p class="mt-4 text-ink-soft">{indisponible ? tr("503.texte") : tr("404.texte")}</p>

    {/* Deux portes de sortie, pas une liste : le catalogue pour qui flâne,
        la recherche pour qui cherchait quelque chose de précis — et c'est
        précisément le cas de qui atterrit ici. */}
    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href={lien(langue, "/affiches")}
        class="bg-ink px-5 py-2.5 text-paper hover:bg-ink/85 transition-colors"
        >{tr("404.affiches")}</a
      >
      <a
        href={lien(langue, "/recherche")}
        class="border border-ink/20 px-5 py-2.5 hover:border-ink transition-colors"
        >{tr("404.recherche")}</a
      >
    </div>

    <a
      href={lien(langue, "/")}
      class="mt-8 text-sm text-ink-soft underline underline-offset-4 hover:text-terracotta transition-colors"
      >{tr("404.accueil")}</a
    >
  </section>
</Base>
