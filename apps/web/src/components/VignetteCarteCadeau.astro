---
/**
 * La carte cadeau dans une grille d'affiches (18/11, Alexandra : « il
 * faudrait intégrer ce produit quelque part »).
 *
 * Pas une affiche du catalogue (voir pages/[...lang]/carte-cadeau.astro) :
 * une vignette à part, dessinée comme VignetteAffiche — même case 1020/1400,
 * même nom, même prix — qui mène à la page de la carte. Son image est celle
 * d'Alexandra, prolongée en portrait sur son propre fond
 * (public/carte-cadeau/vignette-*.webp). Le prix dit « Dès 5 € » : le
 * montant est libre (CARTE_MONTANT_MIN_CENTS de @memoryline/types).
 */
import { formatPrice } from "../lib/api.ts";
import { LOCALE_COMPLETE, lien, t, type Langue } from "../i18n/utils.ts";

interface Props {
  langue: Langue;
  /** Les tailles de la grille qui l'accueille, comme pour ses voisines. */
  sizes: string;
  titre?: "h2" | "h3";
}

const { langue, sizes, titre: Titre = "h3" } = Astro.props;
const tr = t(langue);
const prix = tr("carte.vignette.prix").replace("{montant}", formatPrice(500, LOCALE_COMPLETE[langue]));
---

<li class="group ml-apparition">
  <a href={lien(langue, "/carte-cadeau")} class="block">
    <div class="ml-squelette relative flex items-center justify-center overflow-hidden" style="aspect-ratio:1020/1400">
      <img
        src="/carte-cadeau/vignette-600.webp"
        srcset="/carte-cadeau/vignette-400.webp 400w, /carte-cadeau/vignette-600.webp 600w, /carte-cadeau/vignette-1020.webp 1020w"
        sizes={sizes}
        alt={`${tr("carte.titre")} Memory Line`}
        width="1020"
        height="1400"
        loading="lazy"
        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
      />
    </div>
    <div class="px-2 pt-2.5 sm:pt-3">
      {/* En capitales, comme les noms d'affiches de la boutique. */}
      <Titre class="ml-vignette-nom text-[13px] uppercase leading-snug group-hover:underline underline-offset-4 lg:text-[14px]">
        {tr("carte.titre")}
      </Titre>
      <p class="mt-1 text-[14px] font-semibold tracking-[0.6px] text-ink-soft sm:text-[15px]">{prix}</p>
    </div>
  </a>
</li>
