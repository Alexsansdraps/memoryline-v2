---
/**
 * Composant SEO centralisé : title, meta description, canonical, Open Graph,
 * Twitter Card, robots, hreflang, et JSON-LD optionnel.
 * Utilisé par le layout Base pour que CHAQUE page ait un SEO propre.
 */
import { jsonPourScript } from "../lib/html-sur.ts";
import {
  LANGUES,
  LANGUE_DEFAUT,
  LOCALE_COMPLETE,
  type Langue,
} from "../i18n/utils.ts";

interface Props {
  /** Langue de la page — c'est elle qu'on déclare aux réseaux (og:locale). */
  langue?: Langue;
  title: string;
  description: string;
  /** Chemin de la page (ex. "/affiches/soissons-..."). Sert au canonical. */
  path?: string;
  /** Image absolue ou relative pour Open Graph (partage réseaux). */
  image?: string;
  /**
   * Les dimensions de `image`, telle qu'elle est servie, et son texte : sans
   * elles, Facebook ne garantit pas l'aperçu au premier partage.
   */
  imageInfos?: { largeur: number; hauteur: number; alt: string };
  /** "website" (défaut) ou "product" pour les fiches produit. */
  type?: "website" | "product" | "article";
  noindex?: boolean;
  /**
   * Les langues où cette page existe vraiment — celles que le gabarit
   * déclare en hreflang. Absent : les cinq langues du site.
   */
  alternatives?: readonly Langue[];
  /** Objet(s) JSON-LD (Schema.org) à injecter. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  langue = LANGUE_DEFAUT,
  title,
  description,
  path = Astro.url.pathname,
  image = "/og-default.png",
  imageInfos,
  type = "website",
  noindex = false,
  alternatives = LANGUES,
  jsonLd,
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "https://memoryline.fr";
const canonical = new URL(path, siteUrl + "/").toString();
const ogImage = image.startsWith("http") ? image : new URL(image, siteUrl + "/").toString();
/*
 * L'image par défaut (accueil, rayons, pages) : le logo sur fond blanc, en
 * 1 200 × 630, le format des aperçus de Facebook, WhatsApp ou LinkedIn. Elle
 * manquait — /og-default.png répondait 404, et un lien partagé n'avait pas
 * d'image. Ses dimensions, connues, sont annoncées : le réseau dessine
 * l'aperçu dès le premier partage, sans attendre de l'avoir téléchargée.
 */
const imageParDefaut = image === "/og-default.png";
/*
 * Les autres images (le visuel d'une fiche) annoncent les leurs quand la page
 * les connaît : Shopify les déclarait, et sans elles le réseau attend d'avoir
 * téléchargé l'image pour dessiner l'aperçu (AUDIT-SEO.md, OG-1).
 */
const infosImage = imageParDefaut
  ? { largeur: 1200, hauteur: 630, alt: "Memory Line" }
  : imageInfos;
/*
 * Ce que la page dit aux robots.
 *
 * L'environnement de test ne doit pas être indexé, page par page — le
 * robots.txt seul n'empêche pas une URL de finir dans l'index : tout y est
 * « noindex, nofollow ». C'est le SEUL réglage qui ferme l'indexation du site
 * entier (PUBLIC_NOINDEX, lu au build), avec le « Disallow: / » de robots.txt.
 *
 * En ligne, une page qu'on ne veut pas dans Google (panier, compte, une fiche
 * non traduite sous /en…) est « noindex, follow » : elle n'entre pas dans
 * l'index, mais ses liens — le menu, le pied de page, les affiches — restent
 * suivis, et c'est par eux que le robot trouve le reste de la boutique.
 */
const enTest = import.meta.env.PUBLIC_NOINDEX === "true";
const robots = enTest
  ? "noindex, nofollow"
  : noindex
    ? "noindex, follow"
    : "index, follow, max-image-preview:large";
const jsonLdList = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
/**
 * La locale à la mode d'Open Graph : « fr_FR », avec un tiret bas.
 *
 * Elle était écrite en dur en français : la page anglaise partagée sur
 * Facebook ou WhatsApp se déclarait française. Les autres langues suivent en
 * « alternate », comme les hreflang du gabarit — et seulement celles-là :
 * une fiche écrite en français seul ne s'annonce plus en anglais ou en
 * allemand aux réseaux, alors que Google, lui, ne l'y voit plus.
 */
const localeOg = (l: Langue) => LOCALE_COMPLETE[l].replace("-", "_");
---

<!-- Primaire -->
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={robots} />

<!-- Open Graph (Facebook, LinkedIn, etc.) -->
<meta property="og:site_name" content="Memory Line" />
<meta property="og:locale" content={localeOg(langue)} />
{
  alternatives.filter((l) => l !== langue).map((l) => (
    <meta property="og:locale:alternate" content={localeOg(l)} />
  ))
}
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
{
  infosImage && (
    <Fragment>
      <meta property="og:image:width" content={String(infosImage.largeur)} />
      <meta property="og:image:height" content={String(infosImage.hauteur)} />
      <meta property="og:image:alt" content={infosImage.alt} />
    </Fragment>
  )
}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<!-- Données structurées Schema.org -->
{
  jsonLdList.map((data) => (
    <script
      type="application/ld+json"
      set:html={jsonPourScript(data)}
    />
  ))
}
