---
import { api, type Banner } from "../lib/api.ts";

let banner: Banner | null = null;
try {
  banner = await api.banner();
} catch {
  // API non joignable -> pas de bandeau
}
---

{
  banner && (
    <div
      class="px-4 py-2.5 text-center text-[13px] font-semibold tracking-[0.04em]"
      style={`background:${banner.bgColor ?? "#9c1616"};color:${banner.textColor ?? "#ffffff"}`}
    >
      <span>{banner.message}</span>
      {banner.linkUrl && banner.linkLabel && (
        <a href={banner.linkUrl} class="underline underline-offset-2 ml-2">
          {banner.linkLabel}
        </a>
      )}
    </div>
  )
}
