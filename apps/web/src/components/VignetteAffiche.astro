---
/**
 * Une affiche dans une grille : l'image, le nom, le prix.
 *
 * Écrite une fois et partagée par le rayon, la page de résultats et la
 * vitrine de l'accueil : des grilles écrites séparément finissent par
 * diverger — l'une sait montrer un prix barré, l'autre l'a oublié, la
 * troisième charge l'image en pleine taille — et c'est précisément le défaut
 * qu'on répare ici.
 *
 * L'image porte tout, le texte se fait discret dessous, comme sur
 * memoryline.fr. Le rapport 1020/1400 est celui des visuels de la boutique.
 */
import AfficheVide from "./AfficheVide.astro";
import {
  assetSrcset,
  assetUrl,
  formatPrice,
  promotion,
  varianteLaMoinsChere,
  type Product,
  type ProductVariant,
} from "../lib/api.ts";
import { LOCALE_COMPLETE, lien, t, type Langue } from "../i18n/utils.ts";
import { nommeDejaUneAffiche } from "../lib/textes-seo.ts";

interface Props {
  /**
   * L'affiche — seulement ce que la vignette dessine. Une affiche du
   * catalogue convient telle quelle ; celle d'un bloc « produits » d'une page
   * du site aussi, qui n'a ni genre ni prix barré.
   */
  affiche: Pick<Product, "slug" | "name" | "image" | "basePriceCents"> & {
    variants: Pick<ProductVariant, "priceCents" | "compareAtCents">[];
    /** Le genre, quand on le connaît : il nomme l'image (« Affiche personnalisée LYON »). */
    kind?: Product["kind"];
  };
  langue: Langue;
  /**
   * Le niveau du nom de l'affiche dans le plan de la page.
   *
   * Un cran sous l'intertitre de la grille : « Nos best-sellers » sur
   * l'accueil, le nombre d'affiches d'un rayon, l'intertitre d'une page libre
   * — d'où `h3` par défaut. Une grille qui n'a pas d'intertitre au-dessus
   * d'elle (les résultats de recherche) passe `h2`.
   */
  titre?: "h2" | "h3";
  /**
   * Charger l'image tout de suite plutôt qu'à l'approche de l'écran.
   *
   * Réservé aux premières vignettes : ce sont elles que la visiteuse voit
   * avant d'avoir bougé, et les différer retarde l'affichage de la page pour
   * rien. Au-delà, la paresse reprend ses droits — cent quatre-vingts images
   * chargées d'un coup ne serviraient personne.
   */
  prioritaire?: boolean;
  /**
   * La toute première vignette de la page, dont l'image part AVANT les
   * autres (`fetchpriority="high"`).
   *
   * Les vignettes ont toutes la même taille : la première arrivée est le plus
   * grand élément de la page pour Google (LCP), et Chrome met sinon toutes
   * les images en file au même rang jusqu'à la mise en forme de la page.
   * Une seule par page, pas la rangée entière : des images toutes
   * prioritaires ne le sont plus. Et aucune quand un bandeau visuel la
   * précède : c'est alors lui, le plus grand, et il a déjà la priorité
   * (BandeauxVisuels.astro).
   */
  premiere?: boolean;
  /**
   * La largeur que la vignette occupe VRAIMENT à l'écran, pour `sizes`.
   *
   * Seule la grille la connaît : ses colonnes, ses marges et ses gouttières.
   * Une valeur fausse ne se voit pas tout de suite — le navigateur prend
   * simplement une image trop petite et l'étire, et l'affiche paraît floue sur
   * un grand écran. Par défaut, la grille du rayon (GRILLE_RAYON), que la page
   * de résultats reprend à l'identique.
   */
  sizes?: string;
}

/**
 * La largeur d'une vignette dans la grille du rayon et des résultats.
 *
 * Écrite d'après la grille elle-même (affiches.astro) : deux colonnes, trois
 * dès 1024 px, dans un cadre de 1600 px au plus, 8 px de marge sur téléphone
 * (24 puis 40 au-delà) et des gouttières de 4 puis 8 px. L'ancienne valeur
 * annonçait 300 px au-dessus de 1536 px d'écran alors que la vignette en
 * mesure 500 : l'image servie était deux fois trop petite.
 */
const GRILLE_RAYON =
  "(min-width: 1600px) 502px, (min-width: 1024px) calc((100vw - 96px) / 3), (min-width: 640px) calc((100vw - 56px) / 2), calc((100vw - 20px) / 2)";

const {
  affiche,
  langue,
  prioritaire = false,
  premiere = false,
  sizes = GRILLE_RAYON,
  titre: Titre = "h3",
} = Astro.props;
const tr = t(langue);
const locale = LOCALE_COMPLETE[langue];

/*
 * Au stand, aucun montant.
 *
 * La vendeuse annonce ses prix de salon, qui ne sont pas ceux du site : un
 * chiffre affiché sous la vignette la contredirait devant le client. La
 * remise, elle, disparaît aussi — une étiquette « −20 % » sans prix ne veut
 * plus rien dire.
 */
const sansPrix = Astro.locals.stand;

/**
 * Le nom sans son suffixe commercial.
 *
 * Les noms viennent de Shopify et finissent presque tous par « - Affiche
 * personnalisée ». Répété sous cent quatre-vingts vignettes, il n'apprend
 * rien et mange deux lignes de chaque cartouche.
 */
const nom = affiche.name.replace(/\s*[-–]\s*Affiche.*$/i, "");

/**
 * Le texte de l'image : la nature de l'affiche avec son nom, « Affiche
 * personnalisée LYON ». C'est ce que lit la recherche d'images, et ce que le
 * suffixe retiré ci-dessus disait. Sans genre connu (bloc d'une page libre),
 * ou quand le nom dit déjà « affiche », le nom seul.
 */
const texteImage =
  affiche.kind && !nommeDejaUneAffiche(nom)
    ? `${tr(affiche.kind === "personnalisable" ? "seo.nature.personnalisable" : "seo.nature.prete_a_imprimer")} ${nom}`
    : nom;

/**
 * La promotion, s'il y en a une — celle de la variante la MOINS CHÈRE.
 *
 * C'est son prix que la vignette affiche : barrer l'ancien prix d'un autre
 * format annoncerait une remise qui ne correspond à rien de ce qui est écrit
 * juste à côté.
 */
const moinsChere = varianteLaMoinsChere(affiche.variants);
const promo = moinsChere
  ? promotion(moinsChere.priceCents, moinsChere.compareAtCents)
  : null;

/**
 * Le prix montré : le plus bas, et « – » jusqu'au plus haut s'il varie.
 *
 * En promotion, la fourchette s'efface au profit du seul prix soldé. « 23 € –
 * 29 € » suivi d'un « 29 € » barré se lit deux fois : le 29 € de la fourchette
 * est le prix du grand format, celui qui est barré était celui du petit. Une
 * vignette n'a pas la place d'expliquer la différence — la fiche, elle, montre
 * les deux formats et leurs deux prix.
 */
const tarifs = affiche.variants.map((v) => v.priceCents).filter((c) => c > 0);
const mini = tarifs.length ? Math.min(...tarifs) : affiche.basePriceCents;
const maxi = tarifs.length ? Math.max(...tarifs) : affiche.basePriceCents;
const prix =
  promo || mini === maxi
    ? formatPrice(mini, locale)
    : `${formatPrice(mini, locale)} – ${formatPrice(maxi, locale)}`;
/*
 * Le visuel, et les tailles dans lesquelles le navigateur peut le prendre.
 *
 * Les vignettes ont grandi — trois colonnes au lieu de quatre et des
 * gouttières resserrées, soit environ 450 px de large sur un écran de 1440, et
 * le double de pixels réels sur un écran à haute densité. L'ancien jeu
 * s'arrêtait à 600 px et `sizes` annonçait 300 : le navigateur choisissait
 * donc une image de 400 px qu'il agrandissait, et l'affiche paraissait molle.
 * Le navigateur prend, parmi celles proposées, la plus petite qui couvre la
 * largeur annoncée par `sizes`.
 *
 * 900 et 1400 existent déjà côté API (`/assets/:fichier?l=`) : il n'y avait
 * qu'à les proposer.
 *
 * Pour la plupart des visuels, « 1400 » rend 1020 px : l'API n'agrandit
 * jamais. Sans conséquence ici — la case a son propre rapport et l'image la
 * remplit (`object-cover`), quelle que soit la largeur annoncée, et le
 * navigateur prend le même fichier. Sur la fiche, où l'image prend sa taille
 * naturelle, l'écart comptait : elle annonce la vraie largeur (api.ts,
 * assetSrcset).
 */
const image = assetUrl(affiche.image, 600);
const imageJeu = assetSrcset(affiche.image, [400, 600, 900, 1400]);
---

<li class="group ml-apparition">
  <a href={lien(langue, `/affiches/${affiche.slug}`)} class="block">
    <div
      class="relative flex items-center justify-center overflow-hidden bg-paper-deep"
      style="aspect-ratio:1020/1400"
    >
      {
        image ? (
          <img
            src={image}
            srcset={imageJeu}
            sizes={sizes}
            alt={texteImage}
            width="1020"
            height="1400"
            loading={prioritaire || premiere ? "eager" : "lazy"}
            fetchpriority={premiere ? "high" : undefined}
            class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]"
          />
        ) : (
          <AfficheVide nom={nom} />
        )
      }
      {
        /* L'étiquette de remise sur l'image, pas sous le prix : c'est ce
           qu'on repère en balayant une grille des yeux. */
        promo &&
          !sansPrix && (
            <span class="absolute left-0 top-0 bg-terracotta px-2.5 py-1 text-[13px] font-semibold text-paper">
              −{promo.pourcent} %
            </span>
          )
      }
    </div>
    {/* Le nom, plus petit et un peu plus gras — comme sur memoryline.fr, où
        il fait 12 à 13 px. À 17 px et en poids normal, il se lisait comme
        un titre sous chaque image et tirait l'œil loin des affiches.

        Le texte est rentré de 8 px : les gouttières ne font plus que 4 à
        8 px, et sans ce retrait le nom d'une colonne venait toucher celui de
        la voisine. Le prix garde une taille de lecture, un cran au-dessus du
        nom : c'est la ligne qu'on vient chercher.

        Le prix est en demi-gras, un peu espacé, comme sur memoryline.fr
        (relevé d'octobre 2026 : 16 px, graisse 600). En maigre et en gris,
        il s'effaçait sous le nom ; retour de la boutique : « police des
        produits un peu plus grasse, plus petite ». Sa taille, elle, ne
        bouge pas : elle est déjà sous celle du site actuel. */}
    <div class="px-2 pt-2.5 sm:pt-3">
      <Titre class="ml-vignette-nom text-[13px] leading-snug group-hover:underline underline-offset-4 lg:text-[14px]">
        {nom}
      </Titre>
      {
        sansPrix ? null : promo ? (
          <p class="mt-1 flex flex-wrap items-baseline gap-2 text-[14px] tracking-[0.6px] sm:text-[15px]">
            <span class="font-semibold text-terracotta-deep">{prix}</span>
            <s class="text-ink/45">
              <span class="sr-only">{tr("promo.ancien_prix")} </span>
              {formatPrice(promo.avantCents, locale)}
            </s>
          </p>
        ) : (
          <p class="mt-1 text-[14px] font-semibold tracking-[0.6px] text-ink-soft sm:text-[15px]">
            {prix}
          </p>
        )
      }
    </div>
  </a>
</li>
