---
/**
 * « Continuer avec Google », au-dessus des formulaires de connexion et
 * d'inscription (18/11).
 *
 * Rien ne s'affiche tant que la boutique ne l'a pas branché : l'identifiant
 * client Google posé sur le serveur, l'API le dit (/compte/google/etat ;
 * apps/api/src/google-oauth.ts). Le lien part vers l'API, qui envoie chez
 * Google puis revient sur `retour`, connectée.
 */
import { googleActif } from "../lib/compte.ts";
import { PUBLIC_API_URL } from "../lib/api-navigateur.ts";
import { t, type Langue } from "../i18n/utils.ts";

interface Props {
  langue: Langue;
  /** La page où revenir une fois connectée (un chemin du site). */
  retour: string;
}

const { langue, retour } = Astro.props;
const tr = t(langue);
const actif = await googleActif(Astro);
const href = `${PUBLIC_API_URL.replace(/\/+$/, "")}/compte/google?retour=${encodeURIComponent(retour)}`;
---

{
  actif && (
    <div class="mt-6">
      <a
        href={href}
        class="flex w-full items-center justify-center gap-3 rounded-full border border-ink/25 bg-paper px-6 py-3 font-medium transition-colors hover:border-ink"
      >
        <svg width="18" height="18" viewBox="0 0 48 48" aria-hidden="true">
          <path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z" />
          <path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z" />
          <path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z" />
          <path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z" />
        </svg>
        {tr("compte.google")}
      </a>
      <p class="mt-6 flex items-center gap-3 text-xs uppercase tracking-wide text-ink-soft">
        <span class="h-px flex-1 bg-ink/10" aria-hidden="true" />
        {tr("compte.ou")}
        <span class="h-px flex-1 bg-ink/10" aria-hidden="true" />
      </p>
    </div>
  )
}
