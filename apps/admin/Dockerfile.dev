# Dockerfile DEV pour le back-office Astro (SSR, hot-reload).
FROM node:24-alpine

RUN corepack enable
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/admin/package.json apps/admin/package.json
COPY packages/types/package.json packages/types/package.json

RUN pnpm install --frozen-lockfile

EXPOSE 4322

# Au démarrage, les dépendances sont d'abord remises en accord avec le
# lockfile. Les node_modules vivent dans des volumes anonymes (cf.
# docker-compose.yml), et Docker les REPREND d'un conteneur au suivant,
# même après une reconstruction de l'image : un vieux volume masquait alors
# les dépendances neuves (« tsx: not found », « Failed to resolve import
# @memoryline/types »). Quand rien n'a changé, c'est « Already up to date »
# en une seconde ; le magasin pnpm est dans le dépôt monté (.pnpm-store).
# Le filtre « ... » installe ce paquet ET ses dépendances du workspace, et
# rien d'autre : les node_modules des autres applis sont sur le disque de
# l'hôte, et ce n'est pas à ce conteneur d'y écrire.
CMD ["sh", "-c", "pnpm install --frozen-lockfile --prefer-offline --filter @memoryline/admin... && exec pnpm --filter @memoryline/admin run dev"]
