---
import "../styles/admin.css";
import { url, relPath, apiUrl } from "../lib/url.ts";
interface Props {
  title: string;
}
const { title } = Astro.props;
const path = relPath(Astro.url.pathname);

// Navigation type admin Shopify (vocabulaire familier à la cliente).
// `owner: true` = écran de configuration, masqué aux comptes « seller », qui
// vendent et impriment mais ne modifient ni le catalogue ni les réglages.
interface NavItem {
  href: string;
  label: string;
  icon: string;
  owner?: boolean;
  /** Sous-entrées, affichées en retrait sous le parent. */
  children?: NavItem[];
}

/** Un thème du menu. `titre` à null pour le bloc du haut, qui n'en a pas. */
interface GroupeNav {
  titre: string | null;
  entrees: NavItem[];
}

/*
 * Sept groupes, rangés par NATURE de la chose qu'on manipule — comme Shopify,
 * d'où vient la cliente et dont le vocabulaire lui est déjà familier. Une
 * hésitation s'y tranche en ouvrant l'écran, alors qu'un rangement par
 * fréquence d'usage se périme dès que les habitudes changent.
 *
 * `owner: true` = écran de configuration, masqué aux comptes « seller », qui
 * vendent et impriment mais ne modifient ni le catalogue ni les réglages.
 */
const nav: GroupeNav[] = [
  // Sans titre, tout en haut : les deux écrans qu'on ouvre en arrivant, avant
  // même de savoir ce qu'on vient faire.
  {
    titre: null,
    entrees: [
      { href: "/", label: "Accueil", icon: "🏠", owner: true },
      // Deux écrans, deux questions. « Finances » répond à « où est
      // l'argent » ; « Statistiques » à « qu'est-ce qui se vend ». Les
      // réunir donnerait un écran qu'on ouvre pour deux raisons opposées.
      { href: "/statistiques", label: "Statistiques", icon: "📈", owner: true },
      { href: "/finances", label: "Finances", icon: "📊", owner: true },
    ],
  },
  {
    titre: "Commandes",
    entrees: [
      { href: "/commandes", label: "Commandes en ligne", icon: "🛒", owner: true },
      // La seule entrée qu'un vendeur voit : son stand, et rien d'autre.
      { href: "/ventes-salon", label: "Ventes stand", icon: "🎪" },
      { href: "/paniers", label: "Paniers abandonnés", icon: "🛍️", owner: true },
      // Ici et pas dans le catalogue : une carte cadeau n'est pas un article à
      // vendre, c'est de l'argent que quelqu'un a déjà payé.
      { href: "/cartes-cadeaux", label: "Cartes cadeaux", icon: "🎁", owner: true },
    ],
  },
  {
    titre: "Produits",
    entrees: [
      {
        href: "/produits",
        label: "Produits",
        icon: "🖼️",
        owner: true,
        // Aucun autre écran ne pointe vers l'import : sans cette entrée, il
        // redevient introuvable, ce qu'il a déjà été une fois.
        children: [
          // Où ranger les pages « Affiches personnalisables » et « prêtes à
          // imprimer ». Les collections, elles, se rangent dans leur propre
          // écran.
          { href: "/produits/ordre", label: "Ordre d'affichage", icon: "↕️", owner: true },
          { href: "/produits/import", label: "Importer un fichier", icon: "📥", owner: true },
        ],
      },
      { href: "/collections", label: "Collections", icon: "📚", owner: true },
      // 🪵 et non 🖼 : Produits, Cadres et Décors portaient trois cadres photo
      // presque identiques, et sur un petit écran on vise la forme avant de
      // lire le mot.
      { href: "/cadres", label: "Cadres", icon: "🪵", owner: true },
    ],
  },
  {
    // « Atelier » et surtout pas « Personnalisation » : l'écran de
    // personnalisation des courriers arrive, et l'œil serait allé sur le
    // groupe qui porte le mot — celui des vêtements de personnages.
    titre: "Atelier",
    entrees: [
      {
        href: "/personnages",
        label: "Personnages",
        icon: "🧸",
        owner: true,
        children: [
          // Sa seule porte était un bouton discret en haut de la liste des
          // personnages. C'est pourtant lui qui rend utilisable une pièce
          // fraîchement créée, décochée partout par défaut.
          { href: "/personnages/correspondances", label: "Pièces par personnage", icon: "🧩", owner: true },
          { href: "/categories-pieces", label: "Catégories de pièces", icon: "🎨", owner: true },
        ],
      },
      { href: "/types-affiche", label: "Types d'affiche", icon: "🎭", owner: true },
      // Le libellé garde « des affiches » : c'est le seul mot qui rattache cet
      // écran au catalogue, et on y NOMME un décor, on n'en ajoute pas.
      { href: "/decors", label: "Décors des affiches", icon: "🏞️", owner: true },
      {
        href: "/ia",
        label: "Affiches IA",
        icon: "✨",
        owner: true,
        // Les styles proposés à la cliente — « Couple », « Paysage » — vivent
        // sous les affiches IA dont ils sont le réglage, et non à côté :
        // on n'y va qu'après avoir ouvert celles-ci.
        children: [
          { href: "/ia/styles", label: "Styles proposés", icon: "🎨", owner: true },
        ],
      },
    ],
  },
  {
    titre: "Clients et marketing",
    entrees: [
      { href: "/clients", label: "Clients", icon: "👥", owner: true },
      { href: "/promotions", label: "Promotions", icon: "🎟️", owner: true },
      { href: "/lettre", label: "Lettre d'information", icon: "✉️", owner: true },
    ],
  },
  {
    titre: "Boutique en ligne",
    entrees: [
      // « et offre » : enregistrer cet écran enregistre le message ET la
      // remise qu'il annonce. Le nom doit prévenir qu'on touche à de l'argent.
      { href: "/bandeau", label: "Bandeau et offre", icon: "📢", owner: true },
      // Les grandes images en haut des pages (la bannière de Noël de
      // l'ancienne boutique). Juste sous le bandeau de texte, avec lequel on
      // les confondrait autrement : le nom de chacun dit ce qu'il porte.
      { href: "/bandeaux-visuels", label: "Bandeaux visuels", icon: "🌄", owner: true },
      // « Contenu » ne disait rien et se confondait avec « Pages du site »,
      // juste en dessous. Cet écran ne touche que quelques blocs de
      // l'accueil, la vidéo de la personnalisation et le pied de page.
      { href: "/contenu", label: "Accueil et pied de page", icon: "✏️", owner: true },
      { href: "/pages", label: "Pages du site", icon: "📄", owner: true },
      { href: "/menu", label: "Menu du site", icon: "🧭", owner: true },
    ],
  },
  {
    titre: "Réglages",
    entrees: [
      { href: "/livraison", label: "Livraison", icon: "📦", owner: true },
      // Ni « d'essai » — le mot ne décrivait qu'un bouton et faisait passer
      // l'écran pour un bac à sable — ni « automatiques », qui serait faux :
      // la facture et l'avis d'expédition ne partent que sur son geste.
      { href: "/courriers", label: "Courriers", icon: "📬", owner: true },
      { href: "/comptes", label: "Comptes", icon: "🔑", owner: true },
      // Dans « Réglages » et pas dans un groupe à soi : on n'y va pas pour
      // travailler, on y va quand on cherche quelque chose qu'on a rangé.
      // Chaque écran garde par ailleurs sa propre section « Archivés ».
      { href: "/archives", label: "Archives", icon: "🗄️", owner: true },
      // Les questions qui reviennent (commandes test, bordereau, import CSV…).
      { href: "/aide", label: "Aide", icon: "❓", owner: true },
    ],
  },
];
const isOwner = Astro.locals.user?.role === "owner";

/**
 * Lien vers la boutique. Derrière le proxy, le site est à la racine et le
 * back-office sous /bo — d'où le chemin absolu, qui ne passe donc PAS par
 * url() : celui-ci préfixerait la base et renverrait sur le back-office.
 */
const lienBoutique = import.meta.env.PUBLIC_SITE_URL ?? "/";
const allowed = (item: NavItem) => isOwner || !item.owner;
const visibleNav = nav
  .map((groupe) => ({
    ...groupe,
    entrees: groupe.entrees.filter(allowed).map((item) => ({
      ...item,
      children: item.children?.filter(allowed) ?? [],
    })),
  }))
  // Un groupe dont tout le contenu est masqué ne laisse pas son titre derrière
  // lui : un vendeur verrait cinq intertitres au-dessus de rien.
  .filter((groupe) => groupe.entrees.length > 0);

/*
 * Une liste d'un seul élément ne se range pas.
 *
 * Le compte porte sur le menu ENTIER, et non sur chaque groupe : « au moins
 * deux entrées dans ce groupe » se retournerait contre la patronne le jour où
 * un groupe tomberait à une ligne — son titre disparaîtrait, et cette ligne
 * flotterait sous le groupe précédent comme si elle en faisait partie.
 */
const nombreEntrees = visibleNav.reduce((n, g) => n + g.entrees.length, 0);
const avecGroupes = nombreEntrees > 1;

/** Une entrée est active sur sa page — l'accueil seulement à l'identique. */
const isActive = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(href + "/");
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · Memory Line Admin</title>
    {/* Le thème est posé AVANT le premier rendu : appliqué après, la page
        s'afficherait en clair une fraction de seconde avant de basculer. */}
    <script is:inline>
      (function () {
        var choix = null;
        try {
          choix = localStorage.getItem("bo-theme");
        } catch (e) {
          /* navigation privée : on retombe sur la préférence du système */
        }
        var sombre =
          choix === "sombre" ||
          (choix !== "clair" &&
            window.matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.dataset.theme = sombre ? "dark" : "light";
      })();
    </script>
  </head>
  <body class="min-h-screen">
    <div class="flex min-h-screen">
      <aside
        class="w-60 shrink-0 bg-bo-nav text-white/90 flex flex-col"
      >
        <div
          class="flex items-center justify-between gap-2 border-b border-white/10 px-5 py-4"
        >
          <span class="text-lg font-semibold">Memory&nbsp;Line</span>
          {/* Voir la boutique, comme dans Shopify : on ouvre dans un autre
              onglet pour ne pas perdre l'écran en cours de préparation. */}
          <a
            href={lienBoutique}
            target="_blank"
            rel="noopener"
            title="Voir la boutique"
            aria-label="Voir la boutique"
            class="text-white/45 transition-colors hover:text-white"
          >
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M14 4h6v6" />
              <path d="M20 4 10 14" />
              <path d="M19 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h5" />
            </svg>
          </a>
        </div>
        <nav
          class="flex-1 overflow-y-auto py-3"
          data-groupes={avecGroupes ? "1" : undefined}
        >
          {
            visibleNav.map((groupe) => {
              // Le groupe de l'écran ouvert est déplié de force, quoi qu'ait
              // retenu le navigateur : on ne se perd jamais dans un menu qui
              // cache l'endroit où l'on se trouve.
              const ici = groupe.entrees.some(
                (e) =>
                  isActive(e.href) || e.children.some((c) => isActive(c.href)),
              );
              return (
                <div data-groupe={groupe.titre ?? ""} data-ici={ici ? "1" : undefined}>
                  {avecGroupes && groupe.titre && (
                    <button
                      type="button"
                      data-titre
                      aria-expanded={ici ? "true" : "false"}
                      class="flex w-full items-center gap-1.5 px-5 pt-4 pb-1.5 text-left text-[11px] font-semibold tracking-wider text-white/40 uppercase hover:text-white/70"
                    >
                      <span data-fleche aria-hidden="true" class="text-[9px]">
                        {ici ? "▾" : "▸"}
                      </span>
                      <span>{groupe.titre}</span>
                    </button>
                  )}
                  {/* Fermé d'emblée, sauf le groupe de l'écran ouvert. C'est
                      le SERVEUR qui le décide, et non le script : laissé au
                      navigateur, le menu s'afficherait déployé le temps d'un
                      battement avant de se refermer, à chaque page. */}
                  <div data-corps hidden={avecGroupes && !!groupe.titre && !ici}>
                    {groupe.entrees.map((item) => {
                      // Le parent reste mis en avant quand on est sur une de
                      // ses sous-pages, pour que la section courante reste
                      // lisible.
                      const active =
                        isActive(item.href) ||
                        item.children.some((c) => isActive(c.href));
                      return (
                        // Un bloc par entrée, sous-liens compris : « Importer
                        // un fichier » appartient à « Produits » et se lit en
                        // retrait dessous.
                        <div>
                          <a
                            href={url(item.href)}
                            class={`flex items-center gap-3 px-5 py-2.5 text-sm transition-colors ${
                              active
                                ? "bg-white/10 text-white font-medium"
                                : "hover:bg-white/5"
                            }`}
                          >
                            <span>{item.icon}</span>
                            <span>{item.label}</span>
                          </a>
                          {item.children.map((child) => (
                            <a
                              href={url(child.href)}
                              class={`flex items-center gap-2 py-2 pl-12 pr-5 text-[13px] transition-colors ${
                                isActive(child.href)
                                  ? "bg-white/10 text-white font-medium"
                                  : "text-white/70 hover:bg-white/5"
                              }`}
                            >
                              <span class="text-white/40">└</span>
                              <span>{child.label}</span>
                            </a>
                          ))}
                        </div>
                      );
                    })}
                  </div>
                </div>
              );
            })
          }
        </nav>
        <div class="px-5 py-3 text-xs text-white/40 border-t border-white/10">
          Back-office · v0{!isOwner && " · vendeur"}
        </div>
        <script is:inline>
          (function () {
            var menu = document.querySelector("aside nav");
            if (!menu) return;

            // Un menu réduit à une seule ligne — ce que voit un vendeur —
            // n'a pas de groupes, donc rien à ouvrir ni à fermer.
            if (menu.dataset.groupes !== "1") return;

            var CLE = "ml_groupes_ouverts";

            // Reste d'un glisser-déposer retiré depuis. Sans cet effacement,
            // la liste dormirait indéfiniment dans le navigateur de la seule
            // personne qui s'en était servie.
            try {
              localStorage.removeItem("ml_ordre_menu");
              localStorage.removeItem("ml_groupes_replies");
            } catch (e) {
              /* navigation privée : il n'y avait rien à effacer */
            }

            function lire() {
              try {
                var brut = localStorage.getItem(CLE);
                var liste = brut ? JSON.parse(brut) : null;
                return Array.isArray(liste) ? liste : [];
              } catch (e) {
                return [];
              }
            }
            function ecrire(liste) {
              try {
                if (liste.length) localStorage.setItem(CLE, JSON.stringify(liste));
                else localStorage.removeItem(CLE);
              } catch (e) {
                /* sans stockage, l'ouverture ne tient que le temps de la page */
              }
            }

            function groupes() {
              return Array.prototype.slice.call(
                menu.querySelectorAll("[data-groupe]"),
              );
            }

            function appliquer() {
              var ouverts = lire();
              groupes().forEach(function (g) {
                var titre = g.querySelector("[data-titre]");
                var corps = g.querySelector("[data-corps]");
                if (!titre || !corps) return;
                // Deux raisons d'être ouvert : on s'y trouve, ou elle l'a
                // ouvert. La première ne se discute pas — un menu qui cache
                // l'endroit où l'on est ne sert à rien.
                var ouvert =
                  !!g.dataset.ici || ouverts.indexOf(g.dataset.groupe) !== -1;
                corps.hidden = !ouvert;
                titre.setAttribute("aria-expanded", ouvert ? "true" : "false");
                var fleche = titre.querySelector("[data-fleche]");
                if (fleche) fleche.textContent = ouvert ? "▾" : "▸";
              });
            }

            menu.addEventListener("click", function (e) {
              var titre = e.target.closest("[data-titre]");
              if (!titre) return;
              var groupe = titre.closest("[data-groupe]");
              if (!groupe) return;
              var corps = groupe.querySelector("[data-corps]");
              // Le clic inverse ce qui est À L'ÉCRAN, et non ce qu'a retenu le
              // navigateur. Le groupe où l'on se trouve est ouvert sans figurer
              // dans la liste : la basculer l'y ajoutait, il restait donc
              // ouvert, et le premier clic ne faisait rien de visible.
              var ouvrir = !!corps && corps.hidden;
              // Son clic passe devant la règle qui déroule le groupe où l'on
              // se trouve : un titre sur lequel on appuie sans que rien ne
              // bouge serait pire qu'un titre qui ne s'ouvre pas du tout.
              groupe.removeAttribute("data-ici");
              var ouverts = lire();
              var rang = ouverts.indexOf(groupe.dataset.groupe);
              if (ouvrir && rang === -1) ouverts.push(groupe.dataset.groupe);
              if (!ouvrir && rang !== -1) ouverts.splice(rang, 1);
              ecrire(ouverts);
              appliquer();
            });

            appliquer();
          })();
        </script>
      </aside>

      <div class="flex-1 min-w-0">
        <header
          class="h-14 bg-bo-surface border-b border-bo-border flex items-center gap-4 px-6"
        >
          {/* Le titre garde la priorité sur la largeur : le champ de recherche
              se contente de la place restante (flex-1 part de zéro), et le
              titre ne se coupe qu'à la toute fin, sur une fenêtre étroite, au
              lieu de pousser la déconnexion hors de l'écran. */}
          <h1 class="min-w-0 truncate text-base font-semibold">{title}</h1>
          {/* La recherche est réservée à la propriétaire, comme la route qui
              la sert : un vendeur n'a pas à fouiller les commandes du site ni
              les fiches clients. Absente plutôt que grisée, pour ne pas
              montrer une porte qui ne s'ouvre pas. */}
          {
            isOwner && (
              <div
                id="ml-recherche"
                class="relative min-w-0 max-w-md flex-1"
                data-api={apiUrl("")}
                data-base={url("")}
              >
                <svg
                  width="15"
                  height="15"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  aria-hidden="true"
                  class="pointer-events-none absolute left-2.5 top-1/2 -translate-y-1/2 text-bo-muted"
                >
                  <circle cx="11" cy="11" r="7" />
                  <path d="m20 20-3.5-3.5" />
                </svg>
                {/* Pas de <form> : sans JavaScript, ce champ ne doit mener
                    nulle part plutôt que vers une page qui n'existe pas. Il
                    naît donc inactif, et le script le réveille. */}
                <input
                  id="ml-recherche-champ"
                  type="text"
                  disabled
                  autocomplete="off"
                  spellcheck={false}
                  placeholder="Rechercher une affiche, une commande, un client…"
                  aria-label="Rechercher dans le back-office"
                  role="combobox"
                  aria-expanded="false"
                  aria-controls="ml-recherche-panneau"
                  aria-autocomplete="list"
                  class="w-full rounded-lg border border-bo-border bg-bo-bg py-1.5 pl-8 pr-9 text-sm outline-none placeholder:text-bo-muted focus:border-bo-accent"
                />
                {/* Annoncé discrètement : qui ne le remarque pas garde la
                    souris, qui le remarque gagne une seconde à chaque fois. */}
                <kbd
                  id="ml-recherche-raccourci"
                  hidden
                  class="pointer-events-none absolute right-2 top-1/2 -translate-y-1/2 rounded border border-bo-border px-1.5 py-0.5 text-[11px] leading-none text-bo-muted"
                >
                  /
                </kbd>
                <div
                  id="ml-recherche-panneau"
                  hidden
                  role="listbox"
                  aria-label="Résultats de la recherche"
                  class="absolute left-0 right-0 top-full z-40 mt-1 max-h-[70vh] overflow-y-auto overscroll-contain rounded-lg border border-bo-border bg-bo-surface py-1 shadow-lg"
                />
              </div>
            )
          }
          <div class="ml-auto flex shrink-0 items-center gap-3 text-sm text-bo-muted">
            {/* Clair / sombre / système. Le choix vit dans le navigateur :
                l'écran de la boutique et celui du salon n'ont pas la même
                lumière, il n'y a pas de bon réglage partagé. */}
            <details class="bo-menu relative">
              <summary
                class="rounded border border-bo-border px-2 py-1 hover:bg-bo-bg"
                title="Apparence"
              >
                <span data-theme-icone>◐</span>
              </summary>
              <div
                class="absolute right-0 z-30 mt-1 w-40 rounded-lg border border-bo-border bg-bo-surface py-1 shadow-lg"
              >
                <button
                  type="button"
                  data-theme-choix="clair"
                  class="block w-full px-3 py-1.5 text-left hover:bg-bo-bg"
                >
                  ☀️ Clair
                </button>
                <button
                  type="button"
                  data-theme-choix="sombre"
                  class="block w-full px-3 py-1.5 text-left hover:bg-bo-bg"
                >
                  🌙 Sombre
                </button>
                <button
                  type="button"
                  data-theme-choix="systeme"
                  class="block w-full px-3 py-1.5 text-left hover:bg-bo-bg"
                >
                  ◐ Comme le système
                </button>
              </div>
            </details>
            {Astro.locals.user && <span>{Astro.locals.user.email}</span>}
            <form method="POST" action={url("/logout")}>
              <button class="text-bo-accent hover:underline">Déconnexion</button>
            </form>
          </div>
        </header>
        <script is:inline>
          // La recherche du haut de page.
          //
          // Elle interroge « /admin/recherche » et range les réponses par
          // catégorie. Trois choses comptent plus que le reste ici :
          //
          //   - On n'appelle PAS l'API à chaque touche. On attend que la
          //     frappe s'arrête, et la requête précédente est abandonnée dès
          //     qu'une nouvelle part : sans cela, « cathédrale » lancerait
          //     onze recherches dont dix pour rien, et la plus lente pourrait
          //     revenir en dernier et écraser la bonne réponse.
          //   - Tout se construit avec createElement et textContent. Les noms
          //     de clients et les titres d'affiches viennent de la base : les
          //     coller en HTML ferait exécuter, dans le back-office, ce que
          //     quelqu'un aurait écrit dans un formulaire de la boutique.
          //   - Le clavier seul doit suffire : la barre oblique pour venir,
          //     les flèches pour choisir, Entrée pour ouvrir, Échap pour
          //     renoncer.
          (function () {
            var boite = document.getElementById("ml-recherche");
            if (!boite) return; // vendeur : pas de recherche
            var champ = document.getElementById("ml-recherche-champ");
            var panneau = document.getElementById("ml-recherche-panneau");
            var raccourci = document.getElementById("ml-recherche-raccourci");
            if (!champ || !panneau) return;

            // Le champ naît inactif pour ne rien promettre sans JavaScript.
            champ.disabled = false;
            if (raccourci) raccourci.hidden = false;

            var API = boite.dataset.api || "";
            var BASE = boite.dataset.base || "";
            var MINIMUM = 2;
            // Le temps qu'on laisse aux doigts. Trop court, on rappelle l'API
            // au milieu d'un mot ; trop long, le panneau traîne derrière la
            // frappe. Deux dixièmes de seconde est le point où l'on ne sent
            // ni l'un ni l'autre.
            var ATTENTE = 180;

            var minuteur = null;
            var encours = null; // AbortController de la requête en vol
            var lignes = []; // les <a> du panneau, dans l'ordre d'affichage
            var choisi = -1;

            function ouvrir() {
              panneau.hidden = false;
              champ.setAttribute("aria-expanded", "true");
            }

            function fermer() {
              panneau.hidden = true;
              panneau.replaceChildren();
              champ.setAttribute("aria-expanded", "false");
              champ.removeAttribute("aria-activedescendant");
              lignes = [];
              choisi = -1;
            }

            /** Un mot au milieu du panneau : recherche en cours, ou rien. */
            function message(texte) {
              lignes = [];
              choisi = -1;
              var p = document.createElement("p");
              p.className = "px-3 py-3 text-sm text-bo-muted";
              p.textContent = texte;
              panneau.replaceChildren(p);
              ouvrir();
            }

            function marquer() {
              for (var i = 0; i < lignes.length; i++) {
                var actif = i === choisi;
                lignes[i].classList.toggle("bg-bo-bg", actif);
                lignes[i].setAttribute("aria-selected", actif ? "true" : "false");
              }
              if (choisi >= 0 && lignes[choisi]) {
                champ.setAttribute("aria-activedescendant", lignes[choisi].id);
                // « nearest » : on ne recentre pas la liste sous les yeux de
                // quelqu'un qui descend d'un cran.
                lignes[choisi].scrollIntoView({ block: "nearest" });
              } else {
                champ.removeAttribute("aria-activedescendant");
              }
            }

            function deplacer(pas) {
              if (!lignes.length) return;
              choisi = (choisi + pas + lignes.length) % lignes.length;
              marquer();
            }

            /** L'adresse d'une vignette, telle que le navigateur doit la demander. */
            function vignette(chemin) {
              if (!chemin) return "";
              return chemin.indexOf("http") === 0 ? chemin : API + chemin;
            }

            function dessiner(reponse) {
              var groupes = (reponse && reponse.groupes) || [];
              if (!groupes.length) {
                message("Rien ne correspond à « " + reponse.q + " ».");
                return;
              }
              lignes = [];
              var morceaux = document.createDocumentFragment();
              groupes.forEach(function (groupe) {
                var titre = document.createElement("p");
                titre.className =
                  "px-3 pb-1 pt-2 text-[11px] font-semibold uppercase tracking-wide text-bo-muted";
                titre.textContent = groupe.titre;
                morceaux.appendChild(titre);

                (groupe.resultats || []).forEach(function (r) {
                  var lien = document.createElement("a");
                  lien.id = "ml-recherche-" + lignes.length;
                  lien.href = BASE + r.href;
                  lien.setAttribute("role", "option");
                  lien.className =
                    "flex items-center gap-3 px-3 py-2 text-sm no-underline";

                  if (r.image) {
                    var img = document.createElement("img");
                    img.src = vignette(r.image);
                    img.alt = "";
                    img.loading = "lazy";
                    img.className =
                      "h-8 w-6 shrink-0 rounded border border-bo-border object-cover";
                    lien.appendChild(img);
                  }

                  var textes = document.createElement("span");
                  textes.className = "min-w-0";
                  var nom = document.createElement("span");
                  nom.className = "block truncate";
                  nom.textContent = r.titre;
                  textes.appendChild(nom);
                  if (r.detail) {
                    var sous = document.createElement("span");
                    sous.className = "block truncate text-xs text-bo-muted";
                    sous.textContent = r.detail;
                    textes.appendChild(sous);
                  }
                  lien.appendChild(textes);

                  // La souris et les flèches désignent la MÊME ligne : deux
                  // surbrillances à l'écran ne diraient plus laquelle Entrée
                  // ouvre.
                  var rang = lignes.length;
                  lien.addEventListener("mousemove", function () {
                    if (choisi === rang) return;
                    choisi = rang;
                    marquer();
                  });

                  lignes.push(lien);
                  morceaux.appendChild(lien);
                });
              });
              panneau.replaceChildren(morceaux);
              // Le premier résultat est retenu d'emblée : taper un numéro de
              // commande puis Entrée doit ouvrir la commande, sans détour par
              // la flèche du bas.
              choisi = lignes.length ? 0 : -1;
              marquer();
              ouvrir();
            }

            function chercher() {
              var saisie = champ.value.trim();
              if (encours) encours.abort();
              if (saisie.length < MINIMUM) {
                fermer();
                return;
              }
              message("Recherche…");
              var controleur = new AbortController();
              encours = controleur;
              fetch(API + "/admin/recherche?q=" + encodeURIComponent(saisie), {
                // Le back-office et l'API sont derrière le même proxy : le
                // cookie de session part tout seul, sans rien exposer de plus.
                credentials: "same-origin",
                headers: { Accept: "application/json" },
                signal: controleur.signal,
              })
                .then(function (r) {
                  if (!r.ok) throw new Error(String(r.status));
                  return r.json();
                })
                .then(function (reponse) {
                  // La saisie a pu changer pendant le trajet : on ne dessine
                  // que la réponse à ce qui est écrit maintenant.
                  if (controleur !== encours) return;
                  encours = null;
                  dessiner(reponse);
                })
                .catch(function (e) {
                  if (e && e.name === "AbortError") return;
                  if (controleur !== encours) return;
                  encours = null;
                  message("La recherche n'a pas répondu. Réessayez.");
                });
            }

            champ.addEventListener("input", function () {
              // On attend l'arrêt de la frappe : voir ATTENTE plus haut.
              if (minuteur) clearTimeout(minuteur);
              minuteur = setTimeout(chercher, ATTENTE);
            });

            // Revenir sur un champ déjà rempli rouvre ce qu'on y avait trouvé,
            // au lieu d'obliger à retaper une lettre.
            champ.addEventListener("focus", function () {
              if (champ.value.trim().length >= MINIMUM && panneau.hidden)
                chercher();
            });

            champ.addEventListener("keydown", function (e) {
              if (e.key === "ArrowDown") {
                e.preventDefault();
                deplacer(1);
              } else if (e.key === "ArrowUp") {
                e.preventDefault();
                deplacer(-1);
              } else if (e.key === "Enter") {
                if (choisi >= 0 && lignes[choisi]) {
                  e.preventDefault();
                  lignes[choisi].click();
                }
              } else if (e.key === "Escape") {
                // Le premier Échap ferme le panneau, le second rend le champ :
                // renoncer à la liste et renoncer à la recherche sont deux
                // gestes différents.
                if (!panneau.hidden) {
                  e.preventDefault();
                  fermer();
                } else {
                  champ.value = "";
                  champ.blur();
                }
              }
            });

            // Un clic à l'extérieur ferme, comme partout ailleurs.
            document.addEventListener("mousedown", function (e) {
              if (!boite.contains(e.target)) fermer();
            });

            // La barre oblique amène ici. Une touche seule plutôt qu'une
            // combinaison : elle se tape d'une main. Elle ne prend donc la
            // main QUE si l'on n'est pas déjà en train d'écrire quelque part,
            // sinon on ne pourrait plus taper « 12/03 » dans une note.
            document.addEventListener("keydown", function (e) {
              if (e.key !== "/" || e.ctrlKey || e.metaKey || e.altKey) return;
              var ou = document.activeElement;
              var balise = ou && ou.tagName ? ou.tagName.toLowerCase() : "";
              if (
                balise === "input" ||
                balise === "textarea" ||
                balise === "select" ||
                (ou && ou.isContentEditable)
              )
                return;
              e.preventDefault();
              champ.focus();
              champ.select();
            });
          })();
        </script>
        {/* Pleine largeur : les écrans du back-office sont des tableaux et
            des grilles de vignettes, une colonne de texte les étranglait. */}
        <main class="p-6">
          <slot />
        </main>
      </div>
    </div>

    <script is:inline>
      // Bascule d'apparence. « Système » ne fige rien : la page suit ensuite
      // le réglage du poste, y compris s'il change en cours de journée.
      (function () {
        var media = window.matchMedia("(prefers-color-scheme: dark)");
        var icone = document.querySelector("[data-theme-icone]");
        var ICONES = { clair: "☀️", sombre: "🌙", systeme: "◐" };

        function lire() {
          try {
            return localStorage.getItem("bo-theme") || "systeme";
          } catch (e) {
            return "systeme";
          }
        }

        function appliquer(choix) {
          var sombre = choix === "sombre" || (choix === "systeme" && media.matches);
          document.documentElement.dataset.theme = sombre ? "dark" : "light";
          if (icone) icone.textContent = ICONES[choix] || ICONES.systeme;
        }

        document.querySelectorAll("[data-theme-choix]").forEach(function (b) {
          b.addEventListener("click", function () {
            var choix = b.dataset.themeChoix;
            try {
              if (choix === "systeme") localStorage.removeItem("bo-theme");
              else localStorage.setItem("bo-theme", choix);
            } catch (e) {
              /* sans stockage, le choix ne tiendra que le temps de la page */
            }
            appliquer(choix);
            b.closest("details")?.removeAttribute("open");
          });
        });

        media.addEventListener("change", function () {
          if (lire() === "systeme") appliquer("systeme");
        });

        appliquer(lire());
      })();
    </script>
    {/* Tous les tableaux se trient par colonne (lib/tri-tableaux.ts). */}
    <script>
      import "../lib/tri-tableaux.ts";
    </script>
  </body>
</html>
