---
import "../styles/admin.css";
import { url, relPath } from "../lib/url.ts";
interface Props {
  title: string;
}
const { title } = Astro.props;
const path = relPath(Astro.url.pathname);

// Navigation type admin Shopify (vocabulaire familier à la cliente).
// `owner: true` = écran de configuration, masqué aux comptes « seller », qui
// vendent et impriment mais ne modifient ni le catalogue ni les réglages.
interface NavItem {
  href: string;
  label: string;
  icon: string;
  owner?: boolean;
  /** Sous-entrées, affichées en retrait sous le parent. */
  children?: NavItem[];
}

const nav: NavItem[] = [
  { href: "/", label: "Accueil", icon: "🏠" },
  { href: "/commandes", label: "Commandes en ligne", icon: "🛒" },
  { href: "/ventes-salon", label: "Ventes salon", icon: "🎪" },
  { href: "/produits", label: "Produits", icon: "🖼️", owner: true },
  { href: "/cadres", label: "Cadres", icon: "🖼", owner: true },
  { href: "/personnages", label: "Personnages", icon: "🧸", owner: true },
  { href: "/types-affiche", label: "Types d'affiche", icon: "🎭", owner: true },
  { href: "/categories-pieces", label: "Catégories de pièces", icon: "🎨", owner: true },
  { href: "/promotions", label: "Promotions", icon: "🎟️", owner: true },
  { href: "/livraison", label: "Livraison", icon: "📦", owner: true },
  { href: "/bandeau", label: "Bandeau du site", icon: "📢", owner: true },
  { href: "/contenu", label: "Contenu", icon: "✏️", owner: true },
  { href: "/lettre", label: "Lettre d'information", icon: "✉️", owner: true },
  { href: "/comptes", label: "Comptes", icon: "🔑", owner: true },
];
const isOwner = Astro.locals.user?.role === "owner";
const allowed = (item: NavItem) => isOwner || !item.owner;
const visibleNav = nav.filter(allowed).map((item) => ({
  ...item,
  children: item.children?.filter(allowed) ?? [],
}));

/** Une entrée est active sur sa page — l'accueil seulement à l'identique. */
const isActive = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(href + "/");
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · Memory Line Admin</title>
  </head>
  <body class="min-h-screen">
    <div class="flex min-h-screen">
      <aside
        class="w-60 shrink-0 bg-bo-nav text-white/90 flex flex-col"
      >
        <div class="px-5 py-4 text-lg font-semibold border-b border-white/10">
          Memory&nbsp;Line
        </div>
        <nav class="flex-1 py-3">
          {
            visibleNav.map((item) => {
              // Le parent reste mis en avant quand on est sur une de ses
              // sous-pages, pour que la section courante reste lisible.
              const active =
                isActive(item.href) || item.children.some((c) => isActive(c.href));
              return (
                <>
                  <a
                    href={url(item.href)}
                    class={`flex items-center gap-3 px-5 py-2.5 text-sm transition-colors ${
                      active
                        ? "bg-white/10 text-white font-medium"
                        : "hover:bg-white/5"
                    }`}
                  >
                    <span>{item.icon}</span>
                    <span>{item.label}</span>
                  </a>
                  {item.children.map((child) => (
                    <a
                      href={url(child.href)}
                      class={`flex items-center gap-2 py-2 pl-12 pr-5 text-[13px] transition-colors ${
                        isActive(child.href)
                          ? "bg-white/10 text-white font-medium"
                          : "text-white/70 hover:bg-white/5"
                      }`}
                    >
                      <span class="text-white/40">└</span>
                      <span>{child.label}</span>
                    </a>
                  ))}
                </>
              );
            })
          }
        </nav>
        <div class="px-5 py-3 text-xs text-white/40 border-t border-white/10">
          Back-office · v0{!isOwner && " · vendeur"}
        </div>
      </aside>

      <div class="flex-1 min-w-0">
        <header
          class="h-14 bg-bo-surface border-b border-bo-border flex items-center justify-between px-6"
        >
          <h1 class="text-base font-semibold">{title}</h1>
          <div class="flex items-center gap-3 text-sm text-bo-muted">
            {Astro.locals.user && <span>{Astro.locals.user.email}</span>}
            <form method="POST" action={url("/logout")}>
              <button class="text-bo-accent hover:underline">Déconnexion</button>
            </form>
          </div>
        </header>
        {/* Pleine largeur : les écrans du back-office sont des tableaux et
            des grilles de vignettes, une colonne de texte les étranglait. */}
        <main class="p-6">
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>
