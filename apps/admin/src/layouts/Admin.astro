---
import "../styles/admin.css";
import { url, relPath } from "../lib/url.ts";
interface Props {
  title: string;
}
const { title } = Astro.props;
const path = relPath(Astro.url.pathname);

// Navigation type admin Shopify (vocabulaire familier à la cliente).
// `owner: true` = écran de configuration, masqué aux comptes « seller », qui
// vendent et impriment mais ne modifient ni le catalogue ni les réglages.
interface NavItem {
  href: string;
  label: string;
  icon: string;
  owner?: boolean;
  /** Sous-entrées, affichées en retrait sous le parent. */
  children?: NavItem[];
}

const nav: NavItem[] = [
  // Un vendeur ne voit que son stand : tout le reste porte « owner ». Le
  // tableau de bord lui-même mêle les ventes du site aux siennes, il n'y a
  // donc pas sa place.
  { href: "/", label: "Accueil", icon: "🏠", owner: true },
  { href: "/commandes", label: "Commandes en ligne", icon: "🛒", owner: true },
  { href: "/paniers", label: "Paniers abandonnés", icon: "🛍️", owner: true },
  { href: "/clients", label: "Clients", icon: "👥", owner: true },
  { href: "/ventes-salon", label: "Ventes stand", icon: "🎪" },
  {
    href: "/produits",
    label: "Produits",
    icon: "🖼️",
    owner: true,
    // L'import existait, terminé, sans qu'aucun lien n'y mène : il fallait
    // taper l'adresse pour le trouver.
    children: [
      { href: "/produits/import", label: "Importer un fichier", icon: "📥", owner: true },
    ],
  },
  { href: "/cadres", label: "Cadres", icon: "🖼", owner: true },
  { href: "/personnages", label: "Personnages", icon: "🧸", owner: true },
  { href: "/types-affiche", label: "Types d'affiche", icon: "🎭", owner: true },
  { href: "/ia", label: "Affiches IA", icon: "✨", owner: true },
  { href: "/collections", label: "Collections", icon: "📚", owner: true },
  { href: "/cartes-cadeaux", label: "Cartes cadeaux", icon: "🎁", owner: true },
  { href: "/categories-pieces", label: "Catégories de pièces", icon: "🎨", owner: true },
  { href: "/promotions", label: "Promotions", icon: "🎟️", owner: true },
  { href: "/livraison", label: "Livraison", icon: "📦", owner: true },
  { href: "/bandeau", label: "Bandeau du site", icon: "📢", owner: true },
  { href: "/contenu", label: "Contenu", icon: "✏️", owner: true },
  { href: "/pages", label: "Pages du site", icon: "📄", owner: true },
  { href: "/menu", label: "Menu du site", icon: "🧭", owner: true },
  { href: "/lettre", label: "Lettre d'information", icon: "✉️", owner: true },
  { href: "/courriers", label: "Courriers d'essai", icon: "📬", owner: true },
  { href: "/finances", label: "Finances", icon: "📊", owner: true },
  { href: "/comptes", label: "Comptes", icon: "🔑", owner: true },
];
const isOwner = Astro.locals.user?.role === "owner";

/**
 * Lien vers la boutique. Derrière le proxy, le site est à la racine et le
 * back-office sous /bo — d'où le chemin absolu, qui ne passe donc PAS par
 * url() : celui-ci préfixerait la base et renverrait sur le back-office.
 */
const lienBoutique = import.meta.env.PUBLIC_SITE_URL ?? "/";
const allowed = (item: NavItem) => isOwner || !item.owner;
const visibleNav = nav.filter(allowed).map((item) => ({
  ...item,
  children: item.children?.filter(allowed) ?? [],
}));

/** Une entrée est active sur sa page — l'accueil seulement à l'identique. */
const isActive = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(href + "/");
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · Memory Line Admin</title>
    {/* Le thème est posé AVANT le premier rendu : appliqué après, la page
        s'afficherait en clair une fraction de seconde avant de basculer. */}
    <script is:inline>
      (function () {
        var choix = null;
        try {
          choix = localStorage.getItem("bo-theme");
        } catch (e) {
          /* navigation privée : on retombe sur la préférence du système */
        }
        var sombre =
          choix === "sombre" ||
          (choix !== "clair" &&
            window.matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.dataset.theme = sombre ? "dark" : "light";
      })();
    </script>
  </head>
  <body class="min-h-screen">
    <div class="flex min-h-screen">
      <aside
        class="w-60 shrink-0 bg-bo-nav text-white/90 flex flex-col"
      >
        <div
          class="flex items-center justify-between gap-2 border-b border-white/10 px-5 py-4"
        >
          <span class="text-lg font-semibold">Memory&nbsp;Line</span>
          {/* Voir la boutique, comme dans Shopify : on ouvre dans un autre
              onglet pour ne pas perdre l'écran en cours de préparation. */}
          <a
            href={lienBoutique}
            target="_blank"
            rel="noopener"
            title="Voir la boutique"
            aria-label="Voir la boutique"
            class="text-white/45 transition-colors hover:text-white"
          >
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M14 4h6v6" />
              <path d="M20 4 10 14" />
              <path d="M19 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h5" />
            </svg>
          </a>
        </div>
        <nav class="flex-1 py-3">
          {
            visibleNav.map((item) => {
              // Le parent reste mis en avant quand on est sur une de ses
              // sous-pages, pour que la section courante reste lisible.
              const active =
                isActive(item.href) || item.children.some((c) => isActive(c.href));
              return (
                // Un bloc par entrée, sous-liens compris : sans lui, déplacer
                // « Produits » laisserait ses sous-pages derrière.
                <div data-entree={item.href} class="ml-entree">
                  <a
                    href={url(item.href)}
                    class={`flex items-center gap-3 px-5 py-2.5 text-sm transition-colors ${
                      active
                        ? "bg-white/10 text-white font-medium"
                        : "hover:bg-white/5"
                    }`}
                  >
                    <span>{item.icon}</span>
                    <span>{item.label}</span>
                  </a>
                  {item.children.map((child) => (
                    <a
                      href={url(child.href)}
                      class={`flex items-center gap-2 py-2 pl-12 pr-5 text-[13px] transition-colors ${
                        isActive(child.href)
                          ? "bg-white/10 text-white font-medium"
                          : "text-white/70 hover:bg-white/5"
                      }`}
                    >
                      <span class="text-white/40">└</span>
                      <span>{child.label}</span>
                    </a>
                  ))}
                </div>
              );
            })
          }
          {/* N'apparaît qu'une fois l'ordre changé : un bouton d'annulation
              visible en permanence laisserait croire qu'il y a quelque chose
              à défaire. */}
          <button
            type="button"
            id="ml-ordre-defaut"
            hidden
            class="mt-2 w-full px-5 py-2 text-left text-[11px] text-white/40 hover:text-white/70"
          >
            Remettre le menu dans l'ordre d'origine
          </button>
        </nav>
        <div class="px-5 py-3 text-xs text-white/40 border-t border-white/10">
          Back-office · v0{!isOwner && " · vendeur"}
        </div>
        <script is:inline>
          (function () {
            var menu = document.querySelector("aside nav");
            if (!menu) return;
            var CLE = "ml_ordre_menu";

            function entrees() {
              return Array.prototype.slice.call(
                menu.querySelectorAll("[data-entree]"),
              );
            }
            function ordreActuel() {
              return entrees().map(function (e) {
                return e.dataset.entree;
              });
            }
            function lire() {
              try {
                var brut = localStorage.getItem(CLE);
                var liste = brut ? JSON.parse(brut) : null;
                return Array.isArray(liste) ? liste : null;
              } catch (e) {
                return null;
              }
            }
            function ecrire(liste) {
              try {
                if (liste) localStorage.setItem(CLE, JSON.stringify(liste));
                else localStorage.removeItem(CLE);
              } catch (e) {
                /* sans stockage, l'ordre ne tient que le temps de la page */
              }
              var bouton = document.getElementById("ml-ordre-defaut");
              if (bouton) bouton.hidden = !liste;
            }

            // Les entrées connues d'abord, dans l'ordre retenu ; les autres
            // gardent leur place d'origine derrière. Un écran ajouté demain
            // apparaît donc, au lieu de disparaître faute d'être dans la liste.
            var retenu = lire();
            if (retenu) {
              var parCle = {};
              entrees().forEach(function (e) {
                parCle[e.dataset.entree] = e;
              });
              retenu.forEach(function (cle) {
                if (parCle[cle]) menu.appendChild(parCle[cle]);
                delete parCle[cle];
              });
              Object.keys(parCle).forEach(function (cle) {
                menu.appendChild(parCle[cle]);
              });
              var b = document.getElementById("ml-ordre-defaut");
              if (b) {
                b.hidden = false;
                menu.appendChild(b);
              }
            }

            // Le seuil est ce qui distingue un clic d'un déplacement : sans
            // lui, ouvrir un écran deviendrait impossible, chaque pression
            // étant lue comme le début d'un glissement.
            var SEUIL = 6;
            var tenue = null;
            var depart = 0;
            var glisse = false;

            menu.addEventListener("pointerdown", function (e) {
              if (e.button !== 0) return;
              var entree = e.target.closest("[data-entree]");
              if (!entree) return;
              tenue = entree;
              depart = e.clientY;
              glisse = false;

              function bouger(ev) {
                if (!tenue) return;
                if (!glisse) {
                  if (Math.abs(ev.clientY - depart) < SEUIL) return;
                  glisse = true;
                  tenue.style.opacity = "0.5";
                  document.body.style.userSelect = "none";
                }
                var sous = document.elementFromPoint(ev.clientX, ev.clientY);
                var cible =
                  sous && sous.closest ? sous.closest("[data-entree]") : null;
                if (!cible || cible === tenue || cible.parentElement !== menu)
                  return;
                var apres =
                  cible.compareDocumentPosition(tenue) &
                  Node.DOCUMENT_POSITION_PRECEDING;
                menu.insertBefore(tenue, apres ? cible.nextSibling : cible);
              }
              function lacher() {
                if (tenue) tenue.style.opacity = "";
                document.body.style.userSelect = "";
                window.removeEventListener("pointermove", bouger);
                window.removeEventListener("pointerup", lacher);
                window.removeEventListener("pointercancel", lacher);
                if (glisse) ecrire(ordreActuel());
                tenue = null;
                // Le drapeau survit jusqu'au clic qui suit le relâchement,
                // sinon le lien s'ouvrirait au bout du déplacement.
                setTimeout(function () {
                  glisse = false;
                }, 0);
              }
              window.addEventListener("pointermove", bouger);
              window.addEventListener("pointerup", lacher);
              window.addEventListener("pointercancel", lacher);
            });

            menu.addEventListener(
              "click",
              function (e) {
                if (glisse) {
                  e.preventDefault();
                  e.stopPropagation();
                }
              },
              true,
            );

            document
              .getElementById("ml-ordre-defaut")
              ?.addEventListener("click", function () {
                ecrire(null);
                window.location.reload();
              });

            ecrire(retenu);
          })();
        </script>
      </aside>

      <div class="flex-1 min-w-0">
        <header
          class="h-14 bg-bo-surface border-b border-bo-border flex items-center justify-between px-6"
        >
          <h1 class="text-base font-semibold">{title}</h1>
          <div class="flex items-center gap-3 text-sm text-bo-muted">
            {/* Clair / sombre / système. Le choix vit dans le navigateur :
                l'écran de la boutique et celui du salon n'ont pas la même
                lumière, il n'y a pas de bon réglage partagé. */}
            <details class="bo-menu relative">
              <summary
                class="rounded border border-bo-border px-2 py-1 hover:bg-bo-bg"
                title="Apparence"
              >
                <span data-theme-icone>◐</span>
              </summary>
              <div
                class="absolute right-0 z-30 mt-1 w-40 rounded-lg border border-bo-border bg-bo-surface py-1 shadow-lg"
              >
                <button
                  type="button"
                  data-theme-choix="clair"
                  class="block w-full px-3 py-1.5 text-left hover:bg-bo-bg"
                >
                  ☀️ Clair
                </button>
                <button
                  type="button"
                  data-theme-choix="sombre"
                  class="block w-full px-3 py-1.5 text-left hover:bg-bo-bg"
                >
                  🌙 Sombre
                </button>
                <button
                  type="button"
                  data-theme-choix="systeme"
                  class="block w-full px-3 py-1.5 text-left hover:bg-bo-bg"
                >
                  ◐ Comme le système
                </button>
              </div>
            </details>
            {Astro.locals.user && <span>{Astro.locals.user.email}</span>}
            <form method="POST" action={url("/logout")}>
              <button class="text-bo-accent hover:underline">Déconnexion</button>
            </form>
          </div>
        </header>
        {/* Pleine largeur : les écrans du back-office sont des tableaux et
            des grilles de vignettes, une colonne de texte les étranglait. */}
        <main class="p-6">
          <slot />
        </main>
      </div>
    </div>

    <script is:inline>
      // Bascule d'apparence. « Système » ne fige rien : la page suit ensuite
      // le réglage du poste, y compris s'il change en cours de journée.
      (function () {
        var media = window.matchMedia("(prefers-color-scheme: dark)");
        var icone = document.querySelector("[data-theme-icone]");
        var ICONES = { clair: "☀️", sombre: "🌙", systeme: "◐" };

        function lire() {
          try {
            return localStorage.getItem("bo-theme") || "systeme";
          } catch (e) {
            return "systeme";
          }
        }

        function appliquer(choix) {
          var sombre = choix === "sombre" || (choix === "systeme" && media.matches);
          document.documentElement.dataset.theme = sombre ? "dark" : "light";
          if (icone) icone.textContent = ICONES[choix] || ICONES.systeme;
        }

        document.querySelectorAll("[data-theme-choix]").forEach(function (b) {
          b.addEventListener("click", function () {
            var choix = b.dataset.themeChoix;
            try {
              if (choix === "systeme") localStorage.removeItem("bo-theme");
              else localStorage.setItem("bo-theme", choix);
            } catch (e) {
              /* sans stockage, le choix ne tiendra que le temps de la page */
            }
            appliquer(choix);
            b.closest("details")?.removeAttribute("open");
          });
        });

        media.addEventListener("change", function () {
          if (lire() === "systeme") appliquer("systeme");
        });

        appliquer(lire());
      })();
    </script>
  </body>
</html>
