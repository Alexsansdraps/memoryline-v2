---
/**
 * La liste des produits, et tout ce qu'on peut leur faire sans les ouvrir.
 *
 * Une boutique de deux cents affiches ne se tient pas fiche par fiche : passer
 * la moitié du catalogue en brouillon avant un salon, remonter tous les prix
 * de cinquante centimes, ranger vingt affiches dans une catégorie — chacune de
 * ces corrections demandait autrefois vingt allers-retours. D'où la sélection
 * multiple et la barre d'actions groupées, sur le modèle de Shopify.
 *
 * La liste ne passe plus par la route publique /products : celle-ci ne montre
 * que ce qui est en vente, et le back-office doit justement voir ce que la
 * boutique cache.
 */
import { url, apiUrl } from "../lib/url.ts";
import Admin from "../layouts/Admin.astro";
import { adminApi, formatPrice, type ListeProduitsAdmin } from "../lib/api.ts";

const api = adminApi(Astro.request);

let flash: string | null = null;
let flashErreur = false;

if (Astro.request.method === "POST") {
  const f = await Astro.request.formData();
  const ids = String(f.get("ids") ?? "")
    .split(",")
    .map((v) => Number(v))
    .filter((n) => Number.isFinite(n) && n > 0);
  const quoi = String(f.get("bulk") ?? "");
  try {
    if (!ids.length) throw new Error("Aucun produit sélectionné.");
    let params: Record<string, unknown> = {};
    let action = quoi;

    if (quoi === "statut-direct") {
      // La pastille d'une ligne : l'état voulu est calculé au rendu, pas
      // déduit ici. Deux onglets ouverts sur la même liste ne peuvent donc
      // pas se renvoyer l'un l'autre dans un état que personne n'a demandé.
      action = "statut";
      const voulu = String(f.get("statutVoulu") ?? "");
      if (voulu !== "active" && voulu !== "draft" && voulu !== "archived")
        throw new Error("Ce statut n'existe pas.");
      params = { valeur: voulu };
    } else if (quoi === "activer" || quoi === "desactiver" || quoi === "archiver") {
      action = "statut";
      params = {
        valeur:
          quoi === "activer"
            ? "active"
            : quoi === "desactiver"
              ? "draft"
              : "archived",
      };
    } else if (quoi === "categorie") {
      const brut = String(f.get("categoryId") ?? "");
      params = { categoryId: brut === "" ? null : Number(brut) };
    } else if (quoi === "poids") {
      const brut = String(f.get("poids") ?? "").trim();
      params = { weightGrams: brut === "" ? null : Number(brut) };
    } else if (quoi === "prix") {
      const mode = String(f.get("prixMode") ?? "fixe");
      const unite = String(f.get("prixUnite") ?? "euros");
      const format = String(f.get("prixFormat") ?? "tous");
      // La saisie est en euros, avec la virgule française ; l'API compte en
      // centimes. La conversion se fait ici, une fois, plutôt que dans chaque
      // appel.
      //
      // Une case VIDE est refusée ici. Elle était lue comme « 0 » : un clic
      // sur Appliquer sans rien écrire rendait gratuites toutes les affiches
      // cochées. Pour offrir un produit, il faut écrire 0.
      const saisie = String(f.get("prixValeur") ?? "").trim();
      if (!saisie)
        throw new Error(
          "Indiquez un montant (ou un pourcentage) avant d'appliquer. Pour offrir un produit, écrivez 0.",
        );
      const valeur = Number(saisie.replace(",", "."));
      if (!Number.isFinite(valeur) || valeur < 0)
        throw new Error("Le montant saisi n'est pas un nombre valable.");
      params =
        unite === "pourcent"
          ? { mode, format, pourcent: valeur }
          : { mode, format, montantCents: Math.round(valeur * 100) };
    } else if (quoi === "collection-ajouter" || quoi === "collection-retirer") {
      const brut = String(f.get("collectionId") ?? "");
      if (!brut) throw new Error("Choisissez une collection.");
      params = { collectionId: Number(brut) };
    } else if (quoi !== "supprimer") {
      // « supprimer » n'existe plus : retirer une affiche, c'est l'ARCHIVER,
      // et l'onglet « Archivées » la garde entière. Le bouton rouge a disparu
      // de cet écran, mais un onglet resté ouvert avant la bascule peut encore
      // l'envoyer : on laisse alors l'action descendre jusqu'à l'API, qui la
      // refuse en disant quoi faire à la place. « Action inconnue » laisserait
      // croire à une panne.
      throw new Error("Action inconnue.");
    }

    const r = await api.produitsEnMasse(ids, action, params);
    const refuses = r.refuses ?? [];
    if (quoi === "statut-direct" && !refuses.length) {
      // Un clic sur une pastille ne concerne qu'une affiche : « 1 produit
      // modifié » serait exact et ne dirait rien de ce qui a changé.
      const voulu = String(f.get("statutVoulu") ?? "");
      flash =
        voulu === "active"
          ? "Affiche remise en vente. Elle réapparaît sur le site."
          : "Affiche retirée de la vente. Elle ne s'affiche plus sur le site.";
      flashErreur = false;
    } else {
      flash =
        `${r.count} produit${r.count > 1 ? "s" : ""} modifié${r.count > 1 ? "s" : ""}.` +
        (refuses.length
          ? ` ${refuses.length} refusé${refuses.length > 1 ? "s" : ""} : ` +
            refuses.map((x) => `${x.name} (${x.raison})`).join(" ; ")
          : "");
      flashErreur = refuses.length > 0;
    }
  } catch (e) {
    flash = String(e instanceof Error ? e.message : e);
    flashErreur = true;
  }
}

// --- Filtres, lus dans l'adresse -----------------------------------------
const params = Astro.url.searchParams;
const statut = params.get("statut") ?? "tous";
const q = params.get("q") ?? "";
const categorieFiltre = Number(params.get("categorie") ?? "") || undefined;
const collectionFiltre = Number(params.get("collection") ?? "") || undefined;

let liste: ListeProduitsAdmin = {
  produits: [],
  categories: [],
  collections: [],
  formats: [],
  compte: { tous: 0, active: 0, draft: 0, archived: 0 },
};
let erreur: string | null = null;
try {
  liste = await api.produitsAdmin({
    statut,
    q,
    categorie: categorieFiltre,
    collection: collectionFiltre,
    limit: 1000,
  });
} catch (e) {
  erreur = String(e instanceof Error ? e.message : e);
}

const produits = liste.produits;

/** Le vocabulaire de la boutique, pas celui de la base. */
const ETIQUETTE_STATUT: Record<string, { texte: string; classe: string }> = {
  active: { texte: "Actif", classe: "bg-green-100 text-green-800" },
  draft: { texte: "Désactivé", classe: "bg-amber-100 text-amber-800" },
  archived: { texte: "Archivé", classe: "bg-bo-bg text-bo-muted" },
};

/**
 * Ce que devient le statut quand on clique dessus. Une affiche en vente se
 * retire ; tout le reste revient en vente, parce que c'est la seule chose
 * qu'on veuille faire d'une affiche retirée depuis cette liste.
 */
function statutApresClic(actuel: string): string {
  return actuel === "active" ? "draft" : "active";
}

/** Ce qu'on annonce avant le clic, pour que personne ne clique à l'aveugle. */
function infobulleStatut(actuel: string): string {
  return actuel === "active"
    ? "Cliquer pour retirer cette affiche de la vente"
    : "Cliquer pour remettre cette affiche en vente";
}

const ONGLETS = [
  { cle: "tous", texte: "Tous", nombre: liste.compte.tous },
  { cle: "active", texte: "Actifs", nombre: liste.compte.active },
  { cle: "draft", texte: "Désactivés", nombre: liste.compte.draft },
  { cle: "archived", texte: "Archivés", nombre: liste.compte.archived },
];

/** Garde les filtres en place quand on change d'onglet. */
function lienOnglet(cle: string): string {
  const p = new URLSearchParams();
  if (cle !== "tous") p.set("statut", cle);
  if (q) p.set("q", q);
  if (categorieFiltre) p.set("categorie", String(categorieFiltre));
  if (collectionFiltre) p.set("collection", String(collectionFiltre));
  const suite = p.toString();
  return url(`/produits${suite ? `?${suite}` : ""}`);
}

/**
 * L'adresse d'une image telle que le NAVIGATEUR doit la demander.
 *
 * Les visuels sont servis par l'API sous « /assets/… ». Écrit tel quel dans la
 * page du back-office, ce chemin part vers la boutique, qui ne connaît pas ces
 * fichiers : la vignette restait vide. Derrière le proxy, l'API vit sous
 * « /api », et c'est ce que `apiUrl` sait poser.
 */
function imageProduit(u: string | null): string {
  if (!u) return "";
  return u.startsWith("http") ? u : apiUrl(u);
}

const PAGE_SIZE = 25;

/**
 * La grille de modification groupée sur TOUTES les affiches du filtre, pas
 * seulement les vingt-cinq lignes cochables de la page en cours : elle
 * reprend les mêmes filtres (statut, recherche, catégorie, collection) plutôt
 * qu'une liste d'identifiants, qui ne tiendrait pas dans une adresse.
 */
const lienGrilleDuFiltre = (() => {
  const p = new URLSearchParams();
  if (statut !== "tous") p.set("statut", statut);
  if (q) p.set("q", q);
  if (categorieFiltre) p.set("categorie", String(categorieFiltre));
  if (collectionFiltre) p.set("collection", String(collectionFiltre));
  const suite = p.toString();
  return url(`/produits/modifier-en-masse${suite ? `?${suite}` : ""}`);
})();
---

<Admin title="Produits">
  {erreur && <p class="mb-3 text-sm text-red-600">API injoignable : {erreur}</p>}
  {
    flash && (
      <p
        class={`mb-3 rounded border px-3 py-2 text-sm ${
          flashErreur
            ? "border-red-300 bg-red-50 text-red-800"
            : "border-green-300 bg-green-50 text-green-800"
        }`}
      >
        {flash}
      </p>
    )
  }

  <!-- Recherche, filtres, création -->
  <form method="GET" class="mb-4 flex flex-wrap items-end gap-3">
    <label class="text-sm">
      <span class="mb-1 block text-xs text-bo-muted">Rechercher</span>
      <input
        type="search"
        name="q"
        value={q}
        placeholder="Nom ou identifiant…"
        class="w-64 max-w-full rounded border border-bo-border px-3 py-2 text-sm"
      />
    </label>
    <label class="text-sm">
      <span class="mb-1 block text-xs text-bo-muted">Catégorie</span>
      <select
        name="categorie"
        class="rounded border border-bo-border px-3 py-2 text-sm"
      >
        <option value="">Toutes</option>
        {
          liste.categories.map((c) => (
            <option value={c.id} selected={c.id === categorieFiltre}>
              {c.name}
            </option>
          ))
        }
      </select>
    </label>
    <label class="text-sm">
      <span class="mb-1 block text-xs text-bo-muted">Collection</span>
      <select
        name="collection"
        class="rounded border border-bo-border px-3 py-2 text-sm"
      >
        <option value="">Toutes</option>
        {
          liste.collections.map((c) => (
            <option value={c.id} selected={c.id === collectionFiltre}>
              {c.name}
            </option>
          ))
        }
      </select>
    </label>
    {statut !== "tous" && <input type="hidden" name="statut" value={statut} />}
    <button class="rounded border border-bo-border px-4 py-2 text-sm hover:bg-bo-bg">
      Filtrer
    </button>
    <a
      href="/api/admin/products/export.csv"
      class="ml-auto rounded border border-bo-border px-4 py-2 text-sm hover:bg-bo-bg"
      title="Tout le catalogue dans un fichier, une ligne par format. Il se rouvre dans un tableur, et il se reimporte tel quel."
    >
      Exporter le catalogue
    </a>
    <a
      href={url("/produits/nouveau")}
      class="rounded bg-bo-accent px-4 py-2 text-sm text-white"
    >
      <span class="mr-1">+</span> Nouvelle affiche
    </a>
  </form>

  <!-- Onglets par statut -->
  <nav class="mb-3 flex flex-wrap gap-1 border-b border-bo-border text-sm">
    {
      ONGLETS.map((o) => (
        <a
          href={lienOnglet(o.cle)}
          class={`-mb-px border-b-2 px-3 py-2 ${
            statut === o.cle
              ? "border-bo-accent font-medium text-bo-accent"
              : "border-transparent text-bo-muted hover:text-bo-nav"
          }`}
        >
          {o.texte} <span class="text-xs">({o.nombre})</span>
        </a>
      ))
    }
  </nav>

  {produits.length > 0 && (
    <p class="mb-3 text-sm">
      <a href={lienGrilleDuFiltre} class="font-medium text-bo-accent hover:underline">
        Modifier les {produits.length} affiche{produits.length > 1 ? "s" : ""} de ce filtre
      </a>
      <span class="text-bo-muted">
        {" "}— nom, identifiant, prix, collections, poids, catégorie,
        description, statut, type d'affiche : « Appliquer à tout », puis
        vérification avant d'enregistrer.
      </span>
    </p>
  )}

  <section
    class="overflow-hidden rounded-lg border border-bo-border bg-bo-surface"
  >
    {/* La barre d'actions n'apparaît qu'une fois des cases cochées. */}
    <form
      method="POST"
      id="pm-masse"
      class="hidden border-b border-bo-border bg-bo-bg px-4 py-3"
    >
      <input type="hidden" name="ids" id="pm-ids" />
      <input type="hidden" name="bulk" id="pm-bulk" />
      <div class="flex flex-wrap items-center gap-2 text-sm">
        <span id="pm-compte" class="font-medium"></span>
        <button
          type="button"
          data-bulk="activer"
          class="rounded border border-bo-border bg-bo-surface px-3 py-1.5 hover:bg-bo-bg"
        >
          Activer
        </button>
        <button
          type="button"
          data-bulk="desactiver"
          class="rounded border border-bo-border bg-bo-surface px-3 py-1.5 hover:bg-bo-bg"
        >
          Désactiver
        </button>
        <button
          type="button"
          data-bulk="archiver"
          data-confirme="Archiver les affiches sélectionnées ? Elles quittent la boutique et cette liste. Rien n'est supprimé : leurs photos, leurs fonds, leurs prix et leur rangement en collections sont gardés entiers, et les commandes déjà passées dessus restent imprimables. Vous les retrouverez dans l'onglet « Archivés », et aussi dans l'écran « Archives », d'où elles se remettent en vente."
          class="rounded border border-bo-border bg-bo-surface px-3 py-1.5 hover:bg-bo-bg"
        >
          Archiver
        </button>
        <button
          type="button"
          id="pm-grille"
          class="rounded bg-bo-nav px-3 py-1.5 text-white"
        >
          Modifier en masse
        </button>
        {/* Le bouton rouge « Supprimer » a été RETIRÉ : une affiche ne
            s'efface pas, elle s'archive — c'est ce que fait « Archiver »
            juste au-dessus, et elle se retrouve dans l'onglet « Archivées »,
            d'où elle se remet en vente. Supprimer emportait aussi ses photos,
            ses fonds de configurateur et son rangement en collections. */}
      </div>

      <div
        class="mt-3 flex flex-wrap items-end gap-x-6 gap-y-3 border-t border-bo-border pt-3 text-sm"
      >
        <div class="flex items-end gap-2">
          <label>
            <span class="mb-1 block text-xs text-bo-muted">Catégorie</span>
            <select
              name="categoryId"
              class="rounded border border-bo-border px-2 py-1.5"
            >
              <option value="">Aucune</option>
              {liste.categories.map((c) => <option value={c.id}>{c.name}</option>)}
            </select>
          </label>
          <button
            type="button"
            data-bulk="categorie"
            class="rounded border border-bo-border bg-bo-surface px-3 py-1.5 hover:bg-bo-bg"
          >
            Ranger
          </button>
        </div>

        <div class="flex items-end gap-2">
          <label>
            <span class="mb-1 block text-xs text-bo-muted">Prix de base</span>
            <select
              name="prixMode"
              class="rounded border border-bo-border px-2 py-1.5"
            >
              <option value="fixe">Fixer à</option>
              <option value="augmenter">Augmenter de</option>
              <option value="diminuer">Diminuer de</option>
            </select>
          </label>
          <input
            name="prixValeur"
            type="text"
            inputmode="decimal"
            placeholder="0,00"
            class="w-24 rounded border border-bo-border px-2 py-1.5"
          />
          <select
            name="prixUnite"
            class="rounded border border-bo-border px-2 py-1.5"
          >
            <option value="euros">€</option>
            <option value="pourcent">%</option>
          </select>
          <select
            name="prixFormat"
            class="rounded border border-bo-border px-2 py-1.5"
            aria-label="Formats concernés"
          >
            <option value="tous">tous les formats</option>
            {liste.formats.map((fmt) => <option value={fmt}>{fmt}</option>)}
          </select>
          <button
            type="button"
            data-bulk="prix"
            class="rounded border border-bo-border bg-bo-surface px-3 py-1.5 hover:bg-bo-bg"
          >
            Appliquer
          </button>
        </div>

        <div class="flex items-end gap-2">
          <label>
            <span class="mb-1 block text-xs text-bo-muted">Poids (g)</span>
            <input
              name="poids"
              type="number"
              min="0"
              placeholder="vide = catégorie"
              class="w-36 rounded border border-bo-border px-2 py-1.5"
            />
          </label>
          <button
            type="button"
            data-bulk="poids"
            class="rounded border border-bo-border bg-bo-surface px-3 py-1.5 hover:bg-bo-bg"
          >
            Appliquer
          </button>
        </div>

        <div class="flex items-end gap-2">
          <label>
            <span class="mb-1 block text-xs text-bo-muted">Collection</span>
            <select
              name="collectionId"
              class="rounded border border-bo-border px-2 py-1.5"
            >
              <option value="">Choisir…</option>
              {liste.collections.map((c) => <option value={c.id}>{c.name}</option>)}
            </select>
          </label>
          <button
            type="button"
            data-bulk="collection-ajouter"
            class="rounded border border-bo-border bg-bo-surface px-3 py-1.5 hover:bg-bo-bg"
          >
            Ajouter
          </button>
          <button
            type="button"
            data-bulk="collection-retirer"
            class="rounded border border-bo-border bg-bo-surface px-3 py-1.5 hover:bg-bo-bg"
          >
            Retirer
          </button>
        </div>
      </div>
    </form>

    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="bg-bo-bg text-left text-bo-muted">
          <tr>
            <th class="w-8 px-3 py-2">
              <input type="checkbox" id="pm-tout" aria-label="Tout cocher" />
            </th>
            <th class="px-4 py-2 font-medium">Produit</th>
            <th class="px-4 py-2 font-medium">Statut</th>
            <th class="px-4 py-2 font-medium">Catégorie</th>
            <th class="px-4 py-2 font-medium">Collections</th>
            <th class="px-4 py-2 font-medium text-right">Poids</th>
            <th class="px-4 py-2 font-medium text-right">Prix</th>
            <th class="px-4 py-2"></th>
          </tr>
        </thead>
        <tbody id="pm-tbody">
          {
            produits.map((p) => {
              const badge = ETIQUETTE_STATUT[p.status] ?? {
                texte: p.status,
                classe: "bg-bo-bg text-bo-muted",
              };
              return (
                <tr class="pm-row border-t border-bo-border">
                  <td class="px-3 py-2 align-middle">
                    <input type="checkbox" class="pm-coche" value={p.id} />
                  </td>
                  <td class="px-4 py-2">
                    <div class="flex items-center gap-3">
                      {p.imageUrl ? (
                        <img
                          src={imageProduit(p.imageUrl)}
                          alt=""
                          loading="lazy"
                          class="h-10 w-8 rounded border border-bo-border object-cover"
                        />
                      ) : (
                        <span class="block h-10 w-8 rounded border border-bo-border bg-bo-bg" />
                      )}
                      <span>
                        <a
                          href={url(`/produits/${p.id}`)}
                          class="font-medium text-bo-accent hover:underline"
                        >
                          {p.name}
                        </a>
                        <span class="block text-xs text-bo-muted">
                          {p.variantes} format(s)
                          {p.aiEnabled ? " · affiche IA" : ""}
                        </span>
                      </span>
                    </div>
                  </td>
                  <td class="px-4 py-2">
                    <form method="POST" class="inline">
                      <input type="hidden" name="ids" value={p.id} />
                      <input type="hidden" name="bulk" value="statut-direct" />
                      <input
                        type="hidden"
                        name="statutVoulu"
                        value={statutApresClic(p.status)}
                      />
                      <button
                        type="submit"
                        title={infobulleStatut(p.status)}
                        class={`cursor-pointer rounded-full px-2 py-0.5 text-xs hover:ring-2 hover:ring-bo-accent/40 ${badge.classe}`}
                      >
                        {badge.texte}
                      </button>
                    </form>
                  </td>
                  <td class="px-4 py-2 text-bo-muted">
                    {p.categoryName ?? "—"}
                  </td>
                  <td class="px-4 py-2 text-bo-muted">
                    {p.collections.length
                      ? p.collections.map((c) => c.name).join(", ")
                      : "—"}
                  </td>
                  <td class="px-4 py-2 text-right text-bo-muted">
                    {p.poidsEffectif} g
                    {p.weightGrams === null && (
                      <span class="block text-xs">de la catégorie</span>
                    )}
                  </td>
                  <td class="px-4 py-2 text-right whitespace-nowrap">
                    {p.prixMin === null ? (
                      <span title="Aucun format : c'est le prix de repli du produit.">
                        {formatPrice(p.basePriceCents)}
                        <span class="block text-xs text-bo-muted">sans format</span>
                      </span>
                    ) : p.prixMin === p.prixMax ? (
                      formatPrice(p.prixMin)
                    ) : (
                      <span>
                        {formatPrice(p.prixMin)}
                        <span class="text-bo-muted"> à </span>
                        {formatPrice(p.prixMax ?? p.prixMin)}
                      </span>
                    )}
                  </td>
                  <td class="px-4 py-2 text-right whitespace-nowrap">
                    <a
                      href={url(`/produits/${p.id}`)}
                      class="text-bo-accent hover:underline"
                    >
                      Configurer
                    </a>
                  </td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>
    <p
      id="pm-vide"
      class="hidden px-4 py-6 text-center text-sm text-bo-muted"
    >
      Aucun produit ne correspond.
    </p>
  </section>

  <!-- Pagination -->
  <nav
    class="pm-pager mt-3 flex items-center justify-between gap-2 text-sm"
    data-pager
  >
    <button
      class="pm-prev rounded border border-bo-border px-3 py-1.5 disabled:opacity-40"
    >
      ← Précédent
    </button>
    <span class="pm-pageinfo text-bo-muted"></span>
    <button
      class="pm-next rounded border border-bo-border px-3 py-1.5 disabled:opacity-40"
    >
      Suivant →
    </button>
  </nav>

  <script
    is:inline
    define:vars={{ PAGE_SIZE, lienGrille: url("/produits/modifier-en-masse") }}
  >
    const lignes = Array.from(document.querySelectorAll(".pm-row"));
    const vide = document.getElementById("pm-vide");
    const barre = document.getElementById("pm-masse");
    const compte = document.getElementById("pm-compte");
    const tout = document.getElementById("pm-tout");
    let page = 0;

    const cases = () => Array.from(document.querySelectorAll(".pm-coche"));
    const selection = () =>
      cases()
        .filter((c) => c.checked)
        .map((c) => c.value);

    function rafraichirSelection() {
      const n = selection().length;
      barre.classList.toggle("hidden", n === 0);
      compte.textContent = `${n} produit${n > 1 ? "s" : ""} sélectionné${n > 1 ? "s" : ""}`;
      // « Tout cocher » ne parle que des lignes visibles : cocher une case
      // cachée par la pagination serait une action invisible.
      const visibles = cases().filter((c) => c.closest("tr").style.display !== "none");
      if (tout)
        tout.checked = visibles.length > 0 && visibles.every((c) => c.checked);
    }

    function afficher() {
      const total = lignes.length;
      const pages = Math.max(1, Math.ceil(total / PAGE_SIZE));
      if (page > pages - 1) page = pages - 1;
      if (page < 0) page = 0;
      const debut = page * PAGE_SIZE;
      const fin = debut + PAGE_SIZE;

      lignes.forEach((l) => (l.style.display = "none"));
      lignes.slice(debut, fin).forEach((l) => (l.style.display = ""));
      if (vide) vide.classList.toggle("hidden", total !== 0);

      document.querySelectorAll("[data-pager]").forEach((pager) => {
        const info = pager.querySelector(".pm-pageinfo");
        const prec = pager.querySelector(".pm-prev");
        const suiv = pager.querySelector(".pm-next");
        if (info)
          info.textContent =
            total === 0
              ? "—"
              : `Page ${page + 1} / ${pages} · ${debut + 1}–${Math.min(fin, total)} sur ${total}`;
        if (prec) prec.disabled = page === 0;
        if (suiv) suiv.disabled = page >= pages - 1;
      });
      rafraichirSelection();
    }

    tout?.addEventListener("change", () => {
      cases()
        .filter((c) => c.closest("tr").style.display !== "none")
        .forEach((c) => (c.checked = tout.checked));
      rafraichirSelection();
    });
    cases().forEach((c) => c.addEventListener("change", rafraichirSelection));

    document.querySelectorAll(".pm-prev").forEach((b) =>
      b.addEventListener("click", () => {
        page--;
        afficher();
      }),
    );
    document.querySelectorAll(".pm-next").forEach((b) =>
      b.addEventListener("click", () => {
        page++;
        afficher();
      }),
    );

    document.querySelectorAll("[data-bulk]").forEach((b) => {
      b.addEventListener("click", () => {
        const ids = selection();
        if (!ids.length) return;
        const avertissement = b.dataset.confirme;
        if (avertissement && !confirm(avertissement)) return;
        document.getElementById("pm-ids").value = ids.join(",");
        document.getElementById("pm-bulk").value = b.dataset.bulk;
        barre.submit();
      });
    });

    document.getElementById("pm-grille")?.addEventListener("click", () => {
      const ids = selection();
      if (!ids.length) return;
      window.location.href = `${lienGrille}?ids=${ids.join(",")}`;
    });

    afficher();
  </script>
</Admin>
