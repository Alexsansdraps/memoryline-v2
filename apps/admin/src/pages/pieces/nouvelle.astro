---
/**
 * Créer une pièce. L'écran vivait sous /personnages/piece ; il a déménagé
 * avec la bibliothèque des pièces (octobre 2026), dont il est la porte
 * « + Nouvelle pièce ». L'ancienne adresse redirige ici.
 */
import { url } from "../../lib/url.ts";
import Admin from "../../layouts/Admin.astro";
import ApercusZones from "../../components/ApercusZones.astro";
import GroupesCouleurs from "../../components/GroupesCouleurs.astro";
import { adminApi, type CategoriePiece, type TypeAffiche } from "../../lib/api.ts";
import type { NuancierBase } from "@memoryline/types";

const PUBLIC_API_URL =
  import.meta.env.PUBLIC_API_URL ?? "http://localhost:3000";

const api = adminApi(Astro.request);

/** Emplacements, dans l'ordre d'affichage (mêmes valeurs qu'en base). */
const SLOTS = [
  { value: "clothes", label: "Vêtements" },
  { value: "pants", label: "Pantalons" },
  { value: "hair", label: "Coupes" },
  { value: "accessory", label: "Accessoires" },
];

let erreur: string | null = null;

if (Astro.request.method === "POST") {
  const f = await Astro.request.formData();
  try {
    const zones = JSON.parse(String(f.get("colorZones") || "{}"));
    const groupes = JSON.parse(String(f.get("groupesCouleurs") || "[]"));
    // Familles de teintes, quand le dessin téléversé est une image en pixels.
    const brutFamilles = String(f.get("couleursImage") || "");
    const familles = brutFamilles ? JSON.parse(brutFamilles) : null;
    const piece = await api.upsertAsset({
      slot: String(f.get("slot") || "clothes"),
      name: (f.get("name") as string) || undefined,
      svgUrl: String(f.get("svgUrl") || ""),
      view: String(f.get("view") || "front"),
      colorZones: Object.keys(zones).length ? zones : undefined,
      // Plus de cases « Le client peut la changer » : le client change
      // toutes les couleurs d'une pièce. Une pièce neuve n'a donc aucun
      // réglage de ce genre.
      zonesMasquees: null,
      groupesCouleurs: Array.isArray(groupes) ? groupes : null,
      couleursImage: familles,
      position: Number(f.get("position") || 0),
      // La catégorie décide des couleurs proposées au client : choisie dès la
      // création, la pièce arrive dans le configurateur avec le bon nuancier,
      // au lieu de celui, générique, de son emplacement.
      pieceCategoryId: f.get("pieceCategoryId") ? Number(f.get("pieceCategoryId")) : null,
    });
    // Retour sur la bibliothèque, à la ligne de la pièce créée : c'est là
    // que le message se lit, et que la pièce se voit.
    return Astro.redirect(url(`/pieces?creee=${piece.id}#piece-${piece.id}`), 303);
  } catch (e) {
    erreur = "Erreur : " + String(e);
  }
}

let vues: TypeAffiche[] = [];
let categories: CategoriePiece[] = [];
try {
  [vues, categories] = await Promise.all([
    api.views(),
    // Sans les catégories, la pièce se crée quand même — sans nuancier, comme
    // avant que le choix existe ici.
    api.pieceCategories().catch(() => [] as CategoriePiece[]),
  ]);
} catch (e) {
  if (!erreur) erreur = String(e);
}
/** Les catégories qu'on peut encore choisir : pas les archivées. */
const categoriesChoisissables = categories.filter((c) => !c.archivedAt);
/**
 * Les pastilles d'une partie sans liste, dans une catégorie sans couleurs :
 * le nuancier des personnages de son emplacement, comme le module.
 * Illisibles, le panneau prend ceux d'origine.
 */
const replisPersonnages: Partial<Record<NuancierBase, string[]>> = await api
  .nuanciersBase()
  .then((n) => n.nuanciers)
  .catch(() => ({}));
/**
 * Les types d'affiche ouverts : un type archivé (« Mariés (essai) ») n'est
 * plus proposé au client, une pièce dessinée pour lui ne servirait à
 * personne — et l'écran Pièces ne le montre déjà plus dans ses filtres.
 */
const vuesChoisissables = vues.filter((v) => !v.archivedAt);
---

<Admin title="Nouvelle pièce">
  <p class="mb-4">
    <a href={url("/pieces")} class="text-bo-accent hover:underline text-sm">
      ← Retour aux pièces
    </a>
  </p>

  {erreur && (
    <p class="mb-4 text-sm rounded bg-red-50 border border-red-200 px-3 py-2">
      {erreur}
    </p>
  )}

  <p class="mb-6 text-sm text-bo-muted max-w-3xl">
    Une brique de la garde-robe : un vêtement, un pantalon, une coupe ou un
    accessoire. Elle rejoint la bibliothèque du type d'affiche choisi, et
    devient cochable sur les personnages dessinés sous le même angle.
  </p>

  <form method="POST" class="space-y-6 max-w-3xl">
    <section class="bg-bo-surface border border-bo-border rounded-lg p-5">
      <div class="grid sm:grid-cols-2 gap-4 text-sm">
        <label class="block">
          <span class="text-bo-muted">Emplacement</span>
          <select
            name="slot"
            class="mt-1 w-full border border-bo-border rounded px-3 py-2"
          >
            {SLOTS.map((s) => <option value={s.value}>{s.label}</option>)}
          </select>
        </label>
        <label class="block">
          <span class="text-bo-muted">Type d'affiche</span>
          <select
            name="view"
            class="mt-1 w-full border border-bo-border rounded px-3 py-2"
          >
            {vuesChoisissables.map((v) => <option value={v.slug}>{v.name}</option>)}
          </select>
        </label>
        <label class="block">
          <span class="text-bo-muted">Nom</span>
          <input
            name="name"
            placeholder="T-shirt rayé"
            class="mt-1 w-full border border-bo-border rounded px-3 py-2"
          />
        </label>
        <label class="block">
          <span class="text-bo-muted">Ordre d'affichage</span>
          <input
            name="position"
            type="number"
            value="0"
            class="mt-1 w-full border border-bo-border rounded px-3 py-2"
          />
        </label>
        {/* Seules les catégories de l'emplacement choisi sont proposées (le
            script plus bas cache les autres) : une catégorie « Pantalons »
            n'a pas de sens pour une coupe de cheveux. */}
        <label class="block sm:col-span-2">
          <span class="text-bo-muted">Catégorie (ses couleurs proposées au client)</span>
          <select
            id="piece-categorie"
            name="pieceCategoryId"
            class="mt-1 w-full border border-bo-border rounded px-3 py-2"
          >
            <option value="">Sans catégorie — nuancier de l'emplacement (choix libre, sauf accessoire)</option>
            {categoriesChoisissables.map((c) => (
              <option
                value={String(c.id)}
                data-slot={c.slot}
                data-nom={c.name}
                data-nuancier={JSON.stringify(c.colors ?? [])}
                data-active={
                  // Une catégorie décochée n'arrive pas au configurateur :
                  // ses pièces y proposent le nuancier de leur emplacement.
                  c.active === false ? "" : "1"
                }
              >
                {c.name}
              </option>
            ))}
          </select>
          <span class="mt-1 block text-xs text-bo-muted">
            La palette de la catégorie est celle que le client verra pour
            chaque partie de la pièce. Chaque partie peut aussi avoir sa
            propre liste, jusqu'à 10 couleurs (sous « Couleurs du dessin »,
            plus bas). Les palettes se règlent dans
            <a href={url("/categories-pieces")} class="underline">Catégories de pièces</a>.
            La catégorie se change ensuite dans Pièces, sous « Couleurs » de la pièce.
          </span>
        </label>
      </div>
    </section>

    <section class="bg-bo-surface border border-bo-border rounded-lg p-5">
      <h3 class="font-semibold mb-4">Dessin</h3>
      <div class="flex flex-wrap items-start gap-4 text-sm">
        <img
          id="piece-apercu"
          alt=""
          class="h-32 w-20 object-contain border border-bo-border rounded bg-white"
          style="visibility:hidden"
        />
        <div class="flex-1 min-w-[280px]">
          <span class="text-bo-muted">SVG de la pièce *</span>
          <div class="mt-1 flex items-center gap-2">
            <input
              id="piece-url"
              name="svgUrl"
              required
              placeholder="/assets/tshirt.svg"
              class="flex-1 border border-bo-border rounded px-3 py-2 font-mono text-xs"
            />
            <button
              type="button"
              id="piece-televerser"
              class="rounded border border-bo-border px-3 py-2 text-xs whitespace-nowrap"
            >
              Téléverser…
            </button>
          </div>
          <p id="piece-analyse" class="mt-1 text-xs text-bo-muted">
            Même cadre que les personnages (500 × 1000) : la pièce se superpose
            au dessin, elle n'est pas redimensionnée.
          </p>
        </div>
      </div>

      <div class="mt-4 text-sm" id="piece-couleurs">
        <span class="text-bo-muted block mb-1">
          Couleurs du dessin
        </span>
        <p class="text-xs text-bo-muted mb-2">
          Une ligne par partie de la pièce (les manches, le col, la
          visière…), ses ombres en retrait dessous ; la vignette montre où
          elle se trouve. Le client choisira la couleur de chaque partie :
          donnez-lui le nom qu'il lira. Cochez « C'est une ombre » sur une
          couleur qui n'est que l'ombre ou le reflet d'une partie : elle
          suivra sa couleur.
        </p>
        <GroupesCouleurs
          mode="piece"
          apiUrl={PUBLIC_API_URL}
          svgUrl={null}
          zones={{}}
          groupes={[]}
          champs={{
            zones: "colorZones",
            groupes: "groupesCouleurs",
            masquees: "zonesMasquees",
            familles: "couleursImage",
          }}
          emplacement={{ slot: "clothes", replis: replisPersonnages }}
          rappel="La pièce s'enregistrera avec « Créer la pièce », en bas de page."
        />
      </div>
    </section>

    <div class="flex items-center gap-3">
      <button class="rounded bg-bo-accent text-white px-5 py-2.5">
        Créer la pièce
      </button>
      <a
        href={url("/pieces")}
        class="text-sm text-bo-muted hover:underline"
      >
        Annuler
      </a>
    </div>
  </form>

  <script is:inline define:vars={{ PUBLIC_API_URL }}>
    const champ = document.getElementById("piece-url");
    const apercu = document.getElementById("piece-apercu");
    const bouton = document.getElementById("piece-televerser");
    const couleurs = document.querySelector("#piece-couleurs .js-groupes");

    /** Adresse absolue du dessin saisi, ou "" s'il n'y en a pas. */
    function adresseDuDessin() {
      const v = (champ.value || "").trim();
      if (!v) return "";
      return v.startsWith("http") ? v : PUBLIC_API_URL + v;
    }

    function montrer() {
      const src = adresseDuDessin();
      apercu.style.visibility = src ? "visible" : "hidden";
      if (src) apercu.src = src;
    }

    /**
     * Lit les couleurs du nouveau dessin. Celles d'un autre dessin ne
     * voudraient rien dire sur celui-ci : elles sont remplacées. Un dessin qui
     * écrivait ses couleurs forme par forme (Canva, IA) revient sous une
     * nouvelle adresse, sa version préparée ; l'original reste intact.
     */
    function relire() {
      const v = (champ.value || "").trim();
      montrer();
      if (!v) return;
      couleurs?.dispatchEvent(
        new CustomEvent("groupes:detecter", { detail: { url: v } }),
      );
    }

    couleurs?.addEventListener("groupes:change", (e) => {
      const url = e.detail && e.detail.svgUrl;
      if (url && url !== champ.value.trim()) {
        champ.value = url;
        montrer();
      }
    });

    bouton.addEventListener("click", () => {
      const input = document.createElement("input");
      input.type = "file";
      input.accept = ".svg,.png,.jpg,.jpeg,.webp";
      input.addEventListener("change", async () => {
        const file = input.files && input.files[0];
        if (!file) return;
        const avant = bouton.textContent;
        bouton.textContent = "Envoi…";
        bouton.disabled = true;
        try {
          const fd = new FormData();
          fd.append("file", file);
          const res = await fetch(`${PUBLIC_API_URL}/admin/uploads`, {
            method: "POST",
            body: fd,
            credentials: "include",
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data.error || res.status);
          champ.value = data.url;
          relire();
        } catch (e) {
          alert("Téléversement impossible : " + e);
        } finally {
          bouton.textContent = avant;
          bouton.disabled = false;
        }
      });
      input.click();
    });

    champ.addEventListener("change", relire);

    // La catégorie suit l'emplacement : seules les siennes restent visibles,
    // et la première d'entre elles est choisie d'office — toute la
    // bibliothèque est rangée dans la catégorie de son emplacement, une pièce
    // « Sans catégorie » y faisait exception sans qu'on l'ait voulu. Un choix
    // fait à la main (« Sans catégorie » compris) est respecté tant qu'il
    // reste valable pour l'emplacement.
    const emplacement = document.querySelector('select[name="slot"]');
    const categorie = document.getElementById("piece-categorie");
    let choisieALaMain = false;
    categorie?.addEventListener("change", () => (choisieALaMain = true));
    function filtrerCategories() {
      if (!emplacement || !categorie) return;
      const slot = emplacement.value;
      let premiere = null;
      for (const option of categorie.options) {
        const sienne = !option.dataset.slot || option.dataset.slot === slot;
        option.hidden = !sienne;
        option.disabled = !sienne;
        if (!sienne && option.selected) {
          categorie.value = "";
          choisieALaMain = false;
        }
        if (sienne && option.dataset.slot && !premiere) premiere = option;
      }
      if (!choisieALaMain && premiere) categorie.value = premiere.value;
    }
    emplacement?.addEventListener("change", filtrerCategories);
    filtrerCategories();

    // Les « Couleurs proposées au client » de chaque partie montrent celles
    // de la catégorie choisie, tant que la partie n'a pas sa propre liste.
    function annoncerRegle() {
      const choix = categorie && categorie.selectedOptions[0];
      let nuancier = [];
      try {
        nuancier = JSON.parse((choix && choix.dataset.nuancier) || "[]");
      } catch {
        /* illisible : la partie retombe sur le nuancier de repli */
      }
      const regle =
        choix && choix.dataset.active
          ? { categorie: choix.dataset.nom || "", nuancier }
          : null;
      // L'emplacement d'abord : un accessoire n'a jamais de couleur libre, et
      // une partie sans catégorie à couleurs propose le nuancier des
      // personnages de son emplacement.
      couleurs?.dispatchEvent(
        new CustomEvent("groupes:emplacement", {
          detail: { slot: emplacement ? emplacement.value : "clothes" },
        }),
      );
      couleurs?.dispatchEvent(new CustomEvent("groupes:regle", { detail: regle }));
    }
    categorie?.addEventListener("change", annoncerRegle);
    emplacement?.addEventListener("change", annoncerRegle);
    // Et une fois au chargement, comme le filtre ci-dessus : un retour en
    // arrière du navigateur rend la catégorie choisie sans redéclencher
    // « change », et les couleurs proposées seraient celles d'une autre.
    // Au DOMContentLoaded : le bloc des couleurs se monte par un script de
    // module, qui passe après celui-ci — annoncé plus tôt, personne
    // n'écoutait encore.
    document.addEventListener("DOMContentLoaded", annoncerRegle);
  </script>

  {/* Après le formulaire : les vignettes des couleurs passent par lui. */}
  <ApercusZones />
</Admin>
