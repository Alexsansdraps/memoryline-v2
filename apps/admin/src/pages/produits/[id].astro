      {trad && (
        <section class="bg-bo-surface border border-bo-border rounded-lg p-5">
          <h3 class="font-semibold mb-1">Traductions</h3>
          <p class="mb-4 text-sm text-bo-muted">
            Laissez un champ vide et c'est le français qui s'affichera. Vous
            pouvez donc ne traduire que le nom, ou traduire plus tard.
          </p>

          <div class="space-y-3">
            {LANGUES_TRADUISIBLES.map((l) => {
              const t = trad!.translations?.[l.code] ?? {};
              const etat = etatLangue(l.code);
              return (
                <details class="rounded border border-bo-border">
                  <summary class="cursor-pointer select-none px-4 py-2.5 text-sm font-medium flex items-center gap-2">
                    <span>{l.nom}</span>
                    <span class={`rounded-full px-2 py-0.5 text-xs font-normal ${etat.classe}`}>
                      {etat.texte}
                    </span>
                  </summary>

                  <form method="POST" class="border-t border-bo-border p-4 space-y-3">
                    <input type="hidden" name="_action" value="traduction" />
                    <input type="hidden" name="lang" value={l.code} />

                    <label class="block">
                      <span class="text-xs text-bo-muted">Nom</span>
                      <input
                        name="name"
                        value={t.name ?? ""}
                        placeholder={trad!.fr.name}
                        class="mt-1 w-full border border-bo-border rounded px-3 py-2 text-sm"
                      />
                      <span class="mt-1 block text-xs text-bo-muted">
                        Français : {trad!.fr.name}
                      </span>
                    </label>

                    {/* Un éditeur par langue, chacun avec ses propres
                        identifiants : voir EditeurTexte.astro. Le champ caché
                        qu'il pose s'appelle toujours « description », le POST
                        plus haut n'a donc rien à savoir de tout ceci. */}
                    <div>
                      <span class="text-xs text-bo-muted">Description</span>
                      <EditeurTexte
                        nom="description"
                        valeur={t.description ?? ""}
                        invite={texteBrut(trad!.fr.description)}
                        etiquette={`Description en ${l.nom.toLowerCase()}`}
                      />
                      <details class="mt-1">
                        <summary class="cursor-pointer text-xs text-bo-muted">
                          Voir la description française
                        </summary>
                        <div
                          class="mt-1 max-h-40 overflow-y-auto rounded bg-bo-bg p-2 text-xs text-bo-muted whitespace-pre-wrap"
                        >{texteBrut(trad!.fr.description) ||
                            "Cette affiche n'a pas encore de description française."}</div>
                      </details>
                    </div>

                    <button class="rounded bg-bo-accent text-white px-4 py-2 text-sm hover:opacity-90">
                      Enregistrer {l.nom.toLowerCase()}
                    </button>
                  </form>
                </details>
              );
            })}
          </div>
        </section>
      )}

      <section class="bg-bo-surface border border-bo-border rounded-lg p-5">
        <h3 class="font-semibold mb-1">Expédition</h3>
        <p class="mb-4 text-sm text-bo-muted max-w-3xl">
          Le poids décide de la tranche d'affranchissement proposée au client.
          Un champ laissé <strong>vide</strong> hérite de l'échelon du dessus :
          le format prend le poids du produit, le produit celui de sa
          catégorie. Ne remplissez donc que ce qui sort de l'ordinaire — le
          poids indiqué en regard est celui qui sera réellement pesé.
        </p>

        {erreurLogistique && (
          <p class="text-sm text-red-600">
            Poids indisponibles : {erreurLogistique}
          </p>
        )}

        {logistique && (
          <form method="POST" class="space-y-4">
            <input type="hidden" name="_action" value="expedition" />

            <div class="flex flex-wrap items-end gap-4">
              <label class="block">
                <span class="text-bo-muted text-sm">Catégorie</span>
                <select
                  name="categoryId"
                  class="mt-1 block w-56 border border-bo-border rounded px-3 py-2 text-sm"
                >
                  <option value="" selected={!logistique.produit.categoryId}>
                    — Sans catégorie —
                  </option>
                  {logistique.categories.map((c) => (
                    <option
                      value={c.id}
                      selected={logistique!.produit.categoryId === c.id}
                    >
                      {c.name}
                      {c.defaultWeightGrams > 0
                        ? ` — ${formaterPoids(c.defaultWeightGrams)}`
                        : " — sans poids"}
                    </option>
                  ))}
                </select>
                <span class="mt-1 block text-xs text-bo-muted">
                  Les catégories se créent dans
                  <a class="underline" href={url("/categories-produits")}>
                    {" "}Catégories de produits</a
                  >.
                </span>
              </label>

              <label class="block">
                <span class="text-bo-muted text-sm">Poids du produit (g)</span>
                <input
                  name="weightGrams"
                  type="number"
                  min="0"
                  step="1"
                  value={logistique.produit.weightGrams ?? ""}
                  placeholder={String(
                    logistique.categorie?.defaultWeightGrams ?? 0,
                  )}
                  class="mt-1 block w-32 border border-bo-border rounded px-3 py-2 text-sm"
                />
                <span class="mt-1 block text-xs text-bo-muted">
                  {logistique.categorie
                    ? `Vide = ${formaterPoids(logistique.categorie.defaultWeightGrams)}, de la catégorie ${logistique.categorie.name}`
                    : "Sans catégorie, un champ vide vaut 0 g"}
                </span>
              </label>
            </div>

            <div class="border border-bo-border rounded overflow-hidden">
              <table class="w-full text-sm">
                <thead class="bg-bo-bg text-left text-bo-muted">
                  <tr>
                    <th class="px-4 py-2 font-medium">Format</th>
                    <th class="px-4 py-2 font-medium w-40">Poids (g)</th>
                    <th class="px-4 py-2 font-medium">Ce qui sera pesé</th>
                  </tr>
                </thead>
                <tbody>
                  {logistique.variantes.map((v) => (
                    <tr class="border-t border-bo-border">
                      <td class="px-4 py-2">
                        {v.format}
                        {v.sku && (
                          <span class="text-bo-muted"> · {v.sku}</span>
                        )}
                        <input type="hidden" name="varianteId" value={v.id} />
                      </td>
                      <td class="px-4 py-2">
                        <input
                          name="variantePoids"
                          type="number"
                          min="0"
                          step="1"
                          value={v.weightGrams ?? ""}
                          placeholder={String(poidsHerite)}
                          class="block w-28 border border-bo-border rounded px-2 py-1"
                        />
                      </td>
                      <td class="px-4 py-2 text-bo-muted">
                        {v.poidsEffectif > 0 ? (
                          <>
                            {formaterPoids(v.poidsEffectif)}
                            {v.weightGrams === null && " (hérité)"}
                          </>
                        ) : (
                          <span class="text-amber-800">
                            0 g — poids inconnu, l'affranchissement sera faux
                          </span>
                        )}
                      </td>
                    </tr>
                  ))}
                  {logistique.variantes.length === 0 && (
                    <tr>
                      <td class="px-4 py-4 text-bo-muted" colspan="3">
                        Ce produit n'a aucun format.
                      </td>
                    </tr>
                  )}
                </tbody>
              </table>
            </div>

            <p class="text-xs text-bo-muted">
              Le cadre, quand il est vendu avec l'affiche, ajoute son propre
              poids par-dessus — il se règle dans
              <a class="underline" href={url("/cadres")}> Cadres</a>.
            </p>

            <button class="rounded bg-bo-accent text-white px-4 py-2 text-sm hover:opacity-90">
              Enregistrer l'expédition
            </button>
          </form>
        )}
      </section>

      <section class="rounded-lg border border-bo-border bg-bo-surface p-5">
        <h3 class="mb-1 font-semibold">Génération par IA</h3>
        <p class="mb-4 max-w-3xl text-sm text-bo-muted">
          Le client envoie une photo et voit aussitôt son affiche, dessinée par
          le modèle. Elle porte le filigrane jusqu'au paiement. La dépense et
          les réglages communs (style de la boutique, modèle, plafond) sont
          dans <a class="underline" href={url("/ia")}>Affiches IA</a>.
        </p>

        {!iaSure && (
          <p class="rounded border border-amber-300 bg-amber-50 px-3 py-2 text-sm text-amber-900">
            Ces réglages n'ont pas pu être relus. Ils ne sont donc pas
            modifiables ici pour le moment : le formulaire s'afficherait à vide
            et l'enregistrer effacerait les consignes de style déjà écrites.
            Rechargez la page. Si le message revient, dites-le moi.
          </p>
        )}

        {iaSure && (
        <form method="POST" class="space-y-4">
          <input type="hidden" name="_action" value="ia" />

          <label class="flex items-center gap-2 text-sm">
            <input type="checkbox" name="aiEnabled" checked={reglagesIa.aiEnabled} />
            <span>Cette affiche est générée par IA à partir d'une photo</span>
          </label>

          <label class="block">
            <span class="text-sm text-bo-muted">
              Consignes de style propres à cette affiche
            </span>
            <textarea
              name="aiStylePrompt"
              rows="4"
              class="mt-1 w-full rounded border border-bo-border px-3 py-2 text-sm"
              placeholder="Affiche de mariage : couple en tenue de cérémonie, bouquet de pivoines, arche florale, fond crème."
            >{reglagesIa.aiStylePrompt}</textarea>
            <span class="mt-1 block text-xs text-bo-muted">
              Elles s'ajoutent au style commun de la boutique, qui donne déjà la
              technique et les couleurs. N'écrivez ici que ce qui distingue
              cette affiche des autres — par exemple, pour une affiche
              d'anniversaire : « chapeaux de fête, guirlandes, gâteau à bougies,
              confettis en suspension ». Laissez vide et seul le style commun
              s'applique.
            </span>
          </label>

          <button class="rounded bg-bo-accent px-4 py-2 text-sm text-white hover:opacity-90">
            Enregistrer la génération par IA
          </button>
        </form>
