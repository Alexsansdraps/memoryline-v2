            </p>
          </section>

          {/* Textes pré-remplis */}
          {/* Les champs gardent les noms des colonnes (defaultTitle,
              defaultSubtitle) : ce sont les lignes 1 et 2, remplies par 161
              affiches. */}
          <section class="bg-bo-surface border border-bo-border rounded-lg p-5">
            <h3 class="font-semibold mb-3">Textes pré-remplis</h3>
            <div class="grid sm:grid-cols-3 gap-4">
              <label class="block">
                <span class="text-bo-muted text-sm">Ligne 1</span>
                <input
                  name="defaultTitle"
                  type="text"
                  value={config.defaultTitle ?? ""}
                  class="mt-1 w-full border border-bo-border rounded px-3 py-2 text-sm"
                />
              </label>
              <label class="block">
                <span class="text-bo-muted text-sm">Ligne 2</span>
                <input
                  name="defaultSubtitle"
                  type="text"
                  value={config.defaultSubtitle ?? ""}
                  class="mt-1 w-full border border-bo-border rounded px-3 py-2 text-sm"
                />
              </label>
              <label class="block">
                <span class="text-bo-muted text-sm">Ligne 3</span>
                <input
                  name="defaultLine3"
                  type="text"
                  value={config.defaultLine3 ?? ""}
                  class="mt-1 w-full border border-bo-border rounded px-3 py-2 text-sm"
                />
              </label>
            </div>
            <p class="text-xs text-bo-muted mt-2">
              Les trois lignes déjà écrites sur l'affiche quand le client ouvre
