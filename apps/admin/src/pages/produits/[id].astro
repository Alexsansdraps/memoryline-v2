        {ventes ? (
          <>
            <dl class="space-y-2 text-sm">
              <div class="flex items-baseline justify-between gap-3">
                <dt class="text-bo-muted">Affiches vendues</dt>
                <dd class="font-medium">{ventes.unites}</dd>
              </div>
              <div class="flex items-baseline justify-between gap-3">
                <dt class="text-bo-muted">Acheteurs</dt>
                <dd class="font-medium">{ventes.acheteurs}</dd>
              </div>
              <div class="flex items-baseline justify-between gap-3">
                <dt class="text-bo-muted">Ventes nettes</dt>
                <dd class="font-medium">
