              <span class="text-sm font-medium">Titre de la page</span>
              <input
                id="champ-seo-titre"
                name="seoTitle"
                value={produit.seoTitle ?? ""}
                placeholder={titreParDefaut}
                class={champ}
              />
              <span
                id="compte-seo-titre"
                class="mt-1 block text-xs text-bo-muted"></span>
            </label>

            <label class="block">
              <span class="text-sm font-medium">Description pour les moteurs</span>
              <textarea
