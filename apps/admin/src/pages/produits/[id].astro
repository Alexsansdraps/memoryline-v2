                {STATUTS.map((s) => (
                  <option
                    value={s.valeur}
                    selected={produit.status === s.valeur}
                    data-explication={s.explication}
                  >
                    {s.nom}
                  </option>
                ))}
              </select>
            </label>
            {/* Ce que le statut change vraiment, dit sous le champ : « draft »
