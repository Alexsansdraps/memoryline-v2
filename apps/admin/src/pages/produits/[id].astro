            <p id="explication-statut" class="text-xs text-bo-muted">
              {statutActuel.explication}
            </p>
            <button class={boutonPrincipal}>Enregistrer le statut</button>
          </form>
        </section>
      )}

      {/* Ventes */}
      <section class="rounded-lg border border-bo-border bg-bo-surface p-5">
