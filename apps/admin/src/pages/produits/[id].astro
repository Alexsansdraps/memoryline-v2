      {produit && (
        <section class="rounded-lg border border-bo-border bg-bo-surface p-5">
          <h3 class="mb-3 font-semibold">Statut</h3>
          <form method="POST" class="space-y-3">
            <input type="hidden" name="_action" value="statut" />
            <label class="block">
              <select
                id="champ-statut"
                name="status"
