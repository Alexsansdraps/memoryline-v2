---
import { url } from "../../lib/url.ts";
import Admin from "../../layouts/Admin.astro";
import {
  adminApi,
  type ProductConfig,
  type TypeAffiche,
} from "../../lib/api.ts";

const api = adminApi(Astro.request);
const { id } = Astro.params;

// URL publique de l'API, joignable depuis le navigateur (fetch client) et pour
// résoudre les chemins d'images "/assets/...".
const PUBLIC_API_URL =
  import.meta.env.PUBLIC_API_URL ?? "http://localhost:3000";

// Helper : URL absolue d'une image. Les URLs externes (https://cdn.shopify…)
// s'affichent telles quelles ; les chemins "/assets/..." sont préfixés.
function imgSrc(url: string | null | undefined): string {
  if (!url) return "";
  return url.startsWith("http") ? url : `${PUBLIC_API_URL}${url}`;
}

// --- Enregistrement des défauts (SSR) ----------------------------------
// Le bouton « Appliquer » (titre / sous-titre / position / décor) passe par un
// POST classique, même pattern robuste que promotions / personnages. Les
// actions par visuel (ajout / suppression) se font côté client.
const LANGUES_TRADUISIBLES = [
  { code: "en", nom: "Anglais" },
  { code: "de", nom: "Allemand" },
  { code: "it", nom: "Italien" },
  { code: "es", nom: "Espagnol" },
] as const;

let flash: string | null = null;
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  try {
    if (form.get("_action") === "traduction") {
      const lang = String(form.get("lang") || "");
      await api.setProductTranslation(id!, {
        lang,
        name: String(form.get("name") ?? ""),
        description: String(form.get("description") ?? ""),
      });
      const nom = LANGUES_TRADUISIBLES.find((l) => l.code === lang)?.nom ?? lang;
      flash = `Traduction « ${nom} » enregistrée.`;
    } else {
    await api.setProductConfig(id!, {
      defaultTitle: (form.get("defaultTitle") as string) ?? "",
      defaultSubtitle: (form.get("defaultSubtitle") as string) ?? "",
      // Slug du type d'affiche, pris tel quel : les types se créent au
      // back-office, la liste n'est plus figée ici.
      defaultView: String(form.get("defaultView") || "") || null,
      foregroundUrl: (form.get("foregroundUrl") as string)?.trim() || null,
    });
    flash = "Configuration enregistrée.";
    }
  } catch (e) {
    flash = "Erreur : " + String(e);
  }
}

// Traductions saisies + français de référence (affiché en regard des champs).
let trad: Awaited<ReturnType<typeof api.productTranslations>> | null = null;
try {
  trad = await api.productTranslations(id!);
} catch {
  // Section masquée si l'API ne répond pas : le reste de la page fonctionne.
}

/** « à traduire » / « partiel » / « traduit » — l'état visible d'un coup d'œil. */
function etatLangue(code: string) {
  const t = trad?.translations?.[code];
  const nom = !!t?.name?.trim();
  const desc = !!t?.description?.trim();
  if (nom && desc) return { texte: "traduit", classe: "bg-green-100 text-green-800" };
  if (nom || desc) return { texte: "partiel", classe: "bg-amber-100 text-amber-800" };
  return { texte: "à traduire", classe: "bg-bo-bg text-bo-muted" };
}

let config: ProductConfig | null = null;
let error: string | null = null;
try {
  config = await api.productConfig(id!);
} catch (e) {
  error = String(e);
}

// Types d'affiche proposés au produit (« de face », « de dos », …).
let vues: TypeAffiche[] = [];
try {
  vues = await api.views();
} catch (e) {
  if (!error) error = String(e);
}

const backgrounds = config?.backgrounds ?? [];
---

<Admin title={config?.name ?? "Produit"}>
  <p class="mb-4">
    <a href={url("/produits")} class="text-bo-accent hover:underline text-sm"
      >← Retour aux produits</a
    >
  </p>

  {flash && <p class="mb-4 text-sm rounded bg-green-50 border border-green-200 px-3 py-2">{flash}</p>}
  {error && <p class="mb-4 text-red-600 text-sm">API injoignable : {error}</p>}

  {config && (
    <>
      <header class="mb-6">
        <h2 class="text-xl font-semibold">{config.name}</h2>
        <p class="text-sm text-bo-muted">
          /{config.slug} · Configuration du configurateur
        </p>
      </header>

      {/* =============================================================== */}
      {/* 1 — Visuels disponibles                                         */}
      {/* =============================================================== */}
      <section class="mb-6 bg-bo-surface border border-bo-border rounded-lg p-5">
        <h3 class="font-semibold mb-1">Visuels disponibles</h3>
        <p class="text-sm text-bo-muted mb-4">
          Les arrière-plans proposés au client pour ce produit.
        </p>
        <div id="bg-grid" class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          {backgrounds.map((bg) => (
            <figure
              class="relative border border-bo-border rounded overflow-hidden bg-white group"
              data-bg-id={bg.id}
            >
              <img
                src={imgSrc(bg.url)}
                alt={bg.name ?? ""}
                class="w-full aspect-square object-cover"
                loading="lazy"
              />
              <button
                type="button"
                class="js-del-bg absolute top-1 right-1 h-6 w-6 rounded-full bg-white/90 border border-bo-border text-sm leading-none text-bo-muted hover:text-red-600 hover:border-red-300 shadow"
                title="Supprimer ce visuel"
                aria-label="Supprimer ce visuel"
              >
                ✕
              </button>
              {bg.name && (
                <figcaption class="px-2 py-1 text-xs text-bo-muted truncate">
                  {bg.name}
                </figcaption>
              )}
            </figure>
          ))}
        </div>
        <p
          id="bg-empty"
          class={`text-sm text-bo-muted ${backgrounds.length ? "hidden" : ""}`}
        >
          Aucun visuel pour le moment.
        </p>
      </section>

      {/* =============================================================== */}
      {/* 2 — Ajouter un visuel                                           */}
      {/* =============================================================== */}
      <section class="mb-6 bg-bo-surface border border-bo-border rounded-lg p-5">
        <h3 class="font-semibold mb-1">Ajouter un visuel</h3>
        <p class="mb-3 text-sm text-bo-muted">
          Chaque visuel ajouté ici devient un choix de fond proposé au client
          dans le configurateur de ce produit.
        </p>

        <div class="mb-4 rounded border border-dashed border-bo-border p-4">
          <label class="block text-sm font-medium mb-2" for="new-bg-file">
            Depuis mon ordinateur
          </label>
          <div class="flex flex-wrap items-center gap-3">
            <input
              id="new-bg-file"
              type="file"
              accept=".svg,.png,.jpg,.jpeg,.webp"
              multiple
              class="text-sm"
            />
            <span id="upload-status" class="text-xs"></span>
          </div>
          <p class="mt-2 text-xs text-bo-muted">
            SVG, PNG, JPG ou WebP, 25 Mo maximum par fichier. Plusieurs fichiers
            peuvent être choisis d'un coup.
          </p>
        </div>

        <label class="block text-sm font-medium mb-2" for="new-bg-url">
          Ou depuis une adresse web
        </label>
        <div class="flex flex-wrap items-end gap-3">
          <input
            id="new-bg-url"
            type="text"
            class="flex-1 min-w-[16rem] border border-bo-border rounded px-3 py-2 text-sm font-mono"
            placeholder="https://cdn.shopify.com/..."
          />
          <button
            type="button"
            id="add-bg-btn"
            class="rounded bg-bo-accent text-white px-4 py-2 text-sm hover:opacity-90"
          >
            Ajouter
          </button>
          <span id="add-bg-status" class="text-xs"></span>
        </div>
      </section>

      {/* =============================================================== */}
      {/* 2 bis — Traductions humaines                                    */}
      {/* =============================================================== */}
      {trad && (
        <section class="mb-6 bg-bo-surface border border-bo-border rounded-lg p-5">
          <h3 class="font-semibold mb-1">Traductions</h3>
          <p class="mb-4 text-sm text-bo-muted">
            Laissez un champ vide et c'est le français qui s'affichera. Vous
            pouvez donc ne traduire que le nom, ou traduire plus tard.
          </p>

          <div class="space-y-3">
            {LANGUES_TRADUISIBLES.map((l) => {
              const t = trad!.translations?.[l.code] ?? {};
              const etat = etatLangue(l.code);
              return (
                <details class="rounded border border-bo-border">
                  <summary class="cursor-pointer select-none px-4 py-2.5 text-sm font-medium flex items-center gap-2">
                    <span>{l.nom}</span>
                    <span class={`rounded-full px-2 py-0.5 text-xs font-normal ${etat.classe}`}>
                      {etat.texte}
                    </span>
                  </summary>

                  <form method="POST" class="border-t border-bo-border p-4 space-y-3">
                    <input type="hidden" name="_action" value="traduction" />
                    <input type="hidden" name="lang" value={l.code} />

                    <label class="block">
                      <span class="text-xs text-bo-muted">Nom</span>
                      <input
                        name="name"
                        value={t.name ?? ""}
                        placeholder={trad!.fr.name}
                        class="mt-1 w-full border border-bo-border rounded px-3 py-2 text-sm"
                      />
                      <span class="mt-1 block text-xs text-bo-muted">
                        Français : {trad!.fr.name}
                      </span>
                    </label>

                    <label class="block">
                      <span class="text-xs text-bo-muted">Description</span>
                      <textarea
                        name="description"
                        rows="5"
                        placeholder={trad!.fr.description ?? ""}
                        class="mt-1 w-full border border-bo-border rounded px-3 py-2 text-sm font-mono"
                      >{t.description ?? ""}</textarea>
                      <details class="mt-1">
                        <summary class="cursor-pointer text-xs text-bo-muted">
                          Voir la description française
                        </summary>
                        <div class="mt-1 max-h-40 overflow-y-auto rounded bg-bo-bg p-2 text-xs text-bo-muted whitespace-pre-wrap">
                          {trad!.fr.description ?? "—"}
                        </div>
                      </details>
                    </label>

                    <button class="rounded bg-bo-accent text-white px-4 py-2 text-sm hover:opacity-90">
                      Enregistrer {l.nom.toLowerCase()}
                    </button>
                  </form>
                </details>
              );
            })}
          </div>
        </section>
      )}

      {/* =============================================================== */}
      {/* 3 à 6 — Défauts (form SSR « Appliquer »)                        */}
      {/* =============================================================== */}
      <form method="POST" class="space-y-6">
        {/* 3 — Position des personnages */}
        <section class="bg-bo-surface border border-bo-border rounded-lg p-5">
          <h3 class="font-semibold mb-3">Type d'affiche</h3>
          <label class="block max-w-xs">
            <select
              name="defaultView"
              class="mt-1 w-full border border-bo-border rounded px-3 py-2 text-sm"
            >
              {vues.map((v) => (
                <option
                  value={v.slug}
                  selected={(config.defaultView ?? vues[0]?.slug) === v.slug}
                >
                  {v.name}
                </option>
              ))}
            </select>
          </label>
          <p class="mt-2 text-xs text-bo-muted">
            Détermine les personnages proposés au client et le décor posé au
            premier plan. Les types se créent dans
            <a class="underline" href="../types-affiche"> Types d'affiche</a>.
          </p>
        </section>

        {/* 4 — Décor d'avant-plan */}
        <section class="bg-bo-surface border border-bo-border rounded-lg p-5">
          <h3 class="font-semibold mb-3">Décor d'avant-plan (optionnel)</h3>
          <div class="flex flex-wrap items-end gap-3">
            <label class="flex-1 min-w-[16rem] block">
              <span class="text-bo-muted text-sm">URL du décor</span>
              <input
                id="fg-url"
                name="foregroundUrl"
                type="text"
                value={config.foregroundUrl ?? ""}
                class="mt-1 w-full border border-bo-border rounded px-3 py-2 text-sm font-mono"
                placeholder="/assets/...svg"
              />
            </label>
            <img
              id="fg-preview"
              src={imgSrc(config.foregroundUrl)}
              alt=""
              class="h-16 w-16 object-contain border border-bo-border rounded bg-white shrink-0"
              style={config.foregroundUrl ? "" : "visibility:hidden"}
            />
          </div>
          <p class="text-xs text-bo-muted mt-2">
            Affiché au 1er plan, uniquement quand les personnages sont de dos
            (assis).
          </p>
        </section>

        {/* 5 — Texte par défaut */}
        <section class="bg-bo-surface border border-bo-border rounded-lg p-5">
          <h3 class="font-semibold mb-3">Texte par défaut</h3>
          <div class="grid sm:grid-cols-2 gap-4">
            <label class="block">
              <span class="text-bo-muted text-sm">Titre</span>
              <input
                name="defaultTitle"
                type="text"
                value={config.defaultTitle ?? ""}
                class="mt-1 w-full border border-bo-border rounded px-3 py-2 text-sm"
              />
            </label>
            <label class="block">
              <span class="text-bo-muted text-sm">Sous-titre</span>
              <input
                name="defaultSubtitle"
                type="text"
                value={config.defaultSubtitle ?? ""}
                class="mt-1 w-full border border-bo-border rounded px-3 py-2 text-sm"
              />
            </label>
          </div>
        </section>

        {/* 6 — Appliquer */}
        <div>
          <button class="rounded bg-bo-accent text-white px-5 py-2.5 hover:opacity-90">
            Appliquer
          </button>
        </div>
      </form>
    </>
  )}

  <script is:inline define:vars={{ PUBLIC_API_URL, productId: id }}>
    const abs = (u) =>
      u && u.startsWith("http") ? u : `${PUBLIC_API_URL}${u}`;

    // --- Aperçu live du décor d'avant-plan ---
    const fgUrl = document.getElementById("fg-url");
    const fgPreview = document.getElementById("fg-preview");
    fgUrl?.addEventListener("input", () => {
      const v = fgUrl.value.trim();
      if (v) {
        fgPreview.src = abs(v);
        fgPreview.style.visibility = "visible";
      } else {
        fgPreview.removeAttribute("src");
        fgPreview.style.visibility = "hidden";
      }
    });

    // --- Ajout d'un visuel (POST /admin/products/:id/backgrounds) ---
    const addInput = document.getElementById("new-bg-url");
    const addBtn = document.getElementById("add-bg-btn");
    const addStatus = document.getElementById("add-bg-status");
    const grid = document.getElementById("bg-grid");
    const empty = document.getElementById("bg-empty");

    function bindDelete(btn) {
      btn.addEventListener("click", async () => {
        const fig = btn.closest("[data-bg-id]");
        if (!fig) return;
        if (!confirm("Supprimer ce visuel ?")) return;
        const bgId = fig.getAttribute("data-bg-id");
        try {
          const res = await fetch(`${PUBLIC_API_URL}/admin/backgrounds/${bgId}`, {
            method: "DELETE",
            credentials: "include",
          });
          if (!res.ok) throw new Error("HTTP " + res.status);
          fig.remove();
          if (empty && !grid.querySelector("[data-bg-id]"))
            empty.classList.remove("hidden");
        } catch (e) {
          alert("Suppression impossible : " + e);
        }
      });
    }

    document.querySelectorAll(".js-del-bg").forEach(bindDelete);

    // --- Téléversement d'un ou plusieurs visuels ---
    // Deux temps : on dépose le fichier (POST /admin/uploads), puis on
    // rattache l'URL obtenue au produit, exactement comme un ajout par URL.
    const fileInput = document.getElementById("new-bg-file");
    const uploadStatus = document.getElementById("upload-status");

    async function rattacher(url) {
      const res = await fetch(
        `${PUBLIC_API_URL}/admin/products/${productId}/backgrounds`,
        {
          method: "POST",
          credentials: "include",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ url }),
        },
      );
      if (!res.ok) throw new Error("HTTP " + res.status);
      return res.json();
    }

    fileInput?.addEventListener("change", async () => {
      const fichiers = Array.from(fileInput.files || []);
      if (!fichiers.length) return;
      let faits = 0;
      for (const f of fichiers) {
        uploadStatus.className = "text-xs text-bo-muted";
        uploadStatus.textContent = `Envoi de ${f.name} (${faits + 1}/${fichiers.length})…`;
        try {
          const fd = new FormData();
          fd.append("file", f);
          const res = await fetch(`${PUBLIC_API_URL}/admin/uploads`, {
            method: "POST",
            credentials: "include",
            body: fd,
          });
          const data = await res.json().catch(() => ({}));
          if (!res.ok) throw new Error(data.error || "HTTP " + res.status);
          await rattacher(data.url);
          faits++;
        } catch (e) {
          uploadStatus.className = "text-xs text-red-600";
          uploadStatus.textContent = `${f.name} : ${e}`;
          return;
        }
      }
      uploadStatus.className = "text-xs text-green-700";
      uploadStatus.textContent = `${faits} visuel(s) ajouté(s).`;
      // Rechargement : la grille est rendue côté serveur, plus fiable que de
      // la reconstruire à la main pour plusieurs fichiers.
      location.reload();
    });

    addBtn?.addEventListener("click", async () => {
      const url = (addInput.value || "").trim();
      if (!url) {
        addInput.focus();
        return;
      }
      if (addStatus) {
        addStatus.textContent = "…";
        addStatus.className = "text-xs text-bo-muted";
      }
      try {
        const res = await fetch(
          `${PUBLIC_API_URL}/admin/products/${productId}/backgrounds`,
          {
            method: "POST",
            credentials: "include",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ url }),
          },
        );
        if (!res.ok) throw new Error("HTTP " + res.status);
        const bg = await res.json();

        // Insère la nouvelle vignette sans recharger la page.
        const fig = document.createElement("figure");
        fig.className =
          "relative border border-bo-border rounded overflow-hidden bg-white group";
        fig.setAttribute("data-bg-id", bg.id);
        fig.innerHTML =
          `<img src="${abs(bg.url)}" alt="${bg.name ?? ""}" class="w-full aspect-square object-cover" loading="lazy" />` +
          `<button type="button" class="js-del-bg absolute top-1 right-1 h-6 w-6 rounded-full bg-white/90 border border-bo-border text-sm leading-none text-bo-muted hover:text-red-600 hover:border-red-300 shadow" title="Supprimer ce visuel" aria-label="Supprimer ce visuel">✕</button>` +
          (bg.name
            ? `<figcaption class="px-2 py-1 text-xs text-bo-muted truncate">${bg.name}</figcaption>`
            : "");
        grid.appendChild(fig);
        bindDelete(fig.querySelector(".js-del-bg"));
        empty?.classList.add("hidden");

        addInput.value = "";
        if (addStatus) {
          addStatus.textContent = "Ajouté ✓";
          addStatus.className = "text-xs text-green-700";
        }
      } catch (e) {
        if (addStatus) {
          addStatus.textContent = "Erreur";
          addStatus.className = "text-xs text-red-600";
        }
      }
    });
  </script>
</Admin>
