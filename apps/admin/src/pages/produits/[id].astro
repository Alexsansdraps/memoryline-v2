      {/* Organisation */}
      {produit && fiche && (
        <section class="rounded-lg border border-bo-border bg-bo-surface p-5">
          <h3 class="mb-3 font-semibold">Organisation</h3>
          <form method="POST" class="space-y-4">
            <input type="hidden" name="_action" value="organisation" />
            <input type="hidden" name="etiquettesPresentes" value="1" />
            <input type="hidden" name="collectionsPresentes" value="1" />

