            </p>
          </section>

          <div>
            <button class="rounded bg-bo-accent text-white px-5 py-2.5 hover:opacity-90">
              Appliquer
            </button>
          </div>
        </form>
      )}

      {/* ------------------------------------------------------------- */}
      {/* 5 — Référencement                                             */}
      {/* ------------------------------------------------------------- */}
      {produit && (
        <section class="rounded-lg border border-bo-border bg-bo-surface p-5">
