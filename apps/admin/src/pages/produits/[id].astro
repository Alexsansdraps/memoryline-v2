                  <span
                    class="js-etiquette inline-flex items-center gap-1 rounded-full bg-bo-bg px-2 py-0.5 text-xs"
                    data-etiquette={t}
                  >
                    <input type="hidden" name="tags" value={t} />
                    {t}
                    <button
                      type="button"
                      class="js-retirer-etiquette text-bo-muted hover:text-red-600"
                      aria-label={`Retirer l'étiquette ${t}`}
                    >
                      ✕
                    </button>
                  </span>
                ))}
              </div>
              <p
                id="etiquettes-vide"
                class={`mt-1 text-xs text-bo-muted ${etiquettes.length ? "hidden" : ""}`}
              >
                Aucune étiquette.
              </p>

              <div class="mt-2 flex flex-wrap items-center gap-2">
                <input
                  id="nouvelle-etiquette"
                  list="etiquettes-connues"
                  placeholder="Noël, mariage, enfants..."
                  class="flex-1 rounded border border-bo-border bg-bo-surface px-3 py-2 text-sm"
                  aria-label="Nouvelle étiquette"
                />
                <button
                  type="button"
                  id="ajouter-etiquette"
                  class={boutonDiscret}
                >
                  Ajouter
                </button>
              </div>
              <datalist id="etiquettes-connues">
                {(fiche.etiquettesConnues ?? []).map((t) => (
                  <option value={t}></option>
                ))}
              </datalist>

              {suggestions.length > 0 && (
                <div class="mt-2">
                  <p class="text-xs text-bo-muted">Déjà utilisées ailleurs :</p>
                  <div class="mt-1 flex flex-wrap gap-1.5">
                    {suggestions.slice(0, 20).map((t) => (
                      <button
                        type="button"
                        class="js-suggestion rounded-full border border-bo-border px-2 py-0.5 text-xs text-bo-muted hover:text-bo-ink"
                        data-etiquette={t}
                      >
                        + {t}
                      </button>
                    ))}
                  </div>
                </div>
              )}
            </div>

            <button class={boutonPrincipal}>Enregistrer l'organisation</button>
          </form>
        </section>
      )}
    </aside>
  </div>

  {/* ================================================================= */}
  {/* Le détail des ventes, en modale                                   */}
  {/* ================================================================= */}
  {ventes && (
    <dialog
      id="modale-ventes"
      aria-labelledby="titre-modale-ventes"
      class="w-[min(48rem,92vw)] rounded-lg border border-bo-border bg-bo-surface p-0 text-bo-ink backdrop:bg-bo-nav/60"
    >
      <div class="flex items-start justify-between gap-4 border-b border-bo-border px-5 py-4">
        <div>
          <h3 id="titre-modale-ventes" class="font-semibold">
            Ventes des {ventes.jours} derniers jours
          </h3>
          <p class="text-xs text-bo-muted">
            Du {jourLong(ventes.debut)} au {jourLong(ventes.fin)}, remboursements
            déduits.
          </p>
        </div>
        <button
          type="button"
          id="fermer-ventes"
          class="h-8 w-8 rounded-full border border-bo-border text-bo-muted hover:text-bo-ink"
          aria-label="Fermer"
        >
          ✕
        </button>
      </div>

      <div class="max-h-[75vh] space-y-6 overflow-y-auto px-5 py-5">
        {/* La courbe des ventes nettes */}
        <div>
          <div class="flex items-baseline justify-between gap-3">
            <h4 class="text-sm font-medium">Ventes nettes dans le temps</h4>
            <span class="text-xs text-bo-muted">
              {formatPrice(ventes.ventesNettesCents)} au total
            </span>
          </div>
          {maxSerie > 0 ? (
            <>
              <p class="mt-1 text-xs text-bo-muted">
                Plus forte journée : {formatPrice(maxSerie)}
              </p>
              <svg
                viewBox={`0 0 ${COURBE_L} ${COURBE_H}`}
                preserveAspectRatio="none"
                class="mt-2 h-40 w-full"
                role="img"
                aria-label="Courbe des ventes nettes jour par jour"
              >
                <polygon
                  points={aireCourbe}
                  class="text-bo-accent"
                  fill="currentColor"
                  opacity="0.12"
                />
                <polyline
                  points={pointsCourbe}
                  class="text-bo-accent"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linejoin="round"
                  stroke-linecap="round"
                  vector-effect="non-scaling-stroke"
                />
                <line
                  x1="0"
                  y1={COURBE_H - 0.5}
                  x2={COURBE_L}
                  y2={COURBE_H - 0.5}
                  class="text-bo-border"
                  stroke="currentColor"
                  stroke-width="1"
                  vector-effect="non-scaling-stroke"
                />
              </svg>
              <div class="mt-1 flex justify-between text-xs text-bo-muted">
                {reperesCourbe.map((j) => <span>{jourCourt(j)}</span>)}
              </div>
            </>
          ) : (
            <p class="mt-2 text-sm text-bo-muted">
              Aucune vente sur la période.
            </p>
          )}
        </div>

        {/* Site ou stand */}
        <div>
          <h4 class="text-sm font-medium">Le site ou le stand</h4>
          {canaux.length ? (
            <div class="mt-2 space-y-3">
              {canaux.map((c) => {
                const part =
                  totalCanal > 0 ? Math.round((c.cents / totalCanal) * 100) : 0;
                return (
                  <div>
                    <div class="flex flex-wrap items-baseline justify-between gap-2 text-sm">
                      <span>{NOM_CANAL[c.canal] ?? c.canal}</span>
                      <span class="text-bo-muted">
                        {formatPrice(c.cents)} · {c.unites} vendue{c.unites > 1 ? "s" : ""} · {part} %
                      </span>
                    </div>
                    <svg
                      viewBox="0 0 320 10"
                      preserveAspectRatio="none"
                      class="mt-1 h-2.5 w-full overflow-hidden rounded-full"
                      role="img"
                      aria-label={`${part} % des ventes`}
                    >
                      <rect
                        x="0"
                        y="0"
                        width="320"
                        height="10"
                        class="text-bo-border"
                        fill="currentColor"
                      />
                      <rect
                        x="0"
                        y="0"
                        width={Math.max(part * 3.2, part > 0 ? 3 : 0)}
                        height="10"
                        class="text-bo-accent"
                        fill="currentColor"
                      />
                    </svg>
                  </div>
                );
              })}
            </div>
          ) : (
            <p class="mt-2 text-sm text-bo-muted">Aucune vente sur la période.</p>
          )}
        </div>

        {/* Nouveaux clients */}
        <div>
          <h4 class="text-sm font-medium">Des nouveaux ou des habitués</h4>
          {totalClients ? (
            <>
              <div class="mt-2 flex flex-wrap items-baseline justify-between gap-2 text-sm">
                <span>
                  {nouveaux} nouveau{nouveaux > 1 ? "x" : ""} client
                  {nouveaux > 1 ? "s" : ""}
                </span>
                <span class="text-bo-muted">
                  {partNouveaux} % des acheteurs de cette affiche
                </span>
              </div>
              <svg
                viewBox="0 0 320 10"
                preserveAspectRatio="none"
                class="mt-1 h-2.5 w-full overflow-hidden rounded-full"
                role="img"
                aria-label={`${partNouveaux} % de nouveaux clients`}
              >
                <rect
                  x="0"
                  y="0"
                  width="320"
                  height="10"
                  class="text-bo-border"
                  fill="currentColor"
                />
                <rect
                  x="0"
                  y="0"
                  width={Math.max(partNouveaux * 3.2, partNouveaux > 0 ? 3 : 0)}
                  height="10"
                  class="text-bo-accent"
                  fill="currentColor"
                />
              </svg>
              <p class="mt-1 text-xs text-bo-muted">
                Le reste, {recurrents} client{recurrents > 1 ? "s" : ""}, avait
                déjà commandé avant cette période.
              </p>
            </>
          ) : (
            <p class="mt-2 text-sm text-bo-muted">
              Personne n'a encore acheté cette affiche sur la période.
            </p>
          )}
        </div>
      </div>
    </dialog>
  )}

  <script
    is:inline
    define:vars={{
      PUBLIC_API_URL,
      productId: id,
      titreParDefaut,
      descriptionParDefaut,
      LONGUEUR_DESCRIPTION,
    }}
  >
    const abs = (u) =>
      u && u.startsWith("http") ? u : `${PUBLIC_API_URL}${u}`;

    // --- Aperçu live du décor d'avant-plan ---
    const fgUrl = document.getElementById("fg-url");
    const fgPreview = document.getElementById("fg-preview");
    fgUrl?.addEventListener("input", () => {
      const v = fgUrl.value.trim();
      if (v) {
        fgPreview.src = abs(v);
        fgPreview.style.visibility = "visible";
      } else {
        fgPreview.removeAttribute("src");
        fgPreview.style.visibility = "hidden";
      }
    });

    // --- Ajout d'un visuel (POST /admin/products/:id/backgrounds) ---
    const addInput = document.getElementById("new-bg-url");
    const addBtn = document.getElementById("add-bg-btn");
    const addStatus = document.getElementById("add-bg-status");
    const grid = document.getElementById("bg-grid");
    const empty = document.getElementById("bg-empty");

    function bindDelete(btn) {
      btn.addEventListener("click", async () => {
        const fig = btn.closest("[data-bg-id]");
        if (!fig) return;
        if (!confirm("Supprimer ce visuel ?")) return;
        const bgId = fig.getAttribute("data-bg-id");
        try {
          const res = await fetch(`${PUBLIC_API_URL}/admin/backgrounds/${bgId}`, {
            method: "DELETE",
            credentials: "include",
          });
          if (!res.ok) throw new Error("HTTP " + res.status);
          fig.remove();
          if (empty && !grid.querySelector("[data-bg-id]"))
            empty.classList.remove("hidden");
        } catch (e) {
          alert("Suppression impossible : " + e);
        }
      });
    }

    document.querySelectorAll(".js-del-bg").forEach(bindDelete);

    // --- Téléversement d'un ou plusieurs visuels ---
    // Deux temps : on dépose le fichier (POST /admin/uploads), puis on
    // rattache l'URL obtenue au produit, exactement comme un ajout par URL.
    const fileInput = document.getElementById("new-bg-file");
    const uploadStatus = document.getElementById("upload-status");

    async function rattacher(url) {
      const res = await fetch(
        `${PUBLIC_API_URL}/admin/products/${productId}/backgrounds`,
        {
          method: "POST",
          credentials: "include",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ url }),
        },
      );
      if (!res.ok) throw new Error("HTTP " + res.status);
      return res.json();
    }

    fileInput?.addEventListener("change", async () => {
      const fichiers = Array.from(fileInput.files || []);
      if (!fichiers.length) return;
      let faits = 0;
      for (const f of fichiers) {
        uploadStatus.className = "text-xs text-bo-muted";
        uploadStatus.textContent = `Envoi de ${f.name} (${faits + 1}/${fichiers.length})…`;
        try {
          const fd = new FormData();
          fd.append("file", f);
          const res = await fetch(`${PUBLIC_API_URL}/admin/uploads`, {
            method: "POST",
            credentials: "include",
            body: fd,
          });
          const data = await res.json().catch(() => ({}));
          if (!res.ok) throw new Error(data.error || "HTTP " + res.status);
          await rattacher(data.url);
          faits++;
        } catch (e) {
          uploadStatus.className = "text-xs text-red-600";
          uploadStatus.textContent = `${f.name} : ${e}`;
          return;
        }
      }
      uploadStatus.className = "text-xs text-green-700";
      uploadStatus.textContent = `${faits} visuel(s) ajouté(s).`;
      // Rechargement : la grille est rendue côté serveur, plus fiable que de
      // la reconstruire à la main pour plusieurs fichiers.
      location.reload();
    });

    addBtn?.addEventListener("click", async () => {
      const url = (addInput.value || "").trim();
      if (!url) {
        addInput.focus();
        return;
      }
      if (addStatus) {
        addStatus.textContent = "…";
        addStatus.className = "text-xs text-bo-muted";
      }
      try {
        const res = await fetch(
          `${PUBLIC_API_URL}/admin/products/${productId}/backgrounds`,
          {
            method: "POST",
            credentials: "include",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ url }),
          },
        );
        if (!res.ok) throw new Error("HTTP " + res.status);
        const bg = await res.json();

        // Insère la nouvelle vignette sans recharger la page.
        const fig = document.createElement("figure");
        fig.className =
          "relative border border-bo-border rounded overflow-hidden bg-white group";
        fig.setAttribute("data-bg-id", bg.id);
        fig.innerHTML =
          `<img src="${abs(bg.url)}" alt="${bg.name ?? ""}" class="w-full aspect-square object-cover" loading="lazy" />` +
          `<button type="button" class="js-del-bg absolute top-1 right-1 h-6 w-6 rounded-full bg-white/90 border border-bo-border text-sm leading-none text-bo-muted hover:text-red-600 hover:border-red-300 shadow" title="Supprimer ce visuel" aria-label="Supprimer ce visuel">✕</button>` +
          (bg.name
            ? `<figcaption class="px-2 py-1 text-xs text-bo-muted truncate">${bg.name}</figcaption>`
            : "");
        grid.appendChild(fig);
        bindDelete(fig.querySelector(".js-del-bg"));
        empty?.classList.add("hidden");

        addInput.value = "";
        if (addStatus) {
          addStatus.textContent = "Ajouté ✓";
          addStatus.className = "text-xs text-green-700";
        }
      } catch (e) {
        if (addStatus) {
          addStatus.textContent = "Erreur";
          addStatus.className = "text-xs text-red-600";
        }
      }
    });

    // ================================================================
    // Images de la boutique
    // ================================================================
    // Les vignettes SONT la liste : leur ordre à l'écran est celui qui part au
    // serveur, recopié dans un champ caché avant l'envoi. Rien n'est
    // enregistré tant que le bouton n'a pas été cliqué, ce que dit le
    // marqueur « non enregistré ».
    const listeMedias = document.getElementById("medias-liste");
    if (listeMedias) {
      const champImages = document.getElementById("images-json");
      const mediasVide = document.getElementById("medias-vide");
      const mediasModifie = document.getElementById("medias-modifie");
      const mediaFichier = document.getElementById("media-fichier");
      const mediaEtat = document.getElementById("media-etat");

      function synchroniserMedias() {
        const items = [...listeMedias.querySelectorAll("li[data-url]")];
        items.forEach((li, i) => {
          const rang = li.querySelector(".js-media-rang");
          if (rang) rang.textContent = i === 0 ? "Principale" : "n° " + (i + 1);
        });
        champImages.value = JSON.stringify(
          items.map((li) => ({
            id: li.dataset.imageId ? Number(li.dataset.imageId) : undefined,
            url: li.dataset.url,
            alt: li.dataset.alt || null,
          })),
        );
        mediasVide?.classList.toggle("hidden", items.length > 0);
      }

      function mediasChanges() {
        mediasModifie?.classList.remove("hidden");
        synchroniserMedias();
      }

      synchroniserMedias();

      listeMedias.addEventListener("click", (ev) => {
        const cible = ev.target;
        if (!(cible instanceof Element)) return;
        const li = cible.closest("li[data-url]");
        if (!li) return;
        if (cible.closest(".js-media-gauche")) {
          const avant = li.previousElementSibling;
          if (avant) listeMedias.insertBefore(li, avant);
          mediasChanges();
        } else if (cible.closest(".js-media-droite")) {
          const apres = li.nextElementSibling;
          if (apres) listeMedias.insertBefore(apres, li);
          mediasChanges();
        } else if (cible.closest(".js-media-suppr")) {
          li.remove();
          mediasChanges();
        }
      });

      mediaFichier?.addEventListener("change", async () => {
        const fichiers = Array.from(mediaFichier.files || []);
        if (!fichiers.length) return;
        let faits = 0;
        for (const f of fichiers) {
          mediaEtat.className = "text-xs text-bo-muted";
          mediaEtat.textContent = `Envoi de ${f.name} (${faits + 1}/${fichiers.length})…`;
          try {
            const fd = new FormData();
            fd.append("file", f);
            const res = await fetch(`${PUBLIC_API_URL}/admin/uploads`, {
              method: "POST",
              credentials: "include",
              body: fd,
            });
            const data = await res.json().catch(() => ({}));
            if (!res.ok) throw new Error(data.error || "HTTP " + res.status);

            const li = document.createElement("li");
            li.className = "relative rounded border border-bo-border bg-bo-bg";
            li.dataset.url = data.url;
            li.dataset.alt = "";
            li.innerHTML =
              `<img src="${abs(data.url)}" alt="" class="aspect-square w-full rounded-t object-contain" loading="lazy" />` +
              `<div class="flex items-center justify-between gap-1 px-1.5 py-1">` +
              `<button type="button" class="js-media-gauche px-1 text-bo-muted hover:text-bo-ink" title="Déplacer vers la gauche" aria-label="Déplacer cette image vers la gauche">◀</button>` +
              `<span class="js-media-rang text-[11px] text-bo-muted"></span>` +
              `<button type="button" class="js-media-droite px-1 text-bo-muted hover:text-bo-ink" title="Déplacer vers la droite" aria-label="Déplacer cette image vers la droite">▶</button>` +
              `</div>` +
              `<button type="button" class="js-media-suppr absolute right-1 top-1 h-6 w-6 rounded-full border border-bo-border bg-bo-surface text-sm leading-none text-bo-muted shadow hover:border-red-300 hover:text-red-600" title="Retirer cette image" aria-label="Retirer cette image">✕</button>`;
            listeMedias.appendChild(li);
            faits++;
          } catch (e) {
            mediaEtat.className = "text-xs text-red-600";
            mediaEtat.textContent = `${f.name} n'a pas pu être envoyée. Réessayez.`;
            mediasChanges();
            return;
          }
        }
        mediaEtat.className = "text-xs text-green-700";
        mediaEtat.textContent = `${faits} image(s) ajoutée(s), à enregistrer.`;
        mediaFichier.value = "";
        mediasChanges();
      });
    }

    // ================================================================
    // Tarification : marge affichée, lignes ajoutées et retirées
    // ================================================================
    const corpsFormats = document.getElementById("lignes-formats");
    if (corpsFormats) {
      const formatsVide = document.getElementById("formats-vide");
      const modeleFormat = document.getElementById("modele-format");
      const boutonAjoutFormat = document.getElementById("ajouter-format");

      /** « 24,90 » ou « 24.9 » -> 2490 centimes, ou rien si c'est illisible. */
      function centimes(texte) {
        const t = String(texte || "")
          .replace(/[\s €]/g, "")
          .replace(",", ".");
        if (!/^\d+(\.\d{1,2})?$/.test(t)) return null;
        return Math.round(Number(t) * 100);
      }

      // Le même rendu qu'au chargement de la page : « 24 € » quand le montant
      // est rond, « 24,90 € » sinon.
      function euros(cents) {
        return (cents / 100).toLocaleString("fr-FR", {
          style: "currency",
          currency: "EUR",
          minimumFractionDigits: cents % 100 === 0 ? 0 : 2,
        });
      }

      /** La marge n'est jamais enregistrée : elle se déduit à chaque frappe. */
      function calculerMarge(ligne) {
        const cellule = ligne.querySelector(".js-marge");
        if (!cellule) return;
        const prix = centimes(ligne.querySelector(".js-prix")?.value);
        const cout = centimes(ligne.querySelector(".js-cout")?.value);
        if (prix === null || cout === null || prix <= 0) {
          cellule.textContent = "";
          return;
        }
        const marge = prix - cout;
        const part = Math.round((marge / prix) * 100);
        cellule.textContent = `${euros(marge)} (${part} %)`;
      }

      function rafraichirFormats() {
        const lignes = [...corpsFormats.querySelectorAll(".js-ligne-format")];
        lignes.forEach(calculerMarge);
        formatsVide?.classList.toggle("hidden", lignes.length > 0);
      }

      rafraichirFormats();

      corpsFormats.addEventListener("input", (ev) => {
        const ligne = ev.target.closest?.(".js-ligne-format");
        if (ligne) calculerMarge(ligne);
      });

      corpsFormats.addEventListener("click", (ev) => {
        const cible = ev.target;
        if (!(cible instanceof Element)) return;
        const bouton = cible.closest(".js-retirer-format");
        if (!bouton) return;
        const ligne = bouton.closest(".js-ligne-format");
        const drapeau = ligne?.querySelector(".js-format-supprime");
        if (!ligne || !drapeau) return;

        // Une ligne jamais enregistrée disparaît tout de suite ; une ligne
        // existante reste visible, barrée, jusqu'à l'enregistrement — sinon
        // rien ne dit à la boutique ce qui va être supprimé.
        const existante = ligne.querySelector('input[name="varianteId"]')?.value;
        if (!existante) {
          ligne.remove();
          rafraichirFormats();
          return;
        }
        if (drapeau.value === "1") {
          drapeau.value = "0";
          ligne.classList.remove("opacity-50", "line-through");
          bouton.textContent = "Retirer";
        } else {
          drapeau.value = "1";
          ligne.classList.add("opacity-50", "line-through");
          bouton.textContent = "Rétablir";
        }
      });

      boutonAjoutFormat?.addEventListener("click", () => {
        const clone = modeleFormat.content.firstElementChild.cloneNode(true);
        corpsFormats.appendChild(clone);
        clone.querySelector('input[name="varianteFormat"]')?.focus();
        rafraichirFormats();
      });
    }

    // ================================================================
    // Référencement : l'aperçu suit ce qui se tape
    // ================================================================
    const champSeoTitre = document.getElementById("champ-seo-titre");
    if (champSeoTitre) {
      const champSeoDescription = document.getElementById(
        "champ-seo-description",
      );
      const champSlug = document.getElementById("champ-slug");
      const apercuTitre = document.getElementById("apercu-titre");
      const apercuDescription = document.getElementById("apercu-description");
      const apercuUrl = document.getElementById("apercu-url");
      const compteTitre = document.getElementById("compte-seo-titre");
      const compteDescription = document.getElementById(
        "compte-seo-description",
      );
      const baseUrl = (apercuUrl.textContent || "").replace(/[^/]*$/, "");

      function rafraichirApercu() {
        const titre = champSeoTitre.value.trim();
        const description = champSeoDescription.value.trim();
        apercuTitre.textContent = titre || titreParDefaut;
        apercuDescription.textContent =
          description ||
          descriptionParDefaut ||
          "Cette affiche n'a pas encore de description.";
        apercuUrl.textContent = baseUrl + champSlug.value.trim();
        compteTitre.textContent = titre
          ? `${titre.length} caractères, 70 conseillés au maximum.`
          : "Vide : le site utilise le nom de l'affiche.";
        compteDescription.textContent = description
          ? `${description.length} caractères, ${LONGUEUR_DESCRIPTION} conseillés au maximum.`
          : "Vide : le site utilise le début de la description.";
      }

      [champSeoTitre, champSeoDescription, champSlug].forEach((c) =>
        c?.addEventListener("input", rafraichirApercu),
      );
      rafraichirApercu();
    }

    // ================================================================
    // Statut : dire tout de suite ce que le choix va changer
    // ================================================================
    const champStatut = document.getElementById("champ-statut");
    champStatut?.addEventListener("change", () => {
      const explication = document.getElementById("explication-statut");
      const choisi = champStatut.selectedOptions[0];
      if (explication && choisi)
        explication.textContent = choisi.dataset.explication || "";
    });

    // ================================================================
    // Étiquettes
    // ================================================================
    const posees = document.getElementById("etiquettes-posees");
    if (posees) {
      const saisie = document.getElementById("nouvelle-etiquette");
      const boutonEtiquette = document.getElementById("ajouter-etiquette");
      const etiquettesVide = document.getElementById("etiquettes-vide");

      function rafraichirEtiquettes() {
        const nb = posees.querySelectorAll(".js-etiquette").length;
        etiquettesVide?.classList.toggle("hidden", nb > 0);
        document.querySelectorAll(".js-suggestion").forEach((s) => {
          const nom = s.getAttribute("data-etiquette");
          const deja = !!posees.querySelector(
            `.js-etiquette[data-etiquette="${CSS.escape(nom)}"]`,
          );
          s.classList.toggle("hidden", deja);
        });
      }

      function ajouterEtiquette(nom) {
        const propre = String(nom || "").trim();
        if (!propre) return;
        if (
          posees.querySelector(
            `.js-etiquette[data-etiquette="${CSS.escape(propre)}"]`,
          )
        )
          return;
        const puce = document.createElement("span");
        puce.className =
          "js-etiquette inline-flex items-center gap-1 rounded-full bg-bo-bg px-2 py-0.5 text-xs";
        puce.setAttribute("data-etiquette", propre);
        const champCache = document.createElement("input");
        champCache.type = "hidden";
        champCache.name = "tags";
        champCache.value = propre;
        const retrait = document.createElement("button");
        retrait.type = "button";
        retrait.className =
          "js-retirer-etiquette text-bo-muted hover:text-red-600";
        retrait.setAttribute("aria-label", `Retirer l'étiquette ${propre}`);
        retrait.textContent = "✕";
        puce.append(champCache, document.createTextNode(propre), retrait);
        posees.appendChild(puce);
        rafraichirEtiquettes();
      }

      boutonEtiquette?.addEventListener("click", () => {
        ajouterEtiquette(saisie.value);
        saisie.value = "";
        saisie.focus();
      });

      // Entrée ajoute l'étiquette au lieu d'envoyer le formulaire : personne
      // ne s'attend à enregistrer toute la fiche en tapant une étiquette.
      saisie?.addEventListener("keydown", (ev) => {
        if (ev.key !== "Enter") return;
        ev.preventDefault();
        ajouterEtiquette(saisie.value);
        saisie.value = "";
      });

      posees.addEventListener("click", (ev) => {
        const cible = ev.target;
        if (!(cible instanceof Element)) return;
        if (!cible.closest(".js-retirer-etiquette")) return;
        cible.closest(".js-etiquette")?.remove();
        rafraichirEtiquettes();
      });

      document.querySelectorAll(".js-suggestion").forEach((s) => {
        s.addEventListener("click", () =>
          ajouterEtiquette(s.getAttribute("data-etiquette")),
        );
      });

      rafraichirEtiquettes();
    }

    // ================================================================
    // Le détail des ventes
    // ================================================================
    const modaleVentes = document.getElementById("modale-ventes");
    if (modaleVentes) {
      const ouvrir = document.getElementById("ouvrir-ventes");
      const fermer = document.getElementById("fermer-ventes");
      ouvrir?.addEventListener("click", () => modaleVentes.showModal());
      fermer?.addEventListener("click", () => modaleVentes.close());
      // Un clic hors du cadre ferme aussi : l'événement porte alors sur la
      // fenêtre elle-même, jamais sur son contenu. La touche Échap est déjà
      // gérée par le navigateur.
      modaleVentes.addEventListener("click", (ev) => {
        if (ev.target === modaleVentes) modaleVentes.close();
      });
    }
  </script>
</Admin>
