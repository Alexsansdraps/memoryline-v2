---
/**
 * Modification en masse des produits.
 *
 * Corriger vingt prix ou ranger trente affiches dans une catégorie, fiche par
 * fiche, prend une matinée. Cet écran présente les mêmes réglages sous forme
 * de grille : une ligne par produit, une colonne par champ, et un seul
 * enregistrement à la fin. Sous les en-têtes, la ligne « Appliquer à tout »
 * pose une valeur sur toute une colonne, comme dans l'éditeur en masse de
 * Shopify — le geste qui fait gagner la matinée (« il faut qu'on puisse
 * modifier en masse : le nom, l'identifiant, le prix, les collections, le
 * poids, les catégories, les descriptions, les statuts, le type d'affiche »,
 * carte Trello de Margaux).
 *
 * RIEN NE PART SANS AVOIR ÉTÉ VU. « Vérifier les changements » montre, ligne
 * par ligne, ce que chaque champ était et ce qu'il deviendra, les lignes
 * refusées et pourquoi, et les redirections 301 que poseront les adresses
 * changées. C'est seulement de là qu'on enregistre : renommer cent affiches
 * d'un clic se relit avant.
 *
 * La page ne renvoie que les lignes réellement touchées. Le navigateur garde
 * la valeur d'origine de chaque champ et compare avant d'envoyer : réécrire
 * deux cents produits parce que la page a été ouverte serait le meilleur moyen
 * d'écraser un travail fait ailleurs.
 *
 * Le prix se règle FORMAT PAR FORMAT : c'est le format qui porte le prix payé
 * au panier, le prix de base n'étant qu'un repli pour un produit qui n'a aucun
 * format. Une colonne par format présent dans la sélection, donc, plutôt
 * qu'une colonne « prix » qui ne changerait rien à la caisse.
 *
 * Règle qui gouverne toute la saisie : une valeur incomprise est refusée et
 * dite sur la ligne, jamais rattrapée en douce. Un « 5e » tapé dans un poids
 * ne doit pas devenir un poids vide, et un prix négatif ne doit pas devenir
 * zéro : le colis partirait sous-affranchi, ou l'affiche partirait gratuite,
 * sans que rien ne le signale.
 *
 * Les produits à éditer arrivent soit par leurs identifiants (« ?ids=12,45 »,
 * ce que passe la liste des produits quand on coche des lignes), soit par le
 * filtre courant, repris tel quel de la liste (« Modifier les N affiches de
 * ce filtre »).
 */
import { url } from "../../lib/url.ts";
import Admin from "../../layouts/Admin.astro";
import EditeurTexte from "../../components/EditeurTexte.astro";
import {
  adminApi,
  formatPrice,
  type ApercuMasse,
  type ListeProduitsAdmin,
  type ProduitAdmin,
  type TypeAffiche,
} from "../../lib/api.ts";

const api = adminApi(Astro.request);

/**
 * Au-delà, la grille devient lourde et le navigateur rame sur des milliers
 * de champs. Deux cent cinquante couvrent le catalogue entier d'aujourd'hui
 * (cent soixante-dix-huit affiches) : « toutes les affiches d'un filtre » tient
 * en une fois. Au-delà, mieux vaut deux passages qu'une page qui ne répond plus.
 */
const PLAFOND = 250;

const STATUTS = [
  { valeur: "active", libelle: "Actif" },
  { valeur: "draft", libelle: "Brouillon" },
  { valeur: "archived", libelle: "Archivé" },
];

function libelleStatut(valeur: string): string {
  return STATUTS.find((s) => s.valeur === valeur)?.libelle ?? valeur;
}

/** Les trois façons de toucher aux collections d'un lot. */
const MODES_COLLECTIONS = ["ajouter", "retirer", "remplacer"] as const;
type ModeCollections = (typeof MODES_COLLECTIONS)[number];

/** Les images de l'API sont servies en chemin relatif : le navigateur, lui, a besoin de l'adresse complète. */
const API_PUBLIQUE = import.meta.env.PUBLIC_API_URL ?? "http://localhost:3000";
function imgSrc(chemin: string | null): string {
  if (!chemin) return "";
  return chemin.startsWith("http") ? chemin : `${API_PUBLIQUE}${chemin}`;
}

/** Centimes vers la saisie à l'écran, en français : 2390 devient « 23,90 ». */
function euros(cents: number): string {
  return (cents / 100).toFixed(2).replace(".", ",");
}

/**
 * L'adresse tirée d'un nom — la même règle que l'API (produits-masse.ts) et
 * que le script de la page : sans accent, en minuscules, des tirets.
 */
function slugifier(valeur: string): string {
  return valeur
    .normalize("NFD")
    .replace(/[̀-ͯ]/g, "")
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "")
    .slice(0, 80);
}

/** Le texte d'une description, pour la montrer en une ligne dans la grille. */
function extrait(html: string | null | undefined): string {
  const texte = String(html ?? "")
    .replace(/<[^>]*>/g, " ")
    .replace(/&nbsp;/gi, " ")
    .replace(/&amp;/gi, "&")
    .replace(/\s+/g, " ")
    .trim();
  return texte.length > 60 ? `${texte.slice(0, 59)}…` : texte;
}

const parametres = Astro.url.searchParams;

const idsDemandes = [
  ...new Set(
    (parametres.get("ids") ?? "")
      .split(",")
      .map((t) => Number(t.trim()))
      .filter((n) => Number.isInteger(n) && n > 0),
  ),
];

const STATUTS_FILTRE = ["tous", "active", "draft", "archived"];
const statutDemande = parametres.get("statut") ?? "";
const statutFiltre = STATUTS_FILTRE.includes(statutDemande)
  ? statutDemande
  : "tous";
const recherche = (parametres.get("q") ?? "").trim();
const categorieFiltre = Number(parametres.get("categorie") ?? "");
const collectionFiltre = Number(parametres.get("collection") ?? "");

/** Ce qu'une ligne du tableau demande à l'API. Le prix est indexé par format. */
type LigneModifiee = {
  id: number;
  name?: string;
  slug?: string;
  /** L'adresse suit le nom, rendue unique par l'API (-2, -3…). */
  slugDepuisNom?: true;
  status?: string;
  basePriceCents?: number;
  categoryId?: number | null;
  weightGrams?: number | null;
  aiEnabled?: boolean;
  description?: string | null;
  defaultView?: string | null;
  collections?: { mode: ModeCollections; ids: number[] };
  /** Centimes, uniquement les formats dont le prix change. */
  prix?: Record<string, number>;
};

/** Une ligne écartée avant l'envoi, avec de quoi la réafficher telle quelle. */
interface RefusLocal {
  id: number;
  message: string;
  saisie: Record<string, unknown>;
}

interface LectureCharge {
  lignes: LigneModifiee[];
  refus: RefusLocal[];
}

const MESSAGE_PRIX =
  "Ce prix n'a pas été compris. Retapez-le, par exemple 24,90.";
const MESSAGE_POIDS =
  "Ce poids n'a pas été compris. Tapez un nombre de grammes, par exemple 350, ou laissez la case vide pour reprendre celui de la catégorie.";

/** Un prix tel qu'il doit arriver du navigateur : des centimes entiers, jamais négatifs. */
function centimesValides(v: unknown): number | null {
  return typeof v === "number" && Number.isInteger(v) && v >= 0 ? v : null;
}

/**
 * Relit UNE ligne de la charge. Rend le motif du refus, ou null si tout est
 * lisible.
 *
 * Rien n'est corrigé ici. Un prix négatif arrondi à zéro ou un poids
 * incompréhensible transformé en « vide » seraient acceptés par l'API sans un
 * mot : une donnée fausse deviendrait une donnée plausible, et la propriétaire
 * ne verrait le résultat qu'au moment d'affranchir le colis.
 */
function relireLigne(
  ligne: Record<string, unknown>,
  sortie: LigneModifiee,
): string | null {
  if ("name" in ligne) {
    const nom = typeof ligne.name === "string" ? ligne.name.trim() : "";
    if (!nom) return "Le nom ne peut pas rester vide.";
    sortie.name = nom;
  }

  if ("slug" in ligne) {
    const slug = typeof ligne.slug === "string" ? ligne.slug.trim() : "";
    if (!slug) return "L'identifiant ne peut pas rester vide.";
    sortie.slug = slug;
  } else if ("slugDepuisNom" in ligne) {
    if (ligne.slugDepuisNom !== true)
      return "L'identifiant n'a pas été compris. Cliquez de nouveau « Refaire depuis le nom ».";
    sortie.slugDepuisNom = true;
  }

  if ("status" in ligne) {
    const statut = ligne.status;
    if (typeof statut !== "string" || !STATUTS.some((s) => s.valeur === statut))
      return "Ce statut n'existe pas. Choisissez Actif, Brouillon ou Archivé.";
    sortie.status = statut;
  }

  if ("basePriceCents" in ligne) {
    const cents = centimesValides(ligne.basePriceCents);
    if (cents === null) return MESSAGE_PRIX;
    sortie.basePriceCents = cents;
  }

  if ("prix" in ligne) {
    const brut = ligne.prix;
    if (typeof brut !== "object" || brut === null || Array.isArray(brut))
      return MESSAGE_PRIX;
    const prix: Record<string, number> = {};
    for (const [format, valeur] of Object.entries(
      brut as Record<string, unknown>,
    )) {
      const cents = centimesValides(valeur);
      if (cents === null)
        return `Le prix du format ${format} n'a pas été compris. Retapez-le, par exemple 24,90.`;
      prix[format] = cents;
    }
    if (Object.keys(prix).length > 0) sortie.prix = prix;
  }

  if ("categoryId" in ligne) {
    if (ligne.categoryId === null) {
      sortie.categoryId = null;
    } else {
      const cat = Number(ligne.categoryId);
      if (!Number.isInteger(cat) || cat <= 0)
        return "Cette catégorie n'existe plus. Rechargez la page.";
      sortie.categoryId = cat;
    }
  }

  if ("weightGrams" in ligne) {
    if (ligne.weightGrams === null) {
      sortie.weightGrams = null;
    } else {
      const poids = ligne.weightGrams;
      if (typeof poids !== "number" || !Number.isInteger(poids) || poids < 0)
        return MESSAGE_POIDS;
      sortie.weightGrams = poids;
    }
  }

  if ("aiEnabled" in ligne) {
    if (typeof ligne.aiEnabled !== "boolean")
      return "Le réglage « Affiche IA » n'a pas été compris.";
    sortie.aiEnabled = ligne.aiEnabled;
  }

  if ("description" in ligne) {
    const d = ligne.description;
    if (d !== null && typeof d !== "string")
      return "La description n'a pas été comprise. Rouvrez-la et validez-la de nouveau.";
    sortie.description = d;
  }

  if ("defaultView" in ligne) {
    const v = ligne.defaultView;
    if (v !== null && typeof v !== "string")
      return "Ce type d'affiche n'a pas été compris. Choisissez-le de nouveau.";
    sortie.defaultView = v === "" ? null : v;
  }

  if ("collections" in ligne) {
    const c = ligne.collections;
    const lue =
      c && typeof c === "object" && !Array.isArray(c)
        ? (c as Record<string, unknown>)
        : null;
    const mode = String(lue?.mode ?? "");
    const ids = lue?.ids;
    if (
      !lue ||
      !(MODES_COLLECTIONS as readonly string[]).includes(mode) ||
      !Array.isArray(ids) ||
      ids.some((n) => !Number.isInteger(n) || (n as number) <= 0)
    )
      return "Les collections n'ont pas été comprises. Choisissez-les de nouveau.";
    sortie.collections = { mode: mode as ModeCollections, ids: ids as number[] };
  }

  return null;
}

/**
 * Relit la charge envoyée par le navigateur. Elle traverse un formulaire, donc
 * rien de ce qu'elle contient n'est digne de confiance : ce qui n'est pas
 * lisible ressort dans `refus` et s'affiche, au lieu d'être deviné.
 */
function lireModifications(brut: string): LectureCharge {
  const lignes: LigneModifiee[] = [];
  const refus: RefusLocal[] = [];

  let donnees: unknown;
  try {
    donnees = JSON.parse(brut);
  } catch {
    return { lignes, refus };
  }
  if (!Array.isArray(donnees)) return { lignes, refus };

  for (const entree of donnees) {
    if (typeof entree !== "object" || entree === null) continue;
    const ligne = entree as Record<string, unknown>;
    const id = Number(ligne.id);
    // Sans identifiant lisible, il n'y a aucune ligne sur laquelle afficher
    // quoi que ce soit : c'est le seul cas qu'on laisse tomber en silence.
    if (!Number.isInteger(id) || id <= 0) continue;

    const sortie: LigneModifiee = { id };
    const message = relireLigne(ligne, sortie);
    if (message !== null) {
      refus.push({ id, message, saisie: ligne });
      continue;
    }
    if (Object.keys(sortie).length > 1) lignes.push(sortie);
  }
  return { lignes, refus };
}

let flash: string | null = null;
/** Trois tons, parce qu'un enregistrement sans effet n'est pas un succès. */
let flashTon: "succes" | "avertissement" | "erreur" = "succes";

/** Le motif du refus, produit par produit, affiché sur la ligne concernée. */
const messagesErreur = new Map<number, string>();

/**
 * Ce que la propriétaire avait tapé : pour les lignes que l'API n'a pas
 * gardées, et pour TOUTES les lignes vérifiées. Sans ça, la page se recharge
 * sur les anciennes valeurs et son travail est perdu au moment précis où il
 * faudrait le relire ou le corriger.
 */
const valeursSaisies = new Map<number, Record<string, unknown>>();

/** Après « Vérifier les changements » : ce qui changerait, et le lot à enregistrer. */
let apercu: ApercuMasse[] | null = null;
let chargeVerifiee = "";
let redirectionsPrevues = 0;

function accord(n: number, singulier: string, pluriel: string): string {
  return n > 1 ? pluriel : singulier;
}

if (Astro.request.method === "POST") {
  const f = await Astro.request.formData();
  const action = String(f.get("_action") ?? "enregistrer");
  const { lignes: modifications, refus } = lireModifications(
    String(f.get("modifications") ?? ""),
  );
  for (const r of refus) {
    messagesErreur.set(r.id, r.message);
    valeursSaisies.set(r.id, r.saisie);
  }

  if (modifications.length === 0 && refus.length === 0) {
    flash = "Rien à vérifier : aucune valeur n'avait changé.";
    flashTon = "avertissement";
  } else if (modifications.length === 0) {
    flash = `Rien n'a été envoyé à la boutique : ${refus.length} ${accord(refus.length, "ligne n'a", "lignes n'ont")} pas pu être ${accord(refus.length, "relue", "relues")}. La raison est indiquée en rouge, et vos valeurs sont toujours à l'écran.`;
    flashTon = "erreur";
  } else if (action === "verifier") {
    // Toutes les lignes reviennent à l'écran telles qu'elles ont été tapées :
    // la grille reste modifiable, et l'aperçu s'enregistre d'un clic.
    for (const m of modifications) valeursSaisies.set(m.id, m);
    try {
      const r = await api.enregistrerProduitsEnMasse(modifications, true);
      const refusesApi = r.erreurs ?? [];
      for (const e of refusesApi) messagesErreur.set(e.id, e.message);
      const refusees = new Set(refusesApi.map((e) => e.id));
      apercu = r.apercu ?? [];
      redirectionsPrevues = r.redirections ?? 0;
      // Le lot enregistré sera EXACTEMENT celui qui vient d'être montré,
      // sans les lignes refusées : elles restent à corriger dans la grille.
      chargeVerifiee = JSON.stringify(
        modifications.filter((m) => !refusees.has(m.id)),
      );
      const bloquees = refusesApi.length + refus.length;
      flash =
        `Vérification faite, rien n'est encore enregistré : ${apercu.length} ${accord(apercu.length, "affiche changerait", "affiches changeraient")}` +
        (bloquees
          ? `, ${bloquees} ${accord(bloquees, "ligne est refusée", "lignes sont refusées")} (raison en rouge).`
          : ".") +
        " Relisez le tableau ci-dessous, puis cliquez « Enregistrer ces changements ».";
      flashTon = bloquees ? "avertissement" : "succes";
    } catch (e) {
      flash =
        "La vérification n'a pas pu se faire, la boutique n'a pas répondu : " +
        String(e).replace(/^Error:\s*/, "") +
        ". Vos valeurs sont toujours à l'écran, réessayez dans un instant.";
      flashTon = "erreur";
    }
  } else {
    try {
      const r = await api.enregistrerProduitsEnMasse(modifications);
      const refusesApi = r.erreurs ?? [];
      for (const e of refusesApi) messagesErreur.set(e.id, e.message);
      for (const m of modifications)
        if (messagesErreur.has(m.id)) valeursSaisies.set(m.id, m);

      // L'API ne compte que les lignes qu'elle a vraiment écrites. Ce qui
      // manque à l'appel n'a été ni écrit ni refusé : la valeur envoyée était
      // déjà celle de la boutique, et le taire ferait passer une saisie
      // disparue de l'écran pour un enregistrement réussi.
      const sansEffet = Math.max(
        0,
        modifications.length - r.count - refusesApi.length,
      );
      const bloquees = refusesApi.length + refus.length;
      const redirections = r.redirections ?? 0;

      const morceaux: string[] = [
        r.count === 0
          ? "Aucun produit enregistré."
          : `${r.count} ${accord(r.count, "produit enregistré", "produits enregistrés")}.`,
      ];
      if (redirections > 0)
        morceaux.push(
          `${redirections} ${accord(redirections, "adresse a changé : son ancienne adresse redirige", "adresses ont changé : leurs anciennes adresses redirigent")} vers la nouvelle (301), les liens déjà partagés continuent de fonctionner.`,
        );
      if (bloquees > 0)
        morceaux.push(
          `${bloquees} ${accord(bloquees, "ligne n'a", "lignes n'ont")} pas pu être ${accord(bloquees, "enregistrée", "enregistrées")} : la raison est indiquée en rouge, sur la ligne quand le produit est encore dans le tableau, en haut de cette page sinon. Vos valeurs y sont toujours.`,
        );
      if (sansEffet > 0)
        morceaux.push(
          `${sansEffet} ${accord(sansEffet, "ligne n'a", "lignes n'ont")} rien changé : ce qui a été tapé revenait à ce que la boutique enregistre déjà. Ces cases sont revenues à la valeur de la boutique. L'identifiant, par exemple, est toujours mis en forme sans majuscule ni accent.`,
        );

      flash = morceaux.join(" ");
      flashTon =
        bloquees > 0
          ? "erreur"
          : sansEffet > 0 || r.count === 0
            ? "avertissement"
            : "succes";
    } catch (e) {
      for (const m of modifications) valeursSaisies.set(m.id, m);
      flash =
        "Rien n'a été enregistré, la boutique n'a pas répondu : " +
        String(e).replace(/^Error:\s*/, "") +
        ". Vos valeurs sont toujours à l'écran, réessayez dans un instant.";
      flashTon = "erreur";
    }
  }
}

/** Ce que la page demande à `api.produitsAdmin`. */
interface FiltresProduits {
  statut?: string;
  q?: string;
  categorie?: number;
  collection?: number;
  limit?: number;
  ids?: number[];
  avecDescription?: boolean;
}

const filtres: FiltresProduits =
  idsDemandes.length > 0
    ? // Une sélection se respecte quel que soit le statut des produits cochés.
      {
        ids: idsDemandes,
        statut: "tous",
        limit: idsDemandes.length,
        avecDescription: true,
      }
    : {
        statut: statutFiltre,
        ...(recherche ? { q: recherche } : {}),
        ...(Number.isInteger(categorieFiltre) && categorieFiltre > 0
          ? { categorie: categorieFiltre }
          : {}),
        ...(Number.isInteger(collectionFiltre) && collectionFiltre > 0
          ? { collection: collectionFiltre }
          : {}),
        // Un de plus que le plafond : c'est ce qui distingue « il y en a
        // exactement deux cent cinquante » de « il y en a davantage et on en
        // cache ».
        limit: PLAFOND + 1,
        avecDescription: true,
      };

let liste: ListeProduitsAdmin | null = null;
let error: string | null = null;
try {
  liste = await api.produitsAdmin(filtres);
} catch (e) {
  error = String(e).replace(/^Error:\s*/, "");
}

/** Les types d'affiche (« de face », « de dos »…). Muets : la colonne se tait. */
let vues: TypeAffiche[] = [];
try {
  vues = await api.views();
} catch {
  vues = [];
}
const vuesOuvertes = vues.filter((v) => !v.archivedAt);
const nomVue = new Map(vues.map((v) => [v.slug, v.name]));

/**
 * Toutes les catégories, ARCHIVÉES COMPRISES, avec leur nom et leur poids.
 *
 * Le poids d'abord : la liste des produits ne renvoie que les noms, or c'est
 * ce poids-là que pèsera un produit dont la case reste vide, et l'annoncer
 * faux serait pire que se taire. Le nom ensuite : la liste déroulante ne
 * propose plus les catégories archivées, et il faut tout de même savoir
 * comment s'appelle celle où une affiche est déjà rangée.
 */
const toutesCategories = new Map<
  number,
  { name: string; defaultWeightGrams: number }
>();
let poidsCategoriesConnus = true;
try {
  for (const c of await api.productCategories())
    toutesCategories.set(c.id, {
      name: c.name,
      defaultWeightGrams: c.defaultWeightGrams,
    });
} catch {
  // La grille reste utilisable sans ces poids, mais elle se tait alors au lieu
  // d'annoncer « aucun poids » à des produits qui en ont peut-être un.
  poidsCategoriesConnus = false;
}

/** Les catégories où l'on peut ranger : l'API en retire les archivées. */
const categories = liste?.categories ?? [];
const categoriesOuvertes = new Set(categories.map((c) => c.id));

/**
 * La catégorie d'une ligne quand la liste déroulante ne la propose plus —
 * c'est-à-dire quand elle vient d'être archivée. `null` le reste du temps.
 *
 * Son option DOIT exister, sans quoi aucune ne correspondrait et le navigateur
 * retomberait sur « Aucune » alors que `data-initial` garde l'identifiant :
 * la ligne se dirait modifiée sans que personne n'y ait touché, et le premier
 * enregistrement écrirait `categoryId: null`. L'affiche quitterait son
 * rangement, et avec lui le poids par défaut qui décide de son affranchissement
 * — exactement la perte que l'archivage est là pour empêcher.
 *
 * On n'y range personne d'autre pour autant : l'option n'apparaît que sur sa
 * propre ligne, la recopie vers le bas l'ignore (`optionExiste`), et l'API
 * refuse une catégorie archivée à toute affiche qui n'y est pas déjà.
 */
function categorieArchiveeDe(id: number | null) {
  if (id === null || categoriesOuvertes.has(id)) return null;
  const connue = toutesCategories.get(id);
  return {
    id,
    // Nom inconnu si /admin/product-categories n'a pas répondu : l'option doit
    // exister quand même, c'est elle qui tient le rangement en place.
    label: connue ? `${connue.name} (archivée)` : `Catégorie n° ${id} (archivée)`,
    poids: connue?.defaultWeightGrams ?? null,
  };
}
const selection: ProduitAdmin[] =
  idsDemandes.length > 0
    ? // Ceinture et bretelles : l'écran ne montre que ce qui a été coché, même
      // si la réponse contenait autre chose.
      (liste?.produits ?? []).filter((p) => idsDemandes.includes(p.id))
    : (liste?.produits ?? []);
const produits = selection.slice(0, PLAFOND);

const listeCoupee = selection.length > PLAFOND;
/** Des produits cochés que l'API ne connaît plus. Sans réponse, on ne sait rien. */
const introuvables =
  liste !== null && idsDemandes.length > 0
    ? idsDemandes.length - selection.length
    : 0;

/**
 * Les collections que la grille sait nommer : celles où l'on peut ranger
 * (l'API en retire les archivées), plus les archivées où une affiche du lot
 * se trouve déjà — on doit pouvoir l'en sortir, pas l'y ranger.
 */
const nomsCollections: Record<string, { nom: string; archivee: boolean }> = {};
for (const c of liste?.collections ?? [])
  nomsCollections[String(c.id)] = { nom: c.name, archivee: false };
for (const p of produits)
  for (const c of p.collections)
    if (!nomsCollections[String(c.id)])
      nomsCollections[String(c.id)] = { nom: c.name, archivee: !!c.archivee };
const collectionsOuvertes = liste?.collections ?? [];
const collectionsArchiveesDuLot = Object.entries(nomsCollections)
  .filter(([, c]) => c.archivee)
  .map(([id, c]) => ({ id: Number(id), name: c.nom }));

/**
 * Une colonne de prix par format présent dans la sélection, dans l'ordre du
 * catalogue. Un produit qui n'a pas le format laisse la case vide : il n'y a
 * rien à y écrire.
 */
const formatsPresents = [
  ...new Set([
    ...(liste?.formats ?? []).filter((f) =>
      produits.some((p) => p.formats.includes(f)),
    ),
    ...produits.flatMap((p) => p.formats),
  ]),
];
/** Le prix de repli ne concerne que les produits sans aucun format. */
const afficherRepli = produits.some((p) => p.formats.length === 0);
const nbColonnes = 10 + formatsPresents.length + (afficherRepli ? 1 : 0);
const largeurTable = 122 + 7 * (formatsPresents.length + (afficherRepli ? 1 : 0));

/**
 * Le prix actuel d'un format, pour le montrer dans sa case — comme Shopify
 * montre celui de chaque variante. L'API le donne format par format
 * (`prixParFormat`) ; il n'y manque que quand deux variantes d'un même format
 * n'ont pas le même prix, et la case reste alors vide, parce qu'y écrire l'un
 * des deux ferait passer un repère pour LE prix. Une API d'avant ce champ :
 * on ne le déduit que lorsque tous les formats sont au même prix.
 *
 * C'est aussi la valeur de départ (`data-initial`) : une case laissée à son
 * prix n'envoie rien.
 */
function prixDuFormat(p: ProduitAdmin, format: string): number | null {
  const connu = p.prixParFormat?.[format];
  if (typeof connu === "number") return connu;
  if (p.prixParFormat && format in p.prixParFormat) return null;
  if (p.prixMin === null || p.prixMax === null) return null;
  return p.prixMin === p.prixMax ? p.prixMin : null;
}
/** Un produit dont au moins un format n'a pas de prix à montrer. */
function prixIncertain(p: ProduitAdmin): boolean {
  return p.formats.some((f) => prixDuFormat(p, f) === null);
}
const prixParFormatIncertain = produits.some(prixIncertain);

/** Ce que l'API a refusé reste affiché tel quel : ces lectures s'en chargent. */
function texteSaisi(
  saisie: Record<string, unknown> | undefined,
  cle: string,
  defaut: string,
): string {
  const v = saisie?.[cle];
  return typeof v === "string" ? v : defaut;
}
function nombreSaisi(
  saisie: Record<string, unknown> | undefined,
  cle: string,
  defaut: number | null,
): number | null {
  if (!saisie || !(cle in saisie)) return defaut;
  const v = saisie[cle];
  if (v === null) return null;
  return typeof v === "number" && Number.isFinite(v) ? v : defaut;
}
function boolSaisi(
  saisie: Record<string, unknown> | undefined,
  cle: string,
  defaut: boolean,
): boolean {
  const v = saisie?.[cle];
  return typeof v === "boolean" ? v : defaut;
}
function prixSaisi(
  saisie: Record<string, unknown> | undefined,
  format: string,
  defaut: number | null,
): number | null {
  const brut = saisie?.prix;
  if (typeof brut !== "object" || brut === null) return defaut;
  const v = (brut as Record<string, unknown>)[format];
  return typeof v === "number" && Number.isFinite(v) ? v : defaut;
}
/** Le texte ou l'absence de texte saisis, sinon la valeur de départ. */
function texteOuNulSaisi(
  saisie: Record<string, unknown> | undefined,
  cle: string,
  defaut: string | null,
): string | null {
  if (!saisie || !(cle in saisie)) return defaut;
  const v = saisie[cle];
  return typeof v === "string" ? v : v === null ? null : defaut;
}
/** Les collections telles que la ligne les montrera, saisie comprise. */
function collectionsSaisies(
  p: ProduitAdmin,
  saisie: Record<string, unknown> | undefined,
): number[] {
  const depart = p.collections.map((c) => c.id);
  const c = saisie?.collections as { mode?: string; ids?: number[] } | undefined;
  if (!c || !Array.isArray(c.ids)) return depart;
  if (c.mode === "remplacer") return c.ids;
  if (c.mode === "ajouter") return [...new Set([...depart, ...c.ids])];
  return depart.filter((id) => !c.ids!.includes(id));
}
/** La forme comparable d'une liste de collections : triée, séparée par des virgules. */
const listeTriee = (ids: number[]) => [...ids].sort((a, b) => a - b).join(",");

/** Ce qu'elle avait tapé, en toutes lettres, pour une ligne qui a disparu du tableau. */
function resumeSaisie(saisie: Record<string, unknown> | undefined): string {
  if (!saisie) return "";
  const bouts: string[] = [];
  if (typeof saisie.name === "string") bouts.push(`nom : « ${saisie.name} »`);
  if (typeof saisie.slug === "string")
    bouts.push(`identifiant : ${saisie.slug}`);
  if (saisie.slugDepuisNom === true) bouts.push("identifiant refait depuis le nom");
  if (typeof saisie.status === "string")
    bouts.push(`statut : ${libelleStatut(saisie.status)}`);
  const prix = saisie.prix;
  if (typeof prix === "object" && prix !== null)
    for (const [format, v] of Object.entries(prix as Record<string, unknown>))
      if (typeof v === "number") bouts.push(`prix ${format} : ${euros(v)} €`);
  if (typeof saisie.basePriceCents === "number")
    bouts.push(`prix de repli : ${euros(saisie.basePriceCents)} €`);
  if ("categoryId" in saisie) {
    const id = saisie.categoryId;
    const nom =
      typeof id === "number"
        ? (toutesCategories.get(id)?.name ?? `n° ${id}`)
        : "aucune";
    bouts.push(`catégorie : ${nom}`);
  }
  if ("weightGrams" in saisie) {
    const g = saisie.weightGrams;
    bouts.push(`poids : ${typeof g === "number" ? `${g} g` : "case vide"}`);
  }
  if (typeof saisie.aiEnabled === "boolean")
    bouts.push(`affiche IA : ${saisie.aiEnabled ? "oui" : "non"}`);
  if ("description" in saisie)
    bouts.push(`description : « ${extrait(String(saisie.description ?? "")) || "vide"} »`);
  if ("defaultView" in saisie) {
    const v = saisie.defaultView;
    bouts.push(`type d'affiche : ${typeof v === "string" ? (nomVue.get(v) ?? v) : "par défaut"}`);
  }
  const c = saisie.collections as { mode?: string; ids?: number[] } | undefined;
  if (c && Array.isArray(c.ids))
    bouts.push(
      `collections : ${c.ids.map((id) => nomsCollections[String(id)]?.nom ?? `n° ${id}`).join(", ") || "aucune"}`,
    );
  return bouts.join(" ; ");
}

/**
 * Un refus qui porte sur un produit absent du tableau : effacé entre-temps,
 * ou hors de la page. Le dire ici est la seule façon qu'il soit lu, et de
 * tenir la promesse « vos valeurs sont toujours là ».
 */
const idsAffiches = new Set(produits.map((p) => p.id));
const refusHorsTableau = [...messagesErreur.entries()]
  .filter(([id]) => !idsAffiches.has(id))
  .map(([id, message]) => ({
    id,
    message,
    resume: resumeSaisie(valeursSaisies.get(id)),
  }));

/** Les refus de la vérification, nommés, pour les relire dans l'aperçu. */
const nomDuProduit = new Map(produits.map((p) => [p.id, p.name]));
const refusDeLApercu = apercu
  ? [...messagesErreur.entries()].map(([id, message]) => ({
      nom: nomDuProduit.get(id) ?? `Produit n° ${id}`,
      message,
    }))
  : [];

/** Bordures posées cellule par cellule : la grille est en `border-separate` pour que l'en-tête collant garde les siennes. */
const cellule = "border-t border-bo-border px-2 py-2 align-top";
const enTete =
  "sticky top-0 z-20 border-b border-bo-border bg-bo-bg px-2 py-2 text-left font-medium";
/** La ligne « Appliquer à tout », sous les en-têtes : pas collante, elle. */
const caseAppliquer = "border-b border-bo-border bg-bo-bg px-2 py-2 text-left align-top font-normal";
const champ =
  "w-full rounded border border-bo-border px-2 py-1 text-sm bg-transparent";
const bouton =
  "rounded border border-bo-border px-1 text-xs leading-4 text-bo-muted hover:bg-bo-surface";
const boutonAppliquer =
  "mt-1 rounded border border-bo-border px-2 py-0.5 text-xs text-bo-ink hover:border-bo-accent hover:text-bo-accent";
const soucisChamp = "mt-0.5 block text-xs text-red-600";
const inerte = "block text-xs text-bo-muted";
const puce = "inline-block rounded-full bg-bo-bg px-2 py-0.5 text-xs";
---

<Admin title="Modifier plusieurs produits">
  <p class="mb-4">
    <a href={url("/produits")} class="text-sm text-bo-accent hover:underline">
      ← Retour à la liste
    </a>
  </p>

  {flash && (
    <p
      class={`mb-4 text-sm rounded px-3 py-2 border ${
        flashTon === "erreur"
          ? "bg-red-50 border-red-200"
          : flashTon === "avertissement"
            ? "bg-amber-50 border-amber-200"
            : "bg-green-50 border-green-200"
      }`}
    >
      {flash}
    </p>
  )}
  {error && <p class="mb-4 text-red-600 text-sm">API injoignable : {error}</p>}

  {/* ====== Vérifier les changements : avant / après ====== */}
  {apercu && (
    <section
      id="apercu"
      class="mb-6 rounded-lg border-2 border-bo-accent bg-bo-surface"
      aria-labelledby="titre-apercu"
    >
      <header class="border-b border-bo-border px-4 py-3">
        <h2 id="titre-apercu" class="font-semibold" tabindex="-1">
          Ce qui va changer — rien n'est encore enregistré
        </h2>
        <p class="text-xs text-bo-muted">
          Une ligne par champ modifié : sa valeur actuelle, puis celle qui sera
          enregistrée. La grille, plus bas, garde vos valeurs : vous pouvez
          encore y corriger quelque chose, puis vérifier de nouveau.
        </p>
      </header>

      {apercu.length === 0 ? (
        <p class="px-4 py-4 text-sm text-bo-muted">
          Aucune affiche ne changerait : ce qui a été tapé revient à ce que la
          boutique enregistre déjà, ou toutes les lignes sont refusées.
        </p>
      ) : (
        <div class="max-h-[50vh] overflow-auto">
          <table class="w-full text-sm">
            <caption class="sr-only">Changements prévus, affiche par affiche</caption>
            <thead class="bg-bo-bg text-left text-bo-muted">
              <tr>
                <th scope="col" class="px-3 py-2 font-medium">Affiche</th>
                <th scope="col" class="px-3 py-2 font-medium">Champ</th>
                <th scope="col" class="px-3 py-2 font-medium">Avant</th>
                <th scope="col" class="px-3 py-2 font-medium">Après</th>
              </tr>
            </thead>
            <tbody>
              {apercu.map((l) =>
                l.changements.map((ch, i) => (
                  <tr class={i === 0 ? "border-t-2 border-bo-border" : "border-t border-bo-border"}>
                    {i === 0 && (
                      <th
                        scope="rowgroup"
                        rowspan={l.changements.length}
                        class="px-3 py-1.5 text-left align-top font-medium"
                      >
                        {l.nom}
                      </th>
                    )}
                    <td class="px-3 py-1.5 text-bo-muted">{ch.champ}</td>
                    <td class="px-3 py-1.5 text-bo-muted line-through decoration-bo-muted/60">
                      {ch.avant}
                    </td>
                    <td class="px-3 py-1.5 font-medium">{ch.apres}</td>
                  </tr>
                )),
              )}
            </tbody>
          </table>
        </div>
      )}

      {redirectionsPrevues > 0 && (
        <div class="border-t border-bo-border px-4 py-3 text-sm">
          <p class="font-medium">
            {redirectionsPrevues} redirection{redirectionsPrevues > 1 ? "s" : ""} 301
            {" "}prévue{redirectionsPrevues > 1 ? "s" : ""}
          </p>
          <p class="mb-1 text-xs text-bo-muted">
            L'ancienne adresse de chaque affiche renommée mènera à la nouvelle :
            les liens déjà partagés, les favoris et Google continueront de
            fonctionner.
          </p>
          <ul class="list-disc pl-5 font-mono text-xs">
            {apercu
              .filter((l) => l.redirection)
              .map((l) => (
                <li>{l.redirection!.de} → {l.redirection!.vers}</li>
              ))}
          </ul>
        </div>
      )}

      {refusDeLApercu.length > 0 && (
        <div class="border-t border-bo-border bg-red-50 px-4 py-3 text-sm">
          <p class="font-medium">
            {refusDeLApercu.length > 1
              ? `${refusDeLApercu.length} lignes refusées : elles ne seront pas enregistrées.`
              : "Une ligne refusée : elle ne sera pas enregistrée."}
          </p>
          <ul class="list-disc pl-5">
            {refusDeLApercu.map((r) => (
              <li>{r.nom} : {r.message}</li>
            ))}
          </ul>
        </div>
      )}

      <form
        method="POST"
        id="form-apercu"
        class="flex flex-wrap items-center gap-3 border-t border-bo-border px-4 py-3"
      >
        <input type="hidden" name="_action" value="enregistrer" />
        <input type="hidden" name="modifications" value={chargeVerifiee} />
        <button
          id="enregistrer-apercu"
          class="rounded bg-bo-accent px-4 py-2 text-sm text-white disabled:opacity-40"
          disabled={apercu.length === 0}
        >
          Enregistrer ces changements
          {apercu.length > 0 && ` (${apercu.length} affiche${apercu.length > 1 ? "s" : ""})`}
        </button>
        <a href="#grille" class="text-sm text-bo-accent hover:underline">
          Corriger encore dans la grille
        </a>
        <p id="apercu-perime" class="basis-full text-sm text-amber-800" role="status" hidden>
          La grille a changé depuis cette vérification : cliquez de nouveau
          « Vérifier les changements », en bas de la page, avant d'enregistrer.
        </p>
      </form>
    </section>
  )}

  {refusHorsTableau.length > 0 && (
    <div class="mb-4 rounded border border-red-200 bg-red-50 px-3 py-2 text-sm">
      <p class="font-medium">
        {refusHorsTableau.length > 1
          ? "Ces produits n'ont pas pu être enregistrés et ne sont plus dans le tableau ci-dessous."
          : "Ce produit n'a pas pu être enregistré et n'est plus dans le tableau ci-dessous."}
      </p>
      <ul class="mt-1 list-disc pl-5">
        {refusHorsTableau.map((r) => (
          <li>
            Produit n° {r.id} : {r.message}
            {r.resume && (
              <span class="block text-bo-muted">
                Ce que vous aviez tapé : {r.resume}
              </span>
            )}
          </li>
        ))}
      </ul>
    </div>
  )}

  <p class="mb-4 max-w-3xl text-sm text-bo-muted">
    Une ligne par produit, une colonne par réglage, comme dans un tableur. La
    ligne <strong>Appliquer à tout</strong>, sous les titres, pose une valeur
    sur toute une colonne. Rien ne part avant <strong>Vérifier les
    changements</strong>, qui montre l'avant et l'après de chaque affiche ;
    c'est de là qu'on enregistre. Seules les lignes que vous avez touchées sont
    envoyées.
    {formatsPresents.length > 0 && (
      <>
        {" "}Le prix se règle format par format : la colonne{" "}
        <strong>Prix {formatsPresents[0]}</strong> ne change que le prix des{" "}
        {formatsPresents[0]}, et un produit qui n'a pas ce format n'a rien à y
        saisir.
      </>
    )}
  </p>

  {prixParFormatIncertain && (
    <p class="mb-4 max-w-3xl rounded border border-amber-200 bg-amber-50 px-3 py-2 text-sm">
      Quand plusieurs variantes d'un même format n'ont pas le même prix, sa
      case reste vide : afficher l'un des deux reviendrait à vous le faire
      enregistrer pour tous. Tapez un prix pour changer ce format, laissez la
      case vide pour ne pas y toucher. La fourchette actuelle du produit est
      rappelée sous son nom.
    </p>
  )}

  {listeCoupee && (
    <p class="mb-4 rounded border border-amber-200 bg-amber-50 px-3 py-2 text-sm">
      {idsDemandes.length > 0
        ? `Vous avez sélectionné ${selection.length} produits ; cette page en modifie ${PLAFOND} à la fois. Enregistrez ces ${PLAFOND}, puis revenez cocher les suivants.`
        : `Cette page modifie ${PLAFOND} produits à la fois au maximum. Affinez votre recherche dans la liste des produits, ou faites le travail en deux fois.`}
    </p>
  )}
  {introuvables > 0 && (
    <p class="mb-4 rounded border border-amber-200 bg-amber-50 px-3 py-2 text-sm">
      {introuvables > 1
        ? `${introuvables} produits de votre sélection n'existent plus et n'apparaissent donc pas ci-dessous.`
        : "Un produit de votre sélection n'existe plus et n'apparaît donc pas ci-dessous."}
    </p>
  )}

  {produits.length === 0 && !error && (
    <p class="rounded-lg border border-bo-border bg-bo-surface px-4 py-6 text-sm text-bo-muted">
      Aucun produit à modifier ici. Repassez par la
      <a class="text-bo-accent underline" href={url("/produits")}> liste des produits</a>
      {" "}pour choisir ceux que vous voulez retoucher.
    </p>
  )}

  {/* Les noms des collections, pour les puces que le script redessine. */}
  <script
    is:inline
    type="application/json"
    id="noms-collections"
    set:html={JSON.stringify(nomsCollections).replace(/</g, "\\u003c")}
  />

  {produits.length > 0 && (
    <form
      method="POST"
      id="grille"
      autocomplete="off"
      novalidate
      data-poids-connus={poidsCategoriesConnus ? "1" : "0"}
    >
      {/* `novalidate` : la vérification du navigateur bloquait l'envoi sans
          que la page le sache, avec une bulle sur un champ souvent hors du
          cadre défilant. Une seule voix décide de ce qui part, celle d'ici. */}
      <input type="hidden" name="_action" value="verifier" />
      <input type="hidden" name="modifications" id="charge-modifications" />

      {/* La grille défile dans son propre cadre : c'est ce qui permet à la
          ligne d'en-tête de rester visible, avec ses boutons, et à la colonne
          du produit de ne pas disparaître vers la gauche. */}
      <div class="max-h-[70vh] overflow-auto rounded-lg border border-bo-border bg-bo-surface">
        {/* `data-sans-tri` : la grille a ses propres outils de colonne. Sans
            lui, le tri commun (lib/tri-tableaux.ts) prenait la DERNIÈRE ligne
            de l'en-tête — celle des « Appliquer à tout » — pour les titres, et
            annonçait triables douze colonnes qui ne trient rien. */}
        <table
          class="w-full border-separate border-spacing-0 text-sm"
          style={`min-width:${largeurTable}rem`}
          data-sans-tri
        >
          <thead class="text-bo-muted">
            <tr>
              <th class={`${enTete} sticky left-0 z-30 w-64`}>Produit</th>
              <th class={`${enTete} w-56`}>Nom</th>
              <th class={`${enTete} w-48`}>
                <span
                  class="flex items-center gap-1"
                  title="L'identifiant est ce qui apparaît dans l'adresse de la page du produit sur la boutique."
                >
                  Identifiant
                  <button
                    type="button"
                    data-annuler="slug"
                    data-libelle="Identifiant"
                    class={bouton}
                    title="Remettre la colonne Identifiant comme elle était"
                    aria-label="Remettre la colonne Identifiant comme elle était"
                  >↺</button>
                </span>
              </th>
              <th class={`${enTete} w-36`}>
                <span class="flex items-center gap-1">
                  Statut
                  <button type="button" data-recopier="statut" data-libelle="Statut" class={bouton}
                    title="Recopier le statut de la première ligne sur toutes les autres"
                    aria-label="Recopier le statut de la première ligne sur toutes les autres">↓</button>
                  <button type="button" data-annuler="statut" data-libelle="Statut" class={bouton}
                    title="Remettre la colonne Statut comme elle était"
                    aria-label="Remettre la colonne Statut comme elle était">↺</button>
                </span>
              </th>

              {formatsPresents.map((format) => (
                <th class={`${enTete} w-28`}>
                  <span
                    class="flex items-center gap-1"
                    title={`Prix payé au panier pour un ${format}. Une case vide ne change rien.`}
                  >
                    Prix {format} (€)
                    <button type="button" data-recopier={`prix:${format}`} data-libelle={`Prix ${format}`} class={bouton}
                      title={`Recopier le prix ${format} de la première ligne sur toutes les autres`}
                      aria-label={`Recopier le prix ${format} de la première ligne sur toutes les autres`}>↓</button>
                    <button type="button" data-annuler={`prix:${format}`} data-libelle={`Prix ${format}`} class={bouton}
                      title={`Remettre la colonne Prix ${format} comme elle était`}
                      aria-label={`Remettre la colonne Prix ${format} comme elle était`}>↺</button>
                  </span>
                </th>
              ))}

              {afficherRepli && (
                <th class={`${enTete} w-28`}>
                  <span
                    class="flex items-center gap-1"
                    title="Ce prix ne sert qu'aux produits qui n'ont aucun format. Dès qu'un produit a des formats, c'est le prix du format qui est payé au panier."
                  >
                    Prix de repli (€)
                    <button type="button" data-recopier="repli" data-libelle="Prix de repli" class={bouton}
                      title="Recopier le prix de repli de la première ligne sur toutes les autres"
                      aria-label="Recopier le prix de repli de la première ligne sur toutes les autres">↓</button>
                    <button type="button" data-annuler="repli" data-libelle="Prix de repli" class={bouton}
                      title="Remettre la colonne Prix de repli comme elle était"
                      aria-label="Remettre la colonne Prix de repli comme elle était">↺</button>
                  </span>
                </th>
              )}

              <th class={`${enTete} w-48`}>
                <span class="flex items-center gap-1">
                  Catégorie
                  <button type="button" data-recopier="categorie" data-libelle="Catégorie" class={bouton}
                    title="Recopier la catégorie de la première ligne sur toutes les autres"
                    aria-label="Recopier la catégorie de la première ligne sur toutes les autres">↓</button>
                  <button type="button" data-annuler="categorie" data-libelle="Catégorie" class={bouton}
                    title="Remettre la colonne Catégorie comme elle était"
                    aria-label="Remettre la colonne Catégorie comme elle était">↺</button>
                </span>
              </th>
              <th class={`${enTete} w-40`}>
                <span
                  class="flex items-center gap-1"
                  title="Laissez la case vide pour que le produit prenne le poids de la catégorie choisie sur sa ligne. Ce poids est rappelé sous la case."
                >
                  Poids (g)
                  <button type="button" data-recopier="poids" data-libelle="Poids" class={bouton}
                    title="Recopier le poids de la première ligne sur toutes les autres"
                    aria-label="Recopier le poids de la première ligne sur toutes les autres">↓</button>
                  <button type="button" data-annuler="poids" data-libelle="Poids" class={bouton}
                    title="Remettre la colonne Poids comme elle était"
                    aria-label="Remettre la colonne Poids comme elle était">↺</button>
                </span>
              </th>
              <th class={`${enTete} w-28 text-center`}>
                <span
                  class="flex items-center justify-center gap-1"
                  title="Le client peut faire dessiner cette affiche par l'ordinateur."
                >
                  Affiche IA
                  <button type="button" data-recopier="ia" data-libelle="Affiche IA" class={bouton}
                    title="Recopier le réglage de la première ligne sur toutes les autres"
                    aria-label="Recopier le réglage de la première ligne sur toutes les autres">↓</button>
                  <button type="button" data-annuler="ia" data-libelle="Affiche IA" class={bouton}
                    title="Remettre la colonne Affiche IA comme elle était"
                    aria-label="Remettre la colonne Affiche IA comme elle était">↺</button>
                </span>
              </th>
              <th class={`${enTete} w-40`}>
                <span
                  class="flex items-center gap-1"
                  title="Décide des personnages proposés au client et du décor posé au premier plan."
                >
                  Type d'affiche
                  <button type="button" data-recopier="vue" data-libelle="Type d'affiche" class={bouton}
                    title="Recopier le type d'affiche de la première ligne sur toutes les autres"
                    aria-label="Recopier le type d'affiche de la première ligne sur toutes les autres">↓</button>
                  <button type="button" data-annuler="vue" data-libelle="Type d'affiche" class={bouton}
                    title="Remettre la colonne Type d'affiche comme elle était"
                    aria-label="Remettre la colonne Type d'affiche comme elle était">↺</button>
                </span>
              </th>
              <th class={`${enTete} w-64`}>
                <span class="flex items-center gap-1">
                  Collections
                  <button type="button" data-recopier="collections" data-libelle="Collections" class={bouton}
                    title="Recopier les collections de la première ligne sur toutes les autres"
                    aria-label="Recopier les collections de la première ligne sur toutes les autres">↓</button>
                  <button type="button" data-annuler="collections" data-libelle="Collections" class={bouton}
                    title="Remettre la colonne Collections comme elle était"
                    aria-label="Remettre la colonne Collections comme elle était">↺</button>
                </span>
              </th>
              <th class={`${enTete} w-56`}>
                <span class="flex items-center gap-1">
                  Description
                  <button type="button" data-recopier="description" data-libelle="Description" class={bouton}
                    title="Recopier la description de la première ligne sur toutes les autres"
                    aria-label="Recopier la description de la première ligne sur toutes les autres">↓</button>
                  <button type="button" data-annuler="description" data-libelle="Description" class={bouton}
                    title="Remettre la colonne Description comme elle était"
                    aria-label="Remettre la colonne Description comme elle était">↺</button>
                </span>
              </th>
            </tr>

            {/* « Appliquer à tout », comme dans l'éditeur en masse de Shopify :
                une valeur, un bouton, et toute la colonne la prend — y compris
                les lignes hors de l'écran. Rien n'est enregistré avant la
                vérification, et ↺ annule toujours. */}
            <tr class="ml-appliquer-tout">
              <th class={`${caseAppliquer} sticky left-0 z-10`} scope="row">
                <span class="text-xs font-medium text-bo-muted">Appliquer à tout ↓</span>
              </th>
              <td class={caseAppliquer} data-appliquer="nom">
                <select class={`${champ} text-xs`} data-nom-mode aria-label="Comment changer le nom de toutes les lignes">
                  <option value="remplacer">Remplacer par</option>
                  <option value="debut">Ajouter au début</option>
                  <option value="fin">Ajouter à la fin</option>
                  <option value="rechercher">Rechercher et remplacer</option>
                </select>
                <input class={`${champ} mt-1`} data-nom-texte aria-label="Texte pour le nom de toutes les lignes" placeholder="Texte" />
                <input class={`${champ} mt-1`} data-nom-par aria-label="Remplacer par" placeholder="Remplacer par" hidden />
                <button type="button" class={boutonAppliquer} data-appliquer-bouton="nom">Appliquer</button>
              </td>
              <td class={caseAppliquer} data-appliquer="slug">
                <button type="button" class={boutonAppliquer} data-appliquer-bouton="slug">
                  Refaire depuis le nom
                </button>
                <span class="mt-1 block text-[11px] leading-tight text-bo-muted">
                  Une redirection 301 sera posée pour chaque adresse changée.
                </span>
              </td>
              <td class={caseAppliquer} data-appliquer="statut">
                <select class={champ} data-modele aria-label="Statut à appliquer à toutes les lignes">
                  {STATUTS.map((s) => <option value={s.valeur}>{s.libelle}</option>)}
                </select>
                <button type="button" class={boutonAppliquer} data-appliquer-bouton="statut" data-libelle="Statut">Appliquer</button>
              </td>
              {formatsPresents.map((format) => (
                <td class={caseAppliquer} data-appliquer={`prix:${format}`}>
                  <input type="text" inputmode="decimal" class={`${champ} text-right`} data-modele
                    aria-label={`Prix ${format} à appliquer à toutes les lignes, en euros`} />
                  <button type="button" class={boutonAppliquer} data-appliquer-bouton={`prix:${format}`} data-libelle={`Prix ${format}`}>Appliquer</button>
                </td>
              ))}
              {afficherRepli && (
                <td class={caseAppliquer} data-appliquer="repli">
                  <input type="text" inputmode="decimal" class={`${champ} text-right`} data-modele
                    aria-label="Prix de repli à appliquer à toutes les lignes, en euros" />
                  <button type="button" class={boutonAppliquer} data-appliquer-bouton="repli" data-libelle="Prix de repli">Appliquer</button>
                </td>
              )}
              <td class={caseAppliquer} data-appliquer="categorie">
                {categories.length === 0 ? (
                  <span class="block text-[11px] leading-tight text-bo-muted">
                    Aucune catégorie créée pour l'instant. Elles se créent dans
                    <a class="text-bo-accent underline" href={url("/categories-produits")}>Catégories de produits</a>.
                  </span>
                ) : (
                  <>
                    <select class={champ} data-modele aria-label="Catégorie à appliquer à toutes les lignes">
                      <option value="">Aucune</option>
                      {categories.map((c) => <option value={c.id}>{c.name}</option>)}
                    </select>
                    <button type="button" class={boutonAppliquer} data-appliquer-bouton="categorie" data-libelle="Catégorie">Appliquer</button>
                  </>
                )}
              </td>
              <td class={caseAppliquer} data-appliquer="poids">
                <input type="text" inputmode="numeric" class={`${champ} text-right`} data-modele
                  aria-label="Poids à appliquer à toutes les lignes, en grammes (vide : celui de la catégorie)" />
                <button type="button" class={boutonAppliquer} data-appliquer-bouton="poids" data-libelle="Poids">Appliquer</button>
              </td>
              <td class={`${caseAppliquer} text-center`} data-appliquer="ia">
                <input type="checkbox" class="mt-1" data-modele aria-label="Affiche IA pour toutes les lignes" />
                <button type="button" class={`${boutonAppliquer} block w-full`} data-appliquer-bouton="ia" data-libelle="Affiche IA">Appliquer</button>
              </td>
              <td class={caseAppliquer} data-appliquer="vue">
                <select class={champ} data-modele aria-label="Type d'affiche à appliquer à toutes les lignes">
                  <option value="">Par défaut</option>
                  {vuesOuvertes.map((v) => <option value={v.slug}>{v.name}</option>)}
                </select>
                <button type="button" class={boutonAppliquer} data-appliquer-bouton="vue" data-libelle="Type d'affiche">Appliquer</button>
              </td>
              <td class={caseAppliquer} data-appliquer="collections">
                <select class={`${champ} text-xs`} data-collections-mode aria-label="Comment changer les collections de toutes les lignes">
                  <option value="ajouter">Ajouter à…</option>
                  <option value="retirer">Retirer de…</option>
                  <option value="remplacer">Remplacer par…</option>
                </select>
                <button type="button" class={boutonAppliquer} data-appliquer-bouton="collections">
                  Choisir les collections…
                </button>
              </td>
              <td class={caseAppliquer} data-appliquer="description">
                <button type="button" class={boutonAppliquer} data-appliquer-bouton="description">
                  Remplacer par…
                </button>
              </td>
            </tr>
          </thead>
          <tbody>
            {produits.map((p) => {
              const saisie = valeursSaisies.get(p.id);
              const erreur = messagesErreur.get(p.id);
              const nom = texteSaisi(saisie, "name", p.name);
              const depuisNom = saisie?.slugDepuisNom === true && !("slug" in (saisie ?? {}));
              const slug = depuisNom ? slugifier(nom) : texteSaisi(saisie, "slug", p.slug);
              const statut = texteSaisi(saisie, "status", p.status);
              const repliCents =
                nombreSaisi(saisie, "basePriceCents", p.basePriceCents) ??
                p.basePriceCents;
              const categorieId = nombreSaisi(saisie, "categoryId", p.categoryId);
              // Le rangement de CETTE affiche, si sa catégorie vient d'être
              // archivée : la liste ne le propose plus, l'option ci-dessous le
              // garde. Calculé sur `p.categoryId` et non sur le choix en
              // cours, parce que c'est lui que porte `data-initial` — et que
              // le bouton « remettre comme avant » y revient.
              const sienneArchivee = categorieArchiveeDe(p.categoryId);
              const poids = nombreSaisi(saisie, "weightGrams", p.weightGrams);
              const ia = boolSaisi(saisie, "aiEnabled", p.aiEnabled);
              const statutInconnu = !STATUTS.some((s) => s.valeur === p.status);
              // Une case de prix vide sur cette ligne : la fourchette se
              // rappelle alors sous le nom.
              const prixManquant = prixIncertain(p);
              const vueDepart = p.defaultView ?? null;
              const vue = texteOuNulSaisi(saisie, "defaultView", vueDepart);
              // Même règle que la catégorie : un type archivé reste sur SA
              // ligne, sans quoi la ligne se dirait modifiée d'elle-même.
              const vueArchivee =
                vueDepart && !vuesOuvertes.some((v) => v.slug === vueDepart)
                  ? vueDepart
                  : null;
              const descriptionDepart = (p.description ?? "").trim();
              const description = texteOuNulSaisi(saisie, "description", descriptionDepart) ?? "";
              const collectionsDepart = listeTriee(p.collections.map((c) => c.id));
              const collectionsLigne = listeTriee(collectionsSaisies(p, saisie));
              return (
                <>
                  <tr data-ligne data-id={p.id} data-nom={p.name}>
                    <td class={`${cellule} sticky left-0 z-10 bg-bo-surface`}>
                      <span class="flex items-start gap-2">
                        {p.imageUrl ? (
                          <img
                            src={imgSrc(p.imageUrl)}
                            alt=""
                            class="h-10 w-10 shrink-0 rounded border border-bo-border object-cover"
                            loading="lazy"
                          />
                        ) : (
                          <span class="h-10 w-10 shrink-0 rounded border border-bo-border bg-bo-bg" />
                        )}
                        <span class="min-w-0">
                          <a
                            href={url(`/produits/${p.id}`)}
                            class="block truncate text-bo-accent hover:underline"
                            title={`Ouvrir la fiche de ${p.name}`}
                          >
                            {p.name}
                          </a>
                          <span class="block text-xs text-bo-muted">
                            {p.formats.length > 0
                              ? p.formats.join(", ")
                              : "aucun format"}
                            {p.formats.length > 0 &&
                              prixManquant &&
                              p.prixMin !== null &&
                              p.prixMax !== null && (
                                <span class="block">
                                  de {formatPrice(p.prixMin)} à{" "}
                                  {formatPrice(p.prixMax)}
                                </span>
                              )}
                            <span data-modifie class="ml-1 text-bo-accent" hidden>
                              · modifié
                            </span>
                            <span data-bloquee class="ml-1 text-red-600" hidden>
                              · à corriger
                            </span>
                          </span>
                        </span>
                      </span>
                    </td>

                    <td class={cellule}>
                      {/* La comparaison se fait sur la valeur nettoyée : garder
                          l'espace en trop de la base ferait compter la ligne
                          comme modifiée avant que personne n'y touche. */}
                      <input
                        data-champ="nom"
                        data-colonne="nom"
                        data-initial={p.name.trim()}
                        value={nom}
                        class={champ}
                        aria-label={`Nom de ${p.name}`}
                      />
                      <span data-souci class={soucisChamp} hidden></span>
                    </td>

                    <td class={cellule}>
                      {/* `data-depuis-nom` : l'adresse suit le nom de la ligne,
                          et l'API la rend unique (-2, -3…) au lieu de la
                          refuser. Tapée à la main, elle redevient libre. */}
                      <input
                        data-champ="slug"
                        data-colonne="slug"
                        data-initial={p.slug.trim()}
                        data-depuis-nom={depuisNom ? "1" : undefined}
                        value={slug}
                        class={`${champ} font-mono text-xs`}
                        aria-label={`Identifiant de ${p.name}`}
                      />
                      <span data-souci class={soucisChamp} hidden></span>
                    </td>

                    <td class={cellule}>
                      <select
                        data-champ="statut"
                        data-colonne="statut"
                        data-initial={p.status}
                        class={champ}
                        aria-label={`Statut de ${p.name}`}
                      >
                        {STATUTS.map((s) => (
                          <option value={s.valeur} selected={s.valeur === statut}>
                            {s.libelle}
                          </option>
                        ))}
                        {/* Un statut venu de l'API que la liste ne connaît pas
                            resterait sélectionné à tort sur « Actif ». */}
                        {statutInconnu && (
                          <option value={p.status} selected={p.status === statut}>
                            {p.status}
                          </option>
                        )}
                      </select>
                      <span data-souci class={soucisChamp} hidden></span>
                    </td>

                    {formatsPresents.map((format) => {
                      const prixConnu = prixDuFormat(p, format);
                      const affiche = prixSaisi(saisie, format, prixConnu);
                      return (
                        <td class={cellule}>
                          {p.formats.includes(format) ? (
                            <>
                              {/* `type="text"` et non `number` : un navigateur
                                  rend une case vide dès que la saisie n'est pas
                                  un nombre, si bien qu'une faute de frappe
                                  passerait pour un champ effacé. Il faut voir
                                  ce qui a été tapé pour pouvoir le refuser. */}
                              <input
                                type="text"
                                inputmode="decimal"
                                data-champ="prix"
                                data-colonne={`prix:${format}`}
                                data-format={format}
                                data-initial={
                                  prixConnu === null ? "" : String(prixConnu)
                                }
                                value={affiche === null ? "" : euros(affiche)}
                                class={`${champ} text-right`}
                                aria-label={`Prix ${format} de ${p.name}, en euros`}
                              />
                              <span data-souci class={soucisChamp} hidden></span>
                            </>
                          ) : (
                            <span class={inerte}>sans ce format</span>
                          )}
                        </td>
                      );
                    })}

                    {afficherRepli && (
                      <td class={cellule}>
                        {p.formats.length === 0 ? (
                          <>
                            <input
                              type="text"
                              inputmode="decimal"
                              data-champ="prix"
                              data-colonne="repli"
                              data-initial={String(p.basePriceCents)}
                              value={euros(repliCents)}
                              class={`${champ} text-right`}
                              aria-label={`Prix de ${p.name}, en euros`}
                            />
                            <span data-souci class={soucisChamp} hidden></span>
                          </>
                        ) : (
                          <span class={inerte}>suit les formats</span>
                        )}
                      </td>
                    )}

                    <td class={cellule}>
                      <select
                        data-champ="categorie"
                        data-colonne="categorie"
                        data-initial={p.categoryId === null ? "" : String(p.categoryId)}
                        class={champ}
                        aria-label={`Catégorie de ${p.name}`}
                      >
                        <option value="" selected={categorieId === null}>
                          Aucune
                        </option>
                        {/* Le poids par défaut voyage avec l'option : c'est lui
                            que la ligne annoncera si la case du poids reste
                            vide, sans avoir à redemander quoi que ce soit. */}
                        {categories.map((c) => (
                          <option
                            value={c.id}
                            selected={c.id === categorieId}
                            data-poids={String(
                              toutesCategories.get(c.id)?.defaultWeightGrams ?? "",
                            )}
                          >
                            {c.name}
                          </option>
                        ))}
                        {sienneArchivee && (
                          <option
                            value={sienneArchivee.id}
                            selected={sienneArchivee.id === categorieId}
                            data-poids={String(sienneArchivee.poids ?? "")}
                          >
                            {sienneArchivee.label}
                          </option>
                        )}
                      </select>
                      <span data-souci class={soucisChamp} hidden></span>
                    </td>

                    <td class={cellule}>
                      <input
                        type="text"
                        inputmode="numeric"
                        data-champ="poids"
                        data-colonne="poids"
                        data-initial={p.weightGrams === null ? "" : String(p.weightGrams)}
                        value={poids === null ? "" : String(poids)}
                        class={`${champ} text-right`}
                        aria-label={`Poids de ${p.name}, en grammes`}
                      />
                      <span data-souci class={soucisChamp} hidden></span>
                      {/* Rempli par le navigateur : ce qui est annoncé ici doit
                          suivre la catégorie choisie sur CETTE ligne, pas celle
                          qui était enregistrée en ouvrant la page. */}
                      <span data-heritage class={inerte} hidden></span>
                    </td>

                    <td class={`${cellule} text-center`}>
                      <input
                        type="checkbox"
                        data-champ="ia"
                        data-colonne="ia"
                        data-initial={p.aiEnabled ? "1" : "0"}
                        checked={ia}
                        class="mt-1"
                        aria-label={`Affiche IA pour ${p.name}`}
                      />
                    </td>

                    <td class={cellule}>
                      <select
                        data-champ="vue"
                        data-colonne="vue"
                        data-initial={vueDepart ?? ""}
                        class={champ}
                        aria-label={`Type d'affiche de ${p.name}`}
                      >
                        <option value="" selected={vue === null}>Par défaut</option>
                        {vuesOuvertes.map((v) => (
                          <option value={v.slug} selected={v.slug === vue}>{v.name}</option>
                        ))}
                        {vueArchivee && (
                          <option value={vueArchivee} selected={vueArchivee === vue}>
                            {nomVue.get(vueArchivee) ?? vueArchivee} (archivé)
                          </option>
                        )}
                      </select>
                      <span data-souci class={soucisChamp} hidden></span>
                    </td>

                    <td class={cellule}>
                      {/* La liste vit dans un champ caché, triée : c'est elle
                          qu'on compare à celle de départ. Les puces se
                          redessinent à chaque changement. */}
                      <input
                        type="hidden"
                        data-champ="collections"
                        data-colonne="collections"
                        data-initial={collectionsDepart}
                        value={collectionsLigne}
                      />
                      <span data-puces class="flex flex-wrap gap-1">
                        {collectionsLigne
                          ? collectionsLigne.split(",").map((id) => {
                              const c = nomsCollections[id];
                              return (
                                <span class={puce}>
                                  {c?.nom ?? `n° ${id}`}{c?.archivee ? " (archivée)" : ""}
                                </span>
                              );
                            })
                          : <span class="text-xs text-bo-muted">aucune</span>}
                      </span>
                      <button
                        type="button"
                        data-ouvrir-collections
                        class="mt-1 text-xs text-bo-accent hover:underline"
                        aria-label={`Modifier les collections de ${p.name}`}
                      >
                        Modifier
                      </button>
                    </td>

                    <td class={cellule}>
                      <input
                        type="hidden"
                        data-champ="description"
                        data-colonne="description"
                        data-initial={descriptionDepart}
                        value={description}
                      />
                      <span data-extrait class="block text-xs text-bo-muted">
                        {extrait(description) || "aucune"}
                      </span>
                      <button
                        type="button"
                        data-ouvrir-description
                        class="mt-1 text-xs text-bo-accent hover:underline"
                        aria-label={`Modifier la description de ${p.name}`}
                      >
                        Modifier
                      </button>
                    </td>
                  </tr>
                  {erreur && (
                    <tr>
                      <td colspan={nbColonnes} class="border-t border-bo-border bg-red-50 px-3 py-2 text-sm">
                        « {p.name} » n'a pas pu être enregistré : {erreur}
                      </td>
                    </tr>
                  )}
                </>
              );
            })}
          </tbody>
        </table>
      </div>

      {/* La barre suit le bas de l'écran : avec cent lignes, un bouton posé
          sous le tableau se retrouve à trois écrans de la valeur qu'on tape. */}
      <div class="sticky bottom-0 z-40 -mx-6 mt-4 border-t border-bo-border bg-bo-surface px-6 py-3">
        <div class="flex flex-wrap items-center gap-3">
          <span id="compteur" class="text-sm text-bo-muted">
            Aucune modification pour l'instant.
          </span>
          <span class="flex-1"></span>
          <button
            type="button"
            id="remettre"
            disabled
            class="rounded border border-bo-border px-3 py-1.5 text-sm hover:bg-bo-bg disabled:opacity-40"
          >
            Tout remettre comme avant
          </button>
          <button
            id="verifier"
            disabled
            class="rounded bg-bo-accent px-4 py-2 text-sm text-white disabled:opacity-40"
          >
            Vérifier les changements
          </button>
        </div>
        <p id="annonce" class="mt-2 text-sm text-bo-muted" aria-live="polite" hidden></p>
        <p id="problemes" class="mt-2 text-sm text-red-600" hidden></p>
      </div>
    </form>
  )}

  {/* ====== Fenêtre : les collections d'une ligne, ou de toutes ====== */}
  <dialog
    id="dlg-collections"
    class="w-[min(32rem,calc(100vw-2rem))] rounded-lg border border-bo-border bg-bo-surface p-0 text-bo-ink shadow-xl backdrop:bg-black/40"
    aria-labelledby="dlg-collections-titre"
  >
    <form method="dialog" class="flex max-h-[80vh] flex-col">
      <h2 id="dlg-collections-titre" class="border-b border-bo-border px-4 py-3 font-semibold">
        Collections
      </h2>
      <p data-dlg-aide class="px-4 pt-3 text-xs text-bo-muted"></p>
      <fieldset class="overflow-y-auto px-4 py-3">
        <legend class="sr-only">Collections</legend>
        {collectionsOuvertes.map((c) => (
          <label class="flex items-center gap-2 py-1 text-sm">
            <input type="checkbox" value={c.id} data-collection-case />
            <span>{c.name}</span>
          </label>
        ))}
        {collectionsArchiveesDuLot.map((c) => (
          <label class="flex items-center gap-2 py-1 text-sm text-bo-muted" data-archivee>
            <input type="checkbox" value={c.id} data-collection-case data-archivee />
            <span>{c.name} (archivée — on peut en sortir, pas y entrer)</span>
          </label>
        ))}
        {collectionsOuvertes.length === 0 && collectionsArchiveesDuLot.length === 0 && (
          <p class="text-sm text-bo-muted">Aucune collection pour l'instant.</p>
        )}
      </fieldset>
      <div class="flex justify-end gap-2 border-t border-bo-border px-4 py-3">
        <button value="annuler" class="rounded border border-bo-border px-3 py-1.5 text-sm hover:bg-bo-bg">
          Annuler
        </button>
        <button value="valider" class="rounded bg-bo-accent px-4 py-1.5 text-sm text-white" data-dlg-valider>
          Valider
        </button>
      </div>
    </form>
  </dialog>

  {/* ====== Fenêtre : la description d'une ligne, ou de toutes ====== */}
  <dialog
    id="dlg-description"
    class="w-[min(44rem,calc(100vw-2rem))] rounded-lg border border-bo-border bg-bo-surface p-0 text-bo-ink shadow-xl backdrop:bg-black/40"
    aria-labelledby="dlg-description-titre"
  >
    <form method="dialog" class="flex max-h-[85vh] flex-col">
      <h2 id="dlg-description-titre" class="border-b border-bo-border px-4 py-3 font-semibold">
        Description
      </h2>
      <div class="overflow-y-auto px-4 py-3">
        <p data-dlg-aide class="mb-2 text-xs text-bo-muted"></p>
        <EditeurTexte
          nom="description-de-la-fenetre"
          etiquette="Description de l'affiche"
          invite="La description que le client lit sur la page de l'affiche."
        />
      </div>
      <div class="flex justify-end gap-2 border-t border-bo-border px-4 py-3">
        <button value="annuler" class="rounded border border-bo-border px-3 py-1.5 text-sm hover:bg-bo-bg">
          Annuler
        </button>
        <button value="valider" class="rounded bg-bo-accent px-4 py-1.5 text-sm text-white">
          Valider
        </button>
      </div>
    </form>
  </dialog>

  <script is:inline>
    (function () {
      var formulaire = document.getElementById("grille");
      var apercu = document.getElementById("apercu");
      // Arrivée sur l'aperçu après « Vérifier » : il est en haut de page, et
      // le lecteur d'écran doit y être conduit, pas seulement l'œil.
      if (apercu) {
        var titreApercu = document.getElementById("titre-apercu");
        if (titreApercu) titreApercu.focus();
      }
      if (!formulaire) return;

      var lignes = Array.prototype.slice.call(
        formulaire.querySelectorAll("tbody [data-ligne]"),
      );
      // Les champs des LIGNES seulement : l'éditeur de la fenêtre porte lui
      // aussi un `data-champ`, qui n'a rien à faire dans la comparaison.
      var champs = Array.prototype.slice.call(
        formulaire.querySelectorAll("tbody [data-champ]"),
      );
      var compteur = document.getElementById("compteur");
      var problemesEl = document.getElementById("problemes");
      var annonceEl = document.getElementById("annonce");
      var verifier = document.getElementById("verifier");
      var remettre = document.getElementById("remettre");
      var charge = document.getElementById("charge-modifications");
      var formApercu = document.getElementById("form-apercu");
      var nomsCollections = {};
      try {
        nomsCollections = JSON.parse(
          document.getElementById("noms-collections").textContent || "{}",
        );
      } catch (e) {}
      var modifiees = 0;
      var envoyables = 0;
      var envoiEnCours = false;
      var chargementFini = false;

      // Ce que le navigateur accepte de lire. `parseFloat` rend 12 pour
      // « 12 g » et 5 pour « 5e » : sans ces motifs, une faute de frappe
      // deviendrait un prix ou un poids parfaitement plausible.
      var MOTIF_PRIX = /^\d+(\.\d{1,2})?$/;
      var MOTIF_POIDS = /^\d+$/;

      /** L'adresse tirée d'un nom : la même règle que l'API. */
      function slugifier(v) {
        return String(v || "")
          .normalize("NFD")
          .replace(/[̀-ͯ]/g, "")
          .toLowerCase()
          .replace(/[^a-z0-9]+/g, "-")
          .replace(/^-+|-+$/g, "")
          .slice(0, 80);
      }

      /** Une liste d'identifiants, triée : la forme qu'on compare. */
      function trier(ids) {
        return ids
          .map(Number)
          .filter(function (n) { return n > 0; })
          .sort(function (a, b) { return a - b; })
          .filter(function (n, i, t) { return i === 0 || t[i - 1] !== n; })
          .join(",");
      }
      function idsDe(texte) {
        return String(texte || "").split(",").filter(Boolean).map(Number);
      }

      // Toute comparaison passe par cette forme : le prix est comparé en
      // centimes, pas en « 24,9 » contre « 24,90 », sinon la moitié des lignes
      // partirait sans avoir été touchée. « ? » veut dire « pas compris », et
      // ce n'est jamais confondu avec « vide ».
      function valeur(c) {
        if (c.type === "checkbox") return c.checked ? "1" : "0";
        var genre = c.dataset.champ;
        var brut = String(c.value).replace(",", ".").trim();
        if (genre === "prix") {
          if (brut === "") return "";
          if (!MOTIF_PRIX.test(brut)) return "?";
          return String(Math.round(parseFloat(brut) * 100));
        }
        if (genre === "poids") {
          if (brut === "") return "";
          if (!MOTIF_POIDS.test(brut)) return "?";
          return String(parseInt(brut, 10));
        }
        if (genre === "collections") return trier(idsDe(c.value));
        return String(c.value).trim();
      }

      function initial(c) {
        return c.dataset.initial || "";
      }

      function souci(c) {
        var genre = c.dataset.champ;
        var v = valeur(c);
        if (genre === "nom" && v === "") return "Le nom ne peut pas rester vide.";
        if (genre === "slug" && v === "")
          return "L'identifiant ne peut pas rester vide.";
        if (genre === "statut" && v === "") return "Choisissez un statut.";
        if (genre === "prix") {
          if (v === "?")
            return "Ce prix n'a pas été compris. Tapez par exemple 24,90.";
          if (v === "")
            return "Ce prix ne peut pas rester vide. Retapez-le, ou remettez la colonne comme elle était.";
        }
        if (genre === "poids" && v === "?")
          return "Ce poids se tape en grammes entiers, par exemple 350. Laissez la case vide pour reprendre celui de la catégorie.";
        return null;
      }

      /** Le texte d'une description, en une ligne, pour la grille. */
      function extrait(html) {
        var doc = new DOMParser().parseFromString(
          "<!doctype html><body>" + String(html || ""),
          "text/html",
        );
        var texte = (doc.body.textContent || "").replace(/\s+/g, " ").trim();
        return texte.length > 60 ? texte.slice(0, 59) + "…" : texte;
      }

      /** Redessine ce qui montre la valeur d'un champ caché : puces, extrait. */
      function montrer(c) {
        var cellule = c.parentElement;
        if (!cellule) return;
        if (c.dataset.champ === "collections") {
          var puces = cellule.querySelector("[data-puces]");
          if (!puces) return;
          puces.textContent = "";
          var ids = idsDe(c.value);
          if (!ids.length) {
            var rien = document.createElement("span");
            rien.className = "text-xs text-bo-muted";
            rien.textContent = "aucune";
            puces.append(rien);
          }
          ids.forEach(function (id) {
            var info = nomsCollections[String(id)];
            var s = document.createElement("span");
            s.className = "inline-block rounded-full bg-bo-bg px-2 py-0.5 text-xs";
            s.textContent =
              (info ? info.nom : "n° " + id) + (info && info.archivee ? " (archivée)" : "");
            puces.append(s);
          });
        } else if (c.dataset.champ === "description") {
          var e = cellule.querySelector("[data-extrait]");
          if (e) e.textContent = extrait(c.value) || "aucune";
        }
      }

      function optionExiste(select, valeurCherchee) {
        return Array.prototype.some.call(select.options, function (o) {
          return o.value === valeurCherchee;
        });
      }

      /**
       * Pose une valeur dans un champ, comme si on l'avait tapée. Rend faux
       * quand la liste de la ligne ne propose pas cette valeur : la poser la
       * viderait, la ligne serait comptée modifiée et ne partirait jamais.
       */
      function poser(c, v) {
        if (c.type === "checkbox") c.checked = v === true || v === "1";
        else if (c.tagName === "SELECT" && !optionExiste(c, String(v))) return false;
        else c.value = v;
        montrer(c);
        return true;
      }

      /** « 340 g » ou « 1,25 kg » — pour l'affichage seulement. */
      function texteGrammes(g) {
        if (g < 1000) return g + " g";
        var kg = g % 1000 === 0 ? String(g / 1000) : (g / 1000).toFixed(2);
        return kg.replace(".", ",") + " kg";
      }

      // Ce que le produit pèsera si la case reste vide : le poids de la
      // catégorie choisie sur la ligne, à l'instant où on la choisit.
      function majHeritage(ligne) {
        var champPoids = ligne.querySelector('[data-champ="poids"]');
        var note = ligne.querySelector("[data-heritage]");
        if (!champPoids || !note) return;
        if (formulaire.dataset.poidsConnus !== "1") {
          note.hidden = true;
          return;
        }
        var select = ligne.querySelector('[data-champ="categorie"]');
        var option = select ? select.options[select.selectedIndex] : null;
        var herite = option ? Number(option.dataset.poids || "0") : 0;
        if (!Number.isFinite(herite) || herite <= 0) herite = 0;

        champPoids.placeholder = herite > 0 ? String(herite) : "";
        if (String(champPoids.value).trim() !== "") {
          note.hidden = true;
          return;
        }
        note.hidden = false;
        if (herite > 0) {
          note.textContent = "Vide : " + texteGrammes(herite) + ", celui de la catégorie.";
          note.className = "block text-xs text-bo-muted";
        } else {
          note.textContent = "Vide : aucun poids connu.";
          note.className = "block text-xs text-amber-800";
        }
      }

      function annoncer(texte) {
        if (!annonceEl) return;
        annonceEl.textContent = texte;
        annonceEl.hidden = texte === "";
      }

      function recalculer() {
        modifiees = 0;
        var bloquees = 0;

        lignes.forEach(function (ligne) {
          var bouge = false;
          var fautive = false;
          Array.prototype.forEach.call(
            ligne.querySelectorAll("[data-champ]"),
            function (c) {
              var change = valeur(c) !== initial(c);
              if (change) bouge = true;
              var probleme = change ? souci(c) : null;
              if (probleme) fautive = true;
              if (c.type !== "checkbox" && c.type !== "hidden") {
                c.classList.toggle("border-red-600", !!probleme);
                c.classList.toggle("border-bo-accent", change && !probleme);
                c.classList.toggle("border-bo-border", !change);
              }
              if (c.type === "hidden" && c.parentElement)
                c.parentElement.classList.toggle("bg-amber-50", change);
              // Le motif du refus se lit sous la case fautive : une liste au
              // bas de l'écran ne dit pas quelle ligne corriger.
              var boite = c.parentElement
                ? c.parentElement.querySelector("[data-souci]")
                : null;
              if (boite) {
                boite.textContent = probleme || "";
                boite.hidden = !probleme;
              }
            },
          );
          majHeritage(ligne);
          var marque = ligne.querySelector("[data-modifie]");
          if (marque) marque.hidden = !bouge || fautive;
          var alerte = ligne.querySelector("[data-bloquee]");
          if (alerte) alerte.hidden = !fautive;
          if (bouge) modifiees++;
          if (fautive) bloquees++;
        });

        envoyables = modifiees - bloquees;

        if (compteur) {
          var texte;
          if (modifiees === 0) {
            texte = "Aucune modification pour l'instant.";
          } else {
            var bouts = [];
            if (envoyables > 0)
              bouts.push(
                envoyables +
                  (envoyables > 1
                    ? " produits modifiés, à vérifier"
                    : " produit modifié, à vérifier"),
              );
            if (bloquees > 0)
              bouts.push(
                bloquees +
                  (bloquees > 1 ? " lignes à corriger" : " ligne à corriger"),
              );
            texte = bouts.join(" et ") + ".";
          }
          compteur.textContent = texte;
          compteur.className =
            modifiees === 0 ? "text-sm text-bo-muted" : "text-sm font-medium";
        }

        if (problemesEl) {
          problemesEl.hidden = bloquees === 0;
          problemesEl.textContent =
            bloquees === 0
              ? ""
              : bloquees > 1
                ? bloquees +
                  " lignes comportent une erreur, signalée en rouge sous la case concernée. Elles ne partiront pas ; les autres seront vérifiées normalement."
                : "Une ligne comporte une erreur, signalée en rouge sous la case concernée. Elle ne partira pas ; les autres seront vérifiées normalement.";
        }

        // Une cellule fautive n'empêche plus tout le lot : seules ses propres
        // lignes restent à quai.
        if (verifier) verifier.disabled = envoyables === 0;
        if (remettre) remettre.disabled = modifiees === 0;
      }

      /**
       * La grille a bougé après une vérification : l'aperçu ne dit plus ce
       * qui partirait. Son bouton s'éteint, et une phrase dit pourquoi.
       */
      function apercuPerime() {
        if (!formApercu || !chargementFini) return;
        var b = document.getElementById("enregistrer-apercu");
        if (b) b.disabled = true;
        var mot = document.getElementById("apercu-perime");
        if (mot) mot.hidden = false;
      }

      function apresChangement() {
        recalculer();
        apercuPerime();
      }

      function colonneDe(nom) {
        return champs.filter(function (c) {
          return c.dataset.colonne === nom;
        });
      }
      function champDeLigne(ligne, genre) {
        return ligne.querySelector('[data-champ="' + genre + '"]');
      }

      // L'identifiant qui suit le nom suit chaque frappe dans le nom ; un
      // identifiant tapé à la main redevient libre.
      champs.forEach(function (c) {
        c.addEventListener("input", function () {
          if (c.dataset.champ === "slug") delete c.dataset.depuisNom;
          if (c.dataset.champ === "nom") {
            var ligne = c.closest("[data-ligne]");
            var s = ligne && champDeLigne(ligne, "slug");
            if (s && s.dataset.depuisNom === "1") s.value = slugifier(c.value);
          }
          apresChangement();
        });
        c.addEventListener("change", apresChangement);
      });

      function remettreChamp(c) {
        var depart = initial(c);
        if (c.type === "checkbox") c.checked = depart === "1";
        else if (c.dataset.champ === "prix")
          c.value =
            depart === ""
              ? ""
              : (Number(depart) / 100).toFixed(2).replace(".", ",");
        else c.value = depart;
        if (c.dataset.champ === "slug") delete c.dataset.depuisNom;
        montrer(c);
      }

      /** Ce qu'une case de saisie veut dire, ramené à la forme du champ. */
      function annoncerPose(libelle, poses, ignores, verbe) {
        var texte =
          poses === 0
            ? "Aucune ligne n'a pu recevoir « " + libelle + " »."
            : "« " + libelle + " » " + verbe + " " + poses +
              (poses > 1 ? " lignes" : " ligne") +
              ", y compris celles qui ne sont pas à l'écran. Le bouton ↺ de la colonne annule.";
        if (ignores > 0 && poses > 0)
          texte += " " + ignores + (ignores > 1 ? " lignes n'ont" : " ligne n'a") +
            " pas pu recevoir cette valeur.";
        annoncer(texte);
      }

      // Recopier vers le bas : la première ligne sert de modèle à la colonne.
      Array.prototype.forEach.call(
        document.querySelectorAll("[data-recopier]"),
        function (b) {
          b.addEventListener("click", function () {
            var colonne = colonneDe(b.dataset.recopier);
            if (colonne.length < 2) return;
            var source = colonne[0];
            var modele = source.type === "checkbox" ? source.checked : source.value;
            var poses = 0;
            var ignores = 0;
            for (var i = 1; i < colonne.length; i++)
              if (poser(colonne[i], modele)) poses++;
              else ignores++;
            apresChangement();
            annoncerPose(b.dataset.libelle, poses, ignores, "recopié sur");
          });
        },
      );

      /* --- « Appliquer à tout » ------------------------------------------ */

      /** Le nom d'une ligne, changé selon le mode choisi. */
      function nouveauNom(actuel, mode, texte, par) {
        if (mode === "remplacer") return texte;
        // Un espace entre les deux, sauf si l'on en a tapé un : « Affiche »
        // ajouté au début de « COLMAR » donne « Affiche COLMAR ».
        if (mode === "debut")
          return /\s$/.test(texte) || /^\s/.test(actuel) ? texte + actuel : texte + " " + actuel;
        if (mode === "fin")
          return /^\s/.test(texte) || /\s$/.test(actuel) ? actuel + texte : actuel + " " + texte;
        return texte ? actuel.split(texte).join(par) : actuel;
      }

      var celluleNom = formulaire.querySelector('[data-appliquer="nom"]');
      if (celluleNom) {
        var modeNom = celluleNom.querySelector("[data-nom-mode]");
        var parNom = celluleNom.querySelector("[data-nom-par]");
        var texteNom = celluleNom.querySelector("[data-nom-texte]");
        modeNom.addEventListener("change", function () {
          parNom.hidden = modeNom.value !== "rechercher";
          texteNom.placeholder = modeNom.value === "rechercher" ? "Rechercher" : "Texte";
        });
      }

      function appliquerNom() {
        var mode = modeNom.value;
        var texte = texteNom.value;
        if (mode === "remplacer" ? !texte.trim() : !texte) {
          annoncer(
            mode === "rechercher"
              ? "Tapez d'abord le texte à rechercher dans les noms."
              : "Tapez d'abord le texte à poser dans les noms.",
          );
          texteNom.focus();
          return;
        }
        var poses = 0;
        lignes.forEach(function (ligne) {
          var c = champDeLigne(ligne, "nom");
          if (!c) return;
          var suivant = nouveauNom(c.value, mode, texte, parNom.value);
          if (suivant === c.value) return;
          c.value = suivant;
          poses++;
          var s = champDeLigne(ligne, "slug");
          if (s && s.dataset.depuisNom === "1") s.value = slugifier(suivant);
        });
        apresChangement();
        annoncer(
          poses === 0
            ? "Aucun nom n'a changé."
            : "Nom changé sur " + poses + (poses > 1 ? " lignes" : " ligne") +
              ". Le bouton ↺ de la colonne Identifiant, ou « Tout remettre comme avant », annule.",
        );
      }

      function appliquerSlug() {
        var poses = 0;
        lignes.forEach(function (ligne) {
          var n = champDeLigne(ligne, "nom");
          var s = champDeLigne(ligne, "slug");
          if (!n || !s) return;
          s.value = slugifier(n.value);
          s.dataset.depuisNom = "1";
          if (valeur(s) !== initial(s)) poses++;
        });
        apresChangement();
        annoncer(
          poses === 0
            ? "Les identifiants suivent déjà les noms : rien ne change."
            : poses + (poses > 1 ? " identifiants refaits" : " identifiant refait") +
              " depuis le nom. Une adresse déjà prise recevra -2, -3… : la vérification le montrera, avec la redirection 301 posée pour chaque adresse changée.",
        );
      }

      /** Statut, prix, poids, catégorie, IA, type : une valeur pour toute la colonne. */
      function appliquerSimple(cellule, colonne, libelle) {
        var modele = cellule.querySelector("[data-modele]");
        if (!modele) return;
        var v = modele.type === "checkbox" ? modele.checked : modele.value;
        var poses = 0;
        var ignores = 0;
        colonneDe(colonne).forEach(function (c) {
          if (poser(c, v)) poses++;
          else ignores++;
        });
        apresChangement();
        annoncerPose(libelle, poses, ignores, "appliqué à");
      }

      Array.prototype.forEach.call(
        formulaire.querySelectorAll("[data-appliquer-bouton]"),
        function (b) {
          b.addEventListener("click", function () {
            var quoi = b.dataset.appliquerBouton;
            var cellule = b.closest("[data-appliquer]");
            if (quoi === "nom") appliquerNom();
            else if (quoi === "slug") appliquerSlug();
            else if (quoi === "collections")
              ouvrirCollections(null, cellule.querySelector("[data-collections-mode]").value, b);
            else if (quoi === "description") ouvrirDescription(null, b);
            else appliquerSimple(cellule, quoi, b.dataset.libelle || quoi);
          });
        },
      );

      // Entrée dans une case « Appliquer à tout » applique la colonne, au lieu
      // d'envoyer toute la grille à la vérification par surprise.
      formulaire.addEventListener("keydown", function (e) {
        if (e.key !== "Enter" || !e.target.closest) return;
        var cellule = e.target.closest("[data-appliquer]");
        if (!cellule || e.target.tagName === "BUTTON") return;
        e.preventDefault();
        var b = cellule.querySelector("[data-appliquer-bouton]");
        if (b) b.click();
      });

      /* --- Les deux fenêtres --------------------------------------------- */

      var dlgCollections = document.getElementById("dlg-collections");
      var dlgDescription = document.getElementById("dlg-description");
      /** Pour qui la fenêtre est ouverte : un champ, ou toute la colonne. */
      var cible = null;
      var modeTout = "";
      var retourFocus = null;

      var LIBELLES_MODE = {
        ajouter: "Ajouter toutes les lignes à ces collections",
        retirer: "Retirer toutes les lignes de ces collections",
        remplacer: "Remplacer les collections de toutes les lignes par celles-ci",
      };

      function ouvrirCollections(champ, mode, depuis) {
        cible = champ;
        modeTout = mode || "";
        retourFocus = depuis;
        var choisies = champ ? idsDe(champ.value) : [];
        var titre = dlgCollections.querySelector("#dlg-collections-titre");
        var aide = dlgCollections.querySelector("[data-dlg-aide]");
        if (champ) {
          var ligne = champ.closest("[data-ligne]");
          titre.textContent = "Collections de « " + (ligne ? ligne.dataset.nom : "") + " »";
          aide.textContent = "Cochez les collections où ranger cette affiche. Une collection ajoutée la range à la fin.";
        } else {
          titre.textContent = LIBELLES_MODE[modeTout] || "Collections";
          aide.textContent =
            modeTout === "retirer"
              ? "Les lignes sortiront des collections cochées. Rien n'est supprimé : l'affiche reste au catalogue."
              : "Les affiches ajoutées se rangent à la fin de chaque collection.";
        }
        Array.prototype.forEach.call(
          dlgCollections.querySelectorAll("[data-collection-case]"),
          function (cas) {
            cas.checked = choisies.indexOf(Number(cas.value)) !== -1;
            // Une collection archivée ne se propose que pour EN SORTIR : sur
            // la ligne qui y est, ou pour « Retirer de… ».
            var archivee = cas.hasAttribute("data-archivee");
            var visible = !archivee || (champ ? cas.checked : modeTout === "retirer");
            cas.closest("label").hidden = !visible;
            cas.disabled = archivee && !visible;
          },
        );
        dlgCollections.showModal();
        var premiere = dlgCollections.querySelector("[data-collection-case]:not([disabled])");
        if (premiere) premiere.focus();
      }

      dlgCollections.addEventListener("close", function () {
        var valide = dlgCollections.returnValue === "valider";
        dlgCollections.returnValue = "";
        if (valide) {
          var cochees = Array.prototype.slice
            .call(dlgCollections.querySelectorAll("[data-collection-case]"))
            .filter(function (cas) { return cas.checked && !cas.closest("label").hidden; })
            .map(function (cas) { return Number(cas.value); });
          if (cible) {
            poser(cible, trier(cochees));
            apresChangement();
            annoncer("Collections de la ligne changées. ↺ de la colonne annule.");
          } else {
            var poses = 0;
            colonneDe("collections").forEach(function (c) {
              var actuelles = idsDe(c.value);
              var suivantes =
                modeTout === "ajouter"
                  ? actuelles.concat(cochees)
                  : modeTout === "retirer"
                    ? actuelles.filter(function (id) { return cochees.indexOf(id) === -1; })
                    : cochees;
              var t = trier(suivantes);
              if (t !== trier(actuelles)) poses++;
              poser(c, t);
            });
            apresChangement();
            annoncer(
              poses === 0
                ? "Aucune ligne ne change de collections."
                : "Collections changées sur " + poses + (poses > 1 ? " lignes" : " ligne") +
                  ", y compris celles qui ne sont pas à l'écran. Le bouton ↺ de la colonne annule.",
            );
          }
        }
        if (retourFocus) retourFocus.focus();
        cible = null;
      });

      var editeur = dlgDescription.querySelector("[data-editeur]");
      function ouvrirDescription(champ, depuis) {
        cible = champ;
        retourFocus = depuis;
        var titre = dlgDescription.querySelector("#dlg-description-titre");
        var aide = dlgDescription.querySelector("[data-dlg-aide]");
        if (champ) {
          var ligne = champ.closest("[data-ligne]");
          titre.textContent = "Description de « " + (ligne ? ligne.dataset.nom : "") + " »";
          aide.textContent = "Le texte que le client lit sur la page de l'affiche.";
        } else {
          titre.textContent = "Remplacer la description de toutes les lignes";
          aide.textContent =
            "Ce texte remplacera la description de chaque ligne du tableau, y compris celles hors de l'écran. Rien n'est enregistré avant la vérification.";
        }
        if (editeur)
          editeur.dispatchEvent(
            new CustomEvent("editeur:charger", { detail: { html: champ ? champ.value : "" } }),
          );
        dlgDescription.showModal();
        var zone = dlgDescription.querySelector("[data-zone]");
        if (zone) zone.focus();
      }

      dlgDescription.addEventListener("close", function () {
        var valide = dlgDescription.returnValue === "valider";
        dlgDescription.returnValue = "";
        if (valide && editeur) {
          var html = (editeur.querySelector("[data-champ]") || {}).value || "";
          if (cible) {
            poser(cible, html.trim());
            apresChangement();
            annoncer("Description de la ligne changée. ↺ de la colonne annule.");
          } else {
            var poses = 0;
            colonneDe("description").forEach(function (c) {
              poser(c, html.trim());
              poses++;
            });
            apresChangement();
            annoncerPose("Description", poses, 0, "posée sur");
          }
        }
        if (retourFocus) retourFocus.focus();
        cible = null;
      });

      formulaire.addEventListener("click", function (e) {
        var b = e.target.closest("[data-ouvrir-collections], [data-ouvrir-description]");
        if (!b) return;
        var cellule = b.closest("td");
        if (b.hasAttribute("data-ouvrir-collections"))
          ouvrirCollections(cellule.querySelector('[data-champ="collections"]'), "", b);
        else ouvrirDescription(cellule.querySelector('[data-champ="description"]'), b);
      });

      Array.prototype.forEach.call(
        document.querySelectorAll("[data-annuler]"),
        function (b) {
          b.addEventListener("click", function () {
            colonneDe(b.dataset.annuler).forEach(remettreChamp);
            apresChangement();
            annoncer("« " + b.dataset.libelle + " » remis comme avant.");
          });
        },
      );

      if (remettre)
        remettre.addEventListener("click", function () {
          champs.forEach(remettreChamp);
          apresChangement();
          annoncer("Toutes les colonnes ont été remises comme avant.");
        });

      formulaire.addEventListener("submit", function (e) {
        var modifications = [];
        lignes.forEach(function (ligne) {
          var diff = { id: Number(ligne.dataset.id) };
          var bouge = false;
          var fautive = false;
          var nomLigne = champDeLigne(ligne, "nom");
          Array.prototype.forEach.call(
            ligne.querySelectorAll("[data-champ]"),
            function (c) {
              if (valeur(c) === initial(c)) return;
              if (souci(c)) {
                fautive = true;
                return;
              }
              bouge = true;
              var genre = c.dataset.champ;
              if (genre === "nom") diff.name = String(c.value).trim();
              else if (genre === "slug") {
                // L'adresse qui suit le nom part comme telle : c'est l'API
                // qui la rend unique, face au catalogue et au reste du lot.
                if (
                  c.dataset.depuisNom === "1" &&
                  nomLigne &&
                  valeur(c) === slugifier(nomLigne.value)
                )
                  diff.slugDepuisNom = true;
                else diff.slug = String(c.value).trim();
              } else if (genre === "statut") diff.status = c.value;
              else if (genre === "prix") {
                if (c.dataset.format) {
                  if (!diff.prix) diff.prix = {};
                  diff.prix[c.dataset.format] = Number(valeur(c));
                } else diff.basePriceCents = Number(valeur(c));
              } else if (genre === "categorie")
                diff.categoryId = c.value === "" ? null : Number(c.value);
              else if (genre === "poids")
                diff.weightGrams = valeur(c) === "" ? null : Number(valeur(c));
              else if (genre === "ia") diff.aiEnabled = c.checked;
              else if (genre === "vue") diff.defaultView = c.value === "" ? null : c.value;
              else if (genre === "description") diff.description = valeur(c);
              else if (genre === "collections")
                diff.collections = { mode: "remplacer", ids: idsDe(valeur(c)) };
            },
          );
          // Une ligne à moitié envoyée laisserait le produit dans un état que
          // personne n'a demandé : elle reste entière à l'écran, avec sa faute.
          if (bouge && !fautive) modifications.push(diff);
        });

        if (modifications.length === 0) {
          e.preventDefault();
          annoncer(
            "Rien n'a été envoyé : les lignes modifiées comportent toutes une erreur, indiquée en rouge dans le tableau.",
          );
          return;
        }
        charge.value = JSON.stringify(modifications);
        envoiEnCours = true;
      });

      if (formApercu)
        formApercu.addEventListener("submit", function () {
          envoiEnCours = true;
        });

      window.addEventListener("beforeunload", function (e) {
        if (envoiEnCours || modifiees === 0) return;
        e.preventDefault();
        e.returnValue = "";
      });

      recalculer();
      chargementFini = true;
    })();
  </script>
</Admin>
