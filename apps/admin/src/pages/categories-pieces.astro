---
/**
 * Les catégories de pièces et leurs nuanciers — et les nuanciers des
 * personnages eux-mêmes.
 *
 * Chaque nuancier se compose ET se range (Nuancier.astro, lib/pastilles.ts) :
 * l'ordre des pastilles est celui que la cliente voit dans le module. Avant,
 * une pastille se retirait d'un clic et une couleur ajoutée arrivait toujours
 * en dernier ; pour en placer une au milieu, il fallait tout défaire.
 *
 * Les quatre nuanciers des PERSONNAGES (peau, cheveux / pelage, vêtements,
 * pantalon) étaient écrits dans le code du module, et nulle part ici : « il
 * n'existe pas dans Catégories de pièces alors qu'il est bien côté client ».
 * Ils ont leur section en bas de page, et se choisissent, couleur par
 * couleur, sur la fiche d'un personnage (« Nuancier »), au même titre que le
 * nuancier d'une catégorie.
 */
import { url } from "../lib/url.ts";
import Admin from "../layouts/Admin.astro";
import Nuancier from "../components/Nuancier.astro";
import { adminApi, type CategoriePiece } from "../lib/api.ts";
import { LIBELLES_NUANCIERS_BASE, NUANCIERS_BASE } from "@memoryline/types/couleurs";

const api = adminApi(Astro.request);

const SLOTS = [
  { value: "clothes", label: "Vêtements" },
  { value: "pants", label: "Pantalon" },
  { value: "hair", label: "Coupes" },
  { value: "accessory", label: "Accessoires" },
];
const nomSlot = (v: string) => SLOTS.find((s) => s.value === v)?.label ?? v;

/** « #fff, #B8551D … » ou une couleur par ligne -> liste propre. */
function couleursDepuis(brut: FormDataEntryValue | null): string[] {
  return String(brut ?? "")
    .split(/[\s,;]+/)
    .map((c) => c.trim())
    .filter(Boolean)
    .map((c) => (c.startsWith("#") ? c : `#${c}`))
    .map((c) =>
      // #abc -> #aabbcc, pour que le configurateur retrouve la pastille.
      /^#[0-9a-fA-F]{3}$/.test(c)
        ? "#" + c.slice(1).split("").map((x) => x + x).join("")
        : c,
    )
    .map((c) => c.toUpperCase())
    .filter((c) => /^#[0-9A-F]{6}$/.test(c));
}

let flash: string | null = null;
let flashErreur = false;
if (Astro.request.method === "POST") {
  const f = await Astro.request.formData();
  const action = f.get("_action");
  try {
    if (action === "nuancier" || action === "nuancier-origine") {
      // Un des quatre nuanciers des personnages : enregistré dans l'ordre
      // des pastilles, ou remis à ses couleurs d'origine.
      const nuancier = String(f.get("nuancier") ?? "");
      const libelle =
        LIBELLES_NUANCIERS_BASE[nuancier as keyof typeof LIBELLES_NUANCIERS_BASE] ?? nuancier;
      if (action === "nuancier-origine") {
        await api.enregistrerNuancierBase(nuancier, null);
        flash = `Nuancier « ${libelle} » remis à ses couleurs d'origine.`;
      } else {
        await api.enregistrerNuancierBase(nuancier, couleursDepuis(f.get("colors")));
        flash = `Nuancier « ${libelle} » enregistré. Le module montre ses couleurs dans cet ordre.`;
      }
    } else if (action === "archiver") {
      const restaurer = f.get("archived") === "false";
      const r = await api.archiverCategoriePiece(
        Number(f.get("id")),
        !restaurer,
      );
      flash = restaurer
        ? "Catégorie restaurée, avec ses pièces et son nuancier."
        : `Catégorie archivée${
            r.dedans > 0
              ? `. Ses ${r.dedans} pièce${r.dedans > 1 ? "s" : ""} rest${r.dedans > 1 ? "ent" : "e"} proposée${r.dedans > 1 ? "s" : ""} et repren${r.dedans > 1 ? "nent" : "d"} le nuancier de leur emplacement`
              : ""
          }. Vous pouvez la restaurer à tout moment, plus bas.`;
    } else if (action === "supprimer") {
      // Refusée par l'API tant qu'elle range des pièces en service, ou qu'une
      // couleur prend son nuancier : la phrase de refus s'affiche telle quelle.
      await api.supprimerCategoriePiece(Number(f.get("id")));
      const nom = String(f.get("nom") ?? "").trim();
      flash = nom
        ? `Catégorie « ${nom} » supprimée définitivement, avec son nuancier.`
        : "Catégorie supprimée définitivement, avec son nuancier.";
    } else {
      const cat = await api.upsertPieceCategory({
        id: f.get("id") ? Number(f.get("id")) : undefined,
        name: String(f.get("name") || ""),
        slot: String(f.get("slot") || "accessory"),
        colors: couleursDepuis(f.get("colors")),
        active: f.get("active") === "on",
        position: Number(f.get("position") || 0),
        // Le menu « Le client peut recolorer » a quitté la page (le client
        // change toutes les couleurs) : absent, la valeur en base reste
        // telle quelle. Seule une page restée ouverte d'avant l'envoie encore.
        ...(f.get("couleursProposees") !== null
          ? {
              couleursProposees:
                f.get("couleursProposees") === "principale" ? "principale" : "toutes",
            }
          : {}),
      });
      flash = `Catégorie « ${cat.name} » enregistrée.`;
    }
  } catch (e) {
    // Le message seul, sans le « Error: » du JavaScript : c'est la phrase de
    // l'API (« Elle range encore 3 pièces… ») que la boutique doit lire.
    flash = "Erreur : " + (e instanceof Error ? e.message : String(e));
    flashErreur = true;
  }
}

let toutes: CategoriePiece[] = [];
let error: string | null = null;
try {
  toutes = await api.pieceCategories();
} catch (e) {
  error = String(e);
}

/** Les nuanciers des personnages ; muets, leur section le dit au lieu de mentir. */
let nuanciersBase: Awaited<ReturnType<typeof api.nuanciersBase>> | null = null;
try {
  nuanciersBase = await api.nuanciersBase();
} catch {
  nuanciersBase = null;
}

/** À quoi sert chaque nuancier des personnages, en une ligne. */
const USAGE_NUANCIER: Record<string, string> = {
  peau: "La peau des personnages : la première couleur de chaque personnage, sauf choix contraire sur sa fiche.",
  cheveux: "Les cheveux dessinés sur le personnage, les coupes sans catégorie, et le pelage des animaux dessinés en photo.",
  vetements: "Les vêtements dessinés sur le personnage, et les pièces sans catégorie de l'emplacement Vêtements ou Accessoires.",
  pantalon: "Les pièces sans catégorie de l'emplacement Pantalon.",
};

// Les archivées quittent la liste ordinaire pour leur propre section.
const categories = toutes.filter((c) => !c.archivedAt);
const archivees = toutes.filter((c) => c.archivedAt);

/** Ce qu'il faut avoir lu avant d'archiver une catégorie de pièces. */
function messageArchivage(c: CategoriePiece): string {
  const l = [`Archiver la catégorie « ${c.name} » ?`];
  const n = c.pieces ?? 0;
  if (n > 0)
    l.push(
      `Ses ${n} pièce${n > 1 ? "s restent proposées" : " reste proposée"} dans le configurateur : ${n > 1 ? "elles reprennent" : "elle reprend"} simplement le nuancier de l'emplacement « ${nomSlot(c.slot)} » le temps de l'archivage.`,
    );
  if (c.colors.length)
    l.push(
      `Son nuancier (${c.colors.length} couleur${c.colors.length > 1 ? "s" : ""}) est gardé entier et revient avec elle.`,
    );
  l.push(
    "Rien n'est supprimé : vous pourrez la restaurer quand vous voudrez, dans « Catégories archivées ».",
  );
  return l.join("\n\n");
}
---

<Admin title="Catégories de pièces">
  {flash && (
    <p
      class={`mb-4 text-sm rounded px-3 py-2 border ${
        flashErreur ? "bg-red-50 border-red-200" : "bg-green-50 border-green-200"
      }`}
    >
      {flash}
    </p>
  )}
  {error && <p class="mb-4 text-red-600 text-sm">API injoignable : {error}</p>}

  <p class="mb-4 text-sm text-bo-muted max-w-3xl">
    Les pièces (vêtements, pantalons, coupes, accessoires) se rangent en
    catégories — « Casquettes », « Robes », « Lunettes »… — et chaque catégorie
    porte <strong>ses couleurs</strong> : celles que le client peut choisir pour
    les pièces qu'elle contient. Une catégorie sans couleur laisse le nuancier
    de l'emplacement et une couleur libre — sauf pour les accessoires, où le
    client n'a jamais de couleur libre.
  </p>
  <p class="mb-4 text-sm text-bo-muted max-w-3xl">
    <strong>Le client choisit la couleur de chaque partie de chaque pièce</strong>
    (les manches, le col, la visière…) : chaque partie a sa rangée de
    pastilles, et ses ombres la suivent toutes seules. Dans le module, un bouton sous les pastilles lui rend à tout
    moment les couleurs d'origine. Les commandes déjà passées ne changent pas.
  </p>
  <p class="mb-4 text-sm text-bo-muted max-w-3xl">
    <strong>Une partie peut avoir sa propre liste</strong>, jusqu'à 10
    couleurs (la monture et les verres d'une paire de lunettes, les manches
    d'un pull) : sur
    <a class="underline" href={url("/pieces")}>Pièces</a>, sous « Couleurs »
    de la pièce, « Couleurs proposées au client ». Le client n'a alors que
    celles-ci ; une partie sans liste propose le nuancier de sa catégorie.
  </p>
  <p class="mb-6 text-sm text-bo-muted max-w-3xl">
    Chaque pièce se range dans sa catégorie sur
    <a class="underline" href={url("/pieces")}>Pièces</a> (menu Atelier) : à
    sa création, ou en tête de ses « Couleurs ». C'est là aussi qu'une
    couleur se coche « C'est une ombre ».
  </p>

  <section class="mb-6 bg-bo-surface border border-bo-border rounded-lg overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-bo-bg text-left">
        <tr>
          <th class="px-4 py-2">Catégorie</th>
          <th class="px-2 py-2 w-10"></th>
        </tr>
      </thead>
      <tbody>
        {categories.map((c) => (
          <tr id={`ligne-categorie-${c.id}`} class="border-t border-bo-border align-top">
            <td class="px-4 py-3">
              <form method="POST" class="js-cat flex flex-wrap items-end gap-3">
                <input type="hidden" name="id" value={c.id} />
                <label class="block">
                  <span class="text-bo-muted text-xs">Nom</span>
                  <input
                    name="name"
                    value={c.name}
                    required
                    class="mt-1 block w-44 border border-bo-border rounded px-2 py-1"
                  />
                </label>
                <label class="block">
                  <span class="text-bo-muted text-xs">Emplacement</span>
                  <select
                    name="slot"
                    class="mt-1 block border border-bo-border rounded px-2 py-1"
                  >
                    {SLOTS.map((s) => (
                      <option value={s.value} selected={c.slot === s.value}>
                        {s.label}
                      </option>
                    ))}
                  </select>
                </label>
                <label class="block">
                  <span class="text-bo-muted text-xs">Ordre</span>
                  <input
                    name="position"
                    type="number"
                    value={c.position}
                    class="mt-1 block w-16 border border-bo-border rounded px-2 py-1"
                  />
                </label>
                <label class="flex items-center gap-1 pb-1.5">
                  <input type="checkbox" name="active" checked={c.active} />
                  <span>Proposée</span>
                </label>
                {/* Plus de menu « Le client peut recolorer » (toutes les
                    couleurs / seulement la principale) : le client change
                    toutes les couleurs de chaque pièce depuis le 20 octobre
                    2026, le menu ne voulait plus rien dire. Sa valeur reste
                    en base, intacte : le formulaire ne l'envoie plus, l'API
                    n'y touche donc pas, et plus rien ne la lit. */}
                <button class="rounded bg-bo-accent text-white px-3 py-1.5">
                  Enregistrer
                </button>

                {/* Nuancier : à composer ET à ranger (poignée, ← →, ×). La
                    liste part dans un champ texte, une couleur par ligne,
                    avec « Enregistrer ». */}
                <div class="basis-full">
                  <Nuancier nom="colors" couleurs={c.colors} libelle={`le nuancier « ${c.name} »`} />
                </div>
                <p class="basis-full text-xs text-bo-muted">
                  {c.pieces ?? 0} pièce{(c.pieces ?? 0) > 1 ? "s" : ""} —
                  identifiant <code>{c.slug}</code>. Ces couleurs sont
                  proposées pour chaque partie de ses pièces, sauf celles
                  qui ont leur propre liste.
                </p>
              </form>
            </td>
            <td class="px-2 py-3 text-right">
              <form
                method="POST"
                class="inline"
                onsubmit={`return confirm(${JSON.stringify(messageArchivage(c))})`}
              >
                <input type="hidden" name="_action" value="archiver" />
                <input type="hidden" name="id" value={c.id} />
                <input type="hidden" name="archived" value="true" />
                <button
                  class="rounded border border-bo-border px-2 py-1 text-xs text-bo-muted hover:border-bo-accent hover:text-bo-accent"
                  title={`Archiver « ${c.name} »`}
                >
                  Archiver
                </button>
              </form>
            </td>
          </tr>
        ))}
        {categories.length === 0 && !error && (
          <tr>
            <td class="px-4 py-6 text-bo-muted" colspan="2">
              Aucune catégorie de pièces.
            </td>
          </tr>
        )}
      </tbody>
    </table>
  </section>

  {/* ====== Catégories archivées ====== */}
  {archivees.length > 0 && (
    <section class="mb-6">
      <h2 class="mb-1 font-semibold">Catégories archivées</h2>
      <p class="mb-3 max-w-3xl text-xs text-bo-muted">
        Retirées du configurateur et de la liste ci-dessus. Leurs pièces
        restent proposées, avec le nuancier de leur emplacement :
        « Restaurer » remet la catégorie et ses couleurs en place.
        « Supprimer définitivement » l'efface pour de bon, avec son nuancier,
        une fois qu'aucune pièce en service n'y est rangée.
      </p>
      <div class="overflow-hidden rounded-lg border border-bo-border bg-bo-surface opacity-70">
        <table class="w-full text-sm">
          <tbody>
            {archivees.map((c) => (
              <tr id={`ligne-categorie-${c.id}`} class="border-t border-bo-border first:border-t-0">
                <td class="px-4 py-2 font-medium">{c.name}</td>
                <td class="px-4 py-2 text-bo-muted">
                  {nomSlot(c.slot)} · {c.pieces ?? 0} pièce{(c.pieces ?? 0) > 1 ? "s" : ""} ·{" "}
                  {c.colors.length} couleur{c.colors.length > 1 ? "s" : ""}
                </td>
                <td class="px-4 py-2">
                  <div class="flex flex-wrap items-center gap-1">
                    {c.colors.map((hex) => (
                      <span
                        class="inline-block h-4 w-4 rounded-full border border-bo-border"
                        style={`background:${hex}`}
                        title={hex}
                      />
                    ))}
                  </div>
                </td>
                <td class="px-4 py-2 text-right">
                  <form method="POST" class="inline">
                    <input type="hidden" name="_action" value="archiver" />
                    <input type="hidden" name="id" value={c.id} />
                    <input type="hidden" name="archived" value="false" />
                    <button class="text-bo-accent hover:underline">
                      Restaurer
                    </button>
                  </form>
                  {/* Sans retour, d'où la confirmation. L'API refuse une
                      catégorie qui range encore des pièces en service : la
                      raison s'affiche en haut de l'écran. */}
                  <form
                    method="POST"
                    class="ml-3 inline"
                    onsubmit={`return confirm(${JSON.stringify(`Supprimer définitivement « ${c.name} » ? C'est sans retour.`)})`}
                  >
                    <input type="hidden" name="_action" value="supprimer" />
                    <input type="hidden" name="id" value={c.id} />
                    <input type="hidden" name="nom" value={c.name} />
                    <button class="text-xs text-red-700 hover:underline">
                      Supprimer définitivement
                    </button>
                  </form>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  <details class="bg-bo-surface border border-bo-border rounded-lg">
    <summary class="cursor-pointer px-5 py-3 font-semibold select-none">
      <span class="mr-1 text-bo-accent">+</span> Ajouter une catégorie
    </summary>
    <form method="POST" class="js-cat flex flex-wrap items-end gap-3 px-5 pb-5 text-sm">
      <label class="block">
        <span class="text-bo-muted">Nom</span>
        <input
          name="name"
          required
          placeholder="Casquettes"
          class="mt-1 block w-44 border border-bo-border rounded px-3 py-2"
        />
      </label>
      <label class="block">
        <span class="text-bo-muted">Emplacement</span>
        <select
          name="slot"
          class="mt-1 block border border-bo-border rounded px-3 py-2"
        >
          {SLOTS.map((s) => <option value={s.value}>{s.label}</option>)}
        </select>
      </label>
      <label class="block">
        <span class="text-bo-muted">Ordre</span>
        <input
          name="position"
          type="number"
          value={categories.length}
          class="mt-1 block w-20 border border-bo-border rounded px-3 py-2"
        />
      </label>
      <label class="flex items-center gap-2 pb-2">
        <input type="checkbox" name="active" checked />
        <span>Proposée</span>
      </label>
      <div class="basis-full">
        <Nuancier nom="colors" couleurs={[]} libelle="le nuancier de la nouvelle catégorie" />
      </div>
      <button class="rounded bg-bo-accent text-white px-4 py-2">Créer</button>
    </form>
  </details>

  {/* ====== Nuanciers des personnages ====== */}
  <section id="nuanciers-personnages" class="mt-8">
    <h2 class="mb-1 font-semibold">Nuanciers des personnages</h2>
    <p class="mb-3 max-w-3xl text-sm text-bo-muted">
      Les couleurs proposées pour le dessin d'un personnage lui-même : sa peau,
      ses cheveux ou son pelage, ce qui est dessiné sur lui. Sur la fiche d'un
      personnage (bouton « 🎨 Couleurs »), chaque couleur du dessin choisit son
      « Nuancier » : l'un de ces quatre, ou celui d'une catégorie ci-dessus. Le
      chien qui doit proposer les teintes de peau prend « Peau ».
    </p>
    {!nuanciersBase && (
      <p class="mb-3 text-sm text-red-600">
        Les nuanciers des personnages n'ont pas pu être lus. Rechargez la page.
      </p>
    )}
    {nuanciersBase && (
      <div class="grid gap-3 md:grid-cols-2">
        {NUANCIERS_BASE.map((n) => (
          <form method="POST" class="rounded-lg border border-bo-border bg-bo-surface p-4 text-sm">
            {/* L'action vient du bouton cliqué : un champ caché « _action »
                passerait devant celle du bouton dans le formulaire envoyé. */}
            <input type="hidden" name="nuancier" value={n} />
            <h3 class="font-medium">
              {LIBELLES_NUANCIERS_BASE[n]}
              <span class="ml-1 text-xs font-normal text-bo-muted">
                {nuanciersBase!.modifies[n] ? "— vos couleurs" : "— couleurs d'origine"}
              </span>
            </h3>
            <p class="mb-2 text-xs text-bo-muted">{USAGE_NUANCIER[n]}</p>
            <Nuancier
              nom="colors"
              couleurs={nuanciersBase!.nuanciers[n]}
              libelle={`le nuancier « ${LIBELLES_NUANCIERS_BASE[n]} »`}
            />
            <div class="mt-3 flex flex-wrap items-center gap-2">
              <button name="_action" value="nuancier" class="rounded bg-bo-accent px-3 py-1.5 text-white">
                Enregistrer « {LIBELLES_NUANCIERS_BASE[n]} »
              </button>
              {nuanciersBase!.modifies[n] && (
                <button
                  name="_action"
                  value="nuancier-origine"
                  class="rounded border border-bo-border px-3 py-1.5 text-xs hover:bg-bo-bg"
                  onclick={`return confirm(${JSON.stringify(`Remettre le nuancier « ${LIBELLES_NUANCIERS_BASE[n]} » à ses couleurs d'origine ? Vos couleurs seront remplacées ; les commandes déjà passées ne changent pas.`)})`}
                >
                  Revenir aux couleurs d'origine
                </button>
              )}
            </div>
          </form>
        ))}
      </div>
    )}
  </section>

  <script>
    import "../lib/pastilles.ts";
  </script>
</Admin>
