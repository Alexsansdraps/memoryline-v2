---
import { apiInterne } from "../../lib/api-interne.ts";
import { url } from "../../lib/url.ts";
import Admin from "../../layouts/Admin.astro";
import ApercusZones from "../../components/ApercusZones.astro";
import GroupesCouleurs from "../../components/GroupesCouleurs.astro";
import { Y_SOL_PERSONNAGES } from "@memoryline/types";
import {
  adminApi,
  type Asset,
  type CharacterCategory,
  type CharacterType,
  type TypeAffiche,
} from "../../lib/api.ts";

const PUBLIC_API_URL =
  import.meta.env.PUBLIC_API_URL ?? "http://localhost:3000";

const api = adminApi(Astro.request);
const id = Number(Astro.params.id);

/** URL absolue d'un SVG stocké sous « /assets/… ». */
function svgSrc(u: string | null | undefined): string {
  if (!u) return "";
  return u.startsWith("http") ? u : `${PUBLIC_API_URL}${u}`;
}

const SLOTS = [
  { value: "clothes", label: "Vêtements" },
  { value: "pants", label: "Pantalon" },
  { value: "hair", label: "Coupes" },
  { value: "accessory", label: "Accessoires" },
];

let flash: string | null = null;
let erreur: string | null = null;
/**
 * Arrivée depuis la création : le personnage est nu, la suite immédiate est
 * de poser ses pièces dessus. Le calage passe donc en tête de page — le reste
 * (nom, dessin, tri des pièces) attend en dessous.
 */
const sortDeCreation = Astro.url.searchParams.get("cree") === "1";
if (sortDeCreation)
  flash =
    "Personnage créé. Toutes les pièces de son type lui sont proposées : calez-les à la souris ci-dessous, ou retirez d'abord celles qu'il ne portera pas.";

if (Astro.request.method === "POST") {
  const f = await Astro.request.formData();
  const action = f.get("_action");
  try {
    if (action === "archive") {
      await api.archiveCharacter(id, f.get("archived") === "true");
      return Astro.redirect(url("/personnages?archive=1"), 303);
    } else if (action === "pieces-autorisees") {
      const parSlot: Record<string, number[]> = {};
      for (const s of SLOTS) {
        // Un témoin par emplacement : sans lui, tout décocher n'enverrait
        // aucun champ et le serveur croirait l'emplacement inchangé.
        if (f.get(`present-${s.value}`) === null) continue;
        parSlot[s.value] = f
          .getAll(`${s.value}[]`)
          .map(Number)
          .filter(Number.isFinite);
      }
      await api.setSlotVariants(id, parSlot);
      flash = "Pièces autorisées enregistrées.";
    } else {
      await api.upsertCharacter({
        id,
        name: String(f.get("name") || "Personnage"),
        categoryId: f.get("categoryId") ? Number(f.get("categoryId")) : null,
        orientation: String(f.get("orientation") || "front"),
        position: Number(f.get("position") || 0),
        ...(f.get("bottomPct")
          ? { bottomPct: Number(String(f.get("bottomPct")).replace(",", ".")) }
          : {}),
        ...(f.get("facteurTaille")
          ? {
              facteurTaille: Number(
                String(f.get("facteurTaille")).replace(",", "."),
              ),
            }
          : {}),
        // Zéro est une vraie valeur — « au centre » — et doit partir aussi :
        // tester la chaîne vide plutôt que la valeur, sinon ramener un
        // personnage au centre ne s'enregistrerait jamais.
        ...(f.get("decalageX") !== null && String(f.get("decalageX")) !== ""
          ? {
              decalageX: Number(
                String(f.get("decalageX")).replace(",", "."),
              ),
            }
          : {}),
      });
      flash = "Personnage enregistré.";
    }
  } catch (e) {
    erreur = "Erreur : " + String(e);
  }
}

let perso: CharacterType | undefined;
let assets: Asset[] = [];
let toutesCategories: CharacterCategory[] = [];
let vues: TypeAffiche[] = [];
try {
  const data = await api.characters();
  perso = (data.types ?? []).find((t) => t.id === id);
  assets = await api.assets();
  toutesCategories = await api.categories();
  vues = await api.views();
} catch (e) {
  if (!erreur) erreur = String(e);
}
// Les catégories ouvertes, plus celle de ce personnage si elle vient d'être
// archivée : sans elle, le sélecteur retomberait sur « Sans catégorie » et le
// premier enregistrement de la fiche lui ferait perdre son rayon.
const categories = toutesCategories.filter(
  (c) => !c.archivedAt || perso?.categoryId === c.id,
);

const vueDuPerso = perso?.orientation ?? vues[0]?.slug ?? "front";

/**
 * L'avant-plan du type d'affiche de ce personnage : le muret pour un
 * personnage de dos, rien pour un personnage de face. C'est exactement ce que
 * la boutique dessinera devant lui.
 */
const avantPlan = vues.find((v) => v.slug === vueDuPerso)?.foregroundUrl ?? null;

/** Quelques décors réels, pour ne pas calibrer sur un fond blanc. */
interface DecorChoix {
  id: number;
  nom: string;
  url: string;
}
let decors: DecorChoix[] = [];
try {
  const base =
    apiInterne();
  const res = await fetch(`${base}/admin/decors`, {
    headers: { cookie: Astro.request.headers.get("cookie") ?? "" },
  });
  if (res.ok) {
    const d = (await res.json()) as {
      decors: { id: number; nom: string | null; url: string }[];
    };
    decors = d.decors
      .filter((x) => x.url)
      .map((x) => ({ id: x.id, nom: x.nom ?? `Décor ${x.id}`, url: x.url }))
      // Les décors correctement nommés d'abord : ceux sortis de l'ancienne
      // boutique s'appellent « AFFICHES_Villes_2_.pdf.png » et ne montrent
      // rien de reconnaissable. On calibre sur une vraie ville.
      .sort((a, b) => {
        const propre = (n: string) =>
          /\.(pdf|png|jpe?g)/i.test(n) || /_/.test(n) ? 1 : 0;
        return propre(a.nom) - propre(b.nom) || a.nom.localeCompare(b.nom, "fr");
      });
  }
} catch {
  // Sans décors, la calibration se fait sur un fond uni : moins parlant, mais
  // la géométrie reste juste.
}

/* Les constantes du configurateur, recopiées telles quelles. Elles décident
   de la taille et de la place d'un personnage sur l'affiche ; les changer ici
   sans les changer là-bas ferait mentir la calibration. */
const CHAR_BASE_WIDTH = 0.22; // largeur de référence, en fraction de l'affiche
const ECHELLE_SEUL = 0.7; // échelle d'un personnage seul sur l'affiche
// La hauteur où les pieds se posent : la MÊME valeur que la rangée du site,
// partagée plutôt que recopiée. Le site y ajoutait une pente que cet écran
// ignorait — un personnage calé ici ressortait décalé sur la boutique.
const Y_MURET = Y_SOL_PERSONNAGES;

/**
 * Pièces génériques du type d'affiche de CE personnage, par emplacement.
 * Les positions ne valent que dans un type donné : mélanger les types ferait
 * cocher des pièces qui n'existent pas pour lui.
 */
const piecesParSlot = new Map<string, Asset[]>(SLOTS.map((s) => [s.value, []]));
for (const a of assets) {
  if (a.characterTypeId != null || a.archivedAt) continue;
  if ((a.view ?? "front") !== vueDuPerso) continue;
  piecesParSlot.get(a.slot)?.push(a);
}
for (const liste of piecesParSlot.values())
  liste.sort((a, b) => a.position - b.position);

/**
 * Positions autorisées pour un emplacement. `null` ne veut dire « tout » que
 * si le personnage n'a AUCUN réglage : dès qu'il en a un, un emplacement
 * absent est traité comme vide par le site.
 */
function autorisees(slot: string): number[] | null {
  const sv = perso?.slotVariants;
  if (!sv || typeof sv !== "object") return null;
  const v = sv[slot as "clothes"];
  return Array.isArray(v) ? v : [];
}

/** Pièces réellement proposées pour ce personnage — celles à caler. */
const piecesACaler = SLOTS.flatMap((s) => {
  const permis = autorisees(s.value);
  return (piecesParSlot.get(s.value) ?? [])
    .filter((a) => permis === null || permis.includes(a.position))
    .map((a) => ({
      slot: s.value,
      slotLabel: s.label,
      position: a.position,
      name: a.name,
      url: svgSrc(a.svgUrl),
    }));
});
---

<Admin title={perso?.name ?? "Personnage"}>
  <p class="mb-4">
    <a href={url("/personnages")} class="text-bo-accent hover:underline text-sm">
      ← Retour aux personnages
    </a>
  </p>

  {flash && (
    <p class="mb-4 text-sm rounded bg-green-50 border border-green-200 px-3 py-2">
      {flash}
    </p>
  )}
  {erreur && (
    <p class="mb-4 text-sm rounded bg-red-50 border border-red-200 px-3 py-2">
      {erreur}
    </p>
  )}

  {!perso ? (
    <p class="text-bo-muted text-sm">Personnage introuvable.</p>
  ) : (
    <div class="flex flex-col gap-6">
      {/* ---------------------------------------------------------------- */}
      {/* Identité                                                          */}
      {/* ---------------------------------------------------------------- */}
      <section class="bg-bo-surface border border-bo-border rounded-lg p-5">
        <h3 class="font-semibold mb-4">Le personnage</h3>
        <form
          id="fiche-personnage"
          method="POST"
          class="grid sm:grid-cols-4 gap-4 text-sm items-end"
        >
          <label class="block">
            <span class="text-bo-muted">Nom</span>
            <input
              name="name"
              value={perso.name}
              class="mt-1 w-full border border-bo-border rounded px-3 py-2"
            />
          </label>
          <label class="block">
            <span class="text-bo-muted">Catégorie</span>
            <select
              name="categoryId"
              class="mt-1 w-full border border-bo-border rounded px-3 py-2"
            >
              <option value="" selected={perso.categoryId == null}>
                Sans catégorie
              </option>
              {categories.map((c) => (
                <option
                  value={String(c.id)}
                  selected={perso!.categoryId === c.id}
                >
                  {c.name}
                  {c.archivedAt ? " (archivée)" : ""}
                </option>
              ))}
            </select>
          </label>
          <label class="block">
            <span class="text-bo-muted">Type d'affiche</span>
            <select
              name="orientation"
              class="mt-1 w-full border border-bo-border rounded px-3 py-2"
              title="Angle sous lequel ce personnage est dessiné. Il ne portera que des pièces du même type."
            >
              {vues.map((v) => (
                <option value={v.slug} selected={vueDuPerso === v.slug}>
                  {v.name}
                </option>
              ))}
            </select>
          </label>
          <label class="block">
            <span class="text-bo-muted">Ordre</span>
            <input
              name="position"
              type="number"
              value={perso.position}
              class="mt-1 w-full border border-bo-border rounded px-3 py-2"
            />
          </label>
          {/* « Calage au sol » a rejoint le bloc « Taille et calage » : il y
              chiffre le geste qu'on fait sur l'affiche. */}
          <div class="sm:col-span-4">
            <button class="rounded bg-bo-accent text-white px-4 py-2">
              Enregistrer
            </button>
          </div>
        </form>
      </section>

      {/* ---------------------------------------------------------------- */}
      {/* Calibrage en conditions réelles                                   */}
      {/* ---------------------------------------------------------------- */}
      <section class="rounded-lg border border-bo-border bg-bo-surface p-5">
        <h3 class="mb-1 font-semibold">Taille et calage, en conditions réelles</h3>
        <p class="mb-4 max-w-3xl text-sm text-bo-muted">
          Le personnage est posé sur un vrai décor, à la taille exacte qu'il
          aura dans le configurateur{avantPlan ? ", avec le muret devant lui" : ""}.
          Bougez les curseurs, l'affiche se recompose. Puis enregistrez.
        </p>

        <div class="flex flex-wrap items-start gap-6">
          <div
            id="calibrage-scene"
            class="relative w-[420px] max-w-full shrink-0 overflow-hidden rounded border border-bo-border bg-bo-bg shadow-sm"
            style="aspect-ratio: 1 / 1.4142"
            data-base={svgSrc(perso.baseSvgUrl)}
            data-avant-plan={avantPlan ? svgSrc(avantPlan) : ""}
            data-largeur={CHAR_BASE_WIDTH}
            data-echelle={ECHELLE_SEUL}
            data-y={Y_MURET}
          >
            <img id="calibrage-fond" alt="" class="absolute inset-0 h-full w-full object-cover" />
            {/* Le personnage passe DEVANT le rebord, comme sur la boutique. */}
            {/* Silhouette d'un adulte à 100 %, pour comparer à une taille
                connue. Masquée tant qu'on ne la demande pas. */}
            <img
              id="calibrage-repere-img"
              alt=""
              hidden
              class="absolute opacity-30"
              style="z-index: 9; object-fit: contain; filter: grayscale(1)"
            />
            <img
              id="calibrage-perso"
              alt=""
              class="absolute"
              style="z-index: 10; object-fit: contain; cursor: grab; touch-action: none"
            />
            {/* La poignée de taille, au coin haut-droit du personnage. */}
            <button
              type="button"
              id="calibrage-poignee"
              aria-label="Tirer pour changer la taille du personnage"
              title="Tirez pour changer la taille"
              class="absolute rounded-full border-2 border-white bg-bo-accent shadow"
              style="z-index: 20; width: 18px; height: 18px; cursor: nwse-resize; touch-action: none"
            ></button>
            {avantPlan && (
              <img
                id="calibrage-muret"
                src={svgSrc(avantPlan)}
                alt=""
                class="absolute bottom-0 left-0 w-full"
                style="z-index: 5; height: auto"
              />
            )}
            {/* Le texte est à sa vraie place, aux vraies tailles : c'est lui
                qui donne l'échelle de l'affiche, et sans lui un personnage
                paraît toujours bien dimensionné. Les polices de la boutique ne
                sont pas chargées ici, seule la place compte. */}
            <div
              class="pointer-events-none absolute left-0 right-0 text-center"
              style="top: 5%; padding: 0 6%; container-type: inline-size; z-index: 200; color: #1c1c1c"
            >
              <div style="font-family: Georgia, serif; font-size: 8cqw; line-height: 1.05">
                PARIS
              </div>
              <div style="font-family: Georgia, serif; font-size: 5.5cqw; line-height: 1.15">
                Mon amour
              </div>
            </div>
          </div>

          <div class="min-w-[300px] flex-1 space-y-4 text-sm">
            {decors.length > 0 && (
              <label class="block">
                <span class="text-bo-muted">Décor d'essai</span>
                <select
                  id="calibrage-decor"
                  class="mt-1 w-full rounded border border-bo-border px-3 py-2"
                >
                  {decors.map((d) => (
                    <option value={svgSrc(d.url)}>{d.nom}</option>
                  ))}
                </select>
                <span class="mt-1 block text-xs text-bo-muted">
                  Le décor ne change rien au réglage : il sert à juger.
                </span>
              </label>
            )}

            {/* La commande, c'est l'affiche elle-même. Ces champs ne font
                que porter le résultat jusqu'à l'enregistrement. */}
            <input
              id="calibrage-taille"
              name="facteurTaille"
              form="fiche-personnage"
              type="hidden"
              value={perso.facteurTaille ?? 1}
            />
            <input
              id="calibrage-sol"
              type="hidden"
              value={perso.bottomPct ?? 1}
            />
            <input
              id="calibrage-decalage"
              name="decalageX"
              form="fiche-personnage"
              type="hidden"
              value={perso.decalageX ?? 0}
            />

            <div class="rounded-lg border border-bo-border bg-bo-bg p-4">
              <p class="mb-3 font-medium">
                Attrapez le personnage sur l'affiche.
              </p>
              <ul class="space-y-1.5 text-xs text-bo-muted">
                <li>
                  <b class="text-bo-ink">Pour le poser :</b> montez-le ou
                  descendez-le jusqu'à ce que ses pieds touchent le rebord.
                </li>
                <li>
                  <b class="text-bo-ink">Pour le décaler :</b> glissez-le vers
                  la gauche ou la droite. Sur le site, il gardera cet écart
                  par rapport à sa place dans la rangée.
                </li>
                <li>
                  <b class="text-bo-ink">Pour le dimensionner :</b> tirez la
                  poignée ronde, en haut à droite de lui.
                </li>
              </ul>
            </div>

            <div class="flex flex-wrap items-center gap-2">
              <span class="text-bo-muted">Taille :</span>
              <button
                type="button"
                id="calibrage-moins"
                class="h-9 w-9 rounded border border-bo-border text-lg leading-none hover:bg-bo-bg"
                title="Rapetisser de 5 %"
                aria-label="Rapetisser le personnage"
              >
                −
              </button>
              <b id="calibrage-taille-val" class="min-w-[70px] text-center">100 %</b>
              <button
                type="button"
                id="calibrage-plus"
                class="h-9 w-9 rounded border border-bo-border text-lg leading-none hover:bg-bo-bg"
                title="Agrandir de 5 %"
                aria-label="Agrandir le personnage"
              >
                +
              </button>
              <button
                type="button"
                id="calibrage-reset"
                class="rounded border border-bo-border px-3 py-2 text-xs hover:bg-bo-bg"
              >
                Taille d'un adulte
              </button>
            </div>
            <p class="text-xs text-bo-muted">
              100 %, c'est la taille d'un adulte debout. Un chat ou un bébé
              descendent bien plus bas, un couple monte au-dessus.
            </p>

            <div class="flex flex-wrap items-center gap-2">
              <span class="text-bo-muted">Côté :</span>
              <button
                type="button"
                id="calibrage-gauche"
                class="h-9 w-9 rounded border border-bo-border text-lg leading-none hover:bg-bo-bg"
                title="Décaler vers la gauche"
                aria-label="Décaler le personnage vers la gauche"
              >
                ←
              </button>
              <b id="calibrage-decalage-val" class="min-w-[90px] text-center">au centre</b>
              <button
                type="button"
                id="calibrage-droite"
                class="h-9 w-9 rounded border border-bo-border text-lg leading-none hover:bg-bo-bg"
                title="Décaler vers la droite"
                aria-label="Décaler le personnage vers la droite"
              >
                →
              </button>
              <button
                type="button"
                id="calibrage-centre"
                class="rounded border border-bo-border px-3 py-2 text-xs hover:bg-bo-bg"
              >
                Au centre
              </button>
            </div>

            {/* Le chiffre du geste « poser sur le rebord ». Il suit le
                personnage quand on l'attrape, et le personnage le suit quand on
                tape une valeur.

                `step="any"`, et c'est la correction : le geste écrit une valeur
                à quatre décimales, qu'un pas de 0,005 faisait refuser par le
                navigateur — le formulaire ne partait plus, sans rien dire. */}
            <label class="flex flex-wrap items-center gap-2">
              <span class="text-bo-muted">Calage au sol :</span>
              <input
                id="calibrage-sol-chiffre"
                name="bottomPct"
                form="fiche-personnage"
                type="number"
                step="any"
                min="0.05"
                max="1"
                value={perso.bottomPct ?? 1}
                class="w-28 rounded border border-bo-border px-3 py-2"
              />
              <span class="text-xs text-bo-muted">
                Il flotte au-dessus du muret : baissez. Il s'enfonce : montez.
              </span>
            </label>

            <label class="flex items-center gap-2">
              <input id="calibrage-repere" type="checkbox" />
              <span>Comparer à un adulte</span>
            </label>

            {avantPlan ? (
              <label class="flex items-center gap-2">
                <input id="calibrage-rebord" type="checkbox" checked />
                <span>
                  Montrer le rebord — ce personnage est dessiné pour s'y poser
                </span>
              </label>
            ) : (
              <p class="rounded border border-bo-border bg-bo-bg px-3 py-2 text-xs text-bo-muted">
                Ce personnage n'est pas dessiné pour un rebord : son type
                d'affiche n'en a pas. Il se pose directement sur le décor.
              </p>
            )}

            <div class="flex flex-wrap items-center gap-3 border-t border-bo-border pt-3">
              <button
                type="submit"
                form="fiche-personnage"
                class="rounded bg-bo-accent text-white px-4 py-2"
              >
                Enregistrer la calibration
              </button>
              <span class="text-xs text-bo-muted">
                La taille et le calage au sol ne sont gardés qu'une fois ce
                bouton pressé — l'aperçu ci-dessus ne fait que les montrer.
              </span>
            </div>
          </div>
        </div>
      </section>

      {/* ---------------------------------------------------------------- */}
      {/* Dessin de base                                                    */}
      {/* ---------------------------------------------------------------- */}
      <section class="bg-bo-surface border border-bo-border rounded-lg p-5">
        <h3 class="font-semibold mb-4">Dessin</h3>
        <div class="js-base flex flex-wrap items-start gap-4 text-sm">
          <img
            class="js-base-preview h-32 w-20 object-contain border border-bo-border rounded bg-white"
            src={svgSrc(perso.baseSvgUrl)}
            alt=""
            style={perso.baseSvgUrl ? "" : "visibility:hidden"}
          />
          <div class="flex-1 min-w-[280px]">
            <span class="text-bo-muted">SVG du personnage</span>
            <div class="mt-1 flex items-center gap-2">
              <input
                class="js-base-url flex-1 border border-bo-border rounded px-3 py-2 font-mono text-xs"
                value={perso.baseSvgUrl ?? ""}
                placeholder="/assets/Male_2.svg"
              />
              <button
                type="button"
                class="js-base-upload rounded border border-bo-border px-3 py-2 text-xs whitespace-nowrap"
              >
                Remplacer…
              </button>
            </div>
            <div class="js-base-couleurs mt-4">
              <span class="text-bo-muted block mb-1">Couleurs</span>
              <GroupesCouleurs
                mode="personnage"
                apiUrl={PUBLIC_API_URL}
                svgUrl={perso.baseSvgUrl}
                zones={perso.baseColorZones}
                groupes={perso.baseGroupesCouleurs}
                proposees={perso.baseZonesProposees ?? null}
                couleursImage={perso.baseCouleursImage ?? null}
                rappel="Pensez à enregistrer le dessin."
                aide="Seule la première couleur (la peau) est proposée au client, sauf si vous en cochez d'autres : le pelage d'un animal, une robe dessinée sur le personnage… Le nom et le nuancier sont ceux que le client verra. Si le dessin est une image en pixels (une photo, une illustration : les chiens et les chats), ce sont ses couleurs principales qui apparaissent, et RIEN n'est proposé au client tant que vous n'en avez coché aucune."
              />
            </div>
            <div class="mt-3 flex items-center gap-2">
              <button
                type="button"
                class="js-base-save rounded bg-bo-accent text-white px-3 py-1.5 text-xs"
              >
                Enregistrer le dessin
              </button>
              <span class="js-base-status text-xs"></span>
            </div>
          </div>
        </div>
      </section>

      {/* ---------------------------------------------------------------- */}
      {/* Pièces autorisées                                                 */}
      {/* ---------------------------------------------------------------- */}
      <section class="bg-bo-surface border border-bo-border rounded-lg p-5">
        <h3 class="font-semibold mb-1">Pièces autorisées</h3>
        <p class="text-xs text-bo-muted mb-4">
          Décochez ce que ce personnage ne doit pas porter : la pièce disparaît
          de son choix côté site, sans être supprimée pour les autres. Seules
          les pièces du type « {vues.find((v) => v.slug === vueDuPerso)?.name ??
            vueDuPerso} » sont proposées.
        </p>
        <form method="POST">
          <input type="hidden" name="_action" value="pieces-autorisees" />
          {SLOTS.map((s) => {
            const liste = piecesParSlot.get(s.value) ?? [];
            const permis = autorisees(s.value);
            return (
              <fieldset class="mb-4" data-slot={s.value}>
                <input type="hidden" name={`present-${s.value}`} value="1" />
                <legend class="text-xs font-medium mb-1">
                  {s.label}
                  <button
                    type="button"
                    class="js-tout ml-2 font-normal text-bo-muted underline hover:text-bo-accent"
                  >
                    tout
                  </button>
                  <button
                    type="button"
                    class="js-rien ml-2 font-normal text-bo-muted underline hover:text-bo-accent"
                  >
                    rien
                  </button>
                </legend>
                {liste.length === 0 ? (
                  <p class="text-xs text-bo-muted">
                    Aucune pièce de ce type dans la bibliothèque.
                  </p>
                ) : (
                  <div class="flex flex-wrap gap-2">
                    {liste.map((a) => (
                      <label
                        class="flex w-20 cursor-pointer flex-col items-center gap-1 rounded border border-bo-border p-1 text-center hover:border-bo-accent"
                        title={a.name}
                      >
                        <svg viewBox="0 0 500 1000" class="h-12 w-12 bg-white">
                          <image
                            href={svgSrc(a.svgUrl)}
                            x="0"
                            y="0"
                            width="500"
                            height="1000"
                          />
                        </svg>
                        <span class="w-full truncate text-[10px] text-bo-muted">
                          {a.name}
                        </span>
                        <input
                          type="checkbox"
                          name={`${s.value}[]`}
                          value={a.position}
                          checked={permis === null || permis.includes(a.position)}
                        />
                      </label>
                    ))}
                  </div>
                )}
              </fieldset>
            );
          })}
          <button class="rounded bg-bo-accent text-white px-4 py-2 text-sm">
            Enregistrer les pièces
          </button>
        </form>
      </section>

      {/* ---------------------------------------------------------------- */}
      {/* Calage à la souris                                                */}
      {/* ---------------------------------------------------------------- */}
      <section
        id="calage"
        class:list={[
          "bg-bo-surface border border-bo-border rounded-lg p-5",
          // Au sortir de la création, c'est LA chose à faire : elle passe
          // devant tout le reste sans qu'on ait à faire défiler la page.
          sortDeCreation && "order-first ring-2 ring-bo-accent",
        ]}
      >
        <h3 class="font-semibold mb-1">Calage des pièces</h3>
        <p class="text-xs text-bo-muted mb-4">
          Attrapez la pièce et posez-la où il faut. La molette la
          redimensionne. On valide, la suivante s'affiche — et le réglage vaut
          à l'écran comme à l'impression.
        </p>

        <div class="js-calage" data-id={perso.id}>
          <script
            type="application/json"
            class="js-calage-data"
            set:html={JSON.stringify({
              calage: perso.slotAdjust ?? {},
              defaut: perso.defaultAssets ?? {},
              pieces: piecesACaler,
            })}
          />
          <div class="flex flex-wrap gap-6">
            <div
              class="js-scene relative h-[420px] w-[210px] shrink-0 cursor-grab touch-none select-none rounded border border-bo-border bg-white"
            >
              <svg viewBox="0 0 500 1000" class="absolute inset-0 h-full w-full">
                <image
                  href={svgSrc(perso.baseSvgUrl)}
                  x="0"
                  y="0"
                  width="500"
                  height="1000"
                />
              </svg>
              <svg
                viewBox="0 0 500 1000"
                class="js-piece absolute inset-0 h-full w-full"
                style="transform-origin:50% 100%"
              >
                <image
                  class="js-piece-image"
                  x="0"
                  y="0"
                  width="500"
                  height="1000"
                />
              </svg>

              {/* Cadre de transformation, à la manière d'un logiciel de
                  dessin : il épouse le dessin de la pièce (pas le cadre du
                  personnage) et ses quatre coins la redimensionnent. */}
              <div class="js-cadre absolute hidden">
                <div class="pointer-events-none absolute inset-0 border border-dashed border-bo-accent"></div>
                <span
                  class="js-poignee absolute -left-1.5 -top-1.5 h-3 w-3 cursor-nwse-resize rounded-sm border border-white bg-bo-accent"
                  data-coin="nw"
                ></span>
                <span
                  class="js-poignee absolute -right-1.5 -top-1.5 h-3 w-3 cursor-nesw-resize rounded-sm border border-white bg-bo-accent"
                  data-coin="ne"
                ></span>
                <span
                  class="js-poignee absolute -bottom-1.5 -left-1.5 h-3 w-3 cursor-nesw-resize rounded-sm border border-white bg-bo-accent"
                  data-coin="sw"
                ></span>
                <span
                  class="js-poignee absolute -bottom-1.5 -right-1.5 h-3 w-3 cursor-nwse-resize rounded-sm border border-white bg-bo-accent"
                  data-coin="se"
                ></span>
              </div>
            </div>

            <div class="min-w-[280px] flex-1 text-sm">
              <div class="js-titre font-medium"></div>
              <div class="js-progres mb-3 text-xs text-bo-muted"></div>

              <p class="mb-3 text-xs text-bo-muted">
                Glissez la pièce pour la déplacer, tirez un coin du cadre pour
                la redimensionner. Molette et flèches du clavier pour ajuster
                au détail près.
              </p>
              <div class="js-valeurs mb-4 font-mono text-xs text-bo-muted"></div>

              <label class="mb-1 flex items-center gap-2 text-xs">
                <input type="checkbox" class="js-tout-slot" />
                <span>Appliquer à toutes les pièces de cet emplacement</span>
              </label>
              {/* Tenue de départ : un personnage importé nu arrive nu chez le
                  client tant qu'on ne lui en donne pas une. */}
              <label class="mb-3 flex items-center gap-2 text-xs">
                <input type="checkbox" class="js-defaut" />
                <span>
                  Le personnage porte cette pièce par défaut
                  <span class="block text-bo-muted">
                    Ce que le client voit dès qu'il l'ajoute à son affiche. Une
                    seule pièce par emplacement.
                  </span>
                </span>
              </label>

              <div class="flex flex-wrap items-center gap-2 text-xs">
                <button
                  type="button"
                  class="js-precedent rounded border border-bo-border px-2 py-1"
                >
                  Précédente
                </button>
                <button
                  type="button"
                  class="js-valider rounded bg-bo-accent px-3 py-1.5 text-white"
                >
                  Valider et suivante
                </button>
                <button
                  type="button"
                  class="js-passer rounded border border-bo-border px-2 py-1"
                >
                  Passer
                </button>
                <button
                  type="button"
                  class="js-reset text-bo-muted underline hover:text-bo-accent"
                >
                  remettre à zéro
                </button>
                <span class="js-statut text-bo-muted"></span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <form method="POST">
        <input type="hidden" name="_action" value="archive" />
        <input type="hidden" name="archived" value="true" />
        <button class="text-xs text-bo-muted hover:text-bo-accent">
          Archiver ce personnage
        </button>
      </form>
    </div>
  )}

  <script is:inline define:vars={{ PUBLIC_API_URL, ID_PERSO: id }}>
    // --- Pièces autorisées : raccourcis « tout » / « rien » ---------------
    document.addEventListener("click", (e) => {
      const btn = e.target.closest?.(".js-tout, .js-rien");
      if (!btn) return;
      const bloc = btn.closest("fieldset[data-slot]");
      if (!bloc) return;
      const coche = btn.classList.contains("js-tout");
      bloc
        .querySelectorAll('input[type="checkbox"]')
        .forEach((c) => (c.checked = coche));
    });

    // --- Dessin de base : remplacer le SVG, relire ses couleurs -----------
    const base = document.querySelector(".js-base");
    if (base) {
      const champ = base.querySelector(".js-base-url");
      const apercu = base.querySelector(".js-base-preview");
      const couleurs = base.querySelector(".js-base-couleurs .js-groupes");
      const statut = base.querySelector(".js-base-status");
      // Les couleurs telles que l'éditeur les tient : c'est ce qui part à
      // l'enregistrement du dessin.
      let reglages = null;

      couleurs?.addEventListener("groupes:change", (e) => {
        reglages = e.detail;
        // « Détecter les couleurs » a pu préparer une version du dessin à
        // part (couleurs écrites forme par forme) : c'est elle qui s'enregistre.
        if (reglages.svgUrl && reglages.svgUrl !== champ.value.trim()) {
          champ.value = reglages.svgUrl;
          apercu.src = PUBLIC_API_URL + reglages.svgUrl;
          apercu.style.visibility = "visible";
          statut.textContent = "Couleurs relues — pensez à enregistrer.";
        }
      });

      /** Couleurs d'un NOUVEAU dessin : celles de l'ancien n'y voudraient rien dire. */
      function relireCouleurs(url) {
        couleurs?.dispatchEvent(
          new CustomEvent("groupes:detecter", { detail: { url } }),
        );
      }

      champ.addEventListener("change", () => {
        const v = champ.value.trim();
        if (v) relireCouleurs(v);
      });

      base.querySelector(".js-base-upload")?.addEventListener("click", async (e) => {
        const bouton = e.currentTarget;
        const input = document.createElement("input");
        input.type = "file";
        input.accept = ".svg,.png,.jpg,.jpeg,.webp";
        input.addEventListener("change", async () => {
          const file = input.files && input.files[0];
          if (!file) return;
          const avant = bouton.textContent;
          bouton.textContent = "Envoi…";
          bouton.disabled = true;
          try {
            const fd = new FormData();
            fd.append("file", file);
            const res = await fetch(`${PUBLIC_API_URL}/admin/uploads`, {
              method: "POST",
              body: fd,
              credentials: "include",
            });
            const data = await res.json();
            if (!res.ok) throw new Error(data.error || res.status);
            champ.value = data.url;
            apercu.src = PUBLIC_API_URL + data.url;
            apercu.style.visibility = "visible";
            relireCouleurs(data.url);
            statut.textContent = "Dessin remplacé — pensez à enregistrer.";
          } catch (err) {
            alert("Téléversement impossible : " + err);
          } finally {
            bouton.textContent = avant;
            bouton.disabled = false;
          }
        });
        input.click();
      });

      base.querySelector(".js-base-save")?.addEventListener("click", async () => {
        statut.textContent = "Enregistrement…";
        try {
          const res = await fetch(
            `${PUBLIC_API_URL}/admin/characters/${ID_PERSO}/base`,
            {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({
                baseSvgUrl: champ.value.trim() || null,
                // Sans réglage lu (éditeur pas encore prêt), on ne touche pas
                // aux couleurs enregistrées.
                ...(reglages
                  ? {
                      baseColorZones: reglages.colorZones,
                      baseGroupesCouleurs: reglages.groupesCouleurs,
                      baseZonesProposees: reglages.zonesProposees,
                      // Familles de teintes, quand le dessin est une image en
                      // pixels : elles remplacent alors zones et groupes.
                      baseCouleursImage: reglages.couleursImage,
                    }
                  : {}),
              }),
              credentials: "include",
            },
          );
          if (!res.ok) throw new Error(res.status);
          statut.textContent = "Enregistré.";
        } catch (e) {
          statut.textContent = "Échec : " + e;
        }
      });
    }

    // --- Calage à la souris ----------------------------------------------
    // La scène affiche le cadre 500×1000 du personnage : un déplacement de
    // N pixels vaut donc N / largeur (ou hauteur) de la scène, en pourcents —
    // exactement l'unité enregistrée, et celle qu'appliquent le site et le PDF.
    const boite = document.querySelector(".js-calage");
    if (boite) {
      const donnees = JSON.parse(
        boite.querySelector(".js-calage-data")?.textContent || "{}",
      );
      const pieces = donnees.pieces || [];
      const calage = donnees.calage || {};
      const id = boite.getAttribute("data-id");

      const scene = boite.querySelector(".js-scene");
      const vue = boite.querySelector(".js-piece");
      const image = boite.querySelector(".js-piece-image");
      const titre = boite.querySelector(".js-titre");
      const progres = boite.querySelector(".js-progres");
      const valeurs = boite.querySelector(".js-valeurs");
      const statut = boite.querySelector(".js-statut");
      const toutSlot = boite.querySelector(".js-tout-slot");
      const caseDefaut = boite.querySelector(".js-defaut");
      const defaut = donnees.defaut || {};

      let index = 0;
      let etat = { dx: 0, dy: 0, scale: 1 };

      function borne(v, min, max) {
        return Math.min(max, Math.max(min, v));
      }

      function dessiner() {
        vue.style.transform =
          "translate(" + etat.dx + "%, " + etat.dy + "%) scale(" + etat.scale + ")";
        placerCadre();
        valeurs.textContent =
          "décalage " +
          etat.dx.toFixed(1) +
          " % / " +
          etat.dy.toFixed(1) +
          " % · taille " +
          etat.scale.toFixed(2);
      }

      function afficher() {
        if (pieces.length === 0) {
          titre.textContent = "Aucune pièce cochée pour ce personnage.";
          progres.textContent =
            "Cochez d'abord ses pièces ci-dessus, puis enregistrez.";
          image.removeAttribute("href");
          valeurs.textContent = "";
          return;
        }
        const p = pieces[index];
        image.setAttribute("href", p.url);
        void chargerBbox(p.url);
        titre.textContent = p.slotLabel + " — " + (p.name || "sans nom");
        progres.textContent = index + 1 + " / " + pieces.length;
        const c = calage[p.slot + ":" + p.position] || calage[p.slot] || null;
        toutSlot.checked =
          !calage[p.slot + ":" + p.position] && !!calage[p.slot];
        caseDefaut.checked = defaut[p.slot] === p.position;
        etat = c
          ? { dx: c.dx, dy: c.dy, scale: c.scale }
          : { dx: 0, dy: 0, scale: 1 };
        statut.textContent = "";
        dessiner();
      }

      function avancer(pas) {
        if (pieces.length === 0) return;
        index = (index + pas + pieces.length) % pieces.length;
        afficher();
      }

      // --- Cadre de transformation ---------------------------------------
      // Le cadre épouse le DESSIN, pas le cadre 500×1000 du personnage : sans
      // ça, une casquette serait entourée d'une boîte de la taille d'un corps.
      // L'API mesure ce rectangle (analyse du SVG) ; en attendant sa réponse,
      // et si elle échoue, on retombe sur le cadre entier.
      const cadre = boite.querySelector(".js-cadre");
      const bboxes = {};
      const BBOX_PLEINE = { left: 0, top: 0, right: 1, bottom: 1 };
      const bboxCourante = () =>
        (pieces[index] && bboxes[pieces[index].url]) || BBOX_PLEINE;

      async function chargerBbox(url) {
        if (bboxes[url] !== undefined) return;
        bboxes[url] = null; // évite deux appels pour la même pièce
        try {
          const res = await fetch(`${PUBLIC_API_URL}/admin/svg/analyse`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ url }),
            credentials: "include",
          });
          if (!res.ok) return;
          const info = await res.json();
          if (info.bbox) bboxes[url] = info.bbox;
        } catch {
          // Mesure indisponible : le cadre entoure tout le cadre, ça marche
          // quand même.
        } finally {
          placerCadre();
        }
      }

      /**
       * Position d'un point du cadre (en fractions) sur la scène, en pixels,
       * une fois le calage appliqué. Même formule que la transformation CSS :
       * mise à l'échelle depuis le bas-centre, puis translation.
       */
      function versEcran(fx, fy, r) {
        const ox = 0.5 * r.width;
        const oy = 1 * r.height;
        return {
          x: ox + (fx * r.width - ox) * etat.scale + (etat.dx / 100) * r.width,
          y: oy + (fy * r.height - oy) * etat.scale + (etat.dy / 100) * r.height,
        };
      }

      function placerCadre() {
        if (!cadre) return;
        if (pieces.length === 0) {
          cadre.classList.add("hidden");
          return;
        }
        const r = scene.getBoundingClientRect();
        if (!r.width) return;
        const b = bboxCourante();
        const a = versEcran(b.left, b.top, r);
        const c2 = versEcran(b.right, b.bottom, r);
        cadre.classList.remove("hidden");
        cadre.style.left = Math.min(a.x, c2.x) + "px";
        cadre.style.top = Math.min(a.y, c2.y) + "px";
        cadre.style.width = Math.abs(c2.x - a.x) + "px";
        cadre.style.height = Math.abs(c2.y - a.y) + "px";
      }

      // Glisser : la pièce se déplace ; par un coin, elle se redimensionne en
      // gardant le coin opposé en place — le geste attendu d'un cadre.
      let attrape = null;
      scene.addEventListener("pointerdown", (e) => {
        if (pieces.length === 0) return;
        const poignee = e.target.closest(".js-poignee");
        const r = scene.getBoundingClientRect();
        if (poignee) {
          const coin = poignee.dataset.coin;
          const b = bboxCourante();
          // Coin tiré et coin opposé, en fractions du cadre.
          const tire = {
            x: coin === "nw" || coin === "sw" ? b.left : b.right,
            y: coin === "nw" || coin === "ne" ? b.top : b.bottom,
          };
          const ancre = {
            x: coin === "nw" || coin === "sw" ? b.right : b.left,
            y: coin === "nw" || coin === "ne" ? b.bottom : b.top,
          };
          // En pixels, à l'échelle 1 : le vecteur ancre → coin tiré.
          const v = {
            x: (tire.x - ancre.x) * r.width,
            y: (tire.y - ancre.y) * r.height,
          };
          attrape = {
            mode: "taille",
            ancre,
            v,
            ancreEcran: versEcran(ancre.x, ancre.y, r),
            scale0: etat.scale,
            dx0: etat.dx,
            dy0: etat.dy,
          };
        } else {
          attrape = {
            mode: "deplacer",
            x: e.clientX,
            y: e.clientY,
            dx: etat.dx,
            dy: etat.dy,
          };
          scene.style.cursor = "grabbing";
        }
        scene.setPointerCapture(e.pointerId);
        e.preventDefault();
      });

      scene.addEventListener("pointermove", (e) => {
        if (!attrape) return;
        const r = scene.getBoundingClientRect();
        if (attrape.mode === "deplacer") {
          etat.dx = borne(
            attrape.dx + ((e.clientX - attrape.x) / r.width) * 100,
            -50,
            50,
          );
          etat.dy = borne(
            attrape.dy + ((e.clientY - attrape.y) / r.height) * 100,
            -50,
            50,
          );
        } else {
          // Échelle : projection du curseur sur la diagonale du cadre, pour
          // que le coin suive la souris sans jamais déformer le dessin.
          const q = {
            x: e.clientX - r.left - (attrape.ancreEcran.x - 0),
            y: e.clientY - r.top - (attrape.ancreEcran.y - 0),
          };
          const v = attrape.v;
          const norme = v.x * v.x + v.y * v.y;
          if (!norme) return;
          const s = borne((q.x * v.x + q.y * v.y) / norme, 0.4, 2);
          // Le coin opposé ne bouge pas : on rattrape l'écart par la
          // translation, sinon la pièce s'échapperait à chaque coup.
          etat.dx = borne(
            attrape.dx0 + (attrape.ancre.x - 0.5) * (attrape.scale0 - s) * 100,
            -50,
            50,
          );
          etat.dy = borne(
            attrape.dy0 + (attrape.ancre.y - 1) * (attrape.scale0 - s) * 100,
            -50,
            50,
          );
          etat.scale = s;
        }
        dessiner();
      });

      const lacher = (e) => {
        if (!attrape) return;
        attrape = null;
        scene.style.cursor = "grab";
        try {
          scene.releasePointerCapture(e.pointerId);
        } catch {}
      };
      scene.addEventListener("pointerup", lacher);
      scene.addEventListener("pointercancel", lacher);
      window.addEventListener("resize", placerCadre);

      // Molette = taille. `passive: false` sinon le navigateur refuse qu'on
      // empêche le défilement de la page sous le curseur.
      scene.addEventListener(
        "wheel",
        (e) => {
          if (pieces.length === 0) return;
          e.preventDefault();
          etat.scale = borne(
            Number((etat.scale * (1 - e.deltaY * 0.0015)).toFixed(3)),
            0.4,
            2,
          );
          dessiner();
        },
        { passive: false },
      );

      // Clavier : l'ajustement au pixel près, quand la souris est trop
      // grossière. La scène est focusable pour ça.
      scene.tabIndex = 0;
      scene.addEventListener("keydown", (e) => {
        const pas = e.shiftKey ? 2 : 0.25;
        if (e.key === "ArrowLeft") etat.dx = borne(etat.dx - pas, -50, 50);
        else if (e.key === "ArrowRight") etat.dx = borne(etat.dx + pas, -50, 50);
        else if (e.key === "ArrowUp") etat.dy = borne(etat.dy - pas, -50, 50);
        else if (e.key === "ArrowDown") etat.dy = borne(etat.dy + pas, -50, 50);
        else if (e.key === "+" || e.key === "=")
          etat.scale = borne(etat.scale + 0.02, 0.4, 2);
        else if (e.key === "-")
          etat.scale = borne(etat.scale - 0.02, 0.4, 2);
        else return;
        e.preventDefault();
        dessiner();
      });

      boite.querySelector(".js-reset")?.addEventListener("click", () => {
        etat = { dx: 0, dy: 0, scale: 1 };
        dessiner();
      });
      boite.querySelector(".js-passer")?.addEventListener("click", () => avancer(1));
      boite
        .querySelector(".js-precedent")
        ?.addEventListener("click", () => avancer(-1));

      boite.querySelector(".js-valider")?.addEventListener("click", async (e) => {
        if (pieces.length === 0) return;
        const bouton = e.currentTarget;
        const p = pieces[index];
        const valeur = {
          dx: Number(etat.dx.toFixed(2)),
          dy: Number(etat.dy.toFixed(2)),
          scale: Number(etat.scale.toFixed(3)),
        };
        // « Tout l'emplacement » écrit sous la clé du slot ET neutralise le
        // réglage propre à la pièce : sinon ce dernier gagnerait et le geste
        // n'aurait aucun effet visible.
        const corps = toutSlot.checked
          ? { [p.slot]: valeur, [p.slot + ":" + p.position]: { dx: 0, dy: 0, scale: 1 } }
          : { [p.slot + ":" + p.position]: valeur };
        bouton.disabled = true;
        statut.textContent = "Enregistrement…";
        try {
          const res = await fetch(
            `${PUBLIC_API_URL}/admin/characters/${id}/slot-adjust`,
            {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify(corps),
              credentials: "include",
            },
          );
          const data = await res.json();
          if (!res.ok) throw new Error(data.error || res.status);
          for (const cle of Object.keys(calage)) delete calage[cle];
          Object.assign(calage, data.slotAdjust || {});

          // Tenue par défaut : cochée, cette pièce devient celle portée
          // d'emblée pour son emplacement ; décochée alors qu'elle l'était,
          // l'emplacement redevient vide. Un seul choix par emplacement, donc
          // on écrase sans se poser de question.
          const etaitDefaut = defaut[p.slot] === p.position;
          if (caseDefaut.checked !== etaitDefaut) {
            const res2 = await fetch(
              `${PUBLIC_API_URL}/admin/characters/${id}/default-assets`,
              {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                  [p.slot]: caseDefaut.checked ? p.position : null,
                }),
                credentials: "include",
              },
            );
            const data2 = await res2.json();
            if (!res2.ok) throw new Error(data2.error || res2.status);
            for (const cle of Object.keys(defaut)) delete defaut[cle];
            Object.assign(defaut, data2.defaultAssets || {});
          }

          statut.textContent = "Enregistré.";
          avancer(1);
        } catch (err) {
          statut.textContent = "Échec : " + err;
        } finally {
          bouton.disabled = false;
        }
      });

      afficher();
    }
  </script>

  <script is:inline>
    /*
     * Le calibrage, en conditions réelles.
     *
     * La géométrie est celle du configurateur, recopiée :
     *   largeur du cadre = 22 % × échelle × facteur de taille
     *   hauteur du cadre = largeur × 2 (le cadre est deux fois plus haut que
     *     large), puis rapportée à la hauteur de l'affiche : × √2
     *   descente = (1 − calage au sol) × hauteur du cadre
     * Le personnage est centré sur (0,5 ; 0,816 + descente), comme un
     * personnage seul posé sur le muret.
     */
    (function () {
      const scene = document.getElementById("calibrage-scene");
      if (!scene) return;
      const perso = document.getElementById("calibrage-perso");
      const fond = document.getElementById("calibrage-fond");
      const decor = document.getElementById("calibrage-decor");
      const taille = document.getElementById("calibrage-taille");
      const sol = document.getElementById("calibrage-sol");
      const tailleVal = document.getElementById("calibrage-taille-val");
      const poignee = document.getElementById("calibrage-poignee");
      const repere = document.getElementById("calibrage-repere");
      const repereImg = document.getElementById("calibrage-repere-img");
      const champSol = document.querySelector('input[name="bottomPct"]');
      const decalage = document.getElementById("calibrage-decalage");
      const decalageVal = document.getElementById("calibrage-decalage-val");

      const LARGEUR = Number(scene.dataset.largeur || 0.22);
      const ECHELLE = Number(scene.dataset.echelle || 0.7);
      const Y = Number(scene.dataset.y || 0.816);

      perso.src = scene.dataset.base || "";
      if (!scene.dataset.base) perso.style.visibility = "hidden";
      if (decor && decor.value) fond.src = decor.value;

      function dessiner() {
        const f = Number(taille.value);
        const bp = Number(sol.value);
        // L'écart de côté, en points de largeur d'affiche.
        const dx = decalage ? Number(decalage.value) || 0 : 0;
        const centreX = 50 + dx * 100;
        // Largeur du cadre en % de la largeur d'affiche.
        const largeurPct = LARGEUR * ECHELLE * f * 100;
        // Hauteur du cadre en % de la HAUTEUR d'affiche (aspect 1:2, page √2).
        const hauteurPct = largeurPct * Math.SQRT2;
        const descente = (1 - bp) * hauteurPct;
        perso.style.width = largeurPct + "%";
        perso.style.height = hauteurPct + "%";
        perso.style.left = centreX + "%";
        perso.style.top = Y * 100 + descente + "%";
        perso.style.transform = "translate(-50%, -50%)";
        // La poignée suit le coin haut-droit du personnage.
        if (poignee) {
          poignee.style.left = centreX + largeurPct / 2 + "%";
          poignee.style.top = Y * 100 + descente - hauteurPct / 2 + "%";
          poignee.style.transform = "translate(-50%, -50%)";
        }
        // La silhouette de comparaison : un adulte à 100 %, posé au même
        // endroit, pour juger d'une taille connue plutôt que dans le vide.
        if (repereImg && !repereImg.hidden) {
          const lRep = LARGEUR * ECHELLE * 100;
          const hRep = lRep * Math.SQRT2;
          repereImg.style.width = lRep + "%";
          repereImg.style.height = hRep + "%";
          repereImg.style.left = centreX - largeurPct / 2 - lRep / 2 - 2 + "%";
          repereImg.style.top = Y * 100 + (1 - bp) * hRep + "%";
          repereImg.style.transform = "translate(-50%, -50%)";
        }
        tailleVal.textContent = Math.round(f * 100) + " %";
        if (decalageVal) {
          const pts = Math.round(Math.abs(dx) * 100);
          decalageVal.textContent =
            pts === 0 ? "au centre" : pts + " % " + (dx < 0 ? "à gauche" : "à droite");
        }
        // Le champ chiffré du bloc du dessus reste la source enregistrée pour
        // le calage : deux endroits qui diraient deux choses se
        // contrediraient tôt ou tard.
        if (champSol) champSol.value = bp.toFixed(4);
      }

      /** Borne une valeur, comme la base le fera de toute façon. */
      const borner = (v, min, max) => Math.min(max, Math.max(min, v));

      /* --- Attraper le personnage : le poser sur le rebord --------------- */
      perso.addEventListener("pointerdown", function (ev) {
        ev.preventDefault();
        // Capturer le pointeur garde le geste même si le doigt sort de
        // l'image. Si le navigateur refuse, on continue sans : un réglage qui
        // marche moins bien vaut mieux qu'un réglage qui ne marche pas.
        try {
          perso.setPointerCapture(ev.pointerId);
        } catch {}
        perso.style.cursor = "grabbing";
        const depart = ev.clientY;
        const departX = ev.clientX;
        const bpDepart = Number(sol.value);
        const dxDepart = decalage ? Number(decalage.value) || 0 : 0;
        const boite = scene.getBoundingClientRect();
        // Hauteur du cadre du personnage, en fraction de la hauteur d'affiche.
        const hauteurCadre =
          LARGEUR * ECHELLE * Number(taille.value) * Math.SQRT2;

        const bouger = (e) => {
          // Monter à l'écran = remonter le dessin dans son cadre.
          const d = (e.clientY - depart) / boite.height;
          sol.value = String(borner(bpDepart - d / hauteurCadre, 0.05, 1));
          // Le côté suit le doigt au pixel près : contrairement à la taille,
          // une position se lit directement sur l'affiche, sans amortir.
          if (decalage) {
            const ddx = (e.clientX - departX) / boite.width;
            decalage.value = String(borner(dxDepart + ddx, -0.4, 0.4));
          }
          dessiner();
        };
        const lacher = () => {
          perso.style.cursor = "grab";
          perso.removeEventListener("pointermove", bouger);
          perso.removeEventListener("pointerup", lacher);
          perso.removeEventListener("pointercancel", lacher);
        };
        perso.addEventListener("pointermove", bouger);
        perso.addEventListener("pointerup", lacher);
        perso.addEventListener("pointercancel", lacher);
      });

      /* --- Tirer la poignée : changer la taille -------------------------- */
      poignee?.addEventListener("pointerdown", function (ev) {
        ev.preventDefault();
        try {
          poignee.setPointerCapture(ev.pointerId);
        } catch {}
        const boite = scene.getBoundingClientRect();
        const departX = ev.clientX;
        const facteurDepart = Number(taille.value);

        const bouger = (e) => {
          // On écarte pour agrandir, on rapproche pour rapetisser. Le geste
          // est AMORTI : coller la poignée au doigt rendrait le réglage
          // inutilisable, parce qu'un personnage n'occupe que quinze pour cent
          // de la largeur — trente pixels doubleraient sa taille. Ici,
          // traverser la moitié de l'affiche change la taille de moitié.
          const d = (e.clientX - departX) / boite.width;
          taille.value = String(borner(facteurDepart + d, 0.3, 2));
          dessiner();
        };
        const lacher = () => {
          poignee.removeEventListener("pointermove", bouger);
          poignee.removeEventListener("pointerup", lacher);
          poignee.removeEventListener("pointercancel", lacher);
        };
        poignee.addEventListener("pointermove", bouger);
        poignee.addEventListener("pointerup", lacher);
        poignee.addEventListener("pointercancel", lacher);
      });

      /* --- Les boutons, pour finir au détail près ------------------------ */
      const pas = (facteur) => {
        taille.value = String(borner(Number(taille.value) * facteur, 0.3, 2));
        dessiner();
      };
      document
        .getElementById("calibrage-moins")
        ?.addEventListener("click", () => pas(0.95));
      document
        .getElementById("calibrage-plus")
        ?.addEventListener("click", () => pas(1 / 0.95));
      document
        .getElementById("calibrage-reset")
        ?.addEventListener("click", function () {
          taille.value = "1";
          dessiner();
        });

      /* --- Le calage au sol, tapé au clavier ----------------------------- */
      // Le champ chiffré et le geste se tiennent à jour : dessiner() écrit la
      // valeur du geste dans le champ, et une valeur tapée repose le
      // personnage. Une saisie incomplète (« 0, ») ne déplace rien tant
      // qu'elle n'est pas un nombre.
      champSol?.addEventListener("input", function () {
        const v = Number(String(champSol.value).replace(",", "."));
        if (!Number.isFinite(v)) return;
        sol.value = String(borner(v, 0.05, 1));
        dessiner();
      });

      /* --- Le côté, au détail près --------------------------------------- */
      // Un point de largeur d'affiche par clic : assez fin pour ajuster, assez
      // franc pour qu'on voie le personnage bouger.
      const decaler = (delta) => {
        if (!decalage) return;
        decalage.value = String(
          borner((Number(decalage.value) || 0) + delta, -0.4, 0.4),
        );
        dessiner();
      };
      document
        .getElementById("calibrage-gauche")
        ?.addEventListener("click", () => decaler(-0.01));
      document
        .getElementById("calibrage-droite")
        ?.addEventListener("click", () => decaler(0.01));
      document
        .getElementById("calibrage-centre")
        ?.addEventListener("click", function () {
          if (decalage) decalage.value = "0";
          dessiner();
        });

      /* --- La silhouette de comparaison ---------------------------------- */
      repere?.addEventListener("change", function () {
        repereImg.hidden = !repere.checked;
        if (repere.checked && !repereImg.src)
          repereImg.src = scene.dataset.base || "";
        dessiner();
      });

      // Le champ chiffré du bloc du dessus peut encore être saisi à la main :
      // il reste la référence, et l'affiche le suit.
      if (champSol)
        champSol.addEventListener("input", function () {
          const v = Number(String(champSol.value).replace(",", "."));
          if (Number.isFinite(v) && v >= 0.05 && v <= 1) {
            sol.value = String(v);
            dessiner();
          }
        });
      decor?.addEventListener("change", function () {
        fond.src = decor.value;
      });

      // Le rebord se montre et se cache : c'est en le retirant qu'on voit si
      // le personnage tient debout tout seul, et en le remettant qu'on juge
      // s'il s'y pose bien.
      const rebord = document.getElementById("calibrage-rebord");
      const muret = document.getElementById("calibrage-muret");
      if (rebord && muret)
        rebord.addEventListener("change", function () {
          muret.hidden = !rebord.checked;
        });

      dessiner();
    })();
  </script>

  {/* Vignettes des couleurs du dessin (éditeur des groupes). */}
  <ApercusZones />
</Admin>
