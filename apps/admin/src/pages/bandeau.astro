---
/**
 * Le bandeau d'annonce : les messages qui défilent tout en haut du site.
 *
 * « Le bandeau ne doit pas du tout être lié aux promos… Le bandeau c'est
 * juste un texte et un bouton. Et il faut pouvoir en mettre plusieurs qui
 * défilent. » (Margaux). L'écran enregistrait le message ET la remise qu'il
 * annonçait, allumait et éteignait les deux ensemble : il ne touche plus à
 * aucune promotion. Les offres se règlent dans Promotions, et un message qui
 * en parle se réécrit ici, à la main, comme n'importe quel texte.
 *
 * Un message : un texte, un bouton facultatif (texte et adresse), allumé ou
 * non, des dates facultatives, une place dans le défilement — rangée à la
 * poignée ou aux flèches (lib/rangement.ts). Les couleurs et la durée de
 * chaque message valent pour tout le bandeau. Rien ne se supprime : un
 * message s'archive, et revient par « Restaurer ».
 */
import Admin from "../layouts/Admin.astro";
import Traductions from "../components/Traductions.astro";
import { url } from "../lib/url.ts";
import { adminApi, type Banner, type BannerBo, type ReglagesBandeau } from "../lib/api.ts";
import {
  traiterTraductions,
  type ChampTraduit,
  type ElementTraduit,
  type EtatTraductions,
} from "../lib/traductions.ts";

const api = adminApi(Astro.request);

let flash: string | null = null;
let flashErreur = false;

/** Ce qui se traduit d'un message : son texte et celui de son bouton. */
const CHAMPS_BANDEAU: ChampTraduit[] = [
  { cle: "message", libelle: "Message", max: 500 },
  { cle: "linkLabel", libelle: "Texte du bouton", max: 120 },
];
const elementTraduit = (m: Banner): ElementTraduit => ({
  id: m.id,
  libelle: m.message,
  francais: { message: m.message, linkLabel: m.linkLabel },
  translations: m.translations,
});

/** Un champ date-heure (heure de Paris, celle du serveur) vers ISO, ou rien. */
function quandOuRien(v: FormDataEntryValue | null): string | null {
  const s = String(v ?? "").trim();
  if (!s) return null;
  const d = new Date(s);
  return Number.isNaN(d.getTime()) ? null : d.toISOString();
}

/** Une date pour un champ `datetime-local` (qui n'accepte pas le fuseau). */
function pourChamp(iso: string | null | undefined): string {
  if (!iso) return "";
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return "";
  const p = (n: number) => String(n).padStart(2, "0");
  return `${d.getFullYear()}-${p(d.getMonth() + 1)}-${p(d.getDate())}T${p(d.getHours())}:${p(d.getMinutes())}`;
}

/** Le message en cours de saisie, tel que le formulaire le montre. */
interface SaisieMessage {
  id: number | null;
  message: string;
  linkLabel: string;
  linkUrl: string;
  active: boolean;
  startsAt: string;
  endsAt: string;
}
const NOUVEAU: SaisieMessage = {
  id: null,
  message: "",
  linkLabel: "",
  linkUrl: "",
  active: true,
  startsAt: "",
  endsAt: "",
};
/** Le formulaire refusé, à remontrer tel qu'il a été saisi. */
let saisieRefusee: SaisieMessage | null = null;
/** Propositions de traduction à relire, saisie à réafficher, et bloc ouvert. */
let tradBandeau: EtatTraductions | null = null;

if (Astro.request.method === "POST") {
  const f = await Astro.request.formData();
  const action = String(f.get("_action") ?? "");
  const id = Number(f.get("id"));
  try {
    if (action === "bandeau-traductions" || action === "bandeau-traduire") {
      const ecranActuel = await api.bannerBo();
      tradBandeau = await traiterTraductions(
        action === "bandeau-traductions" ? "enregistrer" : "proposer",
        f,
        ecranActuel.messages.filter((m) => !m.archivedAt).map(elementTraduit),
        CHAMPS_BANDEAU,
        (idMessage, lang, modifies) => api.setBannerTranslation(Number(idMessage), { lang, ...modifies }),
        (lang, champs) => api.proposerTraduction(lang, champs),
      );
      flash = tradBandeau.message;
      flashErreur = tradBandeau.erreur;
    } else if (action === "message") {
      const texte = (n: string) => String(f.get(n) ?? "").trim();
      saisieRefusee = {
        id: texte("id") ? Number(texte("id")) : null,
        message: texte("message"),
        linkLabel: texte("linkLabel"),
        linkUrl: texte("linkUrl"),
        active: f.get("active") === "on",
        startsAt: texte("startsAt"),
        endsAt: texte("endsAt"),
      };
      const m = await api.upsertBanner({
        ...(saisieRefusee.id ? { id: saisieRefusee.id } : {}),
        message: saisieRefusee.message,
        linkLabel: saisieRefusee.linkLabel || null,
        linkUrl: saisieRefusee.linkUrl || null,
        active: saisieRefusee.active,
        startsAt: quandOuRien(saisieRefusee.startsAt),
        endsAt: quandOuRien(saisieRefusee.endsAt),
      });
      saisieRefusee = null;
      flash = m.active
        ? "Message enregistré. Il défile en haut du site pendant ses dates."
        : "Message enregistré, éteint : il ne s'affiche pas tant qu'il n'est pas allumé.";
    } else if (action === "toggle") {
      const m = await api.basculerMessageBandeau(id);
      flash = m.active ? "Message allumé." : "Message éteint : il ne s'affiche plus sur le site.";
    } else if (action === "archiver" || action === "restaurer") {
      await api.archiverMessageBandeau(id, action === "archiver");
      flash =
        action === "archiver"
          ? "Message archivé : il a quitté le site. Il se retrouve plus bas, dans « Messages archivés »."
          : "Message restauré, éteint, en fin de défilement : rallumez-le quand il doit reparaître.";
    } else if (action === "ordre") {
      const ids = String(f.get("ordre") ?? "")
        .split(",")
        .map((x) => Number(x))
        .filter((x) => Number.isInteger(x) && x > 0);
      await api.ordreBandeau(ids);
      flash = "Ordre enregistré : les messages défilent dans cet ordre.";
    } else if (action === "reglages") {
      const r: ReglagesBandeau = {
        fond: String(f.get("fond") ?? ""),
        texte: String(f.get("texte") ?? ""),
        dureeSecondes: Number(f.get("dureeSecondes")),
      };
      await api.reglagesBandeau(r);
      flash = "Couleurs et défilement enregistrés.";
    } else {
      throw new Error("Action inconnue. Rechargez la page.");
    }
  } catch (e) {
    flash = (e instanceof Error ? e.message : String(e)).replace(/^Error:\s*/, "");
    flashErreur = true;
  }
}

let ecran: BannerBo | null = null;
let erreur: string | null = null;
try {
  ecran = await api.bannerBo();
} catch (e) {
  erreur = e instanceof Error ? e.message : String(e);
}
const messages = (ecran?.messages ?? []).filter((m) => !m.archivedAt);
const archives = (ecran?.messages ?? []).filter((m) => m.archivedAt);
const reglages: ReglagesBandeau = ecran?.reglages ?? {
  fond: "#20211f",
  texte: "#f7f3ec",
  dureeSecondes: 6,
};

/** Le message ouvert dans le formulaire (?modifier=12), s'il y en a un. */
const idModifie = Number(Astro.url.searchParams.get("modifier"));
const modifie = messages.find((m) => m.id === idModifie) ?? null;
const saisie: SaisieMessage =
  saisieRefusee ??
  (modifie
    ? {
        id: modifie.id,
        message: modifie.message,
        linkLabel: modifie.linkLabel ?? "",
        linkUrl: modifie.linkUrl ?? "",
        active: modifie.active,
        startsAt: pourChamp(modifie.startsAt),
        endsAt: pourChamp(modifie.endsAt),
      }
    : NOUVEAU);

/** Où en est un message, en un mot, et sa couleur. */
function etat(m: Banner): { mot: string; ton: string } {
  const maintenant = Date.now();
  if (!m.active) return { mot: "Éteint", ton: "bg-bo-bg text-bo-muted" };
  if (m.endsAt && new Date(m.endsAt).getTime() < maintenant)
    return { mot: "Terminé", ton: "bg-amber-100 text-amber-900" };
  if (m.startsAt && new Date(m.startsAt).getTime() > maintenant)
    return { mot: "Programmé", ton: "bg-blue-100 text-blue-800" };
  return { mot: "En ligne", ton: "bg-green-100 text-green-800" };
}

/** La période d'un message, en une ligne. */
function periode(m: Banner): string {
  const jour = (iso: string) =>
    new Date(iso).toLocaleString("fr-FR", { day: "numeric", month: "short", hour: "2-digit", minute: "2-digit" });
  if (m.startsAt && m.endsAt) return `du ${jour(m.startsAt)} au ${jour(m.endsAt)}`;
  if (m.startsAt) return `à partir du ${jour(m.startsAt)}`;
  if (m.endsAt) return `jusqu'au ${jour(m.endsAt)}`;
  return "sans limite de dates";
}

const enLigne = messages.filter((m) => etat(m).mot === "En ligne").length;
const DUREES = Array.from({ length: 12 }, (_, i) => i + 4);

const champ = "mt-1 w-full rounded border border-bo-border bg-bo-surface px-3 py-2 text-sm";
const boutonOutil =
  "flex h-6 w-6 items-center justify-center rounded border border-bo-border text-xs text-bo-muted hover:bg-bo-bg disabled:cursor-default disabled:opacity-30";
const boutonLien = "text-bo-accent hover:underline";
---

<Admin title="Bandeau d'annonce">
  {flash && (
    <p
      role="status"
      class={`mb-4 rounded border px-3 py-2 text-sm ${
        flashErreur
          ? "border-red-300 bg-red-50 text-red-800"
          : "border-green-300 bg-green-50 text-green-800"
      }`}
    >
      {flash}
    </p>
  )}
  {erreur && <p class="mb-4 text-sm text-red-600">API injoignable : {erreur}</p>}

  <p class="mb-4 max-w-3xl text-sm text-bo-muted">
    Les messages qui défilent tout en haut du site, l'un après l'autre. Un
    message, c'est un texte et, si vous le voulez, un bouton qui mène à une
    page. Le bandeau n'applique aucune remise : les offres se règlent dans
    <a href={url("/promotions")} class="underline">Promotions</a>. Quand une
    offre change ou s'arrête, pensez à réécrire ou à éteindre le message qui
    l'annonce.
  </p>

  {/* --- Les messages ---------------------------------------------------- */}
  <section id="messages" class="mb-6 overflow-hidden rounded-lg border border-bo-border bg-bo-surface">
    <form
      method="POST"
      id="form-ordre"
      class="flex flex-wrap items-center justify-between gap-3 border-b border-bo-border px-4 py-3"
    >
      <input type="hidden" name="_action" value="ordre" />
      <input type="hidden" name="ordre" data-rangement-champ />
      {/* Où le message déplacé est arrivé, dit au lecteur d'écran. */}
      <p class="sr-only" aria-live="polite" data-rangement-annonce></p>
      <div class="max-w-3xl text-xs text-bo-muted">
        <h2 class="mb-1 text-sm font-semibold text-bo-ink">Les messages</h2>
        <p>
          Ils défilent dans cet ordre. Pour le changer, attrapez la poignée ⠿
          ou utilisez les flèches, puis enregistrez.
          {messages.length > 0 &&
            (enLigne === 0
              ? " Aucun n'est en ligne en ce moment : le bandeau n'apparaît pas sur le site."
              : enLigne === 1
                ? " Un seul est en ligne : il reste affiché, sans défiler."
                : ` ${enLigne} sont en ligne : ils défilent.`)}
        </p>
      </div>
      <button
        data-rangement-bouton
        disabled
        class="rounded bg-bo-nav px-3 py-1.5 text-sm text-white disabled:cursor-not-allowed disabled:opacity-40"
      >
        Enregistrer l'ordre
      </button>
    </form>
    <div class="overflow-x-auto">
      <table class="w-full text-sm" data-sans-tri>
        <thead class="bg-bo-bg text-left text-bo-muted">
          <tr>
            <th class="w-28 px-4 py-2 font-medium">Ordre</th>
            <th class="px-4 py-2 font-medium">Message</th>
            <th class="px-4 py-2 font-medium">Bouton</th>
            <th class="px-4 py-2 font-medium">Affichage</th>
            <th class="px-4 py-2"><span class="sr-only">Actions</span></th>
          </tr>
        </thead>
        <tbody data-rangement="form-ordre">
          {messages.map((m, i) => {
            const e = etat(m);
            return (
              <tr id={`message-${m.id}`} data-rang-id={m.id} data-rang-nom={`« ${m.message} »`} class="border-t border-bo-border align-top">
                <td class="px-4 py-3 whitespace-nowrap">
                  <span class="flex items-center gap-1.5">
                    <span class="ml-poignee cursor-grab select-none text-bo-muted" title="Glissez pour changer la place" aria-hidden="true">⠿</span>
                    <span data-rang class="w-5 text-right text-xs tabular-nums text-bo-muted">{i + 1}</span>
                    {/* Nommés par le message, pas par leur numéro : le numéro
                        change à chaque déplacement, le libellé resterait faux. */}
                    <button type="button" data-monter class={boutonOutil} title="Monter d'un cran" aria-label={`Monter « ${m.message} »`}>↑</button>
                    <button type="button" data-descendre class={boutonOutil} title="Descendre d'un cran" aria-label={`Descendre « ${m.message} »`}>↓</button>
                  </span>
                </td>
                <td class="px-4 py-3">
                  <span
                    class="inline-block rounded px-2 py-1 text-[13px] font-semibold tracking-[0.02em]"
                    style={`background:${reglages.fond};color:${reglages.texte}`}
                  >
                    {m.message}
                  </span>
                </td>
                <td class="px-4 py-3">
                  {m.linkLabel && m.linkUrl ? (
                    <span>
                      <span class="font-medium">{m.linkLabel}</span>
                      <span class="block text-xs text-bo-muted">{m.linkUrl}</span>
                    </span>
                  ) : (
                    <span class="text-bo-muted">Sans bouton</span>
                  )}
                </td>
                <td class="px-4 py-3">
                  <span class={`inline-block rounded px-2 py-0.5 text-xs ${e.ton}`}>{e.mot}</span>
                  <span class="mt-1 block text-xs text-bo-muted">{periode(m)}</span>
                </td>
                <td class="px-4 py-3">
                  <div class="flex flex-wrap justify-end gap-3 whitespace-nowrap">
                    <a href={`${url("/bandeau")}?modifier=${m.id}#formulaire`} class={boutonLien}>Modifier</a>
                    <form method="POST" class="inline">
                      <input type="hidden" name="_action" value="toggle" />
                      <input type="hidden" name="id" value={m.id} />
                      <button class={boutonLien}>{m.active ? "Éteindre" : "Allumer"}</button>
                    </form>
                    <form method="POST" class="inline">
                      <input type="hidden" name="_action" value="archiver" />
                      <input type="hidden" name="id" value={m.id} />
                      <button class="text-bo-muted hover:underline">Archiver</button>
                    </form>
                  </div>
                </td>
              </tr>
            );
          })}
          {messages.length === 0 && !erreur && (
            <tr>
              <td colspan="5" class="px-4 py-6 text-center text-bo-muted">
                Aucun message : le bandeau n'apparaît pas sur le site.
              </td>
            </tr>
          )}
        </tbody>
      </table>
    </div>
  </section>

  {/* --- Ajouter ou modifier un message ---------------------------------- */}
  <section id="formulaire" class="mb-6 max-w-3xl rounded-lg border border-bo-border bg-bo-surface p-5">
    <div class="mb-4 flex flex-wrap items-baseline justify-between gap-2">
      <h2 class="font-semibold">{saisie.id ? "Modifier le message" : "Ajouter un message"}</h2>
      {saisie.id && (
        <a href={`${url("/bandeau")}#formulaire`} class="text-sm text-bo-accent hover:underline">Ajouter un autre message</a>
      )}
    </div>
    <form method="POST" id="form-message" class="grid gap-4 text-sm sm:grid-cols-2">
      <input type="hidden" name="_action" value="message" />
      {saisie.id && <input type="hidden" name="id" value={saisie.id} />}
      <label class="block sm:col-span-2">
        <span class="text-bo-muted">Texte du message</span>
        <input name="message" id="message" required maxlength="200" value={saisie.message} class={champ} />
        <span class="mt-1 block text-xs text-bo-muted">200 caractères au plus : il doit tenir sur un téléphone.</span>
      </label>
      <label class="block">
        <span class="text-bo-muted">Texte du bouton (facultatif)</span>
        <input name="linkLabel" id="linkLabel" maxlength="60" value={saisie.linkLabel} placeholder="J'en profite" class={champ} />
      </label>
      <label class="block">
        <span class="text-bo-muted">Page où mène le bouton</span>
        <input name="linkUrl" maxlength="500" value={saisie.linkUrl} placeholder="/affiches" class={champ} />
        <span class="mt-1 block text-xs text-bo-muted">Une page du site (« /affiches ») ou une adresse complète. Les deux, ou aucun.</span>
      </label>
      <label class="block">
        <span class="text-bo-muted">Début (facultatif)</span>
        <input name="startsAt" type="datetime-local" value={saisie.startsAt} class={champ} />
      </label>
      <label class="block">
        <span class="text-bo-muted">Fin (facultatif)</span>
        <input name="endsAt" type="datetime-local" value={saisie.endsAt} class={champ} />
      </label>
      <label class="flex items-center gap-2 sm:col-span-2">
        <input name="active" type="checkbox" checked={saisie.active} />
        <span>Allumé : il s'affiche pendant ses dates</span>
      </label>

      <div class="sm:col-span-2">
        <p class="mb-1 text-xs text-bo-muted">Aperçu</p>
        <div
          id="apercu-message"
          class="rounded px-4 py-2.5 text-center text-[13px] font-semibold tracking-[0.04em]"
          style={`background:${reglages.fond};color:${reglages.texte}`}
        >
          <span data-texte>{saisie.message || "Votre message apparaîtra ici."}</span>
          <span data-bouton class="ml-2 underline underline-offset-2" hidden={!saisie.linkLabel}>{saisie.linkLabel}</span>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-3 sm:col-span-2">
        <button class="rounded bg-bo-accent px-4 py-2 text-white hover:opacity-90">Enregistrer le message</button>
        {saisie.id && <a href={`${url("/bandeau")}#formulaire`} class="text-sm text-bo-muted hover:underline">Annuler</a>}
      </div>
    </form>
  </section>

  {/* --- Couleurs et défilement, pour tout le bandeau -------------------- */}
  <form method="POST" class="mb-6 grid max-w-3xl gap-6 text-sm">
    <input type="hidden" name="_action" value="reglages" />
    <section id="couleurs" class="rounded-lg border border-bo-border bg-bo-surface p-5">
      <h2 class="mb-1 font-semibold">Couleurs</h2>
      <p class="mb-4 text-xs text-bo-muted">Pour tous les messages.</p>
      <div class="grid gap-4 sm:grid-cols-2">
        <label class="block">
          <span class="text-bo-muted">Couleur de fond</span>
          <input name="fond" type="color" value={reglages.fond} class="mt-1 h-10 w-full rounded border border-bo-border" />
        </label>
        <label class="block">
          <span class="text-bo-muted">Couleur du texte</span>
          <input name="texte" type="color" value={reglages.texte} class="mt-1 h-10 w-full rounded border border-bo-border" />
        </label>
      </div>
    </section>
    <section id="defilement" class="rounded-lg border border-bo-border bg-bo-surface p-5">
      <h2 class="mb-1 font-semibold">Défilement</h2>
      <p class="mb-4 text-xs text-bo-muted">
        Quand plusieurs messages sont en ligne, chacun reste affiché ce temps,
        puis laisse doucement la place au suivant. Le défilement s'arrête quand
        la souris passe dessus, et la visiteuse peut le mettre en pause. Celles
        qui ont demandé à leur appareil de limiter les animations voient les
        messages un par un, avec des flèches, sans défilement automatique.
      </p>
      <label class="block max-w-xs">
        <span class="text-bo-muted">Durée de chaque message</span>
        <select name="dureeSecondes" class={champ}>
          {DUREES.map((s) => (
            <option value={s} selected={s === reglages.dureeSecondes}>{s} secondes</option>
          ))}
        </select>
      </label>
    </section>
    <div>
      <button class="rounded bg-bo-nav px-4 py-2 text-white hover:opacity-90">Enregistrer les couleurs et le défilement</button>
    </div>
  </form>

  {/* Les messages dans les autres langues du site. À part des formulaires
      ci-dessus : une traduction s'enregistre sans réenregistrer le message. */}
  {messages.length > 0 && (
    <Traductions
      ancre="traductions-bandeau"
      titre="Traductions des messages"
      aide="Ce que lit une cliente qui visite le site en anglais, en allemand, en italien ou en espagnol. Une case vide affiche le français. Modifiez d'abord le texte français et enregistrez-le ci-dessus : les traductions se relisent ensuite en regard."
      champs={CHAMPS_BANDEAU}
      elements={messages.map(elementTraduit)}
      disposition="langues"
      propositions={tradBandeau?.propositions}
      saisies={tradBandeau?.saisies}
      actionEnregistrer="bandeau-traductions"
      actionProposer="bandeau-traduire"
      ouvert={!!tradBandeau}
      classe="mb-6 max-w-3xl bg-bo-surface"
    />
  )}

  {/* --- Les archivés ---------------------------------------------------- */}
  {archives.length > 0 && (
    <section id="archives" class="mb-6 max-w-3xl">
      <h2 class="mb-1 font-semibold">Messages archivés</h2>
      <p class="mb-3 text-sm text-bo-muted">
        Ils ont quitté le site, sans rien perdre. « Restaurer » ramène un
        message éteint, en fin de défilement.
      </p>
      <div class="overflow-hidden rounded-lg border border-bo-border bg-bo-surface">
        <table class="w-full text-sm">
          <tbody>
            {archives.map((m) => (
              <tr id={`message-${m.id}`} class="border-t border-bo-border first:border-t-0">
                <td class="px-4 py-2">{m.message}</td>
                <td class="px-4 py-2 text-right">
                  <form method="POST" class="inline">
                    <input type="hidden" name="_action" value="restaurer" />
                    <input type="hidden" name="id" value={m.id} />
                    <button class={boutonLien}>Restaurer</button>
                  </form>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  <script>
    import "../lib/rangement.ts";
  </script>

  <script is:inline>
    // L'aperçu suit la saisie : on voit le message tel qu'il défilera avant
    // de l'enregistrer.
    (function () {
      var form = document.getElementById("form-message");
      var apercu = document.getElementById("apercu-message");
      if (!form || !apercu) return;
      var texte = apercu.querySelector("[data-texte]");
      var bouton = apercu.querySelector("[data-bouton]");
      function suivre() {
        var m = form.querySelector('[name="message"]').value.trim();
        var b = form.querySelector('[name="linkLabel"]').value.trim();
        texte.textContent = m || "Votre message apparaîtra ici.";
        bouton.textContent = b;
        bouton.hidden = !b;
      }
      form.addEventListener("input", suivre);
    })();
  </script>
