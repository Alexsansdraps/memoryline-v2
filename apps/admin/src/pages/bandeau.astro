---
import { apiInterne } from "../lib/api-interne.ts";
/**
 * Le bandeau du site, et l'offre qu'il annonce.
 *
 * Les deux se réglaient à deux endroits différents : le message ici, la
 * remise dans Promotions. Un bandeau qui annonce « la 2e à moitié prix » sans
 * que le panier la déduise n'est pas une annonce, c'est une promesse que la
 * boutique ne tient pas — et personne ne s'en aperçoit avant qu'une cliente
 * le fasse remarquer. L'oubli inverse coûte plus cher encore : une remise
 * active que plus aucun bandeau n'annonce continue de rogner chaque commande.
 *
 * Ils s'enregistrent donc ensemble. La règle prend l'état et les dates du
 * bandeau : allumés ensemble, éteints ensemble.
 */
import Admin from "../layouts/Admin.astro";
import { url } from "../lib/url.ts";
import { adminApi, formatPrice, type BannerBo, type PromoRule } from "../lib/api.ts";
import {
  champLocalDepuisInstant,
  instantDepuisChampLocal,
  libelleRegle,
  remisesPanier,
  seuilDeclenchement,
} from "@memoryline/types";

const api = adminApi(Astro.request);

let flash: string | null = null;
let flashErreur = false;

/**
 * Un champ date-heure de formulaire vers ce que l'API attend, ou rien.
 *
 * L'heure saisie est celle de PARIS, parce que c'est l'heure qu'a en tête la
 * personne devant l'écran. Lue dans le fuseau du serveur, « 18:00 » devenait
 * 18 h en temps universel, soit 20 h à Paris : le bandeau de Noël s'allumait
 * deux heures après l'heure annoncée, et la remise avec lui.
 *
 * Forme une paire avec `pourChamp` plus bas : les deux lisent le même fuseau,
 * sinon la date dérive un peu plus à chaque enregistrement.
 */
function quandOuRien(v: FormDataEntryValue | null): string | null {
  const s = String(v ?? "").trim();
  if (!s) return null;
  return instantDepuisChampLocal(s)?.toISOString() ?? null;
}

if (Astro.request.method === "POST") {
  const f = await Astro.request.formData();
  try {
    // L'offre annoncée. Trois choix à l'écran, trois formes envoyées :
    // rien du tout, l'identifiant d'une règle déjà écrite, ou la règle
    // entière quand on l'écrit ici.
    const choix = String(f.get("regle") ?? "aucune");
    let promo: Record<string, unknown> | null = null;
    if (choix === "existante") {
      const id = Number(f.get("regleId"));
      if (!id) throw new Error("Choisissez l'offre que le bandeau annonce.");
      promo = { id };
    } else if (choix === "nouvelle") {
      const type = String(f.get("type") ?? "percent");
      let config: Record<string, unknown> = {};
      if (type === "buy_x_get_y") {
        const buyQty = Number(f.get("buyQty") || 1);
        const getQty = Number(f.get("getQty") || 1);
        const remise = Number(f.get("remiseOffertes") ?? 100);
        if (!Number.isInteger(buyQty) || buyQty < 1)
          throw new Error("Le nombre d'affiches achetées doit être au moins 1.");
        if (!Number.isInteger(getQty) || getQty < 1)
          throw new Error("Le nombre d'affiches remisées doit être au moins 1.");
        if (!(remise >= 0 && remise <= 100))
          throw new Error("La remise doit être comprise entre 0 et 100 %.");
        config = {
          buyQty,
          getQty,
          percent: remise,
          // Vide = tous les formats. Un format imposé ne compte QUE les
          // affiches de ce format, à l'achat comme à la remise.
          format: String(f.get("format") ?? "") || undefined,
        };
      } else if (type === "percent") {
        const percent = Number(f.get("percent") || 0);
        if (!(percent > 0 && percent <= 100))
          throw new Error("La remise doit être comprise entre 1 et 100 %.");
        config = { percent };
      } else if (type === "fixed") {
        const euros = Number(String(f.get("amount") ?? "").replace(",", "."));
        if (!(euros > 0)) throw new Error("Indiquez le montant de la remise, en euros.");
        config = { amountCents: Math.round(euros * 100) };
      }
      promo = {
        id: f.get("regleActuelleId") ? Number(f.get("regleActuelleId")) : undefined,
        name: String(f.get("nomRegle") || "Offre du bandeau").trim(),
        type,
        config,
        code: String(f.get("code") ?? "").trim().toUpperCase() || null,
        priority: 10,
      };
    }

    await api.upsertBanner({
      id: f.get("id") ? Number(f.get("id")) : undefined,
      message: String(f.get("message") || ""),
      linkUrl: (f.get("linkUrl") as string) || null,
      linkLabel: (f.get("linkLabel") as string) || null,
      bgColor: (f.get("bgColor") as string) || "#20211f",
      textColor: (f.get("textColor") as string) || "#f7f3ec",
      active: f.get("active") === "on",
      startsAt: quandOuRien(f.get("startsAt")),
      endsAt: quandOuRien(f.get("endsAt")),
      promo,
    });
    flash =
      choix === "aucune"
        ? "Bandeau enregistré. Il n'applique aucune remise : c'est un simple message."
        : "Bandeau enregistré, et l'offre qu'il annonce est déduite au panier.";
  } catch (e) {
    flash = e instanceof Error ? e.message : String(e);
    flashErreur = true;
  }
}

let banner: BannerBo | null = null;
let erreur: string | null = null;
try {
  banner = await api.bannerBo();
} catch (e) {
  erreur = e instanceof Error ? e.message : String(e);
}

let promos: PromoRule[] = [];
try {
  promos = await api.promos();
} catch {}

const regle = banner?.promo ?? null;
const choixInitial = regle ? "nouvelle" : "aucune";

/**
 * Les remises qui tournent SANS que le bandeau les annonce.
 *
 * C'est l'oubli le plus cher : elle est déduite de chaque commande, et rien
 * à l'écran ne le rappelle. On la met sous les yeux.
 */
const muettes = promos.filter(
  (p) => p.active && p.id !== regle?.id && !p.code,
);

/**
 * Le prix d'affiche le plus courant, pour que l'exemple parle de vraies
 * affiches et pas d'un montant inventé. À défaut, 23 € : le prix d'un A4.
 */
let prixExemple = 2300;
try {
  const base =
    apiInterne();
  const res = await fetch(`${base}/products?limit=60`);
  if (res.ok) {
    const liste = (await res.json()) as {
      variants?: { format: string; priceCents: number }[];
    }[];
    const compte = new Map<number, number>();
    for (const p of liste)
      for (const v of p.variants ?? [])
        if (v.format === "A4" && v.priceCents > 0)
          compte.set(v.priceCents, (compte.get(v.priceCents) ?? 0) + 1);
    const gagnant = [...compte.entries()].sort((a, b) => b[1] - a[1])[0];
    if (gagnant) prixExemple = gagnant[0];
  }
} catch {}

/**
 * Ce que l'offre fait, sur un panier concret.
 *
 * L'exemple n'est pas écrit à la main : il passe par le moteur qui facture
 * réellement le client. Une phrase qui décrirait autre chose que le calcul
 * serait pire que pas de phrase du tout.
 */
function exemple(r: PromoRule): {
  quantite: number;
  avant: number;
  apres: number;
} | null {
  const cfg = (r.config ?? {}) as Record<string, unknown>;
  const format = typeof cfg.format === "string" && cfg.format ? cfg.format : "A4";
  const quantite = Math.max(2, seuilDeclenchement(r));
  const lignes = [{ unitPriceCents: prixExemple, quantity: quantite, format }];
  // La règle est évaluée hors dates et forcée active : l'exemple montre ce
  // qui se passera PENDANT l'offre, même si elle commence demain.
  const { remiseCents } = remisesPanier(
    lignes,
    [{ ...r, active: true, startsAt: null, endsAt: null }],
    new Date(),
    r.code ? [r.code] : [],
  );
  const avant = prixExemple * quantite;
  if (remiseCents <= 0) return null;
  return { quantite, avant, apres: avant - remiseCents };
}

const exempleRegle = regle ? exemple(regle) : null;

/**
 * Une date pour un champ `datetime-local` (qui n'accepte pas le fuseau) :
 * écrite à l'heure de Paris, celle que la propriétaire a saisie.
 *
 * Voir `quandOuRien` : ces deux fonctions doivent toujours lire le même
 * fuseau, c'est ce qui fait qu'une date rouvre sur elle-même.
 */
function pourChamp(iso: string | null | undefined): string {
  if (!iso) return "";
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return "";
  return champLocalDepuisInstant(d);
}

const cfg = (regle?.config ?? {}) as Record<string, unknown>;
const nombreOu = (v: unknown, defaut: number) =>
  Number.isFinite(Number(v)) ? Number(v) : defaut;
---

<Admin title="Bandeau du site">
  {flash && (
    <p
      class={`mb-4 rounded border px-3 py-2 text-sm ${
        flashErreur
          ? "border-red-300 bg-red-50 text-red-800"
          : "border-green-300 bg-green-50 text-green-800"
      }`}
    >
      {flash}
    </p>
  )}
  {erreur && <p class="mb-4 text-sm text-red-600">API injoignable : {erreur}</p>}

  <p class="mb-4 max-w-3xl text-sm text-bo-muted">
    Le bandeau s'affiche tout en haut du site. S'il annonce une offre, la
    remise se règle ici même : elle est déduite du panier tant que le bandeau
    est allumé, et cesse de l'être dès qu'il s'éteint.
  </p>

  {muettes.length > 0 && (
    <div class="mb-4 max-w-3xl rounded border border-amber-300 bg-amber-50 px-3 py-2 text-sm text-amber-900">
      <p class="font-medium">
        {muettes.length === 1
          ? "Une remise s'applique aux commandes sans que le bandeau l'annonce."
          : `${muettes.length} remises s'appliquent aux commandes sans que le bandeau les annonce.`}
      </p>
      <ul class="mt-1 list-inside list-disc">
        {muettes.map((p) => (
          <li>
            {p.name} — {libelleRegle(p)}
          </li>
        ))}
      </ul>
      <p class="mt-1">
        Elles sont déduites de chaque panier.{" "}
        <a href={url("/promotions")} class="underline">
          Les voir dans Promotions
        </a>
        .
      </p>
    </div>
  )}

  <form method="POST" class="grid max-w-3xl gap-6 text-sm">
    {banner && <input type="hidden" name="id" value={banner.id} />}
    {regle && <input type="hidden" name="regleActuelleId" value={regle.id} />}

    <section class="rounded-lg border border-bo-border bg-bo-surface p-5">
      <h2 class="mb-4 font-semibold">Le message</h2>
      <label class="block">
        <span class="text-bo-muted">Texte affiché</span>
        <input
          name="message"
          id="message"
          required
          value={banner?.message ?? ""}
          class="mt-1 w-full rounded border border-bo-border px-3 py-2"
        />
      </label>
      <p class="mt-1 text-xs text-bo-muted">
        <button
          type="button"
          id="reprendre"
          class="underline"
          data-vide={banner?.message ? "0" : "1"}
        >
          Écrire le message à partir de l'offre choisie
        </button>
      </p>

      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        <label class="block">
          <span class="text-bo-muted">Lien (adresse)</span>
          <input
            name="linkUrl"
            value={banner?.linkUrl ?? ""}
            placeholder="/affiches"
            class="mt-1 w-full rounded border border-bo-border px-3 py-2"
          />
        </label>
        <label class="block">
          <span class="text-bo-muted">Libellé du lien</span>
          <input
            name="linkLabel"
            value={banner?.linkLabel ?? ""}
            placeholder="J'en profite"
            class="mt-1 w-full rounded border border-bo-border px-3 py-2"
          />
        </label>
        <label class="block">
          <span class="text-bo-muted">Couleur de fond</span>
          <input
            name="bgColor"
            type="color"
            value={banner?.bgColor ?? "#20211f"}
            class="mt-1 h-10 w-full rounded border border-bo-border"
          />
        </label>
        <label class="block">
          <span class="text-bo-muted">Couleur du texte</span>
          <input
            name="textColor"
            type="color"
            value={banner?.textColor ?? "#f7f3ec"}
            class="mt-1 h-10 w-full rounded border border-bo-border"
          />
        </label>
      </div>
    </section>

    <section class="rounded-lg border border-bo-border bg-bo-surface p-5">
      <h2 class="mb-1 font-semibold">L'offre appliquée</h2>
      <p class="mb-4 text-xs text-bo-muted">
        Elle est déduite automatiquement au panier, sans code, pour tout le
        monde. Elle suit le bandeau : allumés ensemble, éteints ensemble.
      </p>

      <label class="flex items-start gap-2">
        <input
          type="radio"
          name="regle"
          value="aucune"
          class="mt-1"
          checked={choixInitial === "aucune"}
        />
        <span>
          <span class="font-medium">Aucune remise</span>
          <span class="block text-xs text-bo-muted">
            Le bandeau annonce seulement (une nouveauté, un délai, un salon).
            {regle && " L'offre actuellement liée sera éteinte."}
          </span>
        </span>
      </label>

      <label class="mt-3 flex items-start gap-2">
        <input
          type="radio"
          name="regle"
          value="nouvelle"
          class="mt-1"
          checked={choixInitial === "nouvelle"}
        />
        <span class="font-medium">
          {regle ? "Cette offre" : "Une offre, écrite ici"}
        </span>
      </label>

      <div class="mt-3 ml-6 grid gap-4 sm:grid-cols-2">
        <label class="block">
          <span class="text-bo-muted">Nom (interne)</span>
          <input
            name="nomRegle"
            value={regle?.name ?? "Offre du bandeau"}
            class="mt-1 w-full rounded border border-bo-border px-3 py-2"
          />
        </label>
        <label class="block">
          <span class="text-bo-muted">Type d'offre</span>
          <select
            name="type"
            id="type-offre"
            class="mt-1 w-full rounded border border-bo-border px-3 py-2"
          >
            <option value="buy_x_get_y" selected={regle?.type === "buy_x_get_y"}>
              X achetées, la suivante remisée
            </option>
            <option value="percent" selected={regle?.type === "percent"}>
              Pourcentage sur tout le panier
            </option>
            <option value="fixed" selected={regle?.type === "fixed"}>
              Montant fixe déduit du panier
            </option>
          </select>
        </label>

        <fieldset data-type="buy_x_get_y" class="grid grid-cols-2 gap-3 sm:col-span-2">
          <label class="block">
            <span class="text-bo-muted">Affiches à payer</span>
            <input
              name="buyQty"
              type="number"
              min="1"
              value={nombreOu(cfg.buyQty, 1)}
              class="mt-1 w-full rounded border border-bo-border px-3 py-2"
            />
          </label>
          <label class="block">
            <span class="text-bo-muted">Affiches remisées ensuite</span>
            <input
              name="getQty"
              type="number"
              min="1"
              value={nombreOu(cfg.getQty, 1)}
              class="mt-1 w-full rounded border border-bo-border px-3 py-2"
            />
          </label>
          <label class="block">
            <span class="text-bo-muted">Remise sur celles-ci (%)</span>
            <input
              name="remiseOffertes"
              type="number"
              min="0"
              max="100"
              value={nombreOu(cfg.percent, 100)}
              class="mt-1 w-full rounded border border-bo-border px-3 py-2"
            />
            <span class="mt-1 block text-xs text-bo-muted">
              100 = offerte. 50 = à moitié prix.
            </span>
          </label>
          <label class="block">
            <span class="text-bo-muted">Format concerné</span>
            <select
              name="format"
              class="mt-1 w-full rounded border border-bo-border px-3 py-2"
            >
              <option value="" selected={!cfg.format}>Tous les formats</option>
              <option value="A4" selected={cfg.format === "A4"}>A4 seulement</option>
              <option value="A3" selected={cfg.format === "A3"}>A3 seulement</option>
            </select>
            <span class="mt-1 block text-xs text-bo-muted">
              Un format imposé ne compte que ces affiches, à l'achat comme à la
              remise.
            </span>
          </label>
          <p
            id="resume-offre"
            class="rounded bg-bo-bg px-3 py-2 text-xs text-bo-muted sm:col-span-2"
          >
          </p>
        </fieldset>

        <fieldset data-type="percent" hidden class="sm:col-span-2">
          <label class="block">
            <span class="text-bo-muted">Remise (%)</span>
            <input
              name="percent"
              type="number"
              min="1"
              max="100"
              value={regle?.type === "percent" ? nombreOu(cfg.percent, 10) : 10}
              class="mt-1 w-full rounded border border-bo-border px-3 py-2"
            />
          </label>
        </fieldset>

        <fieldset data-type="fixed" hidden class="sm:col-span-2">
          <label class="block">
            <span class="text-bo-muted">Montant déduit (€)</span>
            <input
              name="amount"
              type="number"
              step="0.01"
              min="0"
              value={
                regle?.type === "fixed"
                  ? nombreOu(cfg.amountCents, 500) / 100
                  : 5
              }
              class="mt-1 w-full rounded border border-bo-border px-3 py-2"
            />
          </label>
        </fieldset>

        <label class="block sm:col-span-2">
          <span class="text-bo-muted">Code à saisir (facultatif)</span>
          <input
            name="code"
            value={regle?.code ?? ""}
            placeholder="vide = pour tout le monde, sans code"
            class="mt-1 w-full rounded border border-bo-border px-3 py-2 uppercase"
          />
        </label>
      </div>

      {promos.filter((p) => p.id !== regle?.id).length > 0 && (
        <>
          <label class="mt-4 flex items-start gap-2">
            <input type="radio" name="regle" value="existante" class="mt-1" />
            <span class="font-medium">Une promotion déjà enregistrée</span>
          </label>
          <select
            name="regleId"
            class="mt-2 ml-6 w-full max-w-md rounded border border-bo-border px-3 py-2"
          >
            {promos
              .filter((p) => p.id !== regle?.id)
              .map((p) => (
                <option value={p.id}>
                  {p.name} — {libelleRegle(p)}
                  {p.code ? ` (code ${p.code})` : ""}
                </option>
              ))}
          </select>
        </>
      )}
    </section>

    <section class="rounded-lg border border-bo-border bg-bo-surface p-5">
      <h2 class="mb-4 font-semibold">Quand</h2>
      <label class="flex items-center gap-2">
        <input name="active" type="checkbox" checked={banner?.active ?? true} />
        <span>Afficher le bandeau, et appliquer son offre</span>
      </label>
      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        <label class="block">
          <span class="text-bo-muted">Début (facultatif)</span>
          <input
            name="startsAt"
            type="datetime-local"
            value={pourChamp(banner?.startsAt)}
            class="mt-1 w-full rounded border border-bo-border px-3 py-2"
          />
        </label>
        <label class="block">
          <span class="text-bo-muted">Fin (facultatif)</span>
          <input
            name="endsAt"
            type="datetime-local"
            value={pourChamp(banner?.endsAt)}
            class="mt-1 w-full rounded border border-bo-border px-3 py-2"
          />
        </label>
      </div>
      <p class="mt-2 text-xs text-bo-muted">
        Ces dates valent aussi pour la remise : hors période, le bandeau
        disparaît et le panier revient au plein tarif.
      </p>
    </section>

    <div>
      <button class="rounded bg-bo-accent px-4 py-2 text-white hover:opacity-90">
        Enregistrer
      </button>
    </div>
  </form>

  <section class="mt-6 max-w-3xl">
    <h2 class="mb-2 text-sm font-semibold">Aperçu</h2>
    <div
      class="rounded px-4 py-2.5 text-center text-[13px] font-semibold tracking-[0.04em]"
      style={`background:${banner?.bgColor ?? "#20211f"};color:${banner?.textColor ?? "#f7f3ec"}`}
    >
      {banner?.message ?? "Votre message apparaîtra ici."}
      {banner?.linkLabel && (
        <span class="ml-2 underline underline-offset-2">{banner.linkLabel}</span>
      )}
    </div>

    {regle && (
      <div class="mt-3 rounded-lg border border-bo-border bg-bo-surface p-4 text-sm">
        <p>
          Ce que le panier déduit : <b>{libelleRegle(regle)}</b>.
        </p>
        {exempleRegle ? (
          <p class="mt-1 text-bo-muted">
            Panier de {exempleRegle.quantite} affiches à{" "}
            {formatPrice(prixExemple)} : {formatPrice(exempleRegle.apres)} au
            lieu de {formatPrice(exempleRegle.avant)}.
          </p>
        ) : (
          <p class="mt-1 text-amber-800">
            Sur un panier ordinaire, cette offre ne déduit rien. Vérifiez les
            quantités.
          </p>
        )}
        {!banner?.active && (
          <p class="mt-1 text-bo-muted">
            Le bandeau est éteint : l'offre ne s'applique pas non plus.
          </p>
        )}
      </div>
    )}
  </section>

  <script is:inline>
    // Les champs propres au type d'offre choisi, et rien d'autre.
    const type = document.getElementById("type-offre");
    function sync() {
      document.querySelectorAll("fieldset[data-type]").forEach((fs) => {
        fs.hidden = fs.getAttribute("data-type") !== type.value;
      });
    }
    type?.addEventListener("change", sync);
    sync();

    // Choisir un champ de l'offre, c'est choisir l'offre : sans cela on règle
    // une remise que la case restée sur « aucune » jette à l'enregistrement.
    document.querySelectorAll("fieldset[data-type], #type-offre").forEach((el) => {
      el.addEventListener("input", () => {
        const r = document.querySelector('input[name="regle"][value="nouvelle"]');
        if (r) r.checked = true;
      });
    });
    const listeExistante = document.querySelector('select[name="regleId"]');
    listeExistante?.addEventListener("change", () => {
      const r = document.querySelector('input[name="regle"][value="existante"]');
      if (r) r.checked = true;
    });

    // La phrase de l'offre, telle que le panier la fera. Elle se recalcule à
    // chaque frappe : une explication qui ne parle pas des valeurs qu'on a
    // sous les yeux n'explique rien.
    function phraseOffre() {
      const t = type?.value;
      const n = (nom) => Number(document.querySelector(`[name="${nom}"]`)?.value || 0);
      if (t === "buy_x_get_y") {
        const achat = n("buyQty");
        const remisees = n("getQty");
        const pct = n("remiseOffertes");
        const rang = (k) => (k <= 1 ? "1re" : k + "e");
        const cibles =
          remisees === 1
            ? "la " + rang(achat + 1)
            : "les " + rang(achat + 1) + " à " + rang(achat + remisees);
        const effet =
          pct >= 100 ? (remisees === 1 ? "offerte" : "offertes") : "à -" + pct + " %";
        return (
          (achat === 1 ? "1 affiche achetée" : achat + " affiches achetées") +
          ", " + cibles + " " + effet
        );
      }
      if (t === "percent") return "-" + n("percent") + " % sur toutes les affiches";
      if (t === "fixed") {
        const v = document.querySelector('[name="amount"]')?.value || "0";
        return "-" + String(v).replace(".", ",") + " € sur votre commande";
      }
      return "";
    }

    function resume() {
      const cible = document.getElementById("resume-offre");
      if (!cible) return;
      if (type?.value !== "buy_x_get_y") {
        cible.textContent = phraseOffre() + ".";
        return;
      }
      const n = (nom) => Number(document.querySelector(`[name="${nom}"]`)?.value || 0);
      const achat = n("buyQty");
      const remisees = n("getQty");
      const total = achat + remisees;
      cible.textContent =
        phraseOffre() +
        ". Il faut les deux dans le panier : " +
        achat + (achat > 1 ? " payées et " : " payée et ") +
        remisees + (remisees > 1 ? " remisées, " : " remisée, ") +
        "c'est un panier de " + total + " affiches.";
    }
    document
      .querySelectorAll('fieldset[data-type] input, fieldset[data-type] select, #type-offre')
      .forEach((el) => el.addEventListener("input", resume));
    resume();

    // Le message, écrit à partir de l'offre. Proposé, jamais imposé : le
    // bandeau se lit sur un site, pas dans un back-office.
    document.getElementById("reprendre")?.addEventListener("click", () => {
      const champ = document.getElementById("message");
      const phrase = phraseOffre();
      if (champ && phrase) champ.value = phrase;
    });
  </script>
</Admin>
