---
/**
 * Importer un fichier de clientes.
 *
 * Le cas qui l'a fait naître : la liste des clientes de l'ancienne boutique
 * Shopify (Clients › Exporter), ou la liste d'un salon tenue dans un tableur.
 * Même déroulé que l'import des affiches (produits/import.astro), pour qu'il
 * n'y ait qu'une façon d'importer dans tout le back-office : on dépose le
 * fichier, on REGARDE ce qui se passerait, et seulement ensuite on décide.
 * Tant que le second bouton n'a pas été touché, rien n'est écrit.
 *
 * Les règles — une fiche par adresse e-mail, une fiche existante complétée et
 * jamais écrasée, l'abonnement aux e-mails repris pour les nouvelles fiches
 * seulement — vivent dans l'API (import-clients.ts). Cet écran les annonce
 * avant qu'on valide : c'est le moment où elles comptent.
 */
import Admin from "../../layouts/Admin.astro";
import { url } from "../../lib/url.ts";
import { adminApi, type ResultatImportClients } from "../../lib/api.ts";

const api = adminApi(Astro.request);

let resultat: ResultatImportClients | null = null;
let contenu = "";
let erreur: string | null = null;

if (Astro.request.method === "POST") {
  const f = await Astro.request.formData();
  contenu = String(f.get("csv") ?? "");
  const appliquer = String(f.get("_action") ?? "") === "importer";
  try {
    if (!contenu.trim())
      throw new Error(
        "Aucun fichier n'a été choisi. Sélectionnez un fichier, ou collez son contenu.",
      );
    resultat = await api.importerClients(contenu, appliquer);
  } catch (e) {
    erreur = String(e).replace(/^Error:\s*/, "");
    // Un import refusé ne doit pas faire perdre l'aperçu : on le redemande,
    // pour qu'il n'y ait plus qu'à corriger le fichier puis relancer.
    if (appliquer && contenu.trim())
      try {
        resultat = await api.importerClients(contenu, false);
      } catch {
        /* la première phrase dit déjà ce qui bloque */
      }
  }
}

const applique = resultat?.applique === true;
const ecartees = (resultat?.apercu ?? []).filter((l) => l.action === "refus");
const marque = (n: number) => (n > 1 ? "s" : "");

/** La phrase de résumé : au conditionnel avant de valider, au passé après. */
const resume: string[] = [];
if (resultat) {
  const c = resultat.compte;
  resume.push(`${resultat.lignes} ligne${marque(resultat.lignes)} lue${marque(resultat.lignes)}.`);
  if (c.creation)
    resume.push(
      applique
        ? `${c.creation} fiche${marque(c.creation)} créée${marque(c.creation)}.`
        : `${c.creation} fiche${marque(c.creation)} à créer.`,
    );
  if (c["mise-a-jour"])
    resume.push(
      applique
        ? `${c["mise-a-jour"]} fiche${marque(c["mise-a-jour"])} complétée${marque(c["mise-a-jour"])}.`
        : `${c["mise-a-jour"]} fiche${marque(c["mise-a-jour"])} existante${marque(c["mise-a-jour"])} à compléter.`,
    );
  if (c.inchange)
    resume.push(`${c.inchange} déjà à jour, rien à y changer.`);
  if (c.refus) resume.push(`${c.refus} écartée${marque(c.refus)}.`);
}

/** La pastille qui dit, d'un coup d'œil, ce qui arrive à une ligne. */
const pastilles: Record<string, { avant: string; apres: string; classe: string }> = {
  creation: { avant: "à créer", apres: "créée", classe: "bg-green-100 text-green-800" },
  "mise-a-jour": {
    avant: "à compléter",
    apres: "complétée",
    classe: "bg-amber-100 text-amber-800",
  },
  inchange: { avant: "rien à changer", apres: "laissée telle quelle", classe: "bg-bo-bg text-bo-muted" },
  refus: {
    avant: "écartée",
    apres: "écartée",
    classe: "border border-red-300 bg-red-50 text-red-700",
  },
};

/** L'exemple montré à l'écran : ce qu'un tableur écrit à la main peut contenir. */
const EXEMPLE = `Prénom;Nom;E-mail;Téléphone;Adresse;Code postal;Ville;Pays;Abonné;Étiquettes
Camille;Martin;camille.martin@exemple.fr;06 12 34 56 78;12 rue des Lilas;80000;Amiens;France;oui;Salon Amiens`;
---

<Admin title="Importer des clients">
  <p class="mb-4">
    <a href={url("/clients")} class="text-sm text-bo-accent hover:underline">
      ← Retour aux clients
    </a>
  </p>

  <h2 class="mb-1 text-lg font-semibold">Importer des clients</h2>
  <p class="mb-5 max-w-3xl text-sm text-bo-muted">
    Déposez un fichier de clientes — l'export de Shopify (Clients › Exporter),
    celui de l'écran Clients, ou un tableur à vous enregistré en CSV. Vous verrez
    d'abord, ligne par ligne, ce qui serait créé et ce qui serait complété. Rien
    n'est enregistré tant que vous ne l'avez pas demandé.
  </p>

  {
    erreur && (
      <p class="mb-4 max-w-3xl rounded border border-red-300 bg-red-50 px-3 py-2 text-sm text-red-700">
        {erreur}
      </p>
    )
  }

  {/* ------------------------------------------------------------------ */}
  {/*  1. Le fichier, et les règles                                       */}
  {/* ------------------------------------------------------------------ */}
  {
    !applique && (
      <div class="mb-6 grid max-w-5xl gap-6 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)]">
        <form
          method="POST"
          id="formulaire"
          class="space-y-4 rounded-lg border border-bo-border bg-bo-surface p-5"
        >
          <input type="hidden" name="_action" value="apercu" />
          <div
            id="zone-fichier"
            class="rounded-lg border-2 border-dashed border-bo-border px-4 py-8 text-center"
          >
            <p class="mb-2 text-sm">
              Faites glisser votre fichier ici, ou
              <label for="fichier" class="cursor-pointer text-bo-accent hover:underline">
                choisissez-le sur votre ordinateur
              </label>
              .
            </p>
            <input type="file" id="fichier" accept=".csv,text/csv,text/plain" class="sr-only" />
            <p id="etat-fichier" class="text-xs text-bo-muted">
              Un fichier de tableur enregistré au format CSV.
            </p>
          </div>

          <details class="text-sm" open={!!contenu && !resultat}>
            <summary class="cursor-pointer text-bo-muted">
              Ou coller directement le contenu du fichier
            </summary>
            <textarea
              name="csv"
              id="csv"
              rows="6"
              class="mt-2 w-full rounded border border-bo-border px-3 py-2 font-mono text-xs"
              placeholder={EXEMPLE}
              set:text={contenu}
            />
          </details>

          <div class="flex items-center gap-3">
            <button class="rounded bg-bo-accent px-4 py-2 text-sm text-white">
              Voir ce que ça donnerait
            </button>
            <span class="text-xs text-bo-muted">Cette étape n'enregistre rien.</span>
          </div>
        </form>

        <aside class="space-y-3 rounded-lg border border-bo-border bg-bo-surface p-5 text-sm">
          <h3 class="font-semibold">Ce que fait l'import</h3>
          <ul class="list-disc space-y-1.5 pl-5 text-bo-muted">
            <li>
              <strong class="text-bo-ink">Une fiche par adresse e-mail.</strong> Une
              adresse déjà connue complète la fiche existante ; une ligne sans
              adresse e-mail est écartée, et une adresse répétée dans le fichier
              n'est lue qu'une fois.
            </li>
            <li>
              <strong class="text-bo-ink">Rien n'est écrasé.</strong> Sur une fiche
              existante, le fichier remplit ce qui est vide (nom, téléphone, note,
              adresse si elle n'en a pas) et ajoute ses étiquettes.
            </li>
            <li>
              <strong class="text-bo-ink">L'abonnement aux e-mails</strong> n'est
              repris que pour les nouvelles fiches, avec la date de l'import. Une
              fiche existante garde le sien : un vieux fichier ne doit jamais
              réabonner quelqu'un qui s'est désabonné.
            </li>
            <li>
              Une adresse n'entre au carnet que si elle a au moins une rue et une
              ville.
            </li>
          </ul>
          <h3 class="pt-2 font-semibold">Les colonnes reconnues</h3>
          <p class="text-bo-muted">
            <strong class="text-bo-ink">E-mail</strong> (obligatoire), Prénom,
            Nom, Téléphone, Adresse, Complément d'adresse, Code postal, Ville,
            Pays, Abonné (oui / non), Étiquettes, Note — en français, ou avec les
            noms anglais d'un export Shopify. Les autres colonnes sont ignorées,
            et l'aperçu dit lesquelles.
          </p>
        </aside>
      </div>
    )
  }

  {/* ------------------------------------------------------------------ */}
  {/*  2. L'aperçu, ou le compte rendu                                    */}
  {/* ------------------------------------------------------------------ */}
  {
    resultat && (
      <section
        id="resultat-import"
        class="mb-6 max-w-6xl scroll-mt-4 rounded-lg border border-bo-border bg-bo-surface p-5"
      >
        <h3 class="mb-1 text-base font-semibold">
          {applique ? "Import terminé" : "Ce qui se passerait"}
        </h3>
        <p class="mb-3 text-sm text-bo-muted">{resume.join(" ")}</p>
        {!applique && (
          <p class="mb-4 text-xs text-bo-muted">
            Colonnes lues : {resultat.colonnesReconnues.join(", ") || "aucune"}.
            {resultat.colonnesIgnorees.length > 0 &&
              ` Ignorées : ${resultat.colonnesIgnorees.join(", ")}.`}
          </p>
        )}

        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="bg-bo-bg text-left text-bo-muted">
              <tr>
                <th class="px-3 py-2 font-medium">Ligne</th>
                <th class="px-3 py-2 font-medium">Cliente</th>
                <th class="px-3 py-2 font-medium">Ce qui se passe</th>
                <th class="px-3 py-2 font-medium">Le détail</th>
                <th class="px-3 py-2 font-medium">Abonnement aux e-mails</th>
                <th class="px-3 py-2 font-medium">Adresse reprise</th>
              </tr>
            </thead>
            <tbody>
              {resultat.apercu.map((l) => (
                <tr class="border-t border-bo-border align-top">
                  <td class="px-3 py-2 text-bo-muted">{l.ligne}</td>
                  <td class="px-3 py-2">
                    {l.clientId && l.action !== "refus" && (applique || l.action !== "creation") ? (
                      <a
                        href={url(`/clients/${l.clientId}`)}
                        class="font-medium text-bo-accent hover:underline"
                      >
                        {l.nom || l.email}
                      </a>
                    ) : (
                      <span class="font-medium">{l.nom || l.email || "—"}</span>
                    )}
                    {l.nom && l.email && (
                      <span class="block text-xs text-bo-muted">{l.email}</span>
                    )}
                  </td>
                  <td class="px-3 py-2 whitespace-nowrap">
                    <span
                      class={`inline-block rounded-full px-2 py-0.5 text-xs ${pastilles[l.action]?.classe ?? ""}`}
                    >
                      {applique ? pastilles[l.action]?.apres : pastilles[l.action]?.avant}
                    </span>
                  </td>
                  <td class="px-3 py-2">
                    {l.raison && <span class="text-red-700">{l.raison}</span>}
                    {!l.raison && l.changements.length === 0 && (
                      <span class="text-bo-muted">aucune différence avec la fiche</span>
                    )}
                    {l.changements.length > 0 && (
                      <ul class="list-inside list-disc text-xs">
                        {l.changements.map((c) => (
                          <li>{c}</li>
                        ))}
                      </ul>
                    )}
                  </td>
                  <td class="px-3 py-2 whitespace-nowrap">
                    {l.abonne === null ? (
                      <span class="text-bo-muted">—</span>
                    ) : l.abonne ? (
                      <span class="rounded-full bg-green-100 px-2 py-0.5 text-xs text-green-800">
                        Abonné
                      </span>
                    ) : (
                      <span class="rounded-full bg-bo-bg px-2 py-0.5 text-xs text-bo-muted">
                        Non abonné
                      </span>
                    )}
                  </td>
                  <td class="px-3 py-2 text-xs text-bo-muted">{l.emplacement ?? "—"}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        {ecartees.length > 0 && (
          <div class="mt-4 rounded border border-red-300 bg-red-50 px-3 py-2 text-sm text-red-700">
            <p class="mb-1 font-medium">
              {ecartees.length > 1
                ? `${ecartees.length} lignes ont été écartées.`
                : "Une ligne a été écartée."}
              {applique
                ? " Le reste du fichier a bien été importé."
                : " Le reste du fichier reste importable."}
            </p>
            <ul class="list-inside list-disc text-xs">
              {ecartees.map((e) => (
                <li>
                  Ligne {e.ligne} du fichier : {e.raison}
                </li>
              ))}
            </ul>
          </div>
        )}

        {!applique ? (
          <form method="POST" class="mt-5 flex flex-wrap items-center gap-3">
            <input type="hidden" name="_action" value="importer" />
            <input type="hidden" name="csv" value={contenu} />
            <button
              class="rounded bg-bo-accent px-4 py-2 text-sm text-white disabled:opacity-40"
              disabled={resultat.compte.creation + resultat.compte["mise-a-jour"] === 0}
            >
              Importer pour de bon
            </button>
            <span class="text-xs text-bo-muted">
              {resultat.compte.creation + resultat.compte["mise-a-jour"] === 0
                ? "Ce fichier ne changerait rien : il n'y a rien à importer."
                : "L'import crée et complète. Il ne supprime rien, et n'écrase aucune information déjà connue."}
            </span>
            <a href={url("/clients/import")} class="text-sm text-bo-accent hover:underline">
              Choisir un autre fichier
            </a>
          </form>
        ) : (
          <p class="mt-5 text-sm">
            <a href={url("/clients")} class="text-bo-accent hover:underline">
              Voir la liste des clients
            </a>
            <span class="text-bo-muted"> · </span>
            <a href={url("/clients/import")} class="text-bo-accent hover:underline">
              Importer un autre fichier
            </a>
          </p>
        )}
      </section>
    )
  }

  {/* L'aperçu arrive sous le formulaire, hors de l'écran : on y descend,
      sinon on croirait que le dépôt du fichier n'a rien fait. */}
  <script is:inline>
    document.getElementById("resultat-import")?.scrollIntoView({ block: "start" });
  </script>

  {/* Lecture du fichier dans le navigateur : c'est son CONTENU qui part au
     serveur, pas le fichier. Le champ de collage sert de porteur unique, comme
     sur l'import des affiches. */}
  <script is:inline>
    (function () {
      var champFichier = document.getElementById("fichier");
      var zone = document.getElementById("zone-fichier");
      var etat = document.getElementById("etat-fichier");
      var csv = document.getElementById("csv");
      var formulaire = document.getElementById("formulaire");
      if (!champFichier || !zone || !etat || !csv || !formulaire) return;

      function lire(fichier) {
        if (!fichier) return;
        etat.textContent = "Lecture de " + fichier.name + "…";
        fichier
          .arrayBuffer()
          .then(function (octets) {
            // Excel enregistre souvent ses CSV en « Windows » et non en UTF-8 :
            // lus tels quels, « Hélène » deviendrait « H�l�ne » dans les
            // fiches. Un caractère illisible fait relire le fichier ainsi.
            var texte = new TextDecoder("utf-8").decode(octets);
            if (texte.indexOf("�") !== -1) {
              try {
                texte = new TextDecoder("windows-1252").decode(octets);
              } catch (e) {
                /* navigateur sans ce décodeur : on garde la première lecture */
              }
            }
            csv.value = texte;
            etat.textContent = fichier.name + " est prêt. Envoi de l'aperçu en cours…";
            formulaire.submit();
          })
          .catch(function () {
            etat.textContent =
              "Ce fichier n'a pas pu être lu. Réenregistrez-le au format CSV, puis réessayez.";
          });
      }

      champFichier.addEventListener("change", function () {
        lire(champFichier.files && champFichier.files[0]);
      });
      ["dragenter", "dragover"].forEach(function (nom) {
        zone.addEventListener(nom, function (e) {
          e.preventDefault();
          zone.classList.remove("border-bo-border");
          zone.classList.add("border-bo-accent");
        });
      });
      ["dragleave", "drop"].forEach(function (nom) {
        zone.addEventListener(nom, function () {
          zone.classList.remove("border-bo-accent");
          zone.classList.add("border-bo-border");
        });
      });
      zone.addEventListener("drop", function (e) {
        e.preventDefault();
        lire(e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0]);
      });
    })();
  </script>
</Admin>
