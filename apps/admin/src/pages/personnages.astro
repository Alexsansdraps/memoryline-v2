---
/**
 * Les PERSONNAGES, et rien d'autre : ce que le client ajoute sur son affiche,
 * rangé par catégorie.
 *
 * Jusqu'en octobre 2026, cet écran portait aussi toute la bibliothèque des
 * pièces (vêtements, pantalons, coupes, accessoires), chacune avec son
 * panneau de couleurs déplié : 35 000 px de défilement pour 67 personnages.
 * Les pièces ont leur écran, /pieces, et les anciennes adresses qui menaient
 * ici pour une pièce y sont renvoyées (voir plus bas, « adresses »).
 */
import { url } from "../lib/url.ts";
import Admin from "../layouts/Admin.astro";
import TraductionsNoms from "../components/TraductionsNoms.astro";
import { traiterTraductionsNoms } from "../lib/traductions-noms.ts";
import { texteErreur, type EtatTraductions } from "../lib/traductions.ts";
import {
  adminApi,
  type CharacterType,
  type CharacterCategory,
  type TypeAffiche,
} from "../lib/api.ts";

// --- Adresses d'avant le partage de l'écran --------------------------------
// « ?piece=1 » était le retour de la création d'une pièce : le message se lit
// désormais sur l'écran des pièces. Les fragments (#piece-12, #ancre=piece-12…)
// ne parviennent pas au serveur : un script en tête de page s'en charge.
if (Astro.url.searchParams.get("piece"))
  return Astro.redirect(url("/pieces?piece=1"), 301);

const api = adminApi(Astro.request);

// URL publique de l'API, joignable depuis le navigateur (fetch client).
// Sert au glisser-déposer d'un personnage vers une catégorie.
const PUBLIC_API_URL =
  import.meta.env.PUBLIC_API_URL ?? "http://localhost:3000";

// Helper : URL absolue d'un SVG stocké sous "/assets/...".
function svgSrc(url: string | null | undefined): string {
  if (!url) return "";
  return url.startsWith("http") ? url : `${PUBLIC_API_URL}${url}`;
}

// --- Traitement des formulaires (SSR) ----------------------------------
// Tout passe en POST classique (robuste, même pattern que promotions.astro),
// sauf le glisser-déposer, qui parle à l'API en fetch puis recharge la page.
let flash: string | null = null;
// Retour de la fiche après un archivage : le message se lit ici, pas là-bas —
// c'est sur cette page que le résultat se voit.
if (Astro.url.searchParams.get("archive"))
  flash = "Personnage archivé. Les commandes passées restent imprimables.";
// Retour du bouton « Visible » / « Masqué » d'une carte (voir plus bas).
const visibleChange = Astro.url.searchParams.get("visible");
if (visibleChange === "1")
  flash = "Personnage visible : les clients le retrouvent dans le module de personnalisation.";
else if (visibleChange === "0")
  flash =
    "Personnage masqué : les clients ne le voient plus dans le module. Ses réglages ne bougent pas, et une affiche qui le porte déjà s'affiche toujours.";
/**
 * Traductions des catégories et des noms de personnages : propositions
 * automatiques à relire, saisie à réafficher (après une proposition ou un
 * refus), et bloc ouvert.
 */
let tradCategories: EtatTraductions | null = null;
let tradPersonnages: EtatTraductions | null = null;
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const action = form.get("_action");
  // Le nom, le type d'affiche, le calage et les pièces autorisées d'un
  // personnage se règlent sur sa fiche (personnages/[id].astro) et à sa
  // création (personnages/nouveau.astro) : aucun formulaire d'ici ne les
  // envoie, cet écran ne range, n'ordonne, n'archive et ne traduit.
  try {
    if (action === "archive") {
      await api.archiveCharacter(
        Number(form.get("id")),
        form.get("archived") === "true",
      );
      flash =
        form.get("archived") === "true"
          ? "Personnage archivé. Les anciennes commandes restent intactes."
          : "Personnage restauré.";
    } else if (action === "visible") {
      // Retour sur la carte, son groupe ouvert : la boutique enchaîne
      // souvent plusieurs personnages d'un même rayon.
      const id = Number(form.get("id"));
      const visible = form.get("active") === "1";
      await api.personnageVisible(id, visible);
      return Astro.redirect(
        url(`/personnages?visible=${visible ? 1 : 0}#personnage-${id}`),
        303,
      );
    } else if (action === "annuler-deplacement") {
      // "12:1,19:sans" — on regroupe par destination, un appel par groupe,
      // ce qui permet d'annuler même une sélection venue de plusieurs
      // catégories différentes.
      const parCat = new Map<string, number[]>();
      for (const paire of String(form.get("retour") || "").split(",")) {
        const [id, cat] = paire.split(":");
        if (!id) continue;
        const cle = cat || "sans";
        if (!parCat.has(cle)) parCat.set(cle, []);
        parCat.get(cle)!.push(Number(id));
      }
      let total = 0;
      for (const [cat, ids] of parCat) {
        const r = await api.moveCharacters(
          ids,
          cat === "sans" ? null : Number(cat),
        );
        total += r.moved;
      }
      flash = `Déplacement annulé : ${total} personnage(s) remis à leur place.`;
    } else if (action === "move-chars") {
      // Déplacement d'un ou plusieurs personnages (sélecteur d'une carte, ou
      // barre de la sélection) : "" = sans catégorie. Le retour est celui du
      // glisser-déposer — « déplacé vers « Femmes » », « Annuler ce
      // déplacement », et la carte à l'écran dans sa nouvelle catégorie — :
      // avant, on lisait « 1 personnage(s) déplacé(s). » tout en haut, sans
      // savoir vers où, ni pouvoir revenir en arrière.
      const raw = String(form.get("categoryId") ?? "");
      const ids = form.getAll("ids").map(Number).filter(Number.isFinite);
      const cible = raw === "" ? null : Number(raw);
      // D'où vient chacun, lu AVANT le déplacement : c'est ce qui permet de
      // l'annuler, même pour une sélection venue de plusieurs catégories.
      const avant = (await api.characters()).types ?? [];
      const retour = ids
        .map((id) => `${id}:${avant.find((t) => t.id === id)?.categoryId ?? "sans"}`)
        .join(",");
      const r = await api.moveCharacters(ids, cible);
      const vers =
        cible == null
          ? "(sans catégorie)"
          : ((await api.categories()).find((c) => c.id === cible)?.name ?? "");
      const params = new URLSearchParams({ deplaces: String(r.moved), vers, retour });
      return Astro.redirect(
        url(`/personnages?${params.toString()}${ids[0] ? `#personnage-${ids[0]}` : ""}`),
        303,
      );
    } else if (action === "cat-create") {
      const cat = await api.upsertCategory({ name: String(form.get("name") || "") });
      flash = `Catégorie « ${cat.name} » créée.`;
    } else if (action === "cat-rename") {
      const cat = await api.upsertCategory({
        id: Number(form.get("id")),
        name: String(form.get("name") || ""),
      });
      flash = `Catégorie renommée en « ${cat.name} ».`;
    } else if (action === "cat-traductions" || action === "cat-traduire") {
      const cats = (await api.categories()).filter((c) => !c.archivedAt);
      tradCategories = await traiterTraductionsNoms(
        action === "cat-traductions" ? "enregistrer" : "proposer",
        form,
        cats,
        (id, l, nom) => api.traduireCategorie(id, l, nom),
        (l, champs) => api.proposerTraduction(l, champs),
      );
      flash = tradCategories.message;
    } else if (action === "perso-traductions" || action === "perso-traduire") {
      // Le nom de chaque personnage, tel que le client le lit dans « vos
      // personnages » et en bulle sur les vignettes du module.
      const persos = (await api.characters()).types.filter((t) => !t.archivedAt);
      tradPersonnages = await traiterTraductionsNoms(
        action === "perso-traductions" ? "enregistrer" : "proposer",
        form,
        persos,
        (id, l, nom) => api.setCharacterTranslation(id, { lang: l, name: nom }),
        (l, champs) => api.proposerTraduction(l, champs),
      );
      flash = tradPersonnages.message;
    } else if (action === "cat-move") {
      // Échange de position avec la voisine.
      await api.upsertCategory({
        id: Number(form.get("id")),
        name: String(form.get("name") || ""),
        position: Number(form.get("otherPosition")),
      });
      await api.upsertCategory({
        id: Number(form.get("otherId")),
        name: String(form.get("otherName") || ""),
        position: Number(form.get("position")),
      });
      flash = "Ordre des catégories mis à jour.";
    } else if (action === "cat-archive") {
      const restaurer = form.get("archived") === "false";
      const r = await api.archiverCategoriePersonnage(
        Number(form.get("id")),
        !restaurer,
      );
      flash = restaurer
        ? "Catégorie restaurée, avec les personnages qu'elle rangeait."
        : `Catégorie archivée${
            r.dedans > 0
              ? `. Ses ${r.dedans} personnage${r.dedans > 1 ? "s restent proposés" : " reste proposé"} sur le site, rangé${r.dedans > 1 ? "s" : ""} dans « sans catégorie » le temps de l'archivage`
              : ""
          }. Vous pouvez la restaurer à tout moment, plus bas.`;
    } else if (action === "reorder") {
      const items = JSON.parse(String(form.get("items") || "[]"));
      if (items.length) await api.reorderCharacters(items);
      flash = "Ordre mis à jour.";
    }
  } catch (e) {
    flash = "Erreur : " + texteErreur(e);
  }
}

// --- Confirmation d'un glisser-déposer ----------------------------------
// Le dépôt se fait en fetch puis rechargement : sans message, un glissement
// accidentel passait totalement inaperçu. On repasse donc par l'URL ce qui
// vient d'être fait, et de quoi le défaire.
const dndNombre = Number(Astro.url.searchParams.get("deplaces") || 0);
const dndVers = Astro.url.searchParams.get("vers") ?? "";
const dndRetour = Astro.url.searchParams.get("retour") ?? "";
if (dndNombre > 0 && !flash) {
  flash = `${dndNombre} personnage(s) déplacé(s) vers « ${dndVers} ».`;
}

let vues: TypeAffiche[] = [];
let types: CharacterType[] = [];
let error: string | null = null;
try {
  const data = await api.characters();
  types = data.types ?? [];
} catch (e) {
  error = String(e);
}

let toutesCategories: CharacterCategory[] = [];
try {
  toutesCategories = await api.categories();
} catch (e) {
  if (!error) error = String(e);
}
// Les catégories archivées quittent les groupes, les sélecteurs et le
// glisser-déposer : elles se retrouvent dans leur propre section, avec
// « Restaurer ». Leurs personnages, eux, restent proposés — ils se rangent
// simplement dans « sans catégorie » le temps de l'archivage.
const catalogue = toutesCategories.filter((c) => !c.archivedAt);
const categoriesArchivees = toutesCategories.filter((c) => c.archivedAt);
/** Les personnages encore proposés : les seuls dont le nom se lit sur le site. */
const personnagesATraduire = types.filter((t) => !t.archivedAt);

/** Ce qu'il faut avoir lu avant d'archiver une catégorie de personnages. */
function messageArchivageCategorie(c: CharacterCategory): string {
  const l = [`Archiver la catégorie « ${c.name} » ?`];
  const n = c.count ?? 0;
  if (n > 0)
    l.push(
      `Ses ${n} personnage${n > 1 ? "s restent proposés" : " reste proposé"} sur le site : ${n > 1 ? "ils apparaîtront" : "il apparaîtra"} dans « sans catégorie » le temps de l'archivage, et ${n > 1 ? "retrouveront leur rayon" : "retrouvera son rayon"} à la restauration.`,
    );
  l.push(
    "Rien n'est supprimé : vous pourrez la restaurer quand vous voudrez, dans « Catégories archivées ».",
  );
  return l.join("\n\n");
}

/** Ce qu'il faut avoir lu avant d'archiver un personnage. */
function messageArchivagePersonnage(t: { name: string }): string {
  return [
    `Archiver le personnage « ${t.name} » ?`,
    "Il ne sera plus proposé dans le configurateur. Ses pièces, ses couleurs et ses réglages sont gardés entiers, et les commandes déjà passées dessus restent imprimables à l'identique.",
    "Rien n'est supprimé : vous pourrez le restaurer quand vous voudrez, dans « Personnages archivés », plus bas dans cet écran.",
  ].join("\n\n");
}

// Types d'affiche : chaque carte dit celui du personnage (« De face », « De
// dos »), parce que c'est lui qui décide des pièces qu'il peut porter. La
// liste se gère dans son propre écran.
try {
  vues = await api.views();
} catch (e) {
  if (!error) error = String(e);
}
/** Type d'affiche d'un dessin, avec repli sur le premier de la liste. */
const vueParDefaut = vues[0]?.slug ?? "front";
const nomVue = (slug: string | null | undefined) =>
  vues.find((v) => v.slug === (slug ?? vueParDefaut))?.name ??
  slug ??
  vueParDefaut;

const active = types.filter((t) => !t.archivedAt);
const archived = types.filter((t) => t.archivedAt);

/**
 * Vrai quand le personnage a un réglage de pièces mais n'en coche AUCUNE :
 * le site ne lui proposera rien à porter. Sans réglage du tout (null), il
 * porte toute la bibliothèque — rien à signaler (règle `slotsForCharacter`
 * du configurateur, la même que sur la fiche et dans Pièces par personnage).
 */
function sansAucunePiece(t: CharacterType): boolean {
  const sv = t.slotVariants;
  if (!sv || typeof sv !== "object") return false;
  return !Object.values(sv).some((l) => Array.isArray(l) && l.length > 0);
}

// --- Regroupement par catégorie (table character_category) ---------------
// Les groupes suivent l'ordre des catégories, et « sans catégorie » ferme la
// marche : il existe TOUJOURS, même vide — c'est là que se rangent les
// personnages dont la catégorie est archivée, exactement comme le fait le
// configurateur. Sans cela, ils ne seraient dans AUCUN groupe et
// disparaîtraient de cet écran alors qu'ils sont toujours en ligne.
const SANS = { id: null as number | null, name: "(sans catégorie)" };
const categorieRangee = new Set(categoriesArchivees.map((c) => c.id));

const groupes: { cat: CharacterCategory | null; label: string; list: CharacterType[] }[] =
  [
    ...catalogue.map((c) => ({
      cat: c,
      label: c.name,
      list: active
        .filter((t) => t.categoryId === c.id)
        .sort((a, b) => a.position - b.position),
    })),
    {
      cat: null,
      label: SANS.name,
      list: active
        .filter(
          (t) => t.categoryId == null || categorieRangee.has(t.categoryId),
        )
        .sort((a, b) => a.position - b.position),
    },
  ];

/** Options du sélecteur de catégorie, « sans » comprise. */
const optionsCategorie = [
  { value: "", label: SANS.name },
  ...catalogue.map((c) => ({ value: String(c.id), label: c.name })),
];

/**
 * Les options pour UN personnage : les catégories ouvertes, plus la sienne si
 * elle vient d'être archivée.
 *
 * Sans cette dernière, le sélecteur retomberait sur « sans catégorie » et
 * laisserait croire que le rangement est perdu — alors qu'il est intact et
 * revient à la restauration. Elle est marquée, et on n'y range personne
 * d'autre : l'API refuse une catégorie archivée.
 */
function optionsPour(t: CharacterType) {
  const sienne =
    t.categoryId != null && categorieRangee.has(t.categoryId)
      ? toutesCategories.find((c) => c.id === t.categoryId)
      : undefined;
  return sienne
    ? [
        ...optionsCategorie,
        { value: String(sienne.id), label: `${sienne.name} (archivée)` },
      ]
    : optionsCategorie;
}

// Payload de réordonnancement : échange les positions de deux personnages.
// La catégorie n'y figure plus — elle se change avec le sélecteur dédié.
function swapPayload(a: CharacterType, b: CharacterType) {
  return JSON.stringify([
    { id: a.id, position: b.position },
    { id: b.id, position: a.position },
  ]);
}

/**
 * Minuscules sans accent : ce que la recherche compare (même règle dans le
 * script). Sur le NOM seul : le texte entier de la carte comprenait le menu
 * des catégories et les boutons, et « femmes », « animaux », « archiver » ou
 * « dos » (dans « Ados ») y répondaient pour les 67 personnages.
 */
const aplati = (s: string | null | undefined) =>
  (s ?? "")
    .toLowerCase()
    .normalize("NFD")
    .replace(/[̀-ͯ]/g, "");

/** « 67 personnages dans 8 catégories · 2 archivés » : la barre d'entête. */
const masques = active.filter((t) => t.active === false).length;
const compteur =
  [
    `${active.length} personnage${active.length > 1 ? "s" : ""}`,
    `dans ${catalogue.length} catégorie${catalogue.length > 1 ? "s" : ""}`,
  ].join(" ") +
  (masques > 0 ? ` · ${masques} masqué${masques > 1 ? "s" : ""} sur le site` : "");
---

<Admin title="Personnages">
  {/* Les anciens résultats de recherche et favoris qui visaient une pièce
      (#piece-12, #ancre=piece-12&trouver=…, #ancre=couleurs-piece-12) : le
      fragment ne va pas au serveur, seul le navigateur peut les renvoyer vers
      l'écran des pièces, où les mêmes ancres existent. */}
  <script is:inline define:vars={{ versPieces: url("/pieces") }}>
    (() => {
      // Les couleurs d'une pièce ne sont fabriquées, là-bas, que pour la
      // pièce que l'adresse demande (?couleurs=12) : on la demande d'emblée.
      const couleurs = /(?:^#|ancre=)couleurs-piece-(\d+)/.exec(location.hash);
      if (couleurs)
        location.replace(versPieces + "?couleurs=" + couleurs[1] + "#piece-" + couleurs[1]);
      else if (/^#piece-\d+/.test(location.hash) || /(^#|&)ancre=piece-\d+/.test(location.hash))
        location.replace(versPieces + location.hash);
    })();
  </script>

  {/* Après un déplacement, la page descend jusqu'à la carte déplacée : le
      message reste collé en haut de l'écran, pour qu'« Annuler » soit à
      portée de main là où l'on regarde. Un <div> et non un <p> : un <form>
      ne peut pas vivre dans un paragraphe, le navigateur l'en sortait — et
      le bouton restait en haut de la page, loin du message collé. */}
  {flash && (
    <div
      role="status"
      class={`mb-4 flex flex-wrap items-center gap-3 text-sm rounded bg-green-50 border border-green-200 px-3 py-2 ${
        dndRetour && Astro.request.method !== "POST" ? "sticky top-2 z-20 shadow" : ""
      }`}
    >
      <span>{flash}</span>
      {dndRetour && Astro.request.method !== "POST" && (
        <form method="POST" class="inline">
          <input type="hidden" name="_action" value="annuler-deplacement" />
          <input type="hidden" name="retour" value={dndRetour} />
          {/* Fond de la page et non blanc : en thème sombre, le texte clair
              sur blanc ne se lisait pas. */}
          <button class="rounded border border-green-300 bg-bo-surface px-2 py-0.5 text-xs hover:bg-green-100">
            Annuler ce déplacement
          </button>
        </form>
      )}
    </div>
  )}
  {error && <p class="mb-4 text-red-600 text-sm">API injoignable : {error}</p>}

  {/* La barre du haut dit déjà « Personnages » : ici le compte, et UN bouton
      (plus le lien des nuanciers, qui n'a pas d'autre porte d'ici).
      Les pièces se créent sur leur écran, et « Pièces par personnage » est
      dans le menu sous Personnages — plus de menu « Nouveau ▾ » ni de bouton
      « Correspondances » à deviner. */}
  <div class="mb-1 flex flex-wrap items-center justify-between gap-3">
    <p class="text-sm">
      <strong>{compteur}</strong>
      {archived.length > 0 && (
        <span class="text-bo-muted">
          {" · "}
          <a href="#personnages-archives" class="hover:underline">
            {archived.length} archivé{archived.length > 1 ? "s" : ""}
          </a>
        </span>
      )}
    </p>
    <div class="flex flex-wrap items-center gap-3">
      {/* Les teintes de peau et de pelage proposées au client vivent en bas
          de Catégories de pièces (menu Pièces) : sans ce lien, rien n'y
          menait depuis les personnages, qu'elles concernent pourtant. */}
      <a
        href={url("/categories-pieces#nuanciers-personnages")}
        class="text-sm text-bo-accent hover:underline"
        title="Les teintes proposées au client pour la peau, le pelage, les vêtements et le pantalon dessinés sur les personnages"
      >
        Nuanciers des personnages
      </a>
      <a
        href={url("/personnages/nouveau")}
        class="rounded bg-bo-accent px-4 py-2 text-sm text-white"
      >
        + Nouveau personnage
      </a>
    </div>
  </div>
  <p class="mb-4 text-sm text-bo-muted">
    Les personnages que le client peut ajouter sur son affiche, rangés par
    catégorie. Glissez une vignette sur le bandeau d'une catégorie pour l'y
    déplacer, ou cochez-en plusieurs.
  </p>

  {/* ---- Gestion des catégories ---- */}
  <section class="mb-6 bg-bo-surface border border-bo-border rounded-lg p-4">
    <h3 class="font-semibold mb-3">Catégories</h3>
    <div class="flex flex-wrap gap-2 items-center">
      {catalogue.map((c, i) => (
        <div id={`categorie-${c.id}`} class="flex items-center gap-1 rounded border border-bo-border px-2 py-1">
          <form method="POST" class="flex items-center gap-1">
            <input type="hidden" name="_action" value="cat-rename" />
            <input type="hidden" name="id" value={c.id} />
            <input
              name="name"
              value={c.name}
              class="w-32 border-0 bg-transparent p-0 text-sm focus:outline-none"
              title="Modifier le nom puis Entrée"
            />
            <span class="text-xs text-bo-muted">{c.count ?? 0}</span>
          </form>
          {i > 0 && (
            <form method="POST" class="inline">
              <input type="hidden" name="_action" value="cat-move" />
              <input type="hidden" name="id" value={c.id} />
              <input type="hidden" name="name" value={c.name} />
              <input type="hidden" name="position" value={c.position} />
              <input type="hidden" name="otherId" value={catalogue[i - 1]!.id} />
              <input type="hidden" name="otherName" value={catalogue[i - 1]!.name} />
              <input type="hidden" name="otherPosition" value={catalogue[i - 1]!.position} />
              <button class="px-1 text-bo-muted hover:text-bo-accent" title="Monter">↑</button>
            </form>
          )}
          {i < catalogue.length - 1 && (
            <form method="POST" class="inline">
              <input type="hidden" name="_action" value="cat-move" />
              <input type="hidden" name="id" value={c.id} />
              <input type="hidden" name="name" value={c.name} />
              <input type="hidden" name="position" value={c.position} />
              <input type="hidden" name="otherId" value={catalogue[i + 1]!.id} />
              <input type="hidden" name="otherName" value={catalogue[i + 1]!.name} />
              <input type="hidden" name="otherPosition" value={catalogue[i + 1]!.position} />
              <button class="px-1 text-bo-muted hover:text-bo-accent" title="Descendre">↓</button>
            </form>
          )}
          <form
            method="POST"
            class="inline"
            onsubmit={`return confirm(${JSON.stringify(messageArchivageCategorie(c))})`}
          >
            <input type="hidden" name="_action" value="cat-archive" />
            <input type="hidden" name="id" value={c.id} />
            <input type="hidden" name="archived" value="true" />
            <button
              class="px-1 text-xs text-bo-muted hover:text-bo-accent"
              title={`Archiver « ${c.name} » — ses personnages restent en ligne`}
            >
              Archiver
            </button>
          </form>
        </div>
      ))}

      <form method="POST" class="flex items-center gap-2">
        <input type="hidden" name="_action" value="cat-create" />
        <input
          name="name"
          required
          placeholder="Nouvelle catégorie"
          class="w-44 rounded border border-bo-border px-2 py-1.5 text-sm"
        />
        <button class="rounded bg-bo-accent px-3 py-1.5 text-sm text-white">Créer</button>
      </form>
    </div>
    {/* Les noms des catégories dans les autres langues : ce sont les onglets
        du module de personnalisation (« Femmes » → « Women »). */}
    <TraductionsNoms
      ancre="traductions-categories"
      titre="Traductions des catégories"
      aide="Le nom de chaque catégorie, tel que le client le lit en onglet dans le module de personnalisation. Une case vide affiche le nom français."
      elements={catalogue}
      propositions={tradCategories?.propositions}
      saisies={tradCategories?.saisies}
      actionEnregistrer="cat-traductions"
      actionProposer="cat-traduire"
      ouvert={!!tradCategories}
    />
    {/* Les noms des personnages eux-mêmes : le client les lit dans la liste
        « vos personnages » et en bulle sur les vignettes du module. Les
        archivés n'y apparaissent plus, ils n'ont rien à traduire. */}
    {personnagesATraduire.length > 0 && (
      <TraductionsNoms
        ancre="traductions-personnages"
        titre="Traductions des noms de personnages"
        aide="Le nom de chaque personnage, tel que le client le lit dans le module de personnalisation (« Femme 1 », « Chat roux »…). Une case vide affiche le nom français. Les commandes et les fichiers d'impression gardent le nom français."
        elements={personnagesATraduire}
        propositions={tradPersonnages?.propositions}
        saisies={tradPersonnages?.saisies}
        actionEnregistrer="perso-traductions"
        actionProposer="perso-traduire"
        ouvert={!!tradPersonnages}
      />
    )}
    {categoriesArchivees.length > 0 && (
      <div class="mt-4 border-t border-bo-border pt-3">
        <h4 class="mb-1 text-sm font-semibold">Catégories archivées</h4>
        <p class="mb-2 text-xs text-bo-muted">
          Retirées du site et des groupes ci-dessous. Les personnages qu'elles
          rangeaient sont toujours en ligne, dans « sans catégorie » :
          « Restaurer » remet le rayon tel qu'il était.
        </p>
        <div class="flex flex-wrap items-center gap-2">
          {categoriesArchivees.map((c) => (
            <div id={`categorie-${c.id}`} class="flex items-center gap-2 rounded border border-bo-border px-2 py-1 opacity-70">
              <span class="text-sm">{c.name}</span>
              <span class="text-xs text-bo-muted">{c.count ?? 0}</span>
              <form method="POST" class="inline">
                <input type="hidden" name="_action" value="cat-archive" />
                <input type="hidden" name="id" value={c.id} />
                <input type="hidden" name="archived" value="false" />
                <button class="text-xs text-bo-accent hover:underline">
                  Restaurer
                </button>
              </form>
            </div>
          ))}
        </div>
      </div>
    )}
    <p class="mt-2 text-xs text-bo-muted">
      Rien ne se supprime ici : archiver une catégorie la range, sans toucher à
      un seul personnage. Ils restent en ligne, et « Restaurer » les remet dans
      leur rayon.
    </p>
  </section>

  {/* ---- Recherche ---- */}
  <div class="mb-4 flex flex-wrap items-center gap-3" role="search">
    <input
      id="recherche-perso"
      type="search"
      placeholder="Rechercher un personnage par son nom…"
      aria-label="Rechercher un personnage par son nom"
      class="w-full max-w-sm rounded border border-bo-border px-3 py-2 text-sm"
    />
    <span id="recherche-perso-resultat" class="text-xs text-bo-muted" aria-live="polite"></span>
  </div>

  {/* ---- Déplacement groupé (barre collante, affichée à la sélection) ---- */}
  <form method="POST" id="form-lot">
    <input type="hidden" name="_action" value="move-chars" />
    <div
      id="barre-lot"
      class="sticky top-2 z-10 mb-4 hidden items-center gap-3 rounded-lg border border-bo-accent bg-bo-surface px-4 py-2 shadow"
    >
      <strong id="lot-compteur">0</strong>
      <span class="text-sm">sélectionné(s) — déplacer vers</span>
      <select name="categoryId" class="rounded border border-bo-border px-2 py-1 text-sm">
        {optionsCategorie.map((o) => (
          <option value={o.value}>{o.label}</option>
        ))}
      </select>
      <button class="rounded bg-bo-accent px-3 py-1.5 text-sm text-white">Déplacer</button>
      <button type="button" id="lot-annuler" class="text-sm text-bo-muted hover:underline">
        Annuler
      </button>
    </div>
  </form>

  {
    groupes.map(({ cat, label, list }) => (
      <details
        class="mb-3 rounded-lg border border-bo-border bg-bo-bg/40"
        data-groupe
        data-cat={cat ? String(cat.id) : "sans"}
      >
        <summary class="cursor-pointer select-none px-4 py-3 font-semibold">
          {label}
          {/* « 2 sur 21 » pendant une recherche, comme sur l'écran Pièces. */}
          <span class="js-groupe-compte ml-2 text-sm font-normal text-bo-muted" data-total={list.length}>
            {list.length}
          </span>
        </summary>
        <div class="px-4 pb-4">
        {list.length === 0 && (
          <p class="mb-3 text-sm text-bo-muted">
            Aucun personnage{cat ? " dans cette catégorie" : " hors catégorie"}.
          </p>
        )}
        <div class="grid sm:grid-cols-2 gap-3 js-cards">
          {list.map((t, i) => (
            <article
              id={`personnage-${t.id}`}
              class="scroll-mt-16 bg-bo-surface border border-bo-border rounded-lg overflow-hidden"
              data-char-id={t.id}
              data-nom={aplati(t.name)}
            >
              <header class="flex items-start justify-between gap-3 px-4 py-3 bg-bo-bg">
                <div class="flex items-center gap-3 min-w-0">
                  <input
                    type="checkbox"
                    class="js-lot shrink-0"
                    value={t.id}
                    aria-label={`Sélectionner ${t.name}`}
                  />
                  <img
                    src={svgSrc(t.baseSvgUrl)}
                    alt=""
                    class={`js-grip h-12 w-12 object-contain border border-bo-border rounded bg-white shrink-0 cursor-grab active:cursor-grabbing${t.active === false ? " opacity-40" : ""}`}
                    style={t.baseSvgUrl ? "" : "visibility:hidden"}
                    loading="lazy"
                    draggable="true"
                    title="Glisser le personnage sur une catégorie pour l'y déplacer"
                  />
                  <div class="min-w-0">
                    <div class="font-medium truncate">{t.name}</div>
                    {/* Le type d'affiche, et non « /slug · pos N » : c'est
                        lui qui décide des pièces que le personnage peut
                        porter ; le slug et la position sont de la cuisine. */}
                    <div class="text-xs text-bo-muted truncate">
                      {nomVue(t.orientation)}
                    </div>
                  </div>
                </div>
                <div class="flex items-center gap-1 shrink-0">
                  {/* Visible ou masqué sur le site : un clic bascule. Masqué,
                      il n'est pas archivé — il reste ici, réglages compris,
                      le temps d'être prêt (habillé, calé). */}
                  <form method="POST" class="inline">
                    <input type="hidden" name="_action" value="visible" />
                    <input type="hidden" name="id" value={t.id} />
                    <input type="hidden" name="active" value={t.active === false ? "1" : "0"} />
                    <button
                      title={
                        t.active === false
                          ? "Masqué : les clients ne le voient pas dans le module. Cliquer pour le rendre visible."
                          : "Visible dans le module de personnalisation. Cliquer pour le masquer aux clients."
                      }
                      class={`mr-1 cursor-pointer rounded-full px-2 py-0.5 text-xs ${
                        t.active === false
                          ? "bg-bo-bg text-bo-muted ring-1 ring-bo-border"
                          : "bg-green-100 text-green-800"
                      }`}
                    >
                      {t.active === false ? "Masqué" : "Visible"}
                    </button>
                  </form>
                  <form method="POST" class="inline">
                    <input type="hidden" name="_action" value="reorder" />
                    <input
                      type="hidden"
                      name="items"
                      value={i > 0 ? swapPayload(t, list[i - 1]) : "[]"}
                    />
                    <button
                      class="px-2 py-1 rounded border border-bo-border disabled:opacity-30"
                      disabled={i === 0}
                      title="Monter"
                      aria-label="Monter"
                    >
                      ↑
                    </button>
                  </form>
                  <form method="POST" class="inline">
                    <input type="hidden" name="_action" value="reorder" />
                    <input
                      type="hidden"
                      name="items"
                      value={
                        i < list.length - 1 ? swapPayload(t, list[i + 1]) : "[]"
                      }
                    />
                    <button
                      class="px-2 py-1 rounded border border-bo-border disabled:opacity-30"
                      disabled={i === list.length - 1}
                      title="Descendre"
                      aria-label="Descendre"
                    >
                      ↓
                    </button>
                  </form>
                </div>
              </header>

              {/* Déplacement immédiat : un choix, un enregistrement. */}
              <form method="POST" class="flex items-center gap-2 px-4 py-2 text-sm border-b border-bo-border bg-bo-surface">
                <input type="hidden" name="_action" value="move-chars" />
                <input type="hidden" name="ids" value={t.id} />
                <span class="text-bo-muted text-xs">Catégorie</span>
                <select
                  name="categoryId"
                  class="js-cat-select flex-1 border border-bo-border rounded px-2 py-1"
                >
                  {optionsPour(t).map((o) => (
                    <option value={o.value} selected={o.value === String(t.categoryId ?? "")}>
                      {o.label}
                    </option>
                  ))}
                </select>
                <noscript>
                  <button class="rounded border border-bo-border px-2 py-1 text-xs">OK</button>
                </noscript>
              </form>

              {/* Réglages fins : sur la fiche du personnage. Les garder ici
                  noyait la liste — et on ne trouvait plus rien. */}
              <div class="flex flex-wrap items-center justify-between gap-2 px-4 py-3 text-sm">
                <span class="flex flex-wrap items-center gap-2">
                  <a
                    href={url(`/personnages/${t.id}`)}
                    class="rounded bg-bo-accent px-3 py-1.5 text-white"
                  >
                    Modifier / caler
                  </a>
                  {/* Les couleurs que le client peut changer se règlent sur la
                      fiche, sous « Dessin » : « Modifier / caler » ne le
                      disait pas, et la boutique les cherchait. */}
                  <a
                    href={url(`/personnages/${t.id}#couleurs`)}
                    class="rounded border border-bo-border px-2 py-1.5 text-xs hover:bg-bo-bg"
                    title="Les couleurs que le client peut changer : peau, pelage, robe…"
                  >
                    🎨 Couleurs
                  </a>
                </span>
                {/* Un seul renseignement, et seulement quand il sert : un
                    personnage qui ne coche aucune pièce n'a rien à porter sur
                    le site. C'est voulu pour les 21 animaux, d'où un gris
                    discret et pas une alerte ; pour un humain, le lien mène
                    là où l'on coche. « pièces choisies · calé » n'apprenait
                    rien. « Archiver » est sur la même rangée : seul sur une
                    quatrième, il allongeait chaque carte pour un bouton qu'on
                    ne touche presque jamais. */}
                <span class="ml-auto flex items-center gap-3 whitespace-nowrap">
                  {sansAucunePiece(t) && (
                    <a
                      href={url(`/personnages/correspondances?vue=${t.orientation ?? vueParDefaut}&slot=clothes`)}
                      class="text-xs text-bo-muted hover:underline"
                      title="Ce personnage ne porte aucune pièce (normal pour un animal). Pour lui en donner, cochez-les dans Pièces par personnage."
                    >
                      Aucune pièce
                    </a>
                  )}
                  <form
                    method="POST"
                    class="inline"
                    onsubmit={`return confirm(${JSON.stringify(messageArchivagePersonnage(t))})`}
                  >
                    <input type="hidden" name="_action" value="archive" />
                    <input type="hidden" name="id" value={t.id} />
                    <input type="hidden" name="archived" value="true" />
                    <button class="text-xs text-bo-muted hover:text-bo-accent">
                      Archiver
                    </button>
                  </form>
                </span>
              </div>
            </article>
          ))}
        </div>
        <div class="js-pager mt-3 flex flex-wrap items-center gap-2 text-sm"></div>
        </div>
      </details>
    ))
  }

  {active.length === 0 && !error && (
    <p class="text-bo-muted text-sm mb-8">Aucun personnage actif.</p>
  )}

  <!-- ====== Personnages archivés ====== -->
  {/* Le titre reprend les mots de la confirmation d'archivage (« dans
      « Personnages archivés », plus bas dans cet écran ») : on retrouve ce
      qu'on a lu. */}
  {
    archived.length > 0 && (
      <section id="personnages-archives" class="mb-12">
        <h3 class="font-semibold mb-1">Personnages archivés</h3>
        <p class="text-xs text-bo-muted mb-3">
          Retirés du site. Les commandes passées restent intactes et imprimables.
          Vous pouvez les restaurer à tout moment.
        </p>
        <div class="bg-bo-surface border border-bo-border rounded-lg overflow-hidden opacity-60">
          <table class="w-full text-sm">
            <tbody>
              {archived.map((t) => (
                <tr class="border-t border-bo-border first:border-t-0">
                  <td class="px-4 py-2 font-medium">{t.name}</td>
                  <td class="px-4 py-2 text-bo-muted">
                    {catalogue.find((c) => c.id === t.categoryId)?.name ?? "—"}
                  </td>
                  <td class="px-4 py-2 text-right">
                    <form method="POST" class="inline">
                      <input type="hidden" name="_action" value="archive" />
                      <input type="hidden" name="id" value={t.id} />
                      <input type="hidden" name="archived" value="false" />
                      <button class="text-bo-accent hover:underline">Restaurer</button>
                    </form>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )
  }

  <script is:inline>
    // --- Catégories : déplacement immédiat au changement du sélecteur ---
    for (const sel of document.querySelectorAll(".js-cat-select")) {
      sel.addEventListener("change", () => sel.form.submit());
    }

    // --- Sélection multiple + barre de déplacement groupé ---
    (() => {
      const cases = Array.from(document.querySelectorAll(".js-lot"));
      const barre = document.getElementById("barre-lot");
      const compteur = document.getElementById("lot-compteur");
      const formLot = document.getElementById("form-lot");
      if (!cases.length || !barre || !formLot) return;

      const coches = () => cases.filter((c) => c.checked);

      const maj = () => {
        const n = coches().length;
        compteur.textContent = String(n);
        barre.classList.toggle("hidden", n === 0);
        barre.classList.toggle("flex", n > 0);
      };

      for (const c of cases) c.addEventListener("change", maj);

      document.getElementById("lot-annuler").addEventListener("click", () => {
        for (const c of cases) c.checked = false;
        maj();
      });

      // Les cases vivent dans les cartes, hors du formulaire : on injecte les
      // ids sélectionnés au moment de l'envoi.
      formLot.addEventListener("submit", () => {
        for (const vieux of formLot.querySelectorAll('input[name="ids"]')) vieux.remove();
        for (const c of coches()) {
          const input = document.createElement("input");
          input.type = "hidden";
          input.name = "ids";
          input.value = c.value;
          formLot.appendChild(input);
        }
      });

      maj();
    })();

    // --- Catégories repliables + pagination interne + recherche ---
    // 62 personnages en cartes, c'était deux écrans de défilement. Chaque
    // catégorie se replie, et n'affiche qu'une page à la fois.
    (() => {
      const PAR_PAGE = 6;
      const CLE = "ml-bo-categories-ouvertes";
      const champ = document.getElementById("recherche-perso");
      // « details » : le menu de gauche marque aussi ses groupes d'un
      // data-groupe. Pris ici, le premier (sans pagination) arrêtait le script
      // net : ni pages de 6, ni catégories rouvertes, ni recherche.
      const groupes = Array.from(document.querySelectorAll("details[data-groupe]"));
      if (!groupes.length) return;

      // Les actions rechargent la page : sans mémoire, tout se replierait à
      // chaque déplacement de personnage.
      const lire = () => {
        try {
          return new Set(JSON.parse(localStorage.getItem(CLE) || "[]"));
        } catch {
          return new Set();
        }
      };
      const ecrire = (set) => {
        try {
          localStorage.setItem(CLE, JSON.stringify([...set]));
        } catch {
          /* navigation privée : on se passe de la mémoire */
        }
      };

      const ouvertes = lire();
      const etat = new Map(); // groupe -> page courante

      const cartesDe = (g) => Array.from(g.querySelectorAll("[data-char-id]"));

      // Même règle que data-nom, côté serveur : minuscules, sans accent.
      const aplati = (s) =>
        (s || "")
          .toLowerCase()
          .normalize("NFD")
          .replace(/[̀-ͯ]/g, "");

      /** Cartes correspondant à la recherche, sur le nom (toutes si le champ est vide). */
      const filtrees = (g, q) =>
        cartesDe(g).filter((c) => q === "" || (c.dataset.nom || "").includes(q));

      function rendre(g) {
        const q = aplati(champ ? champ.value.trim() : "");
        const visibles = filtrees(g, q);
        const pager = g.querySelector(".js-pager");
        const compte = g.querySelector(".js-groupe-compte");
        if (compte) {
          const total = compte.dataset.total || "0";
          compte.textContent = q === "" ? total : `${visibles.length} sur ${total}`;
        }

        // Pendant une recherche, la pagination est court-circuitée : on montre
        // tous les résultats, sinon ils se cacheraient derrière une page 2.
        const pagine = q === "";
        const pages = pagine ? Math.max(1, Math.ceil(visibles.length / PAR_PAGE)) : 1;
        let page = etat.get(g) ?? 1;
        if (page > pages) page = pages;
        etat.set(g, page);

        const debut = (page - 1) * PAR_PAGE;
        const fin = debut + PAR_PAGE;
        for (const c of cartesDe(g)) c.style.display = "none";
        const aMontrer = pagine ? visibles.slice(debut, fin) : visibles;
        for (const c of aMontrer) c.style.display = "";

        // Le groupe entier disparaît s'il ne contient aucun résultat.
        g.style.display = q === "" || visibles.length ? "" : "none";
        if (q !== "" && visibles.length) g.open = true;

        pager.innerHTML = "";
        if (!pagine || pages <= 1) return;
        const bouton = (texte, cible, actif) => {
          const b = document.createElement("button");
          b.type = "button";
          b.textContent = texte;
          b.className =
            "rounded border border-bo-border px-2 py-1 disabled:opacity-30";
          b.disabled = !actif;
          b.addEventListener("click", () => {
            etat.set(g, cible);
            rendre(g);
          });
          return b;
        };
        pager.appendChild(bouton("‹ Précédent", page - 1, page > 1));
        const info = document.createElement("span");
        info.className = "text-bo-muted";
        info.textContent = `Page ${page} / ${pages} · ${visibles.length} personnage(s)`;
        pager.appendChild(info);
        pager.appendChild(bouton("Suivant ›", page + 1, page < pages));
      }

      for (const g of groupes) {
        g.open = ouvertes.has(g.dataset.cat);
        // Seule une ouverture À LA MAIN se mémorise : un groupe qu'une
        // recherche ou une arrivée avait ouvert restait ouvert à jamais.
        g.querySelector(":scope > summary")?.addEventListener(
          "click",
          () => (g.dataset.parLaMain = "1"),
        );
        g.addEventListener("toggle", () => {
          if (g.dataset.parLaMain !== "1") return;
          delete g.dataset.parLaMain;
          const set = lire();
          if (g.open) set.add(g.dataset.cat);
          else set.delete(g.dataset.cat);
          ecrire(set);
        });
        rendre(g);
      }

      // Le compte, sous le champ : sans lui, une recherche sans réponse
      // (« femmes » : c'est une catégorie, pas un nom) laissait une page vide.
      const resultat = document.getElementById("recherche-perso-resultat");
      if (champ) {
        champ.addEventListener("input", () => {
          let n = 0;
          for (const g of groupes) {
            etat.set(g, 1);
            rendre(g);
            n += filtrees(g, aplati(champ.value.trim())).length;
          }
          if (!resultat) return;
          const q = champ.value.trim();
          resultat.textContent =
            q === ""
              ? ""
              : n === 0
                ? `Aucun personnage dont le nom contient « ${q} ». Les catégories sont les bandeaux ci-dessous.`
                : `${n} personnage${n > 1 ? "s" : ""} trouvé${n > 1 ? "s" : ""}`;
        });
      }

      // Arrivée sur une carte (#personnage-12, après un déplacement) : son
      // groupe s'ouvre à la bonne page, et elle vient au milieu de l'écran,
      // entourée un instant — on voit où elle est arrivée.
      const m = /^#personnage-(\d+)$/.exec(location.hash);
      const carte = m && document.getElementById(`personnage-${m[1]}`);
      const groupe = carte && carte.closest("details[data-groupe]");
      if (carte && groupe) {
        groupe.open = true;
        const rang = cartesDe(groupe).indexOf(carte);
        etat.set(groupe, Math.floor(rang / PAR_PAGE) + 1);
        rendre(groupe);
        // Après le défilement du navigateur vers le fragment (le groupe était
        // fermé quand il l'a tenté).
        requestAnimationFrame(() => carte.scrollIntoView({ block: "center" }));
        carte.classList.add("ml-champ-trouve");
        setTimeout(() => carte.classList.remove("ml-champ-trouve"), 2500);
      }
    })();
  </script>

  <script is:inline define:vars={{ PUBLIC_API_URL }}>
    // ===== Glisser-déposer : prendre un personnage, le lâcher sur une catégorie
    // On saisit la vignette ; les bandeaux de catégorie (repliés ou non) servent
    // de cibles, ce qui rend le déplacement direct maintenant que les huit
    // catégories tiennent sur un écran.
    (() => {
      // Seules les catégories de personnages : voir plus haut (menu de gauche).
      const groupes = Array.from(document.querySelectorAll("details[data-groupe]"));
      if (!groupes.length) return;

      for (const poignee of document.querySelectorAll(".js-grip")) {
        poignee.addEventListener("dragstart", (e) => {
          const carte = poignee.closest("[data-char-id]");
          if (!carte) return;
          const id = carte.getAttribute("data-char-id");
          const coches = Array.from(
            document.querySelectorAll(".js-lot:checked"),
          ).map((c) => c.value);
          // Si le personnage saisi fait partie d'une sélection, on emmène
          // toute la sélection ; sinon on ne déplace que lui.
          const ids = coches.includes(id) ? coches : [id];
          e.dataTransfer.effectAllowed = "move";
          e.dataTransfer.setData("text/plain", ids.join(","));
          carte.classList.add("opacity-40");
        });
        poignee.addEventListener("dragend", () => {
          const carte = poignee.closest("[data-char-id]");
          if (carte) carte.classList.remove("opacity-40");
        });
      }

      for (const groupe of groupes) {
        const bandeau = groupe.querySelector("summary");
        if (!bandeau) continue;
        const surligner = (actif) => {
          bandeau.style.background = actif ? "rgba(79, 70, 229, 0.15)" : "";
        };

        bandeau.addEventListener("dragover", (e) => {
          e.preventDefault();
          e.dataTransfer.dropEffect = "move";
          surligner(true);
        });
        bandeau.addEventListener("dragleave", () => surligner(false));

        bandeau.addEventListener("drop", async (e) => {
          e.preventDefault();
          surligner(false);
          const ids = (e.dataTransfer.getData("text/plain") || "")
            .split(",")
            .filter(Boolean)
            .map(Number);
          if (!ids.length) return;
          const cat = groupe.dataset.cat;

          // Provenance de chacun, AVANT le déplacement : c'est ce qui permet
          // d'offrir une annulation, y compris si la sélection venait de
          // plusieurs catégories différentes.
          const retour = ids
            .map((id) => {
              const carte = document.querySelector(`[data-char-id="${id}"]`);
              const source = carte?.closest("details[data-groupe]")?.dataset.cat ?? "sans";
              return `${id}:${source}`;
            })
            .join(",");
          const nomCible = (
            groupe.querySelector("summary")?.firstChild?.textContent || ""
          ).trim();
          try {
            const res = await fetch(
              `${PUBLIC_API_URL}/admin/characters/category`,
              {
                method: "POST",
                credentials: "include",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                  ids,
                  categoryId: cat === "sans" ? null : Number(cat),
                }),
              },
            );
            if (!res.ok) throw new Error("HTTP " + res.status);
            const params = new URLSearchParams({
              deplaces: String(ids.length),
              vers: nomCible,
              retour,
            });
            // Et la page descend jusqu'à la carte, dans sa nouvelle catégorie.
            location.href =
              location.pathname + "?" + params.toString() + "#personnage-" + ids[0];
          } catch (err) {
            alert("Déplacement impossible : " + err);
          }
        });
      }
    })();
  </script>
</Admin>
