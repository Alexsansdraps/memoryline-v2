---
/**
 * Une collection, et les affiches qu'elle range.
 *
 * Deux façons de regarder, parce qu'on ne cherche pas la même chose : la LISTE
 * pour lire des noms, des statuts et des prix, les ICÔNES pour reconnaître une
 * affiche à son visuel. C'est la distinction que fait l'explorateur de
 * fichiers, et elle vaut ici pour la même raison.
 *
 * L'ORDRE des affiches décide de la façon dont la collection s'affiche sur le
 * site — ce qu'on met devant est ce qui se vend. Il ne se range plus ici mais
 * dans Produits › Ordre d'affichage, le même écran pour toutes les pages de
 * liste ; l'encart « Ordre des affiches » y mène directement. La grille
 * ci-dessous le montre tel quel.
 */
import Admin from "../../layouts/Admin.astro";
import EditeurTexte from "../../components/EditeurTexte.astro";
import { apiUrl, url } from "../../lib/url.ts";
import {
  adminApi,
  formatPrice,
  type CollectionBo,
  type ProduitDeCollection,
  type ProduitAdmin,
} from "../../lib/api.ts";
import { LANGUES_TRADUITES, texteErreur } from "../../lib/traductions.ts";

const id = Number(Astro.params.id);
if (!Number.isInteger(id) || id <= 0) return Astro.redirect(url("/collections"));
const api = adminApi(Astro.request);

let flash: string | null = null;
let flashErreur = false;

/** Les deux textes d'une collection qui se traduisent. */
type TexteCollection = { name?: string; description?: string };
/**
 * Les traductions AUTOMATIQUES proposées, par langue, posées dans les champs
 * sans être enregistrées ; et ce que la boutique venait de taper, réaffiché
 * tel quel après une proposition ou un refus.
 */
const propositionsTrad: Record<string, TexteCollection> = {};
const saisiesTrad: Record<string, TexteCollection> = {};

/** Du HTML au texte, le temps de savoir s'il reste quelque chose à lire. */
const sansBalises = (html: string | null | undefined) =>
  (html ?? "").replace(/<[^>]*>/g, "").replace(/&nbsp;/gi, " ").trim();

/**
 * Ce qu'il faut proposer dans une langue : les champs VIDES (dans `actuel`)
 * dont le français existe. Une traduction déjà écrite n'est jamais remplacée
 * par la machine. La description n'en est que si le français a du texte —
 * une description française vide reste vide dans toutes les langues.
 */
function aProposer(c: CollectionBo, actuel: TexteCollection): Record<string, string> {
  const manque: Record<string, string> = {};
  if (!actuel.name?.trim() && c.name.trim()) manque.name = c.name;
  if (
    actuel.description !== undefined &&
    !sansBalises(actuel.description) &&
    sansBalises(c.description)
  )
    manque.description = c.description ?? "";
  return manque;
}

if (Astro.request.method === "POST") {
  const f = await Astro.request.formData();
  const action = String(f.get("_action") ?? "");
  try {
    if (action === "traduction") {
      const lang = String(f.get("lang") ?? "");
      const langue = LANGUES_TRADUITES.find((l) => l.code === lang);
      if (!langue) throw new Error("Cette langue n'existe pas. Rechargez l'écran et réessayez.");
      const { collection: c } = await api.collection(id);
      // La description n'est dans le formulaire que si la collection en a
      // une en français : absente, elle n'est ni envoyée ni effacée.
      const saisi: TexteCollection = {
        name: String(f.get("name") ?? "").trim(),
        ...(f.has("description")
          ? { description: String(f.get("description") ?? "").trim() }
          : {}),
      };
      if (f.get("auto")) {
        // « Proposer » : la saisie reste, la machine ne remplit que le vide.
        saisiesTrad[lang] = saisi;
        const manque = aProposer(c, saisi);
        if (!Object.keys(manque).length) {
          flash = `Rien à proposer en ${langue.nom.toLowerCase()} : les champs sont déjà remplis.`;
        } else {
          const { champs } = await api.proposerTraduction(lang, manque);
          propositionsTrad[lang] = champs;
          flash = `Traduction en ${langue.nom.toLowerCase()} proposée : relisez-la, corrigez si besoin, puis cliquez « Enregistrer ${langue.nom.toLowerCase()} ». Rien n'est enregistré pour l'instant.`;
        }
      } else {
        // Seuls les champs modifiés partent : l'API garde les autres.
        const avant = c.translations?.[lang] ?? {};
        const modifies: TexteCollection = {};
        if (saisi.name !== (avant.name ?? "").trim()) modifies.name = saisi.name;
        if (
          saisi.description !== undefined &&
          saisi.description !== (avant.description ?? "").trim()
        )
          modifies.description = saisi.description;
        if (!Object.keys(modifies).length) {
          flash = `Rien n'a changé en ${langue.nom.toLowerCase()}.`;
        } else {
          saisiesTrad[lang] = saisi;
          await api.setCollectionTranslation(id, { lang, ...modifies });
          delete saisiesTrad[lang];
          flash = Object.values(modifies).some((v) => v)
            ? `Traduction en ${langue.nom.toLowerCase()} enregistrée. Un champ vide affiche le français sur le site.`
            : `Traduction en ${langue.nom.toLowerCase()} retirée : le site y affiche de nouveau le français.`;
        }
      }
    } else if (action === "traduction-auto-tout") {
      // Les quatre langues d'un coup, mais SEULEMENT ce qui manque.
      const { collection: c } = await api.collection(id);
      let n = 0;
      for (const l of LANGUES_TRADUITES) {
        const t = c.translations?.[l.code] ?? {};
        const manque = aProposer(c, {
          name: t.name ?? "",
          description: sansBalises(c.description) ? (t.description ?? "") : undefined,
        });
        if (!Object.keys(manque).length) continue;
        const { champs } = await api.proposerTraduction(l.code, manque);
        propositionsTrad[l.code] = champs;
        n++;
      }
      flash = n
        ? `Traductions proposées pour ${n} langue${n > 1 ? "s" : ""} (seulement ce qui manquait) : relisez chaque langue, puis enregistrez-la. Rien n'est enregistré pour l'instant.`
        : "Rien à proposer : tout ce qui a un texte français est déjà traduit.";
    } else if (action === "ordre") {
      // L'ordre se range maintenant dans Produits › Ordre d'affichage ; un
      // onglet ouvert avant ce déménagement peut encore l'envoyer ici, et son
      // rangement ne doit pas se perdre.
      const ordre = String(f.get("ordre") ?? "")
        .split(",")
        .map(Number)
        .filter((n) => Number.isInteger(n) && n > 0);
      if (!ordre.length) throw new Error("L'ordre envoyé était vide.");
      const r = await api.ordreCollection(id, ordre);
      flash = `Ordre enregistré, ${r.ranges} affiche(s) rangée(s).`;
    } else if (action === "retirer") {
      await api.produitsDeCollection(id, { retirer: [Number(f.get("produit"))] });
      flash = "Affiche retirée de la collection. Elle reste dans le catalogue.";
    } else if (action === "ajouter") {
      const ajouter = f
        .getAll("produit")
        .map(Number)
        .filter((n) => Number.isInteger(n) && n > 0);
      if (!ajouter.length) throw new Error("Aucune affiche cochée.");
      const r = await api.produitsDeCollection(id, { ajouter });
      flash = `${ajouter.length} affiche(s) ajoutée(s). La collection en compte ${r.dedans}.`;
    } else if (action === "reglages") {
      const brutPoids = String(f.get("defaultWeightGrams") ?? "").trim();
      // Vidé veut dire « je ne sais pas », pas « ça ne pèse rien » : confondre
      // les deux ferait partir des colis sous-affranchis.
      const poids = brutPoids === "" ? null : Number(brutPoids);
      if (poids !== null && (!Number.isInteger(poids) || poids < 0))
        throw new Error("Le poids doit être un nombre de grammes, ou rester vide.");
      // La description n'a PAS de champ dans ce formulaire. L'envoyer quand
      // meme revenait a envoyer `null` : le premier reglage de poids ou de
      // visibilite effacait en silence la description reprise de l'ancienne
      // boutique. L'API n'ecrit que ce qu'on lui envoie : on ne lui envoie
      // donc que ce que l'ecran sait vraiment.
      await api.majCollection(id, {
        name: String(f.get("name") ?? "").trim(),
        ...(f.has("description")
          ? { description: String(f.get("description") ?? "").trim() || null }
          : {}),
        active: f.get("active") === "on",
        defaultWeightGrams: poids,
      });
      flash = "Collection enregistrée.";
    }
  } catch (e) {
    // Une proposition refusée le dit : sinon « il manque OPENAI_API_KEY »
    // pourrait se lire comme un enregistrement manqué.
    const proposition =
      action === "traduction-auto-tout" || (action === "traduction" && !!f.get("auto"));
    flash = (proposition ? "Aucune traduction proposée : " : "") + texteErreur(e);
    flashErreur = true;
  }
}

let collection: CollectionBo | null = null;
let produits: ProduitDeCollection[] = [];
let erreur: string | null = null;
try {
  const r = await api.collection(id);
  collection = r.collection;
  produits = r.produits;
} catch (e) {
  erreur = e instanceof Error ? e.message : String(e);
}

/** La collection a-t-elle une description française à traduire ? */
const descriptionFrancaise = !!collection && !!sansBalises(collection.description);

/**
 * « à traduire » / « partiel » / « traduit » — l'état d'une langue d'un coup
 * d'œil. Seul compte ce qui a un texte français : sans description
 * française, le nom traduit suffit.
 */
function etatLangue(code: string): { texte: string; classe: string } {
  const t = collection?.translations?.[code];
  const attendus = [!!t?.name?.trim()];
  if (descriptionFrancaise) attendus.push(!!sansBalises(t?.description));
  const faits = attendus.filter(Boolean).length;
  if (faits === attendus.length) return { texte: "traduit", classe: "bg-green-100 text-green-800" };
  if (faits) return { texte: "partiel", classe: "bg-amber-100 text-amber-800" };
  return { texte: "à traduire", classe: "bg-bo-bg text-bo-muted" };
}

/** Le texte lisible d'une description HTML, pour la montrer en regard. */
function texteLisible(html: string | null | undefined): string {
  return (html ?? "")
    .replace(/<li[^>]*>/gi, "\n• ")
    .replace(/<br\s*\/?>/gi, "\n")
    .replace(/<\/(p|div|li|ul|ol|h[1-6])\s*>/gi, "\n")
    .replace(/<[^>]*>/g, "")
    .replace(/&nbsp;/gi, " ")
    .replace(/&lt;/gi, "<")
    .replace(/&gt;/gi, ">")
    .replace(/&quot;/gi, '"')
    .replace(/&#0?39;/gi, "'")
    // L'esperluette en dernier, sinon « &amp;lt; » redeviendrait un chevron.
    .replace(/&amp;/gi, "&")
    .replace(/[ \t]+\n/g, "\n")
    .replace(/\n{3,}/g, "\n\n")
    .trim();
}

/** Le catalogue, pour proposer ce qui n'est pas encore dans la collection. */
let horsCollection: ProduitAdmin[] = [];
if (collection) {
  try {
    const dedans = new Set(produits.map((p) => p.id));
    const tout = await api.produitsAdmin({ statut: "tous", limit: 1000 });
    horsCollection = tout.produits.filter((p) => !dedans.has(p.id));
  } catch {
    // Le catalogue manque : on peut encore ranger et réordonner ce qui est là.
    horsCollection = [];
  }
}

/** L'adresse d'une image telle que le NAVIGATEUR doit la demander. */
function imageProduit(u: string | null): string {
  if (!u) return "";
  return u.startsWith("http") ? u : apiUrl(u);
}

/** Le prix affiché sous une affiche : une fourchette quand elle en a une. */
function prix(p: ProduitDeCollection): string {
  if (p.prixMin === null) return "sans format";
  return p.prixMin === p.prixMax
    ? formatPrice(p.prixMin)
    : `${formatPrice(p.prixMin)} à ${formatPrice(p.prixMax ?? p.prixMin)}`;
}

const ETIQUETTE_STATUT: Record<string, { texte: string; classe: string }> = {
  active: { texte: "Actif", classe: "bg-green-100 text-green-800" },
  draft: { texte: "Désactivé", classe: "bg-amber-100 text-amber-800" },
  archived: { texte: "Archivé", classe: "bg-bo-bg text-bo-muted" },
};
---

<Admin title={collection ? collection.name : "Collection"}>
  <p class="mb-4 text-sm">
    <a href={url("/collections")} class="text-bo-accent hover:underline">
      ← Toutes les collections
    </a>
  </p>

  {
    flash && (
      <p
        class={`mb-4 rounded border px-3 py-2 text-sm ${
          flashErreur
            ? "border-red-300 bg-red-50 text-red-800"
            : "border-green-300 bg-green-50 text-green-800"
        }`}
      >
        {flash}
      </p>
    )
  }
  {erreur && <p class="mb-4 text-sm text-red-600">API injoignable : {erreur}</p>}

  {
    collection && (
      <>
        <section id="infos" class="mb-6 rounded-lg border border-bo-border bg-bo-surface p-5">
          <form method="POST" class="flex flex-wrap items-end gap-4">
            <input type="hidden" name="_action" value="reglages" />
            <label class="text-sm">
              <span class="mb-1 block text-xs text-bo-muted">Nom</span>
              <input
                name="name"
                value={collection.name}
                class="w-72 max-w-full rounded border border-bo-border px-3 py-2 text-sm"
              />
            </label>
            <label class="text-sm">
              <span class="mb-1 block text-xs text-bo-muted">
                Poids par défaut
              </span>
              <input
                name="defaultWeightGrams"
                type="text"
                inputmode="numeric"
                value={collection.defaultWeightGrams ?? ""}
                placeholder="non renseigné"
                class="w-40 rounded border border-bo-border px-3 py-2 text-sm"
              />
            </label>
            <label class="flex items-center gap-2 pb-2 text-sm">
              <input
                type="checkbox"
                name="active"
                checked={collection.active}
              />
              <span>Visible en boutique</span>
            </label>
            <button class="rounded bg-bo-accent px-4 py-2 text-sm text-white">
              Enregistrer
            </button>
          </form>
          <p class="mt-3 text-xs text-bo-muted">
            Le poids ne sert que si ni le format ni l'affiche n'en portent un.
            Laissé vide, il ne s'applique pas.
          </p>
        </section>

        {/* Le nom (titre du rayon) et la description dans les autres langues.
            Une langue à la fois, chacune son formulaire : la description est
            un texte long, quatre éditeurs ouverts ensemble ne se liraient
            plus. Le modèle est celui des fiches produits. */}
        <section class="mb-6 rounded-lg border border-bo-border bg-bo-surface p-5">
          <h2 class="mb-1 font-semibold">Traductions</h2>
          <p class="mb-4 text-sm text-bo-muted">
            Ce que le client étranger lit en titre du rayon, et sous ce titre.
            Laissez un champ vide et c'est le français qui s'affichera. L'adresse
            du rayon, elle, ne change pas.
          </p>

          <form method="POST" class="mb-4 flex flex-wrap items-center gap-2">
            <input type="hidden" name="_action" value="traduction-auto-tout" />
            <button class="rounded border border-bo-border px-3 py-1.5 text-sm hover:border-bo-accent hover:text-bo-accent">
              ✨ Proposer les traductions manquantes (4 langues)
            </button>
            <span class="text-xs text-bo-muted">
              Ne remplit que ce qui n'est pas encore traduit. Rien n'est
              enregistré : vous relisez chaque langue, puis vous l'enregistrez.
            </span>
          </form>

          <div class="space-y-3">
            {LANGUES_TRADUITES.map((l) => {
              const proposition = propositionsTrad[l.code];
              const saisie = saisiesTrad[l.code];
              const enregistree = collection!.translations?.[l.code];
              const t = {
                name: proposition?.name ?? saisie?.name ?? enregistree?.name ?? "",
                description:
                  proposition?.description ??
                  saisie?.description ??
                  enregistree?.description ??
                  "",
              };
              const etat = etatLangue(l.code);
              return (
                <details
                  id={`langue-${l.code}`}
                  class="rounded border border-bo-border"
                  open={!!proposition || !!saisie}
                >
                  <summary class="flex cursor-pointer select-none items-center gap-2 px-4 py-2.5 text-sm font-medium">
                    <span>{l.nom}</span>
                    <span class={`rounded-full px-2 py-0.5 text-xs font-normal ${etat.classe}`}>
                      {etat.texte}
                    </span>
                    {proposition && (
                      <span class="rounded-full bg-amber-100 px-2 py-0.5 text-xs font-normal text-amber-800">
                        proposition à relire — pas encore enregistrée
                      </span>
                    )}
                  </summary>

                  <form method="POST" class="space-y-3 border-t border-bo-border p-4">
                    <input type="hidden" name="_action" value="traduction" />
                    <input type="hidden" name="lang" value={l.code} />

                    <label class="block">
                      <span class="text-xs text-bo-muted">Nom</span>
                      <input
                        name="name"
                        value={t.name}
                        maxlength={120}
                        placeholder={collection!.name}
                        class={`mt-1 w-full rounded border px-3 py-2 text-sm ${
                          proposition?.name ? "border-amber-400 bg-amber-50" : "border-bo-border"
                        }`}
                      />
                      <span class="mt-1 block text-xs text-bo-muted">
                        Français : {collection!.name}
                      </span>
                    </label>

                    {descriptionFrancaise ? (
                      <div>
                        <span class="text-xs text-bo-muted">Description</span>
                        {/* Un éditeur par langue : le HTML de la description
                            française (gras, listes, liens) se garde tel quel
                            dans la traduction. */}
                        <div
                          class={proposition?.description ? "rounded ring-2 ring-amber-400" : ""}
                        >
                          <EditeurTexte
                            nom="description"
                            valeur={t.description}
                            invite={texteLisible(collection!.description)}
                            etiquette={`Description en ${l.nom.toLowerCase()}`}
                          />
                        </div>
                        <details class="mt-1">
                          <summary class="cursor-pointer text-xs text-bo-muted">
                            Voir la description française
                          </summary>
                          <div class="mt-1 max-h-40 overflow-y-auto whitespace-pre-wrap rounded bg-bo-bg p-2 text-xs text-bo-muted">
                            {texteLisible(collection!.description)}
                          </div>
                        </details>
                      </div>
                    ) : (
                      <p class="text-xs text-bo-muted">
                        Cette collection n'a pas de description française :
                        rien à traduire de ce côté, le rayon n'en affiche dans
                        aucune langue.
                      </p>
                    )}

                    <div class="flex flex-wrap items-center gap-2">
                      {/* « Enregistrer » d'abord : c'est le bouton que la
                          touche Entrée déclenche. */}
                      <button class="rounded bg-bo-accent px-4 py-2 text-sm text-white hover:opacity-90">
                        Enregistrer {l.nom.toLowerCase()}
                      </button>
                      <button
                        name="auto"
                        value="1"
                        class="rounded border border-bo-border px-3 py-2 text-sm hover:border-bo-accent hover:text-bo-accent"
                        title="Traduit le français dans les champs restés vides, sans enregistrer"
                      >
                        ✨ Proposer les traductions manquantes
                      </button>
                    </div>
                  </form>
                </details>
              );
            })}
          </div>
        </section>

        {/* L'ordre des affiches ne se range plus ici : il se règle au même
            endroit pour TOUTES les pages de liste du site (Produits › Ordre
            d'affichage), avec poignée, flèches et clavier. Deux écrans pour
            un même geste finissaient par se contredire. */}
        <section
          id="ordre-des-affiches"
          class="mb-6 flex flex-wrap items-center justify-between gap-3 rounded-lg border border-bo-border bg-bo-surface px-4 py-3"
        >
          <div class="min-w-0">
            <h2 class="font-semibold">Ordre des affiches</h2>
            <p class="text-xs text-bo-muted">
              L'ordre dans lequel le site montre les affiches de cette
              collection — sur sa page, et partout où elle est reprise
              (vitrine de l'accueil, rangée d'une page). Une affiche ajoutée
              arrive à la fin.
            </p>
          </div>
          <a
            href={url(`/produits/ordre?page=collection:${collection.id}`)}
            class="rounded bg-bo-nav px-3 py-1.5 text-sm text-white hover:opacity-90"
          >
            Ranger les affiches de cette collection
          </a>
        </section>

        <section class="mb-6 rounded-lg border border-bo-border bg-bo-surface">
          <header class="flex flex-wrap items-center justify-between gap-3 border-b border-bo-border px-4 py-3">
            <div>
              <h2 class="font-semibold">
                {produits.length} affiche{produits.length > 1 ? "s" : ""} dans
                cette collection
              </h2>
              <p class="text-xs text-bo-muted">
                Dans l'ordre du site. « Retirer » sort l'affiche de la
                collection sans la supprimer du catalogue.
              </p>
            </div>
            <div class="flex items-center gap-2 text-sm">
              {/* Deux façons de regarder : des noms, ou des visuels. */}
              <div class="inline-flex overflow-hidden rounded border border-bo-border">
                <button
                  type="button"
                  data-vue="liste"
                  class="px-3 py-1.5 text-bo-muted hover:bg-bo-bg"
                >
                  Liste
                </button>
                <button
                  type="button"
                  data-vue="icones"
                  class="border-l border-bo-border px-3 py-1.5 text-bo-muted hover:bg-bo-bg"
                >
                  Icônes
                </button>
              </div>
            </div>
          </header>

          <ul id="grille" class="p-4" data-vue="liste">
            {produits.map((p) => {
              const badge = ETIQUETTE_STATUT[p.status] ?? {
                texte: p.status,
                classe: "bg-bo-bg text-bo-muted",
              };
              return (
                <li
                  class="ml-carte rounded border border-bo-border bg-bo-surface"
                  data-produit={p.id}
                >
                  <span class="ml-vignette">
                    {p.image ? (
                      <img
                        src={imageProduit(p.image)}
                        alt=""
                        loading="lazy"
                        class="h-full w-full rounded object-cover"
                      />
                    ) : (
                      <span class="block h-full w-full rounded bg-bo-bg" />
                    )}
                  </span>
                  <span class="ml-infos">
                    <a
                      href={url(`/produits/${p.id}`)}
                      class="font-medium text-bo-accent hover:underline"
                    >
                      {p.name}
                    </a>
                    <span class="ml-details text-xs text-bo-muted">
                      <span
                        class={`inline-block rounded-full px-2 py-0.5 ${badge.classe}`}
                      >
                        {badge.texte}
                      </span>
                      <span class="ml-2">{prix(p)}</span>
                    </span>
                  </span>
                  <form method="POST" class="ml-retirer">
                    <input type="hidden" name="_action" value="retirer" />
                    <input type="hidden" name="produit" value={p.id} />
                    <button
                      class="text-xs text-red-700 hover:underline"
                      title="Retirer de la collection, sans supprimer l'affiche"
                    >
                      Retirer
                    </button>
                  </form>
                </li>
              );
            })}
          </ul>
          {produits.length === 0 && (
            <p class="px-4 pb-6 text-center text-sm text-bo-muted">
              Cette collection est vide. Ajoutez-y des affiches ci-dessous.
            </p>
          )}
        </section>

        <section class="rounded-lg border border-bo-border bg-bo-surface p-5">
          <h2 class="mb-1 text-base font-semibold">Ajouter des affiches</h2>
          <p class="mb-3 text-sm text-bo-muted">
            Cochez, puis ajoutez. Une affiche peut appartenir à plusieurs
            collections.
          </p>
          <input
            id="recherche-ajout"
            type="search"
            placeholder="Rechercher par nom…"
            class="mb-3 w-72 max-w-full rounded border border-bo-border px-3 py-2 text-sm"
          />
          <form method="POST">
            <input type="hidden" name="_action" value="ajouter" />
            <div class="max-h-80 overflow-y-auto rounded border border-bo-border">
              {horsCollection.map((p) => (
                <label
                  class="ml-ligne-ajout flex items-center gap-3 border-b border-bo-border px-3 py-2 text-sm last:border-b-0"
                  data-nom={p.name.toLowerCase()}
                >
                  <input type="checkbox" name="produit" value={p.id} />
                  {p.imageUrl ? (
                    <img
                      src={imageProduit(p.imageUrl)}
                      alt=""
                      loading="lazy"
                      class="h-10 w-8 rounded border border-bo-border object-cover"
                    />
                  ) : (
                    <span class="block h-10 w-8 rounded border border-bo-border bg-bo-bg" />
                  )}
                  <span class="flex-1">{p.name}</span>
                </label>
              ))}
              {horsCollection.length === 0 && (
                <p class="px-3 py-6 text-center text-sm text-bo-muted">
                  Toutes les affiches du catalogue sont déjà dans cette
                  collection.
                </p>
              )}
            </div>
            <button class="mt-3 rounded bg-bo-accent px-4 py-2 text-sm text-white">
              Ajouter les affiches cochées
            </button>
          </form>
        </section>
      </>
    )
  }

  <style is:global>
    /* La LISTE se lit, les ICÔNES se reconnaissent. Une seule structure dans
       la page, deux mises en forme : sans cela, changer de vue demanderait de
       redessiner la grille et l'ordre en cours se perdrait. */
    #grille[data-vue="liste"] {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }
    #grille[data-vue="liste"] .ml-carte {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.5rem 0.75rem;
    }
    #grille[data-vue="liste"] .ml-vignette {
      display: block;
      width: 2.5rem;
      height: 3.4rem;
      flex: none;
    }
    #grille[data-vue="liste"] .ml-infos {
      display: flex;
      min-width: 0;
      flex: 1;
      flex-direction: column;
    }

    #grille[data-vue="icones"] {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
      gap: 0.75rem;
    }
    #grille[data-vue="icones"] .ml-carte {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.4rem;
      padding: 0.75rem 0.5rem;
      text-align: center;
    }
    #grille[data-vue="icones"] .ml-vignette {
      display: block;
      width: 100%;
      aspect-ratio: 3 / 4;
    }
    #grille[data-vue="icones"] .ml-infos {
      display: flex;
      width: 100%;
      min-width: 0;
      flex-direction: column;
      gap: 0.15rem;
      font-size: 0.8rem;
      line-height: 1.15rem;
    }
    #grille[data-vue="icones"] .ml-retirer {
      position: absolute;
      top: 0.35rem;
      right: 0.4rem;
    }
  </style>

  <script is:inline>
    (function () {
      var grille = document.getElementById("grille");
      if (!grille) return;

      // La vue choisie suit la personne d'une collection à l'autre : c'est une
      // préférence de travail, pas un réglage de la boutique.
      var CLE_VUE = "ml_vue_collection";
      function poserVue(vue) {
        grille.dataset.vue = vue;
        document.querySelectorAll("[data-vue]").forEach(function (b) {
          if (b === grille || !b.dataset.vue) return;
          var actif = b.dataset.vue === vue;
          b.classList.toggle("bg-bo-nav", actif);
          b.classList.toggle("text-white", actif);
          b.classList.toggle("text-bo-muted", !actif);
        });
        try {
          localStorage.setItem(CLE_VUE, vue);
        } catch (e) {
          /* sans stockage, la vue ne tient que le temps de la page */
        }
      }
      document.querySelectorAll("button[data-vue]").forEach(function (b) {
        b.addEventListener("click", function () {
          poserVue(b.dataset.vue);
        });
      });
      var retenue = "liste";
      try {
        retenue = localStorage.getItem(CLE_VUE) || "liste";
      } catch (e) {
        /* rien à retenir */
      }
      poserVue(retenue === "icones" ? "icones" : "liste");

      // Le filtre de la liste d'ajout : cent soixante affiches ne se
      // parcourent pas à l'œil.
      var recherche = document.getElementById("recherche-ajout");
      if (recherche) {
        recherche.addEventListener("input", function () {
          var q = recherche.value.trim().toLowerCase();
          document.querySelectorAll(".ml-ligne-ajout").forEach(function (l) {
            l.style.display =
              !q || (l.dataset.nom || "").indexOf(q) !== -1 ? "" : "none";
          });
        });
      }
    })();
  </script>
</Admin>
