---
/**
 * Affiches IA : ce que la génération coûte, comment elle est réglée, ce
 * qu'elle a produit.
 *
 * Le visiteur n'a aucun quota — c'est un choix assumé. Ce qui est surveillé
 * ici, ce n'est donc pas lui, c'est la dépense : elle est le premier chiffre
 * de l'écran, et le plafond mensuel le seul arrêt d'urgence.
 */
import Admin from "../layouts/Admin.astro";
import { apiUrl, url } from "../lib/url.ts";
import {
  adminApi,
  formatPrice,
  type BilanPurgeIa,
  type ListeGenerationsIA,
  type StatsIA,
} from "../lib/api.ts";

const api = adminApi(Astro.request);

// URL de l'API vue du navigateur : les aperçus sont servis sous /assets et
// s'affichent dans la page, pas côté serveur.
const PUBLIC_API_URL =
  import.meta.env.PUBLIC_API_URL ?? "http://localhost:3000";

/**
 * L'adresse du site, d'où vient le module de personnalisation de « Créer une
 * affiche » (20/11). Vide derrière le proxy : site et back-office partagent
 * alors la même origine, et le chemin suffit.
 */
const SITE = String(
  import.meta.env.PUBLIC_SITE_URL ?? import.meta.env.PUBLIC_ORIGIN ?? "",
).replace(/\/$/, "");

/**
 * Modèles d'image disponibles sur la clé de la boutique.
 *
 * 26/11 : gpt-image-1 retiré (arrêté par OpenAI le 23/10/2026, chaque affiche
 * aurait échoué) ; gpt-image-2.5-sunburst, le modèle par défaut de l'API, et
 * gpt-image-2.5-flare ajoutés, pour qu'on puisse y revenir d'ici.
 */
const MODELES = [
  { valeur: "gpt-image-2", label: "gpt-image-2" },
  { valeur: "gpt-image-2.5-sunburst", label: "gpt-image-2.5-sunburst — réglage d'origine" },
  { valeur: "gpt-image-2.5-flare", label: "gpt-image-2.5-flare" },
  { valeur: "gpt-image-1.5", label: "gpt-image-1.5 — tailles standard seulement" },
  { valeur: "gpt-image-1-mini", label: "gpt-image-1-mini — le plus économique, tailles standard" },
];

/**
 * Seuls gpt-image-2 et ses suites (2.5…) font des tailles libres comme
 * 1584 × 2240 ; OpenAI refuse les autres (400). Même règle que l'API
 * (tailleDuModele, ia.ts), qui ramène de toute façon la taille au départ.
 */
const tailleLibreAcceptee = (modele: string) => modele.startsWith("gpt-image-2");
const TAILLES_STANDARD = ["1024x1024", "1024x1536", "1536x1024", "auto"];

/**
 * Une affiche se lit en hauteur : le portrait est le format normal ici.
 *
 * 1584 × 2240 en tête (26/11) : c'est le défaut de l'API (DEFAUTS, ia.ts), le
 * rapport exact de l'A3, et la taille qui s'imprime nettement (136 points par
 * pouce en A3, contre 88 en 1024 × 1536). Elle manquait au menu : enregistrer
 * ces réglages, ne serait-ce que pour corriger le style commun, écrivait
 * 1024 × 1536 sans que personne l'ait choisi (Margaux, 26/11 : « qualité
 * affiches IA pas top »). Le paysage, lui, part en 2240 × 1584.
 *
 * 2416 × 3424 ensuite (26/11, Alexandra : « faut que les affiches IA aient la
 * même taille que les autres affiches tu vois ») : la plus grande image au
 * format A que gpt-image-2 accepte (TAILLE_MAX, ia.ts) ; le paysage la suit
 * alors en 3424 × 2416. Refusée par OpenAI, l'affiche repart d'elle-même en
 * 1584 × 2240. Les coûts sont ceux de gpt-image-2 en haute qualité
 * (coutAttenduCents, ia.ts).
 */
const TAILLES = [
  {
    valeur: "1584x2240",
    label: "1584 × 2240 — recommandé : la plus grande taille garantie par OpenAI, nette à l'impression (environ 26 c l'image)",
  },
  {
    valeur: "2416x3424",
    // Le risque du délai dans le libellé même (relecture du 26/11) : une
    // image plus longue que 4 min 40 est abandonnée, et payée.
    label:
      "2416 × 3424 — taille maximale, la plus proche des autres affiches (292 ppp en A4, 207 en A3) — expérimentale chez OpenAI pour gpt-image-2.5, environ 47 c l'image, la plus lente : au-delà de 4 min 40, la création échoue et reste payée",
  },
  { valeur: "1024x1536", label: "1024 × 1536 — moins cher (environ 17 c), moins net" },
  { valeur: "1024x1024", label: "1024 × 1024 — carré" },
  { valeur: "1536x1024", label: "1536 × 1024 — paysage" },
  { valeur: "auto", label: "auto — le modèle décide" },
];

const MODELE_DEFAUT = "gpt-image-1-mini";
const TAILLE_DEFAUT = "1584x2240";

/**
 * Le réglage enregistré figure toujours au menu (26/11). Absent de la liste
 * (« gpt-image-2.5-sunburst », ou une taille d'avant), aucune option n'était
 * cochée : le navigateur montrait la PREMIÈRE, et le moindre enregistrement
 * la mettait à la place, sans que rien ne l'annonce.
 */
function avecLeReglageActuel(
  liste: { valeur: string; label: string }[],
  actuel: string,
): { valeur: string; label: string }[] {
  return !actuel || liste.some((o) => o.valeur === actuel)
    ? liste
    : [{ valeur: actuel, label: `${actuel} — en service` }, ...liste];
}

const PURGE_DEFAUT = 30;
/** Générations montrées d'un coup dans la galerie. */
const PAR_PAGE = 60;

/**
 * Le plafond saisi (« 49,90 ») en centimes, ou « vide ».
 *
 * Relecture du 26/11 : un champ vidé s'enregistrait à 0 — et l'API, qui lit
 * 0 comme « plus rien », refusait alors TOUTE création, au stand comme sur
 * le site, pendant que cet écran affirmait « Aucun plafond n'est réglé ».
 * Désormais, comme le plafond des fonds (fonds.astro) : vide, le réglage
 * retombe sur son défaut de 50 € (l'indication du champ) ; « 0 », dit
 * exprès, arrête la création, et l'écran le dit ; un montant illisible
 * n'enregistre rien.
 */
function plafondSaisi(v: FormDataEntryValue | null): number | "vide" {
  const texte = String(v ?? "").replace(/[\s€]/g, "").replace(",", ".");
  if (!texte) return "vide";
  const n = Number(texte);
  if (!Number.isFinite(n) || n < 0)
    throw new Error(`Plafond de dépense : « ${String(v)} » n'est pas un montant. Écrivez par exemple 50 ou 49,90.`);
  return Math.round(n * 100);
}

/**
 * Ce qu'une purge a effacé, en une phrase. L'API répondait autrefois
 * { lignes, fichiers } quand l'écran lisait « supprimees » : il annonçait
 * « Rien à effacer » même après avoir effacé.
 */
function bilanDePurge(r: BilanPurgeIa): string {
  if (r.motif) return r.motif;
  const parties = [
    r.lignes ? `${r.lignes} génération(s) non achetée(s) vidée(s) (${r.fichiers} fichier(s))` : "",
    r.orphelins ? `${r.orphelins} photo(s) jamais utilisée(s)` : "",
    r.relais ? `${r.relais} photo(s) oubliée(s) par le relais du stand` : "",
  ].filter(Boolean);
  return parties.length
    ? `Effacé : ${parties.join(", ")}.`
    : "Rien à effacer : aucune photo non achetée n'a dépassé le délai.";
}

/** Entier positif saisi, ou la valeur de repli. */
function entier(v: FormDataEntryValue | null, defaut: number): number {
  const n = Math.round(Number(String(v ?? "").trim()));
  return Number.isFinite(n) && n >= 0 ? n : defaut;
}

let flash: string | null = null;
let flashErreur = false;

if (Astro.request.method === "POST") {
  const f = await Astro.request.formData();
  try {
    if (f.get("_action") === "purger") {
      flash = bilanDePurge(await api.purgerIa());
    } else if (f.get("_action") === "fiche") {
      // « Créer une fiche produit » (20/11, Alexandra) : l'image, un décor
      // nu, devient le fond d'une affiche PERSONNALISABLE, créée désactivée.
      // Même chemin que BO › Produits › Nouvelle affiche (createProduct) ;
      // seule la copie de l'image parmi les décors est propre à cet écran.
      const nom = String(f.get("nom") ?? "").trim();
      if (!nom) throw new Error("Donnez un nom à l'affiche.");
      const ville = String(f.get("ville") ?? "").trim();
      const decor = await api.iaEnDecor(String(f.get("publicId") ?? ""));
      const produit = await api.createProduct({
        name: nom,
        kind: "personnalisable",
        // La ville en 1re ligne, comme sur les autres affiches de ville ;
        // rien si on ne la connaît pas.
        defaultTitle: ville || null,
        variants: decor.variants,
        // Le décor sert aussi de visuel en attendant une affiche d'exemple :
        // une fiche sans image ne se reconnaît pas dans la liste.
        images: [decor.url],
        backgrounds: [decor.url],
        status: "draft",
      });
      return Astro.redirect(url(`/produits/${produit.id}?depuisIa=1`), 303);
    } else {
      // Montants et durées partent en NOMBRES : l'API compare et additionne
      // ces réglages, une chaîne s'y additionnerait bout à bout.
      // Le plafond d'abord : illisible, il n'enregistre rien du tout.
      const plafond = plafondSaisi(f.get("plafondEuros"));
      const modeleChoisi = String(f.get("modele") ?? MODELE_DEFAUT);
      let tailleChoisie = String(f.get("taille") ?? TAILLE_DEFAUT);
      // Un modèle qui ne fait que les tailles standard (gpt-image-1.5,
      // -1-mini) avec 1584 × 2240 : chaque affiche échouerait chez OpenAI.
      // On enregistre la taille standard du même sens, et on le dit (26/11).
      let ajuste = "";
      if (!tailleLibreAcceptee(modeleChoisi) && !TAILLES_STANDARD.includes(tailleChoisie)) {
        ajuste = ` ${modeleChoisi} ne sait pas faire ${tailleChoisie.replace("x", " × ")} : la taille enregistrée est 1024 × 1536.`;
        tailleChoisie = "1024x1536";
      }
      await api.setSetting("ia.stylePrompt", String(f.get("stylePrompt") ?? ""));
      // Le modèle et la taille ne s'écrivent que s'ils changent (relecture
      // finale du 26/11) : leur date d'enregistrement ouvre la période que
      // compte le cadre « Taille maximale refusée » (repliDeTaille, ia.ts).
      // Réécrits à chaque enregistrement du plafond ou du délai de
      // conservation, ils la remettaient à zéro, et le cadre disparaissait
      // alors que rien n'avait changé.
      const enregistres = await api.settings();
      if (String(enregistres["ia.modele"] ?? "") !== modeleChoisi)
        await api.setSetting("ia.modele", modeleChoisi);
      if (String(enregistres["ia.taille"] ?? "") !== tailleChoisie)
        await api.setSetting("ia.taille", tailleChoisie);
      await api.setSetting("ia.plafondMensuelCents", plafond === "vide" ? "" : plafond);
      await api.setSetting("ia.purgeJours", entier(f.get("purgeJours"), PURGE_DEFAUT));
      flash =
        `Réglages enregistrés.${ajuste}` +
        (plafond === "vide"
          ? " Plafond laissé vide : il revient à 50 € par mois."
          : plafond === 0
            ? " Plafond à 0 € : plus aucune affiche n'est créée, ni au stand ni sur le site, jusqu'à ce que vous en régliez un."
            : "");
    }
  } catch (e) {
    flash = String(e);
    flashErreur = true;
  }
}

const ONGLETS = [
  { cle: "toutes", label: "Toutes" },
  { cle: "prete", label: "Prêtes" },
  { cle: "en_cours", label: "En cours" },
  { cle: "echec", label: "Échecs" },
];
const statut = Astro.url.searchParams.get("statut") ?? "toutes";
const page = Math.max(0, Number(Astro.url.searchParams.get("page") ?? 0) || 0);

let stats: StatsIA | null = null;
let erreurStats: string | null = null;
try {
  stats = await api.iaStats();
} catch (e) {
  erreurStats = String(e);
}

let galerie: ListeGenerationsIA | null = null;
let erreurGalerie: string | null = null;
try {
  galerie = await api.iaGenerations({
    statut: statut === "toutes" ? undefined : statut,
    page,
    limite: PAR_PAGE,
  });
} catch (e) {
  erreurGalerie = String(e);
}
const lignes = galerie?.lignes ?? [];

let reglages: Record<string, unknown> = {};
let erreurReglages: string | null = null;
try {
  reglages = await api.settings();
} catch (e) {
  erreurReglages = String(e);
}

const texte = (cle: string) =>
  typeof reglages[cle] === "string" ? (reglages[cle] as string) : "";

/**
 * Les fonds de « Créer un fond », à part (relecture du 20/11) : leur dépense
 * ne compte plus dans le plafond des affiches, qui ne protège que les clients,
 * et ils ont le leur. L'API les ajoute aux chiffres du mois.
 */
const fondsDuMois = stats?.fonds ?? null;

// Ce que l'API applique fait foi : c'est elle qui lit les réglages et facture.
const modele = stats?.modele ?? texte("ia.modele") ?? MODELE_DEFAUT;
const taille = stats?.taille ?? texte("ia.taille") ?? TAILLE_DEFAUT;
const plafondCents = stats?.plafondCents ?? 0;
const purgeJours = stats?.purgeJours ?? PURGE_DEFAUT;
/**
 * Ce que montre le champ du plafond (relecture du 26/11) : le plafond
 * appliqué par l'API, 0 compris (« 0.00 ») ; sans ses chiffres, le réglage
 * enregistré tel quel ; vide seulement s'il n'y en a pas — enregistrer
 * l'écran ne doit jamais poser 0 sans qu'on l'ait tapé.
 */
const brutDuPlafond = reglages["ia.plafondMensuelCents"];
const plafondEnregistre =
  brutDuPlafond === undefined || brutDuPlafond === null || brutDuPlafond === ""
    ? Number.NaN
    : Number(brutDuPlafond);
const valeurDuPlafond = stats
  ? (stats.plafondCents / 100).toFixed(2)
  : Number.isFinite(plafondEnregistre)
    ? (plafondEnregistre / 100).toFixed(2)
    : "";

const depenseCents = stats?.mois?.depenseCents ?? 0;
const partDuPlafond = plafondCents > 0 ? depenseCents / plafondCents : 0;
/**
 * Le coût d'un aperçu (26/11) : celui des réglages du moment, taille et
 * qualité comptées, quand l'API sait le calculer (gpt-image-2) ; sinon
 * l'estimation fixe du réglage — 8 c, quand une affiche en haute qualité en
 * coûte de 17 à 47 : « soit 1 250 aperçus avant le plafond » en promettait
 * trois à six fois trop.
 */
const coutAttendu = stats?.coutAttenduCents ?? null;
const coutParImage = coutAttendu ?? stats?.coutParImageCents ?? 0;
const apercusRestants =
  coutParImage > 0 ? Math.floor((stats?.resteCents ?? 0) / coutParImage) : null;

/**
 * Le filet de la taille (relecture du 26/11) : avec la taille maximale
 * réglée, les affiches prêtes depuis le dernier enregistrement de la taille
 * ou du modèle, et combien sont parties à la taille sûre parce qu'OpenAI a
 * refusé la grande. null quand rien n'est à dire.
 */
const repli = stats?.repliDeTaille ?? null;
const phraseDuRepli =
  repli && repli.repliees > 0
    ? `depuis ${quand(repli.depuis)}, ${
        repli.repliees === repli.affiches
          ? repli.affiches > 1
            ? `les ${repli.affiches} affiches créées sont parties`
            : "l'affiche créée est partie"
          : `${repli.repliees} affiche${repli.repliees > 1 ? "s" : ""} sur ${repli.affiches} ${
              repli.repliees > 1 ? "sont parties" : "est partie"
            }`
      } à la taille sûre (${repli.tailleSure.replace("x", " × ")}, ou couchée en paysage) au lieu de ${taille.replace("x", " × ")} : OpenAI a refusé la taille maximale, et le repli automatique a pris le relais, au prix de la taille sûre.`
    : null;

/**
 * Taux d'échec recalculé sur les deux compteurs : une part (0,12) et un
 * pourcentage (12) se ressemblent trop pour qu'on affiche l'un pour l'autre.
 */
const essais = stats?.mois?.essais ?? 0;
const echecs = stats?.mois?.echecs ?? 0;
const tauxEchec = essais > 0 ? Math.round((echecs / essais) * 100) : null;

/**
 * Décompte de la purge : la purge elle-même, en simulation. Mêmes règles,
 * même historique complet que le passage horaire — un décompte refait ici à
 * part, sur un échantillon, finissait toujours par dire autre chose que ce
 * que la purge efface vraiment.
 */
let apercuPurge: BilanPurgeIa | null = null;
try {
  apercuPurge = await api.purgerIa(true);
} catch {
  // Sans décompte, le bloc de purge le dit et n'annonce aucun chiffre.
}

const STATUTS: Record<string, { texte: string; classe: string }> = {
  prete: { texte: "Prête", classe: "bg-green-100 text-green-900" },
  en_cours: { texte: "En cours", classe: "bg-amber-100 text-amber-900" },
  echec: { texte: "Échec", classe: "bg-red-50 text-red-700" },
};

function quand(iso: string | null | undefined): string {
  if (!iso) return "—";
  try {
    const d = new Date(iso);
    const jour = d.toLocaleDateString("fr-FR", { day: "numeric", month: "long" });
    const heure = d.toLocaleTimeString("fr-FR", {
      hour: "2-digit",
      minute: "2-digit",
    });
    return `le ${jour} à ${heure}`;
  } catch {
    return "—";
  }
}

/** Aperçu filigrané : chemin d'assets à préfixer, ou adresse déjà complète. */
function apercuSrc(u: string | null): string {
  if (!u) return "";
  return u.startsWith("http") ? u : `${PUBLIC_API_URL}${u}`;
}

/** Reconstruit l'URL de la page en changeant une seule clé. */
function lienAvec(modif: Record<string, string | null>): string {
  const p = new URLSearchParams(Astro.url.searchParams);
  for (const [k, v] of Object.entries(modif)) {
    if (v === null || v === "") p.delete(k);
    else p.set(k, v);
  }
  const qs = p.toString();
  return url(`/ia${qs ? `?${qs}` : ""}`);
}

const total = galerie?.total ?? 0;
const premiere = page * PAR_PAGE;
const derniere = premiere + lignes.length;
---

<Admin title="Affiches IA">
  {flash && (
    <p
      class={`mb-4 rounded border px-3 py-2 text-sm ${
        flashErreur ? "border-red-200 bg-red-50" : "border-green-200 bg-green-50"
      }`}
    >
      {flash}
    </p>
  )}

  {erreurStats && (
    <p class="mb-4 text-sm text-red-600">
      Chiffres du mois indisponibles : {erreurStats}
    </p>
  )}

  {stats && !stats.configuree && (
    <p class="mb-4 rounded border border-red-200 bg-red-50 px-3 py-2 text-sm">
      La clé OpenAI manque à l'appel : aucune affiche IA ne peut être générée
      pour l'instant. Les visiteurs voient une erreur.
    </p>
  )}

  {/* =============================================================== */}
  {/* 1 — Le mois en cours                                            */}
  {/* =============================================================== */}
  <section class="mb-6">
    <div class="grid gap-px overflow-hidden rounded-lg border border-bo-border bg-bo-border sm:grid-cols-2 lg:grid-cols-5">
      <div class="bg-bo-surface px-4 py-3 sm:col-span-2">
        <div class="text-xs text-bo-muted">Dépensé ce mois-ci pour les affiches des clients</div>
        <div class="mt-1 flex items-baseline gap-2">
          <span class="text-3xl">{formatPrice(depenseCents)}</span>
          {plafondCents > 0 && (
            <span class="text-sm text-bo-muted">
              sur {formatPrice(plafondCents)} autorisés
            </span>
          )}
        </div>
        {plafondCents > 0 && (
          <div class="mt-2 h-2 w-full overflow-hidden rounded bg-bo-bg">
            <div
              class={`h-2 ${
                partDuPlafond >= 1
                  ? "bg-red-600"
                  : partDuPlafond >= 0.8
                    ? "bg-amber-500"
                    : "bg-bo-accent"
              }`}
              style={`width:${Math.min(100, Math.round(partDuPlafond * 100))}%`}
            >
            </div>
          </div>
        )}
        <p class="mt-2 text-xs text-bo-muted">
          {/* À 0, l'API refuse TOUTE création (relecture du 26/11) : l'écran
              disait l'inverse, « la dépense n'est bornée par rien ». */}
          {stats && plafondCents === 0
            ? "Plafond à 0 € : plus aucune affiche n'est créée, ni au stand ni sur le site. Pour relancer la création, réglez un plafond dans les réglages, plus bas sur cette page."
            : stats?.plafondAtteint
              ? "Plafond atteint : plus aucune affiche n'est générée jusqu'au mois prochain."
              : partDuPlafond >= 0.8
                ? "Le plafond approche. Au-delà, la génération s'arrête d'elle-même."
                : `Il reste ${formatPrice(stats?.resteCents ?? 0)} ce mois-ci. Chaque aperçu demandé est facturé, que le visiteur achète ou non.`}
        </p>
        {fondsDuMois && (
          <p class="mt-1 text-xs text-bo-muted">
            À part : les fonds de
            <a href={url("/fonds")} class="text-bo-accent underline">Créer des fonds</a>,
            {formatPrice(fondsDuMois.depenseCents)} engagés sur leur propre plafond de
            {formatPrice(fondsDuMois.plafondCents)}. Ils ne comptent pas ici et ne
            peuvent pas couper les affiches des clients.
          </p>
        )}
      </div>

      <div class="bg-bo-surface px-4 py-3">
        <div class="text-xs text-bo-muted">Aperçus demandés</div>
        <div class="mt-1 text-2xl">{stats ? essais : "—"}</div>
        <div class="text-xs text-bo-muted">
          {stats ? `dont ${stats.mois.payees} achetée(s)` : "depuis le 1er du mois"}
        </div>
      </div>

      <div class="bg-bo-surface px-4 py-3">
        <div class="text-xs text-bo-muted">Taux d'échec</div>
        <div class="mt-1 flex items-baseline gap-2">
          <span class="text-2xl">{tauxEchec === null ? "—" : `${tauxEchec} %`}</span>
          {echecs > 0 && <span class="text-xs text-bo-muted">{echecs} raté(s)</span>}
        </div>
        <div class="text-xs text-bo-muted">
          {/* Une création coupée au délai est payée, et compte au plafond
              (relecture du 26/11, coutDUnEchec dans ia.ts) : « Un échec
              n'est pas facturé » n'était plus vrai pour elle. */}
          {tauxEchec !== null && tauxEchec >= 20
            ? "Anormalement haut : voyez les échecs plus bas."
            : "Un refus d'OpenAI n'est pas facturé ; une création abandonnée après 4 min 40, si."}
        </div>
      </div>

      <div class="bg-bo-surface px-4 py-3">
        <div class="text-xs text-bo-muted">
          {/* « auto » : le modèle choisit la taille, l'API la compte comme
              1024 × 1536 (coutAttenduDuModele, relecture finale du 26/11). */}
          {coutAttendu === null
            ? "Coût d'un aperçu (estimation fixe)"
            : taille === "auto"
              ? "Coût d'un aperçu, environ (« auto » compté comme 1024 × 1536)"
              : stats?.coutAttenduEstime
                ? "Coût d'un aperçu, environ (tarifs de gpt-image-2)"
                : "Coût d'un aperçu, environ"}
        </div>
        <div class="mt-1 text-2xl">
          {coutParImage > 0 ? formatPrice(coutParImage) : "—"}
        </div>
        <div class="text-xs text-bo-muted">
          {apercusRestants === null
            ? `modèle ${modele}`
            : `${coutAttendu === null || taille === "auto" ? "" : `en ${taille.replace("x", " × ")} : `}soit environ ${apercusRestants} aperçu${apercusRestants > 1 ? "s" : ""} avant le plafond`}
        </div>
      </div>
    </div>
    {/* Le filet de la taille vu d'ici (relecture du 26/11) : quand OpenAI
        refuse la taille maximale, chaque affiche repart d'elle-même en
        1584 × 2240 — sans ce cadre, les réglages continuaient d'annoncer
        2416 × 3424 à 47 c, et seule la légende de chaque vignette le
        trahissait. */}
    {phraseDuRepli && (
      <p class="mt-3 rounded border border-amber-300 bg-amber-50 px-3 py-2 text-sm text-amber-900">
        <strong class="font-medium">Taille maximale refusée :</strong> {phraseDuRepli}
        Revenez à 1584 × 2240 pour que les réglages disent ce qui sort, ou
        réessayez plus tard.
      </p>
    )}
  </section>

  {/* =============================================================== */}
  {/* 2 — Réglages communs                                            */}
  {/* =============================================================== */}
  <section id="reglages" class="mb-6 rounded-lg border border-bo-border bg-bo-surface p-5">
    <h3 class="mb-1 font-semibold">Réglages</h3>
    {/* Réécrit le 26/11 : « vient s'ajouter à celui-ci » n'est plus vrai
        depuis le 25/11 (la consigne d'un style part seule), et la phrase
        contredisait l'aide du style commun juste en dessous. */}
    <p class="mb-4 max-w-3xl text-sm text-bo-muted">
      Le modèle, la taille, le plafond et la conservation valent pour
      <strong>toutes</strong> les affiches IA. Le style commun, lui, ne part
      qu'avec une affiche sans style, ou dont le style n'a pas de consigne. La
      consigne propre à une affiche, sur sa fiche produit, s'ajoute à celle du
      style que le client a choisi.
    </p>

    {erreurReglages && (
      <p class="mb-3 text-sm text-red-600">Réglages illisibles : {erreurReglages}</p>
    )}

    <form method="POST" class="space-y-4 text-sm">
      <label class="block">
        <span class="text-bo-muted">Style commun de la boutique</span>
        <textarea
          name="stylePrompt"
          rows="4"
          class="mt-1 w-full rounded border border-bo-border px-3 py-2"
          placeholder="Illustration à l'aquarelle, traits doux, couleurs pastel, fond uni crème, cadrage en pied, aucune écriture dans l'image."
          >{texte("ia.stylePrompt")}</textarea
        >
        <span class="mt-1 block text-xs text-bo-muted">
          Envoyé au modèle avec la photo du visiteur, mais seulement pour une
          affiche créée sans style, ou avec un style qui n'a pas de consigne :
          depuis le 25/11, la consigne d'un style part seule
          (<a href={url("/ia/styles")} class="text-bo-accent underline">Styles proposés</a>).
          Décrivez le rendu voulu, pas la personne : le modèle a déjà la photo.
        </span>
      </label>

      <div class="flex flex-wrap items-end gap-4">
        <label class="block">
          <span class="text-bo-muted">Modèle</span>
          <select
            name="modele"
            class="mt-1 block w-72 rounded border border-bo-border px-3 py-2"
          >
            {avecLeReglageActuel(MODELES, modele).map((m) => (
              <option value={m.valeur} selected={m.valeur === modele}>
                {m.label}
              </option>
            ))}
          </select>
        </label>

        <label class="block">
          <span class="text-bo-muted">Taille de l'image</span>
          <select
            name="taille"
            class="mt-1 block w-full max-w-xl rounded border border-bo-border px-3 py-2"
          >
            {avecLeReglageActuel(TAILLES, taille).map((t) => (
              <option value={t.valeur} selected={t.valeur === taille}>
                {t.label}
              </option>
            ))}
          </select>
        </label>
      </div>
      {/* Le coût n'est réel que pour les modèles dont l'API connaît les
          tarifs (26/11) : ailleurs, la galerie montre une estimation, et
          l'aide ne doit pas laisser croire le contraire. Le délai (relecture
          du 26/11) : OPENAI_TIMEOUT_MS, 280 s dans ia.ts ; une image coupée
          compte au plafond (coutDUnEchec). */}
      <p class="-mt-2 max-w-3xl text-xs text-bo-muted">
        Taille des affiches en portrait ; en paysage, elles partent en
        2240 × 1584, ou en 3424 × 2416 avec la taille maximale. Toutes les
        affiches s'impriment sur 2480 × 3508 pixels en A4 et 3508 × 4960 en A3
        (300 points par pouce) : l'image d'une affiche IA y est agrandie, puis
        légèrement accentuée. 2416 × 3424 s'imprime ainsi à 292 points par
        pouce en A4 et 207 en A3, presque comme les autres affiches ;
        1584 × 2240 à 192 et 136 ; 1024 × 1536 à 124 et 88 seulement, et perd
        le haut et le bas de l'image, coupés au format. Si OpenAI refuse la
        taille maximale, l'affiche repart d'elle-même en 1584 × 2240 (le
        cadre « Taille maximale refusée » vous le dit plus haut). Plus
        grande, l'image coûte plus cher et se fait attendre plus longtemps : avec
        gpt-image-2 en haute qualité, environ 17 c, 26 c ou 47 c l'image — avec
        100 € par mois, environ 600, 380 ou 210 affiches.
        <strong class="font-medium text-bo-ink">
          Une création qui dépasse 4 min 40 est abandonnée : la cliente voit un
          échec, et l'image, payée chez OpenAI, compte au plafond.
        </strong>
        En 2416 × 3424, la plus longue à dessiner, ce délai peut être atteint :
        essayez-la sur quelques affiches avant de la garder, et revenez à
        1584 × 2240 si les échecs montent. Les tailles libres n'existent
        qu'avec gpt-image-2 et ses suites (2.5) : avec gpt-image-1.5 ou 1-mini,
        la taille enregistrée redevient 1024 × 1536, et les affiches en paysage
        partent en 1536 × 1024. Avec gpt-image-2, la galerie montre le coût
        réel de chaque image ; avec ses suites, une estimation sur les tarifs
        de gpt-image-2, selon la taille (« auto » comptée comme 1024 × 1536,
        au moins) ; avec gpt-image-1.5 ou 1-mini, une estimation fixe, la même
        quelle que soit la taille. Une estimation est marquée « estimé ».
      </p>

      <div class="flex flex-wrap items-end gap-4">
        <label class="block">
          <span class="text-bo-muted">Plafond de dépense par mois (€)</span>
          {/* 0 se montre « 0.00 », et non vide (relecture du 26/11) : vide
              veut dire « le défaut, 50 € », et 0 « plus aucune création ».
              Sans les chiffres de l'API, la valeur enregistrée. */}
          <input
            name="plafondEuros"
            type="number"
            min="0"
            step="0.01"
            value={valeurDuPlafond}
            placeholder="50.00"
            class="mt-1 block w-40 rounded border border-bo-border px-3 py-2"
          />
          <span class="mt-1 block text-xs text-bo-muted">
            Atteint, il coupe la génération jusqu'au mois suivant. C'est le
            garde-fou contre un robot qui demanderait mille aperçus la nuit.
            Il ne compte que les affiches des clients : les fonds de Créer un
            fond ont leur propre plafond (par défaut, la moitié de celui-ci).
            À 0, plus aucune affiche n'est créée ; vide, il revient à 50 €.
          </span>
        </label>

        <label class="block">
          <span class="text-bo-muted">Conservation des photos non achetées (jours)</span>
          <input
            name="purgeJours"
            type="number"
            min="0"
            step="1"
            value={purgeJours}
            class="mt-1 block w-40 rounded border border-bo-border px-3 py-2"
          />
          <span class="mt-1 block text-xs text-bo-muted">
            Passé ce délai, la photo envoyée par le visiteur et son aperçu
            sont effacés d'eux-mêmes (la purge passe toutes les heures). Ce
            qui a été acheté n'est jamais concerné.
          </span>
        </label>
      </div>

      <button class="rounded bg-bo-accent px-4 py-2 text-white hover:opacity-90">
        Enregistrer les réglages
      </button>
    </form>
  </section>

  {/* =============================================================== */}
  {/* 3 — Galerie des générations                                     */}
  {/* =============================================================== */}
  <section class="mb-6 rounded-lg border border-bo-border bg-bo-surface">
    <div class="flex flex-wrap items-center gap-1 border-b border-bo-border px-3 pt-3">
      {ONGLETS.map((o) => (
        <a
          href={lienAvec({
            statut: o.cle === "toutes" ? null : o.cle,
            page: null,
          })}
          class={`rounded-t px-3 py-2 text-sm ${
            o.cle === statut
              ? "bg-bo-bg font-medium text-bo-ink"
              : "text-bo-muted hover:bg-bo-bg/60"
          }`}
        >
          {o.label}
        </a>
      ))}
    </div>

    <div class="p-5">
      <p class="mb-4 max-w-3xl text-sm text-bo-muted">
        Toutes les affiches portent le filigrane tant que la commande n'est pas
        payée — celles-ci comme les autres. Une fois payée, l'image nette
        s'ouvre depuis sa vignette.
      </p>

      {erreurGalerie && (
        <p class="mb-4 text-sm text-red-600">
          Générations indisponibles : {erreurGalerie}
        </p>
      )}

      {galerie && (
        <p class="mb-4 text-sm text-bo-muted">
          {total === 0
            ? "Aucune génération."
            : `${premiere + 1}–${derniere} sur ${total} · ${formatPrice(galerie.coutCents)} pour ce qui est affiché`}
        </p>
      )}

      <div class="grid gap-4 sm:grid-cols-3 lg:grid-cols-5">
        {lignes.map((g) => {
          const badge = STATUTS[g.status] ?? {
            texte: g.status,
            classe: "bg-bo-bg text-bo-muted",
          };
          return (
            <figure class="overflow-hidden rounded border border-bo-border">
              <div class="flex aspect-[2/3] items-center justify-center bg-bo-bg">
                {g.apercu ? (
                  <img
                    src={apercuSrc(g.apercu)}
                    alt="Aperçu filigrané"
                    class="h-full w-full object-contain"
                    loading="lazy"
                  />
                ) : (
                  <span class="px-3 text-center text-xs text-bo-muted">
                    {g.status === "en_cours" ? "En fabrication…" : "Pas d'image"}
                  </span>
                )}
              </div>
              <figcaption class="space-y-1 px-3 py-2 text-xs">
                <div class="flex flex-wrap items-center gap-1">
                  <span class={`rounded-full px-2 py-0.5 ${badge.classe}`}>
                    {badge.texte}
                  </span>
                  {g.paidAt && (
                    <span class="rounded-full bg-sky-100 px-2 py-0.5 text-sky-900">
                      Payée
                    </span>
                  )}
                </div>
                <div class="truncate" title={g.produit ?? undefined}>
                  {g.productId ? (
                    <a
                      href={url(`/produits/${g.productId}`)}
                      class="text-bo-accent hover:underline"
                    >
                      {g.produit ?? `Produit #${g.productId}`}
                    </a>
                  ) : (
                    <span class="text-bo-muted">Produit inconnu</span>
                  )}
                </div>
                <div class="text-bo-muted">{quand(g.createdAt)}</div>
                <div class="text-bo-muted">
                  {g.costCents > 0 ? formatPrice(g.costCents) : "non facturée"}
                  {/* Une estimation (le réglage, 8 c), pas ce qu'OpenAI a
                      compté (26/11) : elle ne dit rien de la taille. */}
                  {g.costCents > 0 && g.coutEstime && " (estimé)"}
                </div>
                {/* La taille et le modèle de CETTE image (26/11) : rien ne
                    les montrait, et une image en 1024 × 1536 s'imprime en A3
                    à 88 points par pouce, contre 136 en 1584 × 2240. */}
                {(g.size || g.model) && (
                  <div class="truncate text-bo-muted" title={[g.size, g.model].filter(Boolean).join(" · ")}>
                    {[g.size?.replace("x", " × "), g.model].filter(Boolean).join(" · ")}
                  </div>
                )}
                {g.erreur && (
                  <div class="text-red-700" title={g.erreur}>
                    {g.erreur.length > 70 ? g.erreur.slice(0, 70) + "…" : g.erreur}
                  </div>
                )}
                {g.paidAt && g.aPleine && (
                  <a
                    href={apiUrl(`/admin/ia/full/${g.publicId}`)}
                    target="_blank"
                    rel="noopener"
                    class="block text-bo-accent hover:underline"
                  >
                    Image sans filigrane ↗
                  </a>
                )}
                {/* Réutiliser l'image (20/11) : tant que sa pleine définition
                    est là — la purge l'efface, et sans elle ni décor ni PDF. */}
                {g.aPleine && (
                  <div class="flex flex-col gap-1 pt-1">
                    <button
                      type="button"
                      class="js-creer-fiche rounded border border-bo-border px-2 py-1 text-left hover:border-bo-accent hover:text-bo-accent"
                      data-public-id={g.publicId}
                      data-apercu={apercuSrc(g.apercu)}
                    >
                      Créer une fiche produit
                    </button>
                    <button
                      type="button"
                      class="js-creer-affiche rounded border border-bo-border px-2 py-1 text-left hover:border-bo-accent hover:text-bo-accent"
                      data-public-id={g.publicId}
                    >
                      Créer une affiche
                    </button>
                  </div>
                )}
              </figcaption>
            </figure>
          );
        })}
      </div>

      {lignes.length === 0 && !erreurGalerie && (
        <p class="py-6 text-center text-sm text-bo-muted">
          {statut === "toutes"
            ? "Aucune affiche n'a encore été générée."
            : "Aucune génération dans cet onglet."}
        </p>
      )}

      {(page > 0 || derniere < total) && (
        <nav class="mt-4 flex items-center justify-between gap-2 text-sm">
          {page > 0 ? (
            <a
              href={lienAvec({ page: page > 1 ? String(page - 1) : null })}
              class="rounded border border-bo-border px-3 py-1.5"
            >
              ← Plus récentes
            </a>
          ) : (
            <span></span>
          )}
          {derniere < total && (
            <a
              href={lienAvec({ page: String(page + 1) })}
              class="rounded border border-bo-border px-3 py-1.5"
            >
              Plus anciennes →
            </a>
          )}
        </nav>
      )}
    </div>
  </section>

  {/* =============================================================== */}
  {/* 4 — Purge                                                       */}
  {/* =============================================================== */}
  <section class="rounded-lg border border-bo-border bg-bo-surface p-5">
    <h3 class="mb-1 font-semibold">Effacer les photos non achetées</h3>
    <p class="mb-3 max-w-3xl text-sm text-bo-muted">
      Les visiteurs envoient leur photo pour voir un aperçu ; la plupart
      n'achètent pas. Ni ces photos ni leurs aperçus n'ont à rester sur le
      serveur au-delà du délai de conservation. Rien de ce qui a été payé — ou
      vendu au stand — n'est touché, et l'affiche imprimable d'une commande
      payée ne l'est jamais non plus.
    </p>
    <p class="mb-3 max-w-3xl text-sm text-bo-muted">
      Une commande du site restée « en attente de paiement » garde ses photos
      le temps du délai de conservation, compté depuis son dernier passage en
      caisse : de quoi laisser arriver un paiement en retard. Au-delà, elles
      partent comme celles d'un panier abandonné.
    </p>
    <p class="mb-3 max-w-3xl text-sm text-bo-muted">
      Cette purge passe d'elle-même toutes les heures. Le bouton ne fait que la
      lancer tout de suite, avec les mêmes règles.
    </p>

    <div class="mb-3 rounded border border-bo-border bg-bo-bg px-4 py-3 text-sm">
      <div class="font-medium">Ce qui partirait maintenant</div>
      {apercuPurge ? (
        <ul class="mt-1 space-y-0.5 text-bo-muted">
          <li>
            <strong>{apercuPurge.lignes}</strong> génération(s) jamais achetée(s)
            de plus de {apercuPurge.jours} jour(s) : leur photo, leur aperçu et
            leur affiche ({apercuPurge.fichiers} fichier(s)).
          </li>
          <li>
            <strong>{apercuPurge.orphelins}</strong> photo(s) envoyée(s) il y a
            plus de {apercuPurge.heuresPhotosInutilisees} heures sans jamais
            servir à une affiche.
          </li>
          <li>
            <strong>{apercuPurge.relais}</strong> photo(s) envoyée(s) d'un
            téléphone au stand et oubliée(s) sur le serveur.
          </li>
        </ul>
      ) : (
        <p class="mt-1 text-bo-muted">
          Le décompte n'a pas pu être établi. La purge efface les générations
          jamais achetées de plus de {purgeJours} jour(s), et les photos qui
          n'ont servi à aucune affiche.
        </p>
      )}
    </div>

    <form
      method="POST"
      class="js-purger"
      data-nombre={apercuPurge
        ? apercuPurge.lignes + apercuPurge.orphelins + apercuPurge.relais
        : ""}
    >
      <input type="hidden" name="_action" value="purger" />
      <button class="rounded border border-bo-border px-4 py-2 text-sm hover:border-red-300 hover:text-red-700">
        Effacer maintenant
      </button>
    </form>
  </section>

  {/* =============================================================== */}
  {/* Réutiliser une image (20/11)                                    */}
  {/* =============================================================== */}
  {/* La fenêtre « Créer une fiche produit » est aussi sa confirmation :
      rien n'est créé avant « Créer la fiche ». */}
  <dialog
    id="dlg-fiche"
    class="w-[min(34rem,calc(100vw-2rem))] rounded-lg border border-bo-border bg-bo-surface p-0 text-bo-ink shadow-xl backdrop:bg-black/40"
    aria-labelledby="dlg-fiche-titre"
  >
    <form method="POST" class="js-form-fiche flex max-h-[85vh] flex-col">
      <input type="hidden" name="_action" value="fiche" />
      <input type="hidden" name="publicId" value="" />
      <h2 id="dlg-fiche-titre" class="border-b border-bo-border px-4 py-3 font-semibold">
        Créer une fiche produit avec cette image
      </h2>
      <div class="flex gap-4 overflow-y-auto px-4 py-3 text-sm">
        <img data-fiche-apercu src="" alt="" class="hidden h-36 w-24 shrink-0 rounded border border-bo-border object-cover" />
        <div class="space-y-3">
          <p class="text-bo-muted">
            L'image devient le décor d'une nouvelle affiche
            <strong>personnalisable</strong> : le client y ajoute ses
            personnages et ses textes. La fiche est créée
            <strong>désactivée</strong>, aux prix habituels du catalogue :
            elle n'apparaît pas en boutique tant que vous ne l'activez pas.
          </p>
          <label class="block">
            <span class="text-bo-muted">Nom de l'affiche *</span>
            <input
              name="nom"
              required
              maxlength="160"
              placeholder="COLMAR Petite Venise — Affiche personnalisée"
              class="mt-1 w-full rounded border border-bo-border px-3 py-2"
            />
          </label>
          <label class="block">
            <span class="text-bo-muted">Ville, en 1re ligne du texte</span>
            <input
              name="ville"
              maxlength="80"
              placeholder="COLMAR"
              class="mt-1 w-full rounded border border-bo-border px-3 py-2"
            />
            <span class="mt-1 block text-xs text-bo-muted">
              Laissez vide si l'image n'est pas celle d'une ville : les lignes
              restent alors vides pour le client.
            </span>
          </label>
        </div>
      </div>
      <div class="flex justify-end gap-2 border-t border-bo-border px-4 py-3 text-sm">
        <button type="button" class="js-fermer-dialogue rounded border border-bo-border px-4 py-2">
          Annuler
        </button>
        <button class="rounded bg-bo-accent px-4 py-2 text-white hover:opacity-90">
          Créer la fiche désactivée
        </button>
      </div>
    </form>
  </dialog>

  {/* « Créer une affiche » : le module de personnalisation du site, dans
      une fenêtre. C'est une page du SITE (/atelier-affiche), chargée dans un
      cadre : le module y a ses styles, ses polices et ses dessins, à
      l'identique de ce que voit le client. Rien n'y est vendu ni enregistré. */}
  <dialog
    id="dlg-affiche"
    class="h-[calc(100vh-2rem)] w-[min(80rem,calc(100vw-1rem))] max-h-none max-w-none rounded-lg border border-bo-border bg-bo-surface p-0 text-bo-ink shadow-xl backdrop:bg-black/50"
    aria-labelledby="dlg-affiche-titre"
    data-site={SITE}
  >
    <div class="flex h-full flex-col">
      <div class="flex flex-wrap items-center gap-3 border-b border-bo-border px-4 py-2 text-sm">
        <h2 id="dlg-affiche-titre" class="font-semibold">Créer une affiche</h2>
        <span class="text-bo-muted">
          Composez l'affiche comme un client, puis téléchargez ou imprimez son
          PDF. Ni panier, ni commande.
        </span>
        <a
          data-affiche-onglet
          href="#"
          target="_blank"
          rel="noopener"
          class="ml-auto text-bo-accent hover:underline"
        >
          Ouvrir dans un onglet ↗
        </a>
        <button type="button" class="js-fermer-dialogue rounded border border-bo-border px-3 py-1">
          Fermer
        </button>
      </div>
      <iframe
        data-affiche-cadre
        title="Module de personnalisation"
        src="about:blank"
        class="w-full flex-1 border-0 bg-white"
      ></iframe>
    </div>
  </dialog>

  <script is:inline>
    (function () {
      var dlgFiche = document.getElementById("dlg-fiche");
      var dlgAffiche = document.getElementById("dlg-affiche");
      if (!dlgFiche || !dlgAffiche) return;

      document.querySelectorAll(".js-fermer-dialogue").forEach(function (b) {
        b.addEventListener("click", function () {
          var d = b.closest("dialog");
          if (d) d.close();
        });
      });

      document.querySelectorAll(".js-creer-fiche").forEach(function (b) {
        b.addEventListener("click", function () {
          var form = dlgFiche.querySelector("form");
          form.reset();
          form.querySelector('input[name="publicId"]').value = b.getAttribute("data-public-id") || "";
          var img = dlgFiche.querySelector("[data-fiche-apercu]");
          var src = b.getAttribute("data-apercu") || "";
          img.src = src;
          img.classList.toggle("hidden", !src);
          dlgFiche.showModal();
          form.querySelector('input[name="nom"]').focus();
        });
      });
      // Un seul envoi : deux clics feraient deux fiches.
      dlgFiche.querySelector("form").addEventListener("submit", function (e) {
        var bouton = e.target.querySelector("button:not([type])");
        if (bouton.disabled) return e.preventDefault();
        bouton.disabled = true;
        bouton.textContent = "Création…";
      });

      // L'adresse du module : sur le site, à côté du back-office.
      var site = dlgAffiche.getAttribute("data-site") || "";
      var origineDuSite = site ? new URL(site, location.href).origin : location.origin;
      var cadre = dlgAffiche.querySelector("[data-affiche-cadre]");
      var onglet = dlgAffiche.querySelector("[data-affiche-onglet]");
      document.querySelectorAll(".js-creer-affiche").forEach(function (b) {
        b.addEventListener("click", function () {
          var adresse =
            site + "/atelier-affiche?ia=" + encodeURIComponent(b.getAttribute("data-public-id") || "");
          cadre.src = adresse;
          onglet.href = adresse;
          dlgAffiche.showModal();
        });
      });
      // Fermée, la fenêtre oublie l'affiche : la suivante repart de zéro.
      dlgAffiche.addEventListener("close", function () {
        cadre.src = "about:blank";
      });
      // « Retour » à la première étape du module ferme la fenêtre.
      window.addEventListener("message", function (e) {
        if (e.origin !== origineDuSite) return;
        if (e.data && e.data.type === "ml-atelier-fermer") dlgAffiche.close();
      });
    })();
  </script>

  <script is:inline>
    // Effacement irréversible : on redit le nombre avant de lancer.
    document.querySelectorAll("form.js-purger").forEach((f) => {
      f.addEventListener("submit", (e) => {
        const n = f.getAttribute("data-nombre");
        if (
          !confirm(
            n
              ? `Effacer ${n} génération(s) et photo(s) de visiteurs ? C'est définitif.`
              : "Effacer les photos et aperçus des générations non achetées ? C'est définitif.",
          )
        )
          e.preventDefault();
      });
    });
  </script>
</Admin>
