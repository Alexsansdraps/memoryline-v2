---
/**
 * L'éditeur d'une page du site.
 *
 * UN SEUL ÉDITEUR, et les sections se font dedans. C'était auparavant une pile
 * de blocs — un titre, un texte, un titre, un texte — qu'il fallait ajouter,
 * remonter, descendre, supprimer un par un. Les quatre pages existantes en
 * comptaient soixante-huit à elles seules, dont pas une image ni un bouton :
 * rien que l'alternance d'un intertitre et de son paragraphe. Découper cela en
 * blocs demandait du travail à chaque ligne et n'apportait rien qu'un éditeur
 * sachant faire des titres ne fasse mieux.
 *
 * Les anciens blocs sont REPLIÉS À LA LECTURE (voir `corpsDepuisBlocs`) : une
 * page enregistrée autrefois s'ouvre ici d'un seul tenant, ses titres devenus
 * des titres dans le texte. Rien n'est réécrit en base tant qu'on n'enregistre
 * pas, et une page jamais rouverte continue de s'afficher exactement pareil —
 * le site sait rendre les deux formes.
 *
 * Ce qui part au serveur reste un bloc de texte unique, pour ne toucher ni au
 * schéma de la base ni au rendu public : `[{ type: "texte", html }]`.
 */
import { apiUrl, url } from "../../lib/url.ts";
import Admin from "../../layouts/Admin.astro";
import EditeurTexte from "../../components/EditeurTexte.astro";
import {
  adminApi,
  type BlocPage,
  type ListeProduitsAdmin,
  type PageCms,
} from "../../lib/api.ts";

const api = adminApi(Astro.request);
const idPage = Number(Astro.params.id);

/** L'adresse publique du site, pour les liens « voir la page ». */
function originePublique(): string {
  const brut =
    import.meta.env.PUBLIC_SITE_URL ?? import.meta.env.PUBLIC_ORIGIN ?? "";
  const propre = String(brut).trim().replace(/\/+$/, "");
  return propre || "http://localhost:8080";
}
const ORIGINE_PUBLIQUE = originePublique();
/**
 * Le début de l'adresse d'une page, jusqu'à la barre qui précède son nom.
 *
 * La boutique sert ses pages sous « /pages/ » (voir le commentaire de
 * apps/web/src/pages/[...lang]/pages/[slug].astro : posées à la racine, elles
 * masquaient les accueils traduits). Montrer ou ouvrir « memoryline.fr/cgv »
 * menait à une page introuvable.
 */
const RACINE_DES_PAGES = `${ORIGINE_PUBLIQUE.replace(/^https?:\/\//, "")}/pages/`;

/**
 * Ce qu'une adresse de page peut contenir : des minuscules sans accent, des
 * chiffres, des traits d'union. Ni espace, ni barre oblique — l'adresse est un
 * seul segment, collé à « /pages/ ».
 */
const ADRESSE_VALIDE = /^[a-z0-9]+(?:-[a-z0-9]+)*$/;

const LANGUES_TRADUISIBLES = [
  { code: "en", nom: "Anglais" },
  { code: "de", nom: "Allemand" },
  { code: "it", nom: "Italien" },
  { code: "es", nom: "Espagnol" },
  { code: "ja", nom: "Japonais" },
  { code: "zh", nom: "Chinois" },
] as const;
type CodeLangue = (typeof LANGUES_TRADUISIBLES)[number]["code"];

function estLangue(v: string): v is CodeLangue {
  return LANGUES_TRADUISIBLES.some((l) => l.code === v);
}

/** Le texte seul, sans balise : sert à montrer le français sous une traduction. */
function texteBrut(html: string): string {
  return html
    .replace(/<li[^>]*>/gi, "\n• ")
    .replace(/<br\s*\/?>/gi, "\n")
    .replace(/<\/(p|div|li|ul|ol|h[1-6])\s*>/gi, "\n")
    .replace(/<[^>]*>/g, "")
    .replace(/&nbsp;/gi, " ")
    .replace(/&lt;/gi, "<")
    .replace(/&gt;/gi, ">")
    .replace(/&quot;/gi, '"')
    .replace(/&#0?39;/gi, "'")
    // L'esperluette en dernier, sinon « &amp;lt; » redeviendrait un chevron.
    .replace(/&amp;/gi, "&")
    .replace(/[ \t]+\n/g, "\n")
    .replace(/\n{3,}/g, "\n\n")
    .trim();
}

function echapper(t: string): string {
  return String(t ?? "")
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;");
}

/**
 * Replie une pile de blocs en un seul texte.
 *
 * C'est la charnière entre l'ancien découpage et le nouvel éditeur. Un titre
 * de niveau 2 devient un `<h2>`, de niveau 3 un `<h3>` — exactement les deux
 * balises que l'éditeur sait écrire et que la page publique sait dessiner,
 * avec la même allure qu'avant.
 *
 * Le texte d'un bloc passe TEL QUEL : il a déjà été nettoyé par l'éditeur au
 * moment où il a été écrit, et le renettoyer ici ne ferait que risquer d'en
 * perdre un morceau. Un titre, lui, est du texte brut et doit être échappé —
 * un « Conditions & tarifs » écrit dans un ancien bloc titre casserait le HTML
 * s'il y entrait sans précaution.
 */
function corpsDepuisBlocs(blocs: BlocPage[] | null | undefined): string {
  if (!Array.isArray(blocs)) return "";
  const morceaux: string[] = [];
  for (const b of blocs) {
    if (b.type === "titre") {
      const balise = b.niveau === 3 ? "h3" : "h2";
      const texte = echapper(String(b.texte ?? "")).trim();
      if (texte) morceaux.push(`<${balise}>${texte}</${balise}>`);
    } else if (b.type === "texte") {
      const html = String(b.html ?? "").trim();
      if (html) morceaux.push(html);
    } else if (b.type === "image") {
      const src = echapper(String(b.url ?? "")).trim();
      if (src)
        morceaux.push(
          `<p><img src="${src}" alt="${echapper(String(b.alt ?? ""))}"></p>`,
        );
      const legende = String(b.legende ?? "").trim();
      if (legende) morceaux.push(`<p><em>${echapper(legende)}</em></p>`);
    } else if (b.type === "bouton") {
      const href = echapper(String(b.href ?? "")).trim();
      const texte = echapper(String(b.texte ?? "")).trim();
      if (href) morceaux.push(`<p><a href="${href}">${texte}</a></p>`);
    }
    // « produits » : une grille calculée à l'affichage, qui ne se raconte pas
    // en texte. On la laisse de côté ET on le dit — voir `grillePerdue`.
  }
  return morceaux.join("");
}

/** Vrai si des blocs contiennent une grille de produits, qui ne se replie pas. */
function contientUneGrille(blocs: BlocPage[] | null | undefined): boolean {
  return Array.isArray(blocs) && blocs.some((b) => b.type === "produits");
}

/** Le corps tel qu'il part en base : un bloc de texte, ou rien. */
function blocsDepuisCorps(corps: string): BlocPage[] {
  const html = corps.trim();
  return html ? [{ type: "texte", html } as BlocPage] : [];
}

/*
 * LES AFFICHES DE LA PAGE (Margaux, 13/11 : « comment j'ajoute des
 * collections ? », pour la page du stand de Mulhouse). Sous le texte, une
 * grille d'affiches prises dans des collections, DANS L'ORDRE choisi : celles
 * de la première d'abord (Mulhouse), puis la suivante, sans doublon, jusqu'au
 * nombre voulu. Le site savait déjà rendre cette grille (bloc « produits »,
 * cms.ts) ; l'éditeur d'un seul tenant ne savait plus la poser.
 */
/** Le nombre d'affiches d'une grille neuve. */
const AFFICHES_PAR_DEFAUT = 48;
/** Le plus qu'une grille puisse montrer (même borne que l'API, cms.ts). */
const AFFICHES_MAX = 200;
/** Au-delà, « + Ajouter une collection » disparaît (même borne que l'API, cms.ts). */
const COLLECTIONS_MAX = 20;

/** La grille d'affiches enregistrée sur la page : ses collections, dans l'ordre, et leur nombre. */
function grilleDeLaPage(blocs: BlocPage[] | null | undefined): { collections: string[]; limite: number } {
  const b = (blocs ?? []).find((x) => x.type === "produits" && x.source === "collection");
  if (!b) return { collections: [], limite: AFFICHES_PAR_DEFAUT };
  const refs = Array.isArray(b.references) && b.references.length ? b.references : [b.reference];
  const collections = refs.map((r) => String(r ?? "").trim()).filter(Boolean);
  const n = Number(b.limite);
  return { collections, limite: Number.isFinite(n) && n > 0 ? Math.min(n, AFFICHES_MAX) : AFFICHES_PAR_DEFAUT };
}

/** Le bloc à enregistrer pour la grille, ou rien si aucune collection n'est choisie. */
function blocDesAffiches(collections: string[], limite: number): BlocPage[] {
  const refs = [...new Set(collections.map((c) => c.trim()).filter(Boolean))];
  if (!refs.length) return [];
  const n = Math.min(Math.max(Math.trunc(limite) || AFFICHES_PAR_DEFAUT, 1), AFFICHES_MAX);
  return [{ type: "produits", source: "collection", reference: refs[0], references: refs, limite: n } as BlocPage];
}

/*
 * LES AFFICHES CHOISIES UNE À UNE (18/11, Alexandra : « on doit pouvoir voir
 * toutes les affiches et les sélectionner avec pas mal de filtres
 * (sélectionner toute la collection X ou juste une affiche) », « trier les
 * affiches comme on veut, par affiche ou par collection »). C'est la page
 * d'un stand : sa tablette n'affiche qu'elle (Ventes stand). Le tableau,
 * ses filtres et l'ordre vivent dans le navigateur (script plus bas) ; le
 * choix part dans un seul champ caché, en JSON, et devient un bloc
 * « produits » de source « affiches » (cms.ts).
 */
interface ChoixAffiches {
  /** « liste » : un seul ordre ; « collections » : des sections par collection. */
  mode: "liste" | "collections";
  /** Les numéros des affiches, dans l'ordre de la page. */
  ordre: number[];
  /** Mode « collections » : les sections, dans l'ordre, avec leurs affiches. */
  sections: { collection: string; affiches: number[] }[];
  /** Mode « collections » : le nom de chaque collection au-dessus de sa section. */
  titres: boolean;
}

const CHOIX_VIDE: ChoixAffiches = { mode: "liste", ordre: [], sections: [], titres: true };

/** Des numéros d'affiches lisibles, sans doublon. */
function numeros(v: unknown): number[] {
  if (!Array.isArray(v)) return [];
  return [...new Set(v.map(Number).filter((n) => Number.isInteger(n) && n > 0))];
}

/** Le choix enregistré sur la page (son bloc « affiches »), ou rien de choisi. */
function choixDeLaPage(blocs: BlocPage[] | null | undefined): ChoixAffiches {
  const b = (blocs ?? []).find((x) => x.type === "produits" && x.source === "affiches");
  if (!b) return CHOIX_VIDE;
  const sections = (Array.isArray(b.sections) ? b.sections : [])
    .map((s) => ({
      collection: String((s as Record<string, unknown>)?.collection ?? ""),
      affiches: numeros((s as Record<string, unknown>)?.affiches),
    }))
    .filter((s) => s.affiches.length);
  return {
    mode: sections.length ? "collections" : "liste",
    ordre: numeros(Array.isArray(b.references) && b.references.length ? b.references : [b.reference]),
    sections,
    titres: b.titresSections !== false,
  };
}

/** Le choix envoyé par le formulaire (champ caché `affichesChoisies`). */
function choixEnvoye(brut: string): ChoixAffiches {
  try {
    const v = JSON.parse(brut || "{}") as Record<string, unknown>;
    const sections = (Array.isArray(v.sections) ? v.sections : [])
      .map((s) => ({
        collection: String((s as Record<string, unknown>)?.collection ?? "").slice(0, 120),
        affiches: numeros((s as Record<string, unknown>)?.affiches),
      }))
      .filter((s) => s.affiches.length);
    const mode = v.mode === "collections" && sections.length ? "collections" : "liste";
    return {
      mode,
      ordre: mode === "collections" ? sections.flatMap((s) => s.affiches) : numeros(v.ordre),
      sections: mode === "collections" ? sections : [],
      titres: v.titres !== false,
    };
  } catch {
    throw new Error("Le choix des affiches n'a pas pu être lu. Rechargez la page et réessayez.");
  }
}

/** Le bloc à enregistrer pour les affiches choisies, ou rien s'il n'y en a pas. */
function blocDesAffichesChoisies(choix: ChoixAffiches): BlocPage[] {
  if (!choix.ordre.length) return [];
  const references = choix.ordre.map(String);
  const bloc: Record<string, unknown> = {
    type: "produits",
    source: "affiches",
    reference: references[0],
    references,
    limite: references.length,
  };
  if (choix.mode === "collections" && choix.sections.length) {
    bloc.sections = choix.sections.map((s) => ({
      collection: s.collection,
      affiches: s.affiches.map(String),
    }));
    bloc.titresSections = choix.titres;
  }
  return [bloc as BlocPage];
}

let flash: string | null = null;
let flashErreur = false;

/** Ce qui vient d'être saisi, gardé seulement si l'enregistrement est refusé. */
const AFFICHAGES = ["site", "stand", "les-deux"];

let saisie: {
  titre: string;
  adresse: string;
  statut: string;
  affichage: string;
  seoTitre: string;
  seoDescription: string;
  affiches?: { collections: string[]; limite: number };
  choix?: ChoixAffiches;
  corps: string;
} | null = null;

/**
 * Enregistre UNE langue.
 *
 * La traduction est un texte unique, comme le français : le site affiche le
 * français partout où la traduction est vide, jamais un blanc. Une langue dont
 * plus rien n'est rempli est envoyée à `null` — c'est ainsi qu'on efface une
 * traduction devenue fausse.
 *
 * Si le français est encore rangé en plusieurs blocs (une page qu'on n'a pas
 * rouverte depuis le changement), il est replié dans le même envoi. Sans cela,
 * une traduction d'un seul tenant face à un français qui compte quinze blocs
 * se retrouverait en face du mauvais paragraphe.
 */
async function enregistrerTraduction(
  f: FormData,
  idPage: number,
): Promise<string> {
  const lang = String(f.get("lang") ?? "");
  if (!estLangue(lang))
    throw new Error("Cette langue n'existe pas. Rechargez l'écran et réessayez.");
  const nomLangue =
    LANGUES_TRADUISIBLES.find((l) => l.code === lang)?.nom.toLowerCase() ?? lang;

  const titreTraduit = String(f.get("titre") ?? "").trim();
  const corpsTraduit = String(f.get("corps") ?? "").trim();
  const seoTitreTraduit = String(f.get("seoTitle") ?? "").trim();
  const seoDescriptionTraduite = String(f.get("seoDescription") ?? "").trim();
  // Le référencement compte : une langue dont seuls le titre et la
  // description Google sont remplis existe bel et bien. L'oublier ici
  // enverrait `null`, qui efface la langue ENTIÈRE, référencement compris.
  const quelqueChose = !!(
    titreTraduit ||
    corpsTraduit ||
    seoTitreTraduit ||
    seoDescriptionTraduite
  );

  const actuel = await api.page(idPage);
  const blocsFrancais = actuel.page.blocks ?? [];
  /*
   * Les grilles d'affiches (« produits ») ne se replient pas en texte : elles
   * restent, APRÈS le texte, comme l'éditeur français les enregistre (18/11).
   * Elles partaient auparavant au premier enregistrement d'une traduction —
   * une page de stand y aurait perdu toutes ses affiches.
   */
  const grillesFrancaises = blocsFrancais.filter((b) => b.type === "produits");
  const texteFrancais = blocsFrancais.filter((b) => b.type !== "produits");
  const texteRange =
    texteFrancais.length > 1 || (texteFrancais.length === 1 && texteFrancais[0]!.type !== "texte")
      ? blocsDepuisCorps(corpsDepuisBlocs(texteFrancais))
      : texteFrancais;
  /** Le français tel qu'il sera en base après cet envoi : le patron de la traduction. */
  const francaisRange = [...texteRange, ...grillesFrancaises];
  const francaisARanger = JSON.stringify(francaisRange) !== JSON.stringify(blocsFrancais);

  // Un texte traduit se cale sur le texte français, bloc pour bloc : face à
  // une page française vide, il n'aurait rien en face de quoi s'afficher, et
  // le serveur le refuserait en parlant de blocs. On le dit dans ses mots.
  if (corpsTraduit && !texteRange.length)
    throw new Error(
      "Le texte français de cette page est vide : écrivez-le et enregistrez-le " +
        "d'abord, la traduction s'affiche à sa place. Le nom traduit, lui, peut " +
        "s'enregistrer seul.",
    );

  /*
   * Le texte ne part QUE s'il est écrit.
   *
   * Envoyé vide, il partait comme une liste de zéro bloc, que le serveur
   * comparait à l'unique bloc du français et refusait comme « désynchronisée » :
   * traduire le nom seul — ce que l'écran propose en toutes lettres — tombait
   * en erreur. Absent, il laisse le nom s'enregistrer seul, et le site affiche
   * le texte français. Une traduction de texte déjà enregistrée disparaît
   * avec, comme promis : vider un champ, c'est revenir au français.
   */
  const traduction: {
    title: string;
    blocks?: BlocPage[];
    seoTitle: string;
    seoDescription: string;
  } = {
    title: titreTraduit,
    // Toujours envoyés : vides, ils retirent le référencement traduit, et
    // la page retombe sur son nom traduit dans Google.
    seoTitle: seoTitreTraduit,
    seoDescription: seoDescriptionTraduite,
  };
  // Bloc pour bloc face au français : le texte traduit en face du texte, et
  // les grilles recopiées telles quelles (le serveur les reprend du français).
  if (corpsTraduit)
    traduction.blocks = francaisRange.map((b) =>
      b.type === "produits" ? b : ({ type: "texte", html: corpsTraduit } as BlocPage),
    );

  await api.enregistrerPage(idPage, {
    ...(francaisARanger ? { blocks: francaisRange } : {}),
    translations: { [lang]: quelqueChose ? traduction : null },
  });

  const rangement = francaisARanger
    ? " Le texte français, encore découpé en morceaux, a été réuni au passage."
    : "";
  if (!quelqueChose)
    return `Traduction en ${nomLangue} effacée : le site affichera le français.${rangement}`;
  return corpsTraduit
    ? `Traduction en ${nomLangue} enregistrée. Ce qui est laissé vide affiche le français.${rangement}`
    : titreTraduit
      ? `Nom de la page en ${nomLangue} enregistré. Le texte, laissé vide, s'affiche en français.${rangement}`
      : `Référencement en ${nomLangue} enregistré. Le nom et le texte, laissés vides, s'affichent en français.${rangement}`;
}

/** Ce que l'écran d'une langue montre : ses quatre champs. */
interface SaisieLangue {
  titre: string;
  corps: string;
  seoTitle: string;
  seoDescription: string;
}

/**
 * Ce que /admin/traduire accepte par champ : au-delà, il couperait le texte
 * sans le dire, et la traduction s'arrêterait au milieu d'une phrase.
 */
const LIMITE_TRADUCTION = 20_000;

/**
 * Propose, par la traduction automatique, les champs VIDES de la langue
 * ouverte dont le français existe. Ce qui est déjà écrit, enregistré ou tout
 * juste tapé, n'est pas touché. Rien n'est enregistré.
 */
async function proposerTraductionPage(
  f: FormData,
  idPage: number,
): Promise<{ saisie: SaisieLangue; propositions: Partial<SaisieLangue>; message: string }> {
  const lang = String(f.get("lang") ?? "");
  if (!estLangue(lang))
    throw new Error("Cette langue n'existe pas. Rechargez l'écran et réessayez.");
  const nomLangue =
    LANGUES_TRADUISIBLES.find((l) => l.code === lang)?.nom.toLowerCase() ?? lang;
  const saisie: SaisieLangue = {
    titre: String(f.get("titre") ?? "").trim(),
    corps: String(f.get("corps") ?? "").trim(),
    seoTitle: String(f.get("seoTitle") ?? "").trim(),
    seoDescription: String(f.get("seoDescription") ?? "").trim(),
  };
  const { page: actuelle } = await api.page(idPage);
  const francais: SaisieLangue = {
    titre: actuelle.title ?? "",
    corps: corpsDepuisBlocs(actuelle.blocks),
    seoTitle: actuelle.seoTitle ?? "",
    seoDescription: actuelle.seoDescription ?? "",
  };
  const manque: Record<string, string> = {};
  let tropLong = false;
  for (const cle of Object.keys(francais) as (keyof SaisieLangue)[]) {
    if (saisie[cle] || !francais[cle].trim()) continue;
    if (francais[cle].length > LIMITE_TRADUCTION) {
      tropLong = true;
      continue;
    }
    manque[cle] = francais[cle];
  }
  const avertissement = tropLong
    ? " Le texte de la page est trop long pour la traduction automatique : traduisez-le par morceaux."
    : "";
  if (!Object.keys(manque).length)
    return {
      saisie,
      propositions: {},
      message: `Rien à proposer en ${nomLangue} : les champs dont le français existe sont déjà remplis.${avertissement}`,
    };
  const { champs } = await api.proposerTraduction(lang, manque);
  return {
    saisie,
    propositions: champs as Partial<SaisieLangue>,
    message: `Traduction en ${nomLangue} proposée pour les champs vides : relisez-la (encadrés jaunes), corrigez si besoin, puis cliquez « Enregistrer ${nomLangue} ». Rien n'est enregistré pour l'instant.${avertissement}`,
  };
}

/** La langue ouverte telle qu'elle vient d'être envoyée, et les propositions. */
let saisieLangue: SaisieLangue | null = null;
let propositionsLangue: Partial<SaisieLangue> = {};

if (Astro.request.method === "POST") {
  const f = await Astro.request.formData();
  // Deux formulaires postent sur cet écran : celui de la page en français, et
  // celui d'UNE langue de traduction.
  const action = String(f.get("_action") ?? "page");

  if (action === "traduction") {
    try {
      if (!Number.isFinite(idPage) || idPage <= 0)
        throw new Error("Cette page n'a pas pu être retrouvée.");
      if (f.get("auto")) {
        const r = await proposerTraductionPage(f, idPage);
        saisieLangue = r.saisie;
        propositionsLangue = r.propositions;
        flash = r.message;
      } else {
        flash = await enregistrerTraduction(f, idPage);
      }
    } catch (e) {
      flash = String(e).replace(/^Error:\s*/, "");
      flashErreur = true;
      // Refusé : ce qui vient d'être tapé reste à l'écran.
      saisieLangue = {
        titre: String(f.get("titre") ?? ""),
        corps: String(f.get("corps") ?? ""),
        seoTitle: String(f.get("seoTitle") ?? ""),
        seoDescription: String(f.get("seoDescription") ?? ""),
      };
    }
  } else {
    const titre = String(f.get("title") ?? "").trim();
    const adresse = String(f.get("slug") ?? "").trim();
    const statut = String(f.get("status") ?? "");
    // Où la page se montre (recette du 17/11 : le champ manquait, l'API le
    // connaissait depuis le 13/11 mais le BO ne permettait pas de le régler).
    const affichage = String(f.get("affichage") ?? "site");
    const seoTitre = String(f.get("seoTitle") ?? "").trim();
    const seoDescription = String(f.get("seoDescription") ?? "").trim();
    const corpsSaisi = String(f.get("corps") ?? "").trim();
    const affichesSaisies = {
      collections: f.getAll("affiches").map((v) => String(v)),
      limite: Number(f.get("affichesLimite") ?? AFFICHES_PAR_DEFAUT),
    };
    // Le choix des affiches une à une (18/11) : absent d'un formulaire
    // d'avant, il garde ce que la page avait.
    let choixSaisi: ChoixAffiches | undefined;

    try {
      choixSaisi = f.has("affichesChoisies")
        ? choixEnvoye(String(f.get("affichesChoisies") ?? ""))
        : choixDeLaPage((await api.page(idPage)).page.blocks);
      if (!Number.isFinite(idPage) || idPage <= 0)
        throw new Error("Cette page n'a pas pu être retrouvée.");
      if (!titre) throw new Error("Donnez un nom à la page.");
      if (!adresse) throw new Error("Écrivez l'adresse de la page.");
      if (!ADRESSE_VALIDE.test(adresse))
        throw new Error(
          `L'adresse « ${adresse} » ne convient pas : elle ne peut contenir que ` +
            "des lettres minuscules sans accent, des chiffres et des traits " +
            "d'union, sans espace ni barre oblique.",
        );
      if (statut !== "active" && statut !== "draft")
        throw new Error("Indiquez si la page est en ligne ou en brouillon.");
      if (!AFFICHAGES.includes(affichage))
        throw new Error(
          "Dites où cette page doit se montrer : sur le site, sur la tablette du stand, ou sur les deux.",
        );

      await api.enregistrerPage(idPage, {
        title: titre,
        slug: adresse,
        status: statut,
        affichage,
        seoTitle: seoTitre || null,
        seoDescription: seoDescription || null,
        blocks: [
          ...blocsDepuisCorps(corpsSaisi),
          ...blocDesAffichesChoisies(choixSaisi),
          ...blocDesAffiches(affichesSaisies.collections, affichesSaisies.limite),
        ],
      });
      flash =
        statut !== "active"
          ? "Page enregistrée. Elle reste en brouillon : personne ne la voit encore."
          : affichage === "stand"
            ? "Page enregistrée. Elle se montre sur la tablette du stand seulement : introuvable sur le site."
            : affichage === "les-deux"
              ? "Page enregistrée. Elle est en ligne sur le site et sur la tablette du stand."
              : "Page enregistrée. Elle est en ligne sur le site.";
    } catch (e) {
      flash = String(e).replace(/^Error:\s*/, "");
      flashErreur = true;
      saisie = {
        titre,
        adresse,
        statut,
        affichage,
        seoTitre,
        seoDescription,
        corps: corpsSaisi,
        affiches: affichesSaisies,
        choix: choixSaisi,
      };
    }
  }
}

let donnees: PageCms | null = null;
let erreur: string | null = null;
try {
  donnees = await api.page(idPage);
} catch (e) {
  erreur = String(e).replace(/^Error:\s*/, "");
}

const page = donnees?.page ?? null;

const titre = saisie?.titre ?? page?.title ?? "";
const adresse = saisie?.adresse ?? page?.slug ?? "";
const statut = saisie?.statut ?? page?.status ?? "draft";
const affichage = saisie?.affichage ?? page?.affichage ?? "site";
const seoTitre = saisie?.seoTitre ?? page?.seoTitle ?? "";
const seoDescription = saisie?.seoDescription ?? page?.seoDescription ?? "";

/** Le texte de la page, replié s'il était encore en morceaux. */
const corps = saisie?.corps ?? corpsDepuisBlocs(page?.blocks);

/**
 * Une ancienne grille de produits ne se replie pas : il faut le dire. Les
 * affiches choisies une à une, elles, ont leur écran plus bas (18/11).
 */
const grilles = (page?.blocks ?? []).filter(
  (b) => b.type === "produits" && b.source !== "affiches",
);
const grillePerdue =
  !saisie &&
  contientUneGrille(page?.blocks) &&
  (grilles.length > 1 || grilles.some((b) => b.source !== "collection"));
/** La grille d'affiches de l'écran : la saisie refusée, sinon celle enregistrée. */
const affiches = saisie?.affiches ?? grilleDeLaPage(page?.blocks);
/** Les affiches choisies une à une : la saisie refusée, sinon celles enregistrées. */
const choix = saisie?.choix ?? choixDeLaPage(page?.blocks);

/**
 * Toutes les affiches, pour le tableau du choix (18/11) : celles en vente se
 * cochent ; les autres servent à nommer une affiche déjà choisie et retirée
 * de la vente depuis. Les collections de chaque affiche par leur adresse
 * (celles qu'une page peut citer : ouvertes, non archivées).
 */
let catalogue: ListeProduitsAdmin | null = null;
try {
  catalogue = await api.produitsAdmin({ limit: 1000 });
} catch {
  catalogue = null;
}
const slugDeCollection = new Map((donnees?.collections ?? []).map((c) => [c.id, c.slug]));
/** Une vignette légère : 200 px de large, servie par l'API. */
const vignette = (u: string | null) =>
  !u ? "" : /^https?:\/\//i.test(u) ? u : `${apiUrl(u)}?l=200`;
const donneesChoix = {
  max: AFFICHES_MAX,
  choix,
  collections: (donnees?.collections ?? []).map((c) => ({ slug: c.slug, nom: c.name })),
  produits: (catalogue?.produits ?? []).map((p) => ({
    id: p.id,
    nom: p.name,
    slug: p.slug,
    genre: p.kind,
    statut: p.status,
    image: vignette(p.imageUrl),
    collections: p.collections
      .map((c) => slugDeCollection.get(c.id))
      .filter((s): s is string => !!s),
  })),
};
/** Les stands dont la tablette affiche cette page (lecture seule, 18/11). */
const tablettes = (donnees?.stands ?? []).filter((s) => !s.archive);

/**
 * Les collections que montrent les rangées « Affiches » de la page.
 *
 * Tant que la page n'est pas réenregistrée, ces rangées restent en ligne, et
 * elles suivent l'ordre de leur collection : un lien par collection mène là
 * où cet ordre se règle (Produits › Ordre d'affichage).
 */
const collectionsDesRangees = (() => {
  const vues: { id: number; name: string }[] = [];
  for (const b of page?.blocks ?? []) {
    if (b.type !== "produits" || b.source !== "collection") continue;
    const refs =
      Array.isArray(b.references) && b.references.length ? b.references : [b.reference];
    for (const r of refs) {
      const col = donnees?.collections.find((c) => c.slug === String(r ?? "").trim());
      if (col && !vues.some((v) => v.id === col.id)) vues.push({ id: col.id, name: col.name });
    }
  }
  return vues;
})();

const traductions = page?.translations ?? null;

/**
 * La langue ouverte, s'il y en a une, lue dans l'adresse.
 *
 * Une seule à la fois : quatre langues dépliées ensemble donneraient quatre
 * fois la page à l'écran, et autant d'éditeurs à charger pour rien.
 */
const langueOuverte = (() => {
  const demandee = Astro.url.searchParams.get("langue") ?? "";
  return estLangue(demandee) ? demandee : null;
})();
const nomLangueOuverte =
  LANGUES_TRADUISIBLES.find((l) => l.code === langueOuverte)?.nom ?? "";

/** Le lien qui ouvre une langue — ou les referme toutes. */
function lienLangue(code: string | null): string {
  const base = url(`/pages/${idPage}`);
  return code ? `${base}?langue=${code}#traductions` : `${base}#traductions`;
}

/**
 * Ce qu'une langue a de rempli : son nom, son texte, ou les deux — et son
 * référencement, quand le français en a un (sans titre Google français, il
 * n'y a rien à traduire de ce côté).
 */
function etatLangue(code: string): { texte: string; classe: string; manque?: string } {
  const t = traductions?.[code];
  const nom = !!t?.title?.trim();
  const texte = !!corpsDepuisBlocs(t?.blocks).trim();
  const seo: { fait: boolean; quoi: string }[] = [];
  if (page?.seoTitle?.trim()) seo.push({ fait: !!t?.seoTitle?.trim(), quoi: "le titre Google" });
  if (page?.seoDescription?.trim())
    seo.push({ fait: !!t?.seoDescription?.trim(), quoi: "la description Google" });
  const seoFait = seo.filter((s) => s.fait).length;
  if (!nom && !texte && !seoFait)
    return { texte: "à traduire", classe: "bg-bo-bg text-bo-muted" };
  if (nom && texte && seoFait === seo.length)
    return { texte: "traduit", classe: "bg-green-100 text-green-800" };
  const manque = [
    ...(nom ? [] : ["le nom"]),
    ...(texte ? [] : ["le texte"]),
    ...seo.filter((s) => !s.fait).map((s) => s.quoi),
  ];
  return {
    // Les deux cas d'avant gardent leurs mots ; le référencement seul
    // manquant se dit « partiel », le détail au survol.
    texte:
      seoFait === seo.length && (nom || texte)
        ? nom
          ? "nom seulement"
          : "texte seulement"
        : "partiel",
    classe: "bg-amber-100 text-amber-800",
    manque: `Reste à traduire : ${manque.join(", ")}.`,
  };
}

/** Ce que la langue ouverte a déjà d'enregistré. */
const dejaTraduit = langueOuverte ? (traductions?.[langueOuverte] ?? null) : null;
/**
 * Ce que montrent les champs de la langue ouverte : une proposition à
 * relire, sinon ce qui vient d'être tapé (après une proposition ou un
 * refus), sinon ce qui est enregistré.
 */
const champsLangue: SaisieLangue = {
  titre: propositionsLangue.titre ?? saisieLangue?.titre ?? dejaTraduit?.title ?? "",
  corps:
    propositionsLangue.corps ?? saisieLangue?.corps ?? corpsDepuisBlocs(dejaTraduit?.blocks),
  seoTitle:
    propositionsLangue.seoTitle ?? saisieLangue?.seoTitle ?? dejaTraduit?.seoTitle ?? "",
  seoDescription:
    propositionsLangue.seoDescription ??
    saisieLangue?.seoDescription ??
    dejaTraduit?.seoDescription ??
    "",
};
/** Un champ rempli par la machine, à relire. */
const propose = (cle: keyof SaisieLangue) => propositionsLangue[cle] !== undefined;

const champ =
  "mt-1 w-full rounded border border-bo-border bg-bo-surface px-3 py-2 text-sm";
/** Le même, encadré de jaune : une proposition automatique à relire. */
const champPropose =
  "mt-1 w-full rounded border border-amber-400 bg-amber-50 px-3 py-2 text-sm";
const boutonPrincipal =
  "rounded bg-bo-accent px-4 py-2 text-sm text-white hover:opacity-90";
const boutonDiscret =
  "rounded border border-bo-border bg-bo-surface px-3 py-1.5 text-sm hover:bg-bo-bg";
---

<Admin title={page?.title ?? "Page"}>
  <p class="mb-4">
    <a href={url("/pages")} class="text-sm text-bo-accent hover:underline">
      ← Retour aux pages
    </a>
  </p>

  {Astro.url.searchParams.get("cree") === "1" && (
    <p class="mb-4 rounded border border-green-200 bg-green-50 px-3 py-2 text-sm">
      Page créée. Elle est en brouillon : écrivez son contenu ci-dessous, puis
      mettez-la en ligne quand elle vous convient.
    </p>
  )}

  {flash && (
    <p
      class={`mb-4 rounded border px-3 py-2 text-sm ${
        flashErreur ? "bg-red-50 border-red-200" : "bg-green-50 border-green-200"
      }`}
    >
      {flash}
    </p>
  )}
  {erreur && (
    <p class="mb-4 text-sm text-red-600">
      Cette page n'a pas pu être lue : {erreur}
    </p>
  )}

  {page && (
    <form method="POST" class="space-y-6">
      {/* Ce formulaire-ci écrit la page en FRANÇAIS. Celui des traductions,
          plus bas, annonce « traduction » et n'écrit qu'une langue. */}
      <input type="hidden" name="_action" value="page" />

      {/* =============================================================== */}
      {/* En-tête : le nom, l'adresse, l'état                             */}
      {/* =============================================================== */}
      <section id="infos" class="rounded-lg border border-bo-border bg-bo-surface p-5">
        <div class="grid grid-cols-1 gap-4 lg:grid-cols-3">
          <label class="block lg:col-span-2">
            <span class="text-sm font-medium">Nom de la page</span>
            <input name="title" value={titre} required class={champ} />
            <span class="mt-1 block text-xs text-bo-muted">
              Le titre que vos clients voient en haut de la page.
            </span>
          </label>

          <label class="block">
            <span class="text-sm font-medium">Cette page est</span>
            <select name="status" class={champ}>
              <option value="active" selected={statut === "active"}>
                En ligne
              </option>
              <option value="draft" selected={statut !== "active"}>
                Brouillon
              </option>
            </select>
            <span class="mt-1 block text-xs text-bo-muted">
              Un brouillon n'est visible que d'ici. Rien n'apparaît sur le site
              tant que la page n'est pas en ligne.
            </span>
          </label>

          <label class="block">
            <span class="text-sm font-medium">Où elle se montre</span>
            <select name="affichage" class={champ}>
              <option value="site" selected={affichage !== "stand" && affichage !== "les-deux"}>
                Sur le site
              </option>
              <option value="stand" selected={affichage === "stand"}>
                Sur la tablette du stand seulement
              </option>
              <option value="les-deux" selected={affichage === "les-deux"}>
                Sur le site et sur la tablette du stand
              </option>
            </select>
            <span class="mt-1 block text-xs text-bo-muted">
              Une page « tablette du stand seulement » est introuvable sur le
              site, et son lien au menu ne se voit qu'en mode stand.
            </span>
          </label>
        </div>

        {/* La tablette qui l'affiche (18/11) : en lecture seule, la page d'un
            stand se choisit dans Ventes stand. */}
        <p class="mt-3 text-sm">
          {tablettes.length ? (
            <>
              Affichée sur la tablette de :{" "}
              <strong>{tablettes.map((s) => s.nom).join(", ")}</strong>.{" "}
              <a href={url("/ventes-salon")} class="text-bo-accent hover:underline">
                Ventes stand
              </a>
            </>
          ) : (
            <span class="text-bo-muted">
              Aucune tablette n'affiche cette page. La page d'un stand se
              choisit dans{" "}
              <a href={url("/ventes-salon")} class="text-bo-accent hover:underline">
                Ventes stand
              </a>
              .
            </span>
          )}
        </p>

        <div class="mt-4">
          <span class="text-sm font-medium">Adresse de la page</span>
          <span class="mt-1 flex flex-wrap items-center gap-1">
            <span class="text-sm text-bo-muted">{RACINE_DES_PAGES}</span>
            <input
              name="slug"
              value={adresse}
              required
              class="w-64 rounded border border-bo-border bg-bo-surface px-3 py-2 font-mono text-sm"
            />
          </span>
          <span class="mt-1 block text-xs text-bo-muted">
            L'adresse où la page sera visible, par exemple {RACINE_DES_PAGES}magnets.
            La changer casse les liens déjà partagés vers cette page : ne le
            faites que si son nom a vraiment changé.
          </span>
        </div>

        <div class="mt-4 flex flex-wrap items-center gap-3">
          <button class={boutonPrincipal}>Enregistrer</button>
          {/* L'adresse ENREGISTRÉE, pas celle du champ : après un refus, le
              champ garde la saisie rejetée, et le lien mènerait nulle part. */}
          {page?.status === "active" && page.slug && (
            <a
              href={`${ORIGINE_PUBLIQUE}/pages/${encodeURIComponent(page.slug)}${
                // Une page réservée au stand ne s'ouvre qu'en mode stand.
                // « apercu » ne désigne aucun stand (18/11) : « ?stand=1 »
                // ouvrirait la tablette du stand n° 1, qui ramène à SA page.
                page.affichage === "stand" ? "?stand=apercu" : ""
              }`}
              target="_blank"
              rel="noopener"
              class={boutonDiscret}
            >
              Voir la page sur le site ↗
            </a>
          )}
        </div>
      </section>

      {/* =============================================================== */}
      {/* Le contenu : UN SEUL éditeur                                    */}
      {/* =============================================================== */}
      <section id="contenu">
        <h3 class="mb-1 font-semibold">Contenu de la page</h3>
        <p class="mb-4 max-w-3xl text-sm text-bo-muted">
          Écrivez d'un seul tenant, comme dans un traitement de texte. La liste
          déroulante en haut à gauche fait les sections : posez le curseur sur
          une ligne et choisissez « Titre » ou « Sous-titre ».
        </p>

        {grillePerdue && (
          <p class="mb-4 max-w-3xl rounded border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-900">
            Cette page contenait une grille d'affiches, qui ne peut pas devenir
            du texte : elle n'apparaît pas ci-dessous et sera perdue si vous
            enregistrez. Prévenez-moi avant d'enregistrer si vous y teniez.
            {collectionsDesRangees.length > 0 && (
              <span class="mt-1 block">
                D'ici là, elle montre les affiches dans l'ordre de leur
                collection :
                {collectionsDesRangees.map((col, i) => (
                  <>
                    {i > 0 ? "," : ""}{" "}
                    <a
                      href={url(`/produits/ordre?page=collection:${col.id}`)}
                      class="underline"
                    >
                      Ranger ces affiches ({col.name})
                    </a>
                  </>
                ))}
                .
              </span>
            )}
          </p>
        )}

        <div class="rounded-lg border border-bo-border bg-bo-surface p-5">
          <EditeurTexte
            nom="corps"
            valeur={corps}
            titres
            invite="Écrivez le contenu de la page. Les boutons du dessus font les titres, le gras, les listes."
            etiquette="Contenu de la page"
          />
        </div>
      </section>

      {/* =============================================================== */}
      {/* Les affiches choisies une à une (cf. ChoixAffiches, 18/11)      */}
      {/* =============================================================== */}
      <section id="affiches" class="rounded-lg border border-bo-border bg-bo-surface p-5">
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <h3 class="font-semibold">Affiches de la page</h3>
          <p class="text-sm font-medium" data-choix-compte></p>
        </div>
        <p class="mb-4 mt-1 max-w-3xl text-sm text-bo-muted">
          Cochez les affiches dans le tableau, puis rangez-les ci-dessous. La
          page les montre dans cet ordre, avec une recherche et des filtres.
        </p>
        <input
          type="hidden"
          name="affichesChoisies"
          data-choix-champ
          value={JSON.stringify(choix)}
        />
        <div id="affiches-choix" data-donnees={JSON.stringify(donneesChoix)}>
          <div class="space-y-3 rounded border border-bo-border p-3">
            <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
              <span class="font-medium">Ordre</span>
              <label class="flex items-center gap-1">
                <input type="radio" name="_choixMode" value="liste" data-choix-mode />
                Une seule liste
              </label>
              <label class="flex items-center gap-1">
                <input type="radio" name="_choixMode" value="collections" data-choix-mode />
                Groupées par collection
              </label>
              <label class="flex items-center gap-1" data-choix-titres-label>
                <input type="checkbox" data-choix-titres />
                Nom de chaque collection au-dessus de ses affiches
              </label>
            </div>
            <div class="flex flex-wrap items-center gap-2 text-sm">
              <span class="text-bo-muted">Trier :</span>
              <button type="button" class={boutonDiscret} data-choix-tri="nom">Nom A→Z</button>
              <button type="button" class={boutonDiscret} data-choix-tri="recent">Nouveautés d'abord</button>
              <button type="button" class={boutonDiscret} data-choix-tri="collection">Par collection</button>
            </div>
            <div class="flex flex-wrap items-center gap-2 text-sm">
              <span class="text-bo-muted">Collection</span>
              <select
                data-choix-collection-place
                aria-label="Collection à placer"
                class="rounded border border-bo-border bg-bo-surface px-2 py-1 text-sm"
              >
                {(donnees?.collections ?? []).map((c) => (
                  <option value={c.slug}>{c.name}</option>
                ))}
              </select>
              <button type="button" class={boutonDiscret} data-choix-placer="tete">En tête</button>
              <button type="button" class={boutonDiscret} data-choix-placer="fin">À la fin</button>
            </div>
            <ol data-choix-liste class="max-h-[30rem] space-y-1 overflow-y-auto"></ol>
            <p data-choix-vide class="text-sm text-bo-muted">
              Aucune affiche pour l'instant : cochez-en dans le tableau ci-dessous.
            </p>
          </div>

          <h4 class="mt-5 text-sm font-semibold">Choisir les affiches</h4>
          <div class="mt-2 flex flex-wrap items-center gap-2 text-sm">
            <input
              type="search"
              data-filtre-texte
              placeholder="Nom ou ville"
              aria-label="Rechercher une affiche par son nom ou sa ville"
              class="w-56 rounded border border-bo-border bg-bo-surface px-2 py-1"
            />
            <select
              data-filtre-collection
              aria-label="Collection"
              class="rounded border border-bo-border bg-bo-surface px-2 py-1"
            >
              <option value="">Toutes les collections</option>
              {(donnees?.collections ?? []).map((c) => (
                <option value={c.slug}>{c.name}</option>
              ))}
            </select>
            <select
              data-filtre-genre
              aria-label="Genre"
              class="rounded border border-bo-border bg-bo-surface px-2 py-1"
            >
              <option value="">Tous les genres</option>
              <option value="personnalisable">Personnalisables</option>
              <option value="prete_a_imprimer">Prêtes à imprimer</option>
            </select>
            <select
              data-filtre-dans
              aria-label="Dans la page"
              class="rounded border border-bo-border bg-bo-surface px-2 py-1"
            >
              <option value="">Dans la page ou non</option>
              <option value="oui">Déjà dans la page</option>
              <option value="non">Pas encore</option>
            </select>
          </div>
          <div class="mt-2 flex flex-wrap items-center gap-2 text-sm">
            <button type="button" class={boutonDiscret} data-choix-cocher="oui">
              Cocher tout ce qui est affiché
            </button>
            <button type="button" class={boutonDiscret} data-choix-cocher="non">
              Décocher tout ce qui est affiché
            </button>
            <span class="text-bo-muted" data-filtre-compte></span>
          </div>
          <div class="mt-2 flex flex-wrap items-center gap-2 text-sm">
            <span class="text-bo-muted">Toute une collection :</span>
            <select
              data-choix-collection-lot
              aria-label="Collection à ajouter ou retirer"
              class="rounded border border-bo-border bg-bo-surface px-2 py-1"
            >
              {(donnees?.collections ?? []).map((c) => (
                <option value={c.slug}>{c.name}</option>
              ))}
            </select>
            <button type="button" class={boutonDiscret} data-choix-lot="ajouter">
              Ajouter ses affiches
            </button>
            <button type="button" class={boutonDiscret} data-choix-lot="retirer">
              Retirer ses affiches
            </button>
          </div>
          <p data-choix-message class="mt-2 text-sm text-amber-800" role="status"></p>
          {!catalogue && (
            <p class="mt-2 text-sm text-red-700">
              La liste des affiches n'a pas pu être chargée. Rechargez la page.
            </p>
          )}
          <div class="mt-2 max-h-[34rem] overflow-y-auto rounded border border-bo-border">
            <table class="w-full text-sm">
              <thead class="sticky top-0 z-10 bg-bo-bg text-left text-xs text-bo-muted">
                <tr>
                  <th class="w-8 px-2 py-1.5"><span class="sr-only">Dans la page</span></th>
                  <th class="px-2 py-1.5">Affiche</th>
                  <th class="px-2 py-1.5">Collections</th>
                  <th class="px-2 py-1.5">Genre</th>
                  <th class="px-2 py-1.5">Dans la page</th>
                </tr>
              </thead>
              <tbody data-choix-table></tbody>
            </table>
          </div>
        </div>
        <script is:inline>
          (function () {
            var racine = document.getElementById("affiches-choix");
            var champ = document.querySelector("[data-choix-champ]");
            if (!racine || !champ) return;
            var D;
            try {
              D = JSON.parse(racine.getAttribute("data-donnees") || "{}");
            } catch (e) {
              return;
            }
            var MAX = D.max || 200;
            var produits = new Map();
            (D.produits || []).forEach(function (p) {
              produits.set(p.id, p);
            });
            var collections = D.collections || [];
            var rangCollection = new Map();
            var nomCollection = new Map();
            collections.forEach(function (c, i) {
              rangCollection.set(c.slug, i);
              nomCollection.set(c.slug, c.nom);
            });
            var choix = D.choix || {};
            var etat = {
              mode: choix.mode === "collections" ? "collections" : "liste",
              ordre: (choix.ordre || []).slice(),
              sections: (choix.sections || []).map(function (s) {
                return { collection: s.collection || "", affiches: (s.affiches || []).slice() };
              }),
              titres: choix.titres !== false,
            };
            // La collection par laquelle une affiche est entrée : c'est sa
            // section dans le rangement par collection.
            var origine = new Map();
            etat.sections.forEach(function (s) {
              s.affiches.forEach(function (id) {
                origine.set(id, s.collection);
              });
            });

            var listeEl = racine.querySelector("[data-choix-liste]");
            var videEl = racine.querySelector("[data-choix-vide]");
            var compteEl = document.querySelector("[data-choix-compte]");
            var messageEl = racine.querySelector("[data-choix-message]");
            var titresEl = racine.querySelector("[data-choix-titres]");
            var titresLabel = racine.querySelector("[data-choix-titres-label]");
            var tbody = racine.querySelector("[data-choix-table]");
            var texte = racine.querySelector("[data-filtre-texte]");
            var fCollection = racine.querySelector("[data-filtre-collection]");
            var fGenre = racine.querySelector("[data-filtre-genre]");
            var fDans = racine.querySelector("[data-filtre-dans]");
            var compteFiltre = racine.querySelector("[data-filtre-compte]");

            function aplatir(s) {
              return String(s || "").normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase();
            }
            function nomDe(id) {
              var p = produits.get(id);
              return p ? p.nom : "Affiche n° " + id + " (introuvable)";
            }
            function choisies() {
              if (etat.mode !== "collections") return etat.ordre;
              var toutes = [];
              etat.sections.forEach(function (s) {
                toutes = toutes.concat(s.affiches);
              });
              return toutes;
            }
            function collectionDe(id) {
              if (origine.has(id)) return origine.get(id);
              var p = produits.get(id);
              var meilleure = "";
              ((p && p.collections) || []).forEach(function (c) {
                if (!rangCollection.has(c)) return;
                if (!meilleure || rangCollection.get(c) < rangCollection.get(meilleure)) meilleure = c;
              });
              return meilleure;
            }
            function dans(id, c) {
              var p = produits.get(id);
              return !!p && (p.collections || []).indexOf(c) !== -1;
            }
            function dire(t) {
              if (messageEl) messageEl.textContent = t || "";
            }
            function sectionDe(c) {
              for (var i = 0; i < etat.sections.length; i++)
                if (etat.sections[i].collection === c) return etat.sections[i];
              var s = { collection: c, affiches: [] };
              etat.sections.push(s);
              return s;
            }
            function ajouter(ids, via) {
              var deja = new Set(choisies());
              var n = deja.size;
              var refusees = 0;
              ids.forEach(function (id) {
                if (deja.has(id)) return;
                if (n >= MAX) {
                  refusees++;
                  return;
                }
                if (via) origine.set(id, via);
                if (etat.mode === "collections") sectionDe(collectionDe(id)).affiches.push(id);
                else etat.ordre.push(id);
                deja.add(id);
                n++;
              });
              dire(
                refusees
                  ? "Une page montre au plus " + MAX + " affiches : " + refusees + " n'ont pas été ajoutées."
                  : "",
              );
            }
            function retirer(ids) {
              var partir = new Set(ids);
              etat.ordre = etat.ordre.filter(function (id) {
                return !partir.has(id);
              });
              etat.sections.forEach(function (s) {
                s.affiches = s.affiches.filter(function (id) {
                  return !partir.has(id);
                });
              });
              etat.sections = etat.sections.filter(function (s) {
                return s.affiches.length;
              });
              dire("");
            }
            function deplacer(liste, de, vers) {
              if (de === vers || de < 0 || vers < 0 || de >= liste.length || vers >= liste.length) return;
              var x = liste.splice(de, 1)[0];
              liste.splice(vers, 0, x);
            }
            function trier(liste, cle) {
              var rangs = liste.map(function (id, i) {
                return { id: id, i: i };
              });
              rangs.sort(function (a, b) {
                if (cle === "nom") return nomDe(a.id).localeCompare(nomDe(b.id), "fr") || a.i - b.i;
                if (cle === "recent") return b.id - a.id;
                var ra = rangCollection.has(collectionDe(a.id)) ? rangCollection.get(collectionDe(a.id)) : 1e9;
                var rb = rangCollection.has(collectionDe(b.id)) ? rangCollection.get(collectionDe(b.id)) : 1e9;
                return ra - rb || a.i - b.i;
              });
              return rangs.map(function (x) {
                return x.id;
              });
            }

            function bouton(action, signe, titre) {
              var b = document.createElement("button");
              b.type = "button";
              b.dataset.action = action;
              b.textContent = signe;
              b.title = titre;
              b.setAttribute("aria-label", titre);
              b.className = "rounded border border-bo-border px-1.5 text-xs hover:bg-bo-bg";
              return b;
            }
            function ligneAffiche(id, section, index) {
              var p = produits.get(id);
              var li = document.createElement("li");
              li.className =
                "flex items-center gap-2 rounded border border-bo-border bg-bo-surface px-2 py-1" +
                (section >= 0 ? " ml-6" : "");
              li.draggable = true;
              li.dataset.genre = "affiche";
              li.dataset.section = String(section);
              li.dataset.index = String(index);
              var poignee = document.createElement("span");
              poignee.textContent = "⠿";
              poignee.className = "cursor-grab select-none text-bo-muted";
              poignee.setAttribute("aria-hidden", "true");
              li.appendChild(poignee);
              var rang = document.createElement("span");
              rang.className = "w-8 text-right text-xs text-bo-muted";
              rang.textContent = String(index + 1);
              li.appendChild(rang);
              if (p && p.image) {
                var img = document.createElement("img");
                img.src = p.image;
                img.alt = "";
                img.loading = "lazy";
                img.className = "h-10 w-8 rounded border border-bo-border object-cover";
                li.appendChild(img);
              }
              var nom = document.createElement("span");
              nom.className = "min-w-0 flex-1 truncate";
              nom.textContent = nomDe(id) + (p && p.statut !== "active" ? " (hors vente : invisible)" : "");
              li.appendChild(nom);
              li.appendChild(bouton("monter", "↑", "Monter"));
              li.appendChild(bouton("descendre", "↓", "Descendre"));
              li.appendChild(bouton("tete", "⤒", "En tête"));
              li.appendChild(bouton("fin", "⤓", "À la fin"));
              li.appendChild(bouton("retirer", "✕", "Retirer de la page"));
              return li;
            }
            function ligneSection(s, index) {
              var li = document.createElement("li");
              li.className = "mt-2 flex items-center gap-2 rounded bg-bo-bg px-2 py-1 font-medium";
              li.draggable = true;
              li.dataset.genre = "section";
              li.dataset.index = String(index);
              var poignee = document.createElement("span");
              poignee.textContent = "⠿";
              poignee.className = "cursor-grab select-none text-bo-muted";
              poignee.setAttribute("aria-hidden", "true");
              li.appendChild(poignee);
              var nom = document.createElement("span");
              nom.className = "flex-1";
              nom.textContent =
                (s.collection ? nomCollection.get(s.collection) || s.collection : "Autres affiches") +
                " (" + s.affiches.length + ")";
              li.appendChild(nom);
              li.appendChild(bouton("section-monter", "↑", "Monter la collection"));
              li.appendChild(bouton("section-descendre", "↓", "Descendre la collection"));
              li.appendChild(bouton("section-tete", "⤒", "Collection en tête"));
              li.appendChild(bouton("section-fin", "⤓", "Collection à la fin"));
              return li;
            }

            var lignesTable = [];
            (D.produits || [])
              .filter(function (p) {
                return p.statut === "active";
              })
              .forEach(function (p) {
                var tr = document.createElement("tr");
                tr.className = "border-t border-bo-border";
                tr.dataset.id = String(p.id);
                tr.dataset.cle = aplatir(p.nom + " " + p.slug);
                tr.dataset.collections = " " + (p.collections || []).join(" ") + " ";
                tr.dataset.genre = p.genre;
                var td0 = document.createElement("td");
                td0.className = "px-2 py-1";
                var coche = document.createElement("input");
                coche.type = "checkbox";
                coche.id = "choix-affiche-" + p.id;
                td0.appendChild(coche);
                tr.appendChild(td0);
                var td1 = document.createElement("td");
                td1.className = "px-2 py-1";
                var etiquette = document.createElement("label");
                etiquette.htmlFor = coche.id;
                etiquette.className = "flex cursor-pointer items-center gap-2";
                if (p.image) {
                  var img = document.createElement("img");
                  img.src = p.image;
                  img.alt = "";
                  img.loading = "lazy";
                  img.className = "h-10 w-8 rounded border border-bo-border object-cover";
                  etiquette.appendChild(img);
                }
                var nom = document.createElement("span");
                nom.textContent = p.nom;
                etiquette.appendChild(nom);
                td1.appendChild(etiquette);
                tr.appendChild(td1);
                var td2 = document.createElement("td");
                td2.className = "px-2 py-1 text-xs text-bo-muted";
                td2.textContent = (p.collections || [])
                  .map(function (c) {
                    return nomCollection.get(c) || c;
                  })
                  .join(", ");
                tr.appendChild(td2);
                var td3 = document.createElement("td");
                td3.className = "px-2 py-1 text-xs text-bo-muted";
                td3.textContent = p.genre === "prete_a_imprimer" ? "Prête à imprimer" : "Personnalisable";
                tr.appendChild(td3);
                var td4 = document.createElement("td");
                td4.className = "px-2 py-1 text-xs";
                td4.dataset.dans = "";
                tr.appendChild(td4);
                tbody.appendChild(tr);
                lignesTable.push(tr);
              });

            function filtrer() {
              var mots = aplatir(texte.value).split(/\s+/).filter(Boolean);
              var c = fCollection.value;
              var g = fGenre.value;
              var d = fDans.value;
              var retenues = new Set(choisies());
              var n = 0;
              lignesTable.forEach(function (tr) {
                var id = Number(tr.dataset.id);
                var ok =
                  mots.every(function (m) {
                    return tr.dataset.cle.indexOf(m) !== -1;
                  }) &&
                  (!c || tr.dataset.collections.indexOf(" " + c + " ") !== -1) &&
                  (!g || tr.dataset.genre === g) &&
                  (!d || (d === "oui") === retenues.has(id));
                tr.hidden = !ok;
                if (ok) n++;
              });
              compteFiltre.textContent = n + (n > 1 ? " affiches affichées" : " affiche affichée");
            }

            function dessiner() {
              listeEl.innerHTML = "";
              if (etat.mode === "collections")
                etat.sections.forEach(function (s, si) {
                  listeEl.appendChild(ligneSection(s, si));
                  s.affiches.forEach(function (id, i) {
                    listeEl.appendChild(ligneAffiche(id, si, i));
                  });
                });
              else
                etat.ordre.forEach(function (id, i) {
                  listeEl.appendChild(ligneAffiche(id, -1, i));
                });
              var toutes = choisies();
              var retenues = new Set(toutes);
              videEl.hidden = toutes.length > 0;
              if (compteEl)
                compteEl.textContent =
                  toutes.length + (toutes.length > 1 ? " affiches dans la page" : " affiche dans la page");
              lignesTable.forEach(function (tr) {
                var oui = retenues.has(Number(tr.dataset.id));
                tr.querySelector("input").checked = oui;
                tr.querySelector("[data-dans]").textContent = oui ? "Oui" : "";
              });
              racine.querySelectorAll("[data-choix-mode]").forEach(function (r) {
                r.checked = r.value === etat.mode;
              });
              titresEl.checked = etat.titres;
              titresLabel.hidden = etat.mode !== "collections";
              champ.value = JSON.stringify({
                mode: etat.mode,
                ordre: toutes,
                sections: etat.mode === "collections" ? etat.sections : [],
                titres: etat.titres,
              });
              filtrer();
            }

            // La liste rangée : flèches, en tête, à la fin, retirer.
            listeEl.addEventListener("click", function (e) {
              var b = e.target.closest ? e.target.closest("[data-action]") : null;
              if (!b) return;
              var li = b.closest("li");
              var action = b.dataset.action;
              var i = Number(li.dataset.index);
              if (li.dataset.genre === "section") {
                var n = etat.sections.length;
                if (action === "section-monter") deplacer(etat.sections, i, i - 1);
                else if (action === "section-descendre") deplacer(etat.sections, i, i + 1);
                else if (action === "section-tete") deplacer(etat.sections, i, 0);
                else if (action === "section-fin") deplacer(etat.sections, i, n - 1);
              } else {
                var si = Number(li.dataset.section);
                var liste = si >= 0 ? etat.sections[si].affiches : etat.ordre;
                var id = liste[i];
                if (action === "monter") deplacer(liste, i, i - 1);
                else if (action === "descendre") deplacer(liste, i, i + 1);
                else if (action === "tete") deplacer(liste, i, 0);
                else if (action === "fin") deplacer(liste, i, liste.length - 1);
                else if (action === "retirer") retirer([id]);
              }
              dessiner();
            });
            // Glisser-déposer : une affiche dans sa liste (ou sa section), une
            // collection parmi les collections.
            var tenu = null;
            listeEl.addEventListener("dragstart", function (e) {
              var li = e.target.closest ? e.target.closest("li[draggable]") : null;
              if (!li) return;
              tenu = { genre: li.dataset.genre, section: li.dataset.section, index: Number(li.dataset.index) };
              e.dataTransfer.effectAllowed = "move";
              try {
                e.dataTransfer.setData("text/plain", "");
              } catch (err) {}
            });
            listeEl.addEventListener("dragover", function (e) {
              var li = e.target.closest ? e.target.closest("li[draggable]") : null;
              if (!tenu || !li || li.dataset.genre !== tenu.genre) return;
              if (tenu.genre === "affiche" && li.dataset.section !== tenu.section) return;
              e.preventDefault();
            });
            listeEl.addEventListener("drop", function (e) {
              var li = e.target.closest ? e.target.closest("li[draggable]") : null;
              if (!tenu || !li || li.dataset.genre !== tenu.genre) return;
              e.preventDefault();
              var vers = Number(li.dataset.index);
              if (tenu.genre === "section") deplacer(etat.sections, tenu.index, vers);
              else if (li.dataset.section === tenu.section) {
                var si = Number(tenu.section);
                deplacer(si >= 0 ? etat.sections[si].affiches : etat.ordre, tenu.index, vers);
              }
              tenu = null;
              dessiner();
            });
            listeEl.addEventListener("dragend", function () {
              tenu = null;
            });

            // Le mode : une liste, ou des sections par collection.
            racine.querySelectorAll("[data-choix-mode]").forEach(function (r) {
              r.addEventListener("change", function () {
                if (!r.checked || r.value === etat.mode) return;
                if (r.value === "collections") {
                  var ordre = etat.ordre;
                  etat.sections = [];
                  etat.mode = "collections";
                  ordre.forEach(function (id) {
                    sectionDe(collectionDe(id)).affiches.push(id);
                  });
                  etat.ordre = [];
                } else {
                  etat.ordre = choisies().slice();
                  etat.sections = [];
                  etat.mode = "liste";
                }
                dessiner();
              });
            });
            titresEl.addEventListener("change", function () {
              etat.titres = titresEl.checked;
              dessiner();
            });
            // Les tris rapides : un ordre qu'on retouche ensuite à la main.
            racine.querySelectorAll("[data-choix-tri]").forEach(function (b) {
              b.addEventListener("click", function () {
                var cle = b.dataset.choixTri;
                if (etat.mode === "collections") {
                  if (cle === "collection")
                    etat.sections.sort(function (a, c) {
                      var ra = rangCollection.has(a.collection) ? rangCollection.get(a.collection) : 1e9;
                      var rc = rangCollection.has(c.collection) ? rangCollection.get(c.collection) : 1e9;
                      return ra - rc;
                    });
                  else
                    etat.sections.forEach(function (s) {
                      s.affiches = trier(s.affiches, cle);
                    });
                } else etat.ordre = trier(etat.ordre, cle);
                dessiner();
              });
            });
            // Toute une collection en tête, ou à la fin.
            racine.querySelectorAll("[data-choix-placer]").forEach(function (b) {
              b.addEventListener("click", function () {
                var c = racine.querySelector("[data-choix-collection-place]").value;
                var tete = b.dataset.choixPlacer === "tete";
                if (etat.mode === "collections") {
                  var i = etat.sections.findIndex(function (s) {
                    return s.collection === c;
                  });
                  if (i < 0) {
                    dire("Cette collection n'a pas de section dans la page.");
                    return;
                  }
                  deplacer(etat.sections, i, tete ? 0 : etat.sections.length - 1);
                } else {
                  var siDans = etat.ordre.filter(function (id) {
                    return dans(id, c);
                  });
                  if (!siDans.length) {
                    dire("Aucune affiche de la page n'est dans cette collection.");
                    return;
                  }
                  var autres = etat.ordre.filter(function (id) {
                    return !dans(id, c);
                  });
                  etat.ordre = tete ? siDans.concat(autres) : autres.concat(siDans);
                }
                dire("");
                dessiner();
              });
            });
            // Le tableau : une case par affiche.
            tbody.addEventListener("change", function (e) {
              var coche = e.target;
              if (!coche || coche.type !== "checkbox") return;
              var id = Number(coche.closest("tr").dataset.id);
              if (coche.checked) ajouter([id], fCollection.value || "");
              else retirer([id]);
              dessiner();
            });
            function visibles() {
              return lignesTable
                .filter(function (tr) {
                  return !tr.hidden;
                })
                .map(function (tr) {
                  return Number(tr.dataset.id);
                });
            }
            racine.querySelectorAll("[data-choix-cocher]").forEach(function (b) {
              b.addEventListener("click", function () {
                if (b.dataset.choixCocher === "oui") ajouter(visibles(), fCollection.value || "");
                else retirer(visibles());
                dessiner();
              });
            });
            // Toute une collection d'un coup : ajouter ses affiches en vente,
            // ou retirer de la page celles qui en font partie.
            racine.querySelectorAll("[data-choix-lot]").forEach(function (b) {
              b.addEventListener("click", function () {
                var c = racine.querySelector("[data-choix-collection-lot]").value;
                var ids = lignesTable
                  .map(function (tr) {
                    return Number(tr.dataset.id);
                  })
                  .filter(function (id) {
                    return dans(id, c);
                  });
                if (b.dataset.choixLot === "ajouter") ajouter(ids, c);
                else retirer(ids);
                dessiner();
              });
            });
            [texte, fCollection, fGenre, fDans].forEach(function (el) {
              el.addEventListener(el === texte ? "input" : "change", filtrer);
            });
            // Entrée dans la recherche ne doit pas enregistrer la page.
            texte.addEventListener("keydown", function (e) {
              if (e.key === "Enter") e.preventDefault();
            });
            dessiner();
          })();
        </script>
      </section>

      {/* =============================================================== */}
      {/* Les affiches de la page (cf. blocDesAffiches)                   */}
      {/* =============================================================== */}
      <details
        id="affiches-collections"
        class="rounded-lg border border-bo-border bg-bo-surface p-5"
        open={affiches.collections.length > 0}
      >
        <summary class="cursor-pointer font-semibold">
          Autre façon : une grille qui suit des collections entières
        </summary>
        <p class="mb-4 mt-2 max-w-3xl text-sm text-bo-muted">
          Une grille d'affiches sous le texte, prises dans les collections
          choisies ci-dessous, <strong>dans cet ordre</strong> : d'abord celles
          de la 1re collection, puis celles de la 2e, et ainsi de suite, sans
          doublon. Laissez tout sur « aucune » pour une page sans affiches.
        </p>
        {/* Une liste au départ (ou une par collection déjà choisie) ; « +
            Ajouter une collection » en ajoute une, jusqu'à COLLECTIONS_MAX,
            sans écrire la borne (Alexandra, 13/11). */}
        <div id="affiches-liste" class="space-y-2" data-max={COLLECTIONS_MAX}>
          {Array.from({ length: Math.max(1, affiches.collections.length) }, (_, i) => (
            <div data-ligne-collection class="flex items-end gap-2">
              <label class="block w-full max-w-md">
                <span data-rang class="text-xs text-bo-muted">
                  {i === 0 ? "1re collection (en premier)" : `${i + 1}e collection`}
                </span>
                <select name="affiches" class={champ}>
                  <option value="">— aucune —</option>
                  {(donnees?.collections ?? []).map((c) => (
                    <option value={c.slug} selected={affiches.collections[i] === c.slug}>
                      {c.name}
                    </option>
                  ))}
                </select>
              </label>
              <button
                type="button"
                data-retirer-collection
                class={`${boutonDiscret} mb-0.5`}
                title="Retirer cette collection"
                aria-label="Retirer cette collection"
                hidden={i === 0 && affiches.collections.length <= 1}
              >
                ✕
              </button>
            </div>
          ))}
        </div>
        <button type="button" id="affiches-ajouter" class={`${boutonDiscret} mt-3`}>
          + Ajouter une collection
        </button>
        <script is:inline>
          (function () {
            var liste = document.getElementById("affiches-liste");
            var ajouter = document.getElementById("affiches-ajouter");
            if (!liste || !ajouter) return;
            var max = Number(liste.dataset.max) || 20;
            function lignes() {
              return Array.prototype.slice.call(liste.querySelectorAll("[data-ligne-collection]"));
            }
            function renumeroter() {
              var l = lignes();
              l.forEach(function (ligne, i) {
                var rang = ligne.querySelector("[data-rang]");
                if (rang) rang.textContent = i === 0 ? "1re collection (en premier)" : i + 1 + "e collection";
                var x = ligne.querySelector("[data-retirer-collection]");
                if (x) x.hidden = l.length === 1;
              });
              ajouter.hidden = l.length >= max;
            }
            ajouter.addEventListener("click", function () {
              var l = lignes();
              if (l.length >= max) return;
              var copie = l[l.length - 1].cloneNode(true);
              var choix = copie.querySelector("select");
              if (choix) choix.value = "";
              liste.appendChild(copie);
              renumeroter();
              if (choix) choix.focus();
            });
            liste.addEventListener("click", function (e) {
              var x = e.target.closest && e.target.closest("[data-retirer-collection]");
              if (!x) return;
              var l = lignes();
              var ligne = x.closest("[data-ligne-collection]");
              if (l.length === 1) {
                var s = ligne.querySelector("select");
                if (s) s.value = "";
              } else ligne.remove();
              renumeroter();
            });
            renumeroter();
          })();
        </script>
        <label class="mt-4 block w-60">
          <span class="text-xs text-bo-muted">Nombre d'affiches</span>
          <input
            type="number"
            name="affichesLimite"
            min="1"
            max={AFFICHES_MAX}
            value={affiches.limite}
            class={champ}
          />
        </label>
        <p class="mt-2 text-xs text-bo-muted">
          Une collection vide n'affiche rien : remplissez-la depuis Produits
          (filtrez, cochez, puis « Ajouter » à la collection).
        </p>
      </details>

      {/* =============================================================== */}
      {/* Référencement                                                   */}
      {/* =============================================================== */}
      <section id="referencement" class="rounded-lg border border-bo-border bg-bo-surface p-5">
        <h3 class="mb-1 font-semibold">Référencement</h3>
        <p class="mb-4 max-w-3xl text-sm text-bo-muted">
          Ce que Google affiche dans ses résultats. Laissés vides, ces deux
          champs retombent sur le nom de la page.
        </p>
        <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
          <label class="block">
            <span class="text-sm font-medium">Titre dans Google</span>
            <input name="seoTitle" value={seoTitre} class={champ} />
          </label>
          <label class="block">
            <span class="text-sm font-medium">Description dans Google</span>
            <textarea name="seoDescription" rows="3" class={champ}
              >{seoDescription}</textarea
            >
          </label>
        </div>
      </section>

      <div class="flex flex-wrap items-center gap-3">
        <button class={boutonPrincipal}>Enregistrer</button>
        <a href={url("/pages")} class={boutonDiscret}>Retour aux pages</a>
      </div>
    </form>
  )}

  {/* =================================================================== */}
  {/* Traductions — un formulaire à part, une langue à la fois            */}
  {/* =================================================================== */}
  {page && (
    <section
      id="traductions"
      class="mt-6 rounded-lg border border-bo-border bg-bo-surface p-5"
    >
      <h3 class="mb-1 font-semibold">Traductions</h3>
      <p class="mb-2 max-w-3xl text-sm text-bo-muted">
        La boutique est lue dans cinq langues. Ce que vous avez écrit au-dessus
        est le français : c'est la version de référence.
      </p>
      <p class="mb-4 max-w-3xl text-sm text-bo-muted">
        <strong>Un champ laissé vide affiche le français</strong> sur le site —
        jamais un blanc. Vous pouvez donc ne traduire que le nom de la page
        aujourd'hui, et le texte plus tard.
      </p>
      <p class="mb-4 max-w-3xl rounded border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-900">
        Ouvrir une langue recharge l'écran : enregistrez d'abord vos
        modifications françaises, sinon elles seront perdues.
      </p>

      <div class="flex flex-wrap items-center gap-2">
        {LANGUES_TRADUISIBLES.map((l) => {
          const etat = etatLangue(l.code);
          const ouverte = langueOuverte === l.code;
          return (
            <a
              href={ouverte ? lienLangue(null) : lienLangue(l.code)}
              aria-current={ouverte ? "true" : undefined}
              class={`flex items-center gap-2 rounded border px-3 py-1.5 text-sm ${
                ouverte
                  ? "border-bo-accent bg-bo-bg font-medium"
                  : "border-bo-border bg-bo-surface hover:bg-bo-bg"
              }`}
            >
              <span>{l.nom}</span>
              <span
                class={`rounded-full px-2 py-0.5 text-xs font-normal ${etat.classe}`}
                title={etat.manque}
              >
                {etat.texte}
              </span>
            </a>
          );
        })}
      </div>

      {!langueOuverte && (
        <p class="mt-4 text-sm text-bo-muted">
          Choisissez une langue ci-dessus pour la saisir.
        </p>
      )}

      {langueOuverte && (
        <form method="POST" class="mt-5 space-y-5 border-t border-bo-border pt-5">
          <input type="hidden" name="_action" value="traduction" />
          <input type="hidden" name="lang" value={langueOuverte} />

          <label class="block">
            <span class="text-sm font-medium">
              Nom de la page en {nomLangueOuverte.toLowerCase()}
            </span>
            <input
              name="titre"
              value={champsLangue.titre}
              placeholder={titre}
              class={propose("titre") ? champPropose : champ}
            />
            <span class="mt-1 block text-xs text-bo-muted">
              Français : {titre}
            </span>
          </label>

          <div>
            <span class="text-sm font-medium">
              Contenu en {nomLangueOuverte.toLowerCase()}
            </span>
            <div class={propose("corps") ? "rounded ring-2 ring-amber-400" : ""}>
              <EditeurTexte
                nom="corps"
                valeur={champsLangue.corps}
                titres
                invite="Traduisez ici. Laissé vide, le site affichera le français."
                etiquette={`Contenu en ${nomLangueOuverte.toLowerCase()}`}
              />
            </div>
            <details class="mt-1">
              <summary class="cursor-pointer text-xs text-bo-muted">
                Voir le texte français
              </summary>
              <div class="mt-1 max-h-64 overflow-y-auto rounded bg-bo-bg p-2 text-xs whitespace-pre-wrap text-bo-muted">
                {texteBrut(corps)}
              </div>
            </details>
          </div>

          {/* Le référencement de cette langue : ce que Google montre aux
              clients étrangers. Vide, la page retombe sur son nom traduit —
              jamais sur le français. */}
          <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
            <label class="block">
              <span class="text-sm font-medium">
                Titre dans Google en {nomLangueOuverte.toLowerCase()}
              </span>
              <input
                name="seoTitle"
                value={champsLangue.seoTitle}
                maxlength={200}
                placeholder={seoTitre || "Vide : le nom traduit de la page"}
                class={propose("seoTitle") ? champPropose : champ}
              />
              <span class="mt-1 block text-xs text-bo-muted">
                Français : {seoTitre || "non rempli (le nom de la page)"}
              </span>
            </label>
            <label class="block">
              <span class="text-sm font-medium">
                Description dans Google en {nomLangueOuverte.toLowerCase()}
              </span>
              <textarea
                name="seoDescription"
                rows="3"
                maxlength={400}
                placeholder={seoDescription || "Vide : Google choisit lui-même"}
                class={propose("seoDescription") ? champPropose : champ}
              >{champsLangue.seoDescription}</textarea>
              <span class="mt-1 block text-xs text-bo-muted">
                Français : {seoDescription || "non remplie"}
              </span>
            </label>
          </div>

          <div class="flex flex-wrap items-center gap-3">
            {/* « Enregistrer » d'abord : c'est le bouton que la touche Entrée
                déclenche, et Entrée doit enregistrer, pas traduire. */}
            <button class={boutonPrincipal}>
              Enregistrer {nomLangueOuverte.toLowerCase()}
            </button>
            <button
              name="auto"
              value="1"
              class={boutonDiscret}
              title="Traduit le français dans les champs restés vides, sans enregistrer"
            >
              ✨ Proposer les traductions manquantes
            </button>
            <a href={lienLangue(null)} class={boutonDiscret}>
              Fermer sans enregistrer
            </a>
          </div>
          <p class="text-xs text-bo-muted">
            « Proposer » ne remplit que les champs vides, par la traduction
            automatique, et n'enregistre rien : relisez, corrigez, puis
            enregistrez. Videz tous les champs d'une langue et enregistrez
            pour effacer sa traduction : le site repassera entièrement au
            français.
          </p>
        </form>
      )}
    </section>
  )}
</Admin>
