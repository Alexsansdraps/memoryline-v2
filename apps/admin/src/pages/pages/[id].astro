---
/**
 * L'éditeur d'une page du site.
 *
 * Une page se compose de blocs empilés : un titre, un texte, une image, une
 * grille de produits, un bouton. La personne qui écrit ne voit jamais ni
 * balise ni code : elle ajoute un bloc, le remonte, le descend, le supprime.
 *
 * Tout part en UN seul enregistrement, blocs compris, sérialisés en JSON dans
 * un champ caché tenu à jour par le navigateur. Le serveur relit ce JSON sans
 * lui faire confiance : un bloc incompréhensible est refusé avec sa raison,
 * jamais réparé au jugé, et la page se réaffiche avec ce qui venait d'être
 * saisi. Un enregistrement refusé ne coûte donc rien d'autre qu'une
 * correction.
 *
 * Les blocs de texte utilisent l'éditeur visuel du back-office. Son script
 * s'exécute au moment où le navigateur lit la page : une copie fabriquée plus
 * tard par du JavaScript serait un cadre mort, sans barre de mise en forme. Un
 * bloc de texte ne peut donc pas être inventé côté navigateur. D'où la
 * réserve : quelques blocs de texte vides sont rendus par le serveur, cachés,
 * et « Ajouter un texte » en sort un de sa boîte. La réserve se remplit à
 * nouveau à chaque enregistrement.
 */
import { url } from "../../lib/url.ts";
import Admin from "../../layouts/Admin.astro";
import EditeurTexte from "../../components/EditeurTexte.astro";
import { adminApi, type PageCms } from "../../lib/api.ts";

const api = adminApi(Astro.request);
const idPage = Number(Astro.params.id);

const PUBLIC_API_URL =
  import.meta.env.PUBLIC_API_URL ?? "http://localhost:3000";

/** Les images déposées ici sont servies par l'API sous « /assets/... ». */
function imgSrc(adresse: string): string {
  if (!adresse) return "";
  return adresse.startsWith("http") ? adresse : `${PUBLIC_API_URL}${adresse}`;
}

function originePublique(): string {
  const annoncee: unknown =
    import.meta.env.PUBLIC_SITE_URL ?? import.meta.env.PUBLIC_ORIGIN;
  if (typeof annoncee === "string" && annoncee.trim())
    return annoncee.trim().replace(/\/+$/, "");
  const entetes = Astro.request.headers;
  const hote = entetes.get("x-forwarded-host") ?? entetes.get("host");
  const protocole =
    entetes.get("x-forwarded-proto") ?? Astro.url.protocol.replace(":", "");
  return hote ? `${protocole}://${hote}` : Astro.url.origin;
}
const ORIGINE_PUBLIQUE = originePublique();
const NOM_DU_SITE = ORIGINE_PUBLIQUE.replace(/^https?:\/\//, "");

/** Même règle que sur la liste des pages : une adresse doit tenir dans un lien. */
const ADRESSE_VALIDE = /^[a-z0-9]+(?:-[a-z0-9]+)*$/;

/**
 * Ce qu'un bouton ou une entrée de menu peut viser : une page du site, une
 * autre adresse sur internet, ou une adresse électronique. Le reste ne mène
 * nulle part et personne ne s'en apercevrait avant qu'un client ne clique.
 */
const LIEN_VALIDE = /^(\/\S*|https?:\/\/\S+|mailto:\S+)$/;

type TypeBloc = "titre" | "texte" | "image" | "produits" | "bouton";
const TYPES_BLOCS = ["titre", "texte", "image", "produits", "bouton"] as const;

const NOM_BLOC: Record<TypeBloc, string> = {
  titre: "Titre",
  texte: "Texte",
  image: "Image",
  produits: "Grille de produits",
  bouton: "Bouton",
};

/**
 * Un bloc tel qu'il s'affiche dans l'éditeur : tous les champs en texte, même
 * ceux qui finiront en nombre. C'est ce qui permet de réafficher une saisie
 * refusée telle quelle, avec sa faute sous les yeux, au lieu de la remplacer
 * par une valeur par défaut que personne n'a demandée.
 */
interface BlocSouple {
  type: TypeBloc;
  texte: string;
  niveau: string;
  html: string;
  url: string;
  alt: string;
  legende: string;
  source: string;
  reference: string;
  limite: string;
  href: string;
}

/** Un bloc vérifié, dans la forme exacte que l'API attend. */
type BlocEnregistre =
  | { type: "titre"; texte: string; niveau: 2 | 3 }
  | { type: "texte"; html: string }
  | { type: "image"; url: string; alt: string; legende?: string }
  | {
      type: "produits";
      source: "collection" | "categorie";
      reference: string;
      limite: number;
    }
  | { type: "bouton"; texte: string; href: string };

function estTypeBloc(v: unknown): v is TypeBloc {
  return (
    typeof v === "string" && (TYPES_BLOCS as readonly string[]).includes(v)
  );
}

function chaine(objet: Record<string, unknown>, cle: string): string {
  const v = objet[cle];
  if (typeof v === "string") return v;
  if (typeof v === "number" && Number.isFinite(v)) return String(v);
  return "";
}

function blocVide(type: TypeBloc): BlocSouple {
  return {
    type,
    texte: "",
    niveau: "2",
    html: "",
    url: "",
    alt: "",
    legende: "",
    source: "collection",
    reference: "",
    limite: "6",
    href: "",
  };
}

/**
 * Lecture tolérante d'une liste de blocs, qu'elle vienne de la base ou du
 * champ caché. Elle ne juge rien : elle sert à REMPLIR l'écran. Le tri entre
 * ce qui est enregistrable et ce qui ne l'est pas se fait plus bas.
 */
function blocsSouples(brut: unknown): BlocSouple[] {
  if (!Array.isArray(brut)) return [];
  const sortie: BlocSouple[] = [];
  for (const item of brut) {
    if (!item || typeof item !== "object") continue;
    const o = item as Record<string, unknown>;
    if (!estTypeBloc(o.type)) continue;
    const bloc = blocVide(o.type);
    bloc.texte = chaine(o, "texte");
    bloc.niveau = chaine(o, "niveau") || "2";
    bloc.html = chaine(o, "html");
    bloc.url = chaine(o, "url");
    bloc.alt = chaine(o, "alt");
    bloc.legende = chaine(o, "legende");
    bloc.source = chaine(o, "source") === "categorie" ? "categorie" : "collection";
    bloc.reference = chaine(o, "reference");
    bloc.limite = chaine(o, "limite") || "6";
    bloc.href = chaine(o, "href");
    sortie.push(bloc);
  }
  return sortie;
}

/** Le plus grand nombre d'articles qu'une grille peut montrer sans devenir illisible. */
const LIMITE_MAX = 48;

/**
 * Le tri sévère. Chaque refus nomme le bloc par son numéro à l'écran et dit
 * quoi corriger : « bloc n°3 » se retrouve, « champ invalide » non.
 */
function verifierBlocs(souples: BlocSouple[]): BlocEnregistre[] {
  const sortie: BlocEnregistre[] = [];
  souples.forEach((b, i) => {
    const ou = `Bloc n°${i + 1} (${NOM_BLOC[b.type].toLowerCase()})`;
    if (b.type === "titre") {
      const texte = b.texte.trim();
      if (!texte)
        throw new Error(
          `${ou} : écrivez le titre, ou supprimez ce bloc s'il ne sert pas.`,
        );
      sortie.push({ type: "titre", texte, niveau: b.niveau === "3" ? 3 : 2 });
    } else if (b.type === "texte") {
      const html = b.html.trim();
      if (!html)
        throw new Error(
          `${ou} : ce bloc est vide. Écrivez votre texte, ou supprimez le bloc.`,
        );
      sortie.push({ type: "texte", html });
    } else if (b.type === "image") {
      const adresse = b.url.trim();
      if (!adresse)
        throw new Error(
          `${ou} : aucune image choisie. Choisissez une image, ou supprimez le bloc.`,
        );
      // La légende est facultative : absente du bloc plutôt que vide, sinon
      // le site afficherait une ligne blanche sous l'image.
      const legende = b.legende.trim();
      const alt = b.alt.trim();
      sortie.push(
        legende
          ? { type: "image", url: adresse, alt, legende }
          : { type: "image", url: adresse, alt },
      );
    } else if (b.type === "produits") {
      const source = b.source === "categorie" ? "categorie" : "collection";
      const reference = b.reference.trim();
      if (!reference)
        throw new Error(
          source === "categorie"
            ? `${ou} : choisissez la catégorie de produits à afficher.`
            : `${ou} : choisissez la collection à afficher.`,
        );
      // Un champ vidé ne vaut pas zéro article : il ne vaut rien du tout, et
      // une grille réglée sur zéro s'afficherait vide sans un mot d'explication.
      const brut = b.limite.trim();
      if (!brut)
        throw new Error(
          `${ou} : indiquez combien d'articles la grille peut montrer, par exemple 6.`,
        );
      const limite = Number(brut);
      if (!Number.isInteger(limite) || limite < 1 || limite > LIMITE_MAX)
        throw new Error(
          `${ou} : « ${brut} » n'est pas un nombre d'articles possible. ` +
            `Écrivez un nombre entier entre 1 et ${LIMITE_MAX}.`,
        );
      sortie.push({ type: "produits", source, reference, limite });
    } else {
      const texte = b.texte.trim();
      const href = b.href.trim();
      if (!texte)
        throw new Error(`${ou} : écrivez ce qui doit être marqué sur le bouton.`);
      if (!href)
        throw new Error(
          `${ou} : indiquez où le bouton emmène, par exemple /magnets.`,
        );
      if (!LIEN_VALIDE.test(href))
        throw new Error(
          `${ou} : « ${href} » ne mène nulle part. Commencez par / pour une ` +
            `page du site (par exemple /magnets), ou par https:// pour un autre site.`,
        );
      sortie.push({ type: "bouton", texte, href });
    }
  });
  return sortie;
}

let flash: string | null = null;
let flashErreur = false;

/** Ce qui vient d'être saisi, gardé seulement si l'enregistrement est refusé. */
let saisie: {
  titre: string;
  adresse: string;
  statut: string;
  seoTitre: string;
  seoDescription: string;
  blocs: BlocSouple[];
} | null = null;

if (Astro.request.method === "POST") {
  const f = await Astro.request.formData();
  const titre = String(f.get("title") ?? "").trim();
  const adresse = String(f.get("slug") ?? "").trim();
  const statut = String(f.get("status") ?? "");
  const seoTitre = String(f.get("seoTitle") ?? "").trim();
  const seoDescription = String(f.get("seoDescription") ?? "").trim();
  const brutBlocs = String(f.get("blocs") ?? "");

  let souples: BlocSouple[] = [];
  let lectureCassee = false;
  try {
    souples = blocsSouples(JSON.parse(brutBlocs || "[]"));
  } catch {
    // Le champ caché est illisible : c'est un incident du navigateur, pas une
    // faute de saisie. On le dira, et l'écran repartira de ce qui est en base
    // plutôt que d'afficher une page vide qui ferait croire à une perte.
    lectureCassee = true;
  }

  try {
    if (!Number.isFinite(idPage) || idPage <= 0)
      throw new Error("Cette page n'a pas pu être retrouvée.");
    if (lectureCassee)
      throw new Error(
        "Le contenu de la page n'a pas pu être relu par le navigateur. " +
          "Rien n'a été enregistré. Rechargez l'écran et reprenez vos " +
          "modifications.",
      );
    if (!titre) throw new Error("Donnez un nom à la page.");
    if (!adresse) throw new Error("Écrivez l'adresse de la page.");
    if (!ADRESSE_VALIDE.test(adresse))
      throw new Error(
        `L'adresse « ${adresse} » ne convient pas : elle ne peut contenir que ` +
          "des lettres minuscules sans accent, des chiffres et des traits " +
          "d'union, sans espace ni barre oblique.",
      );
    if (statut !== "active" && statut !== "draft")
      throw new Error("Indiquez si la page est en ligne ou en brouillon.");

    const blocs = verifierBlocs(souples);
    await api.enregistrerPage(idPage, {
      title: titre,
      slug: adresse,
      status: statut,
      seoTitle: seoTitre || null,
      seoDescription: seoDescription || null,
      blocks: blocs,
    });
    flash =
      statut === "active"
        ? "Page enregistrée. Elle est en ligne sur le site."
        : "Page enregistrée. Elle reste en brouillon : personne ne la voit encore.";
  } catch (e) {
    flash = String(e).replace(/^Error:\s*/, "");
    flashErreur = true;
    saisie = lectureCassee
      ? null
      : { titre, adresse, statut, seoTitre, seoDescription, blocs: souples };
  }
}

let donnees: PageCms | null = null;
let erreur: string | null = null;
try {
  donnees = await api.page(idPage);
} catch (e) {
  erreur = String(e).replace(/^Error:\s*/, "");
}

const page = donnees?.page ?? null;
// Ce que la grille de produits sait viser. Les formes sont écrites ici parce
// que ces deux listes n'existent que pour remplir deux listes déroulantes :
// l'écran ne veut rien savoir de plus d'une collection ou d'une catégorie.
const collections: { id: number; slug: string; name: string }[] =
  donnees?.collections ?? [];
const categories: { id: number; name: string }[] = donnees?.categories ?? [];

const titre = saisie?.titre ?? page?.title ?? "";
const adresse = saisie?.adresse ?? page?.slug ?? "";
const statut = saisie?.statut ?? page?.status ?? "draft";
const seoTitre = saisie?.seoTitre ?? page?.seoTitle ?? "";
const seoDescription = saisie?.seoDescription ?? page?.seoDescription ?? "";
const blocsAffiches: BlocSouple[] = saisie?.blocs ?? blocsSouples(page?.blocks);

/**
 * La réserve : un exemplaire vide de chaque type, plus quelques blocs de
 * texte. Les quatre premiers servent de patron, recopié à chaque ajout ; les
 * blocs de texte, eux, sont pris un par un, parce que leur éditeur ne se
 * recopie pas (voir l'en-tête du fichier).
 */
const TEXTES_EN_RESERVE = 6;
const reserve: BlocSouple[] = [
  blocVide("titre"),
  blocVide("image"),
  blocVide("produits"),
  blocVide("bouton"),
  ...Array.from({ length: TEXTES_EN_RESERVE }, () => blocVide("texte")),
];

/** Rendus dans le même moule : l'écran d'abord, la réserve ensuite. */
const aRendre = [
  ...blocsAffiches.map((bloc) => ({ bloc, enReserve: false })),
  ...reserve.map((bloc) => ({ bloc, enReserve: true })),
];

/** L'état de départ du champ caché, pour ne rien perdre si le script tarde. */
const blocsJson = JSON.stringify(
  blocsAffiches.map((b) =>
    b.type === "titre"
      ? { type: b.type, texte: b.texte, niveau: b.niveau }
      : b.type === "texte"
        ? { type: b.type, html: b.html }
        : b.type === "image"
          ? { type: b.type, url: b.url, alt: b.alt, legende: b.legende }
          : b.type === "produits"
            ? {
                type: b.type,
                source: b.source,
                reference: b.reference,
                limite: b.limite,
              }
            : { type: b.type, texte: b.texte, href: b.href },
  ),
);

const champ =
  "mt-1 w-full rounded border border-bo-border bg-bo-surface px-3 py-2 text-sm";
const boutonPrincipal =
  "rounded bg-bo-accent px-4 py-2 text-sm text-white hover:opacity-90";
const boutonDiscret =
  "rounded border border-bo-border bg-bo-surface px-3 py-1.5 text-sm hover:bg-bo-bg";
const boutonOutil =
  "flex h-7 w-7 items-center justify-center rounded border border-bo-border text-bo-muted hover:bg-bo-bg";
---

<Admin title={page?.title ?? "Page"}>
  <p class="mb-4">
    <a href={url("/pages")} class="text-sm text-bo-accent hover:underline">
      ← Retour aux pages
    </a>
  </p>

  {Astro.url.searchParams.get("cree") === "1" && (
    <p class="mb-4 rounded border border-green-200 bg-green-50 px-3 py-2 text-sm">
      Page créée. Elle est en brouillon : ajoutez son contenu ci-dessous, puis
      mettez-la en ligne quand elle vous convient.
    </p>
  )}

  {flash && (
    <p
      class={`mb-4 rounded border px-3 py-2 text-sm ${
        flashErreur ? "bg-red-50 border-red-200" : "bg-green-50 border-green-200"
      }`}
    >
      {flash}
    </p>
  )}
  {erreur && (
    <p class="mb-4 text-sm text-red-600">
      Cette page n'a pas pu être lue : {erreur}
    </p>
  )}

  {page && (
    <form method="POST" id="form-page" class="space-y-6">
      {/* =============================================================== */}
      {/* En-tête : le nom, l'adresse, l'état                             */}
      {/* =============================================================== */}
      <section class="rounded-lg border border-bo-border bg-bo-surface p-5">
        <div class="grid grid-cols-1 gap-4 lg:grid-cols-3">
          <label class="block lg:col-span-2">
            <span class="text-sm font-medium">Nom de la page</span>
            <input name="title" value={titre} required class={champ} />
            <span class="mt-1 block text-xs text-bo-muted">
              Le titre que vos clients voient en haut de la page.
            </span>
          </label>

          <label class="block">
            <span class="text-sm font-medium">Cette page est</span>
            <select name="status" class={champ}>
              <option value="active" selected={statut === "active"}>
                En ligne
              </option>
              <option value="draft" selected={statut !== "active"}>
                Brouillon
              </option>
            </select>
            <span class="mt-1 block text-xs text-bo-muted">
              Un brouillon n'est visible que d'ici. Rien n'apparaît sur le site
              tant que la page n'est pas en ligne.
            </span>
          </label>
        </div>

        <div class="mt-4">
          <span class="text-sm font-medium">Adresse de la page</span>
          <span class="mt-1 flex flex-wrap items-center gap-1">
            <span class="text-sm text-bo-muted">{NOM_DU_SITE}/</span>
            <input
              name="slug"
              value={adresse}
              required
              class="w-64 rounded border border-bo-border bg-bo-surface px-3 py-2 font-mono text-sm"
            />
          </span>
          <span class="mt-1 block text-xs text-bo-muted">
            L'adresse où la page sera visible, par exemple {NOM_DU_SITE}/magnets.
            La changer casse les liens déjà partagés vers cette page : ne le
            faites que si son nom a vraiment changé.
          </span>
        </div>

        <div class="mt-4 flex flex-wrap items-center gap-3">
          <button class={boutonPrincipal}>Enregistrer</button>
          {statut === "active" && adresse && (
            <a
              href={`${ORIGINE_PUBLIQUE}/${adresse}`}
              target="_blank"
              rel="noopener"
              class={boutonDiscret}
            >
              Voir la page sur le site ↗
            </a>
          )}
        </div>
      </section>

      {/* =============================================================== */}
      {/* Le contenu, bloc par bloc                                       */}
      {/* =============================================================== */}
      <section>
        <h3 class="mb-1 font-semibold">Contenu de la page</h3>
        <p class="mb-4 max-w-3xl text-sm text-bo-muted">
          Les blocs s'affichent sur le site dans l'ordre où ils sont ici. Les
          flèches les déplacent, la croix les enlève.
        </p>

        <input type="hidden" name="blocs" id="champ-blocs" value={blocsJson} />

        <div id="liste-blocs" class="space-y-4">
          {aRendre.map(({ bloc, enReserve }, i) => (
            <article
              data-bloc={bloc.type}
              data-reserve={enReserve ? "1" : undefined}
              hidden={enReserve}
              style={enReserve ? "display:none" : undefined}
              class="overflow-hidden rounded-lg border border-bo-border bg-bo-surface"
            >
              <header class="flex items-center justify-between gap-2 border-b border-bo-border bg-bo-bg px-4 py-2">
                <span class="text-sm font-medium">
                  <span data-numero class="text-bo-muted"></span>
                  {NOM_BLOC[bloc.type]}
                </span>
                <span class="flex items-center gap-1">
                  <button
                    type="button"
                    data-action="monter"
                    class={boutonOutil}
                    title="Monter ce bloc"
                    aria-label="Monter ce bloc"
                  >
                    ↑
                  </button>
                  <button
                    type="button"
                    data-action="descendre"
                    class={boutonOutil}
                    title="Descendre ce bloc"
                    aria-label="Descendre ce bloc"
                  >
                    ↓
                  </button>
                  <button
                    type="button"
                    data-action="supprimer"
                    class={`${boutonOutil} hover:border-red-300 hover:text-red-700`}
                    title="Supprimer ce bloc"
                    aria-label="Supprimer ce bloc"
                  >
                    ✕
                  </button>
                </span>
              </header>

              <div class="space-y-3 p-4">
                {bloc.type === "titre" && (
                  <div class="flex flex-wrap items-end gap-3">
                    <label class="block min-w-[16rem] flex-1">
                      <span class="text-xs text-bo-muted">Titre</span>
                      <input
                        data-valeur="texte"
                        value={bloc.texte}
                        placeholder="Nos magnets"
                        class={champ}
                      />
                    </label>
                    <label class="block">
                      <span class="text-xs text-bo-muted">Taille</span>
                      <select data-valeur="niveau" class={champ}>
                        <option value="2" selected={bloc.niveau !== "3"}>
                          Grand titre
                        </option>
                        <option value="3" selected={bloc.niveau === "3"}>
                          Petit titre
                        </option>
                      </select>
                    </label>
                  </div>
                )}

                {bloc.type === "texte" && (
                  <EditeurTexte
                    nom={`texte-bloc-${i}`}
                    valeur={bloc.html}
                    invite="Écrivez ici. Les boutons du dessus mettent en gras, en italique, en liste."
                    etiquette="Texte du bloc"
                  />
                )}

                {bloc.type === "image" && (
                  <>
                    <div class="flex flex-wrap items-start gap-4">
                      <img
                        data-apercu
                        src={bloc.url ? imgSrc(bloc.url) : undefined}
                        alt=""
                        class={`h-24 w-24 rounded border border-bo-border object-cover ${
                          bloc.url ? "" : "hidden"
                        }`}
                      />
                      <div class="min-w-[14rem] flex-1">
                        <span class="text-xs text-bo-muted">Image</span>
                        <input
                          type="file"
                          accept="image/*"
                          data-fichier
                          class="mt-1 block w-full text-sm"
                        />
                        <p data-etat-envoi class="mt-1 text-xs text-bo-muted"></p>
                      </div>
                    </div>
                    <input type="hidden" data-valeur="url" value={bloc.url} />
                    <label class="block">
                      <span class="text-xs text-bo-muted">
                        Texte de remplacement
                      </span>
                      <input
                        data-valeur="alt"
                        value={bloc.alt}
                        placeholder="Un magnet posé sur un frigo"
                        class={champ}
                      />
                      <span class="mt-1 block text-xs text-bo-muted">
                        Ce que lit à voix haute le téléphone d'une personne qui
                        ne voit pas l'image. C'est aussi ce qui s'affiche si
                        l'image ne se charge pas.
                      </span>
                    </label>
                    <label class="block">
                      <span class="text-xs text-bo-muted">
                        Légende (facultatif)
                      </span>
                      <input
                        data-valeur="legende"
                        value={bloc.legende}
                        class={champ}
                      />
                      <span class="mt-1 block text-xs text-bo-muted">
                        Une petite phrase affichée sous l'image, sur le site.
                      </span>
                    </label>
                  </>
                )}

                {bloc.type === "produits" && (
                  <>
                    <div class="flex flex-wrap items-end gap-3">
                      <label class="block">
                        <span class="text-xs text-bo-muted">
                          La grille montre
                        </span>
                        <select data-valeur="source" class={champ}>
                          <option
                            value="collection"
                            selected={bloc.source !== "categorie"}
                          >
                            Une collection
                          </option>
                          <option
                            value="categorie"
                            selected={bloc.source === "categorie"}
                          >
                            Une catégorie de produits
                          </option>
                        </select>
                      </label>

                      <label
                        data-choix="collection"
                        class={`block min-w-[14rem] flex-1 ${
                          bloc.source === "categorie" ? "hidden" : ""
                        }`}
                      >
                        <span class="text-xs text-bo-muted">Collection</span>
                        <select data-ref="collection" class={champ}>
                          {collections.map((c) => (
                            <option
                              value={c.slug}
                              selected={
                                bloc.source !== "categorie" &&
                                bloc.reference === c.slug
                              }
                            >
                              {c.name}
                            </option>
                          ))}
                        </select>
                      </label>

                      <label
                        data-choix="categorie"
                        class={`block min-w-[14rem] flex-1 ${
                          bloc.source === "categorie" ? "" : "hidden"
                        }`}
                      >
                        <span class="text-xs text-bo-muted">Catégorie</span>
                        <select data-ref="categorie" class={champ}>
                          {categories.map((c) => (
                            <option
                              value={String(c.id)}
                              selected={
                                bloc.source === "categorie" &&
                                bloc.reference === String(c.id)
                              }
                            >
                              {c.name}
                            </option>
                          ))}
                        </select>
                      </label>

                      <label class="block">
                        <span class="text-xs text-bo-muted">
                          Nombre d'articles
                        </span>
                        <input
                          type="number"
                          min="1"
                          max={LIMITE_MAX}
                          step="1"
                          data-valeur="limite"
                          value={bloc.limite}
                          class="mt-1 w-24 rounded border border-bo-border bg-bo-surface px-3 py-2 text-sm"
                        />
                      </label>
                    </div>
                    {collections.length === 0 && categories.length === 0 && (
                      <p class="text-xs text-amber-800">
                        Aucune collection ni catégorie n'existe encore : la
                        grille n'aurait rien à montrer.
                      </p>
                    )}
                    <p class="text-xs text-bo-muted">
                      Le site affiche les articles avec leur image et leur prix.
                      Ajoutez ou retirez un produit de la collection et la
                      grille suit toute seule.
                    </p>
                  </>
                )}

                {bloc.type === "bouton" && (
                  <div class="flex flex-wrap items-end gap-3">
                    <label class="block min-w-[14rem] flex-1">
                      <span class="text-xs text-bo-muted">
                        Ce qui est marqué dessus
                      </span>
                      <input
                        data-valeur="texte"
                        value={bloc.texte}
                        placeholder="Voir tous les magnets"
                        class={champ}
                      />
                    </label>
                    <label class="block min-w-[14rem] flex-1">
                      <span class="text-xs text-bo-muted">
                        Où il emmène
                      </span>
                      <input
                        data-valeur="href"
                        value={bloc.href}
                        placeholder="/magnets"
                        class={champ}
                      />
                      <span class="mt-1 block text-xs text-bo-muted">
                        Une page du site commence par une barre oblique
                        (/magnets). Un autre site commence par https://.
                      </span>
                    </label>
                  </div>
                )}
              </div>
            </article>
          ))}
        </div>

        {/* Les blocs vides mis de côté au chargement : ils vivent ici, hors
            de la liste, pour ne partir ni à l'écran ni à l'enregistrement. */}
        <div id="reserve" hidden></div>

        <p id="liste-vide" class="mt-4 hidden text-sm text-bo-muted">
          Cette page est encore vide. Ajoutez un premier bloc ci-dessous.
        </p>

        <div class="mt-4 rounded-lg border border-dashed border-bo-border bg-bo-surface p-4">
          <p class="mb-2 text-sm font-medium">Ajouter un bloc</p>
          <div class="flex flex-wrap gap-2">
            {TYPES_BLOCS.map((t) => (
              <button type="button" data-ajouter={t} class={boutonDiscret}>
                + {NOM_BLOC[t]}
              </button>
            ))}
          </div>
        </div>
      </section>

      {/* =============================================================== */}
      {/* Référencement                                                   */}
      {/* =============================================================== */}
      <section class="rounded-lg border border-bo-border bg-bo-surface p-5">
        <h3 class="mb-1 font-semibold">Référencement</h3>
        <p class="mb-4 max-w-3xl text-sm text-bo-muted">
          Ce qu'un moteur de recherche montre quand quelqu'un tombe sur cette
          page. Laissez les deux champs vides et le site reprend le nom de la
          page.
        </p>
        <div class="space-y-4">
          <label class="block">
            <span class="text-sm font-medium">Titre de la page</span>
            <input
              name="seoTitle"
              value={seoTitre}
              placeholder={titre}
              class={champ}
            />
          </label>
          <label class="block">
            <span class="text-sm font-medium">Description pour les moteurs</span>
            <textarea
              name="seoDescription"
              rows="3"
              placeholder="Des magnets à personnaliser avec vos personnages, à poser sur le frigo."
              class={champ}>{seoDescription}</textarea>
            <span class="mt-1 block text-xs text-bo-muted">
              Deux phrases, pas plus : c'est le petit texte gris sous le titre,
              dans les résultats de recherche.
            </span>
          </label>
        </div>
      </section>

      <div class="flex flex-wrap items-center gap-3">
        <button class={boutonPrincipal}>Enregistrer</button>
        <a href={url("/pages")} class={boutonDiscret}>Retour aux pages</a>
      </div>
    </form>
  )}

  <script
    is:inline
    define:vars={{ PUBLIC_API_URL, TEXTES_EN_RESERVE, NOM_BLOC }}
  >
    const formulaire = document.getElementById("form-page");
    const liste = document.getElementById("liste-blocs");
    const reserve = document.getElementById("reserve");
    const champBlocs = document.getElementById("champ-blocs");
    const listeVide = document.getElementById("liste-vide");

    if (formulaire && liste && reserve && champBlocs) {
      // Les blocs vides rendus par le serveur sortent de la liste avant tout
      // le reste : déplacés et non recopiés, les éditeurs de texte qu'ils
      // contiennent gardent leur barre de mise en forme.
      liste
        .querySelectorAll("[data-reserve]")
        .forEach((n) => reserve.appendChild(n));

      const blocsDeLaListe = () =>
        Array.prototype.slice.call(liste.children).filter((n) =>
          n.hasAttribute("data-bloc"),
        );

      function renumeroter() {
        const blocs = blocsDeLaListe();
        blocs.forEach((n, i) => {
          const numero = n.querySelector("[data-numero]");
          if (numero) numero.textContent = i + 1 + ". ";
        });
        if (listeVide) listeVide.classList.toggle("hidden", blocs.length > 0);
      }

      /** La valeur d'un champ du bloc, ou "" s'il n'existe pas dans ce type. */
      function lire(bloc, cle) {
        const el = bloc.querySelector('[data-valeur="' + cle + '"]');
        return el ? String(el.value == null ? "" : el.value) : "";
      }

      function serialiser() {
        const sortie = [];
        blocsDeLaListe().forEach((n) => {
          const type = n.getAttribute("data-bloc");
          if (type === "titre") {
            sortie.push({
              type,
              texte: lire(n, "texte"),
              niveau: lire(n, "niveau"),
            });
          } else if (type === "texte") {
            // Le champ caché de l'éditeur visuel porte déjà le texte nettoyé.
            const cache = n.querySelector("[data-champ]");
            sortie.push({ type, html: cache ? cache.value : "" });
          } else if (type === "image") {
            sortie.push({
              type,
              url: lire(n, "url"),
              alt: lire(n, "alt"),
              legende: lire(n, "legende"),
            });
          } else if (type === "produits") {
            const source =
              lire(n, "source") === "categorie" ? "categorie" : "collection";
            const choix = n.querySelector('[data-ref="' + source + '"]');
            sortie.push({
              type,
              source,
              reference: choix ? String(choix.value || "") : "",
              limite: lire(n, "limite"),
            });
          } else if (type === "bouton") {
            sortie.push({
              type,
              texte: lire(n, "texte"),
              href: lire(n, "href"),
            });
          }
        });
        champBlocs.value = JSON.stringify(sortie);
      }

      /** La liste déroulante visible suit le choix collection / catégorie. */
      function accorderProduits(bloc) {
        const source = lire(bloc, "source");
        bloc.querySelectorAll("[data-choix]").forEach((l) => {
          l.classList.toggle(
            "hidden",
            l.getAttribute("data-choix") !== source,
          );
        });
      }

      liste.addEventListener("change", (ev) => {
        const bloc = ev.target.closest("[data-bloc]");
        if (bloc && bloc.getAttribute("data-bloc") === "produits")
          accorderProduits(bloc);
      });

      liste.addEventListener("click", (ev) => {
        const bouton = ev.target.closest("[data-action]");
        if (!bouton) return;
        const bloc = bouton.closest("[data-bloc]");
        if (!bloc) return;
        const action = bouton.getAttribute("data-action");
        if (action === "monter") {
          const avant = bloc.previousElementSibling;
          if (avant) liste.insertBefore(bloc, avant);
        } else if (action === "descendre") {
          const apres = bloc.nextElementSibling;
          if (apres) liste.insertBefore(apres, bloc);
        } else if (action === "supprimer") {
          const quoi = NOM_BLOC[bloc.getAttribute("data-bloc")] || "ce bloc";
          if (!confirm("Supprimer le bloc « " + quoi + " » ?")) return;
          bloc.remove();
        }
        renumeroter();
      });

      // --- Ajouter un bloc ---
      document.querySelectorAll("[data-ajouter]").forEach((bouton) => {
        bouton.addEventListener("click", () => {
          const type = bouton.getAttribute("data-ajouter");
          const modele = reserve.querySelector('[data-bloc="' + type + '"]');
          if (!modele) {
            // Seuls les blocs de texte s'épuisent : les autres se recopient.
            alert(
              type === "texte"
                ? "Vous avez ajouté " +
                    TEXTES_EN_RESERVE +
                    " blocs de texte d'un coup. Enregistrez la page pour " +
                    "pouvoir en ajouter d'autres."
                : "Ce bloc n'a pas pu être ajouté. Rechargez l'écran et " +
                    "réessayez.",
            );
            return;
          }
          // Un bloc de texte est DÉPLACÉ hors de la réserve : son éditeur ne
          // survivrait pas à une copie. Les autres sont recopiés, la réserve
          // garde donc son exemplaire pour l'ajout suivant.
          const neuf = type === "texte" ? modele : modele.cloneNode(true);
          neuf.removeAttribute("data-reserve");
          neuf.removeAttribute("hidden");
          neuf.removeAttribute("style");
          liste.appendChild(neuf);
          if (type === "produits") accorderProduits(neuf);
          renumeroter();
          neuf.scrollIntoView({ behavior: "smooth", block: "center" });
          const premier = neuf.querySelector(
            "input:not([type=hidden]), select, [contenteditable]",
          );
          if (premier) premier.focus();
        });
      });

      // --- Choix d'une image ---
      // Le fichier part tout de suite vers l'API, qui répond par son adresse :
      // le bloc n'a plus qu'à la retenir. Rien n'est enregistré pour autant,
      // la page ne bouge qu'au clic sur « Enregistrer ».
      liste.addEventListener("change", async (ev) => {
        const entree = ev.target.closest("[data-fichier]");
        if (!entree) return;
        const bloc = entree.closest("[data-bloc]");
        if (!bloc) return;
        const fichier = entree.files && entree.files[0];
        if (!fichier) return;
        const etat = bloc.querySelector("[data-etat-envoi]");
        const apercu = bloc.querySelector("[data-apercu]");
        const cache = bloc.querySelector('[data-valeur="url"]');
        if (etat) {
          etat.className = "mt-1 text-xs text-bo-muted";
          etat.textContent = "Envoi de " + fichier.name + "…";
        }
        try {
          const donnees = new FormData();
          donnees.append("file", fichier);
          const reponse = await fetch(PUBLIC_API_URL + "/admin/uploads", {
            method: "POST",
            credentials: "include",
            body: donnees,
          });
          const corps = await reponse.json().catch(() => ({}));
          if (!reponse.ok)
            throw new Error(
              corps.error || "l'envoi a échoué (" + reponse.status + ")",
            );
          if (cache) cache.value = corps.url;
          if (apercu) {
            apercu.src = String(corps.url).startsWith("http")
              ? corps.url
              : PUBLIC_API_URL + corps.url;
            apercu.classList.remove("hidden");
          }
          if (etat) {
            etat.className = "mt-1 text-xs text-green-700";
            etat.textContent =
              "Image ajoutée. Enregistrez la page pour la publier.";
          }
        } catch (e) {
          if (etat) {
            etat.className = "mt-1 text-xs text-red-600";
            etat.textContent = "Image non ajoutée : " + e;
          }
        }
      });

      formulaire.addEventListener("submit", serialiser);
      liste
        .querySelectorAll('[data-bloc="produits"]')
        .forEach(accorderProduits);
      renumeroter();
    }
  </script>
</Admin>
