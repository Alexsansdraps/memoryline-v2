---
/**
 * Fiche d'une commande.
 *
 * Deux colonnes, comme dans Shopify : à GAUCHE ce qu'on FAIT (expédier,
 * rembourser, commenter), à DROITE ce qu'on CONSULTE (le client, ses adresses,
 * les notes, les étiquettes). La séparation n'est pas cosmétique — elle évite
 * de chercher le bouton d'expédition au milieu d'une adresse.
 *
 * Aucun statut n'est stocké ici : ils viennent tous de l'API, calculés à
 * partir des expéditions et des remboursements enregistrés.
 */
import { apiUrl, url } from "../../lib/url.ts";
import {
  ANNONCE_COURRIER,
  ETAPES_DU_PARCOURS,
  FUSEAU_BOUTIQUE,
  libelleEtape,
  libelleFormat,
  passageEtape,
  rangEtape,
  tonEtape,
  type EtapeTraitement,
  type ParcoursTraitement,
} from "@memoryline/types";
import Admin from "../../layouts/Admin.astro";
import AffichesCommande from "../../components/AffichesCommande.astro";
import ChampsAdresse from "../../components/ChampsAdresse.astro";
import {
  adminApi,
  formatPrice,
  lignesDeLAffiche,
  type EtatBordereau,
  type OrderDetail,
} from "../../lib/api.ts";

const id = Number(Astro.params.id);
const api = adminApi(Astro.request);

/**
 * Un vendeur ouvre aussi cette fiche, pour les ventes de ses stands : il y
 * lit les affiches, les lignes, le client, et télécharge les fichiers
 * d'impression. Rien d'autre — aucun formulaire, aucun bordereau, aucune
 * facture. L'API ne lui rend de toute façon que les commandes de ses stands
 * (vendeurs.ts) et refuse toute écriture ; la fiche lui épargne seulement
 * des boutons qui répondraient « interdit ».
 */
const estProprietaire = Astro.locals.user?.role === "owner";

let flash: string | null = null;
let flashErreur = false;

if (Astro.request.method === "POST" && estProprietaire) {
  const f = await Astro.request.formData();
  const action = f.get("_action");
  try {
    if (action === "etape") {
      // La frise (17/11) : UN statut, en étapes. L'API décide de ce qui part
      // (expéditions, courriel) et refuse ce qui ne se fait pas.
      const r = await api.changerEtape(id, {
        etape: String(f.get("etape") ?? ""),
        carrier: String(f.get("carrier") ?? ""),
        trackingNumber: String(f.get("trackingNumber") ?? ""),
        auteur: Astro.locals.user?.email ?? undefined,
      });
      const nom = libelleEtape(r.etape as EtapeTraitement, r.parcours as ParcoursTraitement);
      flash = r.inchange
        ? `La commande est déjà « ${nom} ».`
        : `Commande passée à « ${nom} ».` +
          (r.courrier
            ? r.courrier.parti
              ? ` Courriel « ${r.courrier.sujet} » envoyé à ${r.courrier.email}.`
              : ` Le courriel « ${r.courrier.sujet} » n'a PAS pu partir vers ${r.courrier.email}.`
            : "");
    } else if (action === "archiver-commande") {
      const restaurer = String(f.get("archived") ?? "") === "false";
      await api.archiverCommande(id, !restaurer);
      if (restaurer) {
        flash = "Commande restaurée : elle revient dans la liste ordinaire.";
      } else {
        // Un retour à la liste des archivées plutôt qu'un rendu : la commande
        // vient de quitter la liste ordinaire, et c'est là qu'on la retrouve.
        return Astro.redirect(`${url("/commandes")}?onglet=archivees`);
      }
    } else if (action === "supprimer-commande") {
      // Un panier, une commande jamais payée, ou une vente du stand (même
      // payée, 19/11), sans passer par les archivées (commandes.ts,
      // motifCommandeAGarder). Un refus s'affiche tel quel, sans « Erreur : » ;
      // la commande reste.
      const numero = String(f.get("numero") ?? "");
      const venteDuStand = f.get("canal") === "salon";
      let refus: string | null = null;
      try {
        await api.supprimerCommande(id);
      } catch (e) {
        refus = e instanceof Error ? e.message : String(e);
      }
      if (refus) {
        flash = refus;
        flashErreur = true;
      } else {
        // La fiche n'existe plus : retour à l'onglet d'où l'on venait, qui
        // redit ce qui vient de partir.
        return Astro.redirect(
          `${url(venteDuStand ? "/ventes-salon" : "/commandes")}?supprimee=${encodeURIComponent(numero)}`,
        );
      }
    } else if (action === "annuler-expedition") {
      await api.cancelFulfillment(Number(f.get("fulfillmentId")));
      flash = "Expédition annulée.";
    } else if (action === "rembourser") {
      // UN SEUL endroit pour rendre de l'argent (Alexandra, 17/11 : « il faut
      // un seul endroit, par défaut le champ rembourse tout, on peut mettre un
      // pourcentage ou un chiffre libre »). Le montant part en euros ou en
      // pourcentage du reste ; tout le reste, c'est « tout rembourser », par
      // les articles (chaque ligne marquée rendue). La case « Annuler aussi la
      // commande » fait l'annulation dans le même geste.
      const resteCents = Math.max(0, Number(f.get("resteCents")) || 0);
      const saisi = Number(String(f.get("montant") ?? "").replace(",", "."));
      const montantCents =
        f.get("unite") === "pct"
          ? Math.round((resteCents * Math.min(100, Math.max(0, saisi || 0))) / 100)
          : Math.round((saisi || 0) * 100);
      const tout = resteCents > 0 && montantCents === resteCents;
      const viaPsp = f.get("viaPsp") === "on";
      const reason = String(f.get("reason") ?? "");
      const note = String(f.get("noteRemb") ?? "");
      const author = Astro.locals.user?.email ?? undefined;
      if (f.get("annulerAussi") === "on") {
        const motif = String(f.get("motif") ?? "");
        const motifLibre = String(f.get("motifLibre") ?? "");
        if (tout) {
          // Tout rendre et annuler : exactement l'annulation avec remboursement.
          const r = await api.annulerCommande(id, { motif, motifLibre, rembourser: true, viaPsp, note, author });
          flash = `Commande ${r.numero} annulée, ${formatPrice(r.rembourseCents)} remboursés.`;
        } else {
          const r1 = await api.refundOrder(id, { amountCents: montantCents, reason, note, viaPsp, author });
          const r2 = await api.annulerCommande(id, { motif, motifLibre, rembourser: false, note, author });
          flash =
            `Remboursement de ${formatPrice(r1.amountCents)} enregistré, commande ${r2.numero} annulée.` +
            (r2.resteADevoir > 0
              ? ` ${formatPrice(r2.resteADevoir)} restent encaissés : ils ne sont pas rendus au client.`
              : "");
        }
      } else {
        const r = await api.refundOrder(
          id,
          tout
            ? { tout: true, reason, note, viaPsp, author }
            : { amountCents: montantCents, reason, note, viaPsp, author },
        );
        flash = `Remboursement de ${formatPrice(r.amountCents)} enregistré.`;
      }
    } else if (action === "annuler") {
      const r = await api.annulerCommande(id, {
        motif: String(f.get("motif") ?? ""),
        motifLibre: String(f.get("motifLibre") ?? ""),
        // L'argent ne se rend plus d'ici : bloc « Rembourser » (17/11).
        rembourser: false,
        restock: f.get("restockAnnul") === "on",
        note: String(f.get("noteAnnul") ?? ""),
        author: Astro.locals.user?.email ?? undefined,
      });
      // Le mot rend compte de TOUT ce qui vient de se passer, y compris de ce
      // qui ne s'est pas passé : une commande payée annulée sans remboursement
      // laisse de l'argent à rendre, et c'est le seul moment où quelqu'un le
      // verra écrit.
      flash =
        `Commande ${r.numero} annulée.` +
        (r.rembourseCents > 0
          ? ` ${formatPrice(r.rembourseCents)} remboursés.`
          : "") +
        (r.resteADevoir > 0
          ? ` Attention : ${formatPrice(r.resteADevoir)} restent à rendre au client — aucun remboursement n'a été enregistré.`
          : "");
    } else if (action === "encaisser") {
      const r = await api.encaisserCommande(id, {
        moyen: String(f.get("moyen") ?? ""),
        reference: String(f.get("reference") ?? ""),
        author: Astro.locals.user?.email ?? undefined,
      });
      flash = r.deja
        ? (r.message ?? "Cette commande était déjà marquée payée.")
        : f.get("moyen") === "sur_place"
          ? // Une vente du stand (17/11) : aucun courrier ne part.
            `Vente du stand marquée payée : ${formatPrice(r.montantCents ?? 0)} réglés sur place.`
          : `Commande encaissée : ${formatPrice(r.montantCents ?? 0)} reçus par ${r.moyen}. La confirmation est partie chez le client. Les fichiers d'impression se préparent : leur état est en bas de la fiche.`;
    } else if (action === "envoyer-facture") {
      const r = await api.envoyerFacture(id, Astro.locals.user?.email ?? undefined);
      flash = `Facture ${r.numeroFacture} envoyée à ${r.destinataire}.`;
    } else if (action === "note") {
      await api.setOrderNote(id, String(f.get("note") || ""));
      flash = "Note enregistrée.";
    } else if (action === "etiquettes") {
      const tags = String(f.get("tags") ?? "")
        .split(",")
        .map((t) => t.trim())
        .filter(Boolean);
      await api.setOrderTags(id, tags);
      flash = "Étiquettes enregistrées.";
    } else if (action === "adresse") {
      // Seuls les champs PRÉSENTS dans le formulaire partent : celui du
      // bordereau d'un point relais n'a que le nom et le téléphone, et
      // l'adresse qu'il n'affiche pas ne doit pas s'effacer.
      const champs = [
        "shippingName",
        "shippingLine1",
        "shippingLine2",
        "shippingPostalCode",
        "shippingCity",
        "shippingCountry",
        "shippingPhone",
      ];
      const data: Record<string, string | boolean> = {};
      for (const c of champs) if (f.has(c)) data[c] = String(f.get(c) ?? "");
      const livrerALAdresse = f.get("livrerALAdresse") === "1";
      if (livrerALAdresse) data.livrerALAdresse = true;
      const r = await api.updateOrderAddress(id, {
        ...data,
        author: Astro.locals.user?.email ?? undefined,
      });
      flash = !r.modifie
        ? "Rien n'a changé : l'adresse était déjà celle-ci."
        : livrerALAdresse
          ? "Le colis partira à cette adresse, et non plus au point relais."
          : "Adresse mise à jour.";
      if (r.bordereauVivant) {
        flash +=
          " Attention : le bordereau déjà acheté porte encore l'ancienne adresse. Annulez-le, puis rachetez-en un.";
        flashErreur = true;
      }
    } else if (action === "acheter-bordereau") {
      const [methodeCode, prix] = String(f.get("methode") ?? "").split("|");
      const b = await api.acheterBordereau(id, {
        methodeCode: methodeCode ?? "",
        poidsGrammes: Number(f.get("poidsGrammes") ?? 0),
        prixAnnonceCents: prix === undefined || prix === "" ? null : Number(prix),
        cleDemande: String(f.get("cleDemande") ?? ""),
        auteur: Astro.locals.user?.email ?? undefined,
      });
      if (b.statut === "echec") {
        flash = `SendCloud a refusé le bordereau : ${b.erreur ?? "raison inconnue"}`;
        flashErreur = true;
      } else if (b.statut === "en_cours") {
        flash =
          "SendCloud n'a pas répondu à temps. Cliquez « Terminer l'achat » pour savoir s'il a été fait — sans risque d'en acheter deux.";
        flashErreur = true;
      } else {
        flash = b.essai
          ? "Bordereau d'ESSAI fabriqué (lettre non affranchie, gratuite) : ce n'est pas une étiquette valable chez le transporteur."
          : `Bordereau acheté : suivi ${b.trackingNumber ?? "en attente"}.`;
      }
    } else if (action === "terminer-bordereau") {
      const b = await api.terminerBordereau(id);
      flash =
        b.statut === "achete"
          ? `Achat terminé : suivi ${b.trackingNumber ?? "en attente"}.`
          : `SendCloud a refusé le bordereau : ${b.erreur ?? "raison inconnue"}`;
      flashErreur = b.statut !== "achete";
    } else if (action === "annuler-bordereau") {
      const r = await api.annulerBordereau(id, Astro.locals.user?.email ?? undefined);
      flash = r.message;
    } else if (action === "renvoyer") {
      await api.resendConfirmation(id);
      flash = "Confirmation renvoyée au client.";
    } else if (action === "commentaire") {
      const message = String(f.get("message") || "").trim();
      if (message) {
        await api.addOrderComment(
          id,
          message,
          Astro.locals.user?.email ?? undefined,
        );
        flash = "Commentaire publié.";
      }
    }
  } catch (e) {
    // Sans le « Error: » de String(e) : le message disait « Erreur : Error: … ».
    flash = "Erreur : " + String(e).replace(/^Error:\s*/, "");
    flashErreur = true;
  }
}

let detail: OrderDetail | null = null;
let error: string | null = null;
try {
  detail = await api.orderDetail(id);
} catch (e) {
  error = String(e);
}

const order = detail?.order;
/**
 * Les mentions obligatoires de la facture qui manquent encore (BO ›
 * Réglages › Factures). Une facture éditée sans elles les reprendra dès
 * qu'elles seront saisies (l'API ne fige pas un émetteur incomplet), mais
 * celle qui part par courriel aujourd'hui partirait sans : on le dit avant
 * le clic. Réservé à la propriétaire, seule à éditer les factures.
 */
let mentionsFactureManquantes: string[] = [];
if (order && estProprietaire && order.status !== "draft") {
  try {
    const r = await api.facturation();
    if (!r.adresse.trim()) mentionsFactureManquantes.push("l'adresse");
    if (!r.siret) mentionsFactureManquantes.push("le SIRET");
  } catch {
    // Sans réponse, on ne prétend rien : la fiche s'affiche comme avant.
  }
}
/** Où la cliente vient chercher sa commande, pour un retrait (voir l'API). */
const lieuRetrait = detail?.lieuRetrait ?? null;
const items = detail?.items ?? [];
const client = detail?.customer ?? null;
const expeditions = detail?.expeditions ?? [];
/**
 * Une commande prise au stand n'est pas expédiée : l'affiche est remise au
 * client, sur place. Pas de transporteur, pas de numéro de suivi — juste
 * « c'est fait ».
 */
const auStand = order?.channel === "salon";

/**
 * Le bordereau transporteur (SendCloud). Chargé à part : si SendCloud ne
 * répond pas, la fiche s'affiche quand même, avec le bloc qui le dit. Le poids
 * se corrige par l'adresse (?poids=…) : les prix dépendent de la tranche ;
 * ?tous=1 montre les services de tous les transporteurs.
 *
 * Pour TOUTE commande, ventes du stand comprises : une affiche commandée au
 * stand peut devoir voyager. Seul un panier n'a pas de bloc — ce n'est pas
 * une commande.
 */
const voirTous = Astro.url.searchParams.get("tous") === "1";
let etatBordereau: EtatBordereau | null = null;
let erreurBordereau: string | null = null;
if (order && order.status !== "draft" && estProprietaire) {
  try {
    const poids = Number(Astro.url.searchParams.get("poids"));
    etatBordereau = await api.bordereau(
      id,
      Number.isFinite(poids) && poids > 0 ? poids : undefined,
      voirTous,
    );
  } catch (e) {
    erreurBordereau = String(e).replace(/^Error: /, "");
  }
}
const bordereau = etatBordereau?.bordereau ?? null;
const bordereauActif = bordereau?.statut === "achete" ? bordereau : null;
const situation = etatBordereau?.situation ?? null;
const versPointRelais = situation?.destination === "point_relais";
const manquesDestinataire = (etatBordereau?.manques ?? []).filter(
  (m) => m.champ === "destinataire",
);
const manquesEmail = (etatBordereau?.manques ?? []).filter((m) => m.champ === "email");
/** La commande a-t-elle la moindre ligne d'adresse ? Sinon, on la « saisit ». */
const aUneAdresse = !!(
  order?.shippingLine1 ||
  order?.shippingPostalCode ||
  order?.shippingCity
);
/**
 * Une vente du stand repart en main propre, sauf si une vraie étiquette a été
 * achetée pour elle : elle s'expédie alors comme une commande du site, avec
 * son transporteur et son numéro de suivi.
 */
const remiseAuStand = auStand && !(bordereauActif && !bordereauActif.essai);

/**
 * Pourquoi aucun service n'est « celui qu'elle a payé », dit au-dessus de la
 * liste : sans cette phrase, une liste sans badge vert passe pour une panne.
 */
const SANS_ENVOI_PAYE: Record<string, string> = {
  retrait:
    "Le client avait choisi le retrait sur place : il n'a payé aucun envoi. L'étiquette est à la charge de la boutique, sauf si vous lui facturez le port à part.",
  stand:
    "Vente du stand : aucun envoi n'a été payé. L'étiquette est à la charge de la boutique, sauf si le port a été réglé à part.",
  inconnu:
    "Le mode de livraison de cette commande n'est relié à aucun transporteur (commande ancienne ou importée) : choisissez le service vous-même.",
};

/**
 * « Voir tous les services », et le retour à la liste courte. Le poids suit :
 * il a pu être corrigé, et les prix en dépendent.
 */
const lienAutresServices = `?${new URLSearchParams({
  ...(voirTous ? {} : { tous: "1" }),
  poids: String(etatBordereau?.poidsGrammes ?? ""),
}).toString()}#bordereau`;
const libelleAutresServices = voirTous
  ? `N'afficher que les services ${situation?.transporteurPaye ?? "du transporteur payé"}`
  : `Voir tous les services (${etatBordereau?.autresServices ?? 0} d'autres transporteurs)`;

/**
 * Les pays qu'on propose au clavier : ceux où la boutique expédie (comme sa
 * caisse), plus Monaco et l'Outre-mer, qui ont leur propre code. Tout autre
 * code à deux lettres reste accepté.
 */
const nomsPays = new Intl.DisplayNames(["fr"], { type: "region" });
const PAYS_PROPOSES = [
  "FR", "BE", "CH", "LU", "DE", "ES", "IT", "NL", "PT", "GB", "CA", "US",
  "MC", "GP", "MQ", "GF", "RE", "YT",
].map((code) => ({ code, nom: nomsPays.of(code) ?? code }));
/** Nom du transporteur tel que l'écrit le formulaire « Expédier ». */
const NOM_TRANSPORTEUR: Record<string, string> = {
  mondial_relay: "Mondial Relay",
  colissimo: "Colissimo",
  chronopost: "Chronopost",
};
const remboursements = detail?.remboursements ?? [];
const mouvements = detail?.mouvements ?? [];

/** « 27 août 2026 à 22:36 », à l'heure de Paris (dite, pas confiée à TZ). */
function quand(iso: string | null | undefined): string {
  if (!iso) return "";
  try {
    const d = new Date(iso);
    return `${d.toLocaleDateString("fr-FR", { day: "numeric", month: "long", year: "numeric", timeZone: FUSEAU_BOUTIQUE })} à ${d.toLocaleTimeString("fr-FR", { hour: "2-digit", minute: "2-digit", timeZone: FUSEAU_BOUTIQUE })}`;
  } catch {
    return "";
  }
}

const NOM_CANAL: Record<string, string> = {
  web: "Boutique en ligne",
  salon: "Ventes stand",
};

const BADGE_PAIEMENT: Record<string, { texte: string; classe: string }> = {
  paid: { texte: "Payée", classe: "bg-bo-bg text-bo-ink" },
  pending: {
    texte: "En attente de paiement",
    classe: "bg-amber-100 text-amber-900",
  },
  authorized: { texte: "Autorisée", classe: "bg-sky-100 text-sky-900" },
  partially_refunded: {
    texte: "Remboursée en partie",
    classe: "bg-violet-100 text-violet-900",
  },
  refunded: { texte: "Remboursée", classe: "bg-violet-100 text-violet-900" },
  voided: { texte: "Annulée", classe: "bg-bo-bg text-bo-muted" },
  draft: { texte: "Panier", classe: "bg-bo-bg text-bo-muted" },
};
const BADGE_TRAITEMENT: Record<string, { texte: string; classe: string }> = {
  fulfilled: { texte: "Traitée", classe: "bg-green-100 text-green-900" },
  partially_fulfilled: {
    texte: "Partiellement traitée",
    classe: "bg-orange-100 text-orange-900",
  },
  unfulfilled: { texte: "Non traitée", classe: "bg-amber-100 text-amber-900" },
};

/** Montants : la remise se déduit de ce qui a réellement été facturé. */
const sousTotal = items.reduce(
  (s, it) => s + it.unitPriceCents * it.quantity,
  0,
);
const nbArticles = items.reduce((s, it) => s + it.quantity, 0);
const port = order?.shippingCents ?? 0;
const total = order?.totalCents ?? 0;
const remise = Math.max(0, sousTotal + port - total);
const rembourse = detail?.rembourseCents ?? 0;
const portRemboursable = detail?.portRemboursableCents ?? 0;
const netEncaisse = total - rembourse;

/**
 * Les paiements arrivés chez le prestataire SANS avoir validé la commande :
 * un montant qui ne correspondait plus au panier (« montant_different »), ou
 * un second paiement sur une commande déjà payée (« en_trop »). L'argent est
 * à rendre. Affiché sous « Encaissé », il laissait croire que la commande
 * était réglée — juste au-dessus du bouton qui la marque payée.
 */
const STATUTS_A_REMBOURSER = ["montant_different", "en_trop"];
const aRembourser = (detail?.paiements ?? []).filter((p) =>
  STATUTS_A_REMBOURSER.includes(p.status ?? ""),
);
const paiement =
  (detail?.paiements ?? []).find((p) => p.status === "succeeded") ??
  (detail?.paiements ?? []).find(
    (p) => !STATUTS_A_REMBOURSER.includes(p.status ?? ""),
  );
const encaisse = order?.status === "paid";

const badgePaiement = BADGE_PAIEMENT[detail?.statutFinancier ?? "pending"]!;
const badgeTraitement =
  BADGE_TRAITEMENT[detail?.statutExpedition ?? "unfulfilled"]!;

/**
 * UN seul statut (exigence d'Alexandra, 17/11) : l'étape de traitement,
 * déduite par l'API (packages/types/src/traitement.ts). « Payée » et
 * « Traitée / Non traitée » ne s'affichent plus ; l'argent se lit dans le
 * bloc Paiement. Null : une reprise de Shopify, qui garde ses deux badges.
 */
const traitement = detail?.traitement ?? null;
const parcoursT = (traitement?.parcours ?? "livraison") as ParcoursTraitement;
const etapeT = (traitement?.etape ?? "panier") as EtapeTraitement;
const CLASSE_TON: Record<string, string> = {
  neutre: "bg-bo-bg text-bo-muted",
  a_faire: "bg-amber-100 text-amber-900",
  en_partie: "bg-orange-100 text-orange-900",
  en_cours: "bg-sky-100 text-sky-900",
  fait: "bg-green-100 text-green-900",
};
const badgeEtape = traitement
  ? {
      texte: libelleEtape(etapeT, parcoursT),
      // « À encaisser » est une chose à faire, pas un état neutre.
      classe: CLASSE_TON[etapeT === "a_encaisser" ? "a_faire" : tonEtape(etapeT)]!,
    }
  : null;
/** Un remboursement se dit à côté de l'étape : c'est de l'argent, pas une étape. */
const badgeRemboursement =
  detail?.statutFinancier === "refunded" || detail?.statutFinancier === "partially_refunded"
    ? BADGE_PAIEMENT[detail.statutFinancier]!
    : null;
/** Les étapes de la frise, avec ce que demanderait chacune depuis l'étape actuelle. */
const etapesFrise = traitement
  ? ETAPES_DU_PARCOURS[parcoursT].map((e) => ({
      etape: e,
      libelle: libelleEtape(e, parcoursT),
      rang: rangEtape(parcoursT, e)!,
      passage: passageEtape(parcoursT, etapeT, e, { bordereauReel: traitement.bordereauReel }),
    }))
  : [];
const rangActuel = traitement ? rangEtape(parcoursT, etapeT) : null;

/**
 * Payée avec les clés d'ESSAI alors que la boutique encaisse pour de vrai
 * (apps/api/src/paiements-reglages.ts, payeeEnEssai) : aucun argent n'est
 * arrivé. Après la bascule, rien d'autre sur la fiche ne la distinguerait
 * d'une vraie vente.
 */
const payeeEnEssai = detail?.payeeEnEssai
  ? `Payée en ESSAI (${detail.payeeEnEssai === "stripe" ? "Stripe test" : "PayPal sandbox"})`
  : null;

/** Ce qui reste à envoyer, et ce qui reste remboursable. */
const resteAExpedier = items.reduce((s, it) => s + (it.aExpedier ?? 0), 0);
const resteARembourser = items.reduce((s, it) => s + (it.aRembourser ?? 0), 0);

/**
 * La commande est-elle annulée ?
 *
 * On lit le statut brut plutôt que le badge : celui-ci range « annulée » et
 * « remboursée » au même endroit visuel, alors que les deux n'autorisent pas
 * du tout les mêmes gestes.
 */
const annulee = order?.status === "cancelled" || order?.status === "voided";

/**
 * Le panier n'est pas une commande. Elle ne s'encaisse pas, ne s'annule pas,
 * ne se facture pas — elle se reprend ou elle s'oublie.
 */
const estPanier = order?.status === "draft";

/** Peut-on encore encaisser un règlement arrivé hors du site ? */
const encaissableALaMain = !!order && !encaisse && !annulee && !estPanier && !auStand;
/** Une vente du stand pas encore réglée : un seul bouton, « réglé sur place » (17/11). */
const encaissableAuStand = !!order && !encaisse && !annulee && !estPanier && auStand;

/** Ce que l'annulation laisserait en suspens si elle ne remboursait pas. */
const resteSiPasRembourse = encaisse ? total - rembourse : 0;

/** Les motifs d'annulation, dans l'ordre où ils se présentent à l'esprit. */
const MOTIFS_ANNULATION = [
  ["cliente", "Demande du client"],
  ["rupture", "Rupture — article indisponible"],
  ["saisie", "Erreur de saisie"],
  ["impaye", "Paiement non reçu"],
  ["autre", "Autre (précisez)"],
];

/** Les moyens de règlement qui n'ont pas de prestataire. */
const MOYENS_HORS_LIGNE = [
  ["virement", "Virement bancaire"],
  ["cheque", "Chèque"],
  ["especes", "Espèces"],
  ["autre", "Autre"],
];

/** Transporteurs proposés — la saisie libre reste possible. */
const TRANSPORTEURS = [
  "Colissimo",
  "Mondial Relay",
  "Chronopost",
  "Remise en main propre",
];

const LIBELLE_MOUVEMENT: Record<string, string> = {
  sale: "Encaissement",
  authorization: "Autorisation",
  capture: "Capture",
  refund: "Remboursement",
  void: "Annulation",
};

/**
 * Le moyen de paiement, dit comme la boutique le dit.
 *
 * Les mêmes mots que la page Finances, à la virgule près : un même
 * encaissement lu à deux endroits ne doit pas porter deux noms. Sans cette
 * table, la fiche affichait le code de la base — « manuel », avec sa
 * minuscule et sans accent — au milieu de phrases écrites en français.
 */
const LIBELLE_MOYEN: Record<string, string> = {
  stripe: "Stripe",
  paypal: "PayPal",
  stand: "Réglé sur place",
  manuel: "À la main (virement, chèque, espèces)",
  // 17/11 : la part payée par une carte cadeau, et une commande à 0 €.
  carte_cadeau: "Carte cadeau",
  gratuit: "Commande gratuite (rien à encaisser)",
};

function libelleMoyen(v: string | null | undefined): string {
  if (!v) return "Moyen non renseigné";
  return LIBELLE_MOYEN[v] ?? v;
}

/**
 * Le lien vers le tableau de bord Stripe n'a de sens que pour un paiement
 * Stripe. Il s'affichait dès qu'une référence existait, si bien qu'un
 * virement encaissé à la main proposait d'aller chercher son numéro de
 * virement chez Stripe, où il n'a jamais été.
 */
const chezStripe = paiement?.provider === "stripe" ? paiement.externalRef : null;
---

<Admin
  title={order ? `Commande ${order.number}` : `Commande #${id}`}
  rubrique={auStand ? "/ventes-salon" : undefined}
>
  <p class="mb-4">
    {/* Le vendeur revient à SES ventes : la liste « /commandes » est celle
        du site, qui ne lui est pas ouverte. */}
    {/* Une vente du stand ramène aux ventes du stand (17/11), pas aux
        commandes en ligne. */}
    <a
      href={url(estProprietaire && !auStand ? "/commandes" : "/ventes-salon")}
      class="text-sm text-bo-accent hover:underline"
    >
      ← {!estProprietaire ? "Retour à vos ventes" : auStand ? "Retour aux ventes du stand" : "Retour aux commandes"}
    </a>
  </p>

  {flash && (
    <p
      class={`mb-4 text-sm rounded px-3 py-2 border ${
        flashErreur ? "bg-red-50 border-red-200" : "bg-green-50 border-green-200"
      }`}
    >
      {flash}
    </p>
  )}
  {error && (
    <p class="mb-4 text-red-600 text-sm">
      {estProprietaire
        ? `API injoignable : ${error}`
        : "Cette commande n'est pas une vente de vos stands, ou n'existe plus."}
    </p>
  )}

  {/* ================================================================ */}
  {/* La fiche d'un VENDEUR : la lecture seule                          */}
  {/* ================================================================ */}
  {order && !estProprietaire && (
    <>
      <div class="mb-6">
        <div class="flex flex-wrap items-center gap-2">
          <h2 class="text-xl font-semibold">{order.number}</h2>
          <span class={`rounded-full px-2 py-0.5 text-xs ${badgePaiement.classe}`}>
            {badgePaiement.texte}
          </span>
          <span class={`rounded-full px-2 py-0.5 text-xs ${badgeTraitement.classe}`}>
            {badgeTraitement.texte}
          </span>
        </div>
        <p class="mt-1 text-sm text-bo-muted">
          {quand(order.createdAt)} · {NOM_CANAL[order.channel] ?? order.channel}
        </p>
      </div>

      {annulee && (
        <p class="mb-6 rounded-lg border border-bo-border bg-bo-bg px-4 py-3 font-medium">
          Commande annulée{order.cancelledAt ? ` le ${quand(order.cancelledAt)}` : ""} :
          rien à imprimer ni à remettre.
        </p>
      )}

      <AffichesCommande items={items} />

      <div class="grid grid-cols-1 items-start gap-6 lg:grid-cols-3">
        {/* Les fichiers d'impression, une ligne par affiche. Ils ne se
            préparent qu'une fois la vente encaissée, comme pour la
            propriétaire. */}
        <section
          class="rounded-lg border border-bo-border bg-bo-surface lg:col-span-2"
          data-impression
          data-url-etat={apiUrl("/admin/print-files/etat")}
          data-preparer={encaisse ? "1" : undefined}
        >
          <header class="border-b border-bo-border px-4 py-3">
            <h3 class="font-medium">
              À imprimer
              <span class="ml-2 text-sm font-normal text-bo-muted">
                {nbArticles} article{nbArticles > 1 ? "s" : ""}
              </span>
            </h3>
          </header>
          <ul class="divide-y divide-bo-border text-sm">
            {items.map((it, rang) => (
              <li class="flex flex-wrap items-center gap-x-4 gap-y-1 px-4 py-3">
                <span class="font-medium">
                  Affiche {rang + 1} · {it.title ?? "Affiche personnalisée"}
                </span>
                <span class="text-bo-muted">
                  {[it.format ? libelleFormat(it.format) : null, `× ${it.quantity}`]
                    .filter(Boolean)
                    .join(" · ")}
                </span>
                {encaisse ? (
                  <>
                    <a
                      href={apiUrl(`/admin/print-files/${it.id}`)}
                      download
                      data-pdf-ligne={it.id}
                      data-pdf-libelle="long"
                      data-pdf-nom={`Affiche ${rang + 1} (${it.title ?? "affiche personnalisée"})`}
                      class="bo-pdf ml-auto text-bo-accent hover:underline"
                    >
                      Télécharger le PDF d'impression
                    </a>
                    <span
                      data-pdf-message={it.id}
                      class="bo-pdf-message basis-full"
                      aria-live="polite"
                    />
                  </>
                ) : (
                  <span class="ml-auto text-xs text-bo-muted">
                    Pas encore réglée : rien à imprimer.
                  </span>
                )}
              </li>
            ))}
          </ul>
          {encaisse && items.length > 1 && (
            <div
              class="flex flex-wrap items-center gap-x-3 gap-y-1 border-t border-bo-border px-4 py-3 text-sm"
              data-pdf-groupe
            >
              <a
                href={apiUrl(`/admin/orders/${order.id}/impression.zip`)}
                download
                data-pdf-tout
                data-pdf-lignes={items.map((it) => it.id).join(",")}
                class="bo-pdf rounded border border-bo-border bg-bo-surface px-3 py-1.5 hover:bg-bo-bg"
              >
                Tout télécharger (.zip)
              </a>
              <span data-pdf-messages class="bo-pdf-messages basis-full" aria-live="polite" />
            </div>
          )}
        </section>

        <section class="rounded-lg border border-bo-border bg-bo-surface px-4 py-3 text-sm">
          <h3 class="mb-2 font-medium">Client</h3>
          {client ? (
            <div class="space-y-1">
              <div>{client.name || "—"}</div>
              {client.email && <div class="text-bo-muted">{client.email}</div>}
            </div>
          ) : (
            <p class="text-bo-muted">Aucun client rattaché.</p>
          )}
          {order.shippingLabel && (
            <p class="mt-3 text-bo-muted">Livraison : {order.shippingLabel}</p>
          )}
          {lieuRetrait && (
            <p class="mt-1 text-bo-muted">
              Retrait : {lieuRetrait.nom}
              {lieuRetrait.adresse && (
                <span class="block whitespace-pre-line">{lieuRetrait.adresse}</span>
              )}
            </p>
          )}
        </section>
      </div>
    </>
  )}

  {order && estProprietaire && (
    <>
      {/* ============================================================== */}
      {/* En-tête                                                        */}
      {/* ============================================================== */}
      <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
        <div>
          <div class="flex flex-wrap items-center gap-2">
            <h2 class="text-xl font-semibold">{order.number}</h2>
            {badgeEtape ? (
              <span class={`rounded-full px-2.5 py-0.5 text-sm font-medium ${badgeEtape.classe}`}>
                {badgeEtape.texte}
              </span>
            ) : (
              <>
                <span class={`rounded-full px-2 py-0.5 text-xs ${badgePaiement.classe}`}>
                  {badgePaiement.texte}
                </span>
                <span class={`rounded-full px-2 py-0.5 text-xs ${badgeTraitement.classe}`}>
                  {badgeTraitement.texte}
                </span>
              </>
            )}
            {badgeEtape && badgeRemboursement && (
              <span class={`rounded-full px-2 py-0.5 text-xs ${badgeRemboursement.classe}`}>
                {badgeRemboursement.texte}
              </span>
            )}
            {payeeEnEssai && (
              <span
                class="rounded-full bg-amber-100 px-2 py-0.5 text-xs font-medium text-amber-900"
                title="Ce paiement a été fait avec les clés d'essai : aucun argent n'est arrivé. Ne pas expédier sans vérifier."
              >
                {payeeEnEssai} : aucun argent reçu
              </span>
            )}
            {/* Dit dès le titre que cette fiche vient du rangement : sans
                cela, on la croit dans la liste et on la cherche en vain. */}
            {order.archivedAt && (
              <span class="rounded-full bg-bo-bg px-2 py-0.5 text-xs text-bo-muted">
                Archivée
              </span>
            )}
          </div>
          <p class="mt-1 text-sm text-bo-muted">
            {quand(order.createdAt)} · {NOM_CANAL[order.channel] ?? order.channel}
            {order.legacyName && ` · ancien n° ${order.legacyName}`}
          </p>
          {/* Reprise de Shopify (17/11) : l'API refuse facture, courriels,
              étiquette, encaissement et remboursement. On le dit d'emblée. */}
          {order.number?.startsWith("SHOP-") && (
            <p class="mt-2 rounded border border-amber-300 bg-amber-50 px-3 py-1.5 text-xs text-amber-900">
              Commande reprise de l'ancienne boutique Shopify : elle y a été réglée,
              expédiée et facturée. Elle reste ici pour l'historique ; facture,
              courriels, étiquette et remboursement ne repartent pas d'ici.
            </p>
          )}
        </div>
        <div class="flex flex-wrap gap-2">
          <a
            href={url(`/commandes/bons?ids=${order.id}`)}
            target="_blank"
            class="rounded border border-bo-border bg-bo-surface px-3 py-2 text-sm hover:bg-bo-bg"
          >
            Bon de livraison
          </a>
          {/* La facture. Le premier clic lui donne son numéro, définitif ;
              les suivants rendent la même. Un panier n'a rien à facturer. */}
          {!estPanier && (
            <a
              href={apiUrl(`/admin/orders/${order.id}/facture.pdf`)}
              target="_blank"
              title={
                order.invoiceNumber
                  ? `Facture ${order.invoiceNumber}, éditée le ${quand(order.invoicedAt)}`
                  : "Cette commande n'a pas encore de facture. L'ouvrir lui attribuera son numéro, définitif."
              }
              class="rounded border border-bo-border bg-bo-surface px-3 py-2 text-sm hover:bg-bo-bg"
            >
              {order.invoiceNumber
                ? `Facture ${order.invoiceNumber}`
                : "Éditer la facture"}
            </a>
          )}
          {!estPanier && client?.email && (
            <form method="POST">
              <input type="hidden" name="_action" value="envoyer-facture" />
              <button class="rounded border border-bo-border bg-bo-surface px-3 py-2 text-sm hover:bg-bo-bg">
                Envoyer la facture
              </button>
            </form>
          )}
          {/* Rien à reconfirmer sur une commande annulée : la cliente vient
              justement de recevoir le contraire. */}
          {client?.email && !annulee && (
            <form method="POST">
              <input type="hidden" name="_action" value="renvoyer" />
              <button class="rounded border border-bo-border bg-bo-surface px-3 py-2 text-sm hover:bg-bo-bg">
                Renvoyer la confirmation
              </button>
            </form>
          )}
          {chezStripe && (
            <a
              href={`https://dashboard.stripe.com/payments/${chezStripe}`}
              target="_blank"
              rel="noopener"
              class="rounded border border-bo-border bg-bo-surface px-3 py-2 text-sm hover:bg-bo-bg"
            >
              Voir chez Stripe ↗
            </a>
          )}
        </div>
      </div>

      {/* Une commande annulée le dit en haut, avant tout le reste : c'est ce
          qui explique pourquoi les boutons d'expédition ont disparu, et sans
          ce bandeau leur absence passerait pour une panne. */}
      {annulee && (
        <div class="mb-6 rounded-lg border border-bo-border bg-bo-bg px-4 py-3">
          <p class="font-medium">
            Commande annulée{order.cancelledAt ? ` le ${quand(order.cancelledAt)}` : ""}.
          </p>
          {order.cancelReason && (
            <p class="mt-0.5 text-sm text-bo-muted">Motif : {order.cancelReason}</p>
          )}
          <p class="mt-1 text-sm text-bo-muted">
            Elle reste lisible et garde son histoire, mais elle ne compte plus
            dans vos chiffres et ne peut plus rien expédier.
            {encaisse && rembourse < total && (
              <>
                {" "}
                <strong class="font-medium text-red-800">
                  {formatPrice(total - rembourse)} restent à rendre au client :
                  aucun remboursement de ce montant n'est enregistré.
                </strong>
              </>
            )}
            {order.invoiceNumber && (
              <>
                {" "}
                La facture {order.invoiceNumber} a déjà été éditée : elle garde
                son numéro et porte désormais la mention « annulée ». Si elle est
                partie chez le client, il faut lui établir un avoir.
              </>
            )}
          </p>
        </div>
      )}

      {/* Avant « Éditer / Envoyer la facture » : une facture sans adresse ni
          SIRET de la boutique manque de mentions obligatoires. */}
      {!estPanier && mentionsFactureManquantes.length > 0 && (
        <div class="mb-6 rounded-lg border border-amber-300 bg-amber-50 px-4 py-3 text-sm text-amber-900" role="status">
          <p>
            Vos factures sortent encore sans {mentionsFactureManquantes.join(" ni ")} de
            la boutique, des mentions obligatoires.{" "}
            <a href={url("/facturation")} class="font-medium underline">
              Renseignez-les dans Réglages › Factures
            </a>{" "}
            avant d'envoyer celle-ci. Une facture déjà éditée les prendra dès
            qu'elles seront saisies.
          </p>
        </div>
      )}

      {/* ============================================================== */}
      {/* La frise : UN statut, en étapes (17/11)                        */}
      {/* ============================================================== */}
      {/* L'étape en cours en plein ; les autres étapes du parcours en
          boutons, en avant comme en arrière. Sous un bouton qui prévient
          le client, ce qu'il recevra. Lisible sur téléphone : Margaux la
          regarde au stand. */}
      {traitement && (
        <section id="statut" class="mb-6 rounded-lg border border-bo-border bg-bo-surface px-4 py-4">
          <h3 class="text-xs font-medium tracking-wide text-bo-muted uppercase">Statut</h3>
          {rangActuel === null ? (
            <div class="mt-2">
              <p class="text-base font-semibold">{badgeEtape?.texte}</p>
              <p class="mt-1 text-sm text-bo-muted">
                {etapeT === "a_encaisser"
                  ? auStand
                    ? "Vente du stand pas encore réglée : marquez-la payée quand le client a payé. Elle passera alors « À imprimer »."
                    : "Commande pas encore payée : on ne prépare pas ce qui n'est pas réglé. Si l'argent est arrivé hors du site, encaissez-la (bloc Paiement)."
                  : etapeT === "rien_a_expedier"
                    ? "Cette commande ne contient que des cartes cadeaux, parties par e-mail : il n'y a rien à préparer."
                    : etapeT === "annulee"
                      ? "Commande annulée : plus rien ne se prépare ni ne part."
                      : "C'est un panier, pas une commande : il n'y a rien à préparer."}
              </p>
              {estProprietaire && encaissableAuStand && (
                <form method="POST" class="mt-3">
                  <input type="hidden" name="_action" value="encaisser" />
                  <input type="hidden" name="moyen" value="sur_place" />
                  <button class="w-full rounded bg-bo-nav px-4 py-3 text-base text-white sm:w-auto">
                    Marquer payée · {formatPrice(total)} réglés sur place
                  </button>
                  <span class="mt-1 block text-xs text-bo-muted">Aucun courriel : le client est là.</span>
                </form>
              )}
            </div>
          ) : (
            <ol class="mt-3 flex flex-col gap-2 sm:flex-row sm:flex-wrap sm:items-start">
              {etapesFrise.map((e, i) => {
                const actuelle = e.rang === rangActuel;
                const faite = rangActuel !== null && e.rang < rangActuel;
                const p = e.passage;
                const courrier = p.ok && !p.inchange ? p.courrier : null;
                const arriere = p.ok && !p.inchange && p.sens === "arriere";
                const expedier = p.ok && !p.inchange && p.expedier;
                const confirmer = courrier
                  ? `Passer la commande à « ${e.libelle} » ? ${ANNONCE_COURRIER[courrier]}`
                  : p.ok && !p.inchange && p.annulerExpeditions
                    ? `Revenir à « ${e.libelle} » ? Les expéditions enregistrées seront annulées (aucun courriel ne part).`
                    : null;
                return (
                  <li class="flex items-start gap-2 sm:max-w-xs sm:flex-1">
                    {i > 0 && <span class="hidden pt-2.5 text-bo-muted sm:inline" aria-hidden="true">→</span>}
                    <div class="flex-1">
                      {actuelle ? (
                        <div
                          class={`rounded-lg px-4 py-2.5 text-base font-semibold ring-2 ring-bo-ink/20 ${badgeEtape?.classe ?? ""}`}
                          aria-current="step"
                        >
                          {e.libelle}
                          <span class="block text-xs font-normal opacity-75">Étape en cours</span>
                        </div>
                      ) : !estProprietaire || !p.ok ? (
                        <div
                          class={`rounded-lg border border-bo-border px-4 py-2.5 text-base ${faite ? "text-bo-ink" : "text-bo-muted"}`}
                          title={!p.ok ? p.raison : undefined}
                        >
                          {faite ? "✓ " : ""}
                          {e.libelle}
                          {!p.ok && estProprietaire && (
                            <span class="mt-1 block text-xs text-bo-muted">{p.raison}</span>
                          )}
                        </div>
                      ) : (
                        <form method="POST" data-confirmer={confirmer ?? undefined}>
                          <input type="hidden" name="_action" value="etape" />
                          <input type="hidden" name="etape" value={e.etape} />
                          {parcoursT === "livraison" && expedier && (
                            <div class="mb-2 grid grid-cols-1 gap-2">
                              <input
                                name="carrier"
                                list="bo-transporteurs-etape"
                                placeholder="Transporteur (Colissimo…)"
                                value={
                                  bordereauActif && !bordereauActif.essai
                                    ? (NOM_TRANSPORTEUR[bordereauActif.transporteur ?? ""] ?? "")
                                    : ""
                                }
                                class="w-full rounded border border-bo-border px-3 py-2 text-sm"
                              />
                              <datalist id="bo-transporteurs-etape">
                                {TRANSPORTEURS.map((t) => <option value={t} />)}
                              </datalist>
                              <input
                                name="trackingNumber"
                                placeholder="Numéro de suivi (facultatif)"
                                value={
                                  bordereauActif && !bordereauActif.essai
                                    ? (bordereauActif.trackingNumber ?? "")
                                    : ""
                                }
                                class="w-full rounded border border-bo-border px-3 py-2 text-sm"
                              />
                            </div>
                          )}
                          <button
                            class={
                              arriere
                                ? "w-full rounded-lg border border-bo-border px-4 py-2.5 text-left text-base text-bo-ink hover:bg-bo-bg"
                                : "w-full rounded-lg bg-bo-nav px-4 py-2.5 text-left text-base text-white hover:opacity-90"
                            }
                          >
                            {faite ? `↩ Revenir à « ${e.libelle} »` : e.libelle}
                          </button>
                          <span class="mt-1 block text-xs text-bo-muted">
                            {courrier
                              ? ANNONCE_COURRIER[courrier]
                              : auStand
                                ? "Aucun courriel : le client est là."
                                : "Aucun courriel."}
                          </span>
                        </form>
                      )}
                    </div>
                  </li>
                );
              })}
            </ol>
          )}
          {etapeT === "en_partie" && (
            <p class="mt-2 text-xs text-bo-muted">
              Une partie des articles est déjà partie : l'étape suivante fait partir le reste.
            </p>
          )}
        </section>
      )}

      {/* Les affiches en grand, avant tout le reste : c'est ce qu'on
          vérifie en ouvrant une commande, avant de l'imprimer. */}
      <AffichesCommande items={items} />

      {/* ============================================================== */}
      {/* Deux colonnes : agir à gauche, consulter à droite               */}
      {/* ============================================================== */}
      <div class="grid grid-cols-1 items-start gap-6 lg:grid-cols-3">
        <div class="space-y-6 lg:col-span-2">
          {/* ---------------------------------------------------------- */}
          {/* Traitement logistique                                       */}
          {/* ---------------------------------------------------------- */}
          {/* `data-impression` : les liens « PDF d'impression » de cette
              section disent où en est leur fichier — prêt, en préparation,
              impossible et pourquoi (lib/impression-bo.ts). Ouvrir une
              commande payée, c'est s'apprêter à l'imprimer : ses fichiers se
              préparent dès l'ouverture (`data-preparer`). */}
          <section
            id="articles"
            class="rounded-lg border border-bo-border bg-bo-surface"
            data-impression
            data-url-etat={apiUrl("/admin/print-files/etat")}
            data-preparer={encaisse ? "1" : undefined}
          >
            <header class="flex flex-wrap items-center justify-between gap-2 border-b border-bo-border px-4 py-3">
              <h3 class="font-medium">
                Articles
                <span class="ml-2 text-sm font-normal text-bo-muted">
                  {nbArticles} article{nbArticles > 1 ? "s" : ""}
                  {resteAExpedier > 0 && ` · ${resteAExpedier} à envoyer`}
                </span>
              </h3>
              <span class="text-sm text-bo-muted">
                {order.shippingLabel}
                {lieuRetrait
                  ? ` · ${lieuRetrait.nom}`
                  : order.relayPointLabel
                    ? ` · ${order.relayPointLabel}`
                    : ""}
              </span>
            </header>

            <table class="w-full text-sm">
              <tbody>
                {items.map((it, rang) => (
                  <tr class="border-b border-bo-border last:border-0">
                    {/* L'aperçu, à gauche, comme dans le panier de la boutique.
                        Il est rendu par le moteur du fichier d'impression :
                        c'est ce qui partira à l'atelier, pas une recomposition.
                        Un clic l'ouvre en grand — c'est là qu'on vérifie un
                        prénom ou la couleur d'un pull avant d'imprimer.

                        Le cadre garde les proportions d'une affiche (1:√2) :
                        l'image se charge après la page, et sans ce gabarit la
                        ligne sauterait de hauteur en arrivant. */}
                    <td class="w-24 py-3 pl-4 align-top">
                      {it.apercu && (
                        <a
                          href={apiUrl(it.apercu)}
                          target="_blank"
                          rel="noopener"
                          title="Voir l'affiche en grand"
                          class="block overflow-hidden rounded border border-bo-border bg-bo-bg transition-opacity hover:opacity-85"
                          style="aspect-ratio: 1 / 1.4142"
                        >
                          <img
                            src={apiUrl(it.apercu)}
                            alt={`Aperçu : ${it.title ?? "affiche"}`}
                            loading="lazy"
                            class="h-full w-full object-cover"
                          />
                        </a>
                      )}
                    </td>
                    <td class="px-4 py-3 align-top">
                      <div class="font-medium">
                        {it.title ?? "Affiche personnalisée"}
                      </div>
                      {it.carteCadeau && (
                        /* Une carte cadeau achetée : rien à imprimer ni à
                           expédier, elle part par e-mail au paiement. */
                        <div class="mt-0.5 text-bo-muted">
                          {[
                            `Pour ${it.carteCadeau.destinatairePrenom ? `${it.carteCadeau.destinatairePrenom}, ` : ""}${it.carteCadeau.destinataireEmail ?? "l'acheteur"}`,
                            it.carteCadeau.carte
                              ? `${it.carteCadeau.carte.masque} · ${it.carteCadeau.carte.envoyeeLe ? "envoyée par e-mail" : "courriel non parti"}`
                              : "carte créée au paiement",
                          ].join(" · ")}
                          {it.carteCadeau.message && (
                            <span class="mt-1 block italic">« {it.carteCadeau.message} »</span>
                          )}
                        </div>
                      )}
                      <div class="mt-0.5 text-bo-muted" hidden={Boolean(it.carteCadeau)}>
                        {[
                          it.format ? `Format ${libelleFormat(it.format)}` : null,
                          // Une affiche IA couchée s'imprime couchée : à voir AVANT de lancer l'impression.
                          it.orientation === "paysage"
                            ? "PAYSAGE (à l'horizontale)"
                            : null,
                          it.cadre ?? "Sans cadre",
                          it.personnages
                            ? `${it.personnages} personnage${it.personnages > 1 ? "s" : ""}`
                            : null,
                        ]
                          .filter(Boolean)
                          .join(" · ")}
                      </div>
                      {lignesDeLAffiche(it).length > 0 && (
                        <div class="mt-1">
                          <span class="text-xs tracking-wide text-bo-muted uppercase">
                            Texte de l'affiche
                          </span>
                          <ul class="mt-0.5 space-y-0.5">
                            {lignesDeLAffiche(it).map((ligne) => (
                              <li>« {ligne} »</li>
                            ))}
                          </ul>
                        </div>
                      )}
                      <div class="mt-1 flex flex-wrap gap-3 text-xs text-bo-muted">
                        {(it.expedie ?? 0) > 0 && (
                          <span>
                            {it.expedie} / {it.quantity} expédié(s)
                          </span>
                        )}
                        {(it.rembourse ?? 0) > 0 && (
                          <span class="text-violet-700">
                            {it.rembourse} remboursé(s)
                          </span>
                        )}
                        {/* Plus d'onglet ouvert à l'aveugle : le lien
                            télécharge sur place (`download`), et seulement
                            quand le fichier est prêt — en attendant, il dit
                            où il en est. Sans script, il télécharge comme
                            avant. */}
                        {encaisse && (
                          <a
                            href={apiUrl(`/admin/print-files/${it.id}`)}
                            download
                            data-pdf-ligne={it.id}
                            data-pdf-libelle="long"
                            data-pdf-nom={`Affiche ${rang + 1} (${it.title ?? "affiche personnalisée"})`}
                            class="bo-pdf text-bo-accent hover:underline"
                          >
                            Télécharger le PDF d'impression
                          </a>
                        )}
                        {encaisse && (
                          <span
                            data-pdf-message={it.id}
                            class="bo-pdf-message basis-full"
                            aria-live="polite"
                          />
                        )}
                      </div>
                    </td>
                    <td class="px-4 py-3 text-right align-top whitespace-nowrap text-bo-muted">
                      {formatPrice(it.unitPriceCents)} × {it.quantity}
                    </td>
                    <td class="px-4 py-3 text-right align-top whitespace-nowrap">
                      {formatPrice(it.unitPriceCents * it.quantity)}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>

            {/* Toutes les affiches d'un coup, chacune sous son nom, dans une
                archive : sur une commande de cinq affiches, cinq clics de
                moins — et aucune d'oubliée. */}
            {encaisse && items.length > 1 && (
              <div
                class="flex flex-wrap items-center gap-x-3 gap-y-1 border-t border-bo-border px-4 py-3 text-sm"
                data-pdf-groupe
              >
                <a
                  href={apiUrl(`/admin/orders/${order.id}/impression.zip`)}
                  download
                  data-pdf-tout
                  data-pdf-lignes={items.map((it) => it.id).join(",")}
                  class="bo-pdf rounded border border-bo-border bg-bo-surface px-3 py-1.5 hover:bg-bo-bg"
                >
                  Tout télécharger (.zip)
                </a>
                <span class="text-xs text-bo-muted">
                  Les {items.length} PDF d'impression, chacun sous son nom, dans une
                  seule archive.
                </span>
                <span data-pdf-messages class="bo-pdf-messages basis-full" aria-live="polite" />
              </div>
            )}

            {expeditions.length > 0 && (
              <div class="border-t border-bo-border px-4 py-3">
                <h4 class="mb-2 text-xs font-medium tracking-wide text-bo-muted uppercase">
                  {auStand ? "Remise au client" : "Colis"}
                </h4>
                <ul class="space-y-2 text-sm">
                  {expeditions.map((f) => (
                    <li class="flex flex-wrap items-center justify-between gap-2">
                      <span
                        class={f.status === "cancelled" ? "text-bo-muted line-through" : ""}
                      >
                        {f.carrier ?? (auStand ? "Remis au client" : "Sans transporteur")}
                        {f.trackingNumber && (
                          <>
                            {" · "}
                            {f.trackingUrl ? (
                              <a
                                href={f.trackingUrl}
                                target="_blank"
                                rel="noopener"
                                class="text-bo-accent hover:underline"
                              >
                                {f.trackingNumber}
                              </a>
                            ) : (
                              f.trackingNumber
                            )}
                          </>
                        )}
                        <span class="ml-2 text-xs text-bo-muted">
                          {quand(f.createdAt)} ·{" "}
                          {f.lignes.reduce((s, l) => s + l.quantity, 0)} article(s)
                        </span>
                      </span>
                      {f.status !== "cancelled" && (
                        <form
                          method="POST"
                          data-confirmer="Annuler cette expédition ? Elle est marquée annulée dans la commande."
                        >
                          <input type="hidden" name="_action" value="annuler-expedition" />
                          <input type="hidden" name="fulfillmentId" value={f.id} />
                          <button class="text-xs text-bo-accent hover:underline">
                            Annuler
                          </button>
                        </form>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {resteAExpedier > 0 && annulee && (
              <p class="border-t border-bo-border px-4 py-3 text-sm text-bo-muted">
                {resteAExpedier} article(s) ne partiront pas : la commande est
                annulée.
              </p>
            )}

            {/* Plus de « Marquer comme remis » ni de « Traiter les articles »
                (17/11) : tout passe par la frise « Statut », en tête. */}
          </section>

          {/* ---------------------------------------------------------- */}
          {/* Bordereau transporteur (SendCloud)                          */}
          {/* ---------------------------------------------------------- */}
          {/* Pas de bordereau pour une vente du stand (17/11) : elle est
              imprimée et remise sur place. Un bordereau déjà acheté reste
              visible, pour qu'on puisse le suivre ou l'annuler. */}
          {order && !estPanier && !(auStand && !bordereauActif) && (
            <section id="bordereau" class="rounded-lg border border-bo-border bg-bo-surface">
              <header class="flex items-center justify-between gap-3 border-b border-bo-border px-4 py-3">
                <h3 class="font-medium">Bordereau transporteur</h3>
                {etatBordereau?.essai && (
                  <span
                    class="rounded bg-amber-100 px-2 py-0.5 text-xs text-amber-900"
                    title="Réglages › Paiements › « Acheter les vraies étiquettes SendCloud » pour acheter de vraies étiquettes"
                  >
                    Mode essai : rien n'est facturé
                  </span>
                )}
              </header>

              <div class="space-y-3 px-4 py-3 text-sm">
                {erreurBordereau && <p class="text-red-700">{erreurBordereau}</p>}

                {versPointRelais && (bordereauActif || bordereau?.statut === "en_cours") && (
                  <p class="text-bo-muted">
                    Point relais choisi : <span class="text-inherit">{etatBordereau?.pointRelais}</span>
                  </p>
                )}

                {/* Acheté : l'étiquette, le suivi, l'annulation. */}
                {bordereauActif && (
                  <div class="space-y-3">
                    <p>
                      <span class="font-medium">{bordereauActif.methodeNom}</span>
                      {bordereauActif.prixAnnonceCents !== null && !bordereauActif.essai && (
                        <span class="text-bo-muted"> · {formatPrice(bordereauActif.prixAnnonceCents)}</span>
                      )}
                      <span class="text-bo-muted"> · {bordereauActif.poidsGrammes} g · acheté {quand(bordereauActif.acheteAt)}</span>
                    </p>
                    {bordereauActif.trackingNumber && (
                      <p>
                        Suivi :{" "}
                        {bordereauActif.trackingUrl ? (
                          <a
                            href={bordereauActif.trackingUrl}
                            target="_blank"
                            rel="noopener"
                            class="font-mono text-bo-accent underline"
                          >
                            {bordereauActif.trackingNumber}
                          </a>
                        ) : (
                          <span class="font-mono">{bordereauActif.trackingNumber}</span>
                        )}
                      </p>
                    )}
                    <div class="flex flex-wrap gap-2">
                      <a
                        href={apiUrl(`/admin/orders/${order.id}/bordereau/etiquette.pdf?format=a6`)}
                        target="_blank"
                        class="rounded bg-bo-nav px-4 py-2 text-white"
                      >
                        Imprimer l'étiquette (10×15)
                      </a>
                      <a
                        href={apiUrl(`/admin/orders/${order.id}/bordereau/etiquette.pdf?format=a4`)}
                        target="_blank"
                        class="rounded border border-bo-border px-4 py-2"
                      >
                        Version A4
                      </a>
                      <form
                        method="POST"
                        class="ml-auto"
                        data-confirmer="Annuler ce bordereau chez SendCloud ? L'étiquette ne sera plus valable. SendCloud dira s'il la rembourse."
                      >
                        <input type="hidden" name="_action" value="annuler-bordereau" />
                        <button class="rounded border border-red-300 px-4 py-2 text-red-700">
                          Annuler le bordereau
                        </button>
                      </form>
                    </div>
                    {!bordereauActif.essai && resteAExpedier > 0 && (
                      <p class="text-xs text-bo-muted">
                        Une fois le colis déposé, enregistrez l'expédition ci-dessus : le
                        transporteur et le numéro de suivi y sont déjà remplis, et le
                        client reçoit son lien de suivi.
                      </p>
                    )}
                    <p class="text-xs text-bo-muted">
                      Une erreur d'adresse, de service ou de poids ? SendCloud ne
                      modifie pas une étiquette : annulez celle-ci, corrigez, puis
                      rachetez-en une.
                    </p>
                  </div>
                )}

                {/* Achat interrompu : on ne sait pas encore s'il a eu lieu. */}
                {bordereau?.statut === "en_cours" && (
                  <div class="space-y-2">
                    <p class="text-amber-800">
                      Un achat a été lancé {quand(bordereau.createdAt)} sans réponse de SendCloud.
                      Rejouer la demande ne peut PAS acheter deux étiquettes : SendCloud
                      rend celle qui existe déjà, ou fabrique celle qui manquait.
                    </p>
                    <form method="POST">
                      <input type="hidden" name="_action" value="terminer-bordereau" />
                      <button class="rounded bg-bo-nav px-4 py-2 text-white">Terminer l'achat</button>
                    </form>
                  </div>
                )}

                {/* Rien de vivant : on peut acheter. */}
                {etatBordereau && !bordereauActif && bordereau?.statut !== "en_cours" && (
                  <div class="space-y-3">
                    {bordereau?.statut === "echec" && (
                      <p class="text-red-700">Dernière tentative refusée : {bordereau.erreur}</p>
                    )}
                    {bordereau?.statut === "annule" && (
                      <p class="text-bo-muted">
                        Bordereau {bordereau.trackingNumber ?? ""} annulé {quand(bordereau.annuleAt)}.
                      </p>
                    )}

                    {etatBordereau.empechement ? (
                      <p class="rounded border border-bo-border bg-bo-bg px-3 py-2">
                        {etatBordereau.empechement}
                      </p>
                    ) : (
                      <>
                        {/* Le destinataire, tel que l'étiquette l'imprimera, et
                            de quoi le saisir ou le corriger SANS quitter le bloc :
                            un retrait sur place, une vente du stand ou une
                            adresse fausse ne bloquent plus l'achat. La commande
                            garde ce qui est saisi ici, et la chronologie le note. */}
                        <div class="space-y-2 rounded border border-bo-border px-3 py-2">
                          <p class="text-xs text-bo-muted">Destinataire de l'étiquette</p>
                          {versPointRelais ? (
                            <p>
                              {order.shippingName || "—"}
                              {order.shippingPhone && (
                                <span class="text-bo-muted"> · {order.shippingPhone}</span>
                              )}
                              <span class="block text-bo-muted">
                                au point relais {etatBordereau.pointRelais ?? ""}
                              </span>
                            </p>
                          ) : aUneAdresse ? (
                            <p>
                              {order.shippingName || "—"}
                              {order.shippingPhone && (
                                <span class="text-bo-muted"> · {order.shippingPhone}</span>
                              )}
                              <span class="block">
                                {[order.shippingLine1, order.shippingLine2].filter(Boolean).join(", ")}
                              </span>
                              <span class="block">
                                {[order.shippingPostalCode, order.shippingCity, order.shippingCountry || "FR"]
                                  .filter(Boolean)
                                  .join(" ")}
                              </span>
                            </p>
                          ) : (
                            <p class="text-bo-muted">
                              {order.shippingName || "Aucun nom"} — aucune adresse de livraison.
                            </p>
                          )}

                          {manquesDestinataire.map((m) => (
                            <p class="text-amber-900">{m.message}</p>
                          ))}

                          {versPointRelais ? (
                            <>
                              {/* Au point relais, l'étiquette porte l'adresse du
                                  point : seuls le nom et le téléphone sont à elle. */}
                              <details open={manquesDestinataire.length > 0}>
                                <summary class="cursor-pointer text-bo-accent">
                                  Corriger le nom ou le téléphone
                                </summary>
                                <form method="POST" class="mt-2 space-y-2">
                                  <input type="hidden" name="_action" value="adresse" />
                                  <input
                                    name="shippingName"
                                    value={order.shippingName ?? ""}
                                    placeholder="Nom du destinataire"
                                    required
                                    class="w-full rounded border border-bo-border px-2 py-1"
                                  />
                                  <input
                                    name="shippingPhone"
                                    value={order.shippingPhone ?? ""}
                                    placeholder="Téléphone (le point relais prévient par SMS)"
                                    class="w-full rounded border border-bo-border px-2 py-1"
                                  />
                                  <button class="rounded border border-bo-border px-3 py-1.5 hover:bg-bo-bg">
                                    Enregistrer
                                  </button>
                                </form>
                              </details>
                              <details>
                                <summary class="cursor-pointer text-bo-accent">
                                  Envoyer à une adresse plutôt qu'au point relais
                                </summary>
                                <form
                                  method="POST"
                                  class="mt-2 space-y-2"
                                  data-confirmer={`Envoyer ce colis à cette adresse plutôt qu'au point relais « ${etatBordereau.pointRelais ?? ""} » ? Le point relais quitte la commande ; la chronologie le garde.`}
                                >
                                  <p class="text-xs text-bo-muted">
                                    Pour un point relais fermé, ou un client qui préfère
                                    être livré chez lui. Il a payé un point relais : un
                                    envoi à domicile coûte en général plus cher.
                                  </p>
                                  <input type="hidden" name="_action" value="adresse" />
                                  <input type="hidden" name="livrerALAdresse" value="1" />
                                  <ChampsAdresse adresse={order} />
                                  <button class="rounded border border-bo-border px-3 py-1.5 hover:bg-bo-bg">
                                    Envoyer à cette adresse
                                  </button>
                                </form>
                              </details>
                            </>
                          ) : (
                            <details
                              open={manquesDestinataire.length > 0 && situation?.envoiPaye !== "stand"}
                            >
                              {/* Ouvert d'office quand il manque l'adresse — sauf
                                  pour une vente du stand, qui se remet le plus
                                  souvent en main propre : on ne l'invite pas à voyager. */}
                              <summary class="cursor-pointer text-bo-accent">
                                {aUneAdresse ? "Corriger l'adresse" : "Saisir l'adresse du destinataire"}
                              </summary>
                              <form method="POST" class="mt-2 space-y-2">
                                <input type="hidden" name="_action" value="adresse" />
                                <ChampsAdresse adresse={order} />
                                <button class="rounded border border-bo-border px-3 py-1.5 hover:bg-bo-bg">
                                  Enregistrer l'adresse
                                </button>
                                <p class="text-xs text-bo-muted">
                                  Elle devient l'adresse de livraison de la commande
                                  (colonne de droite), et la chronologie note le
                                  changement.
                                </p>
                              </form>
                            </details>
                          )}
                        </div>

                        {manquesEmail.map((m) => (
                          <p class="rounded border border-amber-300 bg-amber-50 px-3 py-2 text-amber-900">
                            {m.message}{" "}
                            {client && (
                              <a href={url(`/clients/${client.id}`)} class="underline">
                                Ouvrir la fiche du client
                              </a>
                            )}
                          </p>
                        ))}

                        {etatBordereau.manques.length === 0 && (
                      <>
                        {/* Le poids décide de la tranche, donc du prix : on le
                            corrige AVANT d'acheter (l'emballage pèse). */}
                        <form method="GET" action="#bordereau" class="flex flex-wrap items-end gap-2">
                          {voirTous && <input type="hidden" name="tous" value="1" />}
                          <label>
                            <span class="mb-1 block text-xs text-bo-muted">Poids du colis emballé</span>
                            <span class="flex items-center gap-1">
                              <input
                                type="number"
                                name="poids"
                                min="1"
                                max="70000"
                                value={etatBordereau.poidsGrammes}
                                class="w-24 rounded border border-bo-border px-2 py-1.5"
                              />
                              <span class="text-bo-muted">g</span>
                            </span>
                          </label>
                          <button class="rounded border border-bo-border px-3 py-1.5">Recalculer</button>
                        </form>

                        {etatBordereau.erreurMethodes && (
                          <p class="text-red-700">{etatBordereau.erreurMethodes}</p>
                        )}
                        {!etatBordereau.erreurMethodes && etatBordereau.methodes.length === 0 && (
                          <p class="text-bo-muted">
                            {etatBordereau.autresServices > 0 && !voirTous
                              ? `SendCloud ne propose aucun service ${situation?.transporteurPaye ?? "du transporteur payé"} pour ce colis (poids, pays ou point relais). D'autres transporteurs le peuvent :`
                              : "SendCloud ne propose aucun service pour ce colis (poids, pays ou point relais). Vérifiez le poids et l'adresse, ou créez l'envoi directement dans SendCloud."}
                          </p>
                        )}

                        {etatBordereau.methodes.length > 0 && (
                          <form
                            method="POST"
                            class="space-y-3"
                            id="ml-achat-bordereau"
                            data-essai={etatBordereau.essai ? "1" : ""}
                          >
                            <input type="hidden" name="_action" value="acheter-bordereau" />
                            <input type="hidden" name="poidsGrammes" value={etatBordereau.poidsGrammes} />
                            {/* Une clé par affichage : un double-clic ou un F5
                                renvoient la même, et l'API ne l'achète qu'une fois. */}
                            <input type="hidden" name="cleDemande" value={crypto.randomUUID()} />
                            {/* Ce que la cliente a choisi, sous les yeux au moment
                                de choisir : c'est la promesse que l'étiquette
                                doit tenir (signature, heure, point relais…). */}
                            {order.shippingLabel && (
                              <p>
                                {situation?.envoiPaye === "transporteur" ||
                                situation?.envoiPaye === "hors_sendcloud"
                                  ? "Le client a payé : "
                                  : "Mode choisi : "}
                                <strong>{order.shippingLabel}</strong>
                                {order.shippingDescription && (
                                  <span class="text-bo-muted"> — {order.shippingDescription}</span>
                                )}
                              </p>
                            )}
                            {/* Pourquoi aucune ligne n'est « celle qu'elle a
                                payée », avant de choisir : sans cette phrase,
                                une liste sans badge vert passe pour une panne. */}
                            {situation && SANS_ENVOI_PAYE[situation.envoiPaye] ? (
                              <p class="rounded border border-amber-300 bg-amber-50 px-3 py-2 text-amber-900">
                                {SANS_ENVOI_PAYE[situation.envoiPaye]}
                              </p>
                            ) : situation?.envoiPaye === "hors_sendcloud" ? (
                              <p class="rounded border border-amber-300 bg-amber-50 px-3 py-2 text-amber-900">
                                Le client a payé un envoi {situation.transporteurPaye}, que
                                SendCloud n'expédie pas pour la boutique : voici les services
                                des autres transporteurs. Choisissez le plus proche de ce
                                qu'elle a payé (délai, signature, point relais).
                              </p>
                            ) : (
                              !etatBordereau.methodes[0]!.conforme && (
                                <p class="rounded border border-amber-300 bg-amber-50 px-3 py-2 text-amber-900">
                                  {etatBordereau.autresServices > 0 && !voirTous
                                    ? "Aucun service SendCloud ne correspond exactement à ce mode pour ce colis. Vérifiez lequel convient avant d'acheter — d'autres transporteurs l'ont peut-être : « Voir tous les services »."
                                    : "Aucun service SendCloud ne correspond exactement à ce mode pour ce colis. Vérifiez lequel convient avant d'acheter."}
                                </p>
                              )
                            )}
                            <fieldset class="space-y-1.5">
                              {etatBordereau.methodes.map((m, i) => (
                                <label class="flex cursor-pointer items-center justify-between gap-3 rounded border border-bo-border px-3 py-2 hover:bg-bo-bg">
                                  <span class="flex flex-wrap items-center gap-x-2 gap-y-0.5">
                                    <input
                                      type="radio"
                                      name="methode"
                                      value={`${m.code}|${m.prixCents ?? ""}`}
                                      data-prix={m.prixCents === null ? "" : formatPrice(m.prixCents)}
                                      data-nom={m.nom}
                                      data-ecart={m.conforme ? "" : (m.ecart ?? "")}
                                      checked={i === 0}
                                    />
                                    {m.nom}
                                    {m.conforme ? (
                                      <span class="rounded bg-green-50 px-1.5 text-xs text-green-800">
                                        correspond au mode payé
                                      </span>
                                    ) : (
                                      m.ecart && (
                                        <span class="rounded bg-amber-50 px-1.5 text-xs text-amber-900">
                                          {m.ecart}
                                        </span>
                                      )
                                    )}
                                  </span>
                                  <span class="font-medium">
                                    {m.prixCents === null ? "—" : formatPrice(m.prixCents)}
                                  </span>
                                </label>
                              ))}
                            </fieldset>
                            {etatBordereau.autresServices > 0 && (
                              <p>
                                <a href={lienAutresServices} class="text-bo-accent underline">
                                  {libelleAutresServices}
                                </a>
                              </p>
                            )}
                            <button class="rounded bg-bo-nav px-4 py-2 text-white" data-bouton-achat>
                              {etatBordereau.essai
                                ? "Fabriquer un bordereau d'essai (gratuit)"
                                : `Acheter le bordereau — ${
                                    etatBordereau.methodes[0]!.prixCents === null
                                      ? "prix inconnu"
                                      : formatPrice(etatBordereau.methodes[0]!.prixCents)
                                  }`}
                            </button>
                            <p class="text-xs text-bo-muted">
                              {etatBordereau.essai
                                ? "Mode essai : SendCloud fabrique une lettre non affranchie, qu'il ne facture pas. Ce n'est pas une étiquette valable chez le transporteur."
                                : "Le montant est prélevé par SendCloud dès la création de l'étiquette. Une étiquette annulée avant dépôt est en principe remboursée."}
                            </p>
                          </form>
                        )}
                        {/* Liste vide : le lien vers les autres transporteurs
                            est la seule chose à faire, il se montre seul. */}
                        {etatBordereau.methodes.length === 0 && etatBordereau.autresServices > 0 && (
                          <p>
                            <a href={lienAutresServices} class="text-bo-accent underline">
                              {libelleAutresServices}
                            </a>
                          </p>
                        )}
                      </>
                        )}
                      </>
                    )}
                  </div>
                )}
              </div>
            </section>
          )}

          {/* ---------------------------------------------------------- */}
          {/* Paiement & mouvements                                       */}
          {/* ---------------------------------------------------------- */}
          <section id="mouvements" class="rounded-lg border border-bo-border bg-bo-surface">
            <header class="border-b border-bo-border px-4 py-3">
              <h3 class="font-medium">
                <span
                  class={`mr-2 inline-block h-2 w-2 rounded-full align-middle ${
                    encaisse ? "bg-green-600" : "bg-amber-500"
                  }`}
                />
                {badgePaiement.texte}
              </h3>
            </header>
            <dl class="space-y-1.5 px-4 py-3 text-sm">
              <div class="flex justify-between">
                <dt class="text-bo-muted">
                  Sous-total · {nbArticles} article{nbArticles > 1 ? "s" : ""}
                </dt>
                <dd>{formatPrice(sousTotal)}</dd>
              </div>
              {remise > 0 && (
                <div class="flex justify-between">
                  <dt class="text-bo-muted">
                    Réduction{order.promoCode ? ` · ${order.promoCode}` : ""}
                  </dt>
                  <dd class="text-green-700">− {formatPrice(remise)}</dd>
                </div>
              )}
              <div class="flex justify-between">
                <dt class="text-bo-muted">
                  Livraison{order.shippingLabel ? ` · ${order.shippingLabel}` : ""}
                </dt>
                <dd>{formatPrice(port)}</dd>
              </div>
              <div class="flex justify-between">
                <dt class="text-bo-muted">TVA</dt>
                <dd class="text-bo-muted">Non applicable — art. 293 B du CGI</dd>
              </div>
              <div class="mt-2 flex justify-between border-t border-bo-border pt-2 font-medium">
                <dt>Total</dt>
                <dd>{formatPrice(total)}</dd>
              </div>
              {(order.giftCardCents ?? 0) > 0 && (
                <div class="flex justify-between">
                  <dt class="text-bo-muted">
                    Dont carte cadeau
                    {detail?.carteCadeauPayante ? ` · ${detail.carteCadeauPayante.masque}` : ""}
                  </dt>
                  <dd>{formatPrice(order.giftCardCents ?? 0)}</dd>
                </div>
              )}
              {rembourse > 0 && (
                <>
                  <div class="flex justify-between text-violet-700">
                    <dt>Remboursé</dt>
                    <dd>− {formatPrice(rembourse)}</dd>
                  </div>
                  <div class="flex justify-between font-medium">
                    <dt>Net encaissé</dt>
                    <dd>{formatPrice(netEncaisse)}</dd>
                  </div>
                </>
              )}
            </dl>

            {mouvements.length > 0 && (
              <div class="border-t border-bo-border px-4 py-3">
                <h4 class="mb-2 text-xs font-medium tracking-wide text-bo-muted uppercase">
                  Mouvements
                </h4>
                <ul class="space-y-1 text-sm">
                  {/* Un encaissement annulé (vente rouverte au stand, cf.
                      salon.ts) reste au journal, mais barré : affiché comme
                      les autres, une vente corrigée deux fois se lisait
                      comme trois encaissements. */}
                  {mouvements.map((m) => (
                    <li
                      class={`flex flex-wrap items-baseline justify-between gap-2 ${m.status === "annule" ? "text-bo-muted" : ""}`}
                    >
                      <span>
                        {LIBELLE_MOUVEMENT[m.kind] ?? m.kind}
                        {m.gateway && (
                          <span class="text-bo-muted"> · {libelleMoyen(m.gateway)}</span>
                        )}
                        {m.externalRef && (
                          <span class="ml-1 text-xs text-bo-muted">{m.externalRef}</span>
                        )}
                        {m.status === "annule" && (
                          <span class="ml-1 text-xs"> · annulé, ne compte pas</span>
                        )}
                      </span>
                      <span
                        class={
                          m.status === "annule"
                            ? "line-through"
                            : m.kind === "refund"
                              ? "text-violet-700"
                              : ""
                        }
                      >
                        {m.kind === "refund" ? "− " : ""}
                        {formatPrice(m.amountCents)}
                        <span class="ml-2 text-xs text-bo-muted">
                          {quand(m.createdAt)}
                        </span>
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {paiement && (
              <p class="border-t border-bo-border px-4 py-3 text-sm text-bo-muted">
                {/* « Encaissé » seulement pour un paiement réussi : un paiement
                    commencé puis abandonné laissait croire la commande réglée
                    (recette du 17/11). */}
                {paiement.status === "succeeded"
                  ? "Encaissé"
                  : "Paiement commencé, rien d'encaissé"}{" "}
                : {libelleMoyen(paiement.provider)}
                {paiement.externalRef && ` · ${paiement.externalRef}`}
              </p>
            )}

            {aRembourser.map((p) => (
              <p class="border-t border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
                <strong class="font-medium">À rembourser :</strong>{" "}
                {libelleMoyen(p.provider)} a encaissé {formatPrice(p.amountCents)}
                {p.externalRef && ` (${p.externalRef})`}
                {p.status === "en_trop"
                  ? " alors que la commande était déjà payée."
                  : " pour un montant qui ne correspond pas à la commande."}{" "}
                Ce paiement ne compte pas dans ce qui est encaissé : le journal
                explique quoi faire.
              </p>
            ))}

            {/* Le règlement arrivé hors du site : virement, chèque, espèces.
                Sans ce bouton, une cliente qui paie par virement laissait sa
                commande « En attente » pour toujours — jamais préparée, sans
                fichier d'impression, et sans confirmation. */}
            {/* Une vente du stand (17/11) : la tablette l'enregistre « à
                encaisser », et Margaux la marque réglée d'un clic. */}
            {encaissableAuStand && (
              <form method="POST" class="border-t border-bo-border px-4 py-3">
                <input type="hidden" name="_action" value="encaisser" />
                <input type="hidden" name="moyen" value="sur_place" />
                <p class="mb-2 text-sm text-bo-muted">
                  Vente prise au stand, pas encore réglée. Quand le client a payé
                  (espèces ou carte), marquez-la réglée : elle passe en « Payée »
                  pour {formatPrice(total)}.
                </p>
                <button class="rounded bg-bo-nav px-4 py-2 text-sm text-white">
                  Marquer payée · {formatPrice(total)} réglés sur place
                </button>
              </form>
            )}
            {encaissableALaMain && (
              <details class="border-t border-bo-border">
                <summary class="cursor-pointer px-4 py-3 text-sm font-medium text-bo-accent">
                  Marquer comme payée (règlement hors ligne)
                </summary>
                <form method="POST" class="space-y-3 px-4 pb-4">
                  <input type="hidden" name="_action" value="encaisser" />
                  <p class="text-sm text-bo-muted">
                    À utiliser quand l'argent est bien arrivé mais pas par le
                    site : virement, chèque, espèces. La commande passe en
                    « Payée » pour {formatPrice(total)}, ses fichiers
                    d'impression sont fabriqués, et la confirmation part chez le
                    client — exactement comme un paiement en ligne.
                  </p>
                  <div class="flex flex-wrap items-end gap-4">
                    <label class="text-sm">
                      <span class="mb-1 block text-xs text-bo-muted">
                        Moyen de règlement
                      </span>
                      <select
                        name="moyen"
                        required
                        class="rounded border border-bo-border px-3 py-2"
                      >
                        {MOYENS_HORS_LIGNE.map(([valeur, libelle]) => (
                          <option value={valeur}>{libelle}</option>
                        ))}
                      </select>
                    </label>
                    <label class="flex-1 text-sm">
                      <span class="mb-1 block text-xs text-bo-muted">
                        Référence (numéro de virement, de chèque…)
                      </span>
                      <input
                        name="reference"
                        placeholder="VIR-20260910-4412"
                        class="w-full rounded border border-bo-border px-3 py-2"
                      />
                    </label>
                  </div>
                  <p class="text-xs text-bo-muted">
                    La référence sert à retrouver l'argent sur le relevé de
                    banque. Elle est refusée si une autre commande la porte
                    déjà — c'est souvent le même chèque saisi deux fois.
                  </p>
                  <button class="rounded bg-bo-nav px-4 py-2 text-sm text-white">
                    Encaisser {formatPrice(total)}
                  </button>
                </form>
              </details>
            )}

            {/* Rembourser : le SEUL endroit où l'on rend de l'argent (17/11).
                Le montant part plein — tout ce qui reste —, se règle en euros
                ou en pourcentage du reste, et l'annulation se coche ici aussi :
                le bloc « Annuler » ne touche plus à l'argent. */}
            {/* Pas de remboursement pour une vente du stand (17/11) : elle se
                règle de la main à la main, sur place. */}
            {encaisse && resteSiPasRembourse > 0 && !auStand && (
              <details class="border-t border-bo-border">
                <summary class="cursor-pointer px-4 py-3 text-sm font-medium text-bo-accent">
                  Rembourser
                </summary>
                <form method="POST" class="space-y-3 px-4 pb-4" data-remboursement>
                  <input type="hidden" name="_action" value="rembourser" />
                  <input type="hidden" name="resteCents" value={resteSiPasRembourse} />
                  <div class="flex flex-wrap items-end gap-3">
                    <label class="text-sm">
                      <span class="mb-1 block text-xs text-bo-muted">Montant à rembourser</span>
                      <input
                        type="number"
                        name="montant"
                        step="0.01"
                        min="0.01"
                        max={(resteSiPasRembourse / 100).toFixed(2)}
                        value={(resteSiPasRembourse / 100).toFixed(2)}
                        required
                        data-reste={resteSiPasRembourse}
                        class="w-32 rounded border border-bo-border px-2 py-1"
                      />
                    </label>
                    <label class="text-sm">
                      <span class="mb-1 block text-xs text-bo-muted">en</span>
                      <select name="unite" class="rounded border border-bo-border px-2 py-1">
                        <option value="eur" selected>€</option>
                        <option value="pct">% du reste</option>
                      </select>
                    </label>
                    <p class="pb-1 text-xs text-bo-muted" data-equivaut>
                      Par défaut, tout ce qui reste : {formatPrice(resteSiPasRembourse)}.
                    </p>
                  </div>
                  <label class="block text-sm">
                    <span class="mb-1 block text-xs text-bo-muted">Motif</span>
                    <input
                      name="reason"
                      placeholder="Affiche abîmée, geste commercial, erreur de commande…"
                      class="w-full rounded border border-bo-border px-3 py-2"
                    />
                  </label>
                  <label class="block text-sm">
                    <span class="mb-1 block text-xs text-bo-muted">
                      Note interne (jamais envoyée au client)
                    </span>
                    <input name="noteRemb" class="w-full rounded border border-bo-border px-3 py-2" />
                  </label>
                  <label class="flex items-center gap-2 text-sm">
                    <input type="checkbox" name="viaPsp" checked />
                    Rendre l'argent via {paiement?.provider === "paypal" ? "PayPal" : paiement?.provider === "stripe" ? "Stripe (carte)" : "Stripe ou PayPal"}
                    <span class="text-xs text-bo-muted">
                      (décochez si vous avez déjà remboursé à la main, sur le site du prestataire ou en espèces)
                    </span>
                  </label>
                  {!annulee && (
                    <div class="space-y-2 rounded border border-amber-300 p-3 text-sm">
                      <label class="flex items-start gap-2">
                        <input type="checkbox" name="annulerAussi" class="mt-0.5" data-annuler-aussi />
                        <span>
                          Annuler aussi la commande
                          <span class="block text-xs text-bo-muted">
                            Elle sort de vos chiffres, ne peut plus rien expédier, et le client est prévenu par courrier.
                          </span>
                        </span>
                      </label>
                      {resteAExpedier < nbArticles && (
                        <p class="rounded bg-amber-50 px-2 py-1 text-xs text-amber-900">
                          {nbArticles - resteAExpedier} article(s) sont déjà partis : l'annulation sera refusée (le remboursement, lui, passera).
                        </p>
                      )}
                      <div class="space-y-2" data-champs-annulation hidden>
                        <label class="block">
                          <span class="mb-1 block text-xs text-bo-muted">Motif de l'annulation</span>
                          <select name="motif" class="w-full rounded border border-bo-border px-2 py-1">
                            {MOTIFS_ANNULATION.map(([valeur, libelle]) => (
                              <option value={valeur}>{libelle}</option>
                            ))}
                          </select>
                        </label>
                        <label class="block">
                          <span class="mb-1 block text-xs text-bo-muted">Précision (écrite au client)</span>
                          <input
                            name="motifLibre"
                            placeholder="Le fond choisi n'est plus disponible"
                            class="w-full rounded border border-bo-border px-2 py-1"
                          />
                        </label>
                      </div>
                    </div>
                  )}
                  <p class="text-xs text-bo-muted">
                    Rappel : une affiche personnalisée n'a pas de droit de
                    rétractation (seule la garantie joue) ; une affiche prête à
                    imprimer, 14 jours.
                  </p>
                  <button class="rounded bg-bo-nav px-4 py-2 text-sm text-white">
                    Rembourser
                  </button>
                </form>
              </details>
            )}
          </section>

          {/* ---------------------------------------------------------- */}
          {/* Chronologie                                                 */}
          {/* ---------------------------------------------------------- */}
          <section id="journal" class="rounded-lg border border-bo-border bg-bo-surface">
            <header class="border-b border-bo-border px-4 py-3">
              <h3 class="font-medium">Chronologie</h3>
            </header>
            <form method="POST" class="border-b border-bo-border px-4 py-3">
              <input type="hidden" name="_action" value="commentaire" />
              <textarea
                name="message"
                rows="2"
                placeholder="Laisser un commentaire — « client rappelé », « à joindre au colis de sa sœur »…"
                class="w-full rounded border border-bo-border px-3 py-2 text-sm"
              />
              <div class="mt-2 flex items-center justify-between">
                <span class="text-xs text-bo-muted">
                  Visible seulement au back-office.
                </span>
                <button class="rounded bg-bo-nav px-3 py-1.5 text-sm text-white">
                  Publier
                </button>
              </div>
            </form>
            <ol class="space-y-3 px-4 py-3 text-sm">
              {(detail?.journal ?? []).map((e) => (
                <li class="flex gap-3">
                  <span
                    class={`mt-1.5 h-2 w-2 shrink-0 rounded-full ${
                      e.kind === "comment" ? "bg-bo-accent" : "bg-bo-border"
                    }`}
                  />
                  <span>
                    <span class={e.kind === "comment" ? "italic" : ""}>{e.message}</span>
                    <span class="ml-2 text-xs text-bo-muted">
                      {quand(e.createdAt)}
                      {e.author && ` · ${e.author}`}
                    </span>
                  </span>
                </li>
              ))}
              {(detail?.journal ?? []).length === 0 && (
                <li class="text-bo-muted">
                  Rien pour l'instant — les événements s'ajouteront tout seuls.
                </li>
              )}
            </ol>
          </section>
        </div>

        {/* ============================================================ */}
        {/* Colonne de droite : ce qu'on consulte                        */}
        {/* ============================================================ */}
        <div class="space-y-6">
          <section id="client" class="rounded-lg border border-bo-border bg-bo-surface px-4 py-3">
            <h3 class="mb-2 font-medium">Client</h3>
            {client ? (
              <div class="space-y-1 text-sm">
                {/* Le nom mène à la fiche CRM : de la commande on remonte à
                    l'historique du client sans repasser par la recherche. */}
                <div>
                  <a
                    href={url(`/clients/${client.id}`)}
                    class="text-bo-accent hover:underline"
                  >
                    {client.name || "Voir la fiche client"}
                  </a>
                </div>
                {client.email && (
                  <a
                    href={`mailto:${client.email}`}
                    class="block text-bo-accent hover:underline"
                  >
                    {client.email}
                  </a>
                )}
                {order.shippingPhone && (
                  <div class="text-bo-muted">{order.shippingPhone}</div>
                )}
                {/* L'adresse de facturation (18/11) : l'adresse par défaut du
                    compte du client au moment de commander, celle de la
                    facture. Absente avant : la facture reprend la livraison. */}
                {order.billingLine1 && (
                  <div class="pt-1">
                    <p class="text-xs text-bo-muted">Facturation</p>
                    <p>
                      {order.billingName && <span class="block">{order.billingName}</span>}
                      <span class="block">
                        {[order.billingLine1, order.billingLine2].filter(Boolean).join(", ")}
                      </span>
                      <span class="block">
                        {[order.billingPostalCode, order.billingCity, order.billingCountry]
                          .filter(Boolean)
                          .join(" ")}
                      </span>
                    </p>
                  </div>
                )}
                <p class="text-bo-muted">
                  {detail?.commandesDuClient ?? 0} commande{(detail?.commandesDuClient ?? 0) > 1 ? "s" : ""} au total
                </p>
              </div>
            ) : (
              <p class="text-sm text-bo-muted">
                Aucun client rattaché — commande prise au salon.
              </p>
            )}
          </section>

          <section id="adresse-livraison" class="rounded-lg border border-bo-border bg-bo-surface px-4 py-3">
            <h3 class="mb-2 font-medium">Adresse de livraison</h3>
            {/* Où va la commande : le lieu de retrait choisi à la caisse
                (nom, adresse, texte, tels que la cliente les a lus), ou le
                point relais. L'API dit lequel (`lieuRetrait`) : les
                commandes d'avant les lieux de retrait, prises sur un stand
                (« stand:… »), y sont déjà reconnues. */}
            {lieuRetrait ? (
              <div class="mb-2 rounded bg-bo-bg px-2 py-1.5 text-sm">
                <p>
                  Retrait sur place : <strong class="font-medium">{lieuRetrait.nom}</strong>
                </p>
                {lieuRetrait.adresse && (
                  <p class="whitespace-pre-line text-bo-muted">{lieuRetrait.adresse}</p>
                )}
                {lieuRetrait.description && (
                  <p class="mt-1 whitespace-pre-line text-xs text-bo-muted">
                    {lieuRetrait.description}
                  </p>
                )}
              </div>
            ) : (
              order.relayPointLabel && (
                <p class="mb-2 rounded bg-bo-bg px-2 py-1 text-sm">
                  Point relais : {order.relayPointLabel}
                </p>
              )
            )}
            {order.shippingLine1 || order.shippingName ? (
              <div class="space-y-0.5 text-sm">
                <div>{order.shippingName ?? "—"}</div>
                {order.shippingLine1 && <div>{order.shippingLine1}</div>}
                {order.shippingLine2 && <div>{order.shippingLine2}</div>}
                <div>
                  {[order.shippingPostalCode, order.shippingCity]
                    .filter(Boolean)
                    .join(" ")}
                </div>
                {order.shippingCountry && <div>{order.shippingCountry}</div>}
              </div>
            ) : (
              <p class="text-sm text-bo-muted">
                {lieuRetrait || order.shippingLabel === "Retrait sur place"
                  ? "Retrait sur place — pas d'adresse. S'il faut l'expédier quand même, saisissez-la ci-dessous ou dans le bloc du bordereau."
                  : "Aucune adresse enregistrée."}
              </p>
            )}
            <details class="mt-2">
              <summary class="cursor-pointer text-sm text-bo-accent">Modifier</summary>
              <form method="POST" class="mt-2 space-y-2 text-sm">
                <input type="hidden" name="_action" value="adresse" />
                <input
                  name="shippingName"
                  value={order.shippingName ?? ""}
                  placeholder="Nom"
                  class="w-full rounded border border-bo-border px-2 py-1"
                />
                <input
                  name="shippingLine1"
                  value={order.shippingLine1 ?? ""}
                  placeholder="Adresse"
                  class="w-full rounded border border-bo-border px-2 py-1"
                />
                <input
                  name="shippingLine2"
                  value={order.shippingLine2 ?? ""}
                  placeholder="Complément"
                  class="w-full rounded border border-bo-border px-2 py-1"
                />
                <div class="flex gap-2">
                  <input
                    name="shippingPostalCode"
                    value={order.shippingPostalCode ?? ""}
                    placeholder="Code postal"
                    class="w-28 rounded border border-bo-border px-2 py-1"
                  />
                  <input
                    name="shippingCity"
                    value={order.shippingCity ?? ""}
                    placeholder="Ville"
                    class="flex-1 rounded border border-bo-border px-2 py-1"
                  />
                </div>
                <input
                  name="shippingCountry"
                  value={order.shippingCountry ?? ""}
                  placeholder="Pays (FR, BE, CH…)"
                  list="bo-pays"
                  maxlength="2"
                  pattern="[A-Za-z]{2}"
                  title="Le code du pays, en deux lettres : FR, BE, CH…"
                  class="w-full rounded border border-bo-border px-2 py-1 uppercase"
                />
                {/* Une seule liste pour toute la page : les formulaires
                    d'adresse du bloc du bordereau s'en servent aussi. */}
                <datalist id="bo-pays">
                  {PAYS_PROPOSES.map((p) => (
                    <option value={p.code}>{p.nom}</option>
                  ))}
                </datalist>
                <input
                  name="shippingPhone"
                  value={order.shippingPhone ?? ""}
                  placeholder="Téléphone"
                  class="w-full rounded border border-bo-border px-2 py-1"
                />
                <button class="rounded bg-bo-nav px-3 py-1.5 text-white">
                  Enregistrer l'adresse
                </button>
              </form>
            </details>
          </section>

          <section id="etiquettes" class="rounded-lg border border-bo-border bg-bo-surface px-4 py-3">
            <h3 class="mb-2 font-medium">Étiquettes</h3>
            <form method="POST" class="space-y-2 text-sm">
              <input type="hidden" name="_action" value="etiquettes" />
              <input
                name="tags"
                value={(order.tags ?? []).join(", ")}
                placeholder="cadeau, urgent, stand de Nantes"
                class="w-full rounded border border-bo-border px-2 py-1"
              />
              <p class="text-xs text-bo-muted">Séparées par des virgules.</p>
              <button class="rounded border border-bo-border px-3 py-1.5 hover:bg-bo-bg">
                Enregistrer
              </button>
            </form>
          </section>

          {/* Annuler : le geste qu'on cherche neuf fois sur dix quand on
              croit vouloir supprimer. Il se range donc JUSTE AVANT la
              suppression, pour qu'on le rencontre en premier. */}
          {/* Une vente du stand naît payée et terminée (19/11) : elle s'annule
              quand même, à tout moment, si le client ne paie pas ou autre.
              Rien à rembourser (l'argent se règle de la main à la main) :
              son encaissement sur place sort du grand livre. */}
          {!annulee && !estPanier && (
            <section class="rounded-lg border border-amber-300 bg-bo-surface px-4 py-3">
              <h3 class="mb-2 font-medium text-amber-900">
                {auStand ? "Annuler la vente" : "Annuler la commande"}
              </h3>
              <p class="mb-2 text-sm text-bo-muted">
                {auStand
                  ? "Le client n'a pas payé, ou autre : la vente reste lisible et garde son histoire, mais elle sort de vos chiffres et du grand livre. Aucun courriel n'est envoyé."
                  : "La commande reste lisible et garde toute son histoire. Elle sort de vos chiffres, ne peut plus rien expédier, et le client est prévenu par courrier."}
              </p>
              {!auStand && resteAExpedier < nbArticles && (
                <p class="mb-2 rounded bg-amber-50 px-2 py-1 text-sm text-amber-900">
                  {nbArticles - resteAExpedier} article(s) sont déjà partis :
                  l'annulation sera refusée. Annulez d'abord l'expédition si le
                  colis n'est pas réellement parti, sinon remboursez ce qui
                  revient.
                </p>
              )}
              {!auStand && encaisse && resteSiPasRembourse > 0 ? (
                <p class="text-sm text-bo-muted">
                  Cette commande a été payée : pour l'annuler, ouvrez
                  « Rembourser » (bloc Paiement) et cochez « Annuler aussi la
                  commande ». L'argent et l'annulation partent ensemble.
                </p>
              ) : (
              <details>
                <summary class="cursor-pointer text-sm text-bo-accent">
                  Annuler {order.number}
                </summary>
                <form
                  method="POST"
                  class="mt-2 space-y-2 text-sm"
                  data-confirmer={`Annuler la commande ${order.number} ? Elle sort de vos chiffres et ne peut plus rien expédier.`}
                >
                  <input type="hidden" name="_action" value="annuler" />
                  <label class="block">
                    <span class="mb-1 block text-xs text-bo-muted">Motif</span>
                    <select
                      name="motif"
                      class="w-full rounded border border-bo-border px-2 py-1"
                    >
                      {MOTIFS_ANNULATION.map(([valeur, libelle]) => (
                        <option value={valeur} selected={auStand && valeur === "impaye"}>
                          {libelle}
                        </option>
                      ))}
                    </select>
                  </label>
                  <label class="block">
                    <span class="mb-1 block text-xs text-bo-muted">
                      {auStand ? "Précision (gardée au journal)" : "Précision (écrite au client)"}
                    </span>
                    <input
                      name="motifLibre"
                      placeholder="Le fond choisi n'est plus disponible"
                      class="w-full rounded border border-bo-border px-2 py-1"
                    />
                  </label>
                  <label class="block">
                    <span class="mb-1 block text-xs text-bo-muted">
                      Note interne (jamais envoyée)
                    </span>
                    <input
                      name="noteAnnul"
                      class="w-full rounded border border-bo-border px-2 py-1"
                    />
                  </label>

                  {encaisse && resteSiPasRembourse <= 0 && (
                    <p class="text-xs text-bo-muted">
                      Tout a déjà été remboursé sur cette commande : il n'y a
                      plus rien à rendre.
                    </p>
                  )}
                  {!encaisse && (
                    <p class="text-xs text-bo-muted">
                      Cette commande n'a jamais été encaissée : il n'y a rien à
                      rembourser. Une écriture d'annulation sera portée au grand
                      livre, pour que la page Finances reste juste.
                    </p>
                  )}

                  <label class="flex items-center gap-2">
                    <input type="checkbox" name="restockAnnul" />
                    Remettre les articles en stock
                    <span class="text-xs text-bo-muted">
                      (sans effet sur les affiches, imprimées à la commande)
                    </span>
                  </label>
                  <button class="rounded border border-amber-400 px-3 py-1.5 text-amber-900 hover:bg-amber-50">
                    {auStand ? "Annuler cette vente" : "Annuler cette commande"}
                  </button>
                </form>
              </details>
              )}
            </section>
          )}

          {/* En dernier : ranger une commande, ce qui se défait. Archivée,
              elle peut ensuite être supprimée pour de bon — mais seulement
              un panier ou une commande jamais payée : l'API refuse tout ce
              qui a une facture, de l'argent, un remboursement ou un colis,
              et sa phrase s'affiche en haut de la fiche. */}
          <section class="rounded-lg border border-bo-border bg-bo-surface px-4 py-3">
            <h3 class="mb-2 font-medium">
              {order.archivedAt ? "Commande archivée" : auStand ? "Supprimer la vente" : "Archiver la commande"}
            </h3>
            {order.archivedAt ? (
              <>
                <p class="mb-3 text-sm text-bo-muted">
                  Elle ne s'affiche plus dans la liste ordinaire, ni dans
                  l'export : elle attend dans l'onglet « Archivées ». La
                  recherche la trouve toujours par son numéro, marquée
                  « Archivée ». Rien n'a été effacé, et son statut n'a pas
                  bougé.
                </p>
                <form method="POST">
                  <input type="hidden" name="_action" value="archiver-commande" />
                  <input type="hidden" name="archived" value="false" />
                  <button class="rounded border border-bo-border px-3 py-1.5 text-sm hover:bg-bo-bg">
                    Restaurer {order.number}
                  </button>
                </form>
                <p class="mt-3 mb-2 text-xs text-bo-muted">
                  Un panier ou une commande jamais payée peut aussi être
                  supprimé pour de bon. Une commande payée, remboursée ou
                  facturée, jamais : ses pièces comptables se gardent dix ans.
                </p>
                <form
                  method="POST"
                  onsubmit={`return confirm(${JSON.stringify(
                    `Supprimer définitivement « ${order.number} » ? C'est sans retour.`,
                  )})`}
                >
                  <input type="hidden" name="_action" value="supprimer-commande" />
                  <input type="hidden" name="numero" value={order.number} />
                  <input type="hidden" name="canal" value={order.channel} />
                  <button class="text-sm text-red-700 hover:underline">
                    Supprimer définitivement
                  </button>
                </form>
              </>
            ) : (
              <>
                {!auStand && (
                <p class="mb-3 text-sm text-bo-muted">
                  Elle quitte la liste et l'export, et se range dans l'onglet
                  « Archivées », d'où elle se restaure ; la recherche
                  continue de la trouver, marquée « Archivée ». Rien n'est
                  effacé : ses articles, ses expéditions, son argent et sa
                  chronologie restent, et son statut ne change pas — une
                  vente archivée compte toujours dans vos chiffres. Pour
                  qu'elle cesse d'y compter, annulez-la plutôt.
                </p>
                )}
                {/* Au stand, plus d'archivage (19/11) : l'onglet « Archivées »
                    n'y est plus affiché, la vente deviendrait introuvable. On
                    l'annule, ou on la supprime. */}
                {!auStand && (
                <form
                  method="POST"
                  onsubmit="return confirm('Archiver cette commande ? Elle quitte la liste et se range dans « Archivées », d\'où vous pourrez la restaurer. Rien n\'est supprimé.')"
                >
                  <input type="hidden" name="_action" value="archiver-commande" />
                  <input type="hidden" name="archived" value="true" />
                  <button class="rounded border border-bo-border px-3 py-1.5 text-sm hover:bg-bo-bg">
                    Archiver {order.number}
                  </button>
                </form>
                )}
                {/* Supprimer pour de bon, sans passer par les archivées
                    (19/11). Une vente du stand part même payée ; une commande
                    du site payée, facturée ou remboursée est gardée, et la
                    raison s'affiche en haut de la fiche. */}
                <form
                  method="POST"
                  class="mt-3"
                  onsubmit={`return confirm(${JSON.stringify(
                    `Supprimer définitivement « ${order.number} » ? C'est sans retour : elle part avec ses lignes, son journal et ses fichiers d'impression.`,
                  )})`}
                >
                  <input type="hidden" name="_action" value="supprimer-commande" />
                  <input type="hidden" name="numero" value={order.number} />
                  <input type="hidden" name="canal" value={order.channel} />
                  <button class="text-sm text-red-700 hover:underline">
                    Supprimer définitivement
                  </button>
                </form>
              </>
            )}
          </section>

          <section id="note-interne" class="rounded-lg border border-bo-border bg-bo-surface px-4 py-3">
            <h3 class="mb-2 font-medium">Note interne</h3>
            <form method="POST" class="space-y-2 text-sm">
              <input type="hidden" name="_action" value="note" />
              <textarea
                name="note"
                rows="4"
                placeholder="« À envoyer avec la commande #2141 »"
                class="w-full rounded border border-bo-border px-2 py-1"
                set:text={order.internalNote ?? ""}
              />
              <button class="rounded border border-bo-border px-3 py-1.5 hover:bg-bo-bg">
                Enregistrer
              </button>
            </form>
          </section>

          {remboursements.length > 0 && (
            <section id="remboursements" class="rounded-lg border border-bo-border bg-bo-surface px-4 py-3">
              <h3 class="mb-2 font-medium">Remboursements</h3>
              <ul class="space-y-2 text-sm">
                {remboursements.map((r) => (
                  <li>
                    <div class="flex justify-between">
                      <span class="text-violet-700">− {formatPrice(r.amountCents)}</span>
                      <span class="text-xs text-bo-muted">{quand(r.createdAt)}</span>
                    </div>
                    {r.reason && <div class="text-bo-muted">{r.reason}</div>}
                    {r.note && <div class="text-xs text-bo-muted">{r.note}</div>}
                  </li>
                ))}
              </ul>
            </section>
          )}
        </div>
      </div>
    </>
  )}
  <script is:inline>
    // Bordereau : le bouton porte le prix de l'option cochée, et l'achat
    // redemande confirmation en redisant le montant — c'est de l'argent qui
    // part chez SendCloud au clic. Le bouton se désactive aussitôt : un
    // second clic ne ferait rien de plus (la clé de demande est la même),
    // mais il n'a pas à laisser croire le contraire.
    (function () {
      var achat = document.getElementById("ml-achat-bordereau");
      if (achat) {
        var bouton = achat.querySelector("[data-bouton-achat]");
        var essai = achat.getAttribute("data-essai") === "1";
        var coche = function () {
          return achat.querySelector('input[name="methode"]:checked');
        };
        var attribut = function (nom) {
          var r = coche();
          return r ? r.getAttribute(nom) || "" : "";
        };
        var prixCoche = function () {
          return attribut("data-prix");
        };
        if (!essai)
          achat.addEventListener("change", function () {
            var p = prixCoche();
            bouton.textContent = "Acheter le bordereau — " + (p || "prix inconnu");
          });
        // La confirmation nomme le service et redit son écart avec le mode
        // payé : depuis « Voir tous les services », un Chrono samedi ou un
        // autre transporteur se coche d'un clic, et l'étiquette achetée ne se
        // modifie plus.
        achat.addEventListener("submit", function (e) {
          var p = prixCoche();
          var nom = attribut("data-nom");
          var ecart = attribut("data-ecart");
          var service = nom ? " « " + nom + " »" : "";
          var alerte = ecart ? "\n\nÀ vérifier : " + ecart + "." : "";
          var ok = essai
            ? window.confirm(
                "Fabriquer un bordereau d'ESSAI" +
                  service +
                  " (lettre non affranchie, gratuite) ?" +
                  alerte,
              )
            : window.confirm(
                "Acheter le bordereau" +
                  service +
                  " chez SendCloud pour " +
                  (p || "un prix non communiqué") +
                  " ?" +
                  alerte +
                  "\n\nLe montant est prélevé dès la création de l'étiquette.",
              );
          if (!ok) {
            e.preventDefault();
            return;
          }
          bouton.disabled = true;
          bouton.textContent = "Achat en cours…";
        });
      }
      document.querySelectorAll("form[data-confirmer]").forEach(function (f) {
        f.addEventListener("submit", function (e) {
          if (!window.confirm(f.getAttribute("data-confirmer"))) e.preventDefault();
        });
      });
    })();
  </script>
  {/* Les PDF d'impression : prêt, en préparation, ou impossible et pourquoi. */}
  <script>
    import "../../lib/impression-bo.ts";

    // Le bloc « Rembourser » : passer de l'euro au pourcentage remet le champ
    // sur « tout » dans la nouvelle unité (le reste, ou 100 %), et la ligne
    // d'à côté dit ce que le montant représente. Sans script, le formulaire
    // marche quand même : le serveur fait le calcul.
    for (const form of document.querySelectorAll<HTMLFormElement>("form[data-remboursement]")) {
      const montant = form.querySelector<HTMLInputElement>('input[name="montant"]');
      const unite = form.querySelector<HTMLSelectElement>('select[name="unite"]');
      const equivaut = form.querySelector<HTMLElement>("[data-equivaut]");
      const annuler = form.querySelector<HTMLInputElement>("[data-annuler-aussi]");
      const champs = form.querySelector<HTMLElement>("[data-champs-annulation]");
      if (!montant || !unite) continue;
      const reste = Number(montant.dataset.reste) || 0;
      const euros = (c: number) =>
        (c / 100).toLocaleString("fr-FR", { style: "currency", currency: "EUR" });
      const centimes = () => {
        const v = Number(montant.value.replace(",", ".")) || 0;
        return unite.value === "pct" ? Math.round((reste * Math.min(100, Math.max(0, v))) / 100) : Math.round(v * 100);
      };
      const dire = () => {
        if (!equivaut) return;
        const c = centimes();
        equivaut.textContent =
          c >= reste
            ? `Tout ce qui reste : ${euros(reste)}.`
            : `Soit ${euros(c)} sur ${euros(reste)} remboursables.`;
      };
      unite.addEventListener("change", () => {
        if (unite.value === "pct") {
          // Pas de 0,01 comme en euros : avec un pas de 1 compté depuis le
          // min de 0,01, le navigateur refusait 50 % ou 100 % (recette du
          // 17/11 : seuls 1,01 %, 2,01 %… passaient).
          montant.max = "100";
          montant.step = "0.01";
          montant.value = "100";
        } else {
          montant.max = (reste / 100).toFixed(2);
          montant.step = "0.01";
          montant.value = (reste / 100).toFixed(2);
        }
        dire();
      });
      montant.addEventListener("input", dire);
      annuler?.addEventListener("change", () => {
        if (champs) champs.hidden = !annuler.checked;
      });
    }
  </script>
</Admin>
