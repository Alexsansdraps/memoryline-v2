---
/**
 * Fiche d'une commande.
 *
 * Deux colonnes, comme dans Shopify : à GAUCHE ce qu'on FAIT (expédier,
 * rembourser, commenter), à DROITE ce qu'on CONSULTE (le client, ses adresses,
 * les notes, les étiquettes). La séparation n'est pas cosmétique — elle évite
 * de chercher le bouton d'expédition au milieu d'une adresse.
 *
 * Aucun statut n'est stocké ici : ils viennent tous de l'API, calculés à
 * partir des expéditions et des remboursements enregistrés.
 */
import { apiUrl, url } from "../../lib/url.ts";
import { libelleFormat } from "@memoryline/types";
import Admin from "../../layouts/Admin.astro";
import {
  adminApi,
  formatPrice,
  lignesDeLAffiche,
  type Bordereau,
  type OrderDetail,
} from "../../lib/api.ts";

const id = Number(Astro.params.id);
const api = adminApi(Astro.request);

let flash: string | null = null;
let flashErreur = false;

if (Astro.request.method === "POST") {
  const f = await Astro.request.formData();
  const action = f.get("_action");
  try {
    if (action === "expedier") {
      // Quantités saisies ligne par ligne : `qte-<id>` porte ce qui part.
      const items: { orderItemId: number; quantity: number }[] = [];
      for (const [cle, valeur] of f.entries()) {
        if (!cle.startsWith("qte-")) continue;
        const q = Math.max(0, Number(valeur) || 0);
        if (q > 0) items.push({ orderItemId: Number(cle.slice(4)), quantity: q });
      }
      await api.createFulfillment(id, {
        items,
        carrier: String(f.get("carrier") ?? ""),
        trackingNumber: String(f.get("trackingNumber") ?? ""),
        // Quand une étiquette est jointe, c'est ELLE qui dit le transporteur
        // et le numéro : l'API les relit sur la ligne et ignore le reste du
        // formulaire, qui ne pourrait que contredire ce qui est déjà collé
        // sur le carton.
        bordereauId: Number(f.get("bordereauId")) || undefined,
      });
      // Au stand, il n'y a pas de colis : le mot doit dire ce qui s'est passé.
      flash = f.get("remise")
        ? "Affiche remise au client."
        : "Expédition enregistrée.";
    } else if (action === "deposer-bordereau") {
      /*
       * Le dépôt de l'étiquette achetée chez le transporteur.
       *
       * Ce geste n'expédie RIEN et n'écrit à personne : il range le PDF et
       * retient le numéro de suivi, pour que le bouton d'expédition n'ait plus
       * rien à retaper. C'est « Enregistrer l'expédition » qui fait partir le
       * colis, et lui seul qui prévient la cliente.
       */
      const fichier = f.get("fichier");
      if (!(fichier instanceof File) || !fichier.size) {
        flash =
          "Aucun fichier reçu : choisissez le PDF de l'étiquette téléchargé chez le transporteur.";
        flashErreur = true;
      } else {
        const b = await api.deposerBordereau(id, {
          fichier,
          transporteur: String(f.get("transporteur") ?? ""),
          trackingNumber: String(f.get("trackingNumber") ?? ""),
          trackingUrl: String(f.get("trackingUrl") ?? ""),
          poidsGrammes: Math.max(
            0,
            Math.floor(Number(f.get("poidsGrammes")) || 0),
          ),
        });
        // Le mot dit ce qui vient de se passer ET ce qui ne s'est pas passé :
        // sans la seconde moitié, on croit le colis annoncé à la cliente.
        flash = `Bordereau ${b.transporteurNom} joint, suivi ${b.trackingNumber}. Rien n'est parti : la cliente sera prévenue à l'enregistrement de l'expédition.`;
      }
    } else if (action === "retirer-bordereau") {
      await api.retirerBordereau(Number(f.get("bordereauId")));
      flash =
        "Bordereau retiré : vous pouvez en joindre un autre. Le fichier, lui, reste sur le serveur — une étiquette a coûté de l'argent.";
    } else if (action === "archiver-commande") {
      const restaurer = String(f.get("archived") ?? "") === "false";
      await api.archiverCommande(id, !restaurer);
      if (restaurer) {
        flash = "Commande restaurée : elle revient dans la liste ordinaire.";
      } else {
        // Un retour à la liste des archivées plutôt qu'un rendu : la commande
        // vient de quitter la liste ordinaire, et c'est là qu'on la retrouve.
        return Astro.redirect(`${url("/commandes")}?onglet=archivees`);
      }
    } else if (action === "annuler-expedition") {
      await api.cancelFulfillment(Number(f.get("fulfillmentId")));
      flash = "Expédition annulée.";
    } else if (action === "rembourser") {
      const items: { orderItemId: number; quantity: number }[] = [];
      for (const [cle, valeur] of f.entries()) {
        if (!cle.startsWith("remb-")) continue;
        const q = Math.max(0, Number(valeur) || 0);
        if (q > 0) items.push({ orderItemId: Number(cle.slice(5)), quantity: q });
      }
      const r = await api.refundOrder(id, {
        items,
        shippingCents: Math.round(Number(f.get("portEuros") ?? 0) * 100) || 0,
        reason: String(f.get("reason") ?? ""),
        note: String(f.get("noteRemb") ?? ""),
        restock: f.get("restock") === "on",
        viaPsp: f.get("viaPsp") === "on",
        author: Astro.locals.user?.email ?? undefined,
      });
      flash = `Remboursement de ${formatPrice(r.amountCents)} enregistré.`;
    } else if (action === "annuler") {
      const r = await api.annulerCommande(id, {
        motif: String(f.get("motif") ?? ""),
        motifLibre: String(f.get("motifLibre") ?? ""),
        rembourser: f.get("rembourser") === "on",
        restock: f.get("restockAnnul") === "on",
        viaPsp: f.get("viaPspAnnul") === "on",
        note: String(f.get("noteAnnul") ?? ""),
        author: Astro.locals.user?.email ?? undefined,
      });
      // Le mot rend compte de TOUT ce qui vient de se passer, y compris de ce
      // qui ne s'est pas passé : une commande payée annulée sans remboursement
      // laisse de l'argent à rendre, et c'est le seul moment où quelqu'un le
      // verra écrit.
      flash =
        `Commande ${r.numero} annulée.` +
        (r.rembourseCents > 0
          ? ` ${formatPrice(r.rembourseCents)} remboursés.`
          : "") +
        (r.resteADevoir > 0
          ? ` Attention : ${formatPrice(r.resteADevoir)} restent à rendre à la cliente — aucun remboursement n'a été enregistré.`
          : "");
    } else if (action === "encaisser") {
      const r = await api.encaisserCommande(id, {
        moyen: String(f.get("moyen") ?? ""),
        reference: String(f.get("reference") ?? ""),
        author: Astro.locals.user?.email ?? undefined,
      });
      flash = r.deja
        ? (r.message ?? "Cette commande était déjà marquée payée.")
        : `Commande encaissée : ${formatPrice(r.montantCents ?? 0)} reçus par ${r.moyen}. La confirmation est partie chez la cliente et les fichiers d'impression sont prêts.`;
    } else if (action === "envoyer-facture") {
      const r = await api.envoyerFacture(id, Astro.locals.user?.email ?? undefined);
      flash = `Facture ${r.numeroFacture} envoyée à ${r.destinataire}.`;
    } else if (action === "note") {
      await api.setOrderNote(id, String(f.get("note") || ""));
      flash = "Note enregistrée.";
    } else if (action === "etiquettes") {
      const tags = String(f.get("tags") ?? "")
        .split(",")
        .map((t) => t.trim())
        .filter(Boolean);
      await api.setOrderTags(id, tags);
      flash = "Étiquettes enregistrées.";
    } else if (action === "adresse") {
      await api.updateOrderAddress(id, {
        shippingName: String(f.get("shippingName") ?? ""),
        shippingLine1: String(f.get("shippingLine1") ?? ""),
        shippingLine2: String(f.get("shippingLine2") ?? ""),
        shippingPostalCode: String(f.get("shippingPostalCode") ?? ""),
        shippingCity: String(f.get("shippingCity") ?? ""),
        shippingCountry: String(f.get("shippingCountry") ?? ""),
        shippingPhone: String(f.get("shippingPhone") ?? ""),
      });
      flash = "Adresse mise à jour.";
    } else if (action === "renvoyer") {
      await api.resendConfirmation(id);
      flash = "Confirmation renvoyée au client.";
    } else if (action === "commentaire") {
      const message = String(f.get("message") || "").trim();
      if (message) {
        await api.addOrderComment(
          id,
          message,
          Astro.locals.user?.email ?? undefined,
        );
        flash = "Commentaire publié.";
      }
    }
  } catch (e) {
    // La PHRASE de l'API, pas l'objet qui la porte. Le client la remonte déjà
    // telle quelle (« Ce fichier porte bien .pdf, mais son contenu n'en est
    // pas un ») ; `String(e)` la préfixait d'un « Error: » qui ne veut rien
    // dire pour qui lit, et qui faisait commencer le bandeau par
    // « Erreur : Error: ».
    flash = "Erreur : " + (e instanceof Error ? e.message : String(e));
    flashErreur = true;
  }
}

let detail: OrderDetail | null = null;
let error: string | null = null;
try {
  detail = await api.orderDetail(id);
} catch (e) {
  error = String(e);
}

const order = detail?.order;
const items = detail?.items ?? [];
const client = detail?.customer ?? null;
const expeditions = detail?.expeditions ?? [];
/**
 * Une commande prise au stand n'est pas expédiée : l'affiche est remise au
 * client, sur place. Pas de transporteur, pas de numéro de suivi — juste
 * « c'est fait ».
 */
const auStand = order?.channel === "salon";
const remboursements = detail?.remboursements ?? [];
const mouvements = detail?.mouvements ?? [];

/** « 27 août 2026 à 22:36 » */
function quand(iso: string | null | undefined): string {
  if (!iso) return "";
  try {
    const d = new Date(iso);
    return `${d.toLocaleDateString("fr-FR", { day: "numeric", month: "long", year: "numeric" })} à ${d.toLocaleTimeString("fr-FR", { hour: "2-digit", minute: "2-digit" })}`;
  } catch {
    return "";
  }
}

const NOM_CANAL: Record<string, string> = {
  web: "Boutique en ligne",
  salon: "Ventes stand",
};

const BADGE_PAIEMENT: Record<string, { texte: string; classe: string }> = {
  paid: { texte: "Payée", classe: "bg-bo-bg text-bo-ink" },
  pending: {
    texte: "En attente de paiement",
    classe: "bg-amber-100 text-amber-900",
  },
  authorized: { texte: "Autorisée", classe: "bg-sky-100 text-sky-900" },
  partially_refunded: {
    texte: "Remboursée en partie",
    classe: "bg-violet-100 text-violet-900",
  },
  refunded: { texte: "Remboursée", classe: "bg-violet-100 text-violet-900" },
  voided: { texte: "Annulée", classe: "bg-bo-bg text-bo-muted" },
  draft: { texte: "Panier", classe: "bg-bo-bg text-bo-muted" },
};
const BADGE_TRAITEMENT: Record<string, { texte: string; classe: string }> = {
  fulfilled: { texte: "Traitée", classe: "bg-green-100 text-green-900" },
  partially_fulfilled: {
    texte: "Partiellement traitée",
    classe: "bg-orange-100 text-orange-900",
  },
  unfulfilled: { texte: "Non traitée", classe: "bg-amber-100 text-amber-900" },
};

/** Montants : la remise se déduit de ce qui a réellement été facturé. */
const sousTotal = items.reduce(
  (s, it) => s + it.unitPriceCents * it.quantity,
  0,
);
const nbArticles = items.reduce((s, it) => s + it.quantity, 0);
const port = order?.shippingCents ?? 0;
const total = order?.totalCents ?? 0;
const remise = Math.max(0, sousTotal + port - total);
const rembourse = detail?.rembourseCents ?? 0;
const portRemboursable = detail?.portRemboursableCents ?? 0;
const netEncaisse = total - rembourse;

/**
 * Les paiements arrivés chez le prestataire SANS avoir validé la commande :
 * un montant qui ne correspondait plus au panier (« montant_different »), ou
 * un second paiement sur une commande déjà payée (« en_trop »). L'argent est
 * à rendre. Affiché sous « Encaissé », il laissait croire que la commande
 * était réglée — juste au-dessus du bouton qui la marque payée.
 */
const STATUTS_A_REMBOURSER = ["montant_different", "en_trop"];
const aRembourser = (detail?.paiements ?? []).filter((p) =>
  STATUTS_A_REMBOURSER.includes(p.status ?? ""),
);
const paiement =
  (detail?.paiements ?? []).find((p) => p.status === "succeeded") ??
  (detail?.paiements ?? []).find(
    (p) => !STATUTS_A_REMBOURSER.includes(p.status ?? ""),
  );
const encaisse = order?.status === "paid";

const badgePaiement = BADGE_PAIEMENT[detail?.statutFinancier ?? "pending"]!;
const badgeTraitement =
  BADGE_TRAITEMENT[detail?.statutExpedition ?? "unfulfilled"]!;

/** Ce qui reste à envoyer, et ce qui reste remboursable. */
const resteAExpedier = items.reduce((s, it) => s + (it.aExpedier ?? 0), 0);
const resteARembourser = items.reduce((s, it) => s + (it.aRembourser ?? 0), 0);

/**
 * La commande est-elle annulée ?
 *
 * On lit le statut brut plutôt que le badge : celui-ci range « annulée » et
 * « remboursée » au même endroit visuel, alors que les deux n'autorisent pas
 * du tout les mêmes gestes.
 */
const annulee = order?.status === "cancelled" || order?.status === "voided";

/**
 * Le panier n'est pas une commande. Elle ne s'encaisse pas, ne s'annule pas,
 * ne se facture pas — elle se reprend ou elle s'oublie.
 */
const estPanier = order?.status === "draft";

/** Peut-on encore encaisser un règlement arrivé hors du site ? */
const encaissableALaMain = !!order && !encaisse && !annulee && !estPanier && !auStand;

/** Ce que l'annulation laisserait en suspens si elle ne remboursait pas. */
const resteSiPasRembourse = encaisse ? total - rembourse : 0;

/** Les motifs d'annulation, dans l'ordre où ils se présentent à l'esprit. */
const MOTIFS_ANNULATION = [
  ["cliente", "Demande de la cliente"],
  ["rupture", "Rupture — article indisponible"],
  ["saisie", "Erreur de saisie"],
  ["impaye", "Paiement non reçu"],
  ["autre", "Autre (précisez)"],
];

/** Les moyens de règlement qui n'ont pas de prestataire. */
const MOYENS_HORS_LIGNE = [
  ["virement", "Virement bancaire"],
  ["cheque", "Chèque"],
  ["especes", "Espèces"],
  ["autre", "Autre"],
];

/* ---------------------------------------------------------------------- */
/* Le bordereau transporteur                                               */
/* ---------------------------------------------------------------------- */

/**
 * Peut-on encore joindre une étiquette ?
 *
 * La même condition que « Traiter les articles » juste en dessous : joindre
 * le bordereau et enregistrer l'expédition sont les deux gestes d'un même
 * colis, ils apparaissent et disparaissent ensemble.
 *
 * Une vente au stand en est écartée — l'affiche est remise en main propre, il
 * n'y a pas de colis à étiqueter. La route du dépôt oppose le même refus de
 * son côté : un écran qui masque un bouton est une politesse, pas une garde.
 */
const peutDeposer = resteAExpedier > 0 && !annulee && !auStand;

/**
 * Les bordereaux de la commande, les retirés compris.
 *
 * Un appel de plus, borné à ce qui peut en avoir : l'API répond « rien ici »
 * à un vendeur, et une vente au stand n'a pas de colis. S'il échoue, la fiche
 * reste entière — une étiquette manquante n'empêche ni de rembourser, ni
 * d'annuler, ni de lire la commande.
 */
let bordereaux: Bordereau[] = [];
if (order && !auStand) {
  try {
    bordereaux = await api.bordereauxDeLaCommande(id);
  } catch {
    /* Bloc replié sur son état le plus simple : aucune étiquette connue. */
  }
}

/**
 * Le bordereau VIVANT : ni retiré, ni annulé chez le transporteur.
 *
 * Il n'y en a jamais qu'un — un index de base le garantit. Les autres restent
 * dans la liste, et c'est voulu : « retiré » n'est pas « supprimé », et on
 * doit pouvoir retrouver l'étiquette qu'on vient de remplacer.
 */
const bordereau =
  bordereaux.find((b) => !b.retireAt && b.statut !== "annule") ?? null;
const bordereauxRetires = bordereaux.filter((b) => b.id !== bordereau?.id);

/**
 * Le bordereau a-t-il déjà servi ? Alors le colis est parti avec.
 *
 * UNE EXPÉDITION ANNULÉE NE COMPTE PAS, et s'arrêter à `fulfillmentId`
 * fermait la seule porte de sortie. Ce champ n'est jamais remis à null : il
 * est posé à l'enregistrement de l'expédition, et l'annulation ne supprime pas
 * la ligne — elle pose `status = "cancelled"` et une date. Une étiquette
 * déposée par erreur devenait donc impossible à retirer DÈS qu'une expédition
 * avait existé, pendant que la phrase d'à côté demandait d'annuler cette
 * expédition-là : le geste ne changeait rien, aucune autre étiquette ne
 * pouvait être jointe (le dépôt répond 409), et le formulaire d'expédition
 * cessait de reprendre le transporteur et le numéro — c'est-à-dire qu'il
 * fallait les retaper, à l'endroit exact d'où sort un mauvais lien de suivi.
 *
 * La route de retrait, elle, ne refuse que devant une expédition VIVANTE
 * (`if (expedition && !expedition.cancelledAt)`). L'écran dit maintenant la
 * même chose qu'elle.
 */
const bordereauServi =
  !!bordereau?.fulfillmentId &&
  !expeditions.find((f) => f.id === bordereau?.fulfillmentId)?.cancelledAt;

/**
 * Les transporteurs viennent de l'API, jamais d'une copie locale.
 *
 * La liste de référence vit dans `livraison-regles.ts` ; la fiche en portait
 * jusqu'ici quatre noms écrits à la main, qui ne connaissaient ni GLS, ni DPD,
 * ni les points relais. Deux listes finissent toujours par se contredire, et
 * c'est celle qu'on a sous les yeux qui a tort.
 */
let transporteurs: { code: string; nom: string }[] = [];
/**
 * Le transporteur du mode choisi par la cliente, proposé et jamais imposé :
 * c'est lui qui porte le colis neuf fois sur dix, mais une étiquette achetée
 * ailleurs le contredit parfois, et c'est le bordereau qui a raison.
 */
let transporteurPropose = "";
if (peutDeposer) {
  try {
    const catalogue = await api.shipping();
    transporteurs = catalogue.transporteurs ?? [];
    transporteurPropose =
      catalogue.modes.find((m) => m.slug === order?.shippingMethod)?.carrier ??
      "";
  } catch {
    /* Liste vide : le formulaire le dit lui-même plutôt que de proposer un
       choix incomplet recopié ici. */
  }
}

/**
 * Le poids du colis, tel que la commande l'a figé.
 *
 * Zéro veut dire « personne ne l'a jamais saisi » — c'est le défaut de la
 * colonne, et aucune route d'expédition ne la lisait jusqu'ici. Une étiquette
 * déclarée à 0 g se fait refuser au dépôt ou se paie au mauvais tarif : le
 * champ est donc visible, modifiable, et le dit en rouge quand il est vide.
 */
const poidsColis = order?.weightGrams ?? 0;

/**
 * Un retrait sur place n'est PAS un point relais.
 *
 * `relayPointId` sert à deux choses : l'identifiant du point chez le
 * transporteur, et « stand:<n> » quand la cliente vient chercher son affiche.
 * Copier ce second-là chez SendCloud ferait demander une étiquette vers un
 * point qui n'existe nulle part.
 */
const retraitSurPlace = String(order?.relayPointId ?? "").startsWith("stand:");

/**
 * Ce que le formulaire de SendCloud réclame, dans l'ordre où il le demande.
 *
 * Le poids n'y est pas : il est ajouté au moment du clic, depuis le champ
 * ci-dessous — c'est celui qu'elle vient éventuellement de corriger qu'il faut
 * copier, pas celui qui était là au chargement de la page.
 */
const adresseACopier = [
  order?.shippingName,
  order?.shippingLine1,
  order?.shippingLine2,
  [order?.shippingPostalCode, order?.shippingCity].filter(Boolean).join(" "),
  order?.shippingCountry,
  order?.shippingPhone ? `Téléphone : ${order.shippingPhone}` : null,
  !retraitSurPlace && order?.relayPointLabel
    ? `Point relais : ${order.relayPointLabel}${order.relayPointId ? ` (${order.relayPointId})` : ""}`
    : null,
]
  .filter(Boolean)
  .join("\n");

const LIBELLE_MOUVEMENT: Record<string, string> = {
  sale: "Encaissement",
  authorization: "Autorisation",
  capture: "Capture",
  refund: "Remboursement",
  void: "Annulation",
};

/**
 * Le moyen de paiement, dit comme la boutique le dit.
 *
 * Les mêmes mots que la page Finances, à la virgule près : un même
 * encaissement lu à deux endroits ne doit pas porter deux noms. Sans cette
 * table, la fiche affichait le code de la base — « manuel », avec sa
 * minuscule et sans accent — au milieu de phrases écrites en français.
 */
const LIBELLE_MOYEN: Record<string, string> = {
  stripe: "Stripe",
  paypal: "PayPal",
  stand: "Réglé sur place",
  manuel: "À la main (virement, chèque, espèces)",
};

function libelleMoyen(v: string | null | undefined): string {
  if (!v) return "Moyen non renseigné";
  return LIBELLE_MOYEN[v] ?? v;
}

/**
 * Le lien vers le tableau de bord Stripe n'a de sens que pour un paiement
 * Stripe. Il s'affichait dès qu'une référence existait, si bien qu'un
 * virement encaissé à la main proposait d'aller chercher son numéro de
 * virement chez Stripe, où il n'a jamais été.
 */
const chezStripe = paiement?.provider === "stripe" ? paiement.externalRef : null;
---

<Admin title={order ? `Commande ${order.number}` : `Commande #${id}`}>
  <p class="mb-4">
    <a href={url("/commandes")} class="text-sm text-bo-accent hover:underline">
      ← Retour aux commandes
    </a>
  </p>

  {flash && (
    <p
      class={`mb-4 text-sm rounded px-3 py-2 border ${
        flashErreur ? "bg-red-50 border-red-200" : "bg-green-50 border-green-200"
      }`}
    >
      {flash}
    </p>
  )}
  {error && <p class="mb-4 text-red-600 text-sm">API injoignable : {error}</p>}

  {order && (
    <>
      {/* ============================================================== */}
      {/* En-tête                                                        */}
      {/* ============================================================== */}
      <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
        <div>
          <div class="flex flex-wrap items-center gap-2">
            <h2 class="text-xl font-semibold">{order.number}</h2>
            <span class={`rounded-full px-2 py-0.5 text-xs ${badgePaiement.classe}`}>
              {badgePaiement.texte}
            </span>
            <span class={`rounded-full px-2 py-0.5 text-xs ${badgeTraitement.classe}`}>
              {badgeTraitement.texte}
            </span>
            {/* Dit dès le titre que cette fiche vient du rangement : sans
                cela, on la croit dans la liste et on la cherche en vain. */}
            {order.archivedAt && (
              <span class="rounded-full bg-bo-bg px-2 py-0.5 text-xs text-bo-muted">
                Archivée
              </span>
            )}
          </div>
          <p class="mt-1 text-sm text-bo-muted">
            {quand(order.createdAt)} · {NOM_CANAL[order.channel] ?? order.channel}
            {order.legacyName && ` · ancien n° ${order.legacyName}`}
          </p>
        </div>
        <div class="flex flex-wrap gap-2">
          <a
            href={url(`/commandes/bons?ids=${order.id}`)}
            target="_blank"
            class="rounded border border-bo-border bg-bo-surface px-3 py-2 text-sm hover:bg-bo-bg"
          >
            Bon de livraison
          </a>
          {/* La facture. Le premier clic lui donne son numéro, définitif ;
              les suivants rendent la même. Un panier n'a rien à facturer. */}
          {!estPanier && (
            <a
              href={apiUrl(`/admin/orders/${order.id}/facture.pdf`)}
              target="_blank"
              title={
                order.invoiceNumber
                  ? `Facture ${order.invoiceNumber}, éditée le ${quand(order.invoicedAt)}`
                  : "Cette commande n'a pas encore de facture. L'ouvrir lui attribuera son numéro, définitif."
              }
              class="rounded border border-bo-border bg-bo-surface px-3 py-2 text-sm hover:bg-bo-bg"
            >
              {order.invoiceNumber
                ? `Facture ${order.invoiceNumber}`
                : "Éditer la facture"}
            </a>
          )}
          {!estPanier && client?.email && (
            <form method="POST">
              <input type="hidden" name="_action" value="envoyer-facture" />
              <button class="rounded border border-bo-border bg-bo-surface px-3 py-2 text-sm hover:bg-bo-bg">
                Envoyer la facture
              </button>
            </form>
          )}
          {/* Rien à reconfirmer sur une commande annulée : la cliente vient
              justement de recevoir le contraire. */}
          {client?.email && !annulee && (
            <form method="POST">
              <input type="hidden" name="_action" value="renvoyer" />
              <button class="rounded border border-bo-border bg-bo-surface px-3 py-2 text-sm hover:bg-bo-bg">
                Renvoyer la confirmation
              </button>
            </form>
          )}
          {chezStripe && (
            <a
              href={`https://dashboard.stripe.com/payments/${chezStripe}`}
              target="_blank"
              rel="noopener"
              class="rounded border border-bo-border bg-bo-surface px-3 py-2 text-sm hover:bg-bo-bg"
            >
              Voir chez Stripe ↗
            </a>
          )}
        </div>
      </div>

      {/* Une commande annulée le dit en haut, avant tout le reste : c'est ce
          qui explique pourquoi les boutons d'expédition ont disparu, et sans
          ce bandeau leur absence passerait pour une panne. */}
      {annulee && (
        <div class="mb-6 rounded-lg border border-bo-border bg-bo-bg px-4 py-3">
          <p class="font-medium">
            Commande annulée{order.cancelledAt ? ` le ${quand(order.cancelledAt)}` : ""}.
          </p>
          {order.cancelReason && (
            <p class="mt-0.5 text-sm text-bo-muted">Motif : {order.cancelReason}</p>
          )}
          <p class="mt-1 text-sm text-bo-muted">
            Elle reste lisible et garde son histoire, mais elle ne compte plus
            dans vos chiffres et ne peut plus rien expédier.
            {encaisse && rembourse < total && (
              <>
                {" "}
                <strong class="font-medium text-red-800">
                  {formatPrice(total - rembourse)} restent à rendre à la cliente :
                  aucun remboursement de ce montant n'est enregistré.
                </strong>
              </>
            )}
            {order.invoiceNumber && (
              <>
                {" "}
                La facture {order.invoiceNumber} a déjà été éditée : elle garde
                son numéro et porte désormais la mention « annulée ». Si elle est
                partie chez la cliente, il faut lui établir un avoir.
              </>
            )}
          </p>
        </div>
      )}

      {/* ============================================================== */}
      {/* Deux colonnes : agir à gauche, consulter à droite               */}
      {/* ============================================================== */}
      <div class="grid grid-cols-1 items-start gap-6 lg:grid-cols-3">
        <div class="space-y-6 lg:col-span-2">
          {/* ---------------------------------------------------------- */}
          {/* Traitement logistique                                       */}
          {/* ---------------------------------------------------------- */}
          <section class="rounded-lg border border-bo-border bg-bo-surface">
            <header class="flex flex-wrap items-center justify-between gap-2 border-b border-bo-border px-4 py-3">
              <h3 class="font-medium">
                <span
                  class={`mr-2 inline-block h-2 w-2 rounded-full align-middle ${
                    detail?.statutExpedition === "fulfilled"
                      ? "bg-green-600"
                      : "bg-amber-500"
                  }`}
                />
                {badgeTraitement.texte}
                <span class="ml-2 text-sm font-normal text-bo-muted">
                  {nbArticles} article{nbArticles > 1 ? "s" : ""}
                  {resteAExpedier > 0 && ` · ${resteAExpedier} à envoyer`}
                </span>
              </h3>
              <span class="text-sm text-bo-muted">
                {order.shippingLabel}
                {order.relayPointLabel ? ` · ${order.relayPointLabel}` : ""}
              </span>
            </header>

            <table class="w-full text-sm">
              <tbody>
                {items.map((it) => (
                  <tr class="border-b border-bo-border last:border-0">
                    {/* L'aperçu, à gauche, comme dans le panier de la boutique.
                        Il est rendu par le moteur du fichier d'impression :
                        c'est ce qui partira à l'atelier, pas une recomposition.
                        Un clic l'ouvre en grand — c'est là qu'on vérifie un
                        prénom ou la couleur d'un pull avant d'imprimer.

                        Le cadre garde les proportions d'une affiche (1:√2) :
                        l'image se charge après la page, et sans ce gabarit la
                        ligne sauterait de hauteur en arrivant. */}
                    <td class="w-24 py-3 pl-4 align-top">
                      {it.apercu && (
                        <a
                          href={apiUrl(it.apercu)}
                          target="_blank"
                          rel="noopener"
                          title="Voir l'affiche en grand"
                          class="block overflow-hidden rounded border border-bo-border bg-bo-bg transition-opacity hover:opacity-85"
                          style="aspect-ratio: 1 / 1.4142"
                        >
                          <img
                            src={apiUrl(it.apercu)}
                            alt={`Aperçu : ${it.title ?? "affiche"}`}
                            loading="lazy"
                            class="h-full w-full object-cover"
                          />
                        </a>
                      )}
                    </td>
                    <td class="px-4 py-3 align-top">
                      <div class="font-medium">
                        {it.title ?? "Affiche personnalisée"}
                      </div>
                      <div class="mt-0.5 text-bo-muted">
                        {[
                          it.format ? `Format ${libelleFormat(it.format)}` : null,
                          it.cadre ?? "Sans cadre",
                          it.personnages
                            ? `${it.personnages} personnage${it.personnages > 1 ? "s" : ""}`
                            : null,
                        ]
                          .filter(Boolean)
                          .join(" · ")}
                      </div>
                      {lignesDeLAffiche(it).length > 0 && (
                        <div class="mt-1">
                          <span class="text-xs tracking-wide text-bo-muted uppercase">
                            Texte de l'affiche
                          </span>
                          <ul class="mt-0.5 space-y-0.5">
                            {lignesDeLAffiche(it).map((ligne) => (
                              <li>« {ligne} »</li>
                            ))}
                          </ul>
                        </div>
                      )}
                      <div class="mt-1 flex flex-wrap gap-3 text-xs text-bo-muted">
                        {(it.expedie ?? 0) > 0 && (
                          <span>
                            {it.expedie} / {it.quantity} expédié(s)
                          </span>
                        )}
                        {(it.rembourse ?? 0) > 0 && (
                          <span class="text-violet-700">
                            {it.rembourse} remboursé(s)
                          </span>
                        )}
                        {encaisse && (
                          <a
                            href={apiUrl(`/admin/print-files/${it.id}`)}
                            target="_blank"
                            class="text-bo-accent hover:underline"
                          >
                            Télécharger le PDF d'impression
                          </a>
                        )}
                      </div>
                    </td>
                    <td class="px-4 py-3 text-right align-top whitespace-nowrap text-bo-muted">
                      {formatPrice(it.unitPriceCents)} × {it.quantity}
                    </td>
                    <td class="px-4 py-3 text-right align-top whitespace-nowrap">
                      {formatPrice(it.unitPriceCents * it.quantity)}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>

            {expeditions.length > 0 && (
              <div class="border-t border-bo-border px-4 py-3">
                <h4 class="mb-2 text-xs font-medium tracking-wide text-bo-muted uppercase">
                  {auStand ? "Remise au client" : "Colis"}
                </h4>
                <ul class="space-y-2 text-sm">
                  {expeditions.map((f) => (
                    <li class="flex flex-wrap items-center justify-between gap-2">
                      <span
                        class={f.status === "cancelled" ? "text-bo-muted line-through" : ""}
                      >
                        {f.carrier ?? (auStand ? "Remis au client" : "Sans transporteur")}
                        {f.trackingNumber && (
                          <>
                            {" · "}
                            {f.trackingUrl ? (
                              <a
                                href={f.trackingUrl}
                                target="_blank"
                                rel="noopener"
                                class="text-bo-accent hover:underline"
                              >
                                {f.trackingNumber}
                              </a>
                            ) : (
                              f.trackingNumber
                            )}
                          </>
                        )}
                        <span class="ml-2 text-xs text-bo-muted">
                          {quand(f.createdAt)} ·{" "}
                          {f.lignes.reduce((s, l) => s + l.quantity, 0)} article(s)
                        </span>
                      </span>
                      {f.status !== "cancelled" && (
                        <form method="POST">
                          <input type="hidden" name="_action" value="annuler-expedition" />
                          <input type="hidden" name="fulfillmentId" value={f.id} />
                          <button class="text-xs text-bo-accent hover:underline">
                            Annuler
                          </button>
                        </form>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {resteAExpedier > 0 && annulee && (
              <p class="border-t border-bo-border px-4 py-3 text-sm text-bo-muted">
                {resteAExpedier} article(s) ne partiront pas : la commande est
                annulée.
              </p>
            )}

            {resteAExpedier > 0 && !annulee && auStand && (
              <div class="flex flex-wrap items-center justify-between gap-3 border-t border-bo-border px-4 py-3">
                <p class="text-sm text-bo-muted">
                  {resteAExpedier} affiche(s) à remettre au client. Commande prise
                  au stand : rien à expédier.
                </p>
                <form method="POST">
                  <input type="hidden" name="_action" value="expedier" />
                  <input type="hidden" name="remise" value="1" />
                  <button class="rounded bg-bo-nav px-4 py-2 text-sm text-white">
                    Marquer comme remis
                  </button>
                </form>
              </div>
            )}

            {/* ------------------------------------------------------- */}
            {/* Bordereau transporteur                                   */}
            {/*                                                          */}
            {/* L'étiquette A6 qui se colle SUR le colis. Le BON DE      */}
            {/* LIVRAISON, lui, est le récapitulatif A4 qui voyage       */}
            {/* DEDANS : deux documents, deux formats, et les écrans     */}
            {/* doivent les distinguer partout.                          */}
            {/*                                                          */}
            {/* Placé AU-DESSUS de « Traiter les articles » parce que    */}
            {/* c'est l'ordre des gestes : on colle l'étiquette, puis on */}
            {/* enregistre le départ du colis.                           */}
            {/* ------------------------------------------------------- */}
            {/* `bordereauxRetires.length` fait partie de la condition : sans
                lui, le jour où l'unique bordereau est retiré ET où tout est
                parti, le bloc disparaît — et avec lui le repli « bordereaux
                retirés » et le lien vers le PDF conservé. La page promet que
                rien ne se supprime ; elle ne doit pas le cacher. */}
            {!auStand && (peutDeposer || bordereau || bordereauxRetires.length > 0) && (
              <div class="border-t border-bo-border px-4 py-3">
                <h4 class="mb-2 text-xs font-medium tracking-wide text-bo-muted uppercase">
                  Bordereau transporteur
                </h4>

                {bordereau ? (
                  <>
                    <div class="rounded border border-bo-border bg-bo-bg px-3 py-2 text-sm">
                      <div class="flex flex-wrap items-baseline gap-x-2">
                        <span class="font-medium">
                          {bordereau.transporteurNom}
                        </span>
                        {/* Le numéro EN GROS : c'est celui qu'on relit sur le
                            carton avant d'enregistrer l'expédition, et un
                            chiffre de travers envoie la cliente suivre le
                            colis de quelqu'un d'autre. */}
                        <span class="font-mono text-lg">
                          {bordereau.trackingNumber}
                        </span>
                      </div>
                      <p class="mt-0.5 text-xs text-bo-muted">
                        Joint le {quand(bordereau.createdAt)}
                        {bordereau.createdBy && ` par ${bordereau.createdBy}`}
                        {bordereau.poidsGrammes > 0
                          ? ` · ${bordereau.poidsGrammes} g déclarés`
                          : " · poids non déclaré"}
                      </p>
                      {bordereau.trackingUrl && (
                        <p class="mt-0.5 text-xs">
                          <a
                            href={bordereau.trackingUrl}
                            target="_blank"
                            rel="noopener"
                            class="text-bo-accent hover:underline"
                          >
                            Le lien que la cliente recevra ↗
                          </a>
                        </p>
                      )}
                    </div>

                    <div class="mt-2 flex flex-wrap items-center gap-2 text-sm">
                      <a
                        href={apiUrl(`/admin/bordereaux/${bordereau.id}/fichier.pdf`)}
                        target="_blank"
                        rel="noopener"
                        class="rounded border border-bo-border bg-bo-surface px-3 py-1.5 hover:bg-bo-bg"
                      >
                        Ouvrir le bordereau
                      </a>
                      {/* Deux onglets, jamais un document fusionné : l'un
                          s'imprime en A6 pour être collé, l'autre en A4 pour
                          être glissé dans le colis. */}
                      <button
                        type="button"
                        class="js-imprimer-colis rounded border border-bo-border bg-bo-surface px-3 py-1.5 hover:bg-bo-bg"
                        data-bordereau={apiUrl(
                          `/admin/bordereaux/${bordereau.id}/fichier.pdf`,
                        )}
                        data-bon={url(`/commandes/bons?ids=${order.id}`)}
                      >
                        Imprimer bordereau + bon de livraison
                      </button>
                      <span class="js-imprimer-etat text-xs text-bo-muted" />
                      {!bordereauServi && (
                        <form method="POST">
                          <input
                            type="hidden"
                            name="_action"
                            value="retirer-bordereau"
                          />
                          <input
                            type="hidden"
                            name="bordereauId"
                            value={bordereau.id}
                          />
                          <button class="rounded border border-bo-border bg-bo-surface px-3 py-1.5 hover:bg-bo-bg">
                            Retirer
                          </button>
                        </form>
                      )}
                    </div>

                    {/* La phrase suit l'état, et ne promet jamais un
                        formulaire qui n'est pas rendu : « ci-dessous » n'a de
                        sens que tant qu'il reste quelque chose à expédier. */}
                    {!bordereauServi && peutDeposer ? (
                      <p class="mt-2 text-xs text-bo-muted">
                        Le transporteur et le numéro sont repris tels quels
                        ci-dessous, à l'enregistrement de l'expédition : rien à
                        retaper.
                      </p>
                    ) : (
                      <>
                        <p class="mt-2 text-xs text-bo-muted">
                          Réimpression : l'ouvrir n'achète rien et ne renvoie
                          aucun courrier.
                          {bordereauServi &&
                            " Pour le retirer, annulez d'abord l'expédition qui le porte."}
                        </p>
                        {bordereauServi && resteAExpedier > 0 && (
                          <p class="mt-1 text-xs text-bo-muted">
                            Ce bordereau a déjà servi : ce qui reste partira
                            dans un autre colis, avec sa propre étiquette.
                          </p>
                        )}
                      </>
                    )}
                  </>
                ) : (
                  <>
                    <details class="text-sm">
                      <summary class="cursor-pointer text-bo-accent">
                        Acheter l'étiquette chez SendCloud
                      </summary>
                      <ol class="mt-2 ml-5 list-decimal space-y-1 text-bo-muted">
                        <li>
                          « Copier l'adresse » : tout ce que SendCloud demande
                          passe dans le presse-papier.
                        </li>
                        <li>
                          Sur{" "}
                          <a
                            href="https://app.sendcloud.com"
                            target="_blank"
                            rel="noopener"
                            class="text-bo-accent hover:underline"
                          >
                            app.sendcloud.com
                          </a>
                          , créez l'envoi, collez l'adresse, payez l'étiquette.
                        </li>
                        <li>
                          Téléchargez le PDF de l'étiquette et relevez le
                          numéro de suivi.
                        </li>
                        <li>
                          Revenez ici : déposez le PDF, collez le numéro,
                          joignez le bordereau.
                        </li>
                      </ol>
                    </details>

                    <form
                      method="POST"
                      enctype="multipart/form-data"
                      class="mt-3 space-y-3 text-sm"
                    >
                      <input
                        type="hidden"
                        name="_action"
                        value="deposer-bordereau"
                      />

                      {/* Le poids est à gauche du bouton de copie, et ce n'est
                          pas un hasard : c'est la valeur qu'on corrige AVANT
                          de copier, et c'est celle-là que le presse-papier
                          emporte. */}
                      <div class="flex flex-wrap items-end gap-3">
                        <label>
                          <span class="mb-1 block text-xs text-bo-muted">
                            Poids du colis (grammes)
                          </span>
                          <input
                            id="bo-poids-bordereau"
                            type="number"
                            name="poidsGrammes"
                            min="0"
                            step="10"
                            value={poidsColis || ""}
                            placeholder="1200"
                            class="w-32 rounded border border-bo-border px-3 py-2"
                          />
                        </label>
                        <div class="flex items-center gap-2 pb-1">
                          <button
                            type="button"
                            data-adresse={adresseACopier}
                            class="rounded border border-bo-border bg-bo-surface px-3 py-2 hover:bg-bo-bg"
                          >
                            Copier l'adresse
                          </button>
                          <span class="copie-ok text-xs text-bo-muted" />
                        </div>
                      </div>
                      {poidsColis === 0 && (
                        <p class="text-xs text-red-700">
                          Poids inconnu : une étiquette déclarée à 0 g se fait
                          refuser au dépôt, ou se paie au mauvais tarif. Pesez
                          le colis emballé et écrivez son poids ici avant de
                          copier l'adresse.
                        </p>
                      )}

                      <div class="flex flex-wrap gap-3">
                        <label>
                          <span class="mb-1 block text-xs text-bo-muted">
                            Étiquette (PDF)
                          </span>
                          <input
                            type="file"
                            name="fichier"
                            accept="application/pdf,.pdf"
                            required
                            class="block w-64 py-2 text-xs"
                          />
                        </label>
                        <label>
                          <span class="mb-1 block text-xs text-bo-muted">
                            Transporteur
                          </span>
                          <select
                            name="transporteur"
                            required
                            class="rounded border border-bo-border px-3 py-2"
                          >
                            <option value="">Choisir…</option>
                            {transporteurs.map((t) => (
                              <option
                                value={t.code}
                                selected={t.code === transporteurPropose}
                              >
                                {t.nom}
                              </option>
                            ))}
                          </select>
                        </label>
                        <label>
                          <span class="mb-1 block text-xs text-bo-muted">
                            Numéro de suivi
                          </span>
                          <input
                            name="trackingNumber"
                            required
                            placeholder="6A123456789FR"
                            class="rounded border border-bo-border px-3 py-2"
                          />
                        </label>
                        <label>
                          <span class="mb-1 block text-xs text-bo-muted">
                            Lien de suivi (facultatif)
                          </span>
                          <input
                            name="trackingUrl"
                            type="url"
                            placeholder="https://…"
                            class="w-64 rounded border border-bo-border px-3 py-2"
                          />
                        </label>
                        <div class="flex items-end">
                          <button class="rounded bg-bo-nav px-4 py-2 text-white">
                            Joindre le bordereau
                          </button>
                        </div>
                      </div>

                      {transporteurs.length === 0 && (
                        <p class="text-xs text-red-700">
                          La liste des transporteurs n'a pas pu être lue :
                          rechargez la page avant de déposer l'étiquette.
                        </p>
                      )}
                      {/* La boutique ne sait fabriquer un lien de suivi que
                          pour cinq transporteurs. Pour les autres, le lien
                          collé ici est le SEUL que la cliente puisse recevoir
                          — et le moment de le coller est celui-ci, quand on
                          l'a encore sous les yeux. */}
                      <p class="text-xs text-bo-muted">
                        Pour GLS, DPD, Relais Colis, Colis Privé et Shop2Shop,
                        collez le lien donné par le transporteur : sinon la
                        cliente recevra un numéro sans lien. Il se fabrique
                        tout seul pour Colissimo, Mondial Relay, Chronopost,
                        UPS et DHL.
                      </p>
                      <p class="text-xs text-bo-muted">
                        Joindre l'étiquette n'expédie rien et n'écrit à
                        personne : c'est « Enregistrer l'expédition », en
                        dessous, qui prévient la cliente.
                      </p>
                    </form>
                  </>
                )}

                {/* « Retiré » n'est pas « supprimé » : le fichier reste sur le
                    serveur, parce qu'une étiquette a coûté de l'argent et que
                    sa trace ne dépend pas d'un clic de plus. */}
                {bordereauxRetires.length > 0 && (
                  <details class="mt-3 text-xs text-bo-muted">
                    <summary class="cursor-pointer">
                      {bordereauxRetires.length} bordereau
                      {bordereauxRetires.length > 1 ? "x" : ""} retiré
                      {bordereauxRetires.length > 1 ? "s" : ""}
                    </summary>
                    <ul class="mt-1 space-y-0.5">
                      {bordereauxRetires.map((b) => (
                        <li>
                          {b.transporteurNom} · {b.trackingNumber} · retiré le{" "}
                          {quand(b.retireAt)}
                          {b.fichier && (
                            <>
                              {" · "}
                              <a
                                href={apiUrl(`/admin/bordereaux/${b.id}/fichier.pdf`)}
                                target="_blank"
                                rel="noopener"
                                class="text-bo-accent hover:underline"
                              >
                                ouvrir le PDF
                              </a>
                            </>
                          )}
                        </li>
                      ))}
                    </ul>
                  </details>
                )}
              </div>
            )}

            {resteAExpedier > 0 && !annulee && !auStand && (
              <details class="border-t border-bo-border">
                <summary class="cursor-pointer px-4 py-3 text-sm font-medium text-bo-accent">
                  Traiter les articles ({resteAExpedier} en attente)
                </summary>
                <form method="POST" class="space-y-3 px-4 pb-4">
                  <input type="hidden" name="_action" value="expedier" />
                  <table class="w-full text-sm">
                    <thead class="text-left text-xs text-bo-muted">
                      <tr>
                        <th class="py-1 font-medium">Article</th>
                        <th class="py-1 font-medium">Reste</th>
                        <th class="py-1 font-medium">À expédier</th>
                      </tr>
                    </thead>
                    <tbody>
                      {items
                        .filter((it) => (it.aExpedier ?? 0) > 0)
                        .map((it) => (
                          <tr>
                            <td class="py-1 pr-3">{it.title ?? "Affiche"}</td>
                            <td class="py-1 pr-3 text-bo-muted">{it.aExpedier}</td>
                            <td class="py-1">
                              <input
                                type="number"
                                name={`qte-${it.id}`}
                                min="0"
                                max={it.aExpedier}
                                value={it.aExpedier}
                                class="w-20 rounded border border-bo-border px-2 py-1"
                              />
                            </td>
                          </tr>
                        ))}
                    </tbody>
                  </table>
                  <div class="flex flex-wrap gap-3">
                    {bordereau && !bordereauServi ? (
                      /* L'étiquette est déjà imprimée et collée sur le carton :
                         un transporteur ou un numéro retapés ne pourraient que
                         la contredire, et c'est la cliente qui recevrait le
                         mauvais lien. Le champ caché porte la ligne, l'API y
                         relit les trois valeurs et ignore le reste. */
                      <div class="text-sm">
                        <input
                          type="hidden"
                          name="bordereauId"
                          value={bordereau.id}
                        />
                        <span class="mb-1 block text-xs text-bo-muted">
                          Transporteur et suivi — repris du bordereau joint
                        </span>
                        <p class="rounded border border-bo-border bg-bo-bg px-3 py-2">
                          {bordereau.transporteurNom} ·{" "}
                          <span class="font-mono">
                            {bordereau.trackingNumber}
                          </span>
                        </p>
                      </div>
                    ) : (
                      <>
                        <label class="text-sm">
                          <span class="mb-1 block text-xs text-bo-muted">
                            Transporteur
                          </span>
                          <input
                            name="carrier"
                            list="bo-transporteurs"
                            placeholder="Colissimo"
                            class="rounded border border-bo-border px-3 py-2"
                          />
                          {/* La liste vient de l'API : c'est là que vit la
                              liste de référence des transporteurs. Les DIX
                              sont proposés, y compris ceux dont la boutique
                              ne sait pas fabriquer le lien — c'est le champ
                              « Lien de suivi » à côté qui répond à ce
                              manque-là, plutôt que de retirer de la liste des
                              transporteurs avec lesquels Alexandra expédie
                              pour de bon. La saisie reste libre : « Remise en
                              main propre » n'est le transporteur de
                              personne. */}
                          <datalist id="bo-transporteurs">
                            {transporteurs.map((t) => <option value={t.nom} />)}
                          </datalist>
                        </label>
                        <label class="text-sm">
                          <span class="mb-1 block text-xs text-bo-muted">
                            Numéro de suivi
                          </span>
                          <input
                            name="trackingNumber"
                            placeholder="6A123456789FR"
                            class="rounded border border-bo-border px-3 py-2"
                          />
                        </label>
                        <label class="text-sm">
                          <span class="mb-1 block text-xs text-bo-muted">
                            Lien de suivi (facultatif)
                          </span>
                          <input
                            name="trackingUrl"
                            type="url"
                            placeholder="https://…"
                            class="w-64 rounded border border-bo-border px-3 py-2"
                          />
                        </label>
                      </>
                    )}
                    <div class="flex items-end">
                      <button class="rounded bg-bo-nav px-4 py-2 text-sm text-white">
                        Enregistrer l'expédition
                      </button>
                    </div>
                  </div>
                  {/* Cette phrase-là promet à Alexandra ce que la cliente va
                      recevoir : elle doit être vraie dans les trois cas, y
                      compris celui du bordereau sans lien. */}
                  <p class="text-xs text-bo-muted">
                    {bordereau && !bordereauServi
                      ? bordereau.trackingUrl
                        ? "Ces deux valeurs viennent du bordereau joint : ce qui est collé sur le carton fait foi, et la cliente recevra le lien de suivi affiché plus haut."
                        : "Ces deux valeurs viennent du bordereau joint : ce qui est collé sur le carton fait foi. Aucun lien n'est joint à ce bordereau — la cliente recevra le numéro seul. Pour lui en donner un, retirez le bordereau et redéposez-le avec le lien du transporteur."
                      : "Le lien de suivi se fabrique tout seul pour Colissimo, Mondial Relay, Chronopost, UPS et DHL. Pour GLS, DPD, Relais Colis, Colis Privé et Shop2Shop, collez celui du transporteur dans le champ ci-dessus : sinon la cliente recevra un numéro sans lien."}
                  </p>
                </form>
              </details>
            )}
          </section>

          {/* ---------------------------------------------------------- */}
          {/* Paiement & mouvements                                       */}
          {/* ---------------------------------------------------------- */}
          <section class="rounded-lg border border-bo-border bg-bo-surface">
            <header class="border-b border-bo-border px-4 py-3">
              <h3 class="font-medium">
                <span
                  class={`mr-2 inline-block h-2 w-2 rounded-full align-middle ${
                    encaisse ? "bg-green-600" : "bg-amber-500"
                  }`}
                />
                {badgePaiement.texte}
              </h3>
            </header>
            <dl class="space-y-1.5 px-4 py-3 text-sm">
              <div class="flex justify-between">
                <dt class="text-bo-muted">
                  Sous-total · {nbArticles} article{nbArticles > 1 ? "s" : ""}
                </dt>
                <dd>{formatPrice(sousTotal)}</dd>
              </div>
              {remise > 0 && (
                <div class="flex justify-between">
                  <dt class="text-bo-muted">
                    Réduction{order.promoCode ? ` · ${order.promoCode}` : ""}
                  </dt>
                  <dd class="text-green-700">− {formatPrice(remise)}</dd>
                </div>
              )}
              <div class="flex justify-between">
                <dt class="text-bo-muted">
                  Livraison{order.shippingLabel ? ` · ${order.shippingLabel}` : ""}
                </dt>
                <dd>{formatPrice(port)}</dd>
              </div>
              <div class="flex justify-between">
                <dt class="text-bo-muted">TVA</dt>
                <dd class="text-bo-muted">Non applicable — art. 293 B du CGI</dd>
              </div>
              <div class="mt-2 flex justify-between border-t border-bo-border pt-2 font-medium">
                <dt>Total</dt>
                <dd>{formatPrice(total)}</dd>
              </div>
              {rembourse > 0 && (
                <>
                  <div class="flex justify-between text-violet-700">
                    <dt>Remboursé</dt>
                    <dd>− {formatPrice(rembourse)}</dd>
                  </div>
                  <div class="flex justify-between font-medium">
                    <dt>Net encaissé</dt>
                    <dd>{formatPrice(netEncaisse)}</dd>
                  </div>
                </>
              )}
            </dl>

            {mouvements.length > 0 && (
              <div class="border-t border-bo-border px-4 py-3">
                <h4 class="mb-2 text-xs font-medium tracking-wide text-bo-muted uppercase">
                  Mouvements
                </h4>
                <ul class="space-y-1 text-sm">
                  {mouvements.map((m) => (
                    <li class="flex flex-wrap items-baseline justify-between gap-2">
                      <span>
                        {LIBELLE_MOUVEMENT[m.kind] ?? m.kind}
                        {m.gateway && (
                          <span class="text-bo-muted"> · {libelleMoyen(m.gateway)}</span>
                        )}
                        {m.externalRef && (
                          <span class="ml-1 text-xs text-bo-muted">{m.externalRef}</span>
                        )}
                      </span>
                      <span class={m.kind === "refund" ? "text-violet-700" : ""}>
                        {m.kind === "refund" ? "− " : ""}
                        {formatPrice(m.amountCents)}
                        <span class="ml-2 text-xs text-bo-muted">
                          {quand(m.createdAt)}
                        </span>
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {paiement && (
              <p class="border-t border-bo-border px-4 py-3 text-sm text-bo-muted">
                Encaissé : {libelleMoyen(paiement.provider)}
                {paiement.externalRef && ` · ${paiement.externalRef}`}
              </p>
            )}

            {aRembourser.map((p) => (
              <p class="border-t border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
                <strong class="font-medium">À rembourser :</strong>{" "}
                {libelleMoyen(p.provider)} a encaissé {formatPrice(p.amountCents)}
                {p.externalRef && ` (${p.externalRef})`}
                {p.status === "en_trop"
                  ? " alors que la commande était déjà payée."
                  : " pour un montant qui ne correspond pas à la commande."}{" "}
                Ce paiement ne compte pas dans ce qui est encaissé : le journal
                explique quoi faire.
              </p>
            ))}

            {/* Le règlement arrivé hors du site : virement, chèque, espèces.
                Sans ce bouton, une cliente qui paie par virement laissait sa
                commande « En attente » pour toujours — jamais préparée, sans
                fichier d'impression, et sans confirmation. */}
            {encaissableALaMain && (
              <details class="border-t border-bo-border">
                <summary class="cursor-pointer px-4 py-3 text-sm font-medium text-bo-accent">
                  Marquer comme payée (règlement hors ligne)
                </summary>
                <form method="POST" class="space-y-3 px-4 pb-4">
                  <input type="hidden" name="_action" value="encaisser" />
                  <p class="text-sm text-bo-muted">
                    À utiliser quand l'argent est bien arrivé mais pas par le
                    site : virement, chèque, espèces. La commande passe en
                    « Payée » pour {formatPrice(total)}, ses fichiers
                    d'impression sont fabriqués, et la confirmation part chez la
                    cliente — exactement comme un paiement en ligne.
                  </p>
                  <div class="flex flex-wrap items-end gap-4">
                    <label class="text-sm">
                      <span class="mb-1 block text-xs text-bo-muted">
                        Moyen de règlement
                      </span>
                      <select
                        name="moyen"
                        required
                        class="rounded border border-bo-border px-3 py-2"
                      >
                        {MOYENS_HORS_LIGNE.map(([valeur, libelle]) => (
                          <option value={valeur}>{libelle}</option>
                        ))}
                      </select>
                    </label>
                    <label class="flex-1 text-sm">
                      <span class="mb-1 block text-xs text-bo-muted">
                        Référence (numéro de virement, de chèque…)
                      </span>
                      <input
                        name="reference"
                        placeholder="VIR-20260910-4412"
                        class="w-full rounded border border-bo-border px-3 py-2"
                      />
                    </label>
                  </div>
                  <p class="text-xs text-bo-muted">
                    La référence sert à retrouver l'argent sur le relevé de
                    banque. Elle est refusée si une autre commande la porte
                    déjà — c'est souvent le même chèque saisi deux fois.
                  </p>
                  <button class="rounded bg-bo-nav px-4 py-2 text-sm text-white">
                    Encaisser {formatPrice(total)}
                  </button>
                </form>
              </details>
            )}

            {encaisse && (resteARembourser > 0 || portRemboursable > 0) && (
              <details class="border-t border-bo-border">
                <summary class="cursor-pointer px-4 py-3 text-sm font-medium text-bo-accent">
                  Rembourser
                </summary>
                <form method="POST" class="space-y-3 px-4 pb-4">
                  <input type="hidden" name="_action" value="rembourser" />
                  <table class="w-full text-sm">
                    <thead class="text-left text-xs text-bo-muted">
                      <tr>
                        <th class="py-1 font-medium">Article</th>
                        <th class="py-1 font-medium">Prix</th>
                        <th class="py-1 font-medium">Remboursables</th>
                        <th class="py-1 font-medium">Quantité</th>
                      </tr>
                    </thead>
                    <tbody>
                      {items
                        .filter((it) => (it.aRembourser ?? 0) > 0)
                        .map((it) => (
                          <tr>
                            <td class="py-1 pr-3">{it.title ?? "Affiche"}</td>
                            <td class="py-1 pr-3 text-bo-muted">
                              {formatPrice(it.unitPriceCents)}
                            </td>
                            <td class="py-1 pr-3 text-bo-muted">{it.aRembourser}</td>
                            <td class="py-1">
                              <input
                                type="number"
                                name={`remb-${it.id}`}
                                min="0"
                                max={it.aRembourser}
                                value="0"
                                class="w-20 rounded border border-bo-border px-2 py-1"
                              />
                            </td>
                          </tr>
                        ))}
                    </tbody>
                  </table>
                  <div class="flex flex-wrap items-end gap-4">
                    <label class="text-sm">
                      <span class="mb-1 block text-xs text-bo-muted">
                        Frais de port (max {formatPrice(portRemboursable)})
                      </span>
                      <input
                        type="number"
                        name="portEuros"
                        step="0.01"
                        min="0"
                        max={(portRemboursable / 100).toFixed(2)}
                        value="0"
                        class="w-28 rounded border border-bo-border px-2 py-1"
                      />
                    </label>
                    <label class="flex-1 text-sm">
                      <span class="mb-1 block text-xs text-bo-muted">Motif</span>
                      <input
                        name="reason"
                        placeholder="Article abîmé, erreur de commande…"
                        class="w-full rounded border border-bo-border px-3 py-2"
                      />
                    </label>
                  </div>
                  <label class="block text-sm">
                    <span class="mb-1 block text-xs text-bo-muted">
                      Note interne (jamais envoyée au client)
                    </span>
                    <input
                      name="noteRemb"
                      class="w-full rounded border border-bo-border px-3 py-2"
                    />
                  </label>
                  <label class="flex items-center gap-2 text-sm">
                    <input type="checkbox" name="restock" />
                    Remettre les articles en stock
                    <span class="text-xs text-bo-muted">
                      (sans effet sur les affiches, imprimées à la commande)
                    </span>
                  </label>
                  <label class="flex items-center gap-2 text-sm">
                    <input type="checkbox" name="viaPsp" checked />
                    Rendre l'argent via Stripe
                    <span class="text-xs text-bo-muted">
                      (décochez pour un remboursement fait à la main)
                    </span>
                  </label>
                  <button class="rounded bg-bo-nav px-4 py-2 text-sm text-white">
                    Rembourser
                  </button>
                </form>
              </details>
            )}
          </section>

          {/* ---------------------------------------------------------- */}
          {/* Chronologie                                                 */}
          {/* ---------------------------------------------------------- */}
          <section class="rounded-lg border border-bo-border bg-bo-surface">
            <header class="border-b border-bo-border px-4 py-3">
              <h3 class="font-medium">Chronologie</h3>
            </header>
            <form method="POST" class="border-b border-bo-border px-4 py-3">
              <input type="hidden" name="_action" value="commentaire" />
              <textarea
                name="message"
                rows="2"
                placeholder="Laisser un commentaire — « cliente rappelée », « à joindre au colis de sa sœur »…"
                class="w-full rounded border border-bo-border px-3 py-2 text-sm"
              />
              <div class="mt-2 flex items-center justify-between">
                <span class="text-xs text-bo-muted">
                  Visible seulement au back-office.
                </span>
                <button class="rounded bg-bo-nav px-3 py-1.5 text-sm text-white">
                  Publier
                </button>
              </div>
            </form>
            <ol class="space-y-3 px-4 py-3 text-sm">
              {(detail?.journal ?? []).map((e) => (
                <li class="flex gap-3">
                  <span
                    class={`mt-1.5 h-2 w-2 shrink-0 rounded-full ${
                      e.kind === "comment" ? "bg-bo-accent" : "bg-bo-border"
                    }`}
                  />
                  <span>
                    <span class={e.kind === "comment" ? "italic" : ""}>{e.message}</span>
                    <span class="ml-2 text-xs text-bo-muted">
                      {quand(e.createdAt)}
                      {e.author && ` · ${e.author}`}
                    </span>
                  </span>
                </li>
              ))}
              {(detail?.journal ?? []).length === 0 && (
                <li class="text-bo-muted">
                  Rien pour l'instant — les événements s'ajouteront tout seuls.
                </li>
              )}
            </ol>
          </section>
        </div>

        {/* ============================================================ */}
        {/* Colonne de droite : ce qu'on consulte                        */}
        {/* ============================================================ */}
        <div class="space-y-6">
          <section class="rounded-lg border border-bo-border bg-bo-surface px-4 py-3">
            <h3 class="mb-2 font-medium">Client</h3>
            {client ? (
              <div class="space-y-1 text-sm">
                {/* Le nom mène à la fiche CRM : de la commande on remonte à
                    l'historique du client sans repasser par la recherche. */}
                <div>
                  <a
                    href={url(`/clients/${client.id}`)}
                    class="text-bo-accent hover:underline"
                  >
                    {client.name || "Voir la fiche client"}
                  </a>
                </div>
                {client.email && (
                  <a
                    href={`mailto:${client.email}`}
                    class="block text-bo-accent hover:underline"
                  >
                    {client.email}
                  </a>
                )}
                {order.shippingPhone && (
                  <div class="text-bo-muted">{order.shippingPhone}</div>
                )}
                <p class="text-bo-muted">
                  {detail?.commandesDuClient ?? 0} commande
                  {(detail?.commandesDuClient ?? 0) > 1 ? "s" : ""} au total
                </p>
              </div>
            ) : (
              <p class="text-sm text-bo-muted">
                Aucun client rattaché — commande prise au salon.
              </p>
            )}
          </section>

          <section class="rounded-lg border border-bo-border bg-bo-surface px-4 py-3">
            <h3 class="mb-2 font-medium">Adresse de livraison</h3>
            {/* Un retrait sur stand se range dans les mêmes colonnes qu'un
                point relais — elles disent « où va la commande ». Le préfixe
                de l'identifiant dit de quelle sorte d'endroit il s'agit :
                sans lui, un stand s'annoncerait comme un point relais et
                personne n'irait le chercher au bon endroit. */}
            {order.relayPointLabel && (
              <p class="mb-2 rounded bg-bo-bg px-2 py-1 text-sm">
                {String(order.relayPointId ?? "").startsWith("stand:")
                  ? "Retrait sur place"
                  : "Point relais"}{" "}
                : {order.relayPointLabel}
              </p>
            )}
            {order.shippingLine1 || order.shippingName ? (
              <div class="space-y-0.5 text-sm">
                <div>{order.shippingName ?? "—"}</div>
                {order.shippingLine1 && <div>{order.shippingLine1}</div>}
                {order.shippingLine2 && <div>{order.shippingLine2}</div>}
                <div>
                  {[order.shippingPostalCode, order.shippingCity]
                    .filter(Boolean)
                    .join(" ")}
                </div>
                {order.shippingCountry && <div>{order.shippingCountry}</div>}
              </div>
            ) : (
              <p class="text-sm text-bo-muted">
                {order.shippingLabel === "Retrait sur place"
                  ? "Retrait sur place — pas d'expédition."
                  : "Aucune adresse enregistrée."}
              </p>
            )}
            <details class="mt-2">
              <summary class="cursor-pointer text-sm text-bo-accent">Modifier</summary>
              <form method="POST" class="mt-2 space-y-2 text-sm">
                <input type="hidden" name="_action" value="adresse" />
                <input
                  name="shippingName"
                  value={order.shippingName ?? ""}
                  placeholder="Nom"
                  class="w-full rounded border border-bo-border px-2 py-1"
                />
                <input
                  name="shippingLine1"
                  value={order.shippingLine1 ?? ""}
                  placeholder="Adresse"
                  class="w-full rounded border border-bo-border px-2 py-1"
                />
                <input
                  name="shippingLine2"
                  value={order.shippingLine2 ?? ""}
                  placeholder="Complément"
                  class="w-full rounded border border-bo-border px-2 py-1"
                />
                <div class="flex gap-2">
                  <input
                    name="shippingPostalCode"
                    value={order.shippingPostalCode ?? ""}
                    placeholder="Code postal"
                    class="w-28 rounded border border-bo-border px-2 py-1"
                  />
                  <input
                    name="shippingCity"
                    value={order.shippingCity ?? ""}
                    placeholder="Ville"
                    class="flex-1 rounded border border-bo-border px-2 py-1"
                  />
                </div>
                <input
                  name="shippingCountry"
                  value={order.shippingCountry ?? ""}
                  placeholder="Pays"
                  class="w-full rounded border border-bo-border px-2 py-1"
                />
                <input
                  name="shippingPhone"
                  value={order.shippingPhone ?? ""}
                  placeholder="Téléphone"
                  class="w-full rounded border border-bo-border px-2 py-1"
                />
                <button class="rounded bg-bo-nav px-3 py-1.5 text-white">
                  Enregistrer l'adresse
                </button>
              </form>
            </details>
          </section>

          <section class="rounded-lg border border-bo-border bg-bo-surface px-4 py-3">
            <h3 class="mb-2 font-medium">Étiquettes</h3>
            <form method="POST" class="space-y-2 text-sm">
              <input type="hidden" name="_action" value="etiquettes" />
              <input
                name="tags"
                value={(order.tags ?? []).join(", ")}
                placeholder="cadeau, urgent, stand de Nantes"
                class="w-full rounded border border-bo-border px-2 py-1"
              />
              <p class="text-xs text-bo-muted">Séparées par des virgules.</p>
              <button class="rounded border border-bo-border px-3 py-1.5 hover:bg-bo-bg">
                Enregistrer
              </button>
            </form>
          </section>

          {/* Annuler : le geste qu'on cherche neuf fois sur dix quand on
              croit vouloir supprimer. Il se range donc JUSTE AVANT la
              suppression, pour qu'on le rencontre en premier. */}
          {!annulee && !estPanier && (
            <section class="rounded-lg border border-amber-300 bg-bo-surface px-4 py-3">
              <h3 class="mb-2 font-medium text-amber-900">Annuler la commande</h3>
              <p class="mb-2 text-sm text-bo-muted">
                La commande reste lisible et garde toute son histoire. Elle sort
                de vos chiffres, ne peut plus rien expédier, et la cliente est
                prévenue par courrier.
              </p>
              {resteAExpedier < nbArticles && (
                <p class="mb-2 rounded bg-amber-50 px-2 py-1 text-sm text-amber-900">
                  {nbArticles - resteAExpedier} article(s) sont déjà partis :
                  l'annulation sera refusée. Annulez d'abord l'expédition si le
                  colis n'est pas réellement parti, sinon remboursez ce qui
                  revient.
                </p>
              )}
              <details>
                <summary class="cursor-pointer text-sm text-bo-accent">
                  Annuler {order.number}
                </summary>
                <form method="POST" class="mt-2 space-y-2 text-sm">
                  <input type="hidden" name="_action" value="annuler" />
                  <label class="block">
                    <span class="mb-1 block text-xs text-bo-muted">Motif</span>
                    <select
                      name="motif"
                      class="w-full rounded border border-bo-border px-2 py-1"
                    >
                      {MOTIFS_ANNULATION.map(([valeur, libelle]) => (
                        <option value={valeur}>{libelle}</option>
                      ))}
                    </select>
                  </label>
                  <label class="block">
                    <span class="mb-1 block text-xs text-bo-muted">
                      Précision (écrite à la cliente)
                    </span>
                    <input
                      name="motifLibre"
                      placeholder="Le fond choisi n'est plus disponible"
                      class="w-full rounded border border-bo-border px-2 py-1"
                    />
                  </label>
                  <label class="block">
                    <span class="mb-1 block text-xs text-bo-muted">
                      Note interne (jamais envoyée)
                    </span>
                    <input
                      name="noteAnnul"
                      class="w-full rounded border border-bo-border px-2 py-1"
                    />
                  </label>

                  {/* Le remboursement n'a de sens que sur une commande
                      encaissée. Sur les autres, on ne montre pas une case
                      qui ne peut que produire un refus. */}
                  {encaisse && resteSiPasRembourse > 0 && (
                    <>
                      <label class="flex items-start gap-2">
                        <input type="checkbox" name="rembourser" checked class="mt-0.5" />
                        <span>
                          Rembourser {formatPrice(resteSiPasRembourse)} en même
                          temps
                          <span class="block text-xs text-bo-muted">
                            Décochée, l'annulation passe quand même — mais cette
                            somme reste due à la cliente, et rien d'autre ne
                            vous le rappellera.
                          </span>
                        </span>
                      </label>
                      <label class="flex items-center gap-2">
                        <input type="checkbox" name="viaPspAnnul" checked />
                        Rendre l'argent via Stripe
                        <span class="text-xs text-bo-muted">
                          (décochez pour un remboursement fait à la main)
                        </span>
                      </label>
                    </>
                  )}
                  {encaisse && resteSiPasRembourse <= 0 && (
                    <p class="text-xs text-bo-muted">
                      Tout a déjà été remboursé sur cette commande : il n'y a
                      plus rien à rendre.
                    </p>
                  )}
                  {!encaisse && (
                    <p class="text-xs text-bo-muted">
                      Cette commande n'a jamais été encaissée : il n'y a rien à
                      rembourser. Une écriture d'annulation sera portée au grand
                      livre, pour que la page Finances reste juste.
                    </p>
                  )}

                  <label class="flex items-center gap-2">
                    <input type="checkbox" name="restockAnnul" />
                    Remettre les articles en stock
                    <span class="text-xs text-bo-muted">
                      (sans effet sur les affiches, imprimées à la commande)
                    </span>
                  </label>
                  <button class="rounded border border-amber-400 px-3 py-1.5 text-amber-900 hover:bg-amber-50">
                    Annuler cette commande
                  </button>
                </form>
              </details>
            </section>
          )}

          {/* En dernier : ranger une commande, ce qui se défait. Il n'y a
              plus de suppression — elle emportait les articles, les
              expéditions, les remboursements et les mouvements d'argent. */}
          <section class="rounded-lg border border-bo-border bg-bo-surface px-4 py-3">
            <h3 class="mb-2 font-medium">
              {order.archivedAt ? "Commande archivée" : "Archiver la commande"}
            </h3>
            {order.archivedAt ? (
              <>
                <p class="mb-3 text-sm text-bo-muted">
                  Elle ne s'affiche plus dans la liste ordinaire, ni dans
                  l'export : elle attend dans l'onglet « Archivées ». La
                  recherche la trouve toujours par son numéro, marquée
                  « Archivée ». Rien n'a été effacé, et son statut n'a pas
                  bougé.
                </p>
                <form method="POST">
                  <input type="hidden" name="_action" value="archiver-commande" />
                  <input type="hidden" name="archived" value="false" />
                  <button class="rounded border border-bo-border px-3 py-1.5 text-sm hover:bg-bo-bg">
                    Restaurer {order.number}
                  </button>
                </form>
              </>
            ) : (
              <>
                <p class="mb-3 text-sm text-bo-muted">
                  Elle quitte la liste et l'export, et se range dans l'onglet
                  « Archivées », d'où elle se restaure ; la recherche
                  continue de la trouver, marquée « Archivée ». Rien n'est
                  effacé : ses articles, ses expéditions, son argent et sa
                  chronologie restent, et son statut ne change pas — une
                  vente archivée compte toujours dans vos chiffres. Pour
                  qu'elle cesse d'y compter, annulez-la plutôt.
                </p>
                <form
                  method="POST"
                  onsubmit="return confirm('Archiver cette commande ? Elle quitte la liste et se range dans « Archivées », d\'où vous pourrez la restaurer. Rien n\'est supprimé.')"
                >
                  <input type="hidden" name="_action" value="archiver-commande" />
                  <input type="hidden" name="archived" value="true" />
                  <button class="rounded border border-bo-border px-3 py-1.5 text-sm hover:bg-bo-bg">
                    Archiver {order.number}
                  </button>
                </form>
              </>
            )}
          </section>

          <section class="rounded-lg border border-bo-border bg-bo-surface px-4 py-3">
            <h3 class="mb-2 font-medium">Note interne</h3>
            <form method="POST" class="space-y-2 text-sm">
              <input type="hidden" name="_action" value="note" />
              <textarea
                name="note"
                rows="4"
                placeholder="« À envoyer avec la commande #2141 »"
                class="w-full rounded border border-bo-border px-2 py-1"
                set:text={order.internalNote ?? ""}
              />
              <button class="rounded border border-bo-border px-3 py-1.5 hover:bg-bo-bg">
                Enregistrer
              </button>
            </form>
          </section>

          {remboursements.length > 0 && (
            <section class="rounded-lg border border-bo-border bg-bo-surface px-4 py-3">
              <h3 class="mb-2 font-medium">Remboursements</h3>
              <ul class="space-y-2 text-sm">
                {remboursements.map((r) => (
                  <li>
                    <div class="flex justify-between">
                      <span class="text-violet-700">− {formatPrice(r.amountCents)}</span>
                      <span class="text-xs text-bo-muted">{quand(r.createdAt)}</span>
                    </div>
                    {r.reason && <div class="text-bo-muted">{r.reason}</div>}
                    {r.note && <div class="text-xs text-bo-muted">{r.note}</div>}
                  </li>
                ))}
              </ul>
            </section>
          )}
        </div>
      </div>
    </>
  )}

  <script is:inline>
    // Le presse-papier de « Copier l'adresse », sur le modèle des adresses de
    // stand : on écoute la page une fois, le bouton n'existe que dans un des
    // trois états du bloc.
    document.addEventListener("click", async (evenement) => {
      const cible = evenement.target;
      const bouton =
        cible instanceof Element ? cible.closest("[data-adresse]") : null;
      if (!bouton) return;
      // Le poids est lu au clic, et pas rendu avec le reste : c'est celui
      // qu'elle vient de corriger qu'il faut emporter chez le transporteur,
      // pas celui qui était là au chargement de la page.
      const poids = document.getElementById("bo-poids-bordereau");
      const grammes = poids && Number(poids.value) > 0 ? Number(poids.value) : 0;
      const adresse =
        (bouton.getAttribute("data-adresse") || "") +
        (grammes ? `\nPoids : ${grammes} g` : "");
      const dit = bouton.parentElement?.querySelector(".copie-ok");
      try {
        await navigator.clipboard.writeText(adresse);
        if (dit)
          dit.textContent = grammes
            ? "Adresse et poids copiés."
            : "Adresse copiée — sans le poids, il est à zéro.";
      } catch {
        // Presse-papiers refusé (page non sécurisée, permission) : on montre
        // l'adresse pour qu'elle reste copiable à la main.
        if (dit) dit.textContent = "Copie refusée par le navigateur.";
        window.prompt("Adresse de la cliente :", adresse);
      }
    });

    // Les deux documents du colis, dans deux onglets. On ne les fusionne pas :
    // le bordereau s'imprime en A6 pour être collé DESSUS, le bon de livraison
    // en A4 pour être glissé DEDANS.
    document.addEventListener("click", (evenement) => {
      const cible = evenement.target;
      const bouton =
        cible instanceof Element ? cible.closest(".js-imprimer-colis") : null;
      if (!bouton) return;
      const dit = bouton.parentElement?.querySelector(".js-imprimer-etat");
      window.open(bouton.getAttribute("data-bordereau"), "_blank");
      const second = window.open(bouton.getAttribute("data-bon"), "_blank");
      // Certains navigateurs n'accordent qu'un seul onglet par clic : le dire
      // vaut mieux que de laisser partir un colis sans son bon de livraison.
      if (!second && dit)
        dit.textContent =
          "Second onglet bloqué : ouvrez le bon de livraison par le bouton en haut de la fiche.";
    });
  </script>
</Admin>
