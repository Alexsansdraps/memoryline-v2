---
/**
 * Fiche d'une commande.
 *
 * Deux colonnes, comme dans Shopify : à GAUCHE ce qu'on FAIT (expédier,
 * rembourser, commenter), à DROITE ce qu'on CONSULTE (le client, ses adresses,
 * les notes, les étiquettes). La séparation n'est pas cosmétique — elle évite
 * de chercher le bouton d'expédition au milieu d'une adresse.
 *
 * Aucun statut n'est stocké ici : ils viennent tous de l'API, calculés à
 * partir des expéditions et des remboursements enregistrés.
 */
import { apiUrl, url } from "../../lib/url.ts";
import { libelleFormat } from "@memoryline/types";
import Admin from "../../layouts/Admin.astro";
import {
  adminApi,
  formatPrice,
  lignesDeLAffiche,
  type OrderDetail,
} from "../../lib/api.ts";

const id = Number(Astro.params.id);
const api = adminApi(Astro.request);

let flash: string | null = null;
let flashErreur = false;

if (Astro.request.method === "POST") {
  const f = await Astro.request.formData();
  const action = f.get("_action");
  try {
    if (action === "expedier") {
      // Quantités saisies ligne par ligne : `qte-<id>` porte ce qui part.
      const items: { orderItemId: number; quantity: number }[] = [];
      for (const [cle, valeur] of f.entries()) {
        if (!cle.startsWith("qte-")) continue;
        const q = Math.max(0, Number(valeur) || 0);
        if (q > 0) items.push({ orderItemId: Number(cle.slice(4)), quantity: q });
      }
      await api.createFulfillment(id, {
        items,
        carrier: String(f.get("carrier") ?? ""),
        trackingNumber: String(f.get("trackingNumber") ?? ""),
      });
      // Au stand, il n'y a pas de colis : le mot doit dire ce qui s'est passé.
      flash = f.get("remise")
        ? "Affiche remise au client."
        : "Expédition enregistrée.";
    } else if (action === "supprimer-commande") {
      // Un retour à la liste plutôt qu'un rendu : la commande n'existe plus,
      // la page qui la montre non plus.
      const r = await api.supprimerCommande(id);
      return Astro.redirect(
        `${url("/commandes")}?supprimee=${encodeURIComponent(r.numero)}`,
      );
    } else if (action === "annuler-expedition") {
      await api.cancelFulfillment(Number(f.get("fulfillmentId")));
      flash = "Expédition annulée.";
    } else if (action === "rembourser") {
      const items: { orderItemId: number; quantity: number }[] = [];
      for (const [cle, valeur] of f.entries()) {
        if (!cle.startsWith("remb-")) continue;
        const q = Math.max(0, Number(valeur) || 0);
        if (q > 0) items.push({ orderItemId: Number(cle.slice(5)), quantity: q });
      }
      const r = await api.refundOrder(id, {
        items,
        shippingCents: Math.round(Number(f.get("portEuros") ?? 0) * 100) || 0,
        reason: String(f.get("reason") ?? ""),
        note: String(f.get("noteRemb") ?? ""),
        restock: f.get("restock") === "on",
        viaPsp: f.get("viaPsp") === "on",
        author: Astro.locals.user?.email ?? undefined,
      });
      flash = `Remboursement de ${formatPrice(r.amountCents)} enregistré.`;
    } else if (action === "annuler") {
      const r = await api.annulerCommande(id, {
        motif: String(f.get("motif") ?? ""),
        motifLibre: String(f.get("motifLibre") ?? ""),
        rembourser: f.get("rembourser") === "on",
        restock: f.get("restockAnnul") === "on",
        viaPsp: f.get("viaPspAnnul") === "on",
        note: String(f.get("noteAnnul") ?? ""),
        author: Astro.locals.user?.email ?? undefined,
      });
      // Le mot rend compte de TOUT ce qui vient de se passer, y compris de ce
      // qui ne s'est pas passé : une commande payée annulée sans remboursement
      // laisse de l'argent à rendre, et c'est le seul moment où quelqu'un le
      // verra écrit.
      flash =
        `Commande ${r.numero} annulée.` +
        (r.rembourseCents > 0
          ? ` ${formatPrice(r.rembourseCents)} remboursés.`
          : "") +
        (r.resteADevoir > 0
          ? ` Attention : ${formatPrice(r.resteADevoir)} restent à rendre à la cliente — aucun remboursement n'a été enregistré.`
          : "");
    } else if (action === "encaisser") {
      const r = await api.encaisserCommande(id, {
        moyen: String(f.get("moyen") ?? ""),
        reference: String(f.get("reference") ?? ""),
        author: Astro.locals.user?.email ?? undefined,
      });
      flash = r.deja
        ? (r.message ?? "Cette commande était déjà marquée payée.")
        : `Commande encaissée : ${formatPrice(r.montantCents ?? 0)} reçus par ${r.moyen}. La confirmation est partie chez la cliente et les fichiers d'impression sont prêts.`;
    } else if (action === "envoyer-facture") {
      const r = await api.envoyerFacture(id, Astro.locals.user?.email ?? undefined);
      flash = `Facture ${r.numeroFacture} envoyée à ${r.destinataire}.`;
    } else if (action === "note") {
      await api.setOrderNote(id, String(f.get("note") || ""));
      flash = "Note enregistrée.";
    } else if (action === "etiquettes") {
      const tags = String(f.get("tags") ?? "")
        .split(",")
        .map((t) => t.trim())
        .filter(Boolean);
      await api.setOrderTags(id, tags);
      flash = "Étiquettes enregistrées.";
    } else if (action === "adresse") {
      await api.updateOrderAddress(id, {
        shippingName: String(f.get("shippingName") ?? ""),
        shippingLine1: String(f.get("shippingLine1") ?? ""),
        shippingLine2: String(f.get("shippingLine2") ?? ""),
        shippingPostalCode: String(f.get("shippingPostalCode") ?? ""),
        shippingCity: String(f.get("shippingCity") ?? ""),
        shippingCountry: String(f.get("shippingCountry") ?? ""),
        shippingPhone: String(f.get("shippingPhone") ?? ""),
      });
      flash = "Adresse mise à jour.";
    } else if (action === "renvoyer") {
      await api.resendConfirmation(id);
      flash = "Confirmation renvoyée au client.";
    } else if (action === "commentaire") {
      const message = String(f.get("message") || "").trim();
      if (message) {
        await api.addOrderComment(
          id,
          message,
          Astro.locals.user?.email ?? undefined,
        );
        flash = "Commentaire publié.";
      }
    }
  } catch (e) {
    flash = "Erreur : " + String(e);
    flashErreur = true;
  }
}

let detail: OrderDetail | null = null;
let error: string | null = null;
try {
  detail = await api.orderDetail(id);
} catch (e) {
  error = String(e);
}

const order = detail?.order;
const items = detail?.items ?? [];
const client = detail?.customer ?? null;
const expeditions = detail?.expeditions ?? [];
/**
 * Une commande prise au stand n'est pas expédiée : l'affiche est remise au
 * client, sur place. Pas de transporteur, pas de numéro de suivi — juste
 * « c'est fait ».
 */
const auStand = order?.channel === "salon";
const remboursements = detail?.remboursements ?? [];
const mouvements = detail?.mouvements ?? [];

/** « 27 août 2026 à 22:36 » */
function quand(iso: string | null | undefined): string {
  if (!iso) return "";
  try {
    const d = new Date(iso);
    return `${d.toLocaleDateString("fr-FR", { day: "numeric", month: "long", year: "numeric" })} à ${d.toLocaleTimeString("fr-FR", { hour: "2-digit", minute: "2-digit" })}`;
  } catch {
    return "";
  }
}

const NOM_CANAL: Record<string, string> = {
  web: "Boutique en ligne",
  salon: "Ventes stand",
};

const BADGE_PAIEMENT: Record<string, { texte: string; classe: string }> = {
  paid: { texte: "Payée", classe: "bg-bo-bg text-bo-ink" },
  pending: {
    texte: "En attente de paiement",
    classe: "bg-amber-100 text-amber-900",
  },
  authorized: { texte: "Autorisée", classe: "bg-sky-100 text-sky-900" },
  partially_refunded: {
    texte: "Remboursée en partie",
    classe: "bg-violet-100 text-violet-900",
  },
  refunded: { texte: "Remboursée", classe: "bg-violet-100 text-violet-900" },
  voided: { texte: "Annulée", classe: "bg-bo-bg text-bo-muted" },
  draft: { texte: "Panier", classe: "bg-bo-bg text-bo-muted" },
};
const BADGE_TRAITEMENT: Record<string, { texte: string; classe: string }> = {
  fulfilled: { texte: "Traitée", classe: "bg-green-100 text-green-900" },
  partially_fulfilled: {
    texte: "Partiellement traitée",
    classe: "bg-orange-100 text-orange-900",
  },
  unfulfilled: { texte: "Non traitée", classe: "bg-amber-100 text-amber-900" },
};

/** Montants : la remise se déduit de ce qui a réellement été facturé. */
const sousTotal = items.reduce(
  (s, it) => s + it.unitPriceCents * it.quantity,
  0,
);
const nbArticles = items.reduce((s, it) => s + it.quantity, 0);
const port = order?.shippingCents ?? 0;
const total = order?.totalCents ?? 0;
const remise = Math.max(0, sousTotal + port - total);
const rembourse = detail?.rembourseCents ?? 0;
const portRemboursable = detail?.portRemboursableCents ?? 0;
const netEncaisse = total - rembourse;

const paiement =
  (detail?.paiements ?? []).find((p) => p.status === "succeeded") ??
  (detail?.paiements ?? [])[0];
const encaisse = order?.status === "paid";

const badgePaiement = BADGE_PAIEMENT[detail?.statutFinancier ?? "pending"]!;
const badgeTraitement =
  BADGE_TRAITEMENT[detail?.statutExpedition ?? "unfulfilled"]!;

/** Ce qui reste à envoyer, et ce qui reste remboursable. */
const resteAExpedier = items.reduce((s, it) => s + (it.aExpedier ?? 0), 0);
const resteARembourser = items.reduce((s, it) => s + (it.aRembourser ?? 0), 0);

/**
 * La commande est-elle annulée ?
 *
 * On lit le statut brut plutôt que le badge : celui-ci range « annulée » et
 * « remboursée » au même endroit visuel, alors que les deux n'autorisent pas
 * du tout les mêmes gestes.
 */
const annulee = order?.status === "cancelled" || order?.status === "voided";

/**
 * Le panier n'est pas une commande. Elle ne s'encaisse pas, ne s'annule pas,
 * ne se facture pas — elle se reprend ou elle s'oublie.
 */
const estPanier = order?.status === "draft";

/** Peut-on encore encaisser un règlement arrivé hors du site ? */
const encaissableALaMain = !!order && !encaisse && !annulee && !estPanier && !auStand;

/** Ce que l'annulation laisserait en suspens si elle ne remboursait pas. */
const resteSiPasRembourse = encaisse ? total - rembourse : 0;

/** Les motifs d'annulation, dans l'ordre où ils se présentent à l'esprit. */
const MOTIFS_ANNULATION = [
  ["cliente", "Demande de la cliente"],
  ["rupture", "Rupture — article indisponible"],
  ["saisie", "Erreur de saisie"],
  ["impaye", "Paiement non reçu"],
  ["autre", "Autre (précisez)"],
];

/** Les moyens de règlement qui n'ont pas de prestataire. */
const MOYENS_HORS_LIGNE = [
  ["virement", "Virement bancaire"],
  ["cheque", "Chèque"],
  ["especes", "Espèces"],
  ["autre", "Autre"],
];

/** Transporteurs proposés — la saisie libre reste possible. */
const TRANSPORTEURS = [
  "Colissimo",
  "Mondial Relay",
  "Chronopost",
  "Remise en main propre",
];

const LIBELLE_MOUVEMENT: Record<string, string> = {
  sale: "Encaissement",
  authorization: "Autorisation",
  capture: "Capture",
  refund: "Remboursement",
  void: "Annulation",
};

/**
 * Le moyen de paiement, dit comme la boutique le dit.
 *
 * Les mêmes mots que la page Finances, à la virgule près : un même
 * encaissement lu à deux endroits ne doit pas porter deux noms. Sans cette
 * table, la fiche affichait le code de la base — « manuel », avec sa
 * minuscule et sans accent — au milieu de phrases écrites en français.
 */
const LIBELLE_MOYEN: Record<string, string> = {
  stripe: "Stripe",
  paypal: "PayPal",
  stand: "Réglé sur place",
  manuel: "À la main (virement, chèque, espèces)",
};

function libelleMoyen(v: string | null | undefined): string {
  if (!v) return "Moyen non renseigné";
  return LIBELLE_MOYEN[v] ?? v;
}

/**
 * Le lien vers le tableau de bord Stripe n'a de sens que pour un paiement
 * Stripe. Il s'affichait dès qu'une référence existait, si bien qu'un
 * virement encaissé à la main proposait d'aller chercher son numéro de
 * virement chez Stripe, où il n'a jamais été.
 */
const chezStripe = paiement?.provider === "stripe" ? paiement.externalRef : null;
---

<Admin title={order ? `Commande ${order.number}` : `Commande #${id}`}>
  <p class="mb-4">
    <a href={url("/commandes")} class="text-sm text-bo-accent hover:underline">
      ← Retour aux commandes
    </a>
  </p>

  {flash && (
    <p
      class={`mb-4 text-sm rounded px-3 py-2 border ${
        flashErreur ? "bg-red-50 border-red-200" : "bg-green-50 border-green-200"
      }`}
    >
      {flash}
    </p>
  )}
  {error && <p class="mb-4 text-red-600 text-sm">API injoignable : {error}</p>}

  {order && (
    <>
      {/* ============================================================== */}
      {/* En-tête                                                        */}
      {/* ============================================================== */}
      <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
        <div>
          <div class="flex flex-wrap items-center gap-2">
            <h2 class="text-xl font-semibold">{order.number}</h2>
            <span class={`rounded-full px-2 py-0.5 text-xs ${badgePaiement.classe}`}>
              {badgePaiement.texte}
            </span>
            <span class={`rounded-full px-2 py-0.5 text-xs ${badgeTraitement.classe}`}>
              {badgeTraitement.texte}
            </span>
          </div>
          <p class="mt-1 text-sm text-bo-muted">
            {quand(order.createdAt)} · {NOM_CANAL[order.channel] ?? order.channel}
            {order.legacyName && ` · ancien n° ${order.legacyName}`}
          </p>
        </div>
        <div class="flex flex-wrap gap-2">
          <a
            href={url(`/commandes/bons?ids=${order.id}`)}
            target="_blank"
            class="rounded border border-bo-border bg-bo-surface px-3 py-2 text-sm hover:bg-bo-bg"
          >
            Bon de livraison
          </a>
          {/* La facture. Le premier clic lui donne son numéro, définitif ;
              les suivants rendent la même. Un panier n'a rien à facturer. */}
          {!estPanier && (
            <a
              href={apiUrl(`/admin/orders/${order.id}/facture.pdf`)}
              target="_blank"
              title={
                order.invoiceNumber
                  ? `Facture ${order.invoiceNumber}, éditée le ${quand(order.invoicedAt)}`
                  : "Cette commande n'a pas encore de facture. L'ouvrir lui attribuera son numéro, définitif."
              }
              class="rounded border border-bo-border bg-bo-surface px-3 py-2 text-sm hover:bg-bo-bg"
            >
              {order.invoiceNumber
                ? `Facture ${order.invoiceNumber}`
                : "Éditer la facture"}
            </a>
          )}
          {!estPanier && client?.email && (
            <form method="POST">
              <input type="hidden" name="_action" value="envoyer-facture" />
              <button class="rounded border border-bo-border bg-bo-surface px-3 py-2 text-sm hover:bg-bo-bg">
                Envoyer la facture
              </button>
            </form>
          )}
          {/* Rien à reconfirmer sur une commande annulée : la cliente vient
              justement de recevoir le contraire. */}
          {client?.email && !annulee && (
            <form method="POST">
              <input type="hidden" name="_action" value="renvoyer" />
              <button class="rounded border border-bo-border bg-bo-surface px-3 py-2 text-sm hover:bg-bo-bg">
                Renvoyer la confirmation
              </button>
            </form>
          )}
          {chezStripe && (
            <a
              href={`https://dashboard.stripe.com/payments/${chezStripe}`}
              target="_blank"
              rel="noopener"
              class="rounded border border-bo-border bg-bo-surface px-3 py-2 text-sm hover:bg-bo-bg"
            >
              Voir chez Stripe ↗
            </a>
          )}
        </div>
      </div>

      {/* Une commande annulée le dit en haut, avant tout le reste : c'est ce
          qui explique pourquoi les boutons d'expédition ont disparu, et sans
          ce bandeau leur absence passerait pour une panne. */}
      {annulee && (
        <div class="mb-6 rounded-lg border border-bo-border bg-bo-bg px-4 py-3">
          <p class="font-medium">
            Commande annulée{order.cancelledAt ? ` le ${quand(order.cancelledAt)}` : ""}.
          </p>
          {order.cancelReason && (
            <p class="mt-0.5 text-sm text-bo-muted">Motif : {order.cancelReason}</p>
          )}
          <p class="mt-1 text-sm text-bo-muted">
            Elle reste lisible et garde son histoire, mais elle ne compte plus
            dans vos chiffres et ne peut plus rien expédier.
            {encaisse && rembourse < total && (
              <>
                {" "}
                <strong class="font-medium text-red-800">
                  {formatPrice(total - rembourse)} restent à rendre à la cliente :
                  aucun remboursement de ce montant n'est enregistré.
                </strong>
              </>
            )}
            {order.invoiceNumber && (
              <>
                {" "}
                La facture {order.invoiceNumber} a déjà été éditée : elle garde
                son numéro et porte désormais la mention « annulée ». Si elle est
                partie chez la cliente, il faut lui établir un avoir.
              </>
            )}
          </p>
        </div>
      )}

      {/* ============================================================== */}
      {/* Deux colonnes : agir à gauche, consulter à droite               */}
      {/* ============================================================== */}
      <div class="grid grid-cols-1 items-start gap-6 lg:grid-cols-3">
        <div class="space-y-6 lg:col-span-2">
          {/* ---------------------------------------------------------- */}
          {/* Traitement logistique                                       */}
          {/* ---------------------------------------------------------- */}
          <section class="rounded-lg border border-bo-border bg-bo-surface">
            <header class="flex flex-wrap items-center justify-between gap-2 border-b border-bo-border px-4 py-3">
              <h3 class="font-medium">
                <span
                  class={`mr-2 inline-block h-2 w-2 rounded-full align-middle ${
                    detail?.statutExpedition === "fulfilled"
                      ? "bg-green-600"
                      : "bg-amber-500"
                  }`}
                />
                {badgeTraitement.texte}
                <span class="ml-2 text-sm font-normal text-bo-muted">
                  {nbArticles} article{nbArticles > 1 ? "s" : ""}
                  {resteAExpedier > 0 && ` · ${resteAExpedier} à envoyer`}
                </span>
              </h3>
              <span class="text-sm text-bo-muted">
                {order.shippingLabel}
                {order.relayPointLabel ? ` · ${order.relayPointLabel}` : ""}
              </span>
            </header>

            <table class="w-full text-sm">
              <tbody>
                {items.map((it) => (
                  <tr class="border-b border-bo-border last:border-0">
                    <td class="px-4 py-3">
                      <div class="font-medium">
                        {it.title ?? "Affiche personnalisée"}
                      </div>
                      <div class="mt-0.5 text-bo-muted">
                        {[
                          it.format ? `Format ${libelleFormat(it.format)}` : null,
                          it.cadre ?? "Sans cadre",
                          it.personnages
                            ? `${it.personnages} personnage${it.personnages > 1 ? "s" : ""}`
                            : null,
                        ]
                          .filter(Boolean)
                          .join(" · ")}
                      </div>
                      {lignesDeLAffiche(it).length > 0 && (
                        <div class="mt-1">
                          <span class="text-xs tracking-wide text-bo-muted uppercase">
                            Texte de l'affiche
                          </span>
                          <ul class="mt-0.5 space-y-0.5">
                            {lignesDeLAffiche(it).map((ligne) => (
                              <li>« {ligne} »</li>
                            ))}
                          </ul>
                        </div>
                      )}
                      <div class="mt-1 flex flex-wrap gap-3 text-xs text-bo-muted">
                        {(it.expedie ?? 0) > 0 && (
                          <span>
                            {it.expedie} / {it.quantity} expédié(s)
                          </span>
                        )}
                        {(it.rembourse ?? 0) > 0 && (
                          <span class="text-violet-700">
                            {it.rembourse} remboursé(s)
                          </span>
                        )}
                        {encaisse && (
                          <a
                            href={apiUrl(`/admin/print-files/${it.id}`)}
                            target="_blank"
                            class="text-bo-accent hover:underline"
                          >
                            Télécharger le PDF d'impression
                          </a>
                        )}
                      </div>
                    </td>
                    <td class="px-4 py-3 text-right align-top whitespace-nowrap text-bo-muted">
                      {formatPrice(it.unitPriceCents)} × {it.quantity}
                    </td>
                    <td class="px-4 py-3 text-right align-top whitespace-nowrap">
                      {formatPrice(it.unitPriceCents * it.quantity)}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>

            {expeditions.length > 0 && (
              <div class="border-t border-bo-border px-4 py-3">
                <h4 class="mb-2 text-xs font-medium tracking-wide text-bo-muted uppercase">
                  {auStand ? "Remise au client" : "Colis"}
                </h4>
                <ul class="space-y-2 text-sm">
                  {expeditions.map((f) => (
                    <li class="flex flex-wrap items-center justify-between gap-2">
                      <span
                        class={f.status === "cancelled" ? "text-bo-muted line-through" : ""}
                      >
                        {f.carrier ?? (auStand ? "Remis au client" : "Sans transporteur")}
                        {f.trackingNumber && (
                          <>
                            {" · "}
                            {f.trackingUrl ? (
                              <a
                                href={f.trackingUrl}
                                target="_blank"
                                rel="noopener"
                                class="text-bo-accent hover:underline"
                              >
                                {f.trackingNumber}
                              </a>
                            ) : (
                              f.trackingNumber
                            )}
                          </>
                        )}
                        <span class="ml-2 text-xs text-bo-muted">
                          {quand(f.createdAt)} ·{" "}
                          {f.lignes.reduce((s, l) => s + l.quantity, 0)} article(s)
                        </span>
                      </span>
                      {f.status !== "cancelled" && (
                        <form method="POST">
                          <input type="hidden" name="_action" value="annuler-expedition" />
                          <input type="hidden" name="fulfillmentId" value={f.id} />
                          <button class="text-xs text-bo-accent hover:underline">
                            Annuler
                          </button>
                        </form>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {resteAExpedier > 0 && annulee && (
              <p class="border-t border-bo-border px-4 py-3 text-sm text-bo-muted">
                {resteAExpedier} article(s) ne partiront pas : la commande est
                annulée.
              </p>
            )}

            {resteAExpedier > 0 && !annulee && auStand && (
              <div class="flex flex-wrap items-center justify-between gap-3 border-t border-bo-border px-4 py-3">
                <p class="text-sm text-bo-muted">
                  {resteAExpedier} affiche(s) à remettre au client. Commande prise
                  au stand : rien à expédier.
                </p>
                <form method="POST">
                  <input type="hidden" name="_action" value="expedier" />
                  <input type="hidden" name="remise" value="1" />
                  <button class="rounded bg-bo-nav px-4 py-2 text-sm text-white">
                    Marquer comme remis
                  </button>
                </form>
              </div>
            )}

            {resteAExpedier > 0 && !annulee && !auStand && (
              <details class="border-t border-bo-border">
                <summary class="cursor-pointer px-4 py-3 text-sm font-medium text-bo-accent">
                  Traiter les articles ({resteAExpedier} en attente)
                </summary>
                <form method="POST" class="space-y-3 px-4 pb-4">
                  <input type="hidden" name="_action" value="expedier" />
                  <table class="w-full text-sm">
                    <thead class="text-left text-xs text-bo-muted">
                      <tr>
                        <th class="py-1 font-medium">Article</th>
                        <th class="py-1 font-medium">Reste</th>
                        <th class="py-1 font-medium">À expédier</th>
                      </tr>
                    </thead>
                    <tbody>
                      {items
                        .filter((it) => (it.aExpedier ?? 0) > 0)
                        .map((it) => (
                          <tr>
                            <td class="py-1 pr-3">{it.title ?? "Affiche"}</td>
                            <td class="py-1 pr-3 text-bo-muted">{it.aExpedier}</td>
                            <td class="py-1">
                              <input
                                type="number"
                                name={`qte-${it.id}`}
                                min="0"
                                max={it.aExpedier}
                                value={it.aExpedier}
                                class="w-20 rounded border border-bo-border px-2 py-1"
                              />
                            </td>
                          </tr>
                        ))}
                    </tbody>
                  </table>
                  <div class="flex flex-wrap gap-3">
                    <label class="text-sm">
                      <span class="mb-1 block text-xs text-bo-muted">Transporteur</span>
                      <input
                        name="carrier"
                        list="bo-transporteurs"
                        placeholder="Colissimo"
                        class="rounded border border-bo-border px-3 py-2"
                      />
                      <datalist id="bo-transporteurs">
                        {TRANSPORTEURS.map((t) => <option value={t} />)}
                      </datalist>
                    </label>
                    <label class="text-sm">
                      <span class="mb-1 block text-xs text-bo-muted">
                        Numéro de suivi
                      </span>
                      <input
                        name="trackingNumber"
                        placeholder="6A123456789FR"
                        class="rounded border border-bo-border px-3 py-2"
                      />
                    </label>
                    <div class="flex items-end">
                      <button class="rounded bg-bo-nav px-4 py-2 text-sm text-white">
                        Enregistrer l'expédition
                      </button>
                    </div>
                  </div>
                  <p class="text-xs text-bo-muted">
                    Le lien de suivi est fabriqué tout seul pour Colissimo, Mondial
                    Relay et Chronopost.
                  </p>
                </form>
              </details>
            )}
          </section>

          {/* ---------------------------------------------------------- */}
          {/* Paiement & mouvements                                       */}
          {/* ---------------------------------------------------------- */}
          <section class="rounded-lg border border-bo-border bg-bo-surface">
            <header class="border-b border-bo-border px-4 py-3">
              <h3 class="font-medium">
                <span
                  class={`mr-2 inline-block h-2 w-2 rounded-full align-middle ${
                    encaisse ? "bg-green-600" : "bg-amber-500"
                  }`}
                />
                {badgePaiement.texte}
              </h3>
            </header>
            <dl class="space-y-1.5 px-4 py-3 text-sm">
              <div class="flex justify-between">
                <dt class="text-bo-muted">
                  Sous-total · {nbArticles} article{nbArticles > 1 ? "s" : ""}
                </dt>
                <dd>{formatPrice(sousTotal)}</dd>
              </div>
              {remise > 0 && (
                <div class="flex justify-between">
                  <dt class="text-bo-muted">
                    Réduction{order.promoCode ? ` · ${order.promoCode}` : ""}
                  </dt>
                  <dd class="text-green-700">− {formatPrice(remise)}</dd>
                </div>
              )}
              <div class="flex justify-between">
                <dt class="text-bo-muted">
                  Livraison{order.shippingLabel ? ` · ${order.shippingLabel}` : ""}
                </dt>
                <dd>{formatPrice(port)}</dd>
              </div>
              <div class="flex justify-between">
                <dt class="text-bo-muted">TVA</dt>
                <dd class="text-bo-muted">Non applicable — art. 293 B du CGI</dd>
              </div>
              <div class="mt-2 flex justify-between border-t border-bo-border pt-2 font-medium">
                <dt>Total</dt>
                <dd>{formatPrice(total)}</dd>
              </div>
              {rembourse > 0 && (
                <>
                  <div class="flex justify-between text-violet-700">
                    <dt>Remboursé</dt>
                    <dd>− {formatPrice(rembourse)}</dd>
                  </div>
                  <div class="flex justify-between font-medium">
                    <dt>Net encaissé</dt>
                    <dd>{formatPrice(netEncaisse)}</dd>
                  </div>
                </>
              )}
            </dl>

            {mouvements.length > 0 && (
              <div class="border-t border-bo-border px-4 py-3">
                <h4 class="mb-2 text-xs font-medium tracking-wide text-bo-muted uppercase">
                  Mouvements
                </h4>
                <ul class="space-y-1 text-sm">
                  {mouvements.map((m) => (
                    <li class="flex flex-wrap items-baseline justify-between gap-2">
                      <span>
                        {LIBELLE_MOUVEMENT[m.kind] ?? m.kind}
                        {m.gateway && (
                          <span class="text-bo-muted"> · {libelleMoyen(m.gateway)}</span>
                        )}
                        {m.externalRef && (
                          <span class="ml-1 text-xs text-bo-muted">{m.externalRef}</span>
                        )}
                      </span>
                      <span class={m.kind === "refund" ? "text-violet-700" : ""}>
                        {m.kind === "refund" ? "− " : ""}
                        {formatPrice(m.amountCents)}
                        <span class="ml-2 text-xs text-bo-muted">
                          {quand(m.createdAt)}
                        </span>
                      </span>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {paiement && (
              <p class="border-t border-bo-border px-4 py-3 text-sm text-bo-muted">
                Encaissé : {libelleMoyen(paiement.provider)}
                {paiement.externalRef && ` · ${paiement.externalRef}`}
              </p>
            )}

            {/* Le règlement arrivé hors du site : virement, chèque, espèces.
                Sans ce bouton, une cliente qui paie par virement laissait sa
                commande « En attente » pour toujours — jamais préparée, sans
                fichier d'impression, et sans confirmation. */}
            {encaissableALaMain && (
              <details class="border-t border-bo-border">
                <summary class="cursor-pointer px-4 py-3 text-sm font-medium text-bo-accent">
                  Marquer comme payée (règlement hors ligne)
                </summary>
                <form method="POST" class="space-y-3 px-4 pb-4">
                  <input type="hidden" name="_action" value="encaisser" />
                  <p class="text-sm text-bo-muted">
                    À utiliser quand l'argent est bien arrivé mais pas par le
                    site : virement, chèque, espèces. La commande passe en
                    « Payée » pour {formatPrice(total)}, ses fichiers
                    d'impression sont fabriqués, et la confirmation part chez la
                    cliente — exactement comme un paiement en ligne.
                  </p>
                  <div class="flex flex-wrap items-end gap-4">
                    <label class="text-sm">
                      <span class="mb-1 block text-xs text-bo-muted">
                        Moyen de règlement
                      </span>
                      <select
                        name="moyen"
                        required
                        class="rounded border border-bo-border px-3 py-2"
                      >
                        {MOYENS_HORS_LIGNE.map(([valeur, libelle]) => (
                          <option value={valeur}>{libelle}</option>
                        ))}
                      </select>
                    </label>
                    <label class="flex-1 text-sm">
                      <span class="mb-1 block text-xs text-bo-muted">
                        Référence (numéro de virement, de chèque…)
                      </span>
                      <input
                        name="reference"
                        placeholder="VIR-20260910-4412"
                        class="w-full rounded border border-bo-border px-3 py-2"
                      />
                    </label>
                  </div>
                  <p class="text-xs text-bo-muted">
                    La référence sert à retrouver l'argent sur le relevé de
                    banque. Elle est refusée si une autre commande la porte
                    déjà — c'est souvent le même chèque saisi deux fois.
                  </p>
                  <button class="rounded bg-bo-nav px-4 py-2 text-sm text-white">
                    Encaisser {formatPrice(total)}
                  </button>
                </form>
              </details>
            )}

            {encaisse && (resteARembourser > 0 || portRemboursable > 0) && (
              <details class="border-t border-bo-border">
                <summary class="cursor-pointer px-4 py-3 text-sm font-medium text-bo-accent">
                  Rembourser
                </summary>
                <form method="POST" class="space-y-3 px-4 pb-4">
                  <input type="hidden" name="_action" value="rembourser" />
                  <table class="w-full text-sm">
                    <thead class="text-left text-xs text-bo-muted">
                      <tr>
                        <th class="py-1 font-medium">Article</th>
                        <th class="py-1 font-medium">Prix</th>
                        <th class="py-1 font-medium">Remboursables</th>
                        <th class="py-1 font-medium">Quantité</th>
                      </tr>
                    </thead>
                    <tbody>
                      {items
                        .filter((it) => (it.aRembourser ?? 0) > 0)
                        .map((it) => (
                          <tr>
                            <td class="py-1 pr-3">{it.title ?? "Affiche"}</td>
                            <td class="py-1 pr-3 text-bo-muted">
                              {formatPrice(it.unitPriceCents)}
                            </td>
                            <td class="py-1 pr-3 text-bo-muted">{it.aRembourser}</td>
                            <td class="py-1">
                              <input
                                type="number"
                                name={`remb-${it.id}`}
                                min="0"
                                max={it.aRembourser}
                                value="0"
                                class="w-20 rounded border border-bo-border px-2 py-1"
                              />
                            </td>
                          </tr>
                        ))}
                    </tbody>
                  </table>
                  <div class="flex flex-wrap items-end gap-4">
                    <label class="text-sm">
                      <span class="mb-1 block text-xs text-bo-muted">
                        Frais de port (max {formatPrice(portRemboursable)})
                      </span>
                      <input
                        type="number"
                        name="portEuros"
                        step="0.01"
                        min="0"
                        max={(portRemboursable / 100).toFixed(2)}
                        value="0"
                        class="w-28 rounded border border-bo-border px-2 py-1"
                      />
                    </label>
                    <label class="flex-1 text-sm">
                      <span class="mb-1 block text-xs text-bo-muted">Motif</span>
                      <input
                        name="reason"
                        placeholder="Article abîmé, erreur de commande…"
                        class="w-full rounded border border-bo-border px-3 py-2"
                      />
                    </label>
                  </div>
                  <label class="block text-sm">
                    <span class="mb-1 block text-xs text-bo-muted">
                      Note interne (jamais envoyée au client)
                    </span>
                    <input
                      name="noteRemb"
                      class="w-full rounded border border-bo-border px-3 py-2"
                    />
                  </label>
                  <label class="flex items-center gap-2 text-sm">
                    <input type="checkbox" name="restock" />
                    Remettre les articles en stock
                    <span class="text-xs text-bo-muted">
                      (sans effet sur les affiches, imprimées à la commande)
                    </span>
                  </label>
                  <label class="flex items-center gap-2 text-sm">
                    <input type="checkbox" name="viaPsp" checked />
                    Rendre l'argent via Stripe
                    <span class="text-xs text-bo-muted">
                      (décochez pour un remboursement fait à la main)
                    </span>
                  </label>
                  <button class="rounded bg-bo-nav px-4 py-2 text-sm text-white">
                    Rembourser
                  </button>
                </form>
              </details>
            )}
          </section>

          {/* ---------------------------------------------------------- */}
          {/* Chronologie                                                 */}
          {/* ---------------------------------------------------------- */}
          <section class="rounded-lg border border-bo-border bg-bo-surface">
            <header class="border-b border-bo-border px-4 py-3">
              <h3 class="font-medium">Chronologie</h3>
            </header>
            <form method="POST" class="border-b border-bo-border px-4 py-3">
              <input type="hidden" name="_action" value="commentaire" />
              <textarea
                name="message"
                rows="2"
                placeholder="Laisser un commentaire — « cliente rappelée », « à joindre au colis de sa sœur »…"
                class="w-full rounded border border-bo-border px-3 py-2 text-sm"
              />
              <div class="mt-2 flex items-center justify-between">
                <span class="text-xs text-bo-muted">
                  Visible seulement au back-office.
                </span>
                <button class="rounded bg-bo-nav px-3 py-1.5 text-sm text-white">
                  Publier
                </button>
              </div>
            </form>
            <ol class="space-y-3 px-4 py-3 text-sm">
              {(detail?.journal ?? []).map((e) => (
                <li class="flex gap-3">
                  <span
                    class={`mt-1.5 h-2 w-2 shrink-0 rounded-full ${
                      e.kind === "comment" ? "bg-bo-accent" : "bg-bo-border"
                    }`}
                  />
                  <span>
                    <span class={e.kind === "comment" ? "italic" : ""}>{e.message}</span>
                    <span class="ml-2 text-xs text-bo-muted">
                      {quand(e.createdAt)}
                      {e.author && ` · ${e.author}`}
                    </span>
                  </span>
                </li>
              ))}
              {(detail?.journal ?? []).length === 0 && (
                <li class="text-bo-muted">
                  Rien pour l'instant — les événements s'ajouteront tout seuls.
                </li>
              )}
            </ol>
          </section>
        </div>

        {/* ============================================================ */}
        {/* Colonne de droite : ce qu'on consulte                        */}
        {/* ============================================================ */}
        <div class="space-y-6">
          <section class="rounded-lg border border-bo-border bg-bo-surface px-4 py-3">
            <h3 class="mb-2 font-medium">Client</h3>
            {client ? (
              <div class="space-y-1 text-sm">
                {/* Le nom mène à la fiche CRM : de la commande on remonte à
                    l'historique du client sans repasser par la recherche. */}
                <div>
                  <a
                    href={url(`/clients/${client.id}`)}
                    class="text-bo-accent hover:underline"
                  >
                    {client.name || "Voir la fiche client"}
                  </a>
                </div>
                {client.email && (
                  <a
                    href={`mailto:${client.email}`}
                    class="block text-bo-accent hover:underline"
                  >
                    {client.email}
                  </a>
                )}
                {order.shippingPhone && (
                  <div class="text-bo-muted">{order.shippingPhone}</div>
                )}
                <p class="text-bo-muted">
                  {detail?.commandesDuClient ?? 0} commande
                  {(detail?.commandesDuClient ?? 0) > 1 ? "s" : ""} au total
                </p>
              </div>
            ) : (
              <p class="text-sm text-bo-muted">
                Aucun client rattaché — commande prise au salon.
              </p>
            )}
          </section>

          <section class="rounded-lg border border-bo-border bg-bo-surface px-4 py-3">
            <h3 class="mb-2 font-medium">Adresse de livraison</h3>
            {/* Un retrait sur stand se range dans les mêmes colonnes qu'un
                point relais — elles disent « où va la commande ». Le préfixe
                de l'identifiant dit de quelle sorte d'endroit il s'agit :
                sans lui, un stand s'annoncerait comme un point relais et
                personne n'irait le chercher au bon endroit. */}
            {order.relayPointLabel && (
              <p class="mb-2 rounded bg-bo-bg px-2 py-1 text-sm">
                {String(order.relayPointId ?? "").startsWith("stand:")
                  ? "Retrait sur place"
                  : "Point relais"}{" "}
                : {order.relayPointLabel}
              </p>
            )}
            {order.shippingLine1 || order.shippingName ? (
              <div class="space-y-0.5 text-sm">
                <div>{order.shippingName ?? "—"}</div>
                {order.shippingLine1 && <div>{order.shippingLine1}</div>}
                {order.shippingLine2 && <div>{order.shippingLine2}</div>}
                <div>
                  {[order.shippingPostalCode, order.shippingCity]
                    .filter(Boolean)
                    .join(" ")}
                </div>
                {order.shippingCountry && <div>{order.shippingCountry}</div>}
              </div>
            ) : (
              <p class="text-sm text-bo-muted">
                {order.shippingLabel === "Retrait sur place"
                  ? "Retrait sur place — pas d'expédition."
                  : "Aucune adresse enregistrée."}
              </p>
            )}
            <details class="mt-2">
              <summary class="cursor-pointer text-sm text-bo-accent">Modifier</summary>
              <form method="POST" class="mt-2 space-y-2 text-sm">
                <input type="hidden" name="_action" value="adresse" />
                <input
                  name="shippingName"
                  value={order.shippingName ?? ""}
                  placeholder="Nom"
                  class="w-full rounded border border-bo-border px-2 py-1"
                />
                <input
                  name="shippingLine1"
                  value={order.shippingLine1 ?? ""}
                  placeholder="Adresse"
                  class="w-full rounded border border-bo-border px-2 py-1"
                />
                <input
                  name="shippingLine2"
                  value={order.shippingLine2 ?? ""}
                  placeholder="Complément"
                  class="w-full rounded border border-bo-border px-2 py-1"
                />
                <div class="flex gap-2">
                  <input
                    name="shippingPostalCode"
                    value={order.shippingPostalCode ?? ""}
                    placeholder="Code postal"
                    class="w-28 rounded border border-bo-border px-2 py-1"
                  />
                  <input
                    name="shippingCity"
                    value={order.shippingCity ?? ""}
                    placeholder="Ville"
                    class="flex-1 rounded border border-bo-border px-2 py-1"
                  />
                </div>
                <input
                  name="shippingCountry"
                  value={order.shippingCountry ?? ""}
                  placeholder="Pays"
                  class="w-full rounded border border-bo-border px-2 py-1"
                />
                <input
                  name="shippingPhone"
                  value={order.shippingPhone ?? ""}
                  placeholder="Téléphone"
                  class="w-full rounded border border-bo-border px-2 py-1"
                />
                <button class="rounded bg-bo-nav px-3 py-1.5 text-white">
                  Enregistrer l'adresse
                </button>
              </form>
            </details>
          </section>

          <section class="rounded-lg border border-bo-border bg-bo-surface px-4 py-3">
            <h3 class="mb-2 font-medium">Étiquettes</h3>
            <form method="POST" class="space-y-2 text-sm">
              <input type="hidden" name="_action" value="etiquettes" />
              <input
                name="tags"
                value={(order.tags ?? []).join(", ")}
                placeholder="cadeau, urgent, stand de Nantes"
                class="w-full rounded border border-bo-border px-2 py-1"
              />
              <p class="text-xs text-bo-muted">Séparées par des virgules.</p>
              <button class="rounded border border-bo-border px-3 py-1.5 hover:bg-bo-bg">
                Enregistrer
              </button>
            </form>
          </section>

          {/* Annuler : le geste qu'on cherche neuf fois sur dix quand on
              croit vouloir supprimer. Il se range donc JUSTE AVANT la
              suppression, pour qu'on le rencontre en premier. */}
          {!annulee && !estPanier && (
            <section class="rounded-lg border border-amber-300 bg-bo-surface px-4 py-3">
              <h3 class="mb-2 font-medium text-amber-900">Annuler la commande</h3>
              <p class="mb-2 text-sm text-bo-muted">
                La commande reste lisible et garde toute son histoire. Elle sort
                de vos chiffres, ne peut plus rien expédier, et la cliente est
                prévenue par courrier.
              </p>
              {resteAExpedier < nbArticles && (
                <p class="mb-2 rounded bg-amber-50 px-2 py-1 text-sm text-amber-900">
                  {nbArticles - resteAExpedier} article(s) sont déjà partis :
                  l'annulation sera refusée. Annulez d'abord l'expédition si le
                  colis n'est pas réellement parti, sinon remboursez ce qui
                  revient.
                </p>
              )}
              <details>
                <summary class="cursor-pointer text-sm text-bo-accent">
                  Annuler {order.number}
                </summary>
                <form method="POST" class="mt-2 space-y-2 text-sm">
                  <input type="hidden" name="_action" value="annuler" />
                  <label class="block">
                    <span class="mb-1 block text-xs text-bo-muted">Motif</span>
                    <select
                      name="motif"
                      class="w-full rounded border border-bo-border px-2 py-1"
                    >
                      {MOTIFS_ANNULATION.map(([valeur, libelle]) => (
                        <option value={valeur}>{libelle}</option>
                      ))}
                    </select>
                  </label>
                  <label class="block">
                    <span class="mb-1 block text-xs text-bo-muted">
                      Précision (écrite à la cliente)
                    </span>
                    <input
                      name="motifLibre"
                      placeholder="Le fond choisi n'est plus disponible"
                      class="w-full rounded border border-bo-border px-2 py-1"
                    />
                  </label>
                  <label class="block">
                    <span class="mb-1 block text-xs text-bo-muted">
                      Note interne (jamais envoyée)
                    </span>
                    <input
                      name="noteAnnul"
                      class="w-full rounded border border-bo-border px-2 py-1"
                    />
                  </label>

                  {/* Le remboursement n'a de sens que sur une commande
                      encaissée. Sur les autres, on ne montre pas une case
                      qui ne peut que produire un refus. */}
                  {encaisse && resteSiPasRembourse > 0 && (
                    <>
                      <label class="flex items-start gap-2">
                        <input type="checkbox" name="rembourser" checked class="mt-0.5" />
                        <span>
                          Rembourser {formatPrice(resteSiPasRembourse)} en même
                          temps
                          <span class="block text-xs text-bo-muted">
                            Décochée, l'annulation passe quand même — mais cette
                            somme reste due à la cliente, et rien d'autre ne
                            vous le rappellera.
                          </span>
                        </span>
                      </label>
                      <label class="flex items-center gap-2">
                        <input type="checkbox" name="viaPspAnnul" checked />
                        Rendre l'argent via Stripe
                        <span class="text-xs text-bo-muted">
                          (décochez pour un remboursement fait à la main)
                        </span>
                      </label>
                    </>
                  )}
                  {encaisse && resteSiPasRembourse <= 0 && (
                    <p class="text-xs text-bo-muted">
                      Tout a déjà été remboursé sur cette commande : il n'y a
                      plus rien à rendre.
                    </p>
                  )}
                  {!encaisse && (
                    <p class="text-xs text-bo-muted">
                      Cette commande n'a jamais été encaissée : il n'y a rien à
                      rembourser. Une écriture d'annulation sera portée au grand
                      livre, pour que la page Finances reste juste.
                    </p>
                  )}

                  <label class="flex items-center gap-2">
                    <input type="checkbox" name="restockAnnul" />
                    Remettre les articles en stock
                    <span class="text-xs text-bo-muted">
                      (sans effet sur les affiches, imprimées à la commande)
                    </span>
                  </label>
                  <button class="rounded border border-amber-400 px-3 py-1.5 text-amber-900 hover:bg-amber-50">
                    Annuler cette commande
                  </button>
                </form>
              </details>
            </section>
          )}

          {/* En dernier, et en rouge : ce qu'on ne défait pas se range là où
              on ne clique pas par mégarde. */}
          <section class="rounded-lg border border-red-300 bg-bo-surface px-4 py-3">
            <h3 class="mb-2 font-medium text-red-800">Supprimer la commande</h3>
            <p class="mb-3 text-sm text-bo-muted">
              Les articles, les expéditions, les remboursements, les mouvements
              d'argent et la chronologie partent avec elle, et elle sort de vos
              chiffres. Pour retirer une vente sans effacer son histoire,
              annulez-la plutôt.
            </p>
            <form
              method="POST"
              onsubmit="return confirm('Supprimer définitivement cette commande ? Cette action est sans retour.')"
            >
              <input type="hidden" name="_action" value="supprimer-commande" />
              <button class="rounded border border-red-300 px-3 py-1.5 text-sm text-red-700 hover:bg-red-50">
                Supprimer définitivement {order.number}
              </button>
            </form>
          </section>

          <section class="rounded-lg border border-bo-border bg-bo-surface px-4 py-3">
            <h3 class="mb-2 font-medium">Note interne</h3>
            <form method="POST" class="space-y-2 text-sm">
              <input type="hidden" name="_action" value="note" />
              <textarea
                name="note"
                rows="4"
                placeholder="« À envoyer avec la commande #2141 »"
                class="w-full rounded border border-bo-border px-2 py-1"
                set:text={order.internalNote ?? ""}
              />
              <button class="rounded border border-bo-border px-3 py-1.5 hover:bg-bo-bg">
                Enregistrer
              </button>
            </form>
          </section>

          {remboursements.length > 0 && (
            <section class="rounded-lg border border-bo-border bg-bo-surface px-4 py-3">
              <h3 class="mb-2 font-medium">Remboursements</h3>
              <ul class="space-y-2 text-sm">
                {remboursements.map((r) => (
                  <li>
                    <div class="flex justify-between">
                      <span class="text-violet-700">− {formatPrice(r.amountCents)}</span>
                      <span class="text-xs text-bo-muted">{quand(r.createdAt)}</span>
                    </div>
                    {r.reason && <div class="text-bo-muted">{r.reason}</div>}
                    {r.note && <div class="text-xs text-bo-muted">{r.note}</div>}
                  </li>
                ))}
              </ul>
            </section>
          )}
        </div>
      </div>
    </>
  )}
</Admin>
