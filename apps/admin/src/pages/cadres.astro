---
import Admin from "../layouts/Admin.astro";
import { adminApi, type Cadre } from "../lib/api.ts";
import TraductionsNoms from "../components/TraductionsNoms.astro";
import { traiterTraductionsNoms } from "../lib/traductions-noms.ts";
import type { EtatTraductions } from "../lib/traductions.ts";
import {
  REGLAGE_CADRES_SITE,
  cadresProposesSurLeSite,
} from "@memoryline/types";

const api = adminApi(Astro.request);

/**
 * Saisie en euros, stockée en centimes : jamais de flottant sur de l'argent
 * une fois en base.
 */
function centimes(v: FormDataEntryValue | null): number {
  return Math.round(Number(String(v || "0").replace(",", ".")) * 100);
}

let flash: string | null = null;
/**
 * Traductions des noms de cadres : propositions automatiques à relire, saisie
 * à réafficher (après une proposition ou un refus), et bloc ouvert.
 */
let tradCadres: EtatTraductions | null = null;
if (Astro.request.method === "POST") {
  const f = await Astro.request.formData();
  const action = f.get("_action");
  try {
    if (action === "cadres-traductions" || action === "cadres-traduire") {
      const actifs = (await api.frames()).filter((c) => !c.archivedAt);
      tradCadres = await traiterTraductionsNoms(
        action === "cadres-traductions" ? "enregistrer" : "proposer",
        f,
        actifs,
        (id, l, nom) => api.traduireCadre(id, l, nom),
        (l, champs) => api.proposerTraduction(l, champs),
      );
      flash = tradCadres.message;
    } else if (action === "site") {
      // Booléen et non « on »/« off » : l'API et le site lisent ce réglage
      // tel quel (cadresProposesSurLeSite).
      const proposes = f.get("site") === "on";
      await api.setSetting(REGLAGE_CADRES_SITE, proposes);
      flash = proposes
        ? "Les cadres sont de nouveau proposés sur le site."
        : "Les cadres ne sont plus proposés sur le site. Le stand continue de les proposer.";
    } else if (action === "archiver") {
      const restaurer = f.get("archived") === "false";
      const { commandes } = await api.archiverCadre(
        Number(f.get("id")),
        !restaurer,
      );
      const nom = String(f.get("libelle") || "Ce cadre");
      // Le rappel n'a de sens que si le cadre a servi : sur un cadre jamais
      // vendu, parler des commandes ferait chercher ce qui n'existe pas.
      const vendu =
        commandes > 0
          ? ` Les ${commandes} ligne(s) déjà vendue(s) gardent son nom, sur leur fiche comme dans le nom du fichier d'impression.`
          : "";
      flash = restaurer
        ? `Cadre « ${nom} » restauré, avec ses prix et son poids. Cochez « Affiché » pour le reproposer.`
        : `Cadre « ${nom} » archivé : il n'est plus proposé.${vendu} Vous pouvez le restaurer à tout moment, plus bas.`;
    } else {
      const cadre = await api.upsertFrame({
        id: f.get("id") ? Number(f.get("id")) : undefined,
        name: String(f.get("name") || ""),
        // Un supplément par format : un cadre A3 est plus grand, donc plus
        // cher. Le configurateur montre celui du format choisi.
        priceA4Cents: centimes(f.get("priceA4")),
        priceA3Cents: centimes(f.get("priceA3")),
        // Le poids du cadre s'ajoute à celui de l'affiche : il fait changer de
        // tranche d'affranchissement à lui seul.
        weightGrams: Math.max(
          0,
          Math.round(Number(String(f.get("weightGrams") || "0").replace(",", "."))) || 0,
        ),
        previewColor: String(f.get("previewColor") || "") || undefined,
        active: f.get("active") === "on",
        position: Number(f.get("position") || 0),
      });
      flash = `Cadre « ${cadre.name} » enregistré.`;
    }
  } catch (e) {
    flash = "Erreur : " + String(e);
  }
}

let tous: Cadre[] = [];
let error: string | null = null;
// Réglage illisible : la case s'affiche cochée, comme la boutique se
// comporte quand elle n'a jamais touché au réglage.
let surLeSite = true;
try {
  const [liste, reglages] = await Promise.all([api.frames(), api.settings()]);
  tous = liste;
  surLeSite = cadresProposesSurLeSite(reglages[REGLAGE_CADRES_SITE]);
} catch (e) {
  error = String(e);
}

// Les archivés quittent le tableau ordinaire pour leur propre section.
const cadres = tous.filter((c) => !c.archivedAt);
const archives = tous.filter((c) => c.archivedAt);

/** Ce qu'il faut avoir lu avant d'archiver un cadre. */
function messageArchivage(c: Cadre): string {
  return [
    `Archiver le cadre « ${c.name} » ?`,
    "Il ne sera plus proposé, ni sur le site ni au stand. Les commandes déjà passées ne bougent pas : leur prix a été figé à l'achat, et elles continuent d'afficher son nom — y compris dans le nom du fichier d'impression.",
    "Vous pourrez le restaurer quand vous voudrez, dans « Cadres archivés ».",
  ].join("\n\n");
}
---

<Admin title="Cadres">
  {flash && (
    <p class="mb-4 text-sm rounded bg-green-50 border border-green-200 px-3 py-2">
      {flash}
    </p>
  )}
  {error && <p class="mb-4 text-red-600 text-sm">API injoignable : {error}</p>}

  {/* En tête de page : c'est la question qui se pose avant toutes les
      autres — le site vend-il des cadres en ce moment ? */}
  <section class="mb-6 rounded-lg border border-bo-border bg-bo-surface">
    <form method="POST" class="flex flex-wrap items-start gap-4 px-4 py-4">
      <input type="hidden" name="_action" value="site" />
      <label class="flex max-w-3xl flex-1 items-start gap-3">
        <input type="checkbox" name="site" checked={surLeSite} class="mt-1" />
        <span>
          <span class="text-sm font-medium">Proposer les cadres sur le site</span>
          <span class="mt-0.5 block text-xs text-bo-muted">
            Décochée, le site ne montre plus aucun cadre, et un panier qui en
            contenait déjà les perd, prix recalculé, avec un message à la
            cliente. Le <strong>stand</strong> continue de les proposer : c'est
            l'envoi par la poste qui est en cause, pas le cadre.
          </span>
        </span>
      </label>
      <button class="rounded bg-bo-accent text-white px-3 py-1.5 text-sm">
        Enregistrer
      </button>
    </form>
  </section>

  <p class="mb-4 text-sm text-bo-muted">
    Les cadres proposés en option au moment de la personnalisation. Le prix
    s'ajoute à celui de l'affiche, par exemplaire, et dépend du format :
    un <strong>supplément A4</strong> et un <strong>supplément A3</strong>. Un
    cadre dont « Affiché » est décoché disparaît partout, site et stand, sans
    toucher aux commandes déjà passées.
  </p>
  <p class="mb-4 text-sm text-bo-muted">
    Le <strong>poids</strong>, en grammes, s'ajoute lui aussi à celui de
    l'affiche : c'est lui qui fait basculer le colis dans la tranche
    d'affranchissement suivante. Un cadre laissé à 0 g sous-affranchit toutes
    les commandes qui le contiennent.
  </p>

  <section class="mb-8 bg-bo-surface border border-bo-border rounded-lg overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-bo-bg text-left">
        <tr>
          <th class="px-4 py-2 w-16">Aperçu</th>
          <th class="px-4 py-2">Nom</th>
          <th class="px-4 py-2 w-32">Supplément A4</th>
          <th class="px-4 py-2 w-32">Supplément A3</th>
          <th class="px-4 py-2 w-28">Poids (g)</th>
          <th class="px-4 py-2 w-24">Ordre</th>
          <th class="px-4 py-2 w-24">Affiché</th>
          <th class="px-4 py-2 w-28"></th>
          <th class="px-2 py-2 w-10"></th>
        </tr>
      </thead>
      <tbody>
        {cadres.map((c) => (
          <tr class="border-t border-bo-border">
            <td class="px-4 py-2">
              <span
                class="block h-7 w-7 rounded"
                style={`border: 4px solid ${c.previewColor ?? "#b07d42"}; background:#fff`}
                aria-hidden="true"
              />
            </td>
            <td class="px-4 py-2" colspan="7">
              <form method="POST" class="flex flex-wrap items-center gap-2">
                <input type="hidden" name="id" value={c.id} />
                <input
                  name="name"
                  value={c.name}
                  required
                  class="w-40 border border-bo-border rounded px-2 py-1"
                />
                <label class="flex items-center gap-1" title="Supplément pour une affiche A4">
                  <span class="text-bo-muted">A4</span>
                  <input
                    name="priceA4"
                    type="number"
                    step="0.01"
                    min="0"
                    value={(c.priceA4Cents / 100).toFixed(2)}
                    class="w-24 border border-bo-border rounded px-2 py-1"
                  />
                  <span class="text-bo-muted">€</span>
                </label>
                <label class="flex items-center gap-1" title="Supplément pour une affiche A3">
                  <span class="text-bo-muted">A3</span>
                  <input
                    name="priceA3"
                    type="number"
                    step="0.01"
                    min="0"
                    value={(c.priceA3Cents / 100).toFixed(2)}
                    class="w-24 border border-bo-border rounded px-2 py-1"
                  />
                  <span class="text-bo-muted">€</span>
                </label>
                <label class="flex items-center gap-1">
                  <input
                    name="weightGrams"
                    type="number"
                    min="0"
                    step="1"
                    value={c.weightGrams}
                    title="Poids du cadre, ajouté à celui de l'affiche"
                    class="w-20 border border-bo-border rounded px-2 py-1"
                  />
                  <span class="text-bo-muted">g</span>
                </label>
                <input
                  name="previewColor"
                  type="color"
                  value={c.previewColor ?? "#b07d42"}
                  title="Couleur du cadre dans l'aperçu"
                  class="h-8 w-10 border border-bo-border rounded"
                />
                <input
                  name="position"
                  type="number"
                  value={c.position}
                  title="Ordre d'affichage"
                  class="w-16 border border-bo-border rounded px-2 py-1"
                />
                <label class="flex items-center gap-1">
                  <input type="checkbox" name="active" checked={c.active} />
                  <span>Affiché</span>
                </label>
                <button class="rounded bg-bo-accent text-white px-3 py-1.5">
                  Enregistrer
                </button>
              </form>
            </td>
            <td class="px-2 py-2 text-right">
              {/* L'archivage se fait sur la ligne du cadre concerné : plus
                  besoin d'une liste séparée en bas de page. */}
              <form
                method="POST"
                class="js-archiver inline"
                data-message={messageArchivage(c)}
              >
                <input type="hidden" name="_action" value="archiver" />
                <input type="hidden" name="id" value={c.id} />
                <input type="hidden" name="libelle" value={c.name} />
                <input type="hidden" name="archived" value="true" />
                <button
                  class="rounded border border-bo-border px-2 py-1 text-xs text-bo-muted hover:border-bo-accent hover:text-bo-accent"
                  title={`Archiver « ${c.name} »`}
                  aria-label={`Archiver ${c.name}`}
                >
                  Archiver
                </button>
              </form>
            </td>
          </tr>
        ))}
        {cadres.length === 0 && (
          <tr>
            <td class="px-4 py-6 text-bo-muted" colspan="9">
              Aucun cadre pour le moment.
            </td>
          </tr>
        )}
      </tbody>
    </table>
  </section>

  {/* Le nom de chaque cadre — sa couleur — dans les autres langues : c'est
      ce que le client lit en choisissant son cadre. */}
  {cadres.length > 0 && (
    <section class="mb-8">
      <TraductionsNoms
        titre="Traductions des cadres"
        aide="Le nom de chaque cadre (sa couleur, « Bois naturel », « Noir »…) tel que le client le lit en le choisissant. Une case vide affiche le nom français. Les commandes et les fichiers d'impression gardent le nom français."
        elements={cadres}
        propositions={tradCadres?.propositions}
        saisies={tradCadres?.saisies}
        actionEnregistrer="cadres-traductions"
        actionProposer="cadres-traduire"
        ouvert={!!tradCadres}
      />
    </section>
  )}

  {/* ==================================================================== */}
  {/* Les cadres archivés                                                  */}
  {/* ==================================================================== */}
  {archives.length > 0 && (
    <section class="mb-8">
      <h2 class="mb-1 font-semibold">Cadres archivés</h2>
      <p class="mb-3 max-w-3xl text-xs text-bo-muted">
        Retirés du catalogue et du tableau ci-dessus. Les commandes déjà
        passées continuent de les nommer, sur leur fiche comme dans le nom du
        fichier d'impression. « Restaurer » rend le cadre avec ses prix et son
        poids ; il revient décoché, à vous de le reproposer.
      </p>
      <div class="space-y-2 opacity-70">
        {archives.map((c) => (
          <div class="flex flex-wrap items-center gap-4 rounded-lg border border-bo-border bg-bo-surface p-3">
            <span
              class="block h-7 w-7 shrink-0 rounded"
              style={`border: 4px solid ${c.previewColor ?? "#b07d42"}; background:#fff`}
              aria-hidden="true"
            />
            <div class="min-w-40 flex-1">
              <p class="font-medium">{c.name}</p>
              <p class="text-xs text-bo-muted">
                A4 {(c.priceA4Cents / 100).toFixed(2)} € · A3{" "}
                {(c.priceA3Cents / 100).toFixed(2)} € · {c.weightGrams} g
              </p>
            </div>
            <form method="POST">
              <input type="hidden" name="_action" value="archiver" />
              <input type="hidden" name="id" value={c.id} />
              <input type="hidden" name="libelle" value={c.name} />
              <input type="hidden" name="archived" value="false" />
              <button class="text-sm text-bo-accent hover:underline">
                Restaurer
              </button>
            </form>
          </div>
        ))}
      </div>
    </section>
  )}

  <details class="bg-bo-surface border border-bo-border rounded-lg">
    <summary class="cursor-pointer px-5 py-3 font-semibold select-none">
      <span class="mr-1 text-bo-accent">+</span> Ajouter un cadre
    </summary>
    <form method="POST" class="flex flex-wrap items-end gap-3 px-5 pb-5 text-sm">
      <label class="block">
        <span class="text-bo-muted">Nom</span>
        <input
          name="name"
          required
          placeholder="Cadre noir"
          class="mt-1 block w-44 border border-bo-border rounded px-3 py-2"
        />
      </label>
      <label class="block">
        <span class="text-bo-muted">Supplément A4 (€)</span>
        <input
          name="priceA4"
          type="number"
          step="0.01"
          min="0"
          value="15.00"
          class="mt-1 block w-28 border border-bo-border rounded px-3 py-2"
        />
      </label>
      <label class="block">
        <span class="text-bo-muted">Supplément A3 (€)</span>
        <input
          name="priceA3"
          type="number"
          step="0.01"
          min="0"
          value="15.00"
          class="mt-1 block w-28 border border-bo-border rounded px-3 py-2"
        />
      </label>
      <label class="block">
        <span class="text-bo-muted">Poids (g)</span>
        <input
          name="weightGrams"
          type="number"
          min="0"
          step="1"
          value="0"
          class="mt-1 block w-28 border border-bo-border rounded px-3 py-2"
        />
      </label>
      <label class="block">
        <span class="text-bo-muted">Couleur d'aperçu</span>
        <input
          name="previewColor"
          type="color"
          value="#2b2b2b"
          class="mt-1 block h-10 w-14 border border-bo-border rounded"
        />
      </label>
      <label class="block">
        <span class="text-bo-muted">Ordre</span>
        <input
          name="position"
          type="number"
          value={cadres.length}
          class="mt-1 block w-20 border border-bo-border rounded px-3 py-2"
        />
      </label>
      <label class="flex items-center gap-2 pb-2">
        <input type="checkbox" name="active" checked />
        <span>Affiché</span>
      </label>
      <button class="rounded bg-bo-accent text-white px-4 py-2">Créer</button>
    </form>
  </details>

  <script is:inline>
    // Archiver retire le cadre de la vente : on demande confirmation, avec ce
    // que cela change — et ce que cela NE change pas pour les commandes.
    document.querySelectorAll("form.js-archiver").forEach((f) => {
      f.addEventListener("submit", (e) => {
        const message = f.getAttribute("data-message") || "Archiver ce cadre ?";
        if (!confirm(message)) e.preventDefault();
      });
    });
  </script>
</Admin>
