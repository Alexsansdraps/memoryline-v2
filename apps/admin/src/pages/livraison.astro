---
import Admin from "../layouts/Admin.astro";
import { adminApi, formatPrice, type CatalogueLivraisonBO } from "../lib/api.ts";

const api = adminApi(Astro.request);

/** Euros saisis -> centimes. Champ vide = pas de franchise de port. */
function centimes(v: FormDataEntryValue | null): number | null {
  const t = String(v ?? "").replace(",", ".").trim();
  if (!t) return null;
  const n = Number(t);
  return Number.isFinite(n) ? Math.round(n * 100) : null;
}

let flash: string | null = null;
let flashErreur = false;

if (Astro.request.method === "POST") {
  const f = await Astro.request.formData();
  const action = f.get("_action");
  try {
    if (action === "mode") {
      await api.updateShippingMethod(Number(f.get("id")), {
        name: String(f.get("name") || ""),
        description: String(f.get("description") || ""),
        pickupLocation: String(f.get("pickupLocation") || ""),
        active: f.get("active") === "on",
      });
      flash = "Mode de livraison enregistré.";
    } else if (action === "zone") {
      await api.updateShippingZone(Number(f.get("id")), {
        name: String(f.get("name") || ""),
        countries: String(f.get("countries") || ""),
      });
      flash = "Zone enregistrée.";
    } else {
      await api.updateShippingRate({
        methodId: Number(f.get("methodId")),
        zoneId: Number(f.get("zoneId")),
        priceCents: centimes(f.get("price")) ?? 0,
        freeFromCents: centimes(f.get("freeFrom")),
        active: f.get("active") === "on",
      });
      flash = "Tarif enregistré.";
    }
  } catch (e) {
    flash = "Erreur : " + String(e);
    flashErreur = true;
  }
}

/**
 * La recherche de points relais est-elle branchée ? On le déduit du catalogue
 * PUBLIC : il masque le mode « relay » tant que le compte manque.
 */
let relaisPret = true;
try {
  const res = await fetch(
    `${import.meta.env.API_URL_INTERNAL ?? import.meta.env.PUBLIC_API_URL ?? "http://localhost:3000"}/shipping`,
  );
  const publique = (await res.json()) as { modes: { kind: string }[] };
  relaisPret = publique.modes.some((m) => m.kind === "relay");
} catch {
  // API injoignable : on ne dit rien plutôt que d'alarmer à tort.
}

let cat: CatalogueLivraisonBO = { zones: [], modes: [], tarifs: [] };
let error: string | null = null;
try {
  cat = await api.shipping();
} catch (e) {
  error = String(e);
}

const tarif = (methodId: number, zoneId: number) =>
  cat.tarifs.find((t) => t.methodId === methodId && t.zoneId === zoneId);

const NOM_NATURE: Record<string, string> = {
  relay: "Point relais",
  home: "À domicile",
  pickup: "Retrait sur place",
};
---

<Admin title="Livraison">
  {flash && (
    <p
      class={`mb-4 text-sm rounded px-3 py-2 border ${
        flashErreur ? "bg-red-50 border-red-200" : "bg-green-50 border-green-200"
      }`}
    >
      {flash}
    </p>
  )}
  {error && <p class="mb-4 text-red-600 text-sm">API injoignable : {error}</p>}

  <p class="mb-6 text-sm text-bo-muted max-w-3xl">
    Ce que le client peut choisir au moment de payer, et combien ça lui coûte.
    Le prix dépend du <strong>mode</strong> et de la <strong>zone</strong> :
    c'est le croisement des deux, dans le tableau plus bas, qui décide.
  </p>

  {/* ------------------------------------------------------------------ */}
  {/* Modes                                                               */}
  {/* ------------------------------------------------------------------ */}
  {/* Le point relais suppose un compte transporteur : tant qu'il manque, le
      mode est masqué côté site et il vaut mieux le dire ici. */}
  {cat.modes.some((m) => m.kind === "relay") && !relaisPret && (
    <p class="mb-6 rounded border border-amber-200 bg-amber-50 px-3 py-2 text-sm">
      <strong>Point relais masqué sur le site.</strong> La recherche de points
      relais demande un compte Mondial Relay : ajoutez
      <code> MONDIAL_RELAY_ENSEIGNE</code> et <code>MONDIAL_RELAY_CLE</code>
      dans le fichier <code>.env</code>, puis redémarrez l'API. Sans eux, le
      client ne pourrait pas choisir son point relais — et une adresse saisie
      à la main ne sert à rien pour l'expédition.
    </p>
  )}

  <h3 class="font-semibold mb-3">Modes de livraison</h3>
  <section class="mb-8 space-y-3">
    {cat.modes.map((m) => (
      <form
        method="POST"
        class="bg-bo-surface border border-bo-border rounded-lg p-4 text-sm"
      >
        <input type="hidden" name="_action" value="mode" />
        <input type="hidden" name="id" value={m.id} />
        <div class="flex flex-wrap items-end gap-3">
          <label class="block">
            <span class="text-bo-muted text-xs">Nom vu par le client</span>
            <input
              name="name"
              value={m.name}
              class="mt-1 block w-52 border border-bo-border rounded px-2 py-1"
            />
          </label>
          <label class="block flex-1 min-w-[260px]">
            <span class="text-bo-muted text-xs">Précision (délai…)</span>
            <input
              name="description"
              value={m.description ?? ""}
              class="mt-1 block w-full border border-bo-border rounded px-2 py-1"
            />
          </label>
          <label class="flex items-center gap-2 pb-1.5">
            <input type="checkbox" name="active" checked={m.active} />
            <span>Proposé</span>
          </label>
          <button class="rounded bg-bo-accent text-white px-3 py-1.5">
            Enregistrer
          </button>
        </div>

        {/* Retrait sur place : l'emplacement change de salon en salon. */}
        {m.kind === "pickup" && (
          <label class="mt-3 block">
            <span class="text-bo-muted text-xs">
              Où retirer — affiché au client quand il choisit ce mode
            </span>
            <input
              name="pickupLocation"
              value={m.pickupLocation ?? ""}
              placeholder="Marché de Mers-les-Bains, samedi 9 h – 13 h"
              class="mt-1 block w-full border border-bo-border rounded px-2 py-1"
            />
            <span class="mt-1 block text-xs text-bo-muted">
              Décochez « Proposé » les semaines où vous n'êtes nulle part.
            </span>
          </label>
        )}
        {m.kind !== "pickup" && (
          <input type="hidden" name="pickupLocation" value={m.pickupLocation ?? ""} />
        )}
        <p class="mt-2 text-xs text-bo-muted">
          {NOM_NATURE[m.kind] ?? m.kind} · identifiant <code>{m.slug}</code>
          {m.carrier ? ` · transporteur ${m.carrier}` : ""}
        </p>
      </form>
    ))}
  </section>

  {/* ------------------------------------------------------------------ */}
  {/* Tarifs                                                              */}
  {/* ------------------------------------------------------------------ */}
  <h3 class="font-semibold mb-1">Tarifs</h3>
  <p class="mb-3 text-sm text-bo-muted max-w-3xl">
    Un prix par mode et par zone. Le champ « offert à partir de » se compare au
    panier <strong>après remises</strong> — laissez-le vide pour ne jamais
    offrir le port. Décochez « Disponible » pour retirer un mode d'une zone
    (le retrait sur place n'a pas de sens à l'étranger).
  </p>
  <section class="mb-8 space-y-6">
    {cat.zones.map((z) => (
      <div class="bg-bo-surface border border-bo-border rounded-lg overflow-hidden">
        <div class="bg-bo-bg px-4 py-2 text-sm font-medium">{z.name}</div>
        <table class="w-full text-sm">
          <tbody>
            {cat.modes.map((m) => {
              const t = tarif(m.id, z.id);
              return (
                <tr class="border-t border-bo-border">
                  <td class="px-4 py-3">
                    <form method="POST" class="flex flex-wrap items-end gap-3">
                      <input type="hidden" name="methodId" value={m.id} />
                      <input type="hidden" name="zoneId" value={z.id} />
                      <span class="w-40 pb-1.5">{m.name}</span>
                      <label class="block">
                        <span class="text-bo-muted text-xs">Prix (€)</span>
                        <input
                          name="price"
                          type="number"
                          step="0.01"
                          min="0"
                          value={((t?.priceCents ?? 0) / 100).toFixed(2)}
                          class="mt-1 block w-24 border border-bo-border rounded px-2 py-1"
                        />
                      </label>
                      <label class="block">
                        <span class="text-bo-muted text-xs">
                          Offert à partir de (€)
                        </span>
                        <input
                          name="freeFrom"
                          type="number"
                          step="0.01"
                          min="0"
                          value={
                            t?.freeFromCents == null
                              ? ""
                              : (t.freeFromCents / 100).toFixed(2)
                          }
                          placeholder="jamais"
                          class="mt-1 block w-32 border border-bo-border rounded px-2 py-1"
                        />
                      </label>
                      <label class="flex items-center gap-2 pb-1.5">
                        <input
                          type="checkbox"
                          name="active"
                          checked={t?.active ?? true}
                        />
                        <span>Disponible</span>
                      </label>
                      <button class="rounded bg-bo-accent text-white px-3 py-1.5">
                        Enregistrer
                      </button>
                      <span class="pb-1.5 text-xs text-bo-muted">
                        {t
                          ? `actuellement ${formatPrice(t.priceCents)}`
                          : "aucun tarif"}
                      </span>
                    </form>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    ))}
  </section>

  {/* ------------------------------------------------------------------ */}
  {/* Zones                                                               */}
  {/* ------------------------------------------------------------------ */}
  <h3 class="font-semibold mb-1">Zones</h3>
  <p class="mb-3 text-sm text-bo-muted max-w-3xl">
    Les pays qui partagent les mêmes tarifs, en codes à deux lettres (FR, BE,
    CH…). Une zone <strong>sans aucun pays</strong> est la zone de repli :
    elle prend tous les pays que les autres ne citent pas — sans elle, un
    client d'un pays oublié ne pourrait pas commander.
  </p>
  <section class="space-y-3">
    {cat.zones.map((z) => (
      <form
        method="POST"
        class="bg-bo-surface border border-bo-border rounded-lg p-4 text-sm"
      >
        <input type="hidden" name="_action" value="zone" />
        <input type="hidden" name="id" value={z.id} />
        <div class="flex flex-wrap items-end gap-3">
          <label class="block">
            <span class="text-bo-muted text-xs">Nom</span>
            <input
              name="name"
              value={z.name}
              class="mt-1 block w-44 border border-bo-border rounded px-2 py-1"
            />
          </label>
          <label class="block flex-1 min-w-[300px]">
            <span class="text-bo-muted text-xs">
              Pays ({(z.countries ?? []).length})
            </span>
            <input
              name="countries"
              value={(z.countries ?? []).join(", ")}
              placeholder="vide = zone de repli"
              class="mt-1 block w-full border border-bo-border rounded px-2 py-1 font-mono text-xs"
            />
          </label>
          <button class="rounded bg-bo-accent text-white px-3 py-1.5">
            Enregistrer
          </button>
        </div>
      </form>
    ))}
  </section>
</Admin>
