        {m.kind !== "pickup" && (
          <label class="mt-3 block">
            <span class="text-bo-muted text-xs">Transporteur</span>
            <select
              name="carrier"
              class="mt-1 block w-64 border border-bo-border rounded px-2 py-1"
            >
              {m.kind !== "relay" && (
                <option value="" selected={!m.carrier}>
                  Aucun
                </option>
              )}
              {transporteurs.map((t) => (
                <option value={t.code} selected={m.carrier === t.code}>
                  {t.nom}
                </option>
              ))}
            </select>
          </label>
        )}

        {/* Votre propre remarque sur ce mode, à côté de la liste calculée
            plus bas : le nom de votre interlocuteur, une date de rendez-vous,
