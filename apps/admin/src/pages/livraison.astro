              </div>
              <button
                type="submit"
                name="archiver"
                value="1"
                formnovalidate
                class="text-sm text-bo-accent hover:underline"
              >
                Restaurer
              </button>
              <button
                type="submit"
                name="supprimer"
                value="mode"
                formnovalidate
                data-supprimer={`Supprimer définitivement « ${m.name} » ? C'est sans retour.`}
                class="text-sm text-red-700 hover:underline"
              >
                Supprimer définitivement
              </button>
            </form>
          ))}
        </div>
      </div>
