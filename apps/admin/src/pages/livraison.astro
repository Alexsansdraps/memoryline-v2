              name="supprimer"
              value="tarif"
              data-supprimer={`Supprimer définitivement « ${nomMode(t.methodId)} · ${nomZone(t.zoneId)} · ${bornes(t.minWeightGrams, t.maxWeightGrams)} » ? C'est sans retour.`}
