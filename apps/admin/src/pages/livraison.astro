---
import { url } from "../lib/url.ts";
import Admin from "../layouts/Admin.astro";
import Traductions from "../components/Traductions.astro";
import {
  adminApi,
  formatPrice,
  type CatalogueLivraisonBO,
  type TranchesStandard,
} from "../lib/api.ts";
import {
  nomCase,
  traiterTraductions,
  type ChampTraduit,
  type ElementTraduit,
  type EtatTraductions,
} from "../lib/traductions.ts";

const api = adminApi(Astro.request);

type ModeBO = CatalogueLivraisonBO["modes"][number];

/**
 * Ce qui se traduit d'un mode : ce que la caisse montre au client, et que
 * redisent ses courriels et sa facture. Le lieu de retrait n'existe que pour
 * un retrait sur place. La note de préparation, écrite pour la boutique,
 * n'en fait pas partie.
 */
const CHAMPS_MODE: ChampTraduit[] = [
  { cle: "name", libelle: "Nom vu par le client", max: 120 },
  { cle: "description", libelle: "Précision (délai…)", max: 500 },
];
/**
 * Pour un retrait sur place, la « précision » devient le texte de plusieurs
 * lignes que la caisse affiche sous le mode (horaires, ce qu'il faut
 * apporter) — demande de la boutique. L'ancien « Où retirer » ne se traduit
 * plus : la caisse ne l'affiche plus, les lieux de retrait l'ont remplacé.
 */
const CHAMP_TEXTE_RETRAIT: ChampTraduit = {
  cle: "description",
  libelle: "Texte affiché à la caisse",
  lignes: 4,
  max: 1000,
};
const elementMode = (m: ModeBO): ElementTraduit => ({
  id: m.id,
  libelle: m.name,
  francais: { name: m.name, description: m.description },
  translations: m.translations,
  champs: m.kind === "pickup" ? [CHAMPS_MODE[0]!, CHAMP_TEXTE_RETRAIT] : CHAMPS_MODE,
});

/**
 * Le bloc de traductions qu'on vient d'utiliser : celui de ce mode reste
 * ouvert, avec ses propositions à relire ou la saisie refusée.
 */
let tradMode: { id: number; etat: EtatTraductions } | null = null;

/** Euros saisis -> centimes. Champ vide = pas de valeur. */
function centimes(v: FormDataEntryValue | null | undefined): number | null {
  const t = String(v ?? "").replace(",", ".").trim();
  if (!t) return null;
  const n = Number(t);
  return Number.isFinite(n) ? Math.round(n * 100) : null;
}

/** Borne de poids saisie -> grammes entiers. Champ vide = pas de borne. */
function borne(v: FormDataEntryValue | null | undefined): number | null {
  const t = String(v ?? "").replace(",", ".").trim();
  if (!t) return null;
  const n = Math.round(Number(t));
  return Number.isFinite(n) && n >= 0 ? n : null;
}

/**
 * Une route pas encore déployée doit se lire, pas se deviner : la cliente
 * n'a pas à traduire un 404 en « redémarrez l'API ».
 */
function lisible(e: unknown): string {
  const t = String(e).replace(/^Error:\s*/, "");
  return t.includes("404")
    ? "Cette fonction n'est pas encore disponible côté API. Redémarrez l'API, puis réessayez."
    : t;
}

let flash: string | null = null;
let flashErreur = false;

if (Astro.request.method === "POST") {
  const f = await Astro.request.formData();
  // Lu AVANT `_action` : le bouton Archiver vit dans le formulaire de
  // modification, qui porte son propre `_action` caché. De même pour
  // « Supprimer définitivement », logé dans le formulaire de restauration
  // d'un mode ou d'une tranche archivés : il dit lequel (« mode », « tarif »).
  const supprimer = String(f.get("supprimer") ?? "");
  const action =
    supprimer === "mode" || supprimer === "tarif"
      ? `${supprimer}-supprimer`
      : f.get("archiver")
        ? "mode-archiver"
        : f.get("_action");
  try {
    if (action === "mode-traductions" || action === "mode-traduire") {
      // Chaque mode a son bloc : le formulaire ne porte que les cases du
      // sien, et seules celles-là sont enregistrées ou complétées.
      const modes = (await api.shipping()).modes.filter((m) => !m.archivedAt);
      const vise = modes.find((m) =>
        CHAMPS_MODE.some((c) => f.has(nomCase(m.id, c.cle, "en"))),
      );
      if (!vise) throw new Error("Ce mode de livraison n'a pas été retrouvé. Rechargez l'écran.");
      const etat = await traiterTraductions(
        action === "mode-traductions" ? "enregistrer" : "proposer",
        f,
        [elementMode(vise)],
        CHAMPS_MODE,
        (id, lang, modifies) =>
          api.setShippingMethodTranslation(Number(id), { lang, ...modifies }),
        (lang, champs) => api.proposerTraduction(lang, champs),
      );
      tradMode = { id: vise.id, etat };
      flash = `« ${vise.name} » : ${etat.message}`;
      flashErreur = etat.erreur;
    } else if (action === "mode") {
      await api.updateShippingMethod(Number(f.get("id")), {
        name: String(f.get("name") || ""),
        description: String(f.get("description") || ""),
        // Le champ n'existe pas sur un mode sans transporteur (un retrait sur
        // place) : ne rien envoyer vaut mieux que d'envoyer du vide, qui
        // effacerait le transporteur d'un point relais.
        ...(f.has("carrier") ? { carrier: String(f.get("carrier") || "") } : {}),
        pickupLocation: String(f.get("pickupLocation") || ""),
        notePreparation: String(f.get("notePreparation") || ""),
        active: f.get("active") === "on",
      });
      flash = "Mode de livraison enregistré.";
    } else if (action === "mode-ordre") {
      // L'écran connaît l'ordre affiché ; il envoie la liste ENTIÈRE, le mode
      // déplacé d'un cran. Un « monte d'un cran » côté API ne saurait pas
      // départager deux modes posés à la même position.
      const ordre = f
        .getAll("ordre")
        .map((v) => Number(v))
        .filter((n) => Number.isFinite(n));
      const id = Number(f.get("id"));
      const sens = String(f.get("sens") || "");
      const i = ordre.indexOf(id);
      const j = sens === "haut" ? i - 1 : i + 1;
      if (i < 0 || j < 0 || j >= ordre.length)
        throw new Error("Ce mode est déjà au bout de la liste.");
      [ordre[i], ordre[j]] = [ordre[j]!, ordre[i]!];
      await api.ordonnerModesLivraison(ordre);
      flash = `Ordre enregistré : « ${String(f.get("libelle") || "ce mode")} » ${
        sens === "haut" ? "remonte" : "descend"
      } d'un cran. C'est dans cet ordre que le client les verra.`;
    } else if (action === "mode-creer") {
      await api.createShippingMethod({
        name: String(f.get("name") || ""),
        kind: String(f.get("kind") || "home"),
        carrier: String(f.get("carrier") || "") || undefined,
        description: String(f.get("description") || ""),
        notePreparation: String(f.get("notePreparation") || ""),
      });
      flash =
        "Mode créé. Il est décoché : fixez ses tarifs plus bas, puis cochez « Proposé ».";
    } else if (action === "mode-archiver") {
      const restaurer = f.get("archived") === "false";
      const { commandes } = await api.archiverModeLivraison(
        Number(f.get("id")),
        !restaurer,
      );
      const nom = String(f.get("libelle") || "Ce mode");
      flash = restaurer
        ? `Mode « ${nom} » restauré, avec toute sa grille tarifaire. Il est décoché : cochez « Proposé » quand vous voudrez le reproposer.`
        : `Mode « ${nom} » archivé : il n'est plus proposé au client.${
            commandes > 0
              ? ` Les ${commandes} commande${commandes > 1 ? "s" : ""} parties avec lui continuent de l'afficher.`
              : ""
          } Sa grille est gardée entière ; vous pouvez le restaurer plus bas.`;
    } else if (action === "mode-supprimer" || action === "tarif-supprimer") {
      // Refusé pour un mode qui a servi à une commande : la phrase de l'API
      // s'affiche telle quelle, sans « Erreur : », et il reste archivé.
      const nom = String(f.get("libelle") || "Cet élément");
      try {
        if (action === "mode-supprimer") {
          await api.supprimerModeLivraison(Number(f.get("id")));
          flash = `Mode « ${nom} » supprimé définitivement, avec sa grille tarifaire.`;
        } else {
          await api.supprimerTarifLivraison(Number(f.get("id")));
          flash = `Tranche « ${nom} » supprimée définitivement.`;
        }
      } catch (e) {
        flash = lisible(e);
        flashErreur = true;
      }
    } else if (action === "tarif-restaurer") {
      await api.archiverTarifLivraison(Number(f.get("id")), false);
      flash = "Tranche restaurée : elle facture de nouveau dans sa grille.";
    } else if (action === "zone") {
      await api.updateShippingZone(Number(f.get("id")), {
        name: String(f.get("name") || ""),
        countries: String(f.get("countries") || ""),
      });
      flash = "Zone enregistrée.";
    } else {
      // La grille part entière : une tranche retirée de l'écran doit quitter
      // la grille — l'API l'ARCHIVE alors, elle ne l'efface pas (elle attend
      // dans « Tranches archivées »). Ligne à ligne, on l'oublierait.
      const mins = f.getAll("min");
      const maxs = f.getAll("max");
      const prix = f.getAll("price");
      const tranches: {
        minWeightGrams: number;
        maxWeightGrams: number | null;
        priceCents: number;
      }[] = [];
      for (let i = 0; i < mins.length; i++) {
        const min = borne(mins[i]);
        const max = borne(maxs[i]);
        const p = centimes(prix[i]);
        if (min === null && max === null && p === null) continue;
        // Aucun prix n'est deviné : une tranche sans prix est une erreur de
        // saisie, pas un port gratuit.
        if (p === null)
          throw new Error(
            `La tranche à partir de ${min ?? 0} g n'a pas de prix : saisissez-le, ou retirez la ligne.`,
          );
        if (max !== null && max <= (min ?? 0))
          throw new Error(
            `Tranche impossible : ${max} g n'est pas au-dessus de ${min ?? 0} g.`,
          );
        tranches.push({
          minWeightGrams: min ?? 0,
          maxWeightGrams: max,
          priceCents: p,
        });
      }
      tranches.sort((a, b) => a.minWeightGrams - b.minWeightGrams);
      const r = await api.setShippingGrille({
        methodId: Number(f.get("methodId")),
        zoneId: Number(f.get("zoneId")),
        freeFromCents: centimes(f.get("freeFrom")),
        tranches,
      });
      flash = tranches.length
        ? `Grille enregistrée : ${r.count} tranche(s).`
        : "Grille vidée : ce mode ne sera plus proposé dans cette zone.";
    }
  } catch (e) {
    flash = "Erreur : " + lisible(e);
    flashErreur = true;
  }
}


let cat: CatalogueLivraisonBO = { zones: [], modes: [], tarifs: [] };
let error: string | null = null;
try {
  cat = await api.shipping();
} catch (e) {
  error = String(e);
}

// Bornes habituelles des transporteurs : une aide à la saisie, jamais des
// prix. Si la route manque, les boutons disparaissent et on le dit.
let standard: TranchesStandard | null = null;
let erreurStandard: string | null = null;
try {
  standard = await api.tranchesStandard();
} catch (e) {
  erreurStandard = lisible(e);
}

// Les archivés quittent les listes ordinaires pour leurs propres sections.
const modesActifs = cat.modes.filter((m) => !m.archivedAt);
const modesArchives = cat.modes.filter((m) => m.archivedAt);
const tarifsVivants = cat.tarifs.filter((t) => !t.archivedAt);
const tarifsArchives = cat.tarifs.filter((t) => t.archivedAt);

/** Les tranches proposées au client, de la plus légère à la plus lourde. */
const grille = (methodId: number, zoneId: number) =>
  tarifsVivants
    .filter((t) => t.methodId === methodId && t.zoneId === zoneId && t.active)
    .sort((a, b) => a.minWeightGrams - b.minWeightGrams);

/** Lignes désactivées : elles bloquent le mode sans apparaître dans la grille. */
const retire = (methodId: number, zoneId: number) =>
  tarifsVivants.some(
    (t) => t.methodId === methodId && t.zoneId === zoneId && !t.active,
  );

/** Le nom d'un mode et d'une zone, pour nommer une tranche archivée. */
const nomMode = (id: number) =>
  cat.modes.find((m) => m.id === id)?.name ?? "mode retiré";
const nomZone = (id: number) =>
  cat.zones.find((z) => z.id === id)?.name ?? "zone retirée";

/** Une borne de poids en toutes lettres : « de 0 g à 500 g ». */
const bornes = (min: number, max: number | null) =>
  max === null ? `à partir de ${min} g` : `de ${min} g à ${max} g`;

/** Ce qu'il faut avoir lu avant d'archiver un mode de livraison. */
function messageArchivage(m: { name: string }): string {
  return [
    `Archiver le mode « ${m.name} » ?`,
    "Il ne sera plus proposé au client. Sa grille tarifaire est gardée entière, et les commandes déjà parties avec lui continuent de l'afficher — rien n'est supprimé.",
    "Vous pourrez le restaurer quand vous voudrez, dans « Modes archivés ».",
  ].join("\n\n");
}

/**
 * Les natures et les transporteurs, tels que l'API les connaît. Les deux
 * listes vivent là-bas : une copie ici finirait par proposer une nature ou un
 * transporteur que l'API refuse.
 */
const natures = cat.natures ?? [];
const NOM_NATURE: Record<string, string> = Object.fromEntries(
  natures.map((n) => [n.code, n.nom]),
);
/**
 * Le nom lisible d'une nature — et, si l'API ne la connaît plus, un
 * avertissement plutôt qu'un code brut : un vieux mode restauré des archives
 * porte une nature abandonnée, et « letter » tout seul ne veut rien dire.
 */
const libelleNature = (kind: string) =>
  NOM_NATURE[kind] ?? `nature « ${kind} » inconnue`;
const transporteurs = cat.transporteurs ?? [];
const NOM_TRANSPORTEUR: Record<string, string> = Object.fromEntries(
  transporteurs.map((t) => [t.code, t.nom]),
);

/** Ce mode est-il prêt de bout en bout ? */
const toutEstFait = (etapes: { fait: boolean }[]) => etapes.every((e) => e.fait);

/**
 * Ce que le repli « ce qu'il reste à faire » annonce, plié.
 *
 * Le compte AVANT le détail : replié, l'écran doit déjà dire s'il reste du
 * travail sur ce mode, sans qu'on ait à le déplier pour l'apprendre.
 */
const resumeOuverture = (etapes: { fait: boolean }[]) => {
  const restants = etapes.filter((e) => !e.fait).length;
  return restants === 0
    ? `Les ${etapes.length} étapes sont faites — dépliez pour les revoir.`
    : `Il reste ${restants} chose(s) à faire pour l'ouvrir, ${
        etapes.length - restants
      } déjà faite(s) — dépliez pour voir lesquelles.`;
};

/**
 * L'ordre affiché, tel qu'il partira aux boutons « monter / descendre ».
 *
 * Le même tableau sert à l'affichage et au déplacement : l'API reçoit ainsi
 * exactement la liste qu'Alexandra a sous les yeux, et non une reconstruction
 * qui pourrait différer d'un tri.
 */
const ordreModes = modesActifs.map((m) => m.id);
---

<Admin title="Livraison">
  {flash && (
    <p
      class={`mb-4 text-sm rounded px-3 py-2 border ${
        flashErreur ? "bg-red-50 border-red-200" : "bg-green-50 border-green-200"
      }`}
    >
      {flash}
    </p>
  )}
  {error && <p class="mb-4 text-red-600 text-sm">API injoignable : {error}</p>}

  <p class="mb-3 text-sm text-bo-muted max-w-3xl">
    Ce que le client peut choisir au moment de payer, et combien ça lui coûte.
    Le prix dépend du <strong>mode</strong>, de la <strong>zone</strong> et du
    <strong>poids du colis</strong> : c'est le croisement des trois, dans les
    grilles plus bas, qui décide.
  </p>
  {/* Les modes préparés d'avance arrivent décochés et sans prix. Sans cette
      explication, la liste a l'air de s'être remplie toute seule. */}
  <p class="mb-6 rounded border border-bo-border bg-bo-surface px-3 py-2 text-sm text-bo-muted max-w-3xl">
    Tous les transporteurs qu'une boutique d'affiches peut ouvrir sont déjà là,
    <strong>décochés et sans prix</strong> : Colissimo, Mondial Relay, Relais
    Colis, Chronopost, Colis Privé, DPD, GLS, Shop2Shop, UPS et DHL, à domicile
    et en point relais. Rien n'apparaît sur le site tant que vous ne les avez
    pas cochés. Le jour où vous signez un contrat, il n'y a qu'à <strong
      >saisir le prix</strong
    > dans la grille, puis cocher « Proposé » — aucun développeur à appeler.
    Chaque mode dit lui-même, sous « Ce qu'il reste à faire pour l'ouvrir », ce
    qui lui manque encore et ce qui est déjà fait.
  </p>
  <p class="mb-6 text-sm text-bo-muted max-w-3xl">
    Pas de <strong>lettre suivie</strong> : une affiche part roulée dans un tube
    ou sous pli rigide, c'est un colis. Un affranchissement de lettre ne
    couvrirait ni l'épaisseur, ni le cadre, ni la casse.
  </p>

  {/* ------------------------------------------------------------------ */}
  {/* Modes                                                               */}
  {/* ------------------------------------------------------------------ */}
  {/* Chaque mode dit lui-même s'il sort sur le site : un avertissement
      général ne disait pas LEQUEL des modes était masqué, ni pourquoi. */}

  <h3 class="font-semibold mb-3">Modes de livraison</h3>
  <section class="mb-8 space-y-3">
    {modesActifs.map((m) => (
      <Fragment>
      <form
        id={`mode-${m.id}`}
        method="POST"
        class="bg-bo-surface border border-bo-border rounded-lg p-4 text-sm"
      >
        <input type="hidden" name="_action" value="mode" />
        <input type="hidden" name="id" value={m.id} />
        <div class="flex flex-wrap items-end gap-3">
          <label class="block">
            <span class="text-bo-muted text-xs">Nom vu par le client</span>
            <input
              name="name"
              value={m.name}
              class="mt-1 block w-52 border border-bo-border rounded px-2 py-1"
            />
          </label>
          {m.kind !== "pickup" && (
            <label class="block flex-1 min-w-[260px]">
              <span class="text-bo-muted text-xs">Précision (délai…)</span>
              <input
                name="description"
                value={m.description ?? ""}
                class="mt-1 block w-full border border-bo-border rounded px-2 py-1"
              />
            </label>
          )}
          <label class="flex items-center gap-2 pb-1.5">
            <input type="checkbox" name="active" checked={m.active} />
            <span>Proposé</span>
          </label>
          <button class="rounded bg-bo-accent text-white px-3 py-1.5">
            Enregistrer
          </button>
        </div>

        {/* Retrait sur place : un texte libre sur plusieurs lignes, montré
            sous le mode à la caisse (demande de la boutique : « me laisser
            mettre une description, pouvoir passer à la ligne »). Les
            endroits eux-mêmes — le chalet, l'atelier — sont des lieux de
            retrait, réglés sur leur propre écran. */}
        {m.kind === "pickup" && (
          <>
            <label class="mt-3 block">
              <span class="text-bo-muted text-xs">
                Texte affiché à la caisse, sous « {m.name} »
              </span>
              <textarea
                name="description"
                rows="4"
                maxlength="1000"
                placeholder={"Votre commande vous attend sous 48 h.\nPensez à votre numéro de commande."}
                class="mt-1 block w-full border border-bo-border rounded px-2 py-1"
              >{m.description ?? ""}</textarea>
              <span class="mt-1 block text-xs text-bo-muted">
                Passez à la ligne autant que vous voulez : la caisse garde vos
                retours à la ligne. Où venir chercher la commande se règle
                dans <a class="underline" href={url("/livraison/lieux")}>Lieux
                de retrait</a> — la cliente choisit l'un d'eux en payant.
              </span>
            </label>
            {/* L'ancien « Où retirer » : la caisse ne l'affiche plus. Gardé
                tel quel (champ caché) pour ne rien effacer, et montré tant
                qu'il porte un texte, pour qu'on le recopie là où il sert. */}
            {m.pickupLocation?.trim() && (
              <p class="mt-3 rounded border border-amber-200 bg-amber-50 px-3 py-2 text-xs text-amber-900">
                Ancien texte, plus affiché à la caisse : « {m.pickupLocation} ».
                Recopiez ce qui doit rester dans le texte ci-dessus ou dans un
                lieu de retrait.
              </p>
            )}
          </>
        )}
        <input type="hidden" name="pickupLocation" value={m.pickupLocation ?? ""} />

        {/* Le transporteur se change ici : un mode préparé pour Relais Colis
            peut finir chez Chronopost si c'est ce contrat-là qui se signe.
            Un mode sans transporteur — un retrait sur place — n'en a pas
            besoin, et le champ absent laisse l'API tranquille. */}
        {m.kind !== "pickup" && (
          <label class="mt-3 block">
            <span class="text-bo-muted text-xs">Transporteur</span>
            <select
              name="carrier"
              class="mt-1 block w-64 border border-bo-border rounded px-2 py-1"
            >
              {m.kind !== "relay" && (
                <option value="" selected={!m.carrier}>
                  Aucun
                </option>
              )}
              {transporteurs.map((t) => (
                <option value={t.code} selected={m.carrier === t.code}>
                  {t.nom}
                </option>
              ))}
            </select>
          </label>
        )}

        {/* Votre propre remarque sur ce mode, à côté de la liste calculée
            plus bas : le nom de votre interlocuteur, une date de rendez-vous,
            un piège à ne pas oublier. Écrite pour vous, jamais montrée au
            client — videz-la le jour où elle n'a plus lieu d'être. */}
        <label class="mt-3 block">
          <span class="text-bo-muted text-xs">
            Votre note sur ce mode — jamais vue par le client
          </span>
          <textarea
            name="notePreparation"
            rows="2"
            placeholder="Devis demandé le 3 mars, relancer Mme X…"
            class="mt-1 block w-full border border-bo-border rounded px-2 py-1"
          >{m.notePreparation ?? ""}</textarea>
        </label>

        {/* L'état RÉEL, et ce qu'il faut faire pour en changer.

            « Proposé » coché ne suffit pas à faire apparaître un mode sur le
            site : sans cette liste, on coche, on ne voit rien, et on cherche
            l'erreur ailleurs. Elle dit TOUT d'un coup — contrat, prix, carte
            des points, case à cocher — parce que la question est « qu'est-ce
            qu'il me reste à faire », et que n'en montrer qu'un obligeait à
            revenir trois fois pour découvrir le suivant.

            Un repli, et non une liste toujours ouverte : dépliée pour quinze
            modes, la page ne se lirait plus. Il reste que tout est là, sur le
            même écran, sans rien aller chercher ailleurs — et un mode coché
            qui n'apparaît pourtant pas s'ouvre tout seul, parce que celui-là
            est une surprise à expliquer tout de suite.
            La liste est calculée par l'API — c'est elle qui sait quels
            comptes transporteurs sont branchés. Si elle ne la donne pas
            encore (API pas redémarrée), on retombe sur les raisons seules,
            plutôt que d'afficher un écran vide. */}
        {m.ouverture ? (
          <details
            class={`mt-3 rounded border px-3 py-2 text-xs ${
              toutEstFait(m.ouverture)
                ? "border-green-200 bg-green-50"
                : "border-amber-200 bg-amber-50"
            }`}
            open={m.active && !toutEstFait(m.ouverture)}
          >
            <summary class="cursor-pointer">
              <strong>
                {toutEstFait(m.ouverture)
                  ? "Visible sur le site : les clients peuvent le choisir."
                  : "Pas encore visible sur le site."}
              </strong>{" "}
              {resumeOuverture(m.ouverture)}
            </summary>
            <ul class="mt-2 space-y-1.5">
              {m.ouverture.map((e) => (
                <li class="flex gap-2">
                  <span
                    class={`mt-0.5 shrink-0 rounded px-1.5 py-0.5 font-semibold ${
                      e.fait
                        ? "bg-green-100 text-green-800"
                        : "bg-amber-100 text-amber-900"
                    }`}
                  >
                    {e.fait ? "FAIT" : "À FAIRE"}
                  </span>
                  <span>
                    <strong>{e.titre}</strong> — {e.detail}
                  </span>
                </li>
              ))}
            </ul>
          </details>
        ) : (m.masqueRaisons ?? []).length > 0 ? (
          <div class="mt-3 rounded border border-amber-200 bg-amber-50 px-3 py-2 text-xs">
            <p>
              <strong>Pas visible sur le site.</strong> Il manque :
            </p>
            <ul class="mt-1 list-disc space-y-0.5 pl-4">
              {(m.masqueRaisons ?? []).map((r) => (
                <li>{r}</li>
              ))}
            </ul>
          </div>
        ) : (
          <p class="mt-3 text-xs text-green-700">
            Visible sur le site : les clients peuvent le choisir.
          </p>
        )}
        <p class="mt-2 flex flex-wrap items-center gap-2 text-xs text-bo-muted">
          <span>
            {libelleNature(m.kind)} · identifiant <code>{m.slug}</code>
            {m.carrier
              ? ` · ${NOM_TRANSPORTEUR[m.carrier] ?? m.carrier}`
              : ""}
          </span>
          {/* Son propre champ, et non `_action` : le formulaire en porte
              déjà un, caché, et c'est le premier envoyé qui compte. */}
          <input type="hidden" name="libelle" value={m.name} />
          <input type="hidden" name="archived" value="true" />
          <button
            type="submit"
            name="archiver"
            value="1"
            formnovalidate
            data-archiver={messageArchivage(m)}
            class="ml-auto rounded border border-bo-border px-2 py-1 hover:border-bo-accent hover:text-bo-accent"
          >
            Archiver
          </button>
        </p>
      </form>

      {/* L'ordre des modes, dans son propre formulaire : imbriquer deux
          formulaires est interdit, et l'ordre n'a rien à voir avec le reste
          de la fiche — le déplacer ne doit pas enregistrer une saisie en
          cours par surprise. */}
      <form method="POST" class="-mt-1 flex items-center gap-2 px-4 text-xs text-bo-muted">
        <input type="hidden" name="_action" value="mode-ordre" />
        <input type="hidden" name="id" value={m.id} />
        <input type="hidden" name="libelle" value={m.name} />
        {ordreModes.map((id) => (
          <input type="hidden" name="ordre" value={id} />
        ))}
        <span>Ordre d'affichage chez le client :</span>
        <button
          name="sens"
          value="haut"
          disabled={ordreModes[0] === m.id}
          class="rounded border border-bo-border px-2 py-0.5 hover:border-bo-accent hover:text-bo-accent disabled:opacity-40"
          aria-label={`Remonter ${m.name}`}
        >
          ↑ Monter
        </button>
        <button
          name="sens"
          value="bas"
          disabled={ordreModes[ordreModes.length - 1] === m.id}
          class="rounded border border-bo-border px-2 py-0.5 hover:border-bo-accent hover:text-bo-accent disabled:opacity-40"
          aria-label={`Descendre ${m.name}`}
        >
          ↓ Descendre
        </button>
      </form>

      {/* Ce que le client étranger lit à la caisse, puis dans ses courriels
          et sur sa facture. Son propre formulaire, comme l'ordre : rien ne
          s'imbrique dans la fiche du mode. */}
      <Traductions
        ancre={`traductions-mode-${m.id}`}
        titre={m.kind === "pickup"
          ? "Traductions du nom et du texte affiché à la caisse"
          : "Traductions du nom et de la précision"}
        aide="Ce que le client lit en choisissant ce mode, dans sa langue — et ce que redisent son courriel de confirmation et sa facture. Une case vide affiche le français. Les bordereaux et vos écrans gardent le nom français."
        champs={CHAMPS_MODE}
        elements={[elementMode(m)]}
        disposition="langues"
        propositions={tradMode?.id === m.id ? tradMode.etat.propositions : undefined}
        saisies={tradMode?.id === m.id ? tradMode.etat.saisies : undefined}
        actionEnregistrer="mode-traductions"
        actionProposer="mode-traduire"
        ouvert={tradMode?.id === m.id}
        classe="ml-4 bg-bo-surface"
      />
      </Fragment>
    ))}

    {/* ---------------------------------------------------------------- */}
    {/* Les modes archivés                                                */}
    {/* ---------------------------------------------------------------- */}
    {modesArchives.length > 0 && (
      <div class="pt-2">
        <h4 class="mb-1 text-sm font-semibold">Modes archivés</h4>
        <p class="mb-2 max-w-3xl text-xs text-bo-muted">
          Retirés du tunnel de commande et de la liste ci-dessus. Leur grille
          tarifaire est gardée entière, et les commandes parties avec eux
          continuent de les nommer. « Restaurer » rend le mode et sa grille ;
          il revient décoché. « Supprimer définitivement » l'efface pour de
          bon, avec sa grille, s'il n'a servi à aucune commande.
        </p>
        <div class="space-y-2 opacity-70">
          {modesArchives.map((m) => (
            <form
              id={`mode-${m.id}`}
              method="POST"
              class="flex flex-wrap items-center gap-4 rounded-lg border border-bo-border bg-bo-surface p-3 text-sm"
            >
              <input type="hidden" name="_action" value="mode-archiver" />
              <input type="hidden" name="id" value={m.id} />
              <input type="hidden" name="libelle" value={m.name} />
              <input type="hidden" name="archived" value="false" />
              <div class="min-w-48 flex-1">
                <p class="font-medium">{m.name}</p>
                <p class="text-xs text-bo-muted">
                  {libelleNature(m.kind)} · identifiant{" "}
                  <code>{m.slug}</code>
                  {m.carrier
                    ? ` · ${NOM_TRANSPORTEUR[m.carrier] ?? m.carrier}`
