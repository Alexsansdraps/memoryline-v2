---
/**
 * Contenu du site — les textes de la vitrine, dans les cinq langues.
 *
 * Trois principes, et ils expliquent tout le reste de l'écran.
 *
 * 1. LE FRANÇAIS EST LA RÉFÉRENCE. Une langue qu'on n'a pas traduite retombe
 *    sur le français, jamais sur du vide. C'est pour cela que les champs des
 *    autres langues affichent le texte français en filigrane : on voit ce
 *    qu'on est en train de traduire, et une case laissée blanche est un choix
 *    lisible, pas un oubli invisible.
 *
 * 2. LA FORME NE SE TRADUIT PAS. Une image, un lien, un interrupteur, un
 *    nombre, une collection valent pour les cinq langues. Le jour où
 *    l'espagnol peut pointer une autre image, chaque langue devient une page
 *    indépendante que personne ne tient plus à jour.
 *
 * 3. ON NE CHANGE PAS DE PAGE POUR CHANGER DE LANGUE. Les cinq versions sont
 *    déjà à l'écran ; les onglets ne font que les montrer. Un onglet qui
 *    rechargerait la page perdrait la saisie en cours — c'est le défaut de
 *    l'écran des pages libres, qu'on ne reproduit pas ici.
 */
import Admin from "../layouts/Admin.astro";
import { adminApi, type CollectionBo } from "../lib/api.ts";
import { apiUrl, url } from "../lib/url.ts";
import {
  COLONNES_ORDINATEUR,
  COLONNES_TELEPHONE,
  PAGES_GRILLE,
  cleColonnes,
  cleColonnesTelephone,
  sourceVideo,
} from "@memoryline/types";

const api = adminApi(Astro.request);

/** Les langues du site. Le français en tête : c'est la référence. */
const LANGUES = [
  { code: "fr", nom: "Français" },
  { code: "en", nom: "English" },
  { code: "de", nom: "Deutsch" },
  { code: "it", nom: "Italiano" },
  { code: "es", nom: "Español" },
] as const;

let flash: string | null = null;
let flashErreur = false;

if (Astro.request.method === "POST") {
  const f = await Astro.request.formData();
  try {
    /*
     * Le nom d'un champ porte sa clé et, pour un texte traduisible, sa langue
     * après une arobase : « home.vitrine.title@de ».
     *
     * Les cases à cocher envoient deux valeurs — un « off » caché, puis « on »
     * si elles sont cochées. On ne garde que la dernière, qui reflète l'état
     * réel de la case.
     */
    const valeurs = new Map<string, string>();
    for (const [nom, value] of f.entries()) valeurs.set(nom, String(value));

    let ecrits = 0;
    for (const [nom, value] of valeurs) {
      const [cle, langue] = nom.split("@");
      if (!cle) continue;
      await api.setSetting(cle, value, langue || undefined);
      ecrits++;
    }
    flash = `Contenu enregistré (${ecrits} champ${ecrits > 1 ? "s" : ""}).`;
  } catch (e) {
    flash = "Erreur : " + String(e);
    flashErreur = true;
  }
}

/**
 * Les réglages, LIGNES ENTIÈRES : on a besoin des cinq langues, pas
 * seulement de celle qu'on servirait au visiteur.
 */
let lignes: { key: string; value: unknown }[] = [];
let erreur: string | null = null;
try {
  lignes = await api.settingsLignes();
} catch (e) {
  erreur = String(e);
}
const parCle = new Map(lignes.map((l) => [l.key, l.value]));

/**
 * Les collections, pour le choix de ce que montre la vitrine de l'accueil.
 *
 * Toutes, même vides ou désactivées : ce sont celles de l'écran
 * « Collections », et une collection qu'on prépare doit pouvoir se choisir
 * d'avance. La liste le signale simplement, parce que le site, lui, montre
 * alors les plus récentes à la place.
 */
let collections: CollectionBo[] = [];
let collectionsIllisibles = false;
try {
  collections = (await api.collections()).collections;
} catch {
  collectionsIllisibles = true;
}

/**
 * La valeur d'une clé dans une langue.
 *
 * Une valeur restée en chaîne est du français — c'est la forme d'origine,
 * d'avant que les réglages se traduisent, et elle reste valable.
 */
function valeur(cle: string, langue = "fr"): string {
  const brut = parCle.get(cle);
  if (brut === undefined || brut === null) return "";
  if (typeof brut === "string") return langue === "fr" ? brut : "";
  if (typeof brut === "object" && !Array.isArray(brut)) {
    const v = (brut as Record<string, unknown>)[langue];
    return typeof v === "string" ? v : "";
  }
  return String(brut);
}

/** Une section est affichée sauf si elle vaut explicitement « off ». */
const estAffichee = (cle: string) =>
  !["off", "non", "no", "0", "false"].includes(
    valeur(cle).trim().toLowerCase(),
  );

/** Combien de langues sont traduites, sur les quatre autres que le français. */
function avancement(cles: string[]): { faites: number; total: number } {
  const aTraduire = LANGUES.filter((l) => l.code !== "fr");
  let faites = 0;
  for (const l of aTraduire)
    if (cles.some((c) => valeur(c, l.code).trim())) faites++;
  return { faites, total: aTraduire.length };
}

/*
 * UN CHAMP CHIFFRÉ PORTE SES BORNES ET SA VALEUR D'USINE, et le type l'exige :
 * le gabarit partagé les écrivait en dur (« 1 à 24 », « 8 si vide »), c'est-à-
 * dire celles du nombre d'affiches de la vitrine. Les trois réglages de la
 * signature s'affichaient donc pré-remplis à 8 — et comme l'enregistrement
 * réécrit TOUS les champs du formulaire, pas seulement ceux qu'on a touchés, le
 * premier « Enregistrer » de cet écran, fût-ce pour une baseline, aurait posé
 * largeur 8 %, marge 8 % et opacité ramenée au plancher sur chaque aperçu et
 * chaque fichier d'impression, sans un mot. Dans l'autre sens, « max 24 »
 * interdisait de saisir une opacité de 100 et « min 1 » une marge de 0.
 *
 * Les bornes et les replis sont ceux du lecteur du réglage
 * (apps/api/src/fichiers-impression.ts — le module n'affiche plus la
 * signature, elle ne vit que sur le fichier d'impression) : un
 * champ pré-rempli à sa valeur d'usine écrit exactement ce que l'absence de
 * réglage donnait déjà, donc enregistrer ne change plus rien à l'écran ni sur
 * le papier.
 */
type Champ = {
  key: string;
  label: string;
  aide?: string;
} & (
  | {
      type:
        | "switch"
        | "texte"
        | "long"
        | "image"
        | "lien"
        | "collection"
        | "video";
    }
  | { type: "nombre"; min: number; max: number; defaut: number }
);

/**
 * Ce que la boutique fera de l'adresse saisie, dit en français.
 *
 * Calculé AU RENDU, par la même fonction que la boutique (`sourceVideo`) :
 * il n'y a donc qu'une seule définition de « adresse reconnue » dans tout le
 * projet. Le verdict ne se met pas à jour à la frappe — on le dit sous le
 * champ plutôt que de laisser croire à un bug.
 */
function verdictVideo(cle: string): { texte: string; alerte: boolean } {
  const brut = valeur(cle).trim();
  const s = sourceVideo(brut);
  if (!s)
    return brut
      ? {
          texte:
            "Adresse non reconnue : le bouton « Tuto » ne s'affichera pas. " +
            "Attendu : un lien YouTube, un lien Vimeo, ou un fichier .mp4 / .webm.",
          alerte: true,
        }
      : {
          texte: "Aucune vidéo : le bouton « Tuto » ne s'affiche pas.",
          alerte: false,
        };
  if (s.genre === "youtube")
    return { texte: "Lien YouTube reconnu.", alerte: false };
  if (s.genre === "vimeo")
    return { texte: "Lien Vimeo reconnu.", alerte: false };
  return { texte: "Vidéo hébergée par la boutique.", alerte: false };
}

/**
 * Le choix d'une collection, prêt à afficher : les options, et ce qu'il faut
 * en dire quand le site ne peut pas suivre ce choix.
 *
 * Une collection choisie puis supprimée n'est plus dans la liste : l'écran
 * propose alors « Les plus récentes », ce que le site montre déjà, et le dit.
 * Si la liste n'a pas pu être lue, en revanche, la valeur en place reste une
 * option cochée — sans quoi enregistrer les textes effacerait ce choix sans
 * que personne l'ait voulu.
 */
function choixCollection(cle: string) {
  const choisie = valeur(cle).trim();
  const options = collections.map((col) => {
    const etats = [
      col.produits === 0
        ? "vide"
        : `${col.produits} produit${col.produits > 1 ? "s" : ""}`,
      ...(col.active ? [] : ["désactivée"]),
    ];
    return { slug: col.slug, libelle: `${col.name} (${etats.join(", ")})` };
  });
  const trouvee = collections.find((col) => col.slug === choisie);
  if (choisie && !trouvee && collectionsIllisibles)
    options.push({ slug: choisie, libelle: `« ${choisie} » (choix actuel)` });

  let alerte: string | null = null;
  if (collectionsIllisibles)
    alerte =
      "La liste des collections n'a pas pu être lue. Le choix actuel est conservé si vous enregistrez.";
  else if (choisie && !trouvee)
    alerte = `La collection choisie auparavant (« ${choisie} ») n'existe plus : le site montre les plus récentes à sa place.`;
  else if (trouvee && (!trouvee.active || trouvee.produits === 0))
    alerte =
      "Cette collection est désactivée ou vide : le site montre les plus récentes à sa place, jusqu'à ce qu'elle contienne des affiches en vente.";

  const selection = options.some((o) => o.slug === choisie) ? choisie : "";
  return { options, selection, alerte };
}

const SECTIONS: { titre: string; aide: string; champs: Champ[] }[] = [
  {
    titre: "Personnalisation — vidéo explicative",
    aide:
      "Un petit bouton « ▶ Tuto » en haut à droite de la fenêtre de " +
      "personnalisation, à côté de la croix, aux trois étapes : un clic, et " +
      "la vidéo s'ouvre en pop-up. Tant qu'aucune vidéo n'est donnée, le " +
      "bouton ne s'affiche pas. Rien de YouTube ni de Vimeo n'est chargé tant " +
      "que la cliente n'a pas cliqué — c'est ce qui permet de ne pas toucher " +
      "au bandeau cookies. Au stand, le bouton ne s'affiche pas.",
    champs: [
      {
        key: "configurateur.video.visible",
        label: "Afficher le bouton « Tuto »",
        type: "switch",
      },
      {
        key: "configurateur.video.url",
        label: "Vidéo (lien ou fichier)",
        type: "video",
        aide:
          "Collez un lien YouTube ou Vimeo, ou envoyez un fichier .mp4 / " +
          ".webm (120 Mo maximum, une à deux minutes). Pour retirer la " +
          "vidéo, videz cette case et enregistrez : le bouton disparaît du " +
          "site. Le fichier déjà envoyé, lui, reste rangé sur le " +
          "serveur — rien ne se supprime.",
      },
      {
        key: "configurateur.video.poster",
        label: "Image d'attente (facultative)",
        type: "image",
        aide:
          "L'image figée montrée dans la pop-up avant la lecture d'un fichier " +
          ".mp4 / .webm. Laissez vide : la boutique affiche son propre visuel. " +
          "Elle n'utilise jamais la vignette de " +
          "YouTube, qui préviendrait YouTube de la visite avant même le clic.",
      },
      {
        key: "configurateur.video.titre",
        label: "Titre de la pop-up vidéo",
        type: "texte",
        aide:
          "Laissez vide pour le texte par défaut, déjà traduit dans les cinq " +
          "langues.",
      },
    ],
  },
  /*
   * L'encart en tête de l'accueil (home.encart.*) n'est plus réglé ici : il
   * est devenu le premier des « Bandeaux visuels », qui le reprennent tel
   * quel tant que rien n'y a été enregistré (bandeauDepuisEncart). Garder ses
   * champs ici ferait régler deux fois la même chose, dont une sans effet.
   */
  {
    titre: "Accueil — les affiches",
    aide: "La grille d'affiches mise en avant sur l'accueil.",
    champs: [
      { key: "home.vitrine.visible", label: "Afficher cette section", type: "switch" },
      { key: "home.vitrine.title", label: "Titre de la section", type: "texte" },
      {
        key: "home.vitrine.subtitle",
        label: "Texte d'introduction",
        type: "long",
        aide: "Une ligne par ligne ; commencez par « - » pour une puce.",
      },
      {
        key: "home.vitrine.collection",
        label: "Collection affichée dans la vitrine",
        type: "collection",
        aide:
          "« Les plus récentes » montre les dernières affiches créées. Une " +
          "collection montre ses affiches dans l'ordre que vous leur avez " +
          "donné dans Produits › Ordre d'affichage. Le nombre d'affiches ci-dessous " +
          "s'applique dans les deux cas.",
      },
      {
        key: "home.vitrine.count",
        label: "Nombre d'affiches (1 à 24)",
        type: "nombre",
        // Le repli de la boutique : apps/web/src/pages/[...lang]/index.astro.
        min: 1,
        max: 24,
        defaut: 8,
      },
    ],
  },
  {
    titre: "Accueil — l'affiche à partir d'une photo",
    aide:
      "Le bloc qui met en avant l'affiche générée à partir de la photo du " +
      "client. Il ne s'affiche QUE si une image est renseignée.",
    champs: [
      { key: "home.ia.visible", label: "Afficher cette section", type: "switch" },
      { key: "home.ia.image", label: "Image", type: "image" },
      { key: "home.ia.title", label: "Titre", type: "texte" },
      { key: "home.ia.text", label: "Texte", type: "long" },
      { key: "home.ia.cta", label: "Libellé du bouton", type: "texte" },
      { key: "home.ia.link", label: "Lien du bouton", type: "lien" },
    ],
  },
  {
    titre: "Accueil — lettre d'information",
    aide: "Le bloc d'inscription, tout en bas de la page d'accueil.",
    champs: [{ key: "home.newsletter.title", label: "Intitulé", type: "texte" }],
  },
  {
    titre: "Pied de page",
    aide: "",
    champs: [
      { key: "footer.baseline", label: "Baseline", type: "texte" },
      {
        key: "footer.instagram",
        label: "Compte Instagram (https://www.instagram.com/…) — lien du pied de page, et lu par Google",
        type: "lien",
      },
    ],
  },
  {
    titre: "Signature des créations",
    aide:
      "Le logo posé en bas à droite de CHAQUE création — affiches " +
      "personnalisées comme affiches tirées d'une photo —, SEULEMENT sur le " +
      "fichier d'impression : le client ne le voit pas dans le module. Sans " +
      "image ci-dessous, c'est le logo de la boutique qui s'imprime, en noir. " +
      "Changer l'image ou sa taille refait les fichiers d'impression des " +
      "commandes concernées.",
    champs: [
      {
        key: "signature.visible",
        label: "Signer chaque création (en bas à droite)",
        type: "switch",
      },
      {
        key: "signature.image",
        label: "Logo signature",
        type: "image",
        aide:
          "Un PNG à fond transparent, de préférence : un fond blanc se " +
          "verrait comme un rectangle sur l'affiche. Laissez vide : c'est le " +
          "logo de la boutique qui signe.",
      },
      {
        key: "signature.largeur",
        // « Taille », et non plus « Largeur » : la boutique cherchait où
        // régler la TAILLE et ne voyait que « largeur » et « marge » (8/11).
        // C'est bien la taille : la hauteur suit, sans déformer le logo.
        // Minimum 2 au lieu de 4 : elle la trouvait toujours trop grosse.
        label: "Taille de la signature (2 à 25) — plus petit = plus discret",
        type: "nombre",
        min: 2,
        max: 25,
        defaut: 7,
        aide: "7 si vide. C'est la largeur du logo, en % du petit côté de l'affiche ; sa hauteur suit, sans le déformer. À 7, la signature fait environ 5 % de la largeur d'une affiche en portrait ; à 4, à peu près moitié moins.",
      },
      {
        key: "signature.marge",
        label: "Écart avec le coin en bas à droite, en % (0 à 10)",
        type: "nombre",
        min: 0,
        max: 10,
        defaut: 3,
        aide: "3 si vide.",
      },
      {
        key: "signature.opacite",
        label: "Opacité, en % (20 à 100)",
        type: "nombre",
        min: 20,
        max: 100,
        defaut: 100,
        aide: "100 si vide : la signature est pleine.",
      },
    ],
  },
];

/**
 * Un texte se traduit ; une image, un lien, un nombre, un interrupteur, une
 * collection non.
 */
const traduisible = (t: Champ["type"]) => t === "texte" || t === "long";

const champsTraduisibles = SECTIONS.flatMap((s) =>
  s.champs.filter((c) => traduisible(c.type)).map((c) => c.key),
);
const global = avancement(champsTraduisibles);

/**
 * « Affichage des produits » : le nombre d'affiches par ligne, général, puis
 * — facultatif — par genre de page (les clés : @memoryline/types, grille.ts).
 *
 * Une page laissée sur « Comme partout » (valeur vide) suit le réglage
 * général. La partie « selon la page » reste repliée tant qu'aucune page n'a
 * le sien : pour qui ne veut qu'un chiffre, l'écran garde ses deux menus.
 */
const colonnesGenerales =
  valeur(cleColonnes()) || String(COLONNES_ORDINATEUR.defaut);
const colonnesTelephoneGenerales =
  valeur(cleColonnesTelephone()) || String(COLONNES_TELEPHONE.defaut);
const colonnesParPage = PAGES_GRILLE.map(({ page, libelle }) => ({
  page,
  libelle,
  ordinateur: valeur(cleColonnes(page)).trim(),
  telephone: valeur(cleColonnesTelephone(page)).trim(),
}));
const reglagesParPage = colonnesParPage.some((p) => p.ordinateur || p.telephone);
/** Les nombres permis, du plus petit au plus grand. */
const entre = (b: { min: number; max: number }) =>
  Array.from({ length: b.max - b.min + 1 }, (_, i) => b.min + i);
---

<Admin title="Contenu du site">
  {flash && (
    <p
      class={`mb-4 rounded border px-3 py-2 text-sm ${
        flashErreur
          ? "border-red-200 bg-red-50"
          : "border-green-200 bg-green-50"
      }`}
    >
      {flash}
    </p>
  )}
  {erreur && (
    <p class="mb-4 rounded border border-amber-200 bg-amber-50 px-3 py-2 text-sm">
      Réglages illisibles : {erreur}. Les champs ci-dessous sont vides, ne les
      enregistrez pas — vous effaceriez les textes en place.
    </p>
  )}

  <section class="bg-bo-surface border border-bo-border rounded-lg p-5 max-w-3xl">
    <p class="text-sm text-bo-muted mb-4">
      Modifiez les textes du site et choisissez les sections affichées, sans
      toucher au code. Les changements sont visibles immédiatement.
    </p>
    <p class="mb-4 rounded border border-bo-border bg-bo-bg px-3 py-2 text-sm">
      L'encart en tête de l'accueil et les grandes images en haut des pages se
      règlent dans
      <a href={url("/bandeaux-visuels")} class="text-bo-accent hover:underline">Bandeaux visuels</a>.
    </p>

    {/* Les onglets de langue. Ils ne rechargent RIEN : les cinq versions sont
        déjà à l'écran, on ne fait que les montrer. Un onglet qui rechargerait
        perdrait la saisie en cours. */}
    <div class="mb-5 flex flex-wrap items-center gap-2 border-b border-bo-border pb-4">
      {LANGUES.map((l) => (
        <button
          type="button"
          data-langue={l.code}
          data-ml-langue-bouton={l.code}
          class="js-onglet rounded-full border border-bo-border px-3 py-1 text-sm"
        >
          {l.nom}
        </button>
      ))}
      <span class="ml-auto text-xs text-bo-muted">
        {global.faites === global.total
          ? "Toutes les langues sont traduites."
          : `${global.faites} langue${global.faites > 1 ? "s" : ""} traduite${global.faites > 1 ? "s" : ""} sur ${global.total}`}
      </span>
    </div>

    <p class="js-note-langue mb-4 hidden rounded border border-bo-border bg-bo-bg px-3 py-2 text-xs text-bo-muted">
      Le texte français apparaît en filigrane. Une case laissée vide affichera
      le français aux visiteurs de cette langue — jamais du vide.
    </p>

    <form method="POST" class="space-y-6 text-sm">
      {SECTIONS.map((section) => (
        <fieldset class="rounded border border-bo-border p-4">
          <legend class="px-2 font-semibold">{section.titre}</legend>
          {section.aide && (
            <p class="mb-3 text-xs text-bo-muted">{section.aide}</p>
          )}
          <div class="space-y-4">
            {section.champs.map((champ) =>
              champ.type === "switch" ? (
                <label class="flex items-center gap-2">
                  {/* Champ caché : sans lui, une case décochée n'est pas
                      envoyée et le réglage resterait inchangé. */}
                  <input type="hidden" name={champ.key} value="off" />
                  <input
                    type="checkbox"
                    name={champ.key}
                    value="on"
                    checked={estAffichee(champ.key)}
                  />
                  <span>{champ.label}</span>
                  <span class="text-xs text-bo-muted">
                    (vaut pour les 5 langues)
                  </span>
                </label>
              ) : champ.type === "nombre" ? (
                <label class="block">
                  <span class="text-bo-muted">{champ.label}</span>
                  {/* Les bornes et le pré-remplissage viennent du champ, jamais
                      du gabarit : voir le type `Champ` en tête de page. */}
                  <input
                    type="number"
                    min={champ.min}
                    max={champ.max}
                    name={champ.key}
                    value={valeur(champ.key) || String(champ.defaut)}
                    class="mt-1 w-24 border border-bo-border rounded px-3 py-2"
                  />
                </label>
              ) : champ.type === "collection" ? (
                (() => {
                  const choix = choixCollection(champ.key);
                  return (
                    <label class="block">
                      <span class="text-bo-muted">{champ.label}</span>
                      <span class="ml-2 text-xs text-bo-muted">
                        (vaut pour les 5 langues)
                      </span>
                      <select
                        name={champ.key}
                        class="mt-1 block w-full max-w-md rounded border border-bo-border bg-white px-3 py-2"
                      >
                        <option value="" selected={choix.selection === ""}>
                          Les plus récentes
                        </option>
                        {choix.options.map((o) => (
                          <option
                            value={o.slug}
                            selected={o.slug === choix.selection}
                          >
                            {o.libelle}
                          </option>
                        ))}
                      </select>
                      {champ.aide && (
                        <span class="mt-1 block text-xs text-bo-muted">
                          {champ.aide}
                        </span>
                      )}
                      {choix.alerte && (
                        <span class="mt-1 block rounded border border-amber-200 bg-amber-50 px-2 py-1 text-xs">
                          {choix.alerte}
                        </span>
                      )}
                    </label>
                  );
                })()
              ) : champ.type === "image" ? (
                <div class="js-image" data-cle={champ.key}>
                  <span class="text-bo-muted">{champ.label}</span>
                  <span class="ml-2 text-xs text-bo-muted">
                    (vaut pour les 5 langues)
                  </span>
                  <div class="mt-1 flex flex-wrap items-start gap-3">
                    <img
                      class="js-apercu h-24 w-24 rounded border border-bo-border bg-white object-contain"
                      src={valeur(champ.key) ? apiUrl(valeur(champ.key)) : ""}
                      alt=""
                      style={valeur(champ.key) ? "" : "visibility:hidden"}
                    />
                    <div class="flex-1 min-w-[240px]">
                      <input
                        type="file"
                        accept="image/*"
                        class="js-fichier block w-full text-xs"
                      />
                      <input
                        type="text"
                        name={champ.key}
                        value={valeur(champ.key)}
                        placeholder="/assets/…"
                        class="js-url mt-2 w-full rounded border border-bo-border px-3 py-2 font-mono text-xs"
                      />
                      <p class="js-etat mt-1 text-xs text-bo-muted">
                        Choisissez un fichier : il est envoyé tout de suite, et
                        l'adresse se remplit seule. Enregistrez ensuite pour le
                        publier.
                      </p>
                      {champ.aide && (
                        <p class="mt-1 text-xs text-bo-muted">{champ.aide}</p>
                      )}
                    </div>
                  </div>
                </div>
              ) : champ.type === "video" ? (
                /* Jumeau du bloc des images, à trois différences près : pas
                   d'aperçu <img>, un verdict calculé au rendu, et le MÊME
                   champ texte pour un lien collé et pour un fichier envoyé —
                   les deux aboutissent à une adresse, il n'y a donc qu'une
                   clé à tenir. */
                <div class="js-video" data-cle={champ.key}>
                  <span class="text-bo-muted">{champ.label}</span>
                  <span class="ml-2 text-xs text-bo-muted">
                    (vaut pour les 5 langues)
                  </span>
                  <div class="mt-1">
                    <input
                      type="file"
                      accept="video/mp4,video/webm"
                      class="js-fichier block w-full text-xs"
                    />
                    <input
                      type="text"
                      name={champ.key}
                      value={valeur(champ.key)}
                      placeholder="https://youtu.be/… ou /assets/…"
                      class="js-url mt-2 w-full rounded border border-bo-border px-3 py-2 font-mono text-xs"
                    />
                    <p class="js-etat mt-1 text-xs text-bo-muted">
                      Choisissez un fichier : il est envoyé tout de suite, et
                      l'adresse se remplit seule. Enregistrez ensuite pour le
                      publier.
                    </p>
                    {(() => {
                      const v = verdictVideo(champ.key);
                      return (
                        <p
                          class={
                            v.alerte
                              ? "mt-1 rounded border border-amber-200 bg-amber-50 px-2 py-1 text-xs"
                              : "mt-1 text-xs text-bo-muted"
                          }
                        >
                          {v.texte}
                        </p>
                      );
                    })()}
                    <p class="mt-1 text-xs text-bo-muted">
                      Le verdict se met à jour après Enregistrer.
                    </p>
                    {champ.aide && (
                      <p class="mt-1 text-xs text-bo-muted">{champ.aide}</p>
                    )}
                  </div>
                </div>
              ) : champ.type === "lien" ? (
                <label class="block">
                  <span class="text-bo-muted">{champ.label}</span>
                  <span class="ml-2 text-xs text-bo-muted">
                    (vaut pour les 5 langues)
                  </span>
                  <input
                    type="text"
                    name={champ.key}
                    value={valeur(champ.key)}
                    placeholder="/affiches ou https://…"
                    class="mt-1 w-full rounded border border-bo-border px-3 py-2 font-mono text-xs"
                  />
                  <span class="mt-1 block text-xs text-bo-muted">
                    Une adresse interne (« /affiches ») reçoit d'elle-même le
                    préfixe de la langue du visiteur.
                  </span>
                </label>
              ) : (
                <div class="block">
                  <span class="text-bo-muted">{champ.label}</span>
                  {(() => {
                    const a = avancement([champ.key]);
                    return (
                      <span class="ml-2 text-xs text-bo-muted">
                        {a.faites}/{a.total} traduit{a.faites > 1 ? "s" : ""}
                      </span>
                    );
                  })()}
                  {champ.aide && (
                    <span class="mt-1 block text-xs text-bo-muted">
                      {champ.aide}
                    </span>
                  )}
                  {LANGUES.map((l) => (
                    <textarea
                      name={`${champ.key}@${l.code}`}
                      data-langue={l.code}
                      rows={champ.type === "long" ? 3 : 1}
                      placeholder={
                        l.code === "fr" ? "" : valeur(champ.key, "fr")
                      }
                      class="js-champ-langue mt-1 w-full rounded border border-bo-border px-3 py-2"
                    >{valeur(champ.key, l.code)}</textarea>
                  ))}
                </div>
              ),
            )}
          </div>
        </fieldset>
      ))}
      {/* Le nombre d'affiches par ligne, pour TOUTES les grilles du site :
          catalogue, rayons et collections, accueil, recherche, pages. Un
          réglage général, puis, replié, un réglage par genre de page ; la
          tablette en découle (lib/grille.ts du site). */}
      <fieldset class="rounded border border-bo-border p-4">
        <legend class="px-2 font-semibold">Affichage des produits</legend>
        <p class="mb-3 text-xs text-bo-muted">
          Le nombre d'affiches par ligne, sur toutes les pages du site. Sur
          tablette, c'est une de moins que sur ordinateur (trois au plus).
        </p>
        <div class="flex flex-wrap gap-6">
          <label class="block">
            <span class="mb-1 block font-medium">Sur ordinateur</span>
            <select
              name={cleColonnes()}
              class="rounded border border-bo-border px-3 py-2"
            >
              {entre(COLONNES_ORDINATEUR).map((n) => (
                <option
                  value={String(n)}
                  selected={colonnesGenerales === String(n)}
                >
                  {n} par ligne
                </option>
              ))}
            </select>
          </label>
          <label class="block">
            <span class="mb-1 block font-medium">Sur téléphone</span>
            <select
              name={cleColonnesTelephone()}
              class="rounded border border-bo-border px-3 py-2"
            >
              {entre(COLONNES_TELEPHONE).map((n) => (
                <option
                  value={String(n)}
                  selected={colonnesTelephoneGenerales === String(n)}
                >
                  {n} par ligne
                </option>
              ))}
            </select>
          </label>
        </div>

        {/* Un nombre différent selon la page — l'accueil à 4, la boutique à
            3… Replié tant qu'aucune page n'a le sien. Chaque menu commence
            par « Comme partout » (valeur vide) : la page suit alors le
            réglage général ci-dessus, et le suivra s'il change. */}
        <details class="mt-4 rounded border border-bo-border" open={reglagesParPage}>
          <summary class="cursor-pointer px-3 py-2 font-medium">
            Un nombre différent selon la page (facultatif)
          </summary>
          <div class="space-y-3 border-t border-bo-border px-3 py-3">
            <p class="text-xs text-bo-muted">
              Laissez « Comme partout » pour qu'une page suive le réglage
              ci-dessus. Choisissez un nombre pour qu'elle s'en écarte.
            </p>
            {colonnesParPage.map((p) => (
              <div class="flex flex-wrap items-end gap-x-4 gap-y-2 border-t border-bo-border pt-3 first-of-type:border-t-0 first-of-type:pt-0">
                <span class="w-full font-medium">{p.libelle}</span>
                <label class="block">
                  <span class="mb-1 block text-xs text-bo-muted">Sur ordinateur</span>
                  <select
                    name={cleColonnes(p.page)}
                    class="rounded border border-bo-border px-3 py-2"
                  >
                    <option value="" selected={!p.ordinateur}>
                      Comme partout ({colonnesGenerales} par ligne)
                    </option>
                    {entre(COLONNES_ORDINATEUR).map((n) => (
                      <option value={String(n)} selected={p.ordinateur === String(n)}>
                        {n} par ligne
                      </option>
                    ))}
                  </select>
                </label>
                <label class="block">
                  <span class="mb-1 block text-xs text-bo-muted">Sur téléphone</span>
                  <select
                    name={cleColonnesTelephone(p.page)}
                    class="rounded border border-bo-border px-3 py-2"
                  >
                    <option value="" selected={!p.telephone}>
                      Comme partout ({colonnesTelephoneGenerales} par ligne)
                    </option>
                    {entre(COLONNES_TELEPHONE).map((n) => (
                      <option value={String(n)} selected={p.telephone === String(n)}>
                        {n} par ligne
                      </option>
                    ))}
                  </select>
                </label>
              </div>
            ))}
          </div>
        </details>
      </fieldset>

      <button class="rounded bg-bo-accent text-white px-4 py-2 hover:opacity-90">
        Enregistrer
      </button>
    </form>
  </section>

  <script is:inline define:vars={{ API: apiUrl("") }}>
    (function () {
      /* --- Les onglets de langue ------------------------------------- */
      const onglets = document.querySelectorAll(".js-onglet");
      const champs = document.querySelectorAll(".js-champ-langue");
      const note = document.querySelector(".js-note-langue");

      function montrer(code) {
        champs.forEach((c) => {
          c.hidden = c.dataset.langue !== code;
        });
        onglets.forEach((o) => {
          const actif = o.dataset.langue === code;
          o.style.background = actif ? "#4f46e5" : "";
          o.style.color = actif ? "#fff" : "";
          o.style.borderColor = actif ? "#4f46e5" : "";
          o.setAttribute("aria-pressed", actif ? "true" : "false");
        });
        if (note) note.hidden = code === "fr";
      }
      onglets.forEach((o) =>
        o.addEventListener("click", () => montrer(o.dataset.langue)),
      );
      montrer("fr");

      /* --- Le téléversement des images -------------------------------- */
      document.querySelectorAll(".js-image").forEach((bloc) => {
        const fichier = bloc.querySelector(".js-fichier");
        const url = bloc.querySelector(".js-url");
        const apercu = bloc.querySelector(".js-apercu");
        const etat = bloc.querySelector(".js-etat");
        if (!fichier) return;

        fichier.addEventListener("change", async () => {
          const f = fichier.files && fichier.files[0];
          if (!f) return;
          etat.textContent = "Envoi en cours…";
          try {
            const corps = new FormData();
            corps.append("file", f);
            // Pas d'en-tête Content-Type posée à la main : le navigateur doit
            // écrire lui-même la frontière du multipart. `credentials` porte
            // le cookie d'administration, sans quoi l'API refuse.
            const res = await fetch(API + "/admin/uploads", {
              method: "POST",
              credentials: "include",
              body: corps,
            });
            if (!res.ok) throw new Error("HTTP " + res.status);
            const data = await res.json();
            url.value = data.url;
            apercu.src = API + data.url;
            apercu.style.visibility = "visible";
            etat.textContent =
              "Image envoyée. Enregistrez pour la publier sur le site.";
          } catch (e) {
            etat.textContent = "Envoi impossible : " + e.message;
          }
        });
      });

      /* --- Le téléversement des vidéos -------------------------------- */
      document.querySelectorAll(".js-video").forEach((bloc) => {
        const fichier = bloc.querySelector(".js-fichier");
        const url = bloc.querySelector(".js-url");
        const etat = bloc.querySelector(".js-etat");
        if (!fichier) return;

        fichier.addEventListener("change", async () => {
          const f = fichier.files && fichier.files[0];
          if (!f) return;
          etat.textContent = "Envoi en cours… (une vidéo peut prendre une minute)";
          try {
            const corps = new FormData();
            corps.append("file", f);
            // Mêmes règles absolues que pour une image : pas d'en-tête
            // Content-Type posée à la main (le navigateur doit écrire
            // lui-même la frontière du multipart), et `credentials` pour
            // porter le cookie d'administration, sans quoi l'API refuse.
            const res = await fetch(API + "/admin/uploads", {
              method: "POST",
              credentials: "include",
              body: corps,
            });
            if (res.status === 413)
              throw new Error("Fichier trop lourd (120 Mo maximum)");
            if (res.status === 415)
              throw new Error("Format refusé : .mp4 ou .webm");
            if (!res.ok) throw new Error("HTTP " + res.status);
            const data = await res.json();
            url.value = data.url;
            etat.textContent = "Vidéo envoyée. Enregistrez pour la publier.";
          } catch (e) {
            etat.textContent = "Envoi impossible : " + e.message;
          }
        });
      });
    })();
  </script>
</Admin>
