---
import Admin from "../layouts/Admin.astro";
import { adminApi, type PromoRule } from "../lib/api.ts";

const api = adminApi(Astro.request);

// --- Traitement des formulaires (SSR) ----------------------------------
let flash: string | null = null;
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const action = form.get("_action");
  try {
    if (action === "toggle") {
      const id = Number(form.get("id"));
      await fetch(
        `${import.meta.env.API_URL_INTERNAL ?? import.meta.env.PUBLIC_API_URL ?? "http://localhost:3000"}/admin/promos/${id}/toggle`,
        {
          method: "POST",
          headers: { cookie: Astro.request.headers.get("cookie") ?? "" },
        },
      );
      flash = "Promotion mise à jour.";
    } else {
      const type = String(form.get("type"));
      // Construit `config` selon le type choisi.
      let config: Record<string, unknown> = {};
      if (type === "buy_x_get_y")
        config = {
          buyQty: Number(form.get("buyQty") || 3),
          getQty: Number(form.get("getQty") || 1),
          format: String(form.get("format") || "A4"),
        };
      else if (type === "percent")
        config = { percent: Number(form.get("percent") || 10) };
      else if (type === "fixed")
        config = { amountCents: Math.round(Number(form.get("amount") || 5) * 100) };
      else if (type === "free_shipping_over")
        config = {
          thresholdCents: Math.round(Number(form.get("threshold") || 50) * 100),
        };

      await api.upsertPromo({
        id: form.get("id") ? Number(form.get("id")) : undefined,
        name: String(form.get("name") || "Promotion"),
        type,
        config,
        code: (form.get("code") as string) || null,
        priority: Number(form.get("priority") || 0),
        active: form.get("active") === "on",
        startsAt: (form.get("startsAt") as string) || null,
        endsAt: (form.get("endsAt") as string) || null,
      });
      flash = "Promotion enregistrée.";
    }
  } catch (e) {
    flash = "Erreur : " + String(e);
  }
}

let promos: PromoRule[] = [];
try {
  promos = await api.promos();
} catch {}

const TYPES = [
  { value: "buy_x_get_y", label: "X achetées = Y offerte(s)" },
  { value: "percent", label: "Pourcentage de remise" },
  { value: "fixed", label: "Montant fixe de remise" },
  { value: "free_shipping_over", label: "Livraison offerte dès X €" },
];

function describe(p: PromoRule): string {
  const c = p.config as Record<string, number | string>;
  switch (p.type) {
    case "buy_x_get_y":
      return `${c.buyQty} achetée(s) = ${c.getQty} ${c.format} offerte(s)`;
    case "percent":
      return `-${c.percent}%`;
    case "fixed":
      return `-${Number(c.amountCents) / 100} €`;
    case "free_shipping_over":
      return `Livraison offerte dès ${Number(c.thresholdCents) / 100} €`;
    default:
      return p.type;
  }
}
---

<Admin title="Promotions">
  {flash && <p class="mb-4 text-sm rounded bg-green-50 border border-green-200 px-3 py-2">{flash}</p>}

  <section class="bg-bo-surface border border-bo-border rounded-lg overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-bo-bg text-bo-muted text-left">
        <tr>
          <th class="px-4 py-2 font-medium">Nom</th>
          <th class="px-4 py-2 font-medium">Effet</th>
          <th class="px-4 py-2 font-medium">Code</th>
          <th class="px-4 py-2 font-medium">Statut</th>
          <th class="px-4 py-2"></th>
        </tr>
      </thead>
      <tbody>
        {
          promos.map((p) => (
            <tr class="border-t border-bo-border">
              <td class="px-4 py-2 font-medium">{p.name}</td>
              <td class="px-4 py-2">{describe(p)}</td>
              <td class="px-4 py-2">{p.code ?? <span class="text-bo-muted">auto</span>}</td>
              <td class="px-4 py-2">
                {p.active ? (
                  <span class="text-green-700">● Active</span>
                ) : (
                  <span class="text-bo-muted">○ Inactive</span>
                )}
              </td>
              <td class="px-4 py-2 text-right">
                <form method="POST" class="inline">
                  <input type="hidden" name="_action" value="toggle" />
                  <input type="hidden" name="id" value={p.id} />
                  <button class="text-bo-accent hover:underline">
                    {p.active ? "Désactiver" : "Activer"}
                  </button>
                </form>
              </td>
            </tr>
          ))
        }
        {promos.length === 0 && (
          <tr><td colspan="5" class="px-4 py-6 text-center text-bo-muted">Aucune promotion.</td></tr>
        )}
      </tbody>
    </table>
  </section>

  <section class="mt-6 bg-bo-surface border border-bo-border rounded-lg p-5">
    <h2 class="font-semibold mb-4">Nouvelle promotion</h2>
    <form method="POST" class="grid sm:grid-cols-2 gap-4 text-sm">
      <label class="block">
        <span class="text-bo-muted">Nom</span>
        <input name="name" required class="mt-1 w-full border border-bo-border rounded px-3 py-2" placeholder="Offre du moment" />
      </label>
      <label class="block">
        <span class="text-bo-muted">Type de règle</span>
        <select name="type" id="promo-type" class="mt-1 w-full border border-bo-border rounded px-3 py-2">
          {TYPES.map((t) => <option value={t.value}>{t.label}</option>)}
        </select>
      </label>

      <fieldset data-type="buy_x_get_y" class="grid grid-cols-3 gap-2 sm:col-span-2">
        <label class="block"><span class="text-bo-muted">Quantité achetée</span><input name="buyQty" type="number" value="3" class="mt-1 w-full border border-bo-border rounded px-3 py-2" /></label>
        <label class="block"><span class="text-bo-muted">Quantité offerte</span><input name="getQty" type="number" value="1" class="mt-1 w-full border border-bo-border rounded px-3 py-2" /></label>
        <label class="block"><span class="text-bo-muted">Format offert</span><select name="format" class="mt-1 w-full border border-bo-border rounded px-3 py-2"><option>A4</option><option>A3</option></select></label>
      </fieldset>
      <fieldset data-type="percent" hidden class="sm:col-span-2">
        <label class="block"><span class="text-bo-muted">Pourcentage (%)</span><input name="percent" type="number" value="10" class="mt-1 w-full border border-bo-border rounded px-3 py-2" /></label>
      </fieldset>
      <fieldset data-type="fixed" hidden class="sm:col-span-2">
        <label class="block"><span class="text-bo-muted">Montant remisé (€)</span><input name="amount" type="number" step="0.01" value="5" class="mt-1 w-full border border-bo-border rounded px-3 py-2" /></label>
      </fieldset>
      <fieldset data-type="free_shipping_over" hidden class="sm:col-span-2">
        <label class="block"><span class="text-bo-muted">Seuil (€)</span><input name="threshold" type="number" step="0.01" value="50" class="mt-1 w-full border border-bo-border rounded px-3 py-2" /></label>
      </fieldset>

      <label class="block">
        <span class="text-bo-muted">Code (vide = automatique)</span>
        <input name="code" class="mt-1 w-full border border-bo-border rounded px-3 py-2" placeholder="auto" />
      </label>
      <label class="block">
        <span class="text-bo-muted">Priorité</span>
        <input name="priority" type="number" value="0" class="mt-1 w-full border border-bo-border rounded px-3 py-2" />
      </label>
      <label class="flex items-center gap-2 sm:col-span-2">
        <input name="active" type="checkbox" checked /> <span>Active</span>
      </label>
      <div class="sm:col-span-2">
        <button class="rounded bg-bo-accent text-white px-4 py-2 hover:opacity-90">Enregistrer</button>
      </div>
    </form>
  </section>

  <script is:inline>
    // Affiche les champs propres au type de règle sélectionné.
    const sel = document.getElementById("promo-type");
    function sync() {
      document.querySelectorAll("fieldset[data-type]").forEach((fs) => {
        fs.hidden = fs.getAttribute("data-type") !== sel.value;
      });
    }
    sel?.addEventListener("change", sync);
    sync();
  </script>
</Admin>
