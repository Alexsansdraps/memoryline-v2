---
import { apiInterne } from "../lib/api-interne.ts";
import Admin from "../layouts/Admin.astro";
import { adminApi, type PromoRule } from "../lib/api.ts";
import { url } from "../lib/url.ts";
import { libelleRegle } from "@memoryline/types";
import TraductionsNoms from "../components/TraductionsNoms.astro";
import { traiterTraductionsNoms } from "../lib/traductions-noms.ts";
import type { EtatTraductions } from "../lib/traductions.ts";

const api = adminApi(Astro.request);

// --- Traitement des formulaires (SSR) ----------------------------------
let flash: string | null = null;
let flashErreur = false;
/**
 * Traductions des noms : propositions automatiques à relire, saisie à
 * réafficher (après une proposition ou un refus), et bloc ouvert.
 */
let tradPromos: EtatTraductions | null = null;
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const action = form.get("_action");
  try {
    // Avant tout le reste : le dernier cas de cette chaîne enregistre une
    // promotion, et un formulaire de traductions qui y tomberait en
    // créerait une nouvelle.
    if (action === "promos-traductions" || action === "promos-traduire") {
      tradPromos = await traiterTraductionsNoms(
        action === "promos-traductions" ? "enregistrer" : "proposer",
        form,
        await api.promos(),
        (id, l, nom) => api.setPromoTranslation(id, { lang: l, name: nom }),
        (l, champs) => api.proposerTraduction(l, champs),
      );
      flash = tradPromos.message;
      flashErreur = tradPromos.erreur;
    } else if (action === "toggle") {
      const id = Number(form.get("id"));
      await fetch(
        `${apiInterne()}/admin/promos/${id}/toggle`,
        {
          method: "POST",
          headers: { cookie: Astro.request.headers.get("cookie") ?? "" },
        },
      );
      flash = "Promotion mise à jour.";
    } else {
      const type = String(form.get("type"));
      // Construit `config` selon le type choisi.
      let config: Record<string, unknown> = {};
      if (type === "buy_x_get_y")
        config = {
          buyQty: Number(form.get("buyQty") || 3),
          getQty: Number(form.get("getQty") || 1),
          // 100 = offerte, c'est le cas courant ; en dessous, la suivante est
          // simplement remisee (« la 2e a moitie prix »).
          percent: Number(form.get("remiseOffertes") ?? 100),
          // Vide = tous les formats.
          format: String(form.get("format") || "") || undefined,
        };
      else if (type === "percent")
        config = { percent: Number(form.get("percent") || 10) };
      else if (type === "fixed")
        config = { amountCents: Math.round(Number(form.get("amount") || 5) * 100) };
      else if (type === "free_shipping_over")
        // Le seuil se compare au panier APRÈS remises : c'est le montant que
        // la cliente paie vraiment pour ses affiches.
        config = {
          thresholdCents: Math.round(Number(form.get("seuil") || 60) * 100),
        };

      await api.upsertPromo({
        id: form.get("id") ? Number(form.get("id")) : undefined,
        name: String(form.get("name") || "Promotion"),
        type,
        config,
        code: (form.get("code") as string) || null,
        priority: Number(form.get("priority") || 0),
        active: form.get("active") === "on",
        startsAt: (form.get("startsAt") as string) || null,
        endsAt: (form.get("endsAt") as string) || null,
      });
      flash = "Promotion enregistrée.";
    }
  } catch (e) {
    flash = "Erreur : " + String(e);
    flashErreur = true;
  }
}

let promos: PromoRule[] = [];
try {
  promos = await api.promos();
} catch {}

const TYPES = [
  { value: "buy_x_get_y", label: "X achetées, la suivante remisée" },
  { value: "percent", label: "Pourcentage de remise" },
  { value: "fixed", label: "Montant fixe de remise" },
  { value: "free_shipping_over", label: "Livraison offerte à partir d'un montant" },
];

// La phrase vient du moteur qui facture, pas d'une copie tenue a la main :
// deux textes finissent toujours par ne plus dire la meme chose.
const describe = libelleRegle;
---

<Admin title="Promotions">
  {flash && (
    <p
      class={`mb-4 text-sm rounded border px-3 py-2 ${
        flashErreur ? "bg-red-50 border-red-200" : "bg-green-50 border-green-200"
      }`}
    >
      {flash}
    </p>
  )}

  <p class="mb-4 max-w-3xl text-sm text-bo-muted">
    Une promotion sans code s'applique à tout le monde, silencieusement. Pour
    qu'elle soit annoncée en haut du site en même temps qu'elle s'applique,
    elle se règle depuis <a href={url("/bandeau")} class="underline">le bandeau</a>.
    La livraison offerte au-delà d'un montant, elle, ne se règle pas ici mais
    dans <a href={url("/livraison")} class="underline">Livraison</a>, par mode
    d'envoi : c'est le transporteur qu'on cesse de facturer.
  </p>

  <section class="bg-bo-surface border border-bo-border rounded-lg overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-bo-bg text-bo-muted text-left">
        <tr>
          <th class="px-4 py-2 font-medium">Nom</th>
          <th class="px-4 py-2 font-medium">Effet</th>
          <th class="px-4 py-2 font-medium">Code</th>
          <th class="px-4 py-2 font-medium">Statut</th>
          <th class="px-4 py-2"></th>
        </tr>
      </thead>
      <tbody>
        {
          promos.map((p) => (
            <tr class="border-t border-bo-border">
              <td class="px-4 py-2 font-medium">{p.name}</td>
              <td class="px-4 py-2">{describe(p)}</td>
              <td class="px-4 py-2">{p.code ?? <span class="text-bo-muted">auto</span>}</td>
              <td class="px-4 py-2">
                {p.active ? (
                  <span class="text-green-700">● Active</span>
                ) : (
                  <span class="text-bo-muted">○ Inactive</span>
                )}
              </td>
              <td class="px-4 py-2 text-right">
                <form method="POST" class="inline">
                  <input type="hidden" name="_action" value="toggle" />
                  <input type="hidden" name="id" value={p.id} />
                  <button class="text-bo-accent hover:underline">
                    {p.active ? "Désactiver" : "Activer"}
                  </button>
                </form>
              </td>
            </tr>
          ))
        }
        {promos.length === 0 && (
          <tr><td colspan="5" class="px-4 py-6 text-center text-bo-muted">Aucune promotion.</td></tr>
        )}
      </tbody>
    </table>
  </section>

  {/* Le nom d'une promotion s'écrit sur la ligne de remise du panier : un
      client anglais doit l'y lire en anglais. Le code, lui, ne se traduit
      jamais — c'est ce que le client tape. */}
  {promos.length > 0 && (
    <TraductionsNoms
      titre="Traductions des noms de promotions"
      aide="Le nom de chaque promotion, tel que le client le lit sur la ligne de remise de son panier. Une case vide affiche le nom français. Le code à saisir, lui, reste le même dans toutes les langues."
      elements={promos}
      propositions={tradPromos?.propositions}
      saisies={tradPromos?.saisies}
      actionEnregistrer="promos-traductions"
      actionProposer="promos-traduire"
      ouvert={!!tradPromos}
      classe="mt-6 bg-bo-surface"
    />
  )}

  <section class="mt-6 bg-bo-surface border border-bo-border rounded-lg p-5">
    <h2 class="font-semibold mb-4">Nouvelle promotion</h2>
    <form method="POST" class="grid sm:grid-cols-2 gap-4 text-sm">
      <label class="block">
        <span class="text-bo-muted">Nom</span>
        <input name="name" required class="mt-1 w-full border border-bo-border rounded px-3 py-2" placeholder="Offre du moment" />
      </label>
      <label class="block">
        <span class="text-bo-muted">Type de règle</span>
        <select name="type" id="promo-type" class="mt-1 w-full border border-bo-border rounded px-3 py-2">
          {TYPES.map((t) => <option value={t.value}>{t.label}</option>)}
        </select>
      </label>

      <fieldset data-type="buy_x_get_y" class="grid grid-cols-2 gap-2 sm:col-span-2">
        <label class="block"><span class="text-bo-muted">Affiches à payer</span><input name="buyQty" type="number" min="1" value="3" class="mt-1 w-full border border-bo-border rounded px-3 py-2" /></label>
        <label class="block"><span class="text-bo-muted">Affiches remisées ensuite</span><input name="getQty" type="number" min="1" value="1" class="mt-1 w-full border border-bo-border rounded px-3 py-2" /></label>
        <label class="block"><span class="text-bo-muted">Remise sur celles-ci (%)</span><input name="remiseOffertes" type="number" min="0" max="100" value="100" class="mt-1 w-full border border-bo-border rounded px-3 py-2" /><span class="mt-1 block text-xs text-bo-muted">100 = offerte. 50 = à moitié prix.</span></label>
        <label class="block"><span class="text-bo-muted">Format concerné</span><select name="format" class="mt-1 w-full border border-bo-border rounded px-3 py-2"><option value="">Tous les formats</option><option value="A4">A4 seulement</option><option value="A3">A3 seulement</option></select></label>
        <p class="text-xs text-bo-muted sm:col-span-2">Il faut les deux dans le panier : 3 payées et 1 remisée, c'est un panier de 4 affiches.</p>
      </fieldset>
      <fieldset data-type="percent" hidden class="sm:col-span-2">
        <label class="block"><span class="text-bo-muted">Pourcentage (%)</span><input name="percent" type="number" value="10" class="mt-1 w-full border border-bo-border rounded px-3 py-2" /></label>
      </fieldset>
      <fieldset data-type="fixed" hidden class="sm:col-span-2">
        <label class="block"><span class="text-bo-muted">Montant remisé (€)</span><input name="amount" type="number" step="0.01" value="5" class="mt-1 w-full border border-bo-border rounded px-3 py-2" /></label>
      </fieldset>
      <fieldset data-type="free_shipping_over" hidden class="sm:col-span-2">
        <label class="block">
          <span class="text-bo-muted">Livraison offerte à partir de (€)</span>
          <input
            name="seuil"
            type="number"
            step="0.01"
            min="0"
            value="60"
            class="mt-1 w-full border border-bo-border rounded px-3 py-2"
          />
          <span class="mt-1 block text-xs text-bo-muted">
            Le montant est celui du panier APRÈS remises — ce que la cliente
            paie vraiment pour ses affiches. L'offre vaut pour tous les modes
            de livraison et toutes les zones. Pour n'offrir le port que sur un
            transporteur précis, utilisez plutôt la franchise de sa grille
            tarifaire, dans l'écran Livraison : les deux se cumulent, le port
            est offert dès que l'un des deux seuils est atteint.
          </span>
        </label>
      </fieldset>

      <label class="block">
        <span class="text-bo-muted">Code (vide = automatique)</span>
        <input name="code" class="mt-1 w-full border border-bo-border rounded px-3 py-2" placeholder="auto" />
      </label>
      <label class="block">
        <span class="text-bo-muted">Priorité</span>
        <input name="priority" type="number" value="0" class="mt-1 w-full border border-bo-border rounded px-3 py-2" />
      </label>
      <label class="flex items-center gap-2 sm:col-span-2">
        <input name="active" type="checkbox" checked /> <span>Active</span>
      </label>
      <div class="sm:col-span-2">
        <button class="rounded bg-bo-accent text-white px-4 py-2 hover:opacity-90">Enregistrer</button>
      </div>
    </form>
  </section>

  <script is:inline>
    // Affiche les champs propres au type de règle sélectionné.
    const sel = document.getElementById("promo-type");
    function sync() {
      document.querySelectorAll("fieldset[data-type]").forEach((fs) => {
        fs.hidden = fs.getAttribute("data-type") !== sel.value;
      });
    }
    sel?.addEventListener("change", sync);
    sync();
  </script>
</Admin>
