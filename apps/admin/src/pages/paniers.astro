---
/**
 * Paniers abandonnés : les commandes engagées mais jamais payées, et la
 * relance qui va les chercher.
 *
 * Deux horloges cohabitent ici, et l'écran doit les distinguer sans détour.
 * Celle de L'AFFICHAGE, réglée en minutes : passé ce délai sans activité, le
 * panier apparaît dans la liste. Celle de L'ENVOI, réglée en heures : c'est
 * seulement à ce terme qu'un courrier part. Un panier peut donc rester
 * plusieurs heures sous les yeux sans qu'on ait écrit à personne, et c'est
 * voulu — la marchande voit ce qui se passe avant que la machine n'agisse.
 *
 * Et une limite qui ne se règle pas : passé quatorze jours, plus aucun envoi.
 * Ces paniers-là restent visibles, avec la raison écrite en toutes lettres.
 */
import Admin from "../layouts/Admin.astro";
import { url } from "../lib/url.ts";
import {
  adminApi,
  formatPrice,
  type EcranCourrielsRelance,
  type EcranPaniers,
  type PanierAbandonne,
  type ReglagesRelance,
} from "../lib/api.ts";

const api = adminApi(Astro.request);

let flash: string | null = null;
let flashErreur = false;
/**
 * Les réglages tels que la boutique vient de les saisir, quand l'API les a
 * refusés (une 2e relance programmée avant la 1re…). On les remet dans le
 * formulaire : lui faire tout ressaisir pour une seule valeur à corriger
 * serait la punir de s'être trompée.
 */
let reglagesSaisis: ReglagesRelance | null = null;

/** « 10 h », « 2 jours » — un délai tel qu'on le dit. */
function duree(heures: number): string {
  if (heures < 24 || heures % 24 !== 0) return `${heures} h`;
  const jours = heures / 24;
  return jours === 1 ? "1 jour" : `${jours} jours`;
}

/** Une liste lue à voix haute : « a », « a et b », « a, b et c ». */
function enumeration(morceaux: string[]): string {
  if (morceaux.length <= 1) return morceaux[0] ?? "";
  return `${morceaux.slice(0, -1).join(", ")} et ${morceaux[morceaux.length - 1]}`;
}

if (Astro.request.method === "POST") {
  const f = await Astro.request.formData();
  const action = String(f.get("action") ?? "relancer");
  try {
    if (action === "reglages") {
      // Un champ vide veut dire « pas de 2e (ou 3e) relance » : c'est la
      // première option de la liste.
      const r2 = String(f.get("relance2Heures") ?? "");
      const r3 = String(f.get("relance3Heures") ?? "");
      const saisie: ReglagesRelance = {
        active: f.get("active") === "on",
        palierHeures: Number(f.get("palierHeures")),
        plancherMinutes: Number(f.get("plancherMinutes")),
        baseLegale:
          String(f.get("baseLegale")) === "interet_legitime"
            ? "interet_legitime"
            : "consentement",
        relance2Heures: r2 ? Number(r2) : null,
        relance3Heures: r3 ? Number(r3) : null,
        plage:
          f.get("plageActive") === "on"
            ? { debut: Number(f.get("plageDebut")), fin: Number(f.get("plageFin")) }
            : null,
      };
      reglagesSaisis = saisie;
      const { reglages: r } = await api.reglagesRelance(saisie);
      reglagesSaisis = null;
      // La phrase redit le programme en entier : c'est la meilleure façon de
      // vérifier qu'on a réglé ce qu'on croyait régler.
      const quand = [
        `la 1re ${duree(r.palierHeures)} après le dernier geste du client`,
        ...(r.relance2Heures !== null ? [`la 2e ${duree(r.relance2Heures)} après`] : []),
        ...(r.relance3Heures !== null ? [`la 3e ${duree(r.relance3Heures)} après`] : []),
      ];
      const plage = r.plage
        ? `, seulement entre ${r.plage.debut} h et ${r.plage.fin} h (heure de Paris)`
        : "";
      flash = r.active
        ? `Réglages enregistrés. Les relances partent toutes seules : ${enumeration(quand)}${plage}.`
        : "Réglages enregistrés. La relance automatique est désactivée : seul le bouton « Relancer » envoie un courrier.";
    } else if (action === "essai") {
      // Le courriel tel qu'il partira, envoyé à l'adresse du compte connecté
      // (dans la boîte d'essai sur le site de test) : on le lit comme une
      // cliente avant de laisser partir les relances.
      const r = await api.essaiCourrielRelance(Number(f.get("etape")) || 1);
      flash = r.resume;
      flashErreur = !r.parti;
    } else if (action === "passage") {
      const { bilan } = await api.passageRelance();
      // Un passage qui ne fait rien doit dire pourquoi : « 0 panier examiné »
      // tout seul se lit comme une panne, alors que c'est un réglage.
      flash =
        bilan.envoyes > 0
          ? `${bilan.envoyes} relance${bilan.envoyes > 1 ? "s sont parties" : " est partie"}, ${bilan.renonces} panier${bilan.renonces > 1 ? "s écartés" : " écarté"} sur ${bilan.examines} examiné${bilan.examines > 1 ? "s" : ""}.`
          : (bilan.motif ??
            `Aucun courrier n'est parti. ${bilan.examines} panier${bilan.examines > 1 ? "s examinés" : " examiné"}, ${bilan.renonces} écarté${bilan.renonces > 1 ? "s" : ""} par les garde-fous.`);
    } else {
      await api.relancerPanier(Number(f.get("id")));
      flash = "Relance envoyée.";
    }
  } catch (e) {
    flash = e instanceof Error ? e.message : String(e);
    flashErreur = true;
  }
}

/**
 * Le délai d'affichage peut se regarder autrement que réglé, le temps d'un
 * coup d'œil. Absent de l'adresse, c'est le réglage de la boutique qui parle.
 */
const plancherDemande = Astro.url.searchParams.get("plancher");

let ecran: EcranPaniers | null = null;
let erreur: string | null = null;
/**
 * Les courriels des trois relances, en français : leur objet s'affiche dans
 * la carte « Le courriel envoyé », pour qu'on sache ce qui part sans ouvrir
 * l'écran de réécriture. Une panne ici n'empêche pas la liste de s'afficher.
 */
let courrielsFr: EcranCourrielsRelance | null = null;
const [lecturePaniers, lectureCourriels] = await Promise.allSettled([
  api.abandonedCarts(plancherDemande ? Number(plancherDemande) : undefined),
  api.courrielsRelance("fr"),
]);
if (lecturePaniers.status === "fulfilled") ecran = lecturePaniers.value;
else
  erreur =
    lecturePaniers.reason instanceof Error
      ? lecturePaniers.reason.message
      : String(lecturePaniers.reason);
if (lectureCourriels.status === "fulfilled") courrielsFr = lectureCourriels.value;

const reglages: ReglagesRelance = reglagesSaisis ??
  ecran?.reglages ?? {
    active: false,
    palierHeures: 10,
    plancherMinutes: 10,
    baseLegale: "consentement" as const,
    relance2Heures: null,
    relance3Heures: null,
    plage: null,
  };
const paniers: PanierAbandonne[] = ecran?.paniers ?? [];
const chiffres = ecran?.chiffres ?? {
  relancables: 0,
  montantEnJeu: 0,
  relancesEnvoyees: 0,
  paniersRecuperes: 0,
  montantRecupere: 0,
};

/**
 * Les délais de la 1re relance, avec la phrase qui dit ce qu'ils valent. Les
 * quatre de Shopify, et quelques autres : la liste vient de l'API, la phrase
 * d'ici — un délai sans phrase s'affiche quand même.
 */
const AIDES_PALIERS: Record<number, string> = {
  1: "Très tôt : le client est peut-être encore devant son écran.",
  2: "Tôt : le message arrive pendant qu'il y pense encore.",
  3: "Tôt : le message arrive pendant qu'il y pense encore.",
  6: "Le message arrive dans la même demi-journée.",
  10: "Le réglage conseillé : le panier du soir est rappelé le matin.",
  12: "Une demi-journée plus tard.",
  24: "Un jour plus tard, à la même heure qu'hier.",
  48: "Deux jours plus tard : discret, mais le client a peut-être déjà oublié.",
};
const PALIERS = (ecran?.paliers ?? [1, 6, 10, 24]).map((h) => ({
  h,
  label: h === 1 ? "1 heure" : h % 24 === 0 ? duree(h) : `${h} heures`,
  aide: AIDES_PALIERS[h] ?? "",
}));

/** Les délais proposés pour la 2e et la 3e relance, comptés depuis l'abandon. */
const PALIERS_SUIVANTS = ecran?.paliersSuivants ?? [24, 48, 72, 96, 120, 168, 240, 312];

/** Les heures d'une journée, pour la plage d'envoi. */
const HEURES = Array.from({ length: 25 }, (_, h) => h);

/** Le plancher d'affichage : Shopify ne descend pas sous 10, ni au-delà de 15. */
const PLANCHERS = [10, 11, 12, 13, 14, 15];

const palierChoisi =
  PALIERS.find((p) => p.h === reglages.palierHeures) ??
  PALIERS.find((p) => p.h === 10) ??
  PALIERS[0]!;

/**
 * Les trois relances, telles que le tableau du programme les présente : la
 * phrase dit dans quelles langues la boutique a écrit son propre texte, car
 * chaque cliente reçoit celui de SA langue, ou le texte d'origine de sa langue.
 */
const NOMS_LANGUES: Record<string, string> = {
  fr: "français",
  en: "anglais",
  de: "allemand",
  it: "italien",
  es: "espagnol",
};
function phraseCourriel(langues: string[]): string {
  if (!langues.length) return " Courriel : le texte d'origine.";
  if (langues.length === 5) return " Courriel : votre texte, dans les cinq langues.";
  const noms = langues.map((l) => NOMS_LANGUES[l] ?? l);
  const liste =
    noms.length === 1 ? noms[0] : `${noms.slice(0, -1).join(", ")} et ${noms[noms.length - 1]}`;
  return ` Courriel : votre texte en ${liste} ; le texte d'origine dans les autres langues.`;
}
const courriels = [1, 2, 3].map((etape) => {
  const c = ecran?.courriels?.find((x) => x.etape === etape);
  // Une API d'avant les langues ne disait que « réécrit ou non » : c'était
  // alors le français.
  const langues = c?.langues ?? (c?.personnalise ? ["fr"] : []);
  return { etape, personnalise: langues.length > 0, phrase: phraseCourriel(langues) };
});

/**
 * La carte « Le courriel envoyé » : pour chaque relance, si elle part, quand,
 * et l'objet que lira une cliente française — votre texte ou celui d'origine.
 * Les réglages sont ceux enregistrés, pas une saisie refusée.
 */
const reglagesEnregistres = ecran?.reglages ?? reglages;
const cartesCourriel = [1, 2, 3].map((etape) => {
  const c = courrielsFr?.etapes.find((x) => x.etape === etape);
  const heures =
    etape === 1
      ? reglagesEnregistres.palierHeures
      : etape === 2
        ? reglagesEnregistres.relance2Heures
        : reglagesEnregistres.relance3Heures;
  return {
    etape,
    nom: c?.nom ?? (etape === 1 ? "1re relance" : `${etape}e relance`),
    quand: heures === null ? null : `${duree(heures)} après le dernier geste du client`,
    objet: c?.textes.objet ?? null,
    personnalise: c?.personnalise ?? false,
  };
});

/** Couleur de la pastille d'état — le lisible avant le décoratif. */
function tonEtat(etat: PanierAbandonne["etat"]): string {
  if (etat === "recupere") return "bg-green-100 text-green-800";
  if (etat === "trop_ancien") return "bg-gray-100 text-gray-600";
  if (etat === "relance") return "bg-blue-100 text-blue-800";
  if (etat === "renonce") return "bg-amber-100 text-amber-800";
  return "bg-bo-bg text-bo-muted";
}
---

<Admin title="Paniers abandonnés">
  {flash && (
    <p
      class={`mb-4 rounded border px-3 py-2 text-sm ${
        flashErreur
          ? "border-red-300 bg-red-50 text-red-800"
          : "border-green-300 bg-green-50 text-green-800"
      }`}
    >
      {flash}
    </p>
  )}
  {erreur && <p class="mb-4 text-sm text-red-600">API injoignable : {erreur}</p>}

  {ecran && !ecran.courrierConfigure && (
    <p class="mb-4 rounded border border-amber-300 bg-amber-50 px-3 py-2 text-sm text-amber-900">
      L'envoi de courriers n'est pas configuré : aucune relance ne peut partir,
      automatique ou non. Les paniers restent listés ci-dessous.
    </p>
  )}

  <p class="mb-5 max-w-3xl text-sm text-bo-muted">
    Un panier devient « abandonné » quand un client a laissé son adresse
    e-mail au tunnel de commande et que plus rien n'a bougé depuis le délai
    d'affichage réglé plus bas. Il apparaît alors ici. Les courriers de
    relance, eux, ne partent qu'aux délais du programme — et jamais au-delà de
    quatorze jours, où le panier est définitivement laissé tranquille.
  </p>

  {/* --- Le courriel qui part -------------------------------------------- */}
  {/* En tête : c'est ce que la cliente reçoit, et ce qu'on vient modifier.
      L'écran de réécriture n'avait qu'un petit lien dans les réglages. */}
  <section id="courriel-envoye" class="mb-6 rounded-lg border border-bo-border bg-bo-surface">
    <div class="flex flex-wrap items-center justify-between gap-2 border-b border-bo-border px-4 py-3">
      <h2 class="text-sm font-medium">Le courriel envoyé</h2>
      <span
        class={`rounded px-2 py-0.5 text-xs ${
          reglagesEnregistres.active ? "bg-green-100 text-green-800" : "bg-bo-bg text-bo-muted"
        }`}
      >
        {reglagesEnregistres.active ? "Relance automatique activée" : "Relance automatique désactivée"}
      </span>
    </div>
    <ul class="divide-y divide-bo-border">
      {cartesCourriel.map((c) => (
        <li class="flex flex-wrap items-center gap-x-4 gap-y-2 px-4 py-3">
          <div class="min-w-0 flex-1 text-sm">
            <p>
              <span class="font-medium">{c.nom}</span>
              <span class="text-bo-muted"> — {c.quand ?? "pas programmée"}</span>
            </p>
            {c.objet && (
              <p class="mt-0.5">
                Objet : « {c.objet} »
                <span
                  class={`ml-1 rounded px-1.5 py-0.5 text-xs ${
                    c.personnalise ? "bg-blue-100 text-blue-800" : "bg-bo-bg text-bo-muted"
                  }`}
                >
                  {c.personnalise ? "votre texte" : "texte d'origine"}
                </span>
              </p>
            )}
          </div>
          <a
            href={url(`/paniers/courriel?relance=${c.etape}`)}
            class="rounded border border-bo-border px-3 py-1.5 text-sm whitespace-nowrap hover:bg-bo-bg"
          >
            Modifier le courriel
          </a>
          <form method="POST">
            <input type="hidden" name="action" value="essai" />
            <input type="hidden" name="etape" value={c.etape} />
            <button class="rounded border border-bo-border px-3 py-1.5 text-sm whitespace-nowrap hover:bg-bo-bg">
              M'envoyer un essai
            </button>
          </form>
        </li>
      ))}
    </ul>
    <p class="px-4 pb-3 pt-1 text-xs text-bo-muted">
      L'objet affiché est celui que lisent les clients en français : chaque
      langue a son courriel, à modifier dans le même écran (Paniers abandonnés
      › Courriel de relance). L'essai part à l'adresse de votre compte. Quand
      et à qui les relances partent se règle juste en dessous.
    </p>
  </section>

  {/* --- Les chiffres qui comptent -------------------------------------- */}
  <div class="mb-6 grid grid-cols-2 gap-3 lg:grid-cols-5">
    <div class="rounded-lg border border-bo-border bg-bo-surface px-4 py-3">
      <div class="text-xs text-bo-muted">Paniers relançables</div>
      <div class="text-2xl">{chiffres.relancables}</div>
    </div>
    <div class="rounded-lg border border-bo-border bg-bo-surface px-4 py-3">
      <div class="text-xs text-bo-muted">Montant en jeu</div>
      <div class="text-2xl">{formatPrice(chiffres.montantEnJeu)}</div>
    </div>
    <div class="rounded-lg border border-bo-border bg-bo-surface px-4 py-3">
      <div class="text-xs text-bo-muted">Relances envoyées</div>
      <div class="text-2xl">{chiffres.relancesEnvoyees}</div>
      <div class="text-xs text-bo-muted">Depuis toujours.</div>
    </div>
    <div class="rounded-lg border border-green-300 bg-green-50 px-4 py-3">
      <div class="text-xs text-green-800">Paniers récupérés</div>
      <div class="text-2xl text-green-900">{chiffres.paniersRecuperes}</div>
      <div class="text-xs text-green-800">Payés après une relance.</div>
    </div>
    <div class="rounded-lg border border-green-300 bg-green-50 px-4 py-3">
      <div class="text-xs text-green-800">Montant récupéré</div>
      <div class="text-2xl text-green-900">{formatPrice(chiffres.montantRecupere)}</div>
      <div class="text-xs text-green-800">Ce que la relance a rapporté.</div>
    </div>
  </div>

  {/* --- Les réglages ---------------------------------------------------- */}
  <section class="mb-6 rounded-lg border border-bo-border bg-bo-surface">
    <h2 class="border-b border-bo-border px-4 py-3 text-sm font-medium">
      Réglages de la relance
    </h2>
    <form method="POST" class="space-y-5 px-4 py-4">
      <input type="hidden" name="action" value="reglages" />

      <label class="flex max-w-3xl items-start gap-3">
        <input
          type="checkbox"
          name="active"
          checked={reglages.active}
          class="mt-1"
        />
        <span>
          <span class="text-sm font-medium">Relancer automatiquement</span>
          <span class="mt-0.5 block text-xs text-bo-muted">
            Décochée, aucune relance ne part toute seule : il faut cliquer sur
            « Relancer » panier par panier. Cochée, la boutique regarde toutes
            les cinq minutes et écrit d'elle-même aux clients concernés.
          </span>
        </span>
      </label>

      {/* Le programme : jusqu'à trois relances, chacune avec son délai et
          son courriel. Une seule ligne par relance, pour que le rythme entier
          se lise d'un coup d'œil. */}
      <fieldset class="max-w-3xl">
        <legend class="text-sm font-medium">Programme des relances</legend>
        <p class="mt-0.5 text-xs text-bo-muted">
          Les délais se comptent à partir du dernier geste du client
          (article ajouté, adresse saisie…), pas de la création du panier.
          Une relance ne part jamais avant l'écart prévu depuis la précédente,
          et plus aucune ne part après quatorze jours.
        </p>
        <div class="mt-3 divide-y divide-bo-border rounded border border-bo-border">
          <div class="flex flex-wrap items-center gap-x-4 gap-y-2 px-3 py-3">
            <span class="w-24 text-sm font-medium">1re relance</span>
            <label class="flex items-center gap-2 text-sm">
              <select
                name="palierHeures"
                class="rounded border border-bo-border px-3 py-1.5 text-sm"
              >
                {PALIERS.map((p) => (
                  <option value={p.h} selected={p.h === reglages.palierHeures}>
                    {p.label}
                  </option>
                ))}
              </select>
              <span class="text-bo-muted">après l'abandon</span>
            </label>
            <a
              href={url("/paniers/courriel?relance=1")}
              class="ml-auto text-sm text-bo-accent hover:underline"
            >
              Modifier le courriel
            </a>
            <span class="basis-full text-xs text-bo-muted">
              {palierChoisi.aide}
              {courriels[0]!.phrase}
            </span>
          </div>

          {[2, 3].map((etape) => {
            const valeur =
              etape === 2 ? reglages.relance2Heures : reglages.relance3Heures;
            return (
              <div class="flex flex-wrap items-center gap-x-4 gap-y-2 px-3 py-3">
                <span class="w-24 text-sm font-medium">{etape}e relance</span>
                <label class="flex items-center gap-2 text-sm">
                  <select
                    name={`relance${etape}Heures`}
                    class="rounded border border-bo-border px-3 py-1.5 text-sm"
                  >
                    <option value="" selected={valeur === null}>
                      Pas de {etape}e relance
                    </option>
                    {PALIERS_SUIVANTS.map((h) => (
                      <option value={h} selected={h === valeur}>
                        {duree(h)}
                      </option>
                    ))}
                  </select>
                  <span class="text-bo-muted">après l'abandon</span>
                </label>
                <a
                  href={url(`/paniers/courriel?relance=${etape}`)}
                  class="ml-auto text-sm text-bo-accent hover:underline"
                >
                  Modifier le courriel
                </a>
                <span class="basis-full text-xs text-bo-muted">
                  {etape === 2
                    ? "Facultative. Elle ne part qu'aux clients qui n'ont toujours pas commandé."
                    : "Facultative, et seulement s'il y a une 2e relance. Son courriel d'origine annonce qu'elle est la dernière."}
                  {courriels[etape - 1]!.phrase}
                </span>
              </div>
            );
          })}
        </div>
      </fieldset>

      <div class="max-w-3xl">
        <label class="flex items-start gap-3">
          <input
            type="checkbox"
            name="plageActive"
            checked={reglages.plage !== null}
            class="mt-1"
          />
          <span>
            <span class="text-sm font-medium">N'envoyer qu'en journée</span>
            <span class="mt-0.5 block text-xs text-bo-muted">
              Une relance qui tombe en dehors de ces heures attend le début de
              la plage suivante. Décochée, elles partent à toute heure. Le
              bouton « Relancer » d'une ligne, lui, part tout de suite.
            </span>
          </span>
        </label>
        <div class="mt-2 flex flex-wrap items-center gap-2 pl-7 text-sm">
          <span>De</span>
          <select
            name="plageDebut"
            aria-label="Début de la plage d'envoi"
            class="rounded border border-bo-border px-2 py-1.5 text-sm"
          >
            {HEURES.slice(0, 24).map((h) => (
              <option value={h} selected={h === (reglages.plage?.debut ?? 9)}>
                {h} h
              </option>
            ))}
          </select>
          <span>à</span>
          <select
            name="plageFin"
            aria-label="Fin de la plage d'envoi"
            class="rounded border border-bo-border px-2 py-1.5 text-sm"
          >
            {HEURES.slice(1).map((h) => (
              <option value={h} selected={h === (reglages.plage?.fin ?? 20)}>
                {h} h
              </option>
            ))}
          </select>
          <span class="text-bo-muted">(heure de Paris)</span>
        </div>
      </div>

      <div class="grid max-w-3xl gap-5 sm:grid-cols-2">
        <label class="block">
          <span class="text-sm font-medium">Afficher le panier après</span>
          <select
            name="plancherMinutes"
            class="mt-1 w-full rounded border border-bo-border px-3 py-2 text-sm"
          >
            {PLANCHERS.map((m) => (
              <option value={m} selected={m === reglages.plancherMinutes}>
                {m} minutes
              </option>
            ))}
          </select>
          <span class="mt-1 block text-xs text-bo-muted">
            Le temps qu'on laisse à un client avant de considérer qu'il est
            parti. En dessous de dix minutes, on prendrait pour un abandon
            quelqu'un qui remplit encore son adresse.
          </span>
        </label>
      </div>

      <fieldset class="max-w-3xl">
        <legend class="text-sm font-medium">Sur quelle base on écrit</legend>
        <label class="mt-2 flex items-start gap-3">
          <input
            type="radio"
            name="baseLegale"
            value="consentement"
            checked={reglages.baseLegale === "consentement"}
            class="mt-1"
          />
          <span>
            <span class="text-sm">Consentement</span>
            <span class="mt-0.5 block text-xs text-bo-muted">
              On n'écrit qu'aux clients qui ont accepté de recevoir nos
              messages. C'est le choix le plus prudent : moins de courriers
              partent, mais aucun ne peut être reproché.
            </span>
          </span>
        </label>
        <label class="mt-3 flex items-start gap-3">
          <input
            type="radio"
            name="baseLegale"
            value="interet_legitime"
            checked={reglages.baseLegale === "interet_legitime"}
            class="mt-1"
          />
          <span>
            <span class="text-sm">Intérêt légitime</span>
            <span class="mt-0.5 block text-xs text-bo-muted">
              On écrit à tout client qui a laissé une commande en cours, même
              sans case cochée — le RGPD l'autorise pour une commande entamée.
              En contrepartie, chaque courrier porte alors un lien
              « Ne plus recevoir de rappel », et un client qui l'utilise n'est
              plus jamais relancé.
            </span>
          </span>
        </label>
      </fieldset>

      <div class="flex flex-wrap items-center gap-3">
        <button class="rounded bg-bo-nav px-4 py-2 text-sm text-white">
          Enregistrer les réglages
        </button>
        <span class="text-xs text-bo-muted">
          Ces réglages ne se saisissent qu'ici.
        </span>
      </div>
    </form>
  </section>

  {/* --- La liste -------------------------------------------------------- */}
  <div class="mb-3 flex flex-wrap items-end justify-between gap-3">
    <form method="GET" class="flex flex-wrap items-end gap-3">
      <label class="text-sm">
        <span class="mb-1 block text-xs text-bo-muted">
          Voir les paniers immobiles depuis plus de
        </span>
        <select
          name="plancher"
          class="rounded border border-bo-border px-3 py-2 text-sm"
        >
          {[10, 15, 60, 360, 1440, 10080].map((m) => (
            <option value={m} selected={m === ecran?.plancher}>
              {m < 60
                ? `${m} minutes`
                : m < 1440
                  ? `${m / 60} heures`
                  : m === 1440
                    ? "1 jour"
                    : `${m / 1440} jours`}
            </option>
          ))}
        </select>
      </label>
      <button class="rounded border border-bo-border px-4 py-2 text-sm hover:bg-bo-bg">
        Afficher
      </button>
    </form>

    <form method="POST">
      <input type="hidden" name="action" value="passage" />
      <button class="rounded border border-bo-border px-4 py-2 text-sm hover:bg-bo-bg">
        Lancer un passage maintenant
      </button>
    </form>
  </div>

  <section class="overflow-x-auto rounded-lg border border-bo-border bg-bo-surface">
    <table class="w-full text-sm">
      <thead class="bg-bo-bg text-left text-bo-muted">
        <tr>
          <th class="px-4 py-2 font-medium">Panier</th>
          <th class="px-4 py-2 font-medium">État</th>
          <th class="px-4 py-2 font-medium">Client</th>
          <th class="px-4 py-2 font-medium">Articles</th>
          <th class="px-4 py-2 text-right font-medium">Montant</th>
          <th class="px-4 py-2 font-medium">Lien de récupération</th>
          <th class="px-4 py-2"></th>
        </tr>
      </thead>
      <tbody>
        {paniers.map((p) => (
          <tr class="border-t border-bo-border align-top hover:bg-bo-bg/50">
            <td class="px-4 py-3 whitespace-nowrap">
              <a
                href={url(`/commandes/${p.id}`)}
                class="font-medium text-bo-accent hover:underline"
              >
                {p.number}
              </a>
            </td>
            <td class="px-4 py-3">
              <span class={`inline-block rounded px-2 py-0.5 text-xs ${tonEtat(p.etat)}`}>
                {p.etatLibelle}
              </span>
              {p.etat === "trop_ancien" && (
                <span class="mt-1 block text-xs text-bo-muted">
                  Passé quatorze jours, plus aucun courrier ne part : le rappel
                  serait à côté de la plaque, et les prix ont pu changer.
                </span>
              )}
              {p.motifRenoncement && p.etat !== "trop_ancien" && (
                <span class="mt-1 block text-xs text-amber-800">
                  Envoi renoncé : {p.motifRenoncement}
                </span>
              )}
              {p.prochaineRelance && (
                <span class="mt-1 block text-xs text-bo-muted">
                  {p.prochaineRelance}
                </span>
              )}
            </td>
            <td class="px-4 py-3">
              <div>{p.nom ?? "—"}</div>
              <div class="text-xs text-bo-muted">{p.email}</div>
            </td>
            <td class="px-4 py-3 text-bo-muted">{p.articles}</td>
            <td class="px-4 py-3 text-right whitespace-nowrap">
              {formatPrice(p.totalCents)}
            </td>
            <td class="px-4 py-3">
              {/* Le lien se copie et se donne : au téléphone, dans un message,
                  ou pour vérifier soi-même ce que la cliente verra. */}
              <input
                type="text"
                readonly
                value={p.lienRecuperation}
                onclick="this.select()"
                class="w-64 rounded border border-bo-border bg-bo-bg px-2 py-1 text-xs"
              />
            </td>
            <td class="px-4 py-3 text-right">
              {p.relancable ? (
                <form method="POST">
                  <input type="hidden" name="action" value="relancer" />
                  <input type="hidden" name="id" value={p.id} />
                  <button class="rounded border border-bo-border px-3 py-1.5 text-sm whitespace-nowrap hover:bg-bo-bg">
                    {p.relanceAt ? "Relancer à nouveau" : "Relancer"}
                  </button>
                </form>
              ) : (
                <span class="text-xs text-bo-muted">—</span>
              )}
            </td>
          </tr>
        ))}
        {paniers.length === 0 && !erreur && (
          <tr>
            <td colspan="7" class="px-4 py-6 text-center text-bo-muted">
              Aucun panier abandonné sur cette période. Tant mieux.
            </td>
          </tr>
        )}
      </tbody>
    </table>
  </section>

  <p class="mt-3 max-w-3xl text-sm text-bo-muted">
    Avant chaque envoi, la boutique vérifie cinq choses : que le client n'a
    pas commandé entre-temps avec la même adresse, que cette relance-là n'est
    pas déjà partie, qu'on a le droit de lui écrire (et qu'il n'a pas
    demandé à ne plus recevoir de rappel), que ses affiches sont toujours
    disponibles — un panier vidé n'est jamais relancé —, et que le panier a
    moins de quatorze jours. Le motif s'affiche dans la colonne « État »
    chaque fois qu'un envoi est écarté, et la prochaine relance prévue juste
    en dessous. Le bouton « Relancer » passe outre l'unicité et le
    consentement — jamais les trois autres —, et le courrier qu'il envoie à
    un client sans consentement porte alors son lien de désinscription,
    quel que soit le réglage.
  </p>
</Admin>
