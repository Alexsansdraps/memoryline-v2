  </style>

  <script>
    /*
     * Le formulaire vivant : l'envoi des images, le point de cadrage, les
     * parties propres à la bannière, et l'aperçu.
     *
     * Un script Astro (et non « inline ») pour une seule raison : importer
     * les fonctions du site. Les classes de l'aperçu sont calculées par
     * classesBanniere, comme celles de la boutique — deux copies du calcul
     * finiraient par ne plus montrer la même chose.
     *
     * Tout ce qui vient du formulaire entre dans la page par textContent ou
     * par des attributs : jamais en HTML.
     */
    import {
      classesBanniere,
      lienBandeau,
      normaliserBandeau,
      normaliserLienSaisi,
      styleBanniere,
      type BandeauVisuel,
    } from "@memoryline/types/bandeaux-visuels";

    const formulaire = document.getElementById("bv-formulaire") as HTMLFormElement | null;
    const apercu = document.getElementById("bv-apercu");
    if (formulaire && apercu) {
      const API = apercu.dataset.api ?? "";
      const LARGEURS = { ordinateur: 1280, tablette: 768, telephone: 375 } as const;
      type Ecran = keyof typeof LARGEURS;
      let ecran: Ecran = "ordinateur";

      /** L'adresse d'une image pour ce navigateur : l'API sous /api. */
      const adresseImage = (chemin: string) => (chemin.startsWith("/") ? API + chemin : chemin);

      /* --- Ce qui ne vaut que pour une mise en page ---------------------- */
      const parties = formulaire.querySelectorAll<HTMLElement>("[data-seulement]");
      const enBanniere = () =>
        (formulaire!.querySelector<HTMLInputElement>("input[name='miseEnPage']:checked")?.value ??
          "banniere") === "banniere";
      function selonMiseEnPage() {
        const miseEnPage = enBanniere() ? "banniere" : "cote-a-cote";
        parties.forEach((p) => {
          p.hidden = p.dataset.seulement !== miseEnPage;
        });
      }

      /* --- Les images ---------------------------------------------------- */
      /** Les relevés de dimensions, à refaire quand la mise en page change. */
      const releves: (() => void)[] = [];
      formulaire.querySelectorAll<HTMLElement>(".js-image").forEach((bloc) => {
        const fichier = bloc.querySelector<HTMLInputElement>(".js-fichier");
        const champUrl = bloc.querySelector<HTMLInputElement>(".js-url");
        const cadre = bloc.querySelector<HTMLElement>(".js-cadre");
        const vignette = bloc.querySelector<HTMLImageElement>(".js-vignette");
        const point = bloc.querySelector<HTMLElement>(".js-point");
        const largeur = bloc.querySelector<HTMLInputElement>(".js-largeur");
        const hauteur = bloc.querySelector<HTMLInputElement>(".js-hauteur");
        const etat = bloc.querySelector<HTMLElement>(".js-etat");
        const rangeX = bloc.querySelector<HTMLInputElement>(".js-cadrage-x");
        const rangeY = bloc.querySelector<HTMLInputElement>(".js-cadrage-y");
        const retirer = bloc.querySelector<HTMLButtonElement>(".js-retirer");
        // La largeur conseillée dépend de la mise en page : bord à bord, il
        // en faut bien plus que pour la moitié de la largeur de lecture.
        const minimum = () =>
          Number((enBanniere() ? bloc.dataset.min : bloc.dataset.minCote ?? bloc.dataset.min) || 0);
        if (!champUrl || !cadre || !vignette || !largeur || !hauteur) return;

        // Les dimensions ne se lisent que sur l'ORIGINAL : une version
        // réduite (?l=…) donnerait sa propre largeur, pas celle de l'image.
        // Ce sont elles qui réservent la place du bandeau sur le site.
        function relever() {
          if (!vignette!.naturalWidth) return;
          largeur!.value = String(vignette!.naturalWidth);
          hauteur!.value = String(vignette!.naturalHeight);
          if (etat)
            etat.textContent =
              `${vignette!.naturalWidth} × ${vignette!.naturalHeight} px.` +
              (vignette!.naturalWidth < minimum()
                ? ` Un peu étroite : comptez ${minimum()} px de large au moins, sans quoi elle paraîtra floue sur un grand écran.`
                : "");
        }
        vignette.addEventListener("load", () => {
          relever();
          rendre();
        });
        // Déjà chargée avant ce script (cache du navigateur) : l'événement
        // ne viendra plus. Un bandeau repris sans dimensions les reçoit ici.
        if (vignette.complete && vignette.naturalWidth) relever();
        releves.push(relever);
        vignette.addEventListener("error", () => {
          if (etat) etat.textContent = "Cette adresse ne donne pas d'image lisible.";
        });

        function montrer(adresse: string) {
          largeur!.value = "";
          hauteur!.value = "";
          cadre!.hidden = !adresse;
          if (adresse) vignette!.src = adresseImage(adresse);
          else vignette!.removeAttribute("src");
          rendre();
        }

        function placerPoint() {
          if (!point || !rangeX || !rangeY) return;
          point.style.left = `${rangeX.value}%`;
          point.style.top = `${rangeY.value}%`;
        }

        // Un clic sur l'image choisit le point qui reste visible au
        // recadrage ; les deux curseurs disent la même chose au clavier.
        vignette.addEventListener("click", (e) => {
          // Côte à côte, l'image s'affiche entière : pas de cadrage à choisir.
          if (!rangeX || !rangeY || !enBanniere()) return;
          const r = vignette.getBoundingClientRect();
          rangeX.value = String(Math.round(((e.clientX - r.left) / r.width) * 100));
          rangeY.value = String(Math.round(((e.clientY - r.top) / r.height) * 100));
          placerPoint();
          rendre();
        });
        rangeX?.addEventListener("input", placerPoint);
        rangeY?.addEventListener("input", placerPoint);

        champUrl.addEventListener("change", () => montrer(champUrl.value.trim()));

        retirer?.addEventListener("click", () => {
          champUrl.value = "";
          if (fichier) fichier.value = "";
          if (etat) etat.textContent = "Retirée : le téléphone montrera l'image principale, recadrée.";
          montrer("");
        });

        fichier?.addEventListener("change", async () => {
          const f = fichier.files?.[0];
          if (!f) return;
          if (etat) etat.textContent = "Envoi en cours…";
          try {
            const corps = new FormData();
            corps.append("file", f);
            // Pas d'en-tête Content-Type à la main : le navigateur écrit
            // lui-même la frontière du multipart. `credentials` porte le
            // cookie d'administration, sans quoi l'API refuse.
            const res = await fetch(API + "/admin/uploads", {
              method: "POST",
              credentials: "include",
              body: corps,
            });
            if (res.status === 413) throw new Error("fichier trop lourd (25 Mo au plus)");
            if (res.status === 415) throw new Error("format refusé : JPEG, PNG ou WebP");
            if (!res.ok) throw new Error("HTTP " + res.status);
            const data = (await res.json()) as { url: string };
            champUrl.value = data.url;
            if (etat) etat.textContent = "Image envoyée. Enregistrez pour la publier.";
            montrer(data.url);
          } catch (e) {
            if (etat) etat.textContent = "Envoi impossible : " + (e instanceof Error ? e.message : String(e));
          }
        });
      });

      /* --- L'aperçu ------------------------------------------------------ */
      const el = <K extends keyof HTMLElementTagNameMap>(
        balise: K,
        classe?: string,
        texte?: string,
      ): HTMLElementTagNameMap[K] => {
        const n = document.createElement(balise);
        if (classe) n.className = classe;
        if (texte) n.textContent = texte;
        return n;
      };

      function lire(): BandeauVisuel | null {
        const f = new FormData(formulaire!);
        const champ = (nom: string) => String(f.get(nom) ?? "");
        return normaliserBandeau({
          id: "apercu",
          miseEnPage: champ("miseEnPage"),
          image: champ("image"),
          imageLargeur: champ("imageLargeur"),
          imageHauteur: champ("imageHauteur"),
          cadrage: { x: champ("cadrageX"), y: champ("cadrageY") },
          imageMobile: champ("imageMobile"),
          imageMobileLargeur: champ("imageMobileLargeur"),
          imageMobileHauteur: champ("imageMobileHauteur"),
          cadrageMobile: { x: champ("cadrageMobileX"), y: champ("cadrageMobileY") },
          alt: champ("alt"),
          titre: champ("titre"),
          texte: champ("texte"),
          bouton: champ("bouton"),
          lien: normaliserLienSaisi(champ("lien")),
          imageCliquable: f.get("imageCliquable") === "on",
          position: champ("position"),
          style: champ("style"),
          hauteur: champ("hauteur"),
        });
      }

      /** La bannière, bâtie comme BandeauxVisuels.astro la bâtit. */
      function banniere(b: BandeauVisuel): HTMLElement {
        const lien = lienBandeau(b.lien);
        const entiere = !!lien && (b.imageCliquable || !b.bouton);
        const cadre = el("div", "ml-bv-cadre");
        const racine = el(entiere ? "a" : "div", classesBanniere(b));
        racine.setAttribute("style", styleBanniere(b));
        const picture = el("picture", "ml-bv-media");
        const img = el("img");
        const mobile = ecran === "telephone" && b.imageMobile;
        img.src = adresseImage(mobile ? b.imageMobile : b.image);
        img.alt = b.alt;
        picture.append(img);
        racine.append(picture);
        if (b.titre || b.texte || (b.bouton && lien)) {
          const contenu = el("div", "ml-bv-contenu");
          const boite = el("div", "ml-bv-boite");
          if (b.titre) boite.append(el("h2", "ml-bv-titre", b.titre));
          if (b.texte) boite.append(el("p", "ml-bv-texte", b.texte));
          if (b.bouton && lien) boite.append(el(entiere ? "span" : "a", "ml-bv-bouton", b.bouton));
          contenu.append(boite);
          racine.append(contenu);
        }
        cadre.append(racine);
        return cadre;
      }

      /** L'ancien encart, avec les règles .bv-cote de cette page. */
      function coteACote(b: BandeauVisuel): HTMLElement {
        const section = el("section", "bv-cote");
        const grille = el("div", "bv-cote-grille");
        const img = el("img");
        img.src = adresseImage(b.image);
        img.alt = b.alt || b.titre;
        const textes = el("div");
        if (b.titre) textes.append(el("h2", "", b.titre));
        if (b.texte) textes.append(el("p", "", b.texte));
        if (b.bouton && lienBandeau(b.lien)) textes.append(el("a", "", b.bouton));
        grille.append(img, textes);
        section.append(grille);
        return section;
      }

      const scene = el("div", "bv-scene");

      function rendre() {
        const b = lire();
        const entete = el("div", "bv-scene-entete");
        entete.append(
          el("span", "bv-scene-logo", "Memory Line"),
          el("span", "bv-scene-trait"),
          el("span", "bv-scene-trait"),
        );
        const suite = el("div", "bv-scene-suite");
        for (const largeur of ["38%", "62%", "52%"]) {
          const ligne = el("span");
          ligne.style.width = largeur;
          suite.append(ligne);
        }
        const corps = !b || !b.image
          ? el("div", "bv-scene-vide", "Choisissez une image pour voir le bandeau.")
          : b.miseEnPage === "cote-a-cote"
            ? coteACote(b)
            : banniere(b);
        scene.replaceChildren(entete, corps, suite);
        // Un lien de l'aperçu ne doit mener nulle part : il quitterait le
        // formulaire en cours.
        scene.querySelectorAll("a").forEach((a) => {
          a.setAttribute("href", "#");
          a.setAttribute("tabindex", "-1");
        });
        mettreALEchelle();
      }

      scene.addEventListener("click", (e) => {
        if ((e.target as Element).closest("a")) e.preventDefault();
      });

      /** L'écran simulé, réduit pour tenir dans la colonne. */
      function mettreALEchelle() {
        const largeur = LARGEURS[ecran];
        const place = apercu!.clientWidth || largeur;
        const echelle = Math.min(1, place / largeur);
        scene.style.width = `${largeur}px`;
        scene.style.transform = echelle < 1 ? `scale(${echelle})` : "";
        // Une boîte réduite par `transform` garde sa hauteur d'origine dans
        // la page : on la ramène à ce qu'on voit.
        apercu!.style.height = `${Math.ceil(scene.offsetHeight * echelle)}px`;
        const legende = document.querySelector(".js-legende-apercu");
        if (legende)
          legende.textContent =
            `Écran de ${largeur} px${echelle < 1 ? `, montré à ${Math.round(echelle * 100)} %` : ""}. ` +
            "L'aperçu suit le formulaire : rien n'est publié avant « Enregistrer ».";
      }

      apercu.replaceChildren(scene);
      apercu.style.position = "relative";

      document.querySelectorAll<HTMLButtonElement>(".js-ecran").forEach((bouton) => {
        bouton.addEventListener("click", () => {
          ecran = (bouton.dataset.ecran as Ecran) ?? "ordinateur";
          document.querySelectorAll(".js-ecran").forEach((autre) => {
            autre.setAttribute("aria-pressed", autre === bouton ? "true" : "false");
          });
          rendre();
        });
      });

      formulaire.addEventListener("input", rendre);
      formulaire.addEventListener("change", (e) => {
        if ((e.target as HTMLInputElement | null)?.name === "miseEnPage") {
          selonMiseEnPage();
          releves.forEach((relever) => relever());
        }
        rendre();
      });
      // Les images de l'aperçu arrivent après lui : leur hauteur compte
      // pour l'échelle (mise en page côte à côte, hauteur « de l'image »).
      scene.addEventListener("load", mettreALEchelle, true);
      // La colonne change de largeur avec la fenêtre. On ne réagit qu'à la
      // LARGEUR : la hauteur, c'est mettreALEchelle qui la pose, et y
      // réagir le relancerait sur lui-même.
      let derniereLargeur = 0;
      new ResizeObserver(() => {
        if (apercu.clientWidth === derniereLargeur) return;
        derniereLargeur = apercu.clientWidth;
        mettreALEchelle();
      }).observe(apercu);

      selonMiseEnPage();
      rendre();
    }
  </script>
</Admin>
