    /* « Côte à côte » : les classes de l'ancien encart (px-6 pt-10
       lg:px-12, grille de deux colonnes dès 640 px, titre 30 px…), réécrites
       pour un cadre plutôt que pour l'écran. */
    .bv-cote {
      padding: 40px 24px 0;
    }
    .bv-cote-grille {
      display: grid;
      align-items: center;
      gap: 32px;
      max-width: 1200px;
