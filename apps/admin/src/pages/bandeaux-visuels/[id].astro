---
/**
 * Un bandeau visuel : son image, son texte, sa mise en forme, ses pages et
 * ses dates — avec, à côté, l'aperçu de ce que la boutique affichera.
 *
 * L'APERÇU N'EST PAS UNE IMITATION. Il est bâti avec la feuille de style du
 * site (@memoryline/types/bandeaux-visuels.css) et les mêmes fonctions de
 * calcul des classes : seules la page autour et l'échelle sont simulées. La
 * feuille se règle sur la largeur de son cadre, pas sur celle de l'écran, ce
 * qui permet de montrer ici la version « téléphone » dans une boîte de
 * 375 px.
 *
 * Le formulaire n'enregistre que le français et la forme. Les traductions
 * ont leur bloc, plus bas, comme sur les autres écrans : « Proposer les
 * traductions manquantes » remplit les cases vides en jaune, et rien n'est
 * enregistré avant « Enregistrer les traductions ».
 *
 * « nouveau » à la place de l'identifiant ouvre un bandeau vierge ; il prend
 * son identifiant au premier enregistrement.
 */
import Admin from "../../layouts/Admin.astro";
import Traductions from "../../components/Traductions.astro";
import "@memoryline/types/bandeaux-visuels.css";
import {
  HAUTEURS_BANDEAU,
  POSITIONS_TEXTE_BANDEAU,
  STYLES_TEXTE_BANDEAU,
  etatBandeau,
  lienBandeau,
  normaliserBandeau,
  normaliserLienSaisi,
  nouveauBandeau,
  type BandeauVisuel,
  type HauteurBandeau,
  type PositionTexteBandeau,
  type StyleTexteBandeau,
  champAParis,
  instantDeParis,
} from "@memoryline/types";
import { adminApi, type CollectionBo, type ResumePage } from "../../lib/api.ts";
import { apiUrl, url } from "../../lib/url.ts";
import {
  PASTILLES,
  ecrireBandeaux,
  groupesDePages,
  lireBandeaux,
  nomDuBandeau,
  nouvelId,
  periode,
} from "../../lib/bandeaux-visuels.ts";
import {
  traiterTraductions,
  type ChampTraduit,
  type ElementTraduit,
  type EtatTraductions,
} from "../../lib/traductions.ts";

const api = adminApi(Astro.request);
const idDemande = String(Astro.params.id ?? "");
const creation = idDemande === "nouveau";

/** Ce qui se traduit : les mêmes longueurs que les champs français. */
const CHAMPS_TRADUITS: ChampTraduit[] = [
  { cle: "titre", libelle: "Titre", max: 160 },
  { cle: "texte", libelle: "Texte ou étiquette", max: 400, lignes: 2 },
  { cle: "bouton", libelle: "Bouton", max: 60 },
  { cle: "alt", libelle: "Description de l'image", max: 250 },
];
const elementTraduit = (b: BandeauVisuel): ElementTraduit => ({
  id: b.id,
  libelle: nomDuBandeau(b),
  francais: { titre: b.titre, texte: b.texte, bouton: b.bouton, alt: b.alt },
  translations: b.translations,
  champs: CHAMPS_TRADUITS,
});

/** Un champ date-heure vers une date ISO, à l'heure de la boutique (Paris). */
function quandOuRien(v: FormDataEntryValue | null): string | null {
  const s = String(v ?? "").trim();
  if (!s) return null;
  // Lue à Paris (instantDeParis) et non dans le fuseau de la machine qui
  // fabrique la page ; une date déjà munie de son fuseau se lit telle quelle.
  const d = instantDeParis(s) ?? new Date(s);
  return Number.isNaN(d.getTime()) ? null : d.toISOString();
}

/** Une date pour un champ `datetime-local` (qui n'accepte pas le fuseau). */
function pourChamp(iso: string | null | undefined): string {
  if (!iso) return "";
  const d = new Date(iso);
  return Number.isNaN(d.getTime()) ? "" : champAParis(d);
}

/**
 * Le bandeau tel que le formulaire le décrit, posé sur `base` : ce que le
 * formulaire ne porte pas (traductions, archivage) reste celui de la base.
 */
function bandeauDuFormulaire(f: FormData, base: BandeauVisuel): BandeauVisuel {
  const champ = (nom: string) => String(f.get(nom) ?? "");
  const b = normaliserBandeau({
    ...base,
    nom: champ("nom"),
    actif: f.get("actif") === "on",
    miseEnPage: champ("miseEnPage"),
    image: champ("image"),
    imageLargeur: champ("imageLargeur"),
    imageHauteur: champ("imageHauteur"),
    cadrage: { x: champ("cadrageX"), y: champ("cadrageY") },
    imageMobile: champ("imageMobile"),
    imageMobileLargeur: champ("imageMobileLargeur"),
    imageMobileHauteur: champ("imageMobileHauteur"),
    cadrageMobile: { x: champ("cadrageMobileX"), y: champ("cadrageMobileY") },
    alt: champ("alt"),
    titre: champ("titre"),
    texte: champ("texte"),
    bouton: champ("bouton"),
    lien: normaliserLienSaisi(champ("lien")),
    imageCliquable: f.get("imageCliquable") === "on",
    position: champ("position"),
    style: champ("style"),
    hauteur: champ("hauteur"),
    pages: f.getAll("pages").map(String),
    debut: quandOuRien(f.get("debut")),
    fin: quandOuRien(f.get("fin")),
  });
  if (!b) throw new Error("Le formulaire est illisible : rechargez la page.");
  // Sans image pour le téléphone, ses dimensions n'ont plus de sens.
  if (!b.imageMobile) {
    b.imageMobileLargeur = null;
    b.imageMobileHauteur = null;
  }
  return b;
}

/**
 * Ce qui empêche d'enregistrer, dit en clair. Chaque refus correspond à un
 * bandeau qui s'afficherait mal ou pas du tout sans que rien ne le signale :
 * un bouton sans lien n'apparaît pas, une image cliquable sans aucun texte
 * est un lien muet pour un lecteur d'écran.
 */
function refus(b: BandeauVisuel, lienSaisi: string): string | null {
  if (!b.image)
    return "Choisissez une image : c'est elle qui fait le bandeau.";
  if (lienSaisi.trim() && !lienBandeau(b.lien))
    return `Le lien « ${lienSaisi.trim()} » n'est pas une adresse que le site sait ouvrir. Écrivez une adresse du site, comme « /affiches?collection=villes », ou une adresse complète qui commence par https://.`;
  if (b.bouton && !b.lien)
    return "Le bouton a besoin d'un lien : indiquez où il mène, ou videz son libellé.";
  if (
    b.miseEnPage === "banniere" &&
    b.lien &&
    (b.imageCliquable || !b.bouton) &&
    !b.titre &&
    !b.texte &&
    !b.alt
  )
    return "Décrivez l'image (« Description de l'image ») : sans texte sur le bandeau, c'est cette description qui dit où mène le lien aux personnes qui ne voient pas l'écran.";
  if (b.debut && b.fin && new Date(b.fin).getTime() <= new Date(b.debut).getTime())
    return "La date de fin doit venir après la date de début.";
  return null;
}

let flash: string | null = null;
let flashErreur = false;
/** Le formulaire refusé, réaffiché tel qu'il a été envoyé. */
let saisie: BandeauVisuel | null = null;
/** Propositions de traduction à relire, saisie à réafficher, bloc ouvert. */
let tradEtat: EtatTraductions | null = null;

const formulaire = Astro.request.method === "POST" ? await Astro.request.formData() : null;
const action = String(formulaire?.get("_action") ?? "");

if (formulaire && action === "enregistrer") {
  try {
    // Relue juste avant d'écrire : voir lib/bandeaux-visuels.ts.
    const { bandeaux } = await lireBandeaux(api);
    const existant = creation ? null : (bandeaux.find((b) => b.id === idDemande) ?? null);
    if (!creation && !existant)
      throw new Error("Ce bandeau n'existe plus — il a peut-être été supprimé depuis un autre onglet.");
    const id = existant?.id ?? nouvelId(bandeaux);
    const b = bandeauDuFormulaire(formulaire, existant ?? nouveauBandeau(id));
    const motif = refus(b, String(formulaire.get("lien") ?? ""));
    if (motif) {
      saisie = b;
      throw new Error(motif);
    }
    await ecrireBandeaux(
      api,
      existant ? bandeaux.map((x) => (x.id === id ? b : x)) : [...bandeaux, b],
    );
    return Astro.redirect(`${url(`/bandeaux-visuels/${id}`)}?ok=${creation ? "cree" : "enregistre"}`);
  } catch (e) {
    flash = e instanceof Error ? e.message : String(e);
    flashErreur = true;
  }
}

if (formulaire && (action === "bv-traductions" || action === "bv-traduire")) {
  try {
    const { bandeaux } = await lireBandeaux(api);
    const b = bandeaux.find((x) => x.id === idDemande);
    if (!b)
      throw new Error("Enregistrez d'abord le bandeau en français : ses traductions s'y rattachent.");
    // Les cases modifiées, langue par langue ; écrites d'un coup ensuite,
    // la liste entière ne se réécrit qu'une fois.
    const modifiees = new Map<string, Record<string, string>>();
    tradEtat = await traiterTraductions(
      action === "bv-traductions" ? "enregistrer" : "proposer",
      formulaire,
      [elementTraduit(b)],
      CHAMPS_TRADUITS,
      async (_id, langue, champs) => {
        modifiees.set(langue, champs);
      },
      (langue, champs) => api.proposerTraduction(langue, champs),
    );
    if (action === "bv-traductions" && !tradEtat.erreur && modifiees.size) {
      // Même règle que fusionnerTraductions (API) : une case envoyée vide
      // retire sa traduction, le français s'affiche de nouveau.
      const translations: Record<string, Record<string, string>> = {};
      for (const [langue, champs] of Object.entries(b.translations ?? {}))
        translations[langue] = { ...(champs as Record<string, string>) };
      for (const [langue, champs] of modifiees) {
        const entree = { ...(translations[langue] ?? {}) };
        for (const [cle, texte] of Object.entries(champs)) {
          if (texte.trim()) entree[cle] = texte.trim();
          else delete entree[cle];
        }
        if (Object.keys(entree).length) translations[langue] = entree;
        else delete translations[langue];
      }
      const maj = normaliserBandeau({ ...b, translations });
      if (maj) await ecrireBandeaux(api, bandeaux.map((x) => (x.id === b.id ? maj : x)));
    }
    flash = tradEtat.message;
    flashErreur = tradEtat.erreur;
  } catch (e) {
    flash = e instanceof Error ? e.message : String(e);
    flashErreur = true;
  }
}

if (formulaire && action === "archiver") {
  try {
    const { bandeaux } = await lireBandeaux(api);
    if (!bandeaux.some((b) => b.id === idDemande)) throw new Error("Ce bandeau n'existe plus.");
    await ecrireBandeaux(
      api,
      bandeaux.map((b) => (b.id === idDemande ? { ...b, archive: true } : b)),
    );
    return Astro.redirect(`${url("/bandeaux-visuels")}?ok=archive`);
  } catch (e) {
    flash = e instanceof Error ? e.message : String(e);
    flashErreur = true;
  }
}

/* ---- Ce qu'on affiche ------------------------------------------------- */

let liste: BandeauVisuel[] = [];
let repriseEncart = false;
let erreur: string | null = null;
try {
  ({ bandeaux: liste, repriseEncart } = await lireBandeaux(api));
} catch (e) {
  erreur = e instanceof Error ? e.message : String(e);
}
const enregistre = creation ? null : (liste.find((b) => b.id === idDemande) ?? null);
if (!creation && !enregistre && !erreur)
  return Astro.redirect(`${url("/bandeaux-visuels")}?ok=introuvable`);

const b: BandeauVisuel = saisie ?? enregistre ?? nouveauBandeau("nouveau");

const RETOURS: Record<string, string> = {
  cree: "Bandeau créé.",
  enregistre: "Bandeau enregistré.",
  duplique:
    "Copie créée, désactivée pour l'instant : réglez-la, puis cochez « Afficher ce bandeau ».",
};
if (!flash && RETOURS[Astro.url.searchParams.get("ok") ?? ""]) {
  flash = RETOURS[Astro.url.searchParams.get("ok") ?? ""] ?? null;
}

let collections: CollectionBo[] = [];
let pagesSite: ResumePage[] = [];
let listesIllisibles = false;
try {
  collections = (await api.collections()).collections;
} catch {
  listesIllisibles = true;
}
try {
  pagesSite = (await api.pages()).pages;
} catch {
  listesIllisibles = true;
}
const groupes = groupesDePages(collections, pagesSite, b.pages);

const etat = enregistre ? etatBandeau(enregistre) : null;
const pastille = etat ? PASTILLES[etat] : null;

/** L'adresse d'une image pour le navigateur du back-office. */
const urlImage = (chemin: string) => (chemin.startsWith("/") ? apiUrl(chemin) : chemin);

/** Une image trop étroite pour un grand écran : dit, pas interdit. */
const imageEtroite =
  enregistre?.miseEnPage === "banniere" &&
  !!enregistre.imageLargeur &&
  enregistre.imageLargeur < 1400;

const LIBELLES_POSITION: Record<PositionTexteBandeau, string> = {
  "haut-gauche": "En haut à gauche",
  "haut-centre": "En haut, au centre",
  "haut-droite": "En haut à droite",
  "milieu-gauche": "Au milieu, à gauche",
  "milieu-centre": "Au centre",
  "milieu-droite": "Au milieu, à droite",
  "bas-gauche": "En bas à gauche",
  "bas-centre": "En bas, au centre",
  "bas-droite": "En bas à droite",
};
const STYLES: Record<StyleTexteBandeau, { libelle: string; aide: string }> = {
  etiquette: {
    libelle: "Étiquette noire",
    aide: "Texte blanc sur fond noir, comme le bandeau de Noël.",
  },
  encadre: {
    libelle: "Encadré blanc",
    aide: "Texte foncé dans un cadre blanc : pour un texte plus long.",
  },
  ombre: {
    libelle: "Texte blanc ombré",
    aide: "Sans fond : l'image est assombrie du côté du texte.",
  },
};
const HAUTEURS: Record<HauteurBandeau, { libelle: string; aide: string }> = {
  petite: { libelle: "Petite", aide: "340 px sur ordinateur, 200 sur téléphone" },
  moyenne: { libelle: "Moyenne", aide: "480 px sur ordinateur, 280 sur téléphone" },
  grande: { libelle: "Grande", aide: "640 px sur ordinateur, 380 sur téléphone" },
  image: {
    libelle: "Celle de l'image",
    aide: "L'image entière, sans rien couper : ses proportions décident",
  },
};
---

<Admin title={creation ? "Nouveau bandeau visuel" : `Bandeau visuel : ${nomDuBandeau(b)}`}>
  <p class="mb-4 text-sm">
    <a href={url("/bandeaux-visuels")} class="text-bo-accent hover:underline">
      ← Tous les bandeaux visuels
    </a>
  </p>

  {
    flash && (
      <p
        class={`mb-4 max-w-5xl rounded border px-3 py-2 text-sm ${
          flashErreur
            ? "border-red-300 bg-red-50 text-red-800"
            : "border-green-300 bg-green-50 text-green-800"
        }`}
      >
        {flash}
      </p>
    )
  }
  {erreur && <p class="mb-4 text-sm text-red-600">API injoignable : {erreur}</p>}

  {
    pastille && enregistre && (
      <p class="mb-4 max-w-5xl text-sm">
        <span class={`mr-2 whitespace-nowrap rounded-full px-2 py-0.5 text-xs ${pastille.classe}`}>
          {pastille.libelle}
        </span>
        <span class="text-bo-muted">
          {pastille.aide} Période : {periode(enregistre)}.
        </span>
      </p>
    )
  }
  {
    repriseEncart && enregistre?.id === "encart-accueil" && (
      <p class="mb-4 max-w-5xl rounded border border-sky-100 bg-sky-100 px-3 py-2 text-sm text-sky-900">
        Ce bandeau reprend l'encart qui était réglé dans « Accueil et pied de
        page », tel qu'il s'affiche aujourd'hui. Vous pouvez le garder côte à
        côte ou le passer en bannière pleine largeur.
      </p>
    )
  }
  {
    imageEtroite && (
      <p class="mb-4 max-w-5xl rounded border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-900">
        L'image ne fait que {enregistre?.imageLargeur} px de large : sur un
        grand écran, elle est agrandie et paraît floue. Pour une bannière bord
        à bord, comptez 1920 px de large au moins, 2560 idéalement.
      </p>
    )
  }

  <div class="grid items-start gap-6 xl:grid-cols-[minmax(0,36rem)_minmax(0,1fr)]">
    <form method="POST" id="bv-formulaire" class="space-y-5 text-sm">
      <input type="hidden" name="_action" value="enregistrer" />

      {/* ------------------------------------------------------------ */}
      <fieldset class="rounded-lg border border-bo-border bg-bo-surface p-4">
        <legend class="px-2 font-semibold">L'image</legend>

        <div class="js-image space-y-2" data-role="ordinateur" data-min="1920" data-min-cote="1200">
          <span class="block font-medium">Image (obligatoire)</span>
          <p class="text-xs text-bo-muted">
            En JPEG ou WebP. Elle vaut pour les cinq langues.
            <span data-seulement="banniere">
              1920 px de large au moins (2560 idéalement), en longueur : par
              exemple 2560 × 800. <strong>Cliquez sur l'image</strong> pour
              choisir le point qui reste visible quand elle est recadrée — un
              visage, un titre dessiné dans l'image.
            </span>
            <span data-seulement="cote-a-cote">
              1200 px de large suffisent : elle occupe la moitié de la largeur
              de lecture, et s'affiche entière.
            </span>
          </p>
          <div
            class="js-cadre relative inline-block max-w-full cursor-crosshair"
            hidden={!b.image}
          >
            <img
              class="js-vignette block max-h-48 max-w-full border border-bo-border bg-bo-bg"
              src={b.image ? urlImage(b.image) : undefined}
              alt="Image du bandeau : cliquez pour choisir le point de cadrage"
            />
            <span
              class="js-point pointer-events-none absolute h-5 w-5 -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-white bg-red-600/80 shadow"
              style={`left:${b.cadrage.x}%;top:${b.cadrage.y}%`}
              aria-hidden="true"
              data-seulement="banniere"
            ></span>
          </div>
          <input
            type="file"
            accept="image/jpeg,image/png,image/webp"
            class="js-fichier block w-full text-xs"
            aria-label="Envoyer l'image du bandeau"
          />
          <input
            type="text"
            name="image"
            value={b.image}
            required
            placeholder="/assets/… (se remplit seul après l'envoi)"
            aria-label="Adresse de l'image"
            class="js-url w-full rounded border border-bo-border px-3 py-2 font-mono text-xs"
          />
          <input type="hidden" name="imageLargeur" class="js-largeur" value={b.imageLargeur ?? ""} />
          <input type="hidden" name="imageHauteur" class="js-hauteur" value={b.imageHauteur ?? ""} />
          <p class="js-etat text-xs text-bo-muted">
            Choisissez un fichier : il est envoyé tout de suite. Enregistrez
            ensuite pour le publier.
          </p>
          <div class="grid grid-cols-2 gap-3" data-seulement="banniere">
            <label class="block text-xs text-bo-muted">
              Cadrage horizontal
              <input
                type="range"
                name="cadrageX"
                min="0"
                max="100"
                value={b.cadrage.x}
                class="js-cadrage-x block w-full"
              />
            </label>
            <label class="block text-xs text-bo-muted">
              Cadrage vertical
              <input
                type="range"
                name="cadrageY"
                min="0"
                max="100"
                value={b.cadrage.y}
                class="js-cadrage-y block w-full"
              />
            </label>
          </div>
        </div>

        <div class="js-image mt-5 space-y-2 border-t border-bo-border pt-4" data-role="telephone" data-min="750" data-seulement="banniere">
          <span class="block font-medium">Image pour téléphone (facultative)</span>
          <p class="text-xs text-bo-muted">
            Sans elle, le téléphone montre l'image ci-dessus, recadrée autour
            de son point de cadrage. Une image en hauteur (par exemple
            1080 × 1200) y garde tout son dessin.
          </p>
          <div
            class="js-cadre relative inline-block max-w-full cursor-crosshair"
            hidden={!b.imageMobile}
          >
            <img
              class="js-vignette block max-h-48 max-w-full border border-bo-border bg-bo-bg"
              src={b.imageMobile ? urlImage(b.imageMobile) : undefined}
              alt="Image pour téléphone : cliquez pour choisir le point de cadrage"
            />
            <span
              class="js-point pointer-events-none absolute h-5 w-5 -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-white bg-red-600/80 shadow"
              style={`left:${b.cadrageMobile.x}%;top:${b.cadrageMobile.y}%`}
              aria-hidden="true"
            ></span>
          </div>
          <input
            type="file"
            accept="image/jpeg,image/png,image/webp"
            class="js-fichier block w-full text-xs"
            aria-label="Envoyer l'image pour téléphone"
          />
          <div class="flex gap-2">
            <input
              type="text"
              name="imageMobile"
              value={b.imageMobile}
              placeholder="Aucune : l'image ci-dessus, recadrée"
              aria-label="Adresse de l'image pour téléphone"
              class="js-url w-full rounded border border-bo-border px-3 py-2 font-mono text-xs"
            />
            <button
              type="button"
              class="js-retirer shrink-0 rounded border border-bo-border px-3 py-1 text-xs hover:bg-bo-bg"
            >
              Retirer
            </button>
          </div>
          <input type="hidden" name="imageMobileLargeur" class="js-largeur" value={b.imageMobileLargeur ?? ""} />
          <input type="hidden" name="imageMobileHauteur" class="js-hauteur" value={b.imageMobileHauteur ?? ""} />
          <p class="js-etat text-xs text-bo-muted"></p>
          <div class="grid grid-cols-2 gap-3">
            <label class="block text-xs text-bo-muted">
              Cadrage horizontal
              <input
                type="range"
                name="cadrageMobileX"
                min="0"
                max="100"
                value={b.cadrageMobile.x}
                class="js-cadrage-x block w-full"
              />
            </label>
            <label class="block text-xs text-bo-muted">
              Cadrage vertical
              <input
                type="range"
                name="cadrageMobileY"
                min="0"
                max="100"
                value={b.cadrageMobile.y}
                class="js-cadrage-y block w-full"
              />
            </label>
          </div>
        </div>

        <label class="mt-5 block border-t border-bo-border pt-4">
          <span class="font-medium">Description de l'image</span>
          <span class="mt-0.5 block text-xs text-bo-muted">
            Lue à voix haute aux personnes qui ne voient pas l'écran, et
            affichée si l'image ne charge pas : décrivez ce qu'on y voit
            (« Affiches de Noël encadrées sur un fond écossais »).
            Indispensable quand l'image mène à un lien sans aucun texte posé
            dessus.
          </span>
          <input
            name="alt"
