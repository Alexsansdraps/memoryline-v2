---
import Admin from "../layouts/Admin.astro";
import OrderStats from "../components/OrderStats.astro";
import OrderTable from "../components/OrderTable.astro";
import { adminApi, formatPrice, type StandBo } from "../lib/api.ts";
import { url } from "../lib/url.ts";

const api = adminApi(Astro.request);

/**
 * L'API refuse en français et dit pourquoi (« ce stand a des commandes »).
 * Quand elle ne renvoie qu'un code technique, il n'apprend rien à personne
 * ici : on ne le montre pas, l'appelant met sa propre phrase à la place.
 */
function raisonLisible(souci: unknown): string {
  const brut = (souci instanceof Error ? souci.message : String(souci))
    .replace(/^Error:\s*/, "")
    .trim();
  return brut.startsWith("API ") ? "" : brut;
}

/** « 1 commande », « 3 commandes » : le « (s) » se lit mal. */
const pluriel = (nombre: number, mot: string) =>
  `${nombre} ${mot}${nombre > 1 ? "s" : ""}`;

let flash: string | null = null;
let flashAlerte = false;
/**
 * Le stand qui vient d'être ouvert, ou dont le code vient de changer. Son
 * code est ce qu'on cherche à la seconde même : il s'affiche en grand, sans
 * avoir à le retrouver dans la liste.
 */
let nouveaute: { id: number; nom: string; code: string } | null = null;

if (Astro.request.method === "POST") {
  // La liste des commandes, plus bas, relit le corps de la requête pour ses
  // propres boutons. Un corps ne se lit qu'une fois : on travaille sur une
  // copie et on lui laisse l'original.
  const champs = await Astro.request.clone().formData();
  const texte = (nom: string) => String(champs.get(nom) ?? "").trim();
  const action = texte("_action");
  const numero = Number(texte("id"));
  // Sans identifiant, le formulaire ne désigne aucun stand : mieux vaut ne
  // rien faire que d'agir sur le voisin.
  const cible = Number.isInteger(numero) && numero > 0 ? numero : 0;

  try {
    if (action === "creer") {
      const { stand } = await api.creerStand({
        nom: texte("nom"),
        ouvert: texte("ouvrir") === "1",
      });
      nouveaute = { id: stand.id, nom: stand.nom, code: stand.code };
      flash = stand.ouvert
        ? `Stand « ${stand.nom} » ouvert : la tablette peut prendre des commandes.`
        : `Stand « ${stand.nom} » créé. Il est encore fermé, ouvrez-le quand le salon commence.`;
    } else if (cible) {
      switch (action) {
        case "etat": {
          const { stand } = await api.majStand(cible, {
            ouvert: texte("ouvrir") === "1",
          });
          flash = stand.ouvert
            ? `Stand « ${stand.nom} » ouvert : la tablette peut prendre des commandes.`
            : `Stand « ${stand.nom} » fermé. Ses ventes restent comptées, et vous pourrez le rouvrir.`;
          break;
        }
        case "renommer": {
          const { stand } = await api.majStand(cible, { nom: texte("nom") });
          flash = `Ce stand s'appelle maintenant « ${stand.nom} ».`;
          break;
        }
        case "code": {
          const { stand } = await api.majStand(cible, { nouveauCode: true });
          nouveaute = { id: stand.id, nom: stand.nom, code: stand.code };
          flash = `Nouveau code pour « ${stand.nom} ». L'adresse précédente ne fonctionne plus : ouvrez la nouvelle sur la tablette.`;
          break;
        }
        case "archiver": {
          const restaurer = texte("archived") === "false";
          const { commandes } = await api.archiverStand(cible, !restaurer);
          const nom = texte("libelle") || "Ce stand";
          flash = restaurer
            ? `Stand « ${nom} » restauré. Il revient dans la liste, fermé : ouvrez-le le jour du salon.`
            : `Stand « ${nom} » archivé et fermé.${
                commandes > 0
                  ? ` Ses ${pluriel(commandes, "vente")} gardent son nom et restent comptées.`
                  : ""
              } Vous pouvez le restaurer à tout moment, plus bas.`;
          break;
        }
      }
    }
  } catch (souci) {
    flash =
      raisonLisible(souci) || "L'action n'a pas abouti. Réessayez dans un instant.";
    flashAlerte = true;
  }
}

// Les stands sont lus APRÈS le formulaire : la page montre ainsi l'état
// d'après le clic, pas celui d'avant.
let stands: StandBo[] = [];
let orphelines = { commandes: 0, cents: 0 };
let erreur: string | null = null;
try {
  const tout = await api.stands();
  stands = tout.stands;
  orphelines = tout.orphelines;
} catch (souci) {
  erreur =
    raisonLisible(souci) ||
    "La liste des stands n'a pas pu être chargée. Réessayez dans un instant.";
}

// Les archivés quittent la liste ordinaire pour leur propre section.
const actifs = stands.filter((s) => !s.archivedAt);
const archives = stands.filter((s) => s.archivedAt);

const ouverts = actifs.filter((s) => s.ouvert).length;

/** Ce qu'il faut avoir lu avant d'archiver un stand. */
function messageArchivage(stand: StandBo): string {
  return [
    `Archiver le stand « ${stand.nom} » ?`,
    stand.commandes > 0
      ? `Il sera fermé et quittera la liste. Ses ${pluriel(stand.commandes, "vente")} ne bougent pas : elles gardent son nom et restent comptées dans vos chiffres.`
      : "Il sera fermé et quittera la liste. Son adresse ne répondra plus.",
    "Vous pourrez le restaurer quand vous voudrez, dans « Stands archivés ».",
  ].join("\n\n");
}

/**
 * Origine publique de la boutique, jamais écrite en dur : l'environnement
 * l'annonce (elle change à chaque tunnel de test), et à défaut la requête en
 * cours la porte — le back-office et la boutique passent par le même proxy,
 * donc l'adresse qui affiche cet écran est déjà la bonne.
 */
function originePublique(): string {
  const annoncee: unknown =
    import.meta.env.PUBLIC_SITE_URL ?? import.meta.env.PUBLIC_ORIGIN;
  if (typeof annoncee === "string" && annoncee.trim())
    return annoncee.trim().replace(/\/+$/, "");
  const entetes = Astro.request.headers;
  const hote = entetes.get("x-forwarded-host") ?? entetes.get("host");
  const protocole =
    entetes.get("x-forwarded-proto") ?? Astro.url.protocol.replace(":", "");
  return hote ? `${protocole}://${hote}` : Astro.url.origin;
}

const origine = originePublique();
/**
 * L'adresse à ouvrir sur la tablette : le code y est déjà, rien à taper.
 *
 * C'est le SITE, en mode stand — mêmes pages, sans aucun prix, et seule la
 * dernière étape change : nom, adresse e-mail et « Valider mes affiches » au
 * lieu du paiement. La tablette range le code et l'ôte de la barre d'adresse
 * dès la première page. L'ancienne adresse « /stand?code=… » y mène encore.
 */
const adresseDe = (code: string) =>
  `${origine}/?stand=1&code=${encodeURIComponent(code)}`;

/**
 * Le stand qu'on regarde de près, porté par l'adresse : le filtre survit à un
 * rechargement, se met en favori, et suit les onglets de la liste en dessous.
 */
const demande = Number(Astro.url.searchParams.get("stand") ?? "");
const standChoisi =
  Number.isInteger(demande) && demande > 0 ? demande : undefined;
const standFiltre = standChoisi
  ? stands.find((s) => s.id === standChoisi)
  : undefined;

/** L'adresse courante avec, ou sans, le filtre d'un stand. Le reste est gardé. */
function lienStand(id: number | null): string {
  const p = new URLSearchParams(Astro.url.searchParams);
  if (id === null) p.delete("stand");
  else p.set("stand", String(id));
  const qs = p.toString();
  return url(`/ventes-salon${qs ? `?${qs}` : ""}`);
}

/** « 3 février 2026 », pour situer un salon dans l'année. */
function jour(iso: string | null): string {
  if (!iso) return "";
  const d = new Date(iso);
  return Number.isNaN(d.getTime())
    ? ""
    : d.toLocaleDateString("fr-FR", {
        day: "numeric",
        month: "long",
        year: "numeric",
      });
}

/** La date qui situe le stand : sa dernière fermeture, sinon sa création. */
function dateDite(stand: StandBo): string {
  const ferme = !stand.ouvert && stand.closedAt ? jour(stand.closedAt) : "";
  if (ferme) return `Fermé le ${ferme}.`;
  const cree = jour(stand.createdAt);
  return cree ? `Créé le ${cree}.` : "";
}

const classeBouton =
  "rounded border border-bo-border px-3 py-1.5 hover:bg-bo-bg";
---

<Admin title="Ventes stand">
  {
    flash && (
      <p
        class={`mb-4 rounded border px-3 py-2 text-sm ${
          flashAlerte
            ? "border-amber-200 bg-amber-50 text-amber-900"
            : "border-green-200 bg-green-50 text-green-900"
        }`}
      >
        {flash}
      </p>
    )
  }

  {/* Le code tiré à l'instant, en grand : c'est la seule chose qu'on cherche
      juste après avoir ouvert un stand ou renouvelé son adresse. */}
  {
    nouveaute && (
      <section class="mb-4 rounded-lg border border-green-200 bg-green-50 p-4 text-green-900">
        <p class="text-sm">
          Code d'accès de « {nouveaute.nom} », à lire à la vendeuse :
        </p>
        <p class="mt-1 font-mono text-3xl font-bold tracking-[0.25em]">
          {nouveaute.code}
        </p>
        <div class="mt-3 flex flex-wrap items-center gap-2 text-sm">
          <code class="rounded border border-green-200 px-2 py-1 font-mono text-xs break-all">
            {adresseDe(nouveaute.code)}
          </code>
          <button
            type="button"
            data-adresse={adresseDe(nouveaute.code)}
            class="rounded border border-green-200 px-2 py-1 text-xs hover:bg-green-100"
          >
            Copier l'adresse
          </button>
          <a
            href={adresseDe(nouveaute.code)}
            target="_blank"
            rel="noopener"
            class="rounded border border-green-200 px-2 py-1 text-xs hover:bg-green-100"
          >
            Ouvrir
          </a>
          <span class="copie-ok text-xs" />
        </div>
      </section>
    )
  }

  {
    erreur && (
      <p class="mb-4 rounded border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-700">
        {erreur}
      </p>
    )
  }

  <div class="mb-3 flex flex-wrap items-baseline justify-between gap-2">
    <h2 class="text-base font-semibold">Vos stands</h2>
    <p class="text-sm text-bo-muted">
      {
        stands.length === 0
          ? ""
          : ouverts === 0
            ? "Aucun stand ouvert en ce moment."
            : `${pluriel(ouverts, "stand")} ${ouverts > 1 ? "ouverts" : "ouvert"} en ce moment.`
      }
    </p>
  </div>

  {
    ouverts > 0 && (
      <p class="mb-3 rounded border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-900">
        Tant qu'un stand est ouvert, toute personne qui connaît son adresse
        peut commander sans rien payer. Fermez-le à la fin du salon.
      </p>
    )
  }

  <div class="grid gap-4">
    {
      actifs.map((stand) => (
        <article
          id={`stand-${stand.id}`}
          class={`rounded-lg border bg-bo-surface p-5 ${
            nouveaute?.id === stand.id
              ? "border-green-300 ring-1 ring-green-300"
              : "border-bo-border"
          }`}
        >
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
              <div class="flex flex-wrap items-center gap-3">
                {/* Le nom mène aux ventes du stand : c'est le geste qu'on
                    fait d'instinct, cliquer sur ce dont on veut le détail. */}
                <h3 class="text-base font-semibold">
                  <a
                    href={`${url("/ventes-salon")}?stand=${stand.id}`}
                    class="hover:text-bo-accent hover:underline"
                  >
                    {stand.nom}
                  </a>
                </h3>
                <span
                  class={`inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-xs font-medium ${
                    stand.ouvert
                      ? "bg-green-100 text-green-900"
                      : "bg-bo-bg text-bo-muted"
                  }`}
                >
                  <span
                    class={`h-2 w-2 rounded-full ${
                      stand.ouvert ? "bg-green-600" : "bg-bo-muted"
                    }`}
                  />
                  {stand.ouvert ? "Ouvert" : "Fermé"}
                </span>
              </div>
              <p class="mt-1 text-xs text-bo-muted">{dateDite(stand)}</p>
            </div>

            {/* Ouvrir et fermer se font sans confirmation : le geste se refait
                dans l'autre sens et ne coûte rien. */}
            <form method="POST">
              <input type="hidden" name="_action" value="etat" />
              <input type="hidden" name="id" value={stand.id} />
              <input
                type="hidden"
                name="ouvrir"
                value={stand.ouvert ? "0" : "1"}
              />
              <button
                class={
                  stand.ouvert
                    ? "rounded border border-bo-border px-4 py-1.5 text-sm hover:bg-bo-bg"
                    : "rounded bg-bo-accent px-4 py-1.5 text-sm text-white hover:opacity-90"
                }
              >
                {stand.ouvert ? "Fermer le stand" : "Ouvrir le stand"}
              </button>
            </form>
          </div>

          <div class="mt-4 grid gap-5 md:grid-cols-2">
            <div>
              <span class="text-xs text-bo-muted">Code d'accès</span>
              <p class="mt-1">
                <strong class="inline-block rounded border border-bo-border bg-bo-bg px-3 py-1.5 font-mono text-2xl tracking-[0.25em]">
                  {stand.code}
                </strong>
              </p>
              <div class="mt-2 flex flex-wrap items-center gap-2">
                <code class="rounded border border-bo-border bg-bo-bg px-2 py-1 font-mono text-xs break-all">
                  {adresseDe(stand.code)}
                </code>
                <button
                  type="button"
                  data-adresse={adresseDe(stand.code)}
                  class="rounded border border-bo-border px-2 py-1 text-xs hover:bg-bo-bg"
                >
                  Copier
                </button>
                <a
                  href={adresseDe(stand.code)}
                  target="_blank"
                  rel="noopener"
                  class="rounded border border-bo-border px-2 py-1 text-xs hover:bg-bo-bg"
                >
                  Ouvrir
                </a>
                <span class="copie-ok text-xs text-bo-muted" />
              </div>
              <p class="mt-1 text-xs text-bo-muted">
                À ouvrir sur la tablette : c'est le site, sans aucun prix, et le
                code est déjà dans l'adresse — il n'y a rien à taper.
              </p>
            </div>

            <div>
              <span class="text-xs text-bo-muted">Ventes de ce stand</span>
              {stand.commandes > 0 ? (
                <>
                  <p class="mt-1 text-xl font-semibold">
                    {formatPrice(stand.cents)}
                  </p>
                  <p class="text-sm text-bo-muted">
                    {pluriel(stand.commandes, "commande")}, paniers en cours
                    exclus.
                  </p>
                  <a
                    href={lienStand(stand.id)}
                    class="mt-1 inline-block text-sm text-bo-accent hover:underline"
                  >
                    Voir les commandes de ce stand
                  </a>
                </>
              ) : (
                <p class="mt-1 text-sm text-bo-muted">
                  Aucune vente pour l'instant.
                </p>
              )}
            </div>
          </div>

          <div class="mt-4 flex flex-wrap items-center gap-2 border-t border-bo-border pt-3 text-sm">
            <form method="POST" data-renommer>
              <input type="hidden" name="_action" value="renommer" />
              <input type="hidden" name="id" value={stand.id} />
              <input type="hidden" name="nom" value={stand.nom} />
              <button type="button" class={classeBouton}>
                Renommer
              </button>
            </form>

            <form
              method="POST"
              data-confirme={`Tirer un nouveau code pour « ${stand.nom} » ? L'adresse actuelle cessera de fonctionner : la tablette devra ouvrir la nouvelle. À faire après un salon, ou si le code a circulé plus loin que prévu.`}
            >
              <input type="hidden" name="_action" value="code" />
              <input type="hidden" name="id" value={stand.id} />
              <button class={classeBouton}>Nouveau code</button>
            </form>

            <form method="POST" data-confirme={messageArchivage(stand)}>
              <input type="hidden" name="_action" value="archiver" />
              <input type="hidden" name="id" value={stand.id} />
              <input type="hidden" name="libelle" value={stand.nom} />
              <input type="hidden" name="archived" value="true" />
              <button class={classeBouton}>Archiver</button>
            </form>
          </div>
        </article>
      ))
    }

    {
      actifs.length === 0 && !erreur && (
        <p class="rounded-lg border border-bo-border bg-bo-surface p-5 text-sm text-bo-muted">
          Aucun stand pour l'instant. Ouvrez le premier ci-dessous : son code
          d'accès sera tiré au sort à ce moment-là.
        </p>
      )
    }
  </div>

  {/* ==================================================================== */}
  {/* Les stands archivés                                                  */}
  {/* ==================================================================== */}
  {archives.length > 0 && (
    <section class="mt-6">
      <h2 class="mb-1 text-base font-semibold">Stands archivés</h2>
      <p class="mb-3 max-w-3xl text-xs text-bo-muted">
        Retirés de la liste ci-dessus, fermés, leur adresse ne répond plus.
        Leurs ventes n'ont pas bougé : elles gardent leur nom et restent
        comptées. « Restaurer » remet le stand dans la liste, toujours fermé.
      </p>
      <div class="grid gap-2 opacity-70">
        {archives.map((stand) => (
          <article id={`stand-${stand.id}`} class="flex flex-wrap items-center gap-4 rounded-lg border border-bo-border bg-bo-surface p-4">
            <div class="min-w-48 flex-1">
              <p class="font-medium">{stand.nom}</p>
              <p class="text-xs text-bo-muted">
                {stand.commandes > 0
                  ? `${pluriel(stand.commandes, "vente")} · ${formatPrice(stand.cents)}`
                  : "Aucune vente"}
              </p>
            </div>
            {stand.commandes > 0 && (
              <a
                href={`${url("/ventes-salon")}?stand=${stand.id}`}
                class="text-sm text-bo-accent hover:underline"
              >
                Voir ses commandes
              </a>
            )}
            <form method="POST">
              <input type="hidden" name="_action" value="archiver" />
              <input type="hidden" name="id" value={stand.id} />
              <input type="hidden" name="libelle" value={stand.nom} />
              <input type="hidden" name="archived" value="false" />
              <button class="text-sm text-bo-accent hover:underline">
                Restaurer
              </button>
            </form>
          </article>
        ))}
      </div>
    </section>
  )}

  {/* Pas d'ouverture de stand quand on en regarde un : on est venu voir les
      ventes de celui-là, un formulaire de création à côté se lit comme s'il
      allait le modifier. On revient à la liste pour en ouvrir un autre. */}
  {!standChoisi && (
  <section class="mt-6 rounded-lg border border-bo-border bg-bo-surface p-5">
    <h2 class="text-base font-semibold">Ouvrir un nouveau stand</h2>
    <form method="POST" class="mt-3 flex flex-wrap items-end gap-3 text-sm">
      <input type="hidden" name="_action" value="creer" />
      <label class="min-w-[260px] flex-1">
        <span class="mb-1 block text-xs text-bo-muted">Nom du stand</span>
        <input
          type="text"
          name="nom"
          required
          maxlength="120"
          placeholder="Salon du livre de Nantes 2026"
          class="w-full rounded border border-bo-border px-3 py-2"
        />
      </label>
      <label class="flex items-center gap-2 py-2">
        <input type="checkbox" name="ouvrir" value="1" checked />
        Ouvrir tout de suite
      </label>
      <button class="rounded bg-bo-accent px-4 py-2 text-white hover:opacity-90">
        Ouvrir le stand
      </button>
    </form>
    <p class="mt-2 text-xs text-bo-muted">
      Le nom est ce que vous chercherez des mois plus tard pour savoir quel
      salon a bien marché : mettez la ville et l'année. Le code d'accès, lui,
      est tiré au sort ici même, en six caractères sans les lettres qu'on
      confondrait avec des chiffres.
    </p>
    <ul
      class="mt-4 flex flex-wrap gap-x-6 gap-y-1 border-t border-bo-border pt-4 text-xs text-bo-muted"
    >
      <li>Aucun prix à l'écran, c'est vous qui l'annoncez.</li>
      <li>Aucun paiement en ligne, on règle sur place.</li>
      <li>Une commande se valide avec un nom et une adresse e-mail, pour toutes les affiches du client d'un coup.</li>
      <li>Un stand qui a vendu se ferme et se rouvre, il ne se supprime pas.</li>
    </ul>
  </section>
  )}

  {
    orphelines.commandes > 0 && (
      <p class="mt-6 text-xs text-bo-muted">
        Ventes prises au stand du temps où la boutique n'en tenait qu'un seul,
        et qui ne sont rattachées à aucun de ceux d'aujourd'hui :
        {" "}{pluriel(orphelines.commandes, "commande")},
        {" "}{formatPrice(orphelines.cents)}. Tout cela reste compté dans vos
        chiffres et figure dans la liste ci-dessous.
      </p>
    )
  }

  <h2 class="mt-8 mb-1 text-base font-semibold">Commandes prises au stand</h2>
  <p class="mb-4 text-sm text-bo-muted">
    Réglées sur place, à imprimer et à préparer.
  </p>

  {
    standChoisi && (
      <p class="mb-4 flex flex-wrap items-center gap-2 rounded border border-bo-border bg-bo-bg px-3 py-2 text-sm">
        <span>
          {standFiltre
            ? `Vous ne voyez que les commandes du stand « ${standFiltre.nom} ».`
            : "Vous ne voyez que les commandes d'un stand qui n'est plus dans la liste."}
        </span>
        <a href={lienStand(null)} class="text-bo-accent hover:underline">
          Voir toutes les ventes de stand
        </a>
      </p>
    )
  }

  {/* Les chiffres suivent le stand regardé et disent lequel : au-dessus d'une
      liste filtrée, un total qui compterait autre chose se lirait comme le
      sien. */}
  {/* Les chiffres suivent le stand choisi, et disent lequel. Les cacher dès
      qu'on en choisit un privait justement du chiffre qu'on venait chercher. */}
  <OrderStats
    channel="salon"
    stand={standChoisi}
    portee={standFiltre ? standFiltre.nom : "tous les stands"}
  />
  <OrderTable channel="salon" stand={standChoisi} />

  <script is:inline>
    // Il y a un bouton par stand, et la liste change à chaque salon : on écoute
    // la page une fois pour toutes plutôt que chaque bouton un à un.
    document.addEventListener("click", async (evenement) => {
      const cible = evenement.target;
      const bouton =
        cible instanceof Element ? cible.closest("[data-adresse]") : null;
      if (!bouton) return;
      const adresse = bouton.getAttribute("data-adresse") || "";
      const dit = bouton.parentElement?.querySelector(".copie-ok");
      try {
        await navigator.clipboard.writeText(adresse);
        if (dit) dit.textContent = "Adresse copiée.";
      } catch {
        // Presse-papiers refusé (page non sécurisée, permission) : on montre
        // l'adresse pour qu'elle reste copiable à la main.
        if (dit) dit.textContent = "Copie refusée par le navigateur.";
        window.prompt("Adresse du stand :", adresse);
      }
    });

    // Renommer demande le nouveau nom et dit, dans la même phrase, jusqu'où va
    // le changement.
    document.addEventListener("click", (evenement) => {
      const cible = evenement.target;
      const formulaire =
        cible instanceof Element ? cible.closest("form[data-renommer]") : null;
      if (!formulaire) return;
      const champ = formulaire.querySelector("input[name='nom']");
      if (!champ) return;
      const saisi = window.prompt(
        "Nouveau nom de ce stand. Il apparaîtra partout, y compris sur les ventes déjà prises ici.",
        champ.value,
      );
      if (saisi === null) return;
      const propre = saisi.trim();
      if (!propre || propre === champ.value) return;
      champ.value = propre;
      formulaire.submit();
    });

    // Ce qui coupe une adresse ou efface un stand s'annonce avant de partir.
    document.addEventListener("submit", (evenement) => {
      const formulaire = evenement.target;
      const question =
        formulaire instanceof Element
          ? formulaire.getAttribute("data-confirme")
          : null;
      if (question && !window.confirm(question)) evenement.preventDefault();
    });
  </script>
</Admin>
