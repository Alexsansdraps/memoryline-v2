---
import Admin from "../layouts/Admin.astro";
import OrderStats from "../components/OrderStats.astro";
import OrderTable from "../components/OrderTable.astro";
import { adminApi } from "../lib/api.ts";

const api = adminApi(Astro.request);

/**
 * Alphabet du code d'accès : ni O/0 ni I/1. Le code se lit à voix haute puis
 * se tape sur une tablette entre deux clients — une confusion, et c'est la
 * file d'attente qui patiente.
 */
const ALPHABET = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789";
function tirerCode(): string {
  const octets = crypto.getRandomValues(new Uint8Array(6));
  return Array.from(octets, (o) => ALPHABET.charAt(o % ALPHABET.length)).join("");
}

let reglages: Record<string, unknown> = {};
let erreur: string | null = null;
try {
  // La route protégée, pas /settings : celle-ci est publique et ne livre
  // plus le code du stand à personne.
  const stand = await api.salon();
  reglages = {
    "salon.code": stand.code,
    "salon.evenement": stand.evenement,
    "salon.ouvert": stand.ouvert ? "1" : "0",
  };
} catch (e) {
  erreur = String(e);
}

/**
 * Valeur d'un réglage, chaîne vide s'il n'a jamais été enregistré. Les
 * réglages sont stockés en JSON : « 1 » en ressort tantôt en texte, tantôt en
 * nombre. On ramène tout au texte, comme le fait l'API de son côté.
 */
const valeur = (cle: string) => {
  const v = reglages[cle];
  return v === undefined || v === null ? "" : String(v).trim();
};

let flash: string | null = null;
let flashAlerte = false;
if (Astro.request.method === "POST") {
  const f = await Astro.request.formData();
  try {
    switch (String(f.get("action") ?? "")) {
      case "code": {
        const nouveau = tirerCode();
        await api.setSetting("salon.code", nouveau);
        reglages["salon.code"] = nouveau;
        flash = `Nouveau code : ${nouveau}. L'adresse précédente ne fonctionne plus.`;
        break;
      }
      case "evenement": {
        const nom = String(f.get("evenement") ?? "").trim();
        await api.setSetting("salon.evenement", nom);
        reglages["salon.evenement"] = nom;
        flash = nom
          ? `Événement en cours : ${nom}.`
          : "Nom de l'événement effacé.";
        break;
      }
      case "etat": {
        const ouvrir = f.get("ouvrir") === "1";
        // Sans code, l'API refuse les commandes de toute façon : autant le
        // dire ici plutôt que d'afficher un stand ouvert qui ne prend rien.
        if (ouvrir && !valeur("salon.code")) {
          flash = "Tirez d'abord un code d'accès : sans code, le stand reste fermé.";
          flashAlerte = true;
          break;
        }
        await api.setSetting("salon.ouvert", ouvrir ? "1" : "0");
        reglages["salon.ouvert"] = ouvrir ? "1" : "0";
        flash = ouvrir
          ? "Stand ouvert : la tablette prend des commandes."
          : "Stand fermé : plus aucune commande n'est acceptée.";
        break;
      }
    }
  } catch (e) {
    flash = "Erreur : " + String(e);
    flashAlerte = true;
  }
}

const code = valeur("salon.code");
const evenement = valeur("salon.evenement");
/** Même règle que l'API : sans code, le stand est fermé quoi que dise le réglage. */
const ouvert = valeur("salon.ouvert") === "1" && code !== "";

/**
 * Origine publique de la boutique, jamais écrite en dur : l'environnement
 * l'annonce (elle change à chaque tunnel de test), et à défaut la requête en
 * cours la porte — le back-office et la boutique passent par le même proxy,
 * donc l'adresse qui affiche cet écran est déjà la bonne.
 */
function originePublique(): string {
  const annoncee: unknown =
    import.meta.env.PUBLIC_SITE_URL ?? import.meta.env.PUBLIC_ORIGIN;
  if (typeof annoncee === "string" && annoncee.trim())
    return annoncee.trim().replace(/\/+$/, "");
  const entetes = Astro.request.headers;
  const hote = entetes.get("x-forwarded-host") ?? entetes.get("host");
  const protocole =
    entetes.get("x-forwarded-proto") ?? Astro.url.protocol.replace(":", "");
  return hote ? `${protocole}://${hote}` : Astro.url.origin;
}

const adresseStand = code
  ? `${originePublique()}/salon?code=${encodeURIComponent(code)}`
  : "";

/** Les deux côtés de l'interrupteur : celui en vigueur est plein. */
const classeInterrupteur = (actif: boolean) =>
  `px-4 py-1.5 ${
    actif ? "bg-bo-accent text-white" : "text-bo-muted hover:bg-bo-bg"
  } disabled:cursor-not-allowed disabled:opacity-40`;
---

<Admin title="Ventes salon">
  {flash && (
    <p
      class={`mb-4 rounded border px-3 py-2 text-sm ${
        flashAlerte
          ? "border-amber-200 bg-amber-50 text-amber-900"
          : "border-green-200 bg-green-50"
      }`}
    >
      {flash}
    </p>
  )}
  {erreur && (
    <p class="mb-4 text-sm text-red-600">Réglages injoignables : {erreur}</p>
  )}

  <section class="mb-8 rounded-lg border border-bo-border bg-bo-surface p-5">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <h2 class="text-base font-semibold">Le stand</h2>
        <span
          class={`inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-xs font-medium ${
            ouvert ? "bg-green-100 text-green-900" : "bg-bo-bg text-bo-muted"
          }`}
        >
          <span
            class={`h-2 w-2 rounded-full ${ouvert ? "bg-green-600" : "bg-bo-muted"}`}
          ></span>
          {ouvert ? "Ouvert" : "Fermé"}
        </span>
      </div>
      <form
        method="POST"
        class="inline-flex overflow-hidden rounded-lg border border-bo-border text-sm"
      >
        <input type="hidden" name="action" value="etat" />
        <button name="ouvrir" value="0" class={classeInterrupteur(!ouvert)}>
          Fermé
        </button>
        <button
          name="ouvrir"
          value="1"
          disabled={!code}
          title={code ? undefined : "Tirez d'abord un code d'accès."}
          class={classeInterrupteur(ouvert)}
        >
          Ouvert
        </button>
      </form>
    </div>

    {
      ouvert ? (
        <p class="mt-3 rounded border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-900">
          Tant que le stand est ouvert, toute personne qui connaît l'adresse
          peut commander sans rien payer. Fermez-le à la fin du salon.
        </p>
      ) : (
        <p class="mt-3 rounded border border-bo-border bg-bo-bg px-3 py-2 text-sm text-bo-muted">
          Aucune commande n'est acceptée : l'adresse du stand répond « stand
          fermé ». C'est l'état normal entre deux salons.
        </p>
      )
    }

    <div class="mt-5 grid gap-5 text-sm md:grid-cols-2">
      <form method="POST">
        <input type="hidden" name="action" value="evenement" />
        <label class="block">
          <span class="text-bo-muted">Événement en cours</span>
          <input
            type="text"
            name="evenement"
            value={evenement}
            placeholder="Salon du livre de Nantes 2026"
            class="mt-1 w-full rounded border border-bo-border px-3 py-2"
          />
        </label>
        <p class="mt-1 text-xs text-bo-muted">
          Recopié en note et en étiquette sur chaque commande prise au stand :
          c'est ce qu'on cherche des mois plus tard pour savoir quel salon a
          bien marché.
        </p>
        <button
          class="mt-2 rounded bg-bo-accent px-4 py-2 text-white hover:opacity-90"
        >
          Enregistrer
        </button>
      </form>

      <form method="POST">
        <input type="hidden" name="action" value="code" />
        <span class="text-bo-muted">Code d'accès</span>
        <div class="mt-1 flex flex-wrap items-center gap-3">
          <strong
            class="rounded border border-bo-border bg-bo-bg px-3 py-2 font-mono text-lg tracking-[0.25em]"
            >{code || "—"}</strong
          >
          <button class="rounded border border-bo-border px-3 py-2 hover:bg-bo-bg">
            Tirer un nouveau code
          </button>
        </div>
        <p class="mt-1 text-xs text-bo-muted">
          Six caractères, sans O ni I qu'on confondrait avec 0 et 1. En tirer
          un nouveau coupe l'ancienne adresse : à faire après le salon, pas
          pendant.
        </p>
      </form>
    </div>

    <div class="mt-5 border-t border-bo-border pt-4 text-sm">
      <span class="text-bo-muted">Adresse du stand</span>
      {
        adresseStand ? (
          <div class="mt-1 flex flex-wrap items-center gap-2">
            <code class="rounded border border-bo-border bg-bo-bg px-3 py-2 font-mono break-all">
              {adresseStand}
            </code>
            <button
              type="button"
              id="copier-adresse"
              data-adresse={adresseStand}
              class="rounded border border-bo-border px-3 py-2 hover:bg-bo-bg"
            >
              Copier
            </button>
            <a
              href={adresseStand}
              target="_blank"
              rel="noopener"
              class="rounded border border-bo-border px-3 py-2 hover:bg-bo-bg"
            >
              Ouvrir
            </a>
            <span id="copie-ok" class="text-xs text-bo-muted" />
          </div>
        ) : (
          <p class="mt-1 text-bo-muted">
            Tirez un code : l'adresse du stand se construit avec lui.
          </p>
        )
      }
      <p class="mt-1 text-xs text-bo-muted">
        À ouvrir sur la tablette du stand : le code est déjà dans l'adresse,
        il n'y a rien à taper.
      </p>
    </div>

    <ul
      class="mt-4 flex flex-wrap gap-x-6 gap-y-1 border-t border-bo-border pt-4 text-xs text-bo-muted"
    >
      <li>Aucun prix à l'écran — c'est vous qui l'annoncez.</li>
      <li>Aucun paiement en ligne — on règle sur place.</li>
      <li>Une commande se valide avec un nom et une adresse e-mail.</li>
    </ul>
  </section>

  <h2 class="mb-1 text-base font-semibold">Commandes prises au stand</h2>
  <p class="mb-4 text-sm text-bo-muted">
    À encaisser sur place, puis à imprimer et préparer.
  </p>
  <OrderStats channel="salon" />
  <OrderTable channel="salon" />

  <script is:inline>
    document
      .getElementById("copier-adresse")
      ?.addEventListener("click", async (e) => {
        const adresse = e.currentTarget.getAttribute("data-adresse") || "";
        const dit = document.getElementById("copie-ok");
        try {
          await navigator.clipboard.writeText(adresse);
          dit.textContent = "Copiée.";
        } catch {
          // Presse-papiers refusé (page non sécurisée, permission) : on la
          // montre pour qu'elle reste copiable à la main.
          dit.textContent = "Copie refusée par le navigateur.";
          window.prompt("Adresse du stand :", adresse);
        }
      });
  </script>
</Admin>
