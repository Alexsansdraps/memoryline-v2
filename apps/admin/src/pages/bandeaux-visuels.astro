---
/**
 * Les bandeaux visuels — la « bannière avec image » de l'ancienne boutique
 * Shopify : une grande image en haut d'une page, avec un texte, un bouton ou
 * un lien. L'écran de la liste : ce qui existe, où et quand chacun s'affiche,
 * dans quel ordre.
 *
 * L'ORDRE DE LA LISTE EST CELUI DU SITE. Deux bandeaux sur la même page s'y
 * empilent dans cet ordre-ci ; les flèches le changent. C'est le seul
 * tableau du back-office dont l'ordre affiché compte : il ne se trie donc pas
 * en cliquant sur les colonnes (data-sans-tri).
 *
 * Chaque geste relit la liste en base avant de l'écrire (lib/bandeaux-
 * visuels.ts), puis revient ici par une redirection : actualiser la page ne
 * refait pas monter un bandeau d'un cran de plus.
 *
 * Un bandeau ARCHIVÉ peut être supprimé définitivement : il sort de la liste
 * enregistrée, avec ses textes et ses traductions. Toute la liste tient dans
 * un seul réglage, réécrit d'un coup : il n'y a ni route à part ni
 * transaction à ouvrir, et rien d'autre ne pointe vers un bandeau. Son image
 * reste sur le disque (elle peut servir ailleurs). La règle commune
 * (apps/api/src/suppression.ts) est appliquée ici : un bandeau qui n'est pas
 * archivé est refusé.
 */
import Admin from "../layouts/Admin.astro";
import { adminApi, type CollectionBo, type ResumePage } from "../lib/api.ts";
import { apiUrl, url } from "../lib/url.ts";
import {
  PASTILLES,
  ecrireBandeaux,
  libellePage,
  lireBandeaux,
  nomDuBandeau,
  nouvelId,
  periode,
} from "../lib/bandeaux-visuels.ts";
import { etatBandeau, type BandeauVisuel } from "@memoryline/types";

const api = adminApi(Astro.request);

/** Ce que dit l'écran au retour d'un geste (redirection ?ok=…). */
const MESSAGES: Record<string, string> = {
  monte: "Ordre enregistré : sur une page qui en a plusieurs, les bandeaux s'affichent dans l'ordre de cette liste.",
  allume: "Bandeau activé. Il s'affiche sur ses pages, dans sa période.",
  eteint: "Bandeau désactivé : il a quitté le site. Ses réglages sont gardés.",
  archive:
    "Bandeau archivé : il a quitté le site et la liste. « Restaurer », en bas de page, le remet tel quel.",
  restaure:
    "Bandeau restauré, avec tous ses réglages. S'il est allumé et dans sa période, il est de nouveau en ligne.",
  supprime: "Bandeau supprimé définitivement.",
  introuvable:
    "Ce bandeau n'existe plus — il a peut-être été supprimé depuis un autre onglet.",
};

/** Le message (?ok=…) que chaque geste de la liste fait afficher au retour. */
const RETOUR_DU_GESTE: Record<string, string> = {
  monter: "monte",
  descendre: "monte",
  allumer: "allume",
  eteindre: "eteint",
  archiver: "archive",
  restaurer: "restaure",
  supprimer: "supprime",
};

let flash: string | null = MESSAGES[Astro.url.searchParams.get("ok") ?? ""] ?? null;
let flashErreur = false;

if (Astro.request.method === "POST") {
  const f = await Astro.request.formData();
  const action = String(f.get("_action") ?? "");
  const id = String(f.get("id") ?? "");
  try {
    const { bandeaux } = await lireBandeaux(api);
    const rang = bandeaux.findIndex((b) => b.id === id);
    const cible = bandeaux[rang];
    if (!cible) throw new Error(MESSAGES.introuvable);
    let suite: BandeauVisuel[] = bandeaux;

    if (action === "monter" || action === "descendre") {
      // On saute les archivés : ils ne sont pas à l'écran, échanger avec
      // l'un d'eux donnerait une flèche qui ne fait rien de visible.
      const pas = action === "monter" ? -1 : 1;
      let voisin = rang + pas;
      while (bandeaux[voisin]?.archive) voisin += pas;
      const autre = bandeaux[voisin];
      if (autre) {
        suite = [...bandeaux];
        suite[rang] = autre;
        suite[voisin] = cible;
      }
    } else if (action === "allumer" || action === "eteindre") {
      const actif = action === "allumer";
      suite = bandeaux.map((b) => (b.id === id ? { ...b, actif } : b));
    } else if (action === "archiver" || action === "restaurer") {
      const archive = action === "archiver";
      suite = bandeaux.map((b) => (b.id === id ? { ...b, archive } : b));
    } else if (action === "supprimer") {
      if (!cible.archive)
        throw new Error(
          "Archivez-le d'abord : seul un bandeau archivé peut être supprimé définitivement.",
        );
      suite = bandeaux.filter((b) => b.id !== id);
    } else if (action === "dupliquer") {
      // La copie part ÉTEINTE, juste sous l'original : on la règle (ses
      // dates, son texte) avant qu'elle se montre à côté de lui.
      const copie: BandeauVisuel = {
        ...structuredClone(cible),
        id: nouvelId(bandeaux),
        nom: `${nomDuBandeau(cible)} (copie)`.slice(0, 80),
        actif: false,
        archive: false,
      };
      suite = [...bandeaux.slice(0, rang + 1), copie, ...bandeaux.slice(rang + 1)];
      await ecrireBandeaux(api, suite);
      return Astro.redirect(`${url(`/bandeaux-visuels/${copie.id}`)}?ok=duplique`);
    } else {
      throw new Error("Action inconnue.");
    }

    await ecrireBandeaux(api, suite);
    return Astro.redirect(`${url("/bandeaux-visuels")}?ok=${RETOUR_DU_GESTE[action] ?? ""}`);
  } catch (e) {
    flash = e instanceof Error ? e.message : String(e);
    flashErreur = true;
  }
}

let bandeaux: BandeauVisuel[] = [];
let repriseEncart = false;
let erreur: string | null = null;
try {
  ({ bandeaux, repriseEncart } = await lireBandeaux(api));
} catch (e) {
  erreur = e instanceof Error ? e.message : String(e);
}

// De quoi nommer les rayons et les pages : une liste illisible laisse leur
// adresse à la place du nom, rien de plus.
let collections: CollectionBo[] = [];
let pagesSite: ResumePage[] = [];
try {
  collections = (await api.collections()).collections;
} catch {}
try {
  pagesSite = (await api.pages()).pages;
} catch {}

const maintenant = new Date();
const vivants = bandeaux.filter((b) => !b.archive);
const archives = bandeaux.filter((b) => b.archive);

/** La vignette d'une image : une petite taille, quand l'API sait la faire. */
const vignette = (chemin: string) =>
  chemin.startsWith("/assets/") ? `${apiUrl(chemin)}?l=400` : chemin;

const pagesDe = (b: BandeauVisuel) =>
  b.pages.map((p) => libellePage(p, collections, pagesSite)).join(", ") || "Aucune";
---

<Admin title="Bandeaux visuels">
  {
    flash && (
      <p
        class={`mb-4 max-w-4xl rounded border px-3 py-2 text-sm ${
          flashErreur
            ? "border-red-300 bg-red-50 text-red-800"
            : "border-green-300 bg-green-50 text-green-800"
        }`}
      >
        {flash}
      </p>
    )
  }
  {erreur && <p class="mb-4 text-sm text-red-600">API injoignable : {erreur}</p>}

  <div class="mb-5 max-w-4xl space-y-2 text-sm text-bo-muted">
    <p>
      Une grande image en haut d'une page, bord à bord sous le menu — comme la
      bannière de Noël de l'ancienne boutique. Vous choisissez l'image, un
      texte posé dessus, un bouton ou un lien, la hauteur, les pages où elle
      s'affiche et, si vous voulez, ses dates : elle s'active et se désactive
      toute seule.
    </p>
    <p>
      Plusieurs bandeaux sur une même page s'affichent dans l'ordre de cette
      liste. Pour un message en texte seul, tout en haut du site, c'est
      l'écran <a href={url("/bandeau")} class="text-bo-accent hover:underline">Bandeau d'annonce</a>.
    </p>
  </div>

  {
    repriseEncart && (
      <div class="mb-5 max-w-4xl rounded border border-sky-100 bg-sky-100 px-3 py-2 text-sm text-sky-900">
        L'encart qui était réglé dans « Accueil et pied de page » a été repris
        ici, tel qu'il s'affiche aujourd'hui (image et texte côte à côte). Il
        s'enregistre dans cette liste à votre première modification ; l'ancien
        réglage n'est plus utilisé ensuite.
      </div>
    )
  }

  <p class="mb-4">
    <a
      href={url("/bandeaux-visuels/nouveau")}
      class="inline-block rounded bg-bo-accent px-4 py-2 text-sm text-white hover:opacity-90"
    >
      + Nouveau bandeau
    </a>
  </p>

  <section class="overflow-x-auto rounded-lg border border-bo-border bg-bo-surface">
    <table class="w-full text-sm" data-sans-tri>
      <thead class="bg-bo-bg text-left text-bo-muted">
        <tr>
          <th class="px-4 py-2 font-medium">Image</th>
          <th class="px-4 py-2 font-medium">Bandeau</th>
          <th class="px-4 py-2 font-medium">Pages</th>
          <th class="px-4 py-2 font-medium">Quand</th>
          <th class="px-4 py-2 font-medium">État</th>
          <th class="px-4 py-2 font-medium">Ordre</th>
          <th class="px-4 py-2"></th>
        </tr>
      </thead>
      <tbody>
        {
          vivants.map((b, i) => {
            const pastille = PASTILLES[etatBandeau(b, maintenant)];
            return (
              <tr class="border-t border-bo-border align-middle">
                <td class="px-4 py-2">
                  <a href={url(`/bandeaux-visuels/${b.id}`)} class="block w-32">
                    {b.image ? (
                      <img
                        src={vignette(b.image)}
                        alt=""
                        loading="lazy"
                        class="h-14 w-32 rounded border border-bo-border bg-bo-bg object-cover"
                      />
                    ) : (
                      <span class="flex h-14 w-32 items-center justify-center rounded border border-dashed border-bo-border text-xs text-bo-muted">
                        sans image
                      </span>
                    )}
                  </a>
                </td>
                <td class="px-4 py-2">
                  <a
                    href={url(`/bandeaux-visuels/${b.id}`)}
                    class="font-medium text-bo-accent hover:underline"
                  >
                    {nomDuBandeau(b)}
                  </a>
                  <span class="block text-xs text-bo-muted">
                    {b.miseEnPage === "cote-a-cote"
                      ? "Image et texte côte à côte"
                      : "Bannière pleine largeur"}
                  </span>
                </td>
                <td class="max-w-[16rem] px-4 py-2 text-xs">{pagesDe(b)}</td>
                <td class="px-4 py-2 text-xs text-bo-muted">{periode(b)}</td>
                <td class="px-4 py-2">
                  <span
                    title={pastille.aide}
                    class={`whitespace-nowrap rounded-full px-2 py-0.5 text-xs ${pastille.classe}`}
                  >
                    {pastille.libelle}
                  </span>
                </td>
                <td class="whitespace-nowrap px-4 py-2">
                  <form method="POST" class="inline">
                    <input type="hidden" name="_action" value="monter" />
                    <input type="hidden" name="id" value={b.id} />
                    <button
                      class="rounded border border-bo-border px-2 py-0.5 hover:bg-bo-bg disabled:opacity-30"
                      disabled={i === 0}
                      aria-label={`Monter « ${nomDuBandeau(b)} »`}
                      title="Monter"
                    >
                      ▲
                    </button>
                  </form>
                  <form method="POST" class="inline">
                    <input type="hidden" name="_action" value="descendre" />
                    <input type="hidden" name="id" value={b.id} />
                    <button
                      class="rounded border border-bo-border px-2 py-0.5 hover:bg-bo-bg disabled:opacity-30"
                      disabled={i === vivants.length - 1}
                      aria-label={`Descendre « ${nomDuBandeau(b)} »`}
                      title="Descendre"
                    >
                      ▼
                    </button>
                  </form>
                </td>
                <td class="whitespace-nowrap px-4 py-2 text-right">
                  <a
                    href={url(`/bandeaux-visuels/${b.id}`)}
                    class="text-bo-accent hover:underline"
                  >
                    Modifier
                  </a>
                  <form method="POST" class="ml-3 inline">
                    <input
                      type="hidden"
                      name="_action"
                      value={b.actif ? "eteindre" : "allumer"}
                    />
                    <input type="hidden" name="id" value={b.id} />
                    <button class="text-xs text-bo-muted hover:text-bo-accent hover:underline">
                      {b.actif ? "Désactiver" : "Activer"}
                    </button>
                  </form>
                  <form method="POST" class="ml-3 inline">
                    <input type="hidden" name="_action" value="dupliquer" />
                    <input type="hidden" name="id" value={b.id} />
                    <button class="text-xs text-bo-muted hover:text-bo-accent hover:underline">
                      Dupliquer
                    </button>
                  </form>
                  <form
                    method="POST"
                    class="ml-3 inline"
                    onsubmit={`return confirm(${JSON.stringify(
                      `Archiver « ${nomDuBandeau(b)} » ?\n\nIl quitte le site et cette liste. Rien n'est supprimé : « Restaurer », en bas de page, le remet avec tous ses réglages.`,
                    )})`}
                  >
                    <input type="hidden" name="_action" value="archiver" />
                    <input type="hidden" name="id" value={b.id} />
                    <button class="text-xs text-bo-muted hover:text-bo-accent hover:underline">
                      Archiver
                    </button>
                  </form>
                </td>
              </tr>
            );
          })
        }
      </tbody>
    </table>
    {
      vivants.length === 0 && !erreur && (
        <p class="px-4 py-6 text-center text-sm text-bo-muted">
          Aucun bandeau pour le moment. « + Nouveau bandeau » pour en créer un.
        </p>
      )
    }
  </section>

  {
    archives.length > 0 && (
      <section class="mt-8">
        <h2 class="mb-1 font-semibold">Bandeaux archivés</h2>
        <p class="mb-3 max-w-3xl text-xs text-bo-muted">
          Hors du site et de la liste ci-dessus. « Restaurer » les remet à
          leur place, avec leur image, leurs textes, leurs traductions et
          leurs dates ; « Supprimer définitivement » les efface pour de bon.
        </p>
        <div class="overflow-hidden rounded-lg border border-bo-border bg-bo-surface opacity-70">
          <table class="w-full text-sm" data-sans-tri>
            <tbody>
              {archives.map((b) => (
                <tr class="border-t border-bo-border first:border-t-0">
                  <td class="px-4 py-2">
                    <span class="font-medium">{nomDuBandeau(b)}</span>
                    <span class="block text-xs text-bo-muted">{pagesDe(b)}</span>
                  </td>
                  <td class="px-4 py-2 text-xs text-bo-muted">{periode(b)}</td>
                  <td class="px-4 py-2 text-right">
                    <form method="POST" class="inline">
                      <input type="hidden" name="_action" value="restaurer" />
                      <input type="hidden" name="id" value={b.id} />
                      <button class="text-bo-accent hover:underline">Restaurer</button>
                    </form>
                    <form
                      method="POST"
                      class="ml-4 inline"
                      onsubmit={`return confirm(${JSON.stringify(
                        `Supprimer définitivement « ${nomDuBandeau(b)} » ? C'est sans retour.`,
                      )})`}
                    >
                      <input type="hidden" name="_action" value="supprimer" />
                      <input type="hidden" name="id" value={b.id} />
                      <button class="text-red-700 hover:underline">Supprimer définitivement</button>
                    </form>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )
  }
</Admin>
