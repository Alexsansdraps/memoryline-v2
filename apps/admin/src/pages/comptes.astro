---
import Admin from "../layouts/Admin.astro";
import { adminApi, type CompteAdmin, type StandBo } from "../lib/api.ts";

const api = adminApi(Astro.request);

const ROLES = [
  {
    value: "owner",
    label: "Propriétaire",
    aide: "Tous les droits : catalogue, personnages, prix, promotions, comptes.",
  },
  {
    value: "seller",
    label: "Vendeur",
    aide: "Ne voit que les ventes et les fichiers d'impression des stands qui lui sont confiés. Ne modifie rien.",
  },
];

/**
 * Les stands cochés dans un formulaire de compte, ou `undefined` si le
 * formulaire ne les porte pas.
 *
 * Une case décochée n'envoie rien : sans le champ témoin `standsPresents`,
 * « aucune case cochée » et « pas de cases du tout » se confondraient, et
 * enregistrer le mot de passe d'un vendeur lui retirerait ses stands. Pour
 * un propriétaire, on n'y touche pas : il voit tout de toute façon.
 */
function standsCoches(f: FormData): number[] | undefined {
  if (String(f.get("role") ?? "") !== "seller") return undefined;
  if (!f.has("standsPresents")) return undefined;
  return f
    .getAll("stands")
    .map((v) => Number(v))
    .filter((n) => Number.isInteger(n) && n > 0);
}
const nomRole = (v: string) => ROLES.find((r) => r.value === v)?.label ?? v;

/** Date lisible, sans dépendance : « 8 septembre 2026 ». */
function leJour(iso: string): string {
  try {
    return new Date(iso).toLocaleDateString("fr-FR", {
      day: "numeric",
      month: "long",
      year: "numeric",
    });
  } catch {
    return "";
  }
}

let flash: string | null = null;
let flashErreur = false;

if (Astro.request.method === "POST") {
  const f = await Astro.request.formData();
  const action = f.get("_action");
  try {
    if (action === "archiver") {
      const restaurer = f.get("archived") === "false";
      await api.archiverCompte(Number(f.get("id")), !restaurer);
      const nom = String(f.get("libelle") || "Ce compte");
      flash = restaurer
        ? `Compte « ${nom} » restauré : il peut se reconnecter, avec son rôle et son mot de passe.`
        : `Compte « ${nom} » archivé : il ne peut plus entrer, et ses sessions ouvertes sont fermées. L'historique garde son nom. Vous pouvez le restaurer plus bas.`;
    } else if (action === "deconnecter") {
      await api.logoutUser(Number(f.get("id")));
      flash = "Sessions fermées : ce compte devra se reconnecter.";
    } else {
      const motDePasse = String(f.get("password") || "");
      const standIds = standsCoches(f);
      const compte = await api.upsertUser({
        id: f.get("id") ? Number(f.get("id")) : undefined,
        email: String(f.get("email") || ""),
        role: String(f.get("role") || "seller"),
        ...(motDePasse ? { password: motDePasse } : {}),
        ...(standIds ? { standIds } : {}),
      });
      flash = f.get("id")
        ? `Compte « ${compte.email} » mis à jour${motDePasse ? " — nouveau mot de passe actif, ses sessions ont été fermées." : "."}`
        : `Compte « ${compte.email} » créé.`;
    }
  } catch (e) {
    // Les refus de l'API sont explicites (dernier propriétaire, son propre
    // compte, adresse déjà prise) : on les montre tels quels.
    const texte = String(e);
    flash = texte.includes("400") || texte.includes("409")
      ? "Refusé : " + texte.replace(/^.*-> \d+\s*/, "")
      : "Erreur : " + texte;
    flashErreur = true;
  }
}

let comptes: CompteAdmin[] = [];
let error: string | null = null;
try {
  comptes = await api.users();
} catch (e) {
  error = String(e);
}

/**
 * Tous les stands, pour les cases « Stands confiés » d'un vendeur. Les
 * archivés viennent en dernier, marqués : on peut en confier un, pour que
 * le vendeur d'un marché passé relise ses ventes.
 */
let stands: StandBo[] = [];
try {
  stands = (await api.stands()).stands
    .slice()
    .sort(
      (a, b) =>
        Number(Boolean(a.archivedAt)) - Number(Boolean(b.archivedAt)) ||
        a.nom.localeCompare(b.nom, "fr"),
    );
} catch {
  // Sans la liste, les cases ne s'affichent pas : le reste de l'écran sert.
}
const nomDuStand = new Map(stands.map((s) => [s.id, s.nom]));

/** « Marché de Mulhouse, Salon de Colmar », ou rien. */
function standsDe(c: CompteAdmin): string {
  return (c.standIds ?? [])
    .map((id) => nomDuStand.get(id) ?? `stand n° ${id}`)
    .join(", ");
}

// Les archivés quittent le tableau ordinaire pour leur propre section.
const actifs = comptes.filter((c) => !c.archivedAt);
const archives = comptes.filter((c) => c.archivedAt);

// Seuls les propriétaires ENCORE capables d'entrer comptent : un compte
// archivé ne se connecte plus, et le compter ici laisserait archiver le
// dernier qui le peut. C'est la règle que l'API applique de son côté.
const proprietaires = actifs.filter((c) => c.role === "owner").length;
/**
 * Un compte archivable : ni le sien, ni le dernier propriétaire.
 * Calculé ici et pas dans le gabarit : un « <= » au milieu du JSX est lu
 * comme l'ouverture d'un fragment et casse la compilation.
 */
const archivable = (c: CompteAdmin) =>
  !c.moi && !(c.role === "owner" && proprietaires === 1);
---

<Admin title="Comptes">
  {flash && (
    <p
      class={`mb-4 text-sm rounded px-3 py-2 border ${
        flashErreur ? "bg-red-50 border-red-200" : "bg-green-50 border-green-200"
      }`}
    >
      {flash}
    </p>
  )}
  {error && (
    <p class="mb-4 text-red-600 text-sm">
      Liste indisponible : {error}
    </p>
  )}

  <p class="mb-6 text-sm text-bo-muted max-w-3xl">
    Qui peut entrer dans le back-office, et jusqu'où. Un
    <strong> propriétaire</strong> peut tout modifier, y compris cette page ; un
    <strong> vendeur</strong> ne voit que les ventes des stands que vous lui
    confiez ici, et leurs fichiers d'impression, sans rien pouvoir changer.
    Un vendeur sans stand confié ne voit aucune vente : cochez ses stands —
    un par marché, autant qu'il en tient.
  </p>

  <section class="mb-6 bg-bo-surface border border-bo-border rounded-lg overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-bo-bg text-left">
        <tr>
          <th class="px-4 py-2">Compte</th>
          <th class="px-2 py-2 w-10"></th>
        </tr>
      </thead>
      <tbody>
        {actifs.map((c) => (
          <tr id={`compte-${c.id}`} class="border-t border-bo-border align-top">
            <td class="px-4 py-3">
              <form method="POST" class="flex flex-wrap items-end gap-3">
                <input type="hidden" name="id" value={c.id} />
                <label class="block">
                  <span class="text-bo-muted text-xs">Adresse e-mail</span>
                  <input
                    name="email"
                    type="email"
                    value={c.email}
                    required
                    class="mt-1 block w-64 border border-bo-border rounded px-2 py-1"
                  />
                </label>
                <label class="block">
                  <span class="text-bo-muted text-xs">Rôle</span>
                  <select
                    name="role"
                    disabled={c.moi}
                    title={c.moi ? "On ne change pas son propre rôle" : undefined}
                    class="mt-1 block border border-bo-border rounded px-2 py-1 disabled:opacity-60"
                  >
                    {ROLES.map((r) => (
                      <option value={r.value} selected={c.role === r.value}>
                        {r.label}
                      </option>
                    ))}
                  </select>
                  {c.moi && <input type="hidden" name="role" value={c.role} />}
                </label>
                <label class="block">
                  <span class="text-bo-muted text-xs">
                    Nouveau mot de passe
                  </span>
                  <input
                    name="password"
                    type="password"
                    minlength="10"
                    autocomplete="new-password"
                    placeholder="laisser vide pour ne pas changer"
                    class="mt-1 block w-56 border border-bo-border rounded px-2 py-1"
                  />
                </label>
                <fieldset
                  class="js-stands basis-full"
                  hidden={c.role !== "seller"}
                  disabled={c.role !== "seller"}
                >
                  <legend class="text-bo-muted text-xs">Stands confiés</legend>
                  <input type="hidden" name="standsPresents" value="1" />
                  {stands.length === 0 ? (
                    <p class="mt-1 text-xs text-bo-muted">
                      Aucun stand pour l'instant : ouvrez-en un dans « Ventes
                      stand », puis revenez le confier.
                    </p>
                  ) : (
                    <div class="mt-1 flex flex-wrap gap-x-4 gap-y-1">
                      {stands.map((s) => (
                        <label class="flex items-center gap-1.5">
                          <input
                            type="checkbox"
                            name="stands"
                            value={s.id}
                            checked={(c.standIds ?? []).includes(s.id)}
                          />
                          {s.nom}
                          {s.archivedAt && (
                            <span class="text-xs text-bo-muted">(archivé)</span>
                          )}
                        </label>
                      ))}
                    </div>
                  )}
                </fieldset>
                <button class="rounded bg-bo-accent text-white px-3 py-1.5">
                  Enregistrer
                </button>
                <p class="basis-full text-xs text-bo-muted">
                  {nomRole(c.role)} · créé le {leJour(c.createdAt)}
                  {c.moi && " · c'est vous"}
                  {c.connecte ? " · connecté en ce moment" : ""}
                  {c.role === "seller" && standsDe(c) && ` · Stands : ${standsDe(c)}`}
                </p>
                {c.role === "seller" && !standsDe(c) && (
                  <p class="basis-full">
                    <span class="rounded bg-amber-100 px-2 py-0.5 text-xs text-amber-900">
                      Aucun stand : ne voit aucune vente
                    </span>
                  </p>
                )}
              </form>
            </td>
            <td class="px-2 py-3 text-right whitespace-nowrap">
              {c.connecte && !c.moi && (
                <form method="POST" class="inline">
                  <input type="hidden" name="_action" value="deconnecter" />
                  <input type="hidden" name="id" value={c.id} />
                  <button
                    class="rounded border border-bo-border px-2 py-1 text-xs text-bo-muted hover:text-bo-accent"
                    title={`Fermer les sessions de ${c.email}`}
                  >
                    Déconnecter
                  </button>
                </form>
              )}
              {archivable(c) && (
                <form
                  method="POST"
                  class="js-archiver ml-1 inline"
                  data-nom={c.email}
                >
                  <input type="hidden" name="_action" value="archiver" />
                  <input type="hidden" name="id" value={c.id} />
                  <input type="hidden" name="libelle" value={c.email} />
                  <input type="hidden" name="archived" value="true" />
                  <button
                    class="rounded border border-bo-border px-2 py-1 text-xs text-bo-muted hover:border-bo-accent hover:text-bo-accent"
                    title={`Archiver le compte ${c.email}`}
                    aria-label={`Archiver ${c.email}`}
                  >
                    Archiver
                  </button>
                </form>
              )}
            </td>
          </tr>
        ))}
        {actifs.length === 0 && !error && (
          <tr>
            <td class="px-4 py-6 text-bo-muted" colspan="2">
              Aucun compte.
            </td>
          </tr>
        )}
      </tbody>
    </table>
  </section>

  {/* ==================================================================== */}
  {/* Les comptes archivés                                                 */}
  {/* ==================================================================== */}
  {archives.length > 0 && (
    <section class="mb-6">
      <h2 class="mb-1 font-semibold">Comptes archivés</h2>
      <p class="mb-3 max-w-3xl text-xs text-bo-muted">
        Ils ne peuvent plus entrer dans le back-office, et leurs sessions ont
        été fermées. Rien n'est effacé : l'historique des commandes garde leur
        nom, là où ils ont expédié, remboursé ou encaissé. « Restaurer » rend
        l'accès, avec le rôle et le mot de passe d'avant.
      </p>
      <div class="space-y-2 opacity-70">
        {archives.map((c) => (
          <div id={`compte-${c.id}`} class="flex flex-wrap items-center gap-4 rounded-lg border border-bo-border bg-bo-surface p-3">
            <div class="min-w-56 flex-1">
              <p class="font-medium">{c.email}</p>
              <p class="text-xs text-bo-muted">
                {nomRole(c.role)} · créé le {leJour(c.createdAt)}
              </p>
            </div>
            <form method="POST">
              <input type="hidden" name="_action" value="archiver" />
              <input type="hidden" name="id" value={c.id} />
              <input type="hidden" name="libelle" value={c.email} />
              <input type="hidden" name="archived" value="false" />
              <button class="text-sm text-bo-accent hover:underline">
                Restaurer
              </button>
            </form>
          </div>
        ))}
      </div>
    </section>
  )}

  <details class="bg-bo-surface border border-bo-border rounded-lg">
    <summary class="cursor-pointer px-5 py-3 font-semibold select-none">
      <span class="mr-1 text-bo-accent">+</span> Ajouter un compte
    </summary>
    <form method="POST" class="flex flex-wrap items-end gap-3 px-5 pb-5 text-sm">
      <label class="block">
        <span class="text-bo-muted">Adresse e-mail</span>
        <input
          name="email"
          type="email"
          required
          placeholder="prenom@memoryline.fr"
          class="mt-1 block w-64 border border-bo-border rounded px-3 py-2"
        />
      </label>
      <label class="block">
        <span class="text-bo-muted">Rôle</span>
        <select
          name="role"
          class="mt-1 block border border-bo-border rounded px-3 py-2"
        >
          {ROLES.map((r) => <option value={r.value}>{r.label}</option>)}
        </select>
      </label>
      <label class="block">
        <span class="text-bo-muted">Mot de passe</span>
        <input
          name="password"
          type="password"
          required
          minlength="10"
          autocomplete="new-password"
          class="mt-1 block w-56 border border-bo-border rounded px-3 py-2"
        />
      </label>
      <fieldset class="js-stands basis-full" hidden disabled>
        <legend class="text-bo-muted">Stands confiés</legend>
        <input type="hidden" name="standsPresents" value="1" />
        {stands.length === 0 ? (
          <p class="mt-1 text-xs text-bo-muted">
            Aucun stand pour l'instant : ouvrez-en un dans « Ventes stand »,
            puis revenez le confier.
          </p>
        ) : (
          <div class="mt-1 flex flex-wrap gap-x-4 gap-y-1">
            {stands.map((s) => (
              <label class="flex items-center gap-1.5">
                <input type="checkbox" name="stands" value={s.id} />
                {s.nom}
                {s.archivedAt && <span class="text-xs text-bo-muted">(archivé)</span>}
              </label>
            ))}
          </div>
        )}
        <p class="mt-1 text-xs text-bo-muted">
          Sans stand coché, le compte ne verra aucune vente.
        </p>
      </fieldset>
      <button class="rounded bg-bo-accent text-white px-4 py-2">Créer</button>
      <p class="basis-full text-xs text-bo-muted">
        Dix caractères minimum. Transmettez-le à la personne par un autre canal
        que l'e-mail du compte, et demandez-lui de le changer ici même.
      </p>
    </form>
  </details>

  <p class="mt-6 text-xs text-bo-muted max-w-3xl">
    Un compte ne se supprime pas : il s'archive. Deux règles que le back-office
    fait respecter tout seul : il reste toujours au moins un propriétaire
    capable d'entrer, et on ne peut ni archiver son propre compte ni changer
    son propre rôle — de quoi éviter de se retrouver dehors.
  </p>

  <script is:inline>
    // Les cases « Stands confiés » ne concernent qu'un vendeur : elles
    // apparaissent quand on choisit ce rôle, et disparaissent — désactivées,
    // donc non envoyées — pour un propriétaire, qui voit tout.
    document.querySelectorAll("form select[name='role']").forEach((choix) => {
      const cases = choix.form && choix.form.querySelector("fieldset.js-stands");
      if (!cases) return;
      const suivre = () => {
        const vendeur = choix.value === "seller";
        cases.hidden = !vendeur;
        cases.disabled = !vendeur;
      };
      choix.addEventListener("change", suivre);
      suivre();
    });

    document.querySelectorAll("form.js-archiver").forEach((f) => {
      f.addEventListener("submit", (e) => {
        const nom = f.getAttribute("data-nom") || "ce compte";
        if (
          !confirm(
            `Archiver le compte « ${nom} » ?\n\nIl perdra l'accès immédiatement et ses sessions seront fermées. Rien n'est supprimé : l'historique des commandes garde son nom.\n\nVous pourrez le restaurer dans « Comptes archivés ».`,
          )
        )
          e.preventDefault();
      });
    });
  </script>
</Admin>
