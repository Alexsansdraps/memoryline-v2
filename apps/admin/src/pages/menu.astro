  {/* ====== Liens retirés du menu (ou du pied de page) ====== */}
  {archives.length > 0 && (
    <section class="mt-10">
      <h2 class="mb-1 font-semibold">
        {auPied ? "Liens retirés du pied de page" : "Liens retirés du menu"}
      </h2>
      <p class="mb-3 max-w-3xl text-xs text-bo-muted">
        Ces liens ne sont plus dans {mots.leMenu} du site. Leur nom, leur
        adresse et leurs traductions sont gardés : « Restaurer » les remet dans
        {mots.leMenu} ci-dessus, où vous pouvez les replacer avec les flèches
        avant d'enregistrer. « Supprimer définitivement » les efface pour de bon.
      </p>
      <div class="overflow-hidden rounded-lg border border-bo-border bg-bo-surface opacity-70">
        <table class="w-full text-sm">
          <tbody>
            {archives.map((lien) => (
              <tr id={`entree-${lien.id}`} class="border-t border-bo-border first:border-t-0">
                <td class="px-4 py-2">
                  <span class="font-medium">{lien.label}</span>
                  {lien.parent && (
                    <span class="block text-xs text-bo-muted">
                      {auPied ? "lien de la colonne" : "sous-lien de"} « {lien.parent} »
                    </span>
                  )}
                </td>
                <td class="px-4 py-2 text-bo-muted">
                  {lien.href ? <code>{lien.href}</code> : "titre de colonne, sans adresse"}
                </td>
                <td class="px-4 py-2 text-right">
                  <form method="POST" class="inline">
                    <input type="hidden" name="_action" value="restaurer" />
                    <input type="hidden" name="id" value={lien.id} />
                    <button class="text-bo-accent hover:underline">
                      Restaurer
                    </button>
                  </form>
                  <form
                    method="POST"
                    class="ml-4 inline"
                    onsubmit={`return confirm(${JSON.stringify(confirmationSuppression(lien))})`}
                  >
                    <input type="hidden" name="_action" value="supprimer" />
                    <input type="hidden" name="id" value={lien.id} />
                    <button class="text-red-700 hover:underline">
                      Supprimer définitivement
                    </button>
                  </form>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  <script is:inline>
    const formulaire = document.getElementById("form-menu");
    const arbre = document.getElementById("arbre");
    const champEntrees = document.getElementById("champ-entrees");
    const menuVide = document.getElementById("menu-vide");

    if (formulaire && arbre && champEntrees) {
      /** Les mots du menu affiché (le haut ou le pied de page), posés par le serveur. */
      let mots = {};
      try {
        mots = JSON.parse(formulaire.getAttribute("data-mots") || "{}");
      } catch (e) {
        /* les phrases du menu du haut servent alors de repli */
      }

      /** Les vrais éléments d'un conteneur : le patron caché n'en est pas un. */
      function reels(conteneur, marqueur) {
        if (!conteneur) return [];
        return Array.prototype.slice
          .call(conteneur.children)
          .filter(
            (n) => n.hasAttribute(marqueur) && !n.hasAttribute("data-reserve"),
          );
      }

      /** Le champ d'une entrée, sans jamais descendre dans ses sous-liens. */
      function lire(entree, cle) {
        const champs = entree.querySelectorAll('[data-valeur="' + cle + '"]');
        for (let i = 0; i < champs.length; i++) {
          if (champs[i].closest("[data-entree], [data-enfant]") === entree)
            return champs[i];
        }
        return null;
      }

      function valeur(entree, cle) {
        const el = lire(entree, cle);
        if (!el) return "";
        return el.type === "checkbox"
          ? el.checked
          : String(el.value == null ? "" : el.value);
      }

      /**
       * Les libellés traduits d'UNE ligne, sans descendre dans ses sous-liens.
       *
       * Un champ vide n'est pas enregistré : « vide » et « pas traduit » disent
       * la même chose, et le site affiche alors le français. C'est aussi ce qui
       * permet d'effacer une traduction devenue fausse — on vide, on enregistre.
       */
      function traductions(ligne) {
        const sortie = {};
        ligne.querySelectorAll("[data-trad]").forEach((n) => {
          if (n.closest("[data-entree], [data-enfant]") !== ligne) return;
          const texte = String(n.value == null ? "" : n.value).trim();
          if (texte) sortie[n.getAttribute("data-trad")] = { label: texte };
        });
        return Object.keys(sortie).length ? sortie : null;
      }

      function serialiser() {
        const sortie = reels(arbre, "data-entree").map((entree) => {
          const enfants = entree.querySelector("[data-enfants]");
          return {
            id: valeur(entree, "id"),
            label: valeur(entree, "label"),
            href: valeur(entree, "href"),
            visible: valeur(entree, "visible") === true,
            enfants: enfants
              ? reels(enfants, "data-enfant").map((enfant) => ({
                  id: valeur(enfant, "id"),
                  label: valeur(enfant, "label"),
                  href: valeur(enfant, "href"),
                  visible: valeur(enfant, "visible") === true,
                  translations: traductions(enfant),
                }))
              : [],
            translations: traductions(entree),
          };
        });
        champEntrees.value = JSON.stringify(sortie);
      }

      /* --- La langue affichée ------------------------------------------- */

      const boutonsLangue = document.querySelectorAll("[data-choix-langue]");
      const aideLangue = document.getElementById("aide-langue");
      let langueAffichee = "fr";

      /**
       * Montre les champs d'UNE langue et cache ceux des autres.
       *
       * Appelée aussi après chaque ajout de ligne : une ligne recopiée du
       * patron arrive avec ses quatre champs cachés, et resterait muette en
       * pleine saisie d'une traduction.
       */
      function afficherLangue(code) {
        langueAffichee = code;
        arbre.querySelectorAll("[data-langue]").forEach((n) => {
          n.hidden = n.getAttribute("data-langue") !== code;
        });
        boutonsLangue.forEach((b) => {
          const actif = b.getAttribute("data-choix-langue") === code;
          b.classList.toggle("border-bo-accent", actif);
          b.classList.toggle("font-medium", actif);
          b.setAttribute("aria-pressed", actif ? "true" : "false");
        });
        if (aideLangue) aideLangue.classList.toggle("hidden", code === "fr");
      }

      boutonsLangue.forEach((bouton) => {
        bouton.addEventListener("click", () => {
          afficherLangue(bouton.getAttribute("data-choix-langue"));
        });
      });

      // Le nom français sert d'invite grisée aux champs traduits de sa ligne :
      // on voit du premier coup d'œil ce qui s'affichera si on ne remplit pas.
      arbre.addEventListener("input", (ev) => {
        const champFrancais = ev.target.closest('[data-valeur="label"]');
        if (!champFrancais) return;
        const ligne =
          champFrancais.closest("[data-enfant]") ||
          champFrancais.closest("[data-entree]");
        if (!ligne) return;
        ligne.querySelectorAll("[data-trad]").forEach((n) => {
          if (n.closest("[data-entree], [data-enfant]") === ligne)
            n.placeholder = champFrancais.value;
        });
      });

      function rafraichir() {
        if (menuVide)
          menuVide.classList.toggle(
            "hidden",
            reels(arbre, "data-entree").length > 0,
          );
        // Les lignes tout juste ajoutées arrivent avec leurs champs traduits
        // cachés : on les remet dans la langue affichée.
        afficherLangue(langueAffichee);
      }

      arbre.addEventListener("click", (ev) => {
        const bouton = ev.target.closest("[data-action], [data-ajouter-enfant]");
        if (!bouton) return;

        if (bouton.hasAttribute("data-ajouter-enfant")) {
          const entree = bouton.closest("[data-entree]");
          const conteneur = entree && entree.querySelector("[data-enfants]");
          const modele = conteneur && conteneur.querySelector("[data-reserve]");
          if (!conteneur || !modele) return;
          const neuf = modele.cloneNode(true);
          neuf.removeAttribute("data-reserve");
          neuf.removeAttribute("hidden");
          neuf.removeAttribute("style");
          conteneur.insertBefore(neuf, modele);
          rafraichir();
          const premier = neuf.querySelector("input:not([type=hidden])");
          if (premier) premier.focus();
          return;
        }

        const ligne = bouton.closest("[data-enfant]") || bouton.closest("[data-entree]");
        if (!ligne || !ligne.parentElement) return;
        const action = bouton.getAttribute("data-action");
        if (action === "monter") {
          const avant = ligne.previousElementSibling;
          if (avant && !avant.hasAttribute("data-reserve"))
            ligne.parentElement.insertBefore(ligne, avant);
        } else if (action === "descendre") {
          const apres = ligne.nextElementSibling;
          if (apres && !apres.hasAttribute("data-reserve"))
            ligne.parentElement.insertBefore(apres, ligne);
        } else if (action === "retirer") {
          // Retirer n'efface rien : au prochain enregistrement, le lien
          // descend dans « Liens retirés du menu », d'où il se restaure.
          const nom = valeur(ligne, "label") || "ce lien";
          const sousLiens = ligne.hasAttribute("data-entree")
            ? reels(ligne.querySelector("[data-enfants]"), "data-enfant").length
            : 0;
          const avertissement = sousLiens
            ? sousLiens > 1
              ? " Ses " + sousLiens + " " + (mots.sousLiens || "sous-liens") + " partiront avec elle."
              : " Son " + (mots.sousLien || "sous-lien") + " partira avec elle."
            : "";
          if (
            !confirm(
              "Retirer « " +
                nom +
                " » " +
                (mots.duMenu || "du menu") +
                " ?" +
                avertissement +
                " Rien n'est supprimé : après enregistrement, vous le " +
                "retrouverez dans « " +
                (mots.retires || "Liens retirés du menu") +
                " », en bas de cet écran, avec un bouton pour le remettre.",
            )
          )
            return;
          ligne.remove();
        }
        rafraichir();
      });

      const ajouter = document.getElementById("ajouter-entree");
      ajouter?.addEventListener("click", () => {
        const modele = arbre.querySelector(":scope > [data-reserve]");
        if (!modele) return;
        const neuf = modele.cloneNode(true);
        neuf.removeAttribute("data-reserve");
        neuf.removeAttribute("hidden");
        neuf.removeAttribute("style");
        arbre.insertBefore(neuf, modele);
        rafraichir();
        neuf.scrollIntoView({ behavior: "smooth", block: "center" });
        const premier = neuf.querySelector("input:not([type=hidden])");
        if (premier) premier.focus();
      });

      formulaire.addEventListener("submit", serialiser);
      rafraichir();

      /*
       * Les onglets « Menu du haut » et « Pied de page » rechargent l'écran :
       * ce qui n'est pas enregistré serait perdu sans un mot. On compare donc
       * l'arbre à celui du chargement — et une ligne préparée par « Ajouter
       * au menu », ou une saisie refusée, compte déjà comme une modification.
       */
      serialiser();
      const auDepart = champEntrees.value;
      document.querySelectorAll("[data-onglet]").forEach((onglet) => {
        onglet.addEventListener("click", (ev) => {
          if (onglet.getAttribute("aria-current") === "page") return;
          serialiser();
          const modifie =
            formulaire.hasAttribute("data-modifie") || champEntrees.value !== auDepart;
          if (modifie && !confirm(mots.quitter || "Quitter sans enregistrer ?"))
            ev.preventDefault();
        });
      });
    }
  </script>

  <script>
    /*
     * Le choix d'une page dans la liste, et la phrase qui dit où mène chaque
     * ligne.
     *
     * Tout passe par délégation sur l'arbre : les lignes ajoutées par
     * « + Ajouter » sont des copies du patron, nées après ce script, et elles
     * doivent marcher pareil. La comparaison des adresses est celle de
     * l'écran « Pages du site » (lib/destinations.ts) : les deux écrans
     * disent la même chose de la même adresse.
     */
    import { cleDAdresse } from "../lib/destinations.ts";

    interface Cible {
      nom: string;
      href: string;
      cle: string;
      traductions: Record<string, string>;
      enLigne: boolean;
      remarque: string | null;
    }

    const donnees = document.getElementById("cibles-menu");
    const arbre = document.getElementById("arbre");
    if (donnees && arbre) {
      const cibles = JSON.parse(donnees.textContent || "[]") as Cible[];
      const parCle = new Map(cibles.map((c) => [c.cle, c]));
      /** L'écran du pied de page : une entrée de premier niveau y est une colonne. */
      const auPied = arbre.dataset.emplacement === "pied";

      /** La ligne d'un élément : le sous-lien s'il en est un, sinon l'entrée. */
      const ligneDe = (el: Element) =>
        el.closest<HTMLElement>("[data-enfant], [data-entree]");

      /** Un élément de la ligne elle-même, jamais d'un de ses sous-liens. */
      function dansLaLigne<T extends HTMLElement>(ligne: HTMLElement, selecteur: string): T | null {
        for (const n of Array.from(ligne.querySelectorAll<T>(selecteur)))
          if (ligneDe(n) === ligne) return n;
        return null;
      }

      /** La phrase sous la ligne : où mène l'adresse, et si la page répond. */
      function commenter(ligne: HTMLElement): void {
        const phrase = dansLaLigne<HTMLElement>(ligne, "[data-cible]");
        const champ = dansLaLigne<HTMLInputElement>(ligne, '[data-valeur="href"]');
        if (!phrase || !champ) return;
        const href = champ.value.trim();
        let texte = "";
        let alerte = false;
        if (!href)
          texte =
            auPied && ligne.hasAttribute("data-entree")
              ? "→ titre seul : ce sont les liens de la colonne qui mènent quelque part."
              : "";
        else if (/^https?:\/\//i.test(href)) texte = "→ un autre site";
        else if (/^mailto:/i.test(href)) texte = "→ un courriel";
        else {
          const cible = parCle.get(cleDAdresse(href));
          if (!cible) {
            texte =
              "⚠ Cette adresse ne correspond à aucune page connue du site : choisissez la page dans la liste « Page ».";
            alerte = true;
          } else {
            texte = `→ ${cible.nom}${cible.enLigne ? "" : ` — ${cible.remarque ?? "introuvable sur le site"}`}`;
            alerte = !cible.enLigne;
          }
        }
        phrase.textContent = texte;
        phrase.classList.toggle("text-amber-800", alerte);
        phrase.classList.toggle("text-bo-muted", !alerte);
      }

      function toutCommenter(): void {
        arbre!
          .querySelectorAll<HTMLElement>("[data-entree], [data-enfant]")
          .forEach(commenter);
      }

      arbre.addEventListener("change", (e) => {
        const liste = (e.target as HTMLElement).closest<HTMLSelectElement>("select[data-choisir]");
        if (!liste) return;
        // La liste GARDE la page choisie (13/11) : c'est elle qui fait
        // l'adresse, qu'on ne saisit plus à la main.
        const ligne = ligneDe(liste);
        if (!ligne) return;
        const adresse = dansLaLigne<HTMLInputElement>(ligne, '[data-valeur="href"]');
        // Le premier choix (« — Choisir — », « — Aucune (titre seul) — »)
        // vide l'adresse : un titre de colonne du pied de page s'en passe, et
        // ailleurs l'enregistrement demandera où mène le lien. Il valait
        // Number("") = 0, et posait l'accueil en douce.
        if (liste.value === "") {
          if (adresse) adresse.value = "";
          commenter(ligne);
          return;
        }
        const cible = cibles[Number(liste.value)];
        if (!cible) return;
        if (adresse) adresse.value = cible.href;
        // Le nom n'est rempli que s'il est vide : un nom choisi (« Tout
        // voir ») ne doit pas être remplacé par celui de la page.
        const nom = dansLaLigne<HTMLInputElement>(ligne, '[data-valeur="label"]');
        if (nom && !nom.value.trim()) {
          nom.value = cible.nom;
          nom.dispatchEvent(new Event("input", { bubbles: true }));
        }
        for (const [langue, traduit] of Object.entries(cible.traductions)) {
          const champ = dansLaLigne<HTMLInputElement>(ligne, `[data-trad="${langue}"]`);
          if (champ && !champ.value.trim()) champ.value = traduit;
        }
        commenter(ligne);
      });

      arbre.addEventListener("input", (e) => {
        const champ = (e.target as HTMLElement).closest('[data-valeur="href"]');
        const ligne = champ ? ligneDe(champ) : null;
        if (ligne) commenter(ligne);
      });

      // « + Ajouter » recopie le patron dans un autre script : on recommente
      // tout après chaque clic, une fois la nouvelle ligne posée.
      arbre.addEventListener("click", () => requestAnimationFrame(toutCommenter));
      document.getElementById("ajouter-entree")?.addEventListener("click", () =>
        requestAnimationFrame(toutCommenter),
      );

      toutCommenter();
    }
  </script>
</Admin>
