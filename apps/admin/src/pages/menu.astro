---
/**
 * Le menu du site : ce que les clients voient tout en haut de la boutique.
 *
 * Une page créée dans « Pages du site » n'existe pour personne tant qu'aucun
 * lien n'y mène. Cet écran est la deuxième moitié du geste : créer la page
 * « Magnets », puis poser « Magnets » dans le menu.
 *
 * Le menu tient sur deux niveaux, pas trois : une entrée, et éventuellement
 * des sous-liens dessous. C'est ce qu'un bandeau de boutique sait afficher, et
 * un troisième niveau ne se déplierait nulle part.
 *
 * L'enregistrement remplace l'arbre entier en une fois : ce qui a été retiré
 * ici quitte le site — et rejoint « Liens retirés du menu », en bas de l'écran,
 * d'où il se remet en place. Rien ne s'efface en enregistrant : seul
 * « Supprimer définitivement », sur un lien déjà retiré, l'efface pour de bon
 * (avec ses sous-liens retirés, qui ne se restaureraient plus sans lui).
 *
 * Le menu se saisit dans les cinq langues, mais UNE À LA FOIS : les boutons du
 * haut choisissent la langue affichée, et chaque ligne montre alors son nom
 * français à côté du champ à remplir. Un champ laissé vide n'est pas un trou :
 * le site affiche le français à sa place. Les quatre langues sont rendues dès
 * le départ et simplement masquées — c'est ce qui permet à un ajout de ligne,
 * fait par recopie du patron, d'emporter ses champs de traduction avec lui.
 *
 * L'ADRESSE SE CHOISIT dans une liste — les pages de la boutique, chaque
 * collection, chaque page écrite — au lieu de se deviner : la boutique
 * cherchait comment faire mener une entrée à « Thèmes & paysages ». Choisir
 * remplit l'adresse, et le nom quand il est vide, traductions comprises
 * quand on les connaît. Sous chaque ligne, une phrase dit où mène l'adresse
 * écrite, et prévient quand la page visée est introuvable sur le site.
 *
 * « Ajouter au menu », sur l'écran Pages du site, arrive ici avec la page à
 * ajouter (`?ajouter=…&nom=…`) : l'écran demande où la placer, prépare la
 * ligne, et rien n'est enregistré avant « Enregistrer le menu ».
 *
 * DEUX ONGLETS (17/11) : le menu du haut, et le pied de page
 * (`?emplacement=pied`), pour que Margaux règle seule les colonnes de liens
 * du bas du site. Même écran, mêmes gestes : une entrée de premier niveau du
 * pied de page est une colonne (son titre, sans adresse le plus souvent), et
 * ses sous-liens sont les liens de la colonne. Chaque onglet s'enregistre
 * seul : l'API ne touche jamais à l'autre menu.
 */
import { url } from "../lib/url.ts";
import Admin from "../layouts/Admin.astro";
import {
  adminApi,
  type CollectionBo,
  type CollectionEnLigne,
  type EmplacementMenu,
  type LienArchive,
  type MenuCms,
  type ResumePage,
} from "../lib/api.ts";
import { cleDAdresse, destinations, type Destination } from "../lib/destinations.ts";

/**
 * Le menu affiché : le haut, ou le pied de page. Les formulaires de l'écran
 * n'ont pas d'action : ils repartent vers cette même adresse, `?emplacement`
 * compris.
 */
const emplacement: EmplacementMenu =
  Astro.url.searchParams.get("emplacement") === "pied" ? "pied" : "haut";
const auPied = emplacement === "pied";
/** L'adresse de cet écran, pour ce menu. */
const adresseEcran = auPied ? `${url("/menu")}?emplacement=pied` : url("/menu");

/**
 * Les colonnes que le pied de page affiche au plus, à côté du logo et de
 * « Compte ». La même limite que l'API (COLONNES_PIED_MAX, cms.ts), qui
 * refuse d'enregistrer davantage de colonnes visibles et dit pourquoi.
 */
const COLONNES_PIED_MAX = 4;

/** La classe d'un des deux onglets du haut de l'écran : souligné s'il est ouvert. */
const onglet = (actif: boolean) =>
  `-mb-px border-b-2 px-1 pb-2 text-sm ${
    actif ? "border-bo-accent font-medium text-bo-ink" : "border-transparent text-bo-muted hover:text-bo-ink"
  }`;

/** Les mots de l'écran qui changent avec le menu affiché. */
const mots = auPied
  ? {
      leMenu: "le pied de page",
      duMenu: "du pied de page",
      titreEntree: "Titre de la colonne",
      exempleEntree: "Informations",
      titreSousLien: "Nom du lien",
      exempleSousLien: "Livraison et retours",
      sousLien: "lien",
      sousLiens: "liens",
      cetteEntree: "cette colonne",
      ceSousLien: "ce lien",
      ajouterEntree: "+ Ajouter une colonne",
      ajouterSousLien: "+ Ajouter un lien",
      enregistrer: "Enregistrer le pied de page",
      enregistre: "Pied de page enregistré. Il est à jour sur le site.",
      retires: "Liens retirés du pied de page",
      vide:
        "Le pied de page est vide : le site affichera ses deux colonnes d'origine, « La boutique » et « Aide et informations ».",
    }
  : {
      leMenu: "le menu",
      duMenu: "du menu",
      titreEntree: "Nom dans le menu",
      exempleEntree: "Magnets",
      titreSousLien: "Nom du sous-lien",
      exempleSousLien: "Magnets ronds",
      sousLien: "sous-lien",
      sousLiens: "sous-liens",
      cetteEntree: "cette entrée",
      ceSousLien: "ce sous-lien",
      ajouterEntree: "+ Ajouter une entrée",
      ajouterSousLien: "+ Ajouter un sous-lien",
      enregistrer: "Enregistrer le menu",
      enregistre: "Menu enregistré. Il est à jour sur le site.",
      retires: "Liens retirés du menu",
      vide: "Le menu est vide : aucun lien n'apparaît en haut du site.",
    };

/**
 * La page d'une ligne, cochée dans sa liste : l'adresse ne se saisit plus à
 * la main (Alexandra, 13/11 : « faut pas qu'on puisse modifier l'adresse,
 * juste la voir, et qu'elle change en choisissant une page »). Comparée par
 * ce qu'elle MONTRE (cleDAdresse), comme le reste de l'écran.
 */
const memePage = (cible: string, href: string | undefined): boolean =>
  !!href && cleDAdresse(cible) === cleDAdresse(href);

const api = adminApi(Astro.request);

/**
 * Ce qu'une adresse de menu peut viser : une page du site, une autre adresse
 * sur internet, ou une adresse électronique.
 */
const LIEN_VALIDE = /^(\/\S*|https?:\/\/\S+|mailto:\S+)$/;

/**
 * Les quatre langues qui se traduisent. Le français n'en fait pas partie :
 * c'est lui qu'on traduit, il vit dans le champ « Nom dans le menu ».
 */
const LANGUES_TRADUISIBLES = [
  { code: "en", nom: "Anglais" },
  { code: "de", nom: "Allemand" },
  { code: "it", nom: "Italien" },
  { code: "es", nom: "Espagnol" },
] as const;

/** Les libellés traduits d'une entrée, par code de langue. */
type Traductions = Record<string, { label?: string }>;

/** Une entrée telle qu'elle s'affiche : tout en texte, rien de jugé. */
interface EntreeSouple {
  id: string;
  label: string;
  href: string;
  visible: boolean;
  traductions: Traductions | null;
  enfants: EntreeSouple[];
}

function entreeVide(): EntreeSouple {
  return { id: "", label: "", href: "", visible: true, traductions: null, enfants: [] };
}

/** Le libellé déjà traduit dans cette langue, ou rien. */
function libelleTraduit(entree: EntreeSouple, code: string): string {
  const valeur = entree.traductions?.[code]?.label;
  return typeof valeur === "string" ? valeur : "";
}

function chaine(objet: Record<string, unknown>, cle: string): string {
  const v = objet[cle];
  if (typeof v === "string") return v;
  if (typeof v === "number" && Number.isFinite(v)) return String(v);
  return "";
}

/** Lecture tolérante, pour REMPLIR l'écran : la base et le champ caché y passent. */
function entreesSouples(brut: unknown, profondeur = 0): EntreeSouple[] {
  if (!Array.isArray(brut)) return [];
  const sortie: EntreeSouple[] = [];
  for (const item of brut) {
    if (!item || typeof item !== "object") continue;
    const o = item as Record<string, unknown>;
    const entree = entreeVide();
    entree.id = chaine(o, "id");
    entree.label = chaine(o, "label");
    entree.href = chaine(o, "href");
    // Une entrée sans réponse sur « visible » est montrée : rien ne doit
    // disparaître du site sans que personne ne l'ait décoché.
    entree.visible = o.visible !== false;
    entree.traductions =
      o.translations && typeof o.translations === "object"
        ? (o.translations as Traductions)
        : null;
    // Un seul niveau de sous-liens : au-delà, le site n'aurait pas où les mettre.
    entree.enfants = profondeur === 0 ? entreesSouples(o.enfants, 1) : [];
    sortie.push(entree);
  }
  return sortie;
}

/**
 * Une entrée vérifiée, dans la forme que l'API attend. `titreDeColonne` : le
 * titre d'une colonne du pied de page, qui peut se passer d'adresse.
 */
function verifierEntree(
  e: EntreeSouple,
  ou: string,
  titreDeColonne = false,
): Record<string, unknown> {
  const label = e.label.trim();
  const href = e.href.trim();
  if (!label)
    throw new Error(
      `${ou} : écrivez ce qui doit être marqué dans ${mots.leMenu}, par exemple « ${mots.exempleEntree} ».`,
    );
  if (!href && !titreDeColonne)
    throw new Error(
      `${ou} (« ${label} ») : indiquez où ce lien emmène, par exemple /magnets.`,
    );
  if (href && !LIEN_VALIDE.test(href))
    throw new Error(
      `${ou} (« ${label} ») : « ${href} » ne mène nulle part. Commencez par ` +
        `une barre oblique pour une page du site, par exemple /magnets, ou ` +
        `par https:// pour un autre site.`,
    );
  const sortie: Record<string, unknown> = { label, href, visible: e.visible };
  const identifiant = Number(e.id);
  if (e.id && Number.isFinite(identifiant) && identifiant > 0)
    sortie.id = identifiant;
  // Toujours envoyé, même vide : c'est ainsi qu'un libellé traduit effacé à
  // l'écran disparaît vraiment. Omettre la clé le laisserait en place.
  sortie.translations = e.traductions ?? null;
  return sortie;
}

function verifierArbre(entrees: EntreeSouple[]): Record<string, unknown>[] {
  return entrees.map((e, i) => {
    const parent = auPied
      ? verifierEntree(e, `Colonne n°${i + 1}`, true)
      : verifierEntree(e, `Entrée n°${i + 1}`);
    parent.enfants = e.enfants.map((enfant, j) =>
      verifierEntree(
        enfant,
        auPied
          ? `Lien n°${j + 1} de la colonne « ${e.label.trim() || "n°" + (i + 1)} »`
          : `Sous-lien n°${j + 1} de « ${e.label.trim() || "l'entrée n°" + (i + 1)} »`,
      ),
    );
    return parent;
  });
}

let flash: string | null = null;
let flashErreur = false;
let saisie: EntreeSouple[] | null = null;

if (Astro.request.method === "POST") {
  const f = await Astro.request.formData();

  // Remettre un lien dans le menu : un geste à part, qui ne passe pas par
  // l'arbre affiché — celui-ci ne montre que ce qui est DANS le menu, et le
  // lien à restaurer n'y est justement plus.
  if (String(f.get("_action") ?? "") === "restaurer") {
    try {
      await api.restaurerLienMenu(Number(f.get("id")), emplacement);
      flash = `Lien remis dans ${mots.leMenu}. Vérifiez sa place avec les flèches, puis enregistrez.`;
    } catch (e) {
      flash = String(e).replace(/^Error:\s*/, "");
      flashErreur = true;
    }
  } else if (String(f.get("_action") ?? "") === "supprimer") {
    // Même geste à part que « Restaurer » : il ne touche qu'aux liens
    // retirés, jamais à l'arbre affiché. Un refus de l'API (409) s'affiche
    // tel quel.
    try {
      await api.supprimerLienMenu(Number(f.get("id")), emplacement);
      flash = "Lien supprimé définitivement.";
    } catch (e) {
      flash = String(e).replace(/^Error:\s*/, "");
      flashErreur = true;
    }
  } else {
    const brut = String(f.get("entrees") ?? "");
    let souples: EntreeSouple[] = [];
    let lectureCassee = false;
    try {
      souples = entreesSouples(JSON.parse(brut || "[]"));
    } catch {
      lectureCassee = true;
    }
    try {
      if (lectureCassee)
        throw new Error(
          "Le menu n'a pas pu être relu par le navigateur. Rien n'a été " +
            "enregistré. Rechargez l'écran et reprenez vos modifications.",
        );
      await api.enregistrerMenu(verifierArbre(souples), emplacement);
      flash = mots.enregistre;
    } catch (e) {
      flash = String(e).replace(/^Error:\s*/, "");
      flashErreur = true;
      saisie = lectureCassee ? null : souples;
    }
  }
}

let menu: MenuCms | null = null;
let erreur: string | null = null;
try {
  menu = await api.menu(emplacement);
} catch (e) {
  erreur = String(e).replace(/^Error:\s*/, "");
}

/*
 * Les pages qu'une entrée peut viser, pour la liste de choix. Chaque morceau a
 * son repli : sans les collections ou les pages, la liste est plus courte,
 * et l'adresse se tape encore à la main comme avant.
 */
const [listeCollections, collectionsServies, listePages] = await Promise.all([
  api
    .collections()
    .then((r) => r.collections)
    .catch(() => [] as CollectionBo[]),
  api.collectionsEnLigne().catch(() => null as CollectionEnLigne[] | null),
  api
    .pages()
    .then((r) => r.pages)
    .catch(() => [] as ResumePage[]),
]);
/**
 * La page de recherche du site. Le pied de page y mène depuis toujours, mais
 * la liste des pages de la boutique (lib/destinations.ts) ne la proposait
 * pas : son lien s'annonçait « aucune page connue du site ».
 */
const RECHERCHE: Destination = {
  groupe: "boutique",
  nom: "Rechercher",
  href: "/recherche",
  enLigne: true,
  remarque: "la recherche dans les affiches",
};
const cibles: Destination[] = [
  ...destinations(listeCollections, collectionsServies, listePages),
  RECHERCHE,
];
const GROUPES_DE_CIBLES = [
  { groupe: "boutique", titre: "Pages de la boutique" },
  { groupe: "collection", titre: "Collections" },
  { groupe: "page", titre: "Vos pages" },
] as const;
/** Ce que le script de la page reçoit : de quoi remplir une ligne et la commenter. */
const ciblesJson = JSON.stringify(
  cibles.map((d) => ({
    nom: d.nom,
    href: d.href,
    cle: cleDAdresse(d.href),
    traductions: d.traductions ?? {},
    enLigne: d.enLigne,
    remarque: d.remarque ?? null,
  })),
  // « < » échappé : un nom de collection contenant « </script> » fermerait
  // sinon la balise qui porte ces données, et le reste deviendrait du code.
).replace(/</g, "\\u003c");

const entrees: EntreeSouple[] = saisie ?? entreesSouples(menu?.entrees);

/*
 * Une page à ajouter, arrivée de l'écran « Pages du site ». Tant que la place
 * n'est pas choisie (`sous` absent), l'écran la demande ; une fois choisie, la
 * ligne est préparée à cet endroit — elle ne sera enregistrée qu'avec le menu.
 */
const params = Astro.url.searchParams;
const hrefAAjouter =
  Astro.request.method === "GET" ? (params.get("ajouter") ?? "").trim() : "";
const nomAAjouter = (params.get("nom") ?? "").trim().slice(0, 120);
const ajoutValide = !!hrefAAjouter && LIEN_VALIDE.test(hrefAAjouter);
const placeChoisie = params.get("sous");
let ajoutPrepare: string | null = null;
if (ajoutValide && placeChoisie !== null) {
  const cible = cibles.find((d) => cleDAdresse(d.href) === cleDAdresse(hrefAAjouter));
  const nouvelle: EntreeSouple = {
    ...entreeVide(),
    label: nomAAjouter || cible?.nom || "",
    href: hrefAAjouter,
    traductions: cible?.traductions
      ? Object.fromEntries(
          Object.entries(cible.traductions).map(([l, nom]) => [l, { label: nom }]),
        )
      : null,
  };
  const parent = placeChoisie === "0" ? undefined : entrees.find((e) => e.id === placeChoisie);
  if (parent) parent.enfants.push(nouvelle);
  else entrees.push(nouvelle);
  if (auPied)
    ajoutPrepare = parent
      ? `« ${nouvelle.label} » est préparé dans la colonne « ${parent.label} », à la fin.`
      : `« ${nouvelle.label} » est préparé comme nouvelle colonne, à droite des autres.`;
  else
    ajoutPrepare = parent
      ? `« ${nouvelle.label} » est préparé comme sous-lien de « ${parent.label} », à la fin.`
      : `« ${nouvelle.label} » est préparé en bas du menu.`;
}
/** Le lien qui choisit la place de la page à ajouter, dans ce menu. */
const lienPlace = (sous: string) =>
  `${url("/menu")}?${new URLSearchParams({
    ...(auPied ? { emplacement: "pied" } : {}),
    ajouter: hrefAAjouter,
    nom: nomAAjouter,
    sous,
  }).toString()}`;

/** Les liens retirés du menu, gardés pour pouvoir les remettre. */
const archives: LienArchive[] = menu?.archives ?? [];

/**
 * La confirmation de « Supprimer définitivement ». Une entrée emporte ses
 * sous-liens retirés (apps/api/src/cms.ts) : la phrase les compte.
 */
function confirmationSuppression(lien: LienArchive): string {
  const sousLiens = archives.filter((a) => a.parentId === lien.id).length;
  const avec = sousLiens
    ? ` ${sousLiens > 1 ? `Ses ${sousLiens} ${mots.sousLiens} retirés partent` : `Son ${mots.sousLien} retiré part`} avec elle.`
    : "";
  return `Supprimer définitivement « ${lien.label} » ? C'est sans retour.${avec}`;
}

/**
 * Les mots du script de l'écran (confirmations), et l'alerte des onglets :
 * changer d'onglet recharge l'écran, et perdrait ce qui n'est pas enregistré.
 */
const motsDuScript = JSON.stringify({
  duMenu: mots.duMenu,
  retires: mots.retires,
  sousLien: mots.sousLien,
  sousLiens: mots.sousLiens,
  quitter:
    "Vos modifications ne sont pas enregistrées : elles seront perdues si vous changez d'onglet. Changer quand même ?",
});

/**
 * Le champ caché part rempli : sans JavaScript, l'écran ne sait ni ajouter ni
 * déplacer, mais un enregistrement ne viderait pas le menu pour autant.
 */
const entreesJson = JSON.stringify(
  entrees.map((e) => ({
    id: e.id,
    label: e.label,
    href: e.href,
    visible: e.visible,
    translations: e.traductions,
    enfants: e.enfants.map((c) => ({
      id: c.id,
      label: c.label,
      href: c.href,
      visible: c.visible,
      translations: c.traductions,
    })),
  })),
);

/**
 * Les entrées de l'écran, suivies d'un exemplaire vide qui sert de patron au
 * bouton « Ajouter ». Le patron est rendu par le serveur comme les autres :
 * une seule écriture du formulaire, donc un seul endroit à corriger.
 */
const aRendre = [
  ...entrees.map((entree) => ({ entree, modele: false })),
  { entree: entreeVide(), modele: true },
];

const champ =
  "mt-1 w-full rounded border border-bo-border bg-bo-surface px-3 py-2 text-sm";
const boutonPrincipal =
  "rounded bg-bo-accent px-4 py-2 text-sm text-white hover:opacity-90";
const boutonDiscret =
  "rounded border border-bo-border bg-bo-surface px-3 py-1.5 text-sm hover:bg-bo-bg";
const boutonOutil =
  "flex h-7 w-7 items-center justify-center rounded border border-bo-border text-bo-muted hover:bg-bo-bg";
---

<Admin
  title={auPied ? "Pied de page" : "Menu du site"}
  rubrique={auPied ? "/menu?emplacement=pied" : undefined}
>
  {/* Les deux menus du site. Des liens, et non des boutons : chaque onglet
      est un écran à part, qui s'enregistre seul. Le script de l'écran
      prévient avant de quitter des modifications non enregistrées. */}
  <nav
    aria-label="Les menus du site"
    class="mb-6 flex flex-wrap gap-6 border-b border-bo-border"
  >
    {/* Écrits en toutes lettres, et non tirés d'une liste : la recherche du
        back-office lit les textes du fichier, et « pied de page » doit
        trouver cet écran. */}
    <a href={url("/menu")} data-onglet aria-current={auPied ? undefined : "page"} class={onglet(!auPied)}>
      Menu du haut
    </a>
    <a href={`${url("/menu")}?emplacement=pied`} data-onglet aria-current={auPied ? "page" : undefined} class={onglet(auPied)}>
      Pied de page
    </a>
  </nav>

  {flash && (
    <p
      class={`mb-4 rounded border px-3 py-2 text-sm ${
        flashErreur ? "bg-red-50 border-red-200" : "bg-green-50 border-green-200"
      }`}
    >
      {flash}
    </p>
  )}
  {erreur && (
    <p class="mb-4 text-sm text-red-600">
      {auPied ? "Le pied de page" : "Le menu"} n'a pas pu être lu : {erreur}
    </p>
  )}

  {/* Une page à ajouter, venue de « Pages du site » : d'abord sa place. */}
  {ajoutValide && placeChoisie === null && (
    <div class="mb-6 max-w-3xl rounded-lg border border-bo-accent/50 bg-bo-surface p-4 text-sm">
      <p class="mb-2 font-medium">
        {auPied
          ? `Dans quelle colonne du pied de page placer « ${nomAAjouter || hrefAAjouter} » ?`
          : `Où placer « ${nomAAjouter || hrefAAjouter} » dans le menu ?`}
      </p>
      <div class="flex flex-wrap gap-2">
        {entrees
          .filter((e) => auPied && e.id)
          .map((e) => (
            <a href={lienPlace(e.id)} class={boutonDiscret}>
              Dans « {e.label} »
            </a>
          ))}
        <a href={lienPlace("0")} class={boutonDiscret}>
          {auPied ? "Dans une nouvelle colonne" : "Au premier niveau"}
        </a>
        {entrees
          .filter((e) => !auPied && e.id)
          .map((e) => (
            <a href={lienPlace(e.id)} class={boutonDiscret}>
              Sous « {e.label} »
            </a>
          ))}
        <a href={adresseEcran} class="px-2 py-1.5 text-bo-muted hover:underline">Annuler</a>
      </div>
      <p class="mt-2 text-xs text-bo-muted">
        Rien n'est enregistré à ce stade : la ligne est préparée, vous la
        placez avec les flèches, puis « {mots.enregistrer} ».
      </p>
    </div>
  )}
  {ajoutPrepare && (
    <p class="mb-4 max-w-3xl rounded border border-amber-200 bg-amber-50 px-3 py-2 text-sm">
      {ajoutPrepare} Placez-le avec les flèches ↑ ↓, puis cliquez
      « {mots.enregistrer} » : rien n'est enregistré avant.
    </p>
  )}

  {auPied ? (
