---
/**
 * Les couleurs d'un dessin : ce que le client pourra changer, et sous quel
 * nom.
 *
 * L'ÉCRAN SE LIT DE HAUT EN BAS, SANS RIEN SAVOIR DES DESSINS. L'écran
 * d'avant (« incompréhensible », retour cliente) alignait des cartes à « une
 * seule teinte », des menus « Rattacher à… Couleur 1 » — une couleur 1
 * écrite nulle part —, et des vignettes où la partie concernée était peinte
 * en ROUGE : une marinière bleu nuit y passait pour un t-shirt rouge. Ici :
 *   - une phrase dit d'abord ce que le client pourra changer ;
 *   - une ligne par couleur : sa pastille, l'endroit du dessin où elle se
 *     trouve (dans SA couleur, cerné d'un trait, le reste en gris), le nom
 *     que le client lira, et la case « Le client peut la changer » ;
 *   - ce qui corrige la lecture du dessin (couleur de départ, teintes
 *     réunies, relire le dessin, remettre ses couleurs) attend, replié, sous
 *     « Réglages avancés ». « Suit la couleur de… » y figurait aussi : la
 *     boutique l'a fait retirer (octobre 2026).
 *
 * DEUX SORTES DE DESSINS, UN SEUL ÉCRAN. Un dessin VECTORIEL se range en
 * zones réunies en groupes ; une image EN PIXELS (une photo, une illustration
 * enregistrée en SVG — les chiens et les chats téléversés) se range en
 * FAMILLES de teintes (cf. couleurs-image.ts). Le bouton est le même, et c'est
 * le fichier qui décide : la boutique n'a pas à savoir de quelle sorte est son
 * dessin. Les réglages sont les mêmes des deux côtés.
 *
 * Un dessin vectorisé par IA ou exporté de Canva arrive avec des dizaines de
 * nuances presque identiques. La lecture du dessin les range en zones et
 * réunit les nuances proches en GROUPES : le client choisit une couleur par
 * groupe, et les ombres suivent (cf. couleurs-groupes.ts). Une ligne de
 * l'écran est un groupe.
 *
 * Deux usages :
 *   - `enregistrer` fourni (cartes des pièces) : chaque changement part tout
 *     de suite à cette adresse, comme les autres réglages de la page ;
 *   - sinon (fiche personnage, nouvelle pièce) : l'état vit dans la page, et
 *     c'est le formulaire qui l'envoie. `champs` nomme alors les champs
 *     cachés à remplir, et l'événement « groupes:change » prévient la page.
 * La page peut demander une lecture d'un nouveau dessin en envoyant
 * l'événement « groupes:detecter » ({ url }) au bloc.
 *
 * À placer APRÈS <ApercusZones /> dans la page : les vignettes des groupes
 * passent par lui.
 *
 * UNE PIÈCE SUIT SA CATÉGORIE tant qu'on ne touche pas à ses cases : la
 * catégorie propose toutes ses couleurs (le réglage de départ depuis 0068 :
 * une rangée par famille de teinte, les ombres suivant la couleur choisie,
 * cf. famillesDeLaPiece) ou seulement la principale (la plus étendue, ombres
 * comprises), et les cases montrent ce que cela donne. Cocher ou décocher une
 * case règle la pièce à la main, et ce réglage passe avant celui de la
 * catégorie ; « Refaire comme la catégorie » le retire (cf.
 * couleurs-groupes.ts, groupesProposesDeLaPiece).
 *
 * LES OMBRES N'ONT PAS DE CASE. Une ombre suit sa couleur sur le site : sa
 * ligne le dit (« ombre de « Couleur 2 », elle la suit »), et c'est la case
 * de sa couleur qui la propose ou la retire avec elle. Une case à elle
 * laissait croire qu'on pouvait la proposer seule, et la décocher figeait un
 * liseré vert foncé sous des manches rouges. Une couleur prise à tort pour
 * une ombre — la visière d'une casquette — se sépare d'un clic (« Séparer »,
 * cf. GroupeCouleur.separee) et retrouve sa rangée.
 *
 * UN ACCESSOIRE A SES COULEURS PARTIE PAR PARTIE. « C'est moi qui dois les
 * changer, en ajouter et en supprimer si je veux. Pas de sélecteur pour les
 * gens » (Margaux, 20 octobre 2026). Chaque couleur en tête d'une rangée du
 * client reçoit, sous sa ligne, la liste des pastilles qu'il aura pour elle :
 * le nuancier rangeable des catégories (lib/pastilles.ts, creerNuancier),
 * enregistré aussitôt comme le reste (cf. GroupeCouleur.couleurs). Sans
 * liste, la partie propose le nuancier de sa catégorie ; « Reprendre les
 * couleurs de la catégorie » efface la liste. Le client n'a jamais de
 * saisie libre sur un accessoire (cf. pastillesDeLaRangee).
 */
import type {
  CouleursImage,
  CouleursProposees,
  GroupeCouleur,
} from "@memoryline/types";

interface Props {
  /**
   * « piece » : la catégorie décide, sauf réglage propre à la pièce.
   * « personnage » : seule la peau (le premier groupe) l'est par défaut.
   */
  mode: "piece" | "personnage";
  apiUrl: string;
  svgUrl: string | null;
  zones: Record<string, string> | null;
  groupes: GroupeCouleur[] | null | undefined;
  /**
   * Pièce : zones de référence des groupes masqués — le réglage PROPRE à la
   * pièce. Null (ou absent) : la pièce suit le réglage de sa catégorie.
   */
  masquees?: string[] | null;
  /**
   * Pièce : sa catégorie, et ce qu'elle propose au client. Null : aucune
   * catégorie qui compte (aucune, archivée, décochée) — toutes les couleurs,
   * comme le réglage de départ. `nuancier` : ses couleurs, que propose une
   * partie d'accessoire sans liste à elle.
   */
  regle?: { categorie: string; couleurs: CouleursProposees; nuancier?: string[] } | null;
  /**
   * Pièce : de quoi régler les couleurs de chaque partie d'un ACCESSOIRE
   * (cf. GroupeCouleur.couleurs). `oui` : la pièce est de cet emplacement —
   * la page de création le change par l'événement « groupes:emplacement »
   * ({ accessoire }) ; `repli` : ce que propose une partie sans liste quand
   * sa catégorie n'a pas de couleurs — le nuancier des vêtements des
   * personnages, comme dans le module (presetPaletteForSlot).
   */
  accessoire?: { oui: boolean; repli: string[] } | null;
  /** Pièce : la part du dessin peinte par chaque zone (couleur principale). */
  parts?: Record<string, number> | null;
  /** Personnage : zones de référence des groupes proposés (null = la peau). */
  proposees?: string[] | null;
  /**
   * Familles de couleurs, quand le dessin est une image en PIXELS. Null = ce
   * n'est pas le cas, ou rien n'a encore été détecté.
   */
  couleursImage?: CouleursImage | null;
  /** Adresse d'enregistrement automatique (relative à l'API). */
  enregistrer?: string;
  /** Champs cachés à tenir à jour pour un formulaire. */
  champs?: { zones: string; groupes: string; masquees: string; familles: string };
  /** Cadrage de repli des vignettes (viewBox). */
  cadrage?: string;
  /** Texte d'aide sous la phrase du haut. */
  aide?: string;
  /**
   * Sans enregistrement automatique : ce que la page rappelle après chaque
   * changement (« Pensez à enregistrer le dessin. »).
   */
  rappel?: string;
  /**
   * Personnage : les nuanciers qu'une couleur du dessin peut proposer — les
   * quatre des personnages, tels que la boutique les a réglés, et ceux des
   * catégories de pièces. Sans eux, le menu « Nuancier » ne propose que les
   * quatre, avec leurs couleurs d'origine.
   */
  nuanciers?: {
    base: Record<string, string[]>;
    categories: { slug: string; name: string; colors: string[] }[];
  } | null;
}

const {
  mode,
  apiUrl,
  svgUrl,
  zones,
  groupes,
  masquees,
  regle,
  parts,
  proposees,
  couleursImage,
  enregistrer,
  champs,
  cadrage,
  aide,
  rappel,
  nuanciers,
  accessoire,
} = Astro.props;

const etat = {
  mode,
  svgUrl: svgUrl ?? "",
  zones: zones ?? {},
  groupes: groupes ?? null,
  // Null se garde tel quel : il veut dire « suit sa catégorie », pas « rien
  // de masqué ».
  masquees: masquees ?? null,
  regle: regle ?? null,
  parts: parts ?? null,
  proposees: proposees ?? null,
  couleursImage: couleursImage ?? null,
  nuanciers: nuanciers ?? null,
  accessoire: accessoire ?? null,
};
// « < » échappé : un nom de groupe ne doit pas pouvoir fermer la balise.
const json = JSON.stringify(etat).replace(/</g, "\\u003c");
const src = (u: string | null) =>
  !u ? undefined : u.startsWith("http") ? u : `${apiUrl}${u}`;
const bouton =
  "rounded border border-bo-border bg-bo-surface px-2.5 py-1 text-xs hover:bg-bo-bg";
---

<div
  class="js-groupes"
  data-api={apiUrl}
  data-enregistrer={enregistrer}
  data-apercu-svg={src(svgUrl)}
  data-apercu-cadrage={cadrage ?? "0 0 500 1000"}
  data-rappel={rappel}
>
  <script is:inline type="application/json" class="js-groupes-etat" set:html={json} />
  <div class="mb-1.5 flex flex-wrap items-baseline gap-x-3 gap-y-1">
    <p class="js-groupes-resume text-sm"></p>
    <span class="js-groupes-statut text-xs text-bo-muted"></span>
  </div>
  <div class="js-groupes-regle"></div>
  {aide && <p class="mb-2 text-xs text-bo-muted">{aide}</p>}
  <div class="js-groupes-liste flex flex-col gap-1.5"></div>
  <details class="js-groupes-avance mt-2 text-xs">
    <summary class="cursor-pointer select-none text-bo-muted hover:text-bo-ink">
      Réglages avancés — seulement si les couleurs du dessin ont été mal lues
    </summary>
    <div class="mt-2 flex flex-col gap-2 rounded border border-dashed border-bo-border p-2">
      <div class="js-groupes-avance-liste flex flex-col gap-2"></div>
      <div class="flex flex-wrap gap-2">
        <button
          type="button"
          class={`js-groupes-remettre ${bouton}`}
          title="Remet à chaque couleur celle du fichier du dessin. Les noms et les cases sont gardés."
        >
          Remettre les couleurs du dessin
        </button>
        <button
          type="button"
          class={`js-groupes-detecter ${bouton}`}
          title="Relit les couleurs du dessin et réunit les teintes proches. Le fichier d'origine est conservé."
        >
          Relire le dessin
        </button>
      </div>
    </div>
  </details>
  {champs && (
    <>
      <input type="hidden" name={champs.zones} class="js-champ-zones" value="{}" />
      <input type="hidden" name={champs.groupes} class="js-champ-groupes" value="[]" />
      <input type="hidden" name={champs.masquees} class="js-champ-masquees" value="null" />
      <input type="hidden" name={champs.familles} class="js-champ-familles" value="" />
    </>
  )}
</div>

<script>
  import {
    NUANCIERS_BASE,
    couleursDuGroupe,
    couleursProposees,
    famillesDeLaPiece,
    famillesDuDessin,
    groupesDuDessin,
    groupesProposesDeLaPiece,
    hexVersRgb,
    memeCouleur,
    partEnPourcent,
    rgbVersHex,
    teintesDeLaFamille,
    zonesDuGroupe,
    type CouleursImage,
    type CouleursProposees,
    type FamilleCouleur,
    type GroupeCouleur,
    type MotifSansCouleur,
    type NuancierBase,
    LIBELLES_NUANCIERS_BASE,
    couleursDuNuancier,
    estNuancier,
    type Nuancier,
    COULEURS_PARTIE_MAX,
    NUANCIERS_PAR_DEFAUT,
    couleurHexPropre,
  } from "@memoryline/types/couleurs";
  import { creerNuancier } from "../lib/pastilles.ts";

  declare global {
    interface Window {
      /** Remplit les vignettes « où est cette couleur ? » d'un bloc (ApercusZones). */
      mlApercusZones?: (bloc: HTMLElement) => void;
    }
  }

  /** La catégorie d'une pièce, et ce qu'elle propose au client. */
  interface RegleCategorie {
    categorie: string;
    couleurs: CouleursProposees;
    /** Son nuancier : les pastilles d'une partie d'accessoire sans liste à elle. */
    nuancier: string[];
  }

  /** L'état d'un bloc : le dessin, ses zones, ses groupes, ce qui est caché. */
  interface Etat {
    mode: "piece" | "personnage";
    svgUrl: string;
    zones: Record<string, string>;
    groupes: GroupeCouleur[];
    /** Zones de référence des groupes NON proposés au client. */
    cachees: string[];
    /** Familles de teintes, quand le dessin est une image en pixels. */
    couleursImage: CouleursImage | null;
    /**
     * Pièce : a-t-elle son PROPRE réglage (des cases touchées) ? Sinon, ce
     * qui est caché vient de la règle de sa catégorie, recalculée à chaque
     * changement des groupes.
     */
    propre: boolean;
    /** Pièce : sa catégorie et sa règle (null : tout est proposé). */
    regle: RegleCategorie | null;
    /** Pièce : la part du dessin peinte par chaque zone (couleur principale). */
    parts: Record<string, number> | null;
    /**
     * Pièce de l'emplacement « Accessoires » : chaque partie proposée a sa
     * liste de couleurs à régler (cf. GroupeCouleur.couleurs).
     */
    accessoire: boolean;
    /** Les pastilles d'une partie d'accessoire sans liste ni catégorie à couleurs. */
    repli: string[];
  }

  /** Une liste de couleurs reçue de la page : « #RRGGBB », sans doublon. */
  function couleursLues(brut: unknown): string[] {
    if (!Array.isArray(brut)) return [];
    const out: string[] = [];
    for (const v of brut) {
      const c = couleurHexPropre(v);
      if (c && !out.includes(c)) out.push(c);
    }
    return out;
  }

  /** La règle reçue de la page, nettoyée. */
  function regleLue(brut: unknown): RegleCategorie | null {
    if (!brut || typeof brut !== "object") return null;
    const r = brut as Record<string, unknown>;
    if (typeof r.categorie !== "string") return null;
    return {
      categorie: r.categorie,
      couleurs: couleursProposees(r.couleurs),
      nuancier: couleursLues(r.nuancier),
    };
  }

  /** « 1 couleur proposée », « 4 couleurs proposées ». */
  const couleursProposeesEnMots = (n: number) =>
    `${n} couleur${n > 1 ? "s" : ""} proposée${n > 1 ? "s" : ""}`;

  /** La pièce telle que le site la lit (couleurs-groupes.ts). */
  function pieceDe(etat: Etat, propre = etat.propre) {
    return {
      colorZones: etat.zones,
      groupesCouleurs: etat.groupes,
      partsDesZones: etat.parts,
      // Une pièce qui suit sa catégorie n'a pas de liste : c'est ce qui la
      // distingue d'une pièce réglée à la main qui ne masquerait rien.
      zonesMasquees: propre ? etat.cachees : null,
    };
  }

  /**
   * Les rangées de pastilles qu'aura le client, dans son ordre : les mêmes
   * que sur le site (groupesProposesDeLaPiece), pour que l'écran du
   * back-office dise exactement ce que le client verra. Chaque rangée a sa
   * couleur en tête et ses ombres en nuances : toutes les familles de teinte
   * sous « toutes », la principale seule sous « principale », celles des
   * couleurs cochées pour une pièce réglée à la main.
   */
  function rangeesDuClient(etat: Etat, propre = etat.propre): GroupeCouleur[] {
    return groupesProposesDeLaPiece(pieceDe(etat, propre), etat.regle?.couleurs ?? null);
  }

  /**
   * Ce que la règle de la catégorie ne propose pas : les groupes qu'aucune
   * rangée du client ne recolore, ni en tête ni en ombre. Rien sous
   * « toutes » ; sous « principale », tout sauf la principale et ses ombres.
   * C'est de là que part le réglage à la main quand on touche une case : il
   * propose d'abord exactement la même chose.
   */
  function cacheesDeLaRegle(etat: Etat): string[] {
    const couvertes = new Set(rangeesDuClient(etat, false).flatMap(zonesDuGroupe));
    return etat.groupes.filter((g) => !couvertes.has(g.zone)).map((g) => g.zone);
  }

  /** Réponse de l'API après lecture d'un dessin. */
  interface Lecture {
    url: string;
    colorZones: Record<string, string>;
    groupesCouleurs: GroupeCouleur[];
    zonesCreees: number;
    images: number;
    couleursImage: CouleursImage | null;
    /** Pourquoi rien n'est sorti d'une image. Absent si la lecture a donné. */
    motif?: MotifSansCouleur;
    /** La phrase toute faite qui va avec le motif (fabriquée par l'API). */
    phrase?: string;
  }

  /** Le dessin en cours est-il une image en pixels ? */
  function enPixels(etat: Etat): boolean {
    return (etat.couleursImage?.familles.length ?? 0) > 0;
  }

  /**
   * Les couleurs écrites dans le fichier d'un dessin vectoriel, zone par
   * zone : les règles « .stN{fill:…} » de son bloc <style>, lues comme les
   * lit recolorSvg (@memoryline/types).
   */
  function couleursDuFichier(svg: string): Record<string, string> {
    const out: Record<string, string> = {};
    const regle = /\.(st\d+)\s*\{[^}]*?fill\s*:\s*(#[0-9a-fA-F]{3,8})/g;
    for (let m = regle.exec(svg); m; m = regle.exec(svg)) {
      const rgb = hexVersRgb(m[2]!);
      if (rgb && !out[m[1]!]) out[m[1]!] = rgbVersHex(...rgb);
    }
    return out;
  }

  /**
   * Les réglages d'avant reportés sur une nouvelle lecture d'un dessin EN
   * PIXELS : une famille qui retrouve sa teinte de référence reprend son nom,
   * sa case, sa couleur par défaut, son nuancier — ET SA CLÉ.
   *
   * La clé compte plus que le reste : c'est elle que portent les paniers et
   * les commandes déjà passés. La perdre ferait retomber une affiche commandée
   * sur les couleurs du fichier, sans que rien ne le signale.
   */
  function reprendreFamilles(
    anciennes: FamilleCouleur[],
    nouvelles: FamilleCouleur[],
  ): FamilleCouleur[] {
    const prises = new Set<string>();
    return nouvelles.map((f) => {
      const ancienne = anciennes.find(
        (a) => !prises.has(a.cle) && memeCouleur(a.reference, f.reference),
      );
      if (!ancienne) return f;
      prises.add(ancienne.cle);
      return {
        ...f,
        cle: ancienne.cle,
        ...(ancienne.nom ? { nom: ancienne.nom } : {}),
        ...(ancienne.proposee ? { proposee: true } : {}),
        ...(ancienne.defaut ? { defaut: ancienne.defaut } : {}),
        ...(ancienne.nuancier ? { nuancier: ancienne.nuancier } : {}),
        // Les couleurs proposées pour cette partie d'un accessoire : la
        // boutique les a choisies une à une, une relecture ne les perd pas.
        ...(ancienne.couleurs?.length ? { couleurs: ancienne.couleurs } : {}),
      };
    });
  }

  /* ---------------------------------------------------------------------- */
  /*  Vignettes « où est cette famille ? »                                   */
  /* ---------------------------------------------------------------------- */

  const ESTOMPE_FAMILLE = "#D1D5DB";

  /** Les cartes de teintes déjà décodées : une par dessin, pas une par famille. */
  const cartes = new Map<string, Promise<ImageData | null>>();

  /**
   * La carte des teintes d'un dessin, décodée.
   *
   * C'est le serveur qui l'a écrite au moment de la détection : une vignette
   * minuscule où le niveau de gris de chaque pixel dit à quelle TEINTE il
   * appartient. On la relit ici pour colorier n'importe quelle famille — y
   * compris celles que la boutique vient de réunir à l'instant, et qu'aucune
   * vignette toute faite ne pourrait montrer.
   */
  function carteDecodee(carte: string): Promise<ImageData | null> {
    let en = cartes.get(carte);
    if (!en) {
      en = new Promise<ImageData | null>((fin) => {
        const image = new Image();
        image.onload = () => {
          try {
            const toile = document.createElement("canvas");
            toile.width = image.naturalWidth;
            toile.height = image.naturalHeight;
            const ctx = toile.getContext("2d");
            if (!ctx) return fin(null);
            ctx.drawImage(image, 0, 0);
            fin(ctx.getImageData(0, 0, toile.width, toile.height));
          } catch {
            fin(null); // canevas verrouillé : pas de vignette, rien de cassé
          }
        };
        image.onerror = () => fin(null);
        image.src = carte;
      });
      cartes.set(carte, en);
    }
    return en;
  }

  /**
   * Le dessin avec les teintes voulues dans LEUR couleur et le reste en gris,
   * en image prête à poser dans une vignette. `null` si la carte manque.
   *
   * Pas de rouge vif : un pelage fauve surligné en rouge passait pour un
   * pelage rouge. La couleur de la famille dit la même chose sans mentir.
   *
   * Les niveaux de gris de la carte sont espacés de 25 : on cherche donc le
   * plus proche, pour qu'un arrondi du décodage ne fasse pas changer une
   * teinte de famille.
   */
  async function vignetteDeFamille(
    couleursImage: CouleursImage,
    teintes: string[],
    couleur: string,
  ): Promise<string | null> {
    if (!couleursImage.carte || !couleursImage.carteTeintes?.length) return null;
    const source = await carteDecodee(couleursImage.carte);
    if (!source) return null;
    const NIVEAU_BASE = 20;
    const NIVEAU_PAS = 25;
    const voulus = new Set(
      couleursImage.carteTeintes
        .map((t, i) => (teintes.some((x) => memeCouleur(x, t)) ? i : -1))
        .filter((i) => i >= 0),
    );
    const toile = document.createElement("canvas");
    toile.width = source.width;
    toile.height = source.height;
    const ctx = toile.getContext("2d");
    if (!ctx) return null;
    const sortie = ctx.createImageData(source.width, source.height);
    const voulue = hexVersRgb(couleur) ?? hexVersRgb("#111827")!;
    const gris = hexVersRgb(ESTOMPE_FAMILLE)!;
    for (let i = 0; i < source.data.length; i += 4) {
      if (source.data[i + 3]! < 128) continue; // hors dessin
      const rang = Math.round((source.data[i]! - NIVEAU_BASE) / NIVEAU_PAS);
      const c = voulus.has(rang) ? voulue : gris;
      sortie.data[i] = c[0];
      sortie.data[i + 1] = c[1];
      sortie.data[i + 2] = c[2];
      sortie.data[i + 3] = 255;
    }
    ctx.putImageData(sortie, 0, 0);
    try {
      return toile.toDataURL("image/png");
    } catch {
      return null;
    }
  }

  /** Ce que la page fournit pour le menu « Nuancier » d'un personnage. */
  interface NuanciersProposes {
    base: Partial<Record<NuancierBase, string[]>>;
    categories: { slug: string; name: string; colors: string[] }[];
  }

  /** Les nuanciers reçus de la page, nettoyés ; null s'il n'y en a pas. */
  function nuanciersLus(brut: unknown): NuanciersProposes | null {
    if (!brut || typeof brut !== "object") return null;
    const r = brut as Record<string, unknown>;
    const base =
      r.base && typeof r.base === "object" ? (r.base as Partial<Record<NuancierBase, string[]>>) : {};
    const categories = Array.isArray(r.categories)
      ? (r.categories as { slug: string; name: string; colors: string[] }[]).filter(
          (c) => c && typeof c.slug === "string" && Array.isArray(c.colors),
        )
      : [];
    return { base, categories };
  }

  /** Les zones de référence cachées, quel que soit le mode d'enregistrement. */
  function cacheesDepuis(
    mode: Etat["mode"],
    groupes: GroupeCouleur[],
    masquees: string[],
    proposees: string[] | null,
  ): string[] {
    if (mode === "piece")
      return groupes.filter((g) => masquees.includes(g.zone)).map((g) => g.zone);
    // Personnage : null = la peau seule, la règle d'avant ce réglage.
    const ouvertes = proposees ?? groupes.slice(0, 1).map((g) => g.zone);
    return groupes.filter((g) => !ouvertes.includes(g.zone)).map((g) => g.zone);
  }

  /**
   * Les réglages d'avant reportés sur une nouvelle lecture du MÊME dessin :
   * un groupe qui partage une zone avec un ancien en reprend le nom, le
   * nuancier, la case et les couleurs par défaut réglées ici. Les zones
   * nouvelles (couleurs qui étaient écrites sur les formes) partent des
   * couleurs du fichier, proposées pour une pièce, pas pour un personnage.
   */
  function reprendre(ancien: Etat, lecture: Lecture, garder: boolean): Etat {
    // Dessin en PIXELS : il n'a ni zone ni groupe, seulement des familles de
    // teintes. On garde les réglages d'avant quand c'est le même dessin.
    if (lecture.couleursImage) {
      const nouvelles = famillesDuDessin(lecture.couleursImage);
      return {
        ...ancien,
        svgUrl: lecture.url,
        zones: {},
        groupes: [],
        cachees: [],
        couleursImage: {
          ...lecture.couleursImage,
          familles: garder
            ? reprendreFamilles(ancien.couleursImage?.familles ?? [], nouvelles)
            : nouvelles,
        },
      };
    }
    const zones = { ...lecture.colorZones };
    const groupes = groupesDuDessin(zones, lecture.groupesCouleurs);
    if (!garder || Object.keys(ancien.zones).length === 0) {
      return {
        ...ancien,
        svgUrl: lecture.url,
        zones,
        groupes,
        cachees: cacheesDepuis(ancien.mode, groupes, [], null),
        // Ce dessin-ci est vectoriel : les familles d'un dessin en pixels
        // remplacé n'ont plus rien à décrire.
        couleursImage: null,
        // Un autre dessin : les parts mesurées sur l'ancien ne valent plus.
        // L'API mesure le nouveau à l'enregistrement ; d'ici là, la
        // principale est le premier groupe — la zone la plus étendue, pour un
        // dessin préparé par la lecture.
        parts: null,
      };
    }
    for (const z of Object.keys(zones))
      if (ancien.zones[z]) zones[z] = ancien.zones[z]!;
    const cachees: string[] = [];
    const reprises = groupes.map((g) => {
      const membres = zonesDuGroupe(g);
      const anciens = ancien.groupes.filter((a) =>
        zonesDuGroupe(a).some((z) => membres.includes(z)),
      );
      const cache =
        anciens.length > 0
          ? anciens.every((a) => ancien.cachees.includes(a.zone))
          : ancien.mode === "personnage";
      if (cache) cachees.push(g.zone);
      const nomme = anciens.find((a) => a.nom);
      const nuancier = anciens.find((a) => a.nuancier)?.nuancier;
      // Une couleur que la boutique a séparée de sa teinte reste à part : la
      // relecture ne dit rien de plus sur le dessin que ce qu'elle a vu.
      const separee = anciens.some((a) => a.separee);
      // Les couleurs proposées pour une partie d'accessoire suivent le
      // groupe, comme son nom : celles de la tête d'abord, qui sont celles
      // que le client voyait.
      const avecListe = anciens.filter((a) => a.couleurs?.length);
      const couleurs = (avecListe.find((a) => a.zone === g.zone) ?? avecListe[0])?.couleurs;
      return {
        ...g,
        ...(nomme?.nom ? { nom: nomme.nom } : {}),
        ...(nuancier ? { nuancier } : {}),
        ...(separee ? { separee: true as const } : {}),
        ...(couleurs?.length ? { couleurs } : {}),
      };
    });
    return {
      ...ancien,
      svgUrl: lecture.url,
      zones,
      groupes: reprises,
      cachees,
      couleursImage: null,
      // Même dessin, mêmes parts ; une version préparée à part n'a pas
      // encore été mesurée.
      parts: lecture.url === ancien.svgUrl ? ancien.parts : null,
    };
  }

  /** Ce qu'une ligne de l'écran montre et ce qu'elle fait. */
  interface Ligne {
    /** Ce qui désigne la couleur d'un dessin à l'autre : sa zone, ou sa clé. */
    cle: string;
    /** La couleur de départ, en pastille. */
    couleur: string;
    /** La vignette « où est cette couleur sur le dessin ? ». */
    vignette: HTMLElement;
    /** « Couleur 2 » : ce que les menus des réglages avancés en disent. */
    libelle: string;
    nom: string | undefined;
    /** Exemple de nom, dans l'indication du champ (« ex. Rayures »). */
    exemple: string;
    onNom: (nom: string | undefined) => void;
    proposee: boolean;
    onProposee: (oui: boolean) => void;
    /**
     * Pièce : la couleur est l'OMBRE d'une autre, qu'elle suit sur le site.
     * Pas de case à elle — celle de sa couleur décide pour les deux —, mais
     * de quoi la séparer si elle a été prise à tort pour une ombre.
     */
    ombre?: { separer: () => void };
    /**
     * Pièce : couleur séparée par la boutique, qui suivrait sans cela la
     * couleur `de` comme une ombre : de quoi l'y réunir de nouveau.
     */
    separee?: { de: string; reunir: () => void };
    /** Ce qu'il faut savoir de plus, en petit (« couleur principale »). */
    notes: string[];
    /**
     * Personnage : le nuancier que le client aura pour cette couleur, et celui
     * qu'il aurait sans réglage (`repli` : la peau pour la première, les
     * vêtements pour les autres, le pelage pour une image en pixels).
     */
    nuancier?: {
      valeur: Nuancier | undefined;
      repli: NuancierBase;
      onChange: (n: Nuancier) => void;
    };
    /**
     * Accessoire, en tête d'une rangée du client : les couleurs qu'il aura
     * pour cette partie — sa liste propre (`propres`, vide : aucune), sinon
     * celles dont elle hérite (`heritees` : le nuancier de la catégorie, ou
     * celui de repli).
     */
    pastilles?: {
      propres: string[];
      heritees: { source: string; couleurs: string[] };
      onChange: (couleurs: string[]) => void;
    };
  }

  function monter(bloc: HTMLElement) {
    const api = bloc.dataset.api ?? "";
    const adresseEnregistrement = bloc.dataset.enregistrer;
    const liste = bloc.querySelector<HTMLElement>(".js-groupes-liste")!;
    const avance = bloc.querySelector<HTMLElement>(".js-groupes-avance-liste")!;
    const resume = bloc.querySelector<HTMLElement>(".js-groupes-resume")!;
    const zoneRegle = bloc.querySelector<HTMLElement>(".js-groupes-regle")!;
    const statut = bloc.querySelector<HTMLElement>(".js-groupes-statut")!;
    const source = bloc.querySelector<HTMLScriptElement>(".js-groupes-etat")!;
    const brut = JSON.parse(source.textContent || "{}");
    const groupesInitiaux = groupesDuDessin(brut.zones, brut.groupes);
    // Les nuanciers proposés au menu « Nuancier » (personnage seulement) :
    // ils ne changent pas pendant la visite, on les garde tels quels.
    const nuanciers = nuanciersLus(brut.nuanciers);
    let etat: Etat = {
      mode: brut.mode === "personnage" ? "personnage" : "piece",
      svgUrl: brut.svgUrl ?? "",
      zones: brut.zones ?? {},
      groupes: groupesInitiaux,
      cachees: cacheesDepuis(
        brut.mode,
        groupesInitiaux,
        Array.isArray(brut.masquees) ? brut.masquees : [],
        Array.isArray(brut.proposees) ? brut.proposees : null,
      ),
      couleursImage: brut.couleursImage
        ? {
            ...brut.couleursImage,
            familles: famillesDuDessin(brut.couleursImage),
          }
        : null,
      // Une liste, même vide, est le réglage de la pièce ; null, celui de
      // sa catégorie (les cases se recalculent alors dans dessiner()).
      propre: brut.mode !== "personnage" && Array.isArray(brut.masquees),
      regle: regleLue(brut.regle),
      parts:
        brut.parts && typeof brut.parts === "object"
          ? (brut.parts as Record<string, number>)
          : null,
      accessoire: brut.mode !== "personnage" && brut.accessoire?.oui === true,
      // Sans nuancier reçu, celui d'origine des vêtements : c'est aussi ce
      // que le module montre quand l'API ne dit rien.
      repli: couleursLues(brut.accessoire?.repli).length
        ? couleursLues(brut.accessoire?.repli)
        : [...NUANCIERS_PAR_DEFAUT.vetements],
    };
    let visible = false;

    const dire = (texte: string, ton: "ok" | "erreur" | "" = "") => {
      statut.textContent = texte;
      statut.className =
        "js-groupes-statut text-xs " +
        (ton === "ok" ? "text-green-700" : ton === "erreur" ? "text-red-600" : "text-bo-muted");
    };

    /** Ce que la page (ou l'API) enregistre. */
    function aEnregistrer() {
      const references = etat.groupes.map((g) => g.zone);
      return {
        svgUrl: etat.svgUrl,
        colorZones: etat.zones,
        groupesCouleurs: etat.groupes,
        // Une pièce qui suit sa catégorie n'enregistre AUCUNE liste : en
        // écrire une, même identique, figerait ses couleurs le jour où la
        // catégorie changera d'avis.
        zonesMasquees:
          etat.mode === "piece" && !etat.propre
            ? null
            : etat.cachees.filter((z) => references.includes(z)),
        zonesProposees: references.filter((z) => !etat.cachees.includes(z)),
        couleursImage: etat.couleursImage,
      };
    }

    function publier() {
      const e = aEnregistrer();
      // La règle et les parts voyagent avec : `source` est relu tel quel si
      // la page remonte le bloc.
      source.textContent = JSON.stringify({
        mode: etat.mode,
        ...e,
        masquees: e.zonesMasquees,
        regle: etat.regle,
        parts: etat.parts,
        nuanciers,
        accessoire: { oui: etat.accessoire, repli: etat.repli },
      });
      const champ = (c: string) => bloc.querySelector<HTMLInputElement>(c);
      const cz = champ(".js-champ-zones");
      if (cz) cz.value = JSON.stringify(e.colorZones);
      const cg = champ(".js-champ-groupes");
      if (cg) cg.value = JSON.stringify(e.groupesCouleurs);
      const cm = champ(".js-champ-masquees");
      if (cm) cm.value = JSON.stringify(e.zonesMasquees);
      const cf = champ(".js-champ-familles");
      if (cf) cf.value = e.couleursImage ? JSON.stringify(e.couleursImage) : "";
      bloc.dispatchEvent(new CustomEvent("groupes:change", { detail: e }));
    }

    /** Sans enregistrement automatique, la page rappelle ce qu'il reste à faire. */
    const rappeler = (message: string) =>
      bloc.dataset.rappel ? `${message} ${bloc.dataset.rappel}` : message;

    async function enregistrerTout(message: string) {
      publier();
      if (!adresseEnregistrement) {
        if (bloc.dataset.rappel) dire(rappeler(message));
        return;
      }
      dire("Enregistrement…");
      try {
        const e = aEnregistrer();
        const res = await fetch(`${api}${adresseEnregistrement}`, {
          method: "POST",
          credentials: "include",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            svgUrl: e.svgUrl,
            colorZones: e.colorZones,
            groupesCouleurs: e.groupesCouleurs,
            zonesMasquees: e.zonesMasquees,
            couleursImage: e.couleursImage,
          }),
        });
        if (!res.ok) {
          // L'API dit pourquoi elle refuse (une couleur mal écrite) : on le
          // répète tel quel, plutôt qu'un numéro d'erreur.
          const raison = await res
            .json()
            .then((r: { error?: unknown }) => (typeof r?.error === "string" ? r.error : ""))
            .catch(() => "");
          throw new Error(raison || "HTTP " + res.status);
        }
        dire(`${message} Enregistré ✓`, "ok");
      } catch (err) {
        dire(
          "Erreur, rien n'est enregistré : " + (err instanceof Error ? err.message : String(err)),
          "erreur",
        );
      }
    }

    const el = <K extends keyof HTMLElementTagNameMap>(
      tag: K,
      classe = "",
      texte = "",
    ): HTMLElementTagNameMap[K] => {
      const n = document.createElement(tag);
      if (classe) n.className = classe;
      if (texte) n.textContent = texte;
      return n;
    };

    const nomAffiche = (g: GroupeCouleur, i: number) =>
      g.nom || `Couleur ${i + 1}`;
    const nomDeFamille = (f: FamilleCouleur, i: number) =>
      f.nom || `Couleur ${i + 1}`;
    /** « Rayures (couleur 2) », ou « Couleur 2 » tant qu'elle n'a pas de nom. */
    const titreAvance = (nom: string | undefined, i: number) =>
      nom ? `${nom} (couleur ${i + 1})` : `Couleur ${i + 1}`;
    const objet = () => (etat.mode === "personnage" ? "de ce personnage" : "de cette pièce");

    /**
     * Ce que propose une partie d'accessoire sans liste à elle, comme le
     * module (pastillesDeLaRangee) : le nuancier de sa catégorie, sinon celui
     * des vêtements des personnages. `source` se lit après « celles ».
     */
    const heriteesDeLaPartie = (): { source: string; couleurs: string[] } => {
      const regle = etat.regle;
      if (regle && regle.nuancier.length)
        return { source: `de la catégorie « ${regle.categorie} »`, couleurs: regle.nuancier };
      return {
        source: regle
          ? `du nuancier « Vêtements » des personnages (la catégorie « ${regle.categorie} » n'a pas de couleurs)`
          : // Aucune catégorie, ou une archivée, décochée : le site n'en reçoit pas.
            "du nuancier « Vêtements » des personnages (la pièce n'a pas de catégorie active)",
        couleurs: etat.repli,
      };
    };

    /**
     * Les couleurs de la partie `cible` (un groupe, une famille en pixels) :
     * leur liste propre change, et s'enregistre. Vide : la partie reprend
     * celles de sa catégorie.
     */
    const reglerCouleursDeLaPartie = (
      cible: { couleurs?: string[] },
      nom: string,
      couleurs: string[],
    ) => {
      if (couleurs.length) cible.couleurs = [...couleurs];
      else delete cible.couleurs;
      void enregistrerTout(
        couleurs.length
          ? `« ${nom} » : ${couleursProposeesEnMots(couleurs.length)}.`
          : `« ${nom} » reprend les couleurs de la catégorie.`,
      );
    };

    /** La phrase du haut : ce que le client pourra changer, en clair. */
    function resumer(noms: string[]) {
      resume.textContent = "";
      if (noms.length === 0) {
        resume.className = "js-groupes-resume text-sm text-bo-muted";
        resume.textContent = `Le client ne pourra changer aucune couleur ${objet()}.`;
        return;
      }
      resume.className = "js-groupes-resume text-sm";
      resume.append("Le client pourra changer : ");
      noms.forEach((n, i) => {
        if (i > 0) resume.append(", ");
        resume.append(el("strong", "", n));
      });
      resume.append(".");
    }

    /** Une ligne de l'écran : une couleur, et ce que le client pourra en faire. */
    function ligne(l: Ligne): HTMLElement {
      const rangee = el(
        "div",
        "flex flex-wrap items-center gap-x-3 gap-y-1.5 rounded border border-bo-border px-2 py-1.5" +
          (l.proposee ? " bg-bo-surface" : " bg-bo-bg"),
      );
      const pastille = el("span", "h-9 w-9 shrink-0 rounded-full border border-bo-border");
      pastille.style.background = l.couleur;
      pastille.title = `Couleur de départ : ${l.couleur}`;

      const milieu = el("div", "min-w-[11rem] flex-1");
      const nom = el(
        "input",
        "w-full rounded border border-bo-border bg-bo-surface px-2 py-1 text-sm",
      );
      nom.type = "text";
      nom.dataset.cle = `nom:${l.cle}`;
      nom.maxLength = 40;
      nom.value = l.nom ?? "";
      nom.placeholder = `Nom, ${l.exemple}`;
      nom.title = "Le nom que le client lit au-dessus de ses pastilles";
      nom.setAttribute("aria-label", `${l.libelle} : nom que lira le client`);
      nom.addEventListener("change", () => l.onNom(nom.value.trim() || undefined));
      milieu.append(
        nom,
        el("p", "mt-0.5 text-[11px] text-bo-muted", [l.libelle, ...l.notes].join(" · ")),
      );
      rangee.append(pastille, l.vignette, milieu);

      if (l.nuancier) {
        // « Nuancier : » — l'un des quatre des personnages, ou celui d'une
        // catégorie de pièces —, suivi des pastilles qu'il proposera : la
        // boutique voit ce qu'elle choisit, au lieu d'un nom à deviner.
        const n = l.nuancier;
        const choixNuancier = el("div", "flex flex-wrap items-center gap-1.5 text-xs text-bo-muted");
        const etiquette = el("label", "flex items-center gap-1");
        const select = el("select", "rounded border border-bo-border bg-bo-surface px-1 py-0.5 text-bo-ink");
        select.dataset.cle = `pastilles:${l.cle}`;
        const actuel: Nuancier = n.valeur ?? n.repli;
        const groupeBase = el("optgroup");
        groupeBase.label = "Nuanciers des personnages";
        for (const x of NUANCIERS_BASE) {
          const o = el("option", "", LIBELLES_NUANCIERS_BASE[x]);
          o.value = x;
          o.selected = actuel === x;
          groupeBase.append(o);
        }
        select.append(groupeBase);
        const categories = nuanciers?.categories ?? [];
        const groupeCategories = el("optgroup");
        groupeCategories.label = "Catégories de pièces";
        for (const c of categories) {
          const o = el("option", "", c.name);
          o.value = `categorie:${c.slug}`;
          o.selected = actuel === o.value;
          groupeCategories.append(o);
        }
        // Une catégorie choisie puis archivée ou décochée n'est plus dans la
        // liste : son option reste, sans quoi le menu montrerait « Peau » et
        // le premier enregistrement effacerait le choix sans qu'on l'ait vu.
        if (
          actuel.startsWith("categorie:") &&
          !categories.some((c) => `categorie:${c.slug}` === actuel)
        ) {
          const o = el("option", "", `${actuel.slice("categorie:".length)} (catégorie indisponible : le client a « ${LIBELLES_NUANCIERS_BASE[n.repli]} »)`);
          o.value = actuel;
          o.selected = true;
          groupeCategories.append(o);
        }
        if (groupeCategories.children.length) select.append(groupeCategories);

        // Les pastilles du nuancier choisi, dans l'ordre où le client les
        // verra ; elles suivent le menu.
        const apercu = el("span", "flex flex-wrap items-center gap-0.5");
        apercu.setAttribute("aria-hidden", "true");
        const montrerPastilles = (choisi: Nuancier) => {
          apercu.textContent = "";
          for (const hex of couleursDuNuancier(choisi, n.repli, nuanciers?.base, categories)) {
            const p = el("span", "inline-block h-3.5 w-3.5 rounded-full border border-bo-border");
            p.style.background = hex;
            p.title = hex;
            apercu.append(p);
          }
        };
        montrerPastilles(actuel);
        select.addEventListener("change", () => {
          if (!estNuancier(select.value)) return;
          montrerPastilles(select.value);
          n.onChange(select.value);
        });
        etiquette.append("Nuancier :", select);
        etiquette.title = "Les couleurs proposées au client pour celle-ci";
        choixNuancier.append(etiquette, apercu);
        rangee.append(choixNuancier);
      }

      const petitBouton =
        "rounded border border-bo-border bg-bo-surface px-2 py-0.5 text-xs text-bo-accent hover:bg-bo-bg";
      if (l.ombre) {
        // Une ombre n'a pas de case : elle suit sa couleur, proposée ou non
        // avec elle (la note de la ligne le dit). Seul geste utile ici :
        // la séparer, si c'est en fait une partie à part.
        const separer = el("button", petitBouton, "Séparer");
        separer.type = "button";
        separer.dataset.cle = `separer:${l.cle}`;
        separer.title =
          "Ce n'est pas une ombre : le client la changera à part, sur sa propre rangée de pastilles";
        separer.setAttribute("aria-label", `${l.libelle} : séparer de sa teinte`);
        separer.addEventListener("click", l.ombre.separer);
        rangee.append(separer);
        return rangee;
      }

      const choix = el("label", "flex cursor-pointer items-center gap-1.5 text-sm");
      const caseProposee = el("input", "h-4 w-4 cursor-pointer");
      caseProposee.type = "checkbox";
      caseProposee.dataset.cle = `case:${l.cle}`;
      caseProposee.checked = l.proposee;
      caseProposee.addEventListener("change", () => l.onProposee(caseProposee.checked));
      choix.append(caseProposee, el("span", "", "Le client peut la changer"));
      if (l.separee) {
        const reunir = el("button", petitBouton, `Suivre « ${l.separee.de} »`);
        reunir.type = "button";
        reunir.dataset.cle = `reunir:${l.cle}`;
        reunir.title = `Elle redevient une ombre de « ${l.separee.de} » : elle en suivra la couleur, sans rangée à elle`;
        reunir.addEventListener("click", l.separee.reunir);
        rangee.append(reunir);
      }
      rangee.append(choix);
      if (l.pastilles) rangee.append(listeDeLaPartie(l, l.pastilles));
      return rangee;
    }

    /**
     * Sous la ligne d'une partie d'accessoire : les couleurs que le client
     * aura pour elle, à composer et à ranger avec le nuancier des catégories
     * (lib/pastilles.ts) — mêmes gestes, mêmes poignées. Chaque changement
     * s'enregistre aussitôt, comme les autres réglages de la pièce.
     *
     * TANT QUE LA PARTIE N'A PAS DE LISTE À ELLE, le nuancier montre les
     * couleurs dont elle hérite (celles de la catégorie), et le premier geste
     * — ajouter, retirer, ranger — part d'elles : « + Ajouter » en met une
     * septième après les six de la catégorie. Avant, un nuancier VIDE
     * s'affichait sous les six, et le premier « + Ajouter » les remplaçait
     * par une seule : le client passait de six pastilles à une, enregistré
     * aussitôt, alors que la boutique voulait « en ajouter ». Retirer la
     * dernière couleur d'une liste rend la partie à sa catégorie.
     *
     * Ajouter, retirer ou déplacer une couleur ne redessine PAS l'écran : le
     * nuancier garde le focus sur la flèche qu'on vient d'utiliser, et l'on
     * enchaîne les clics. Seuls « Reprendre les couleurs de la catégorie » et
     * le retrait de la dernière couleur, qui changent la ligne entière, la
     * refont.
     */
    function listeDeLaPartie(l: Ligne, p: NonNullable<Ligne["pastilles"]>): HTMLElement {
      const bloc = el(
        "div",
        "basis-full rounded border border-dashed border-bo-border bg-bo-bg/40 px-2 py-1.5 text-xs",
      );
      bloc.dataset.listePartie = l.cle;
      const nom = l.nom || l.libelle;
      const phrase = el("p", "mb-1 flex flex-wrap items-center gap-x-2 gap-y-1");
      const petit =
        "rounded border border-bo-border bg-bo-surface px-2 py-0.5 text-xs text-bo-accent hover:bg-bo-bg";

      // « Reprendre » et le champ du code (plus bas) portent la même clé :
      // quand « Reprendre » refait la ligne et disparaît, le focus passe au
      // champ du code de la même partie.
      const reprendre = el("button", petit, "Reprendre les couleurs de la catégorie");
      reprendre.type = "button";
      reprendre.dataset.cle = `liste-partie:${l.cle}`;
      reprendre.title = `Efface la liste de « ${nom} » : le client aura de nouveau les couleurs ${p.heritees.source}`;

      let couleurs = [...p.propres];
      /** Ce que montre le nuancier : la liste de la partie, sinon celles dont elle hérite. */
      const montrees = () => (couleurs.length ? couleurs : p.heritees.couleurs);
      /** La phrase de la partie : combien de couleurs, et d'où elles viennent. */
      const ecrire = () => {
        phrase.textContent = "";
        // La phrase dans UN élément : la ligne est en flex, et chaque bout de
        // texte y deviendrait une case à part, le point détaché du chiffre.
        const texte = el("span", "", "Pastilles du client : ");
        if (couleurs.length) {
          texte.append(
            el("strong", "", couleursProposeesEnMots(couleurs.length)),
            couleurs.length > 1 ? ", propres à cette partie." : ", propre à cette partie.",
          );
          phrase.append(texte, reprendre);
          return;
        }
        texte.append(
          `celles ${p.heritees.source} — `,
          el("strong", "", couleursProposeesEnMots(p.heritees.couleurs.length)),
          ". Ajouter, retirer ou ranger une couleur ci-dessous en fait une liste propre à cette partie, à partir de celles-ci ; rien ne change ailleurs.",
        );
        phrase.append(texte);
      };

      const nuancier = creerNuancier({
        couleurs: montrees(),
        libelle: `les couleurs de « ${nom} »`,
        max: COULEURS_PARTIE_MAX,
        aussitot: true,
        etiquette: "Dans l'ordre où le client les voit.",
      });
      const code = nuancier.querySelector<HTMLInputElement>("[data-pastilles-code]");
      if (code) code.dataset.cle = `liste-partie:${l.cle}`;
      nuancier.addEventListener("pastilles:change", (e) => {
        const nouvelles = (e as CustomEvent<{ couleurs: string[] }>).detail.couleurs;
        // Une poignée saisie puis relâchée sans bouger : rien n'a changé.
        if (nouvelles.join() === montrees().join()) return;
        couleurs = nouvelles;
        p.onChange(couleurs);
        if (couleurs.length) {
          ecrire();
          return;
        }
        // La dernière couleur retirée : la partie reprend celles de sa
        // catégorie, et la ligne refaite les montre de nouveau. Le focus,
        // posé sur le champ du code, y revient (même clé).
        code?.focus();
        dessiner();
      });
      reprendre.addEventListener("click", () => {
        if (
          !confirm(
            `Reprendre les couleurs de la catégorie pour « ${nom} » ? Sa liste (${couleursProposeesEnMots(couleurs.length)}) sera effacée ; le client aura les couleurs ${p.heritees.source}. Les paniers et les commandes déjà passés gardent leurs couleurs.`,
          )
        )
          return;
        p.onChange([]);
        dessiner();
      });

      ecrire();
      bloc.append(phrase, nuancier);
      return bloc;
    }

    /** La pastille et le titre d'une ligne des réglages avancés. */
    function enTeteAvance(
      cle: string,
      titre: string,
      couleur: string,
      onCouleur: (hex: string) => void,
    ) {
      const tete = el("span", "flex min-w-[11rem] items-center gap-1.5 font-medium");
      const depart = el("input", "h-6 w-6 cursor-pointer rounded border border-bo-border");
      depart.type = "color";
      depart.dataset.cle = `depart:${cle}`;
      // Le sélecteur n'accepte que « #rrggbb » : « #fff » y deviendrait noir.
      depart.value = rgbVersHex(...(hexVersRgb(couleur) ?? [0, 0, 0])).toLowerCase();
      depart.title =
        "Couleur de départ : celle de la pièce tant que le client n'en choisit pas d'autre";
      depart.addEventListener("change", () => onCouleur(depart.value.toUpperCase()));
      tete.append(depart, titre);
      return tete;
    }

    /** « Teintes réunies : ■× ■× » — un clic sépare la teinte. */
    function teintesReunies(teintes: { couleur: string; separer: () => void }[]) {
      const puces = el("span", "flex flex-wrap items-center gap-1");
      puces.append(el("span", "text-bo-muted", "Teintes réunies :"));
      for (const t of teintes) {
        const puce = el(
          "button",
          "inline-flex items-center gap-0.5 rounded border border-bo-border px-1 hover:bg-bo-bg",
        );
        puce.type = "button";
        puce.title = "Séparer cette teinte : elle devient une couleur à part";
        const p = el("span", "inline-block h-3 w-3 rounded-sm border border-bo-border");
        p.style.background = t.couleur;
        puce.append(p, el("span", "", "×"));
        puce.addEventListener("click", t.separer);
        puces.append(puce);
      }
      return puces;
    }

    /**
     * Les lignes d'un dessin EN PIXELS : une par famille de teintes. Mêmes
     * réglages que pour un dessin vectoriel ; la part du dessin s'ajoute,
     * qui dit d'un coup d'œil si une famille est le pelage ou un reflet dans
     * l'œil.
     */
    function dessinerFamilles(couleursImage: CouleursImage) {
      const familles = couleursImage.familles;
      resumer(familles.filter((f) => f.proposee).map((f) => nomDeFamille(f, familles.indexOf(f))));

      familles.forEach((f, i) => {
        const couleur = f.defaut ?? f.reference;
        const vignette = el(
          "img",
          "h-16 w-16 shrink-0 rounded border border-bo-border bg-white object-contain",
        );
        vignette.alt = `Où est la ${nomDeFamille(f, i).toLowerCase()} sur le dessin`;
        vignette.style.visibility = "hidden";
        void vignetteDeFamille(couleursImage, teintesDeLaFamille(f), couleur).then((src) => {
          if (!src) return;
          vignette.src = src;
          vignette.style.visibility = "visible";
        });

        liste.append(
          ligne({
            cle: f.cle,
            couleur,
            vignette,
            libelle: `Couleur ${i + 1}`,
            nom: f.nom,
            exemple: "ex. Pelage",
            onNom: (nom) => {
              if (nom) f.nom = nom;
              else delete f.nom;
              dessiner();
              void enregistrerTout("Nom changé.");
            },
            proposee: f.proposee === true,
            onProposee: (oui) => {
              if (oui) f.proposee = true;
              else delete f.proposee;
              dessiner();
              void enregistrerTout(
                oui ? "Le client peut la changer." : "Le client ne peut plus la changer.",
              );
            },
            notes: [`${partEnPourcent(f)} % du dessin`],
            // Le nuancier des cheveux va au pelage d'un animal : c'est le
            // repli le plus utile ici, ces dessins étant tous des animaux.
            nuancier:
              etat.mode === "personnage"
                ? {
                    valeur: f.nuancier,
                    repli: "cheveux",
                    onChange: (n) => {
                      f.nuancier = n;
                      publier();
                      void enregistrerTout("Nuancier changé.");
                    },
                  }
                : undefined,
            // Accessoire dessiné en pixels : chaque famille proposée a ses
            // couleurs, comme une partie d'un dessin vectoriel.
            pastilles:
              etat.mode === "piece" && etat.accessoire && f.proposee === true
                ? {
                    propres: f.couleurs ?? [],
                    heritees: heriteesDeLaPartie(),
                    onChange: (couleurs) =>
                      reglerCouleursDeLaPartie(f, nomDeFamille(f, i), couleurs),
                  }
                : undefined,
          }),
        );

        const rangee = el("div", "flex flex-wrap items-center gap-x-4 gap-y-1");
        rangee.append(
          enTeteAvance(f.cle, titreAvance(f.nom, i), couleur, (hex) => {
            f.defaut = hex;
            dessiner();
            void enregistrerTout("Couleur de départ changée.");
          }),
        );
        if (f.teintes?.length)
          rangee.append(
            teintesReunies(
              f.teintes.map((t) => ({
                couleur: t,
                separer: () => {
                  f.teintes = (f.teintes ?? []).filter((x) => x !== t);
                  if (f.teintes.length === 0) delete f.teintes;
                  // La famille détachée prend la première clé libre, et n'est
                  // pas proposée : une teinte séparée est une couleur qu'on
                  // n'a pas encore regardée.
                  const prises = new Set(familles.map((x) => x.cle));
                  let n = 0;
                  while (prises.has(`fam${n}`)) n++;
                  familles.splice(i + 1, 0, { cle: `fam${n}`, reference: t, part: 0 });
                  dessiner();
                  void enregistrerTout("Teinte séparée.");
                },
              })),
            ),
          );
        // Plus de « Suit la couleur de… » ici : la boutique l'a fait retirer
        // (octobre 2026), il compliquait l'écran pour un réglage rare. Les
        // teintes déjà réunies restent, et se séparent par leur « × »
        // ci-dessus ; la lecture du dessin réunit d'elle-même les teintes
        // d'une même famille.
        avance.append(rangee);
      });
      publier();
    }

    /**
     * La ligne qui dit d'où viennent les cases d'une pièce : de sa catégorie,
     * ou d'un réglage fait à la main pour elle — avec de quoi rendre la main
     * à la catégorie.
     */
    function ligneDeLaRegle(): HTMLElement {
      const ligneRegle = el(
        "p",
        "mb-1.5 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-bo-muted",
      );
      const regle = etat.regle;
      if (etat.propre) {
        ligneRegle.append(
          el(
            "span",
            "",
            "Réglé à la main pour cette pièce : chaque couleur cochée a sa rangée de pastilles, ses ombres la suivent.",
          ),
        );
        if (regle) {
          const revenir = el(
            "button",
            "rounded border border-bo-border px-2 py-0.5 text-xs text-bo-accent hover:bg-bo-bg",
            `Refaire comme la catégorie « ${regle.categorie} »`,
          );
          revenir.type = "button";
          revenir.addEventListener("click", () => {
            etat.propre = false;
            dessiner();
            void enregistrerTout("Réglage de la catégorie repris.");
          });
          ligneRegle.append(revenir);
        }
        return ligneRegle;
      }
      ligneRegle.append(
        el(
          "span",
          "",
          !regle
            ? "Pièce sans catégorie : toutes ses couleurs sont proposées, chaque partie avec ses ombres."
            : regle.couleurs === "principale"
              ? `Comme toute la catégorie « ${regle.categorie} » : seule la couleur principale est proposée.`
              : `Comme toute la catégorie « ${regle.categorie} » : toutes les couleurs sont proposées, chaque partie avec ses ombres.`,
        ),
      );
      return ligneRegle;
    }

    /**
     * Redessine le bloc, et rend le focus au champ qui l'avait : un nom se
     * valide en quittant son champ, souvent d'un Tab vers le suivant, et ce
     * suivant vient d'être refait à neuf. Chaque champ redessiné porte une
     * clé (`data-cle`, « nom:st2 ») qui le retrouve, même quand une ligne de
     * plus est apparue au-dessus.
     */
    function dessiner() {
      const actif = document.activeElement;
      const cle =
        actif instanceof HTMLElement && bloc.contains(actif) ? actif.dataset.cle : undefined;
      rendre();
      if (cle) bloc.querySelector<HTMLElement>(`[data-cle="${CSS.escape(cle)}"]`)?.focus();
    }

    function rendre() {
      liste.innerHTML = "";
      avance.innerHTML = "";
      zoneRegle.innerHTML = "";
      // Un dessin en pixels n'a pas de zone : ce sont ses familles de teintes
      // que la boutique règle, dans le même écran et avec les mêmes gestes.
      if (enPixels(etat)) {
        dessinerFamilles(etat.couleursImage!);
        return;
      }
      if (etat.groupes.length === 0) {
        resume.className = "js-groupes-resume text-sm text-bo-muted";
        resume.textContent = "Pas de couleur à changer dans ce dessin.";
        // Un dessin dont les couleurs n'ont JAMAIS été lues (un animal
        // téléversé depuis Canva, le berger allemand) arrivait ici sans rien
        // à cocher ni à choisir, et la lecture était cachée sous « Réglages
        // avancés ». Le bouton est maintenant là où l'on bute.
        if (etat.svgUrl) {
          resume.textContent = "Les couleurs de ce dessin n'ont pas encore été lues.";
          const lire = el(
            "button",
            "rounded bg-bo-accent px-3 py-1.5 text-sm text-white hover:opacity-90",
            "Lire les couleurs du dessin",
          );
          lire.type = "button";
          lire.dataset.cle = "lire-le-dessin";
          lire.addEventListener("click", () => void detecter(etat.svgUrl, false));
          const suite = el(
            "p",
            "text-xs text-bo-muted",
            etat.mode === "personnage"
              ? "Puis cochez « Le client peut la changer » sur le pelage (ou la peau), choisissez son nuancier, et cliquez « Enregistrer le dessin »."
              : "Puis cochez les couleurs que le client pourra changer : chaque réglage s'enregistre aussitôt.",
          );
          const bloc = el("div", "flex flex-col items-start gap-1.5");
          bloc.append(lire, suite);
          liste.append(bloc);
        }
        publier();
        return;
      }
      // Une pièce qui suit sa catégorie : ses cases se recalculent à chaque
      // fois — des groupes réunis ou séparés peuvent changer la principale et
      // les familles de teinte.
      const piece = etat.mode === "piece";
      if (piece && !etat.propre) etat.cachees = cacheesDeLaRegle(etat);
      if (piece) zoneRegle.append(ligneDeLaRegle());
      // Les rangées du client, telles que le site les propose : chacune a sa
      // couleur en tête et ses ombres en nuances. Un personnage n'en a pas ici
      // (null) : chaque ligne cochée y est une rangée.
      const rangees = piece ? rangeesDuClient(etat) : null;
      /** La rangée qui recolore ce groupe, en tête ou en ombre. */
      const rangeeDe = (g: GroupeCouleur) =>
        rangees?.find((r) => zonesDuGroupe(r).includes(g.zone));
      /** Le nom de la ligne qui porte la tête d'une rangée. */
      const nomDeTete = (r: GroupeCouleur) => {
        const j = etat.groupes.findIndex((h) => zonesDuGroupe(h).includes(r.zone));
        return j >= 0 ? nomAffiche(etat.groupes[j]!, j) : r.nom ?? r.zone;
      };
      const premier = etat.groupes[0]?.zone;
      // Le résumé suit l'ordre des rangées du client, la famille la plus
      // étendue d'abord ; pour un personnage, l'ordre du back-office.
      resumer(
        rangees
          ? rangees.map(nomDeTete)
          : etat.groupes
              .map((g, i) => ({ g, i }))
              .filter(({ g }) => !etat.cachees.includes(g.zone))
              .map(({ g, i }) => nomAffiche(g, i)),
      );

      etat.groupes.forEach((g, i) => {
        const cache = etat.cachees.includes(g.zone);
        const rangee = rangeeDe(g);
        // En tête de sa rangée : la couleur que le client choisit. Sinon,
        // c'est une ombre : elle suit la tête, et n'a pas de case à elle.
        const tete = !!rangee && zonesDuGroupe(g).includes(rangee.zone);
        const ombre = !!rangee && !tete;
        // Ce que la rangée du client recolore depuis cette ligne : la tête
        // emmène ses ombres, ancrées sur SA zone — une couleur de départ
        // réglée ici tombe telle quelle sur elle, et ses ombres suivent,
        // comme sur le site quand le client choisit.
        const vue: GroupeCouleur =
          rangee && tete
            ? { ...g, nuances: zonesDuGroupe(rangee).filter((z) => z !== g.zone) }
            : g;
        const membres = zonesDuGroupe(vue);

        // La vignette : la pièce entière, CETTE couleur dans la sienne — ses
        // ombres dans les leurs —, le reste en gris (cf. ApercusZones).
        const vignette = el(
          "img",
          "js-zone-apercu h-16 w-16 shrink-0 rounded border border-bo-border bg-white object-contain",
        );
        vignette.dataset.zone = membres.join(" ");
        vignette.dataset.couleurs = JSON.stringify(
          Object.fromEntries(membres.filter((z) => etat.zones[z]).map((z) => [z, etat.zones[z]])),
        );
        vignette.alt = `Où est la ${nomAffiche(g, i).toLowerCase()} sur le dessin`;
        vignette.style.visibility = "hidden";

        const notes: string[] = [];
        // La tête de la première rangée est la couleur principale : celle qui
        // passe d'une pièce à l'autre dans le module (cf. principaleDeLaPiece).
        if (tete && rangee === rangees?.[0]) notes.push("couleur principale");
        // Une ombre suit la tête de sa rangée (famillesDeLaPiece). On le dit,
        // pour qu'on ne la croie ni figée ni proposée seule.
        if (ombre) notes.push(`ombre de « ${nomDeTete(rangee!)} », elle la suit`);
        // Séparée par la boutique : la ligne le dit et, si le site la prenait
        // sans cela pour l'ombre d'une autre couleur, propose de l'y réunir.
        let separee: Ligne["separee"];
        if (piece && g.separee) {
          notes.push("séparée de sa teinte");
          const sans = etat.groupes.map((h) => {
            if (h !== g) return h;
            const reste = { ...h };
            delete reste.separee;
            return reste;
          });
          const suivie = famillesDeLaPiece({ ...pieceDe(etat), groupesCouleurs: sans }).find(
            (f) => zonesDuGroupe(f).includes(g.zone) && !zonesDuGroupe(g).includes(f.zone),
          );
          if (suivie)
            separee = {
              de: nomDeTete(suivie),
              reunir: () => {
                delete g.separee;
                dessiner();
                void enregistrerTout("Couleur réunie à sa teinte : elle en suit la couleur.");
              },
            };
        }

        liste.append(
          ligne({
            cle: g.zone,
            couleur: etat.zones[g.zone] ?? "#000000",
            vignette,
            libelle: `Couleur ${i + 1}`,
            nom: g.nom,
            exemple:
              etat.mode === "personnage" ? (i === 0 ? "ex. Peau" : "ex. Robe") : "ex. Rayures",
            onNom: (nom) => {
              if (nom) g.nom = nom;
              else delete g.nom;
              dessiner();
              void enregistrerTout("Nom changé.");
            },
            proposee: piece ? !!rangee : !cache,
            onProposee: (oui) => {
              // Une case touchée : la pièce a désormais SON réglage, qui part
              // de ce qu'elle proposait jusque-là (celui de sa catégorie).
              etat.propre = true;
              // Pièce : la case vaut pour la couleur ET ses ombres. Décochée,
              // sa rangée entière s'en va ; cochée, sa famille de teinte
              // revient avec elle — sans quoi une ombre restée décochée
              // resterait figée sous la couleur choisie (le liseré vert foncé
              // sous des manches rouges).
              const famille = !piece
                ? undefined
                : oui
                  ? famillesDeLaPiece(pieceDe(etat)).find((f) =>
                      zonesDuGroupe(f).includes(g.zone),
                    )
                  : rangee;
              const zonesF = new Set(famille ? zonesDuGroupe(famille) : []);
              const touchees = etat.groupes
                .filter((h) => h === g || zonesF.has(h.zone))
                .map((h) => h.zone);
              etat.cachees = etat.cachees.filter((z) => !touchees.includes(z));
              if (!oui) etat.cachees.push(...touchees);
              dessiner();
              void enregistrerTout(
                oui ? "Le client peut la changer." : "Le client ne peut plus la changer.",
              );
            },
            ombre: ombre
              ? {
                  separer: () => {
                    g.separee = true;
                    dessiner();
                    void enregistrerTout("Couleur séparée : le client la changera à part.");
                  },
                }
              : undefined,
            separee,
            notes,
            nuancier:
              etat.mode === "personnage"
                ? {
                    valeur: g.nuancier,
                    repli: g.zone === premier ? "peau" : "vetements",
                    onChange: (n) => {
                      g.nuancier = n;
                      publier();
                      void enregistrerTout("Nuancier changé.");
                    },
                  }
                : undefined,
            // Accessoire : la tête de chaque rangée du client a ses couleurs
            // à elle. Une ombre suit sa couleur, une couleur que le client ne
            // peut pas changer n'a pas de pastilles : ni l'une ni l'autre n'a
            // de liste à régler (celle qu'elles auraient reste gardée).
            pastilles:
              piece && etat.accessoire && tete
                ? {
                    propres: g.couleurs ?? [],
                    heritees: heriteesDeLaPartie(),
                    onChange: (couleurs) =>
                      reglerCouleursDeLaPartie(g, nomAffiche(g, i), couleurs),
                  }
                : undefined,
          }),
        );

        const rangeeAvancee = el("div", "flex flex-wrap items-center gap-x-4 gap-y-1");
        rangeeAvancee.append(
          enTeteAvance(g.zone, titreAvance(g.nom, i), etat.zones[g.zone] ?? "", (hex) => {
            // Les ombres suivent, comme sur le site quand le client choisit :
            // celles que le site rattache à cette couleur (`vue`), et pas
            // seulement les teintes enregistrées avec elle. Avec le groupe
            // seul, un rouge mis ici laissait le liseré vert foncé, qui
            // sortait alors de la famille et devenait une rangée à part.
            // « Remettre les couleurs du dessin » défait tout cela.
            Object.assign(etat.zones, couleursDuGroupe(vue, etat.zones, hex));
            dessiner();
            void enregistrerTout("Couleur de départ changée.");
          }),
        );
        if (g.nuances?.length)
          rangeeAvancee.append(
            teintesReunies(
              g.nuances.map((z) => ({
                couleur: etat.zones[z] ?? "#000",
                separer: () => {
                  g.nuances = (g.nuances ?? []).filter((n) => n !== z);
                  if (g.nuances.length === 0) delete g.nuances;
                  // Pièce : la teinte détachée est marquée séparée, sans quoi
                  // le site la reprendrait aussitôt pour une ombre de la même
                  // couleur, et le « × » semblerait ne rien faire.
                  etat.groupes.splice(i + 1, 0, piece ? { zone: z, separee: true } : { zone: z });
                  if (cache) etat.cachees.push(z);
                  dessiner();
                  void enregistrerTout("Teinte séparée.");
                },
              })),
            ),
          );
        // Plus de « Suit la couleur de… » (retiré à la demande de la
        // boutique, octobre 2026) : les nuances enregistrées se séparent par
        // leur « × » ci-dessus, une ombre devinée par « Séparer » sur sa
        // ligne ; les ombres de même teinte suivent d'elles-mêmes la tête de
        // leur rangée, sur une pièce réglée à la main comme ailleurs.
        avance.append(rangeeAvancee);
      });
      publier();
      if (visible) window.mlApercusZones?.(bloc);
    }

    /** Lit (ou relit) les couleurs d'un dessin et les range. */
    async function detecter(url: string, garder: boolean) {
      if (!url) {
        dire("Aucun dessin à lire.", "erreur");
        return;
      }
      dire("Lecture des couleurs du dessin…");
      try {
        const res = await fetch(`${api}/admin/svg/couleurs`, {
          method: "POST",
          credentials: "include",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ url }),
        });
        if (!res.ok) throw new Error("HTTP " + res.status);
        const lecture = (await res.json()) as Lecture;
        etat = reprendre(etat, lecture, garder);
        const src = etat.svgUrl.startsWith("http") ? etat.svgUrl : api + etat.svgUrl;
        bloc.dataset.apercuSvg = src;
        dessiner();
        const familles = etat.couleursImage?.familles.length ?? 0;
        const n = etat.groupes.length;
        let message: string;
        if (familles > 0) {
          // Dessin en pixels : on dit ce qu'on y a trouvé, et ce qu'il reste
          // à faire — rien n'est proposé au client tant que rien n'est coché.
          const proposees =
            etat.couleursImage?.familles.filter((f) => f.proposee).length ?? 0;
          message =
            `Image en pixels : ${familles} couleur${familles > 1 ? "s" : ""} principale` +
            `${familles > 1 ? "s" : ""} trouvée${familles > 1 ? "s" : ""}. ` +
            (proposees
              ? `${proposees} proposée${proposees > 1 ? "s" : ""} au client.`
              : "Cochez celles que le client pourra changer.");
        } else if (n === 0 && lecture.motif)
          // AUCUN MESSAGE N'ACCUSE UN FICHIER SANS PREUVE. L'ancien disait
          // « image illisible ou entièrement transparente » à un export Canva
          // parfaitement bon, dont le seul tort était son format : la boutique
          // en refaisait dix fois un fichier qui n'avait rien. Le serveur dit
          // maintenant lequel des cinq cas s'est produit, et la phrase —
          // partagée par tous les écrans — dit quoi faire ensuite.
          message = lecture.phrase ?? "Aucune couleur lue dans cette image.";
        else if (n === 0) message = "Aucune couleur à changer dans ce dessin.";
        else
          message =
            `${n} couleur${n > 1 ? "s" : ""} dans ce dessin` +
            (lecture.zonesCreees
              ? ` (version préparée enregistrée à part, l'original est conservé)`
              : "") +
            ".";
        if (adresseEnregistrement) await enregistrerTout(message);
        else
          dire(
            rappeler(message),
            // SEULE une vraie panne de lecture s'affiche en rouge. Un format
            // qu'on ne sait pas encore lire, un dessin au trait, une image
            // vide ou trop grande : le dessin est bon et s'enregistre — le
            // motif dit ce qu'il faut savoir. Le peindre en rouge ferait
            // croire à une avarie, et c'est exactement ce qui poussait la
            // boutique à refaire ses fichiers pour rien.
            lecture.motif && lecture.motif !== "echec-lecture"
              ? ""
              : n === 0 && familles === 0
                ? "erreur"
                : "ok",
          );
      } catch (err) {
        dire("Lecture impossible : " + String(err), "erreur");
      }
    }

    /**
     * Remet à chaque couleur celle de son fichier : la porte de sortie quand
     * une couleur de départ a été changée par erreur. Changer une couleur de
     * départ réécrit aussi ses teintes réunies — passer une marinière au noir
     * puis revenir laissait ses rayures noires, sans autre moyen de retrouver
     * le bleu nuit du dessin. Noms, cases et regroupements ne bougent pas.
     */
    async function remettreCouleursDuDessin() {
      if (enPixels(etat)) {
        const familles = etat.couleursImage!.familles;
        if (!familles.some((f) => f.defaut)) {
          dire("Les couleurs sont déjà celles du dessin.");
          return;
        }
        for (const f of familles) delete f.defaut;
      } else {
        const url = etat.svgUrl.startsWith("http") ? etat.svgUrl : api + etat.svgUrl;
        let fichier: Record<string, string>;
        try {
          const res = await fetch(url);
          if (!res.ok) throw new Error("HTTP " + res.status);
          fichier = couleursDuFichier(await res.text());
        } catch (err) {
          dire("Dessin introuvable : " + String(err), "erreur");
          return;
        }
        let changees = 0;
        for (const z of Object.keys(etat.zones)) {
          const c = fichier[z];
          if (c && !memeCouleur(c, etat.zones[z]!)) {
            etat.zones[z] = c;
            changees++;
          }
        }
        if (changees === 0) {
          dire("Les couleurs sont déjà celles du dessin.");
          return;
        }
      }
      dessiner();
      await enregistrerTout("Couleurs du dessin remises.");
    }

    bloc.querySelector(".js-groupes-detecter")?.addEventListener("click", () => {
      if (
        adresseEnregistrement &&
        !confirm(
          "Relire le dessin ? Ses teintes proches seront réunies à nouveau. Les noms, les cases et les couleurs séparées sont gardés.",
        )
      )
        return;
      void detecter(etat.svgUrl, true);
    });
    bloc.querySelector(".js-groupes-remettre")?.addEventListener("click", () => {
      if (
        adresseEnregistrement &&
        !confirm(
          "Remettre les couleurs du dessin ? Les couleurs de départ réglées ici seront remplacées par celles du fichier.",
        )
      )
        return;
      void remettreCouleursDuDessin();
    });
    bloc.addEventListener("groupes:detecter", (e) => {
      const detail = (e as CustomEvent<{ url: string }>).detail;
      void detecter(detail?.url ?? "", false);
    });
    // La pièce change de catégorie (sélecteur de la page) : les cases d'une
    // pièce qui la suit se redessinent selon la nouvelle règle. Rien à
    // enregistrer ici — la catégorie l'est déjà, et la pièce garde « suit sa
    // catégorie ».
    bloc.addEventListener("groupes:regle", (e) => {
      etat.regle = regleLue((e as CustomEvent<unknown>).detail);
      dessiner();
    });
    // L'emplacement change (page de création) : un accessoire montre la liste
    // de couleurs de chaque partie, les autres pièces non. Les listes déjà
    // composées restent dans l'état : revenir à « Accessoires » les retrouve.
    bloc.addEventListener("groupes:emplacement", (e) => {
      const oui = (e as CustomEvent<{ accessoire?: unknown }>).detail?.accessoire === true;
      if (etat.mode !== "piece" || oui === etat.accessoire) return;
      etat.accessoire = oui;
      dessiner();
    });

    // Vignettes à l'approche de l'écran seulement : la page des pièces en
    // compte plus de cent cinquante.
    if ("IntersectionObserver" in window) {
      const guet = new IntersectionObserver(
        (entrees) => {
          if (!entrees.some((x) => x.isIntersecting)) return;
          guet.disconnect();
          visible = true;
          window.mlApercusZones?.(bloc);
        },
        { rootMargin: "400px" },
      );
      guet.observe(bloc);
    } else visible = true;

    dessiner();
  }

  document.querySelectorAll<HTMLElement>(".js-groupes").forEach(monter);
</script>
