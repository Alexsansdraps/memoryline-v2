---
/**
 * Les noms d'une liste (catégories de personnages, cadres, personnages,
 * collections, promotions…) dans les quatre autres langues du site, en un
 * tableau : une ligne par élément, une colonne par langue.
 *
 * C'est le cas le plus courant de Traductions.astro — un seul champ, `name` —
 * gardé sous ce nom pour que les écrans de listes restent courts. La
 * mécanique (cases vides = français, proposition automatique à relire,
 * enregistrement des seules cases modifiées) est celle du composant général.
 *
 * Côté serveur : enregistrerTraductionsNoms / proposerTraductionsNoms
 * (lib/traductions-noms.ts).
 */
import Traductions from "./Traductions.astro";
import { CHAMP_NOM, elementsNoms, type ElementNom } from "../lib/traductions-noms.ts";
import type { Propositions } from "../lib/traductions.ts";

interface Props {
  titre: string;
  aide: string;
  elements: ElementNom[];
  /** Propositions automatiques à afficher (non enregistrées). */
  propositions?: Propositions;
  /** Le formulaire tel qu'il vient d'être envoyé, à réafficher tel quel. */
  saisies?: FormData | null;
  actionEnregistrer: string;
  actionProposer: string;
  /** Ouvert d'office (après une proposition, pour qu'on la voie). */
  ouvert?: boolean;
  classe?: string;
  /** L'id du bloc, où la recherche emmène (voir Traductions.astro). */
  ancre?: string;
}

const { elements, ...reste } = Astro.props;
---

<Traductions
  {...reste}
  champs={[CHAMP_NOM]}
  elements={elementsNoms(elements)}
  unite={["nom", "noms"]}
/>
