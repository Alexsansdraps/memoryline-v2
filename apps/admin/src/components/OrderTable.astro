---
/**
 * Liste des commandes.
 *
 * Trois niveaux de filtrage, du plus rapide au plus fin : les ONGLETS (une
 * question par onglet — « qu'est-ce qui reste à envoyer ? »), la RECHERCHE
 * plein texte, et les FILTRES combinables pour les cas précis. Tout passe par
 * l'URL : un filtre utile se met en favori, se partage, et survit à un
 * rafraîchissement.
 */
import { apiUrl, url } from "../lib/url.ts";
import {
  ANNONCE_COURRIER,
  ETAPES_DU_PARCOURS,
  FUSEAU_BOUTIQUE,
  libelleEtape,
  passageEtape,
  rangEtape,
  tonEtape,
  type EtapeTraitement,
  type ParcoursTraitement,
} from "@memoryline/types";
import ApercuFlottant from "./ApercuFlottant.astro";
import {
  adminApi,
  formatPrice,
  type FiltresCommandes,
  type OrderRow,
} from "../lib/api.ts";

interface Props {
  channel: "web" | "salon";
  /** Restreint la liste à un seul stand, quand l'écran en regarde un. */
  stand?: number;
}
const { channel, stand } = Astro.props;

const api = adminApi(Astro.request);

/**
 * Un vendeur lit la liste de ses stands et télécharge les fichiers
 * d'impression ; il ne marque rien, n'étiquette rien, n'archive rien — l'API
 * le lui refuserait. On ne lui montre donc pas ces boutons, ni les
 * étiquettes, qui sont des notes de la boutique.
 */
const estProprietaire = Astro.locals.user?.role === "owner";

let flash: string | null = null;
let erreurAction: string | null = null;
if (Astro.request.method === "POST" && estProprietaire) {
  const f = await Astro.request.formData();
  const action = f.get("_action");
  try {
    if (action === "annuler-vente") {
      // Une vente du stand que le client n'a pas payée, ou autre (19/11) :
      // annulée d'ici, sans ouvrir la fiche. Aucun courriel, rien à rendre :
      // son encaissement sur place sort du grand livre (commandes.ts).
      const r = await api.annulerCommande(Number(f.get("id")), {
        motif: String(f.get("motif") ?? "impaye"),
        motifLibre: "",
        rembourser: false,
        author: Astro.locals.user?.email ?? undefined,
      });
      flash = `Vente ${r.numero} annulée : elle ne compte plus dans vos chiffres.`;
    } else if (action === "supprimer-vente") {
      // Pour les essais (19/11, Alexandra : « faut qu'on puisse supprimer
      // malgré la loi les commandes […] et pas devoir passer par
      // archivées ») : une vente du stand part pour de bon, d'un clic.
      const numero = String(f.get("numero") ?? "");
      await api.supprimerCommande(Number(f.get("id")));
      flash = `Vente ${numero} supprimée définitivement, avec ses lignes et son journal.`;
    } else if (action === "etape") {
      // L'étape suivante, d'un clic dans la liste (17/11) : la même règle que
      // la frise de la fiche (courriel compris).
      const r = await api.changerEtape(Number(f.get("id")), {
        etape: String(f.get("etape") ?? ""),
        auteur: Astro.locals.user?.email ?? undefined,
      });
      const nom = libelleEtape(r.etape as EtapeTraitement, r.parcours as ParcoursTraitement);
      flash =
        `${String(f.get("numero") ?? "Commande")} : « ${nom} ».` +
        (r.courrier
          ? r.courrier.parti
            ? ` Courriel envoyé à ${r.courrier.email}.`
            : ` Le courriel n'a PAS pu partir vers ${r.courrier.email}.`
          : "");
    } else if (action === "masse") {
      const ids = String(f.get("ids") ?? "")
        .split(",")
        .map(Number)
        .filter(Boolean);
      const quoi = String(f.get("bulk") ?? "");
      const tags = String(f.get("tags") ?? "")
        .split(",")
        .map((t) => t.trim())
        .filter(Boolean);
      if (quoi === "etape-suivante") {
        const r = await api.bulkOrders(ids, quoi, undefined, Astro.locals.user?.email ?? undefined);
        const ecartees = r.ecartees ?? [];
        flash =
          `${r.count} commande(s) passée(s) à l'étape suivante` +
          (r.prevenues ? `, ${r.prevenues} client(s) prévenu(s) par courriel` : "") +
          "." +
          (ecartees.length
            ? ` ${ecartees.length} laissée(s) telle(s) quelle(s) : ${ecartees
                .map((e) => e.raison)
                .filter((v, i, t) => t.indexOf(v) === i)
                .join(" ")}`
            : "");
      } else if (quoi === "tag" || quoi === "untag") {
        const r = await api.bulkOrders(ids, quoi, tags);
        flash =
          quoi === "tag"
            ? `Étiquette ajoutée à ${r.count} commande(s).`
            : `Étiquette retirée de ${r.count} commande(s).`;
      } else if (quoi === "archiver" || quoi === "restaurer") {
        const r = await api.bulkOrders(ids, quoi);
        const numeros = Array.isArray(r.numeros) ? r.numeros : [];
        const liste = numeros.length ? ` : ${numeros.join(", ")}.` : ".";
        flash =
          quoi === "archiver"
            ? `${r.count} commande(s) archivée(s)${liste} Rien n'est effacé : elles attendent dans l'onglet « Archivées ».`
            : `${r.count} commande(s) restaurée(s)${liste}`;
      } else if (quoi === "supprimer") {
        // La suppression DÉFINITIVE, par sélection, dans l'onglet
        // « Archivées » (18/11). Une à une, par la route de la fiche : mêmes
        // règles (suppression.ts, motifCommandeAGarder). Ce qui a été payé,
        // facturé, remboursé, expédié ou réglé en carte cadeau reste
        // archivé, et le message dit pourquoi.
        let supprimees = 0;
        const raisons: string[] = [];
        for (const id of ids) {
          try {
            await api.supprimerCommande(id);
            supprimees++;
          } catch (e) {
            raisons.push(String(e).replace(/^Error:\s*/, ""));
          }
        }
        const uniques = raisons.filter((v, i, t) => t.indexOf(v) === i);
        flash =
          `${supprimees} commande(s) supprimée(s) définitivement, avec leurs lignes et leur journal.` +
          (raisons.length ? ` ${raisons.length} gardée(s) : ${uniques.join(" ")}` : "");
      }
    }
  } catch (e) {
    erreurAction = String(e);
  }
}

/* --- Onglets ------------------------------------------------------------- */

/**
 * Chaque onglet est une question qu'on se pose vraiment dans la journée. Ils
 * ne font que pré-régler les filtres : rien ne s'y cache qu'on ne puisse
 * retrouver à la main.
 */
const ONGLETS: {
  cle: string;
  label: string;
  filtres: Partial<FiltresCommandes>;
}[] = [
  { cle: "toutes", label: "Toutes", filtres: {} },
  // Un seul statut, en étapes (17/11) : les onglets suivent les étapes.
  ...(channel === "salon"
    ? [
        // Une vente du stand naît payée et terminée (19/11) : il ne reste
        // qu'à voir celles qu'on a annulées (Alexandra : « laisse toutes et
        // annulées »).
        { cle: "annulees", label: "Annulées", filtres: { etape: "annulee" } },
      ]
    : [
        {
          cle: "a-preparer",
          label: "À préparer",
          filtres: { etape: "en_preparation,en_partie" },
        },
        {
          cle: "en-route",
          label: "Envoyées ou prêtes",
          filtres: { etape: "envoyee,prete" },
        },
        { cle: "impayees", label: "Impayées", filtres: { etape: "a_encaisser" } },
        {
          cle: "remboursees",
          label: "Remboursées",
          filtres: { financial: "refunded,partially_refunded" },
        },
      ]),
  // Le rangement, et non une corbeille : rien n'y est détruit, et les
  // commandes en sortent entières. Les autres onglets ne les montrent pas.
  // Seule la fiche d'une archivée propose « Supprimer définitivement », et
  // l'API ne le permet qu'à un panier ou une commande jamais payée.
  { cle: "archivees", label: "Archivées", filtres: { archived: "1" } },
];

const params = Astro.url.searchParams;
// Retour de la fiche d'une commande supprimée définitivement : elle n'existe
// plus, c'est donc la liste qui le redit.
const supprimee = params.get("supprimee");
if (!flash && supprimee)
  flash = `Commande ${supprimee} supprimée définitivement, avec ses lignes et son journal.`;
const ongletActif = params.get("onglet") ?? "toutes";
const onglet = ONGLETS.find((o) => o.cle === ongletActif) ?? ONGLETS[0]!;

// Les filtres saisis à la main l'emportent sur ceux de l'onglet : sinon on ne
// pourrait pas affiner « À expédier » sans changer d'onglet.
const filtres: FiltresCommandes = {
  channel,
  stand,
  ...onglet.filtres,
  q: params.get("q") ?? undefined,
  financial: params.get("financial") ?? onglet.filtres.financial,
  fulfillment: params.get("fulfillment") ?? onglet.filtres.fulfillment,
  etape: params.get("etape") ?? onglet.filtres.etape,
  tag: params.get("tag") ?? undefined,
  from: params.get("from") ?? undefined,
  to: params.get("to") ?? undefined,
};

// Dans l'onglet « Archivées », le bouton d'action groupée devient
// « Restaurer » : proposer « Archiver » sur ce qui l'est déjà n'aurait aucun
// sens, et c'est de là qu'on ressort une commande rangée par erreur.
const vueArchivees = onglet.cle === "archivees";

let orders: OrderRow[] = [];
let etiquettes: { name: string; n: number }[] = [];
let error: string | null = null;
try {
  [orders, etiquettes] = await Promise.all([
    api.orders(filtres),
    estProprietaire ? api.orderTags() : Promise.resolve([]),
  ]);
} catch (e) {
  error = String(e);
}

/** Reconstruit l'URL courante en changeant une seule clé. */
function lienAvec(modif: Record<string, string | null>): string {
  const p = new URLSearchParams(params);
  for (const [k, v] of Object.entries(modif)) {
    if (v === null || v === "") p.delete(k);
    else p.set(k, v);
  }
  const qs = p.toString();
  return url(`${channel === "salon" ? "/ventes-salon" : "/commandes"}${qs ? `?${qs}` : ""}`);
}

/** Lien d'export, qui reprend exactement les filtres affichés. */
const lienExport = (() => {
  const p = new URLSearchParams();
  for (const [k, v] of Object.entries(filtres))
    if (v) p.set(k, String(v));
  return apiUrl(`/admin/orders/export.csv?${p.toString()}`);
})();

/**
 * « le 27 août à 22:36 », comme sur la boutique. L'heure de PARIS, dite
 * explicitement plutôt que confiée au réglage TZ du serveur.
 */
function quand(iso: string | null | undefined): string {
  if (!iso) return "—";
  try {
    const d = new Date(iso);
    const jour = d.toLocaleDateString("fr-FR", {
      day: "numeric",
      month: "long",
      timeZone: FUSEAU_BOUTIQUE,
    });
    const heure = d.toLocaleTimeString("fr-FR", {
      hour: "2-digit",
      minute: "2-digit",
      timeZone: FUSEAU_BOUTIQUE,
    });
    return `le ${jour} à ${heure}`;
  } catch {
    return "—";
  }
}

const BADGE_PAIEMENT: Record<string, { texte: string; classe: string }> = {
  paid: { texte: "Payée", classe: "bg-bo-bg text-bo-ink" },
  pending: { texte: "En attente", classe: "bg-amber-100 text-amber-900" },
  authorized: { texte: "Autorisée", classe: "bg-sky-100 text-sky-900" },
  partially_refunded: {
    texte: "Remb. en partie",
    classe: "bg-violet-100 text-violet-900",
  },
  refunded: { texte: "Remboursée", classe: "bg-violet-100 text-violet-900" },
  voided: { texte: "Annulée", classe: "bg-bo-bg text-bo-muted" },
  draft: { texte: "Panier", classe: "bg-bo-bg text-bo-muted" },
};

const BADGE_TRAITEMENT: Record<string, { texte: string; classe: string }> = {
  fulfilled: { texte: "Traitée", classe: "bg-green-100 text-green-900" },
  partially_fulfilled: {
    texte: "En partie",
    classe: "bg-orange-100 text-orange-900",
  },
  unfulfilled: { texte: "Non traitée", classe: "bg-amber-100 text-amber-900" },
};

/** L'argent, à part de l'étape : seuls les remboursements se filtrent ici. */
const FILTRES_PAIEMENT = [
  ["partially_refunded", "Remboursée en partie"],
  ["refunded", "Remboursée"],
];
/** Les étapes que cette liste peut montrer, dans l'ordre des parcours. */
const FILTRES_ETAPE: [string, string][] =
  channel === "salon"
    ? [
        ["a_encaisser", "À encaisser"],
        ["a_imprimer", "À imprimer"],
        ["en_partie", "Remise en partie"],
        ["terminee", "Terminée"],
        ["annulee", "Annulée"],
      ]
    : [
        ["a_encaisser", "En attente de paiement"],
        ["en_preparation", "En préparation"],
        ["en_partie", "Envoyée ou retirée en partie"],
        ["prete", "Prête à retirer"],
        ["retiree", "Retirée"],
        ["envoyee", "Envoyée"],
        ["livree", "Livrée"],
        ["rien_a_expedier", "Rien à expédier (cartes cadeaux)"],
        ["annulee", "Annulée"],
      ];

const paiementCoches = (filtres.financial ?? "").split(",").filter(Boolean);
const traitementCoches = (filtres.etape ?? "").split(",").filter(Boolean);

/** La couleur d'une étape, la même que sur la fiche. */
const CLASSE_TON: Record<string, string> = {
  neutre: "bg-bo-bg text-bo-muted",
  a_faire: "bg-amber-100 text-amber-900",
  en_partie: "bg-orange-100 text-orange-900",
  en_cours: "bg-sky-100 text-sky-900",
  fait: "bg-green-100 text-green-900",
};
/**
 * Le statut d'une ligne et l'étape d'après, s'il y en a une à proposer d'un
 * clic. Une reprise de Shopify (sans étape) garde l'ancien libellé.
 */
function statutDeLaLigne(o: OrderRow) {
  if (!o.etapeTraitement || !o.parcours) return null;
  const parcours = o.parcours as ParcoursTraitement;
  const etape = o.etapeTraitement as EtapeTraitement;
  const rang = rangEtape(parcours, etape);
  const suivante = rang === null ? undefined : ETAPES_DU_PARCOURS[parcours][Math.floor(rang) + 1];
  const passage = suivante ? passageEtape(parcours, etape, suivante) : null;
  return {
    texte: libelleEtape(etape, parcours),
    classe: CLASSE_TON[etape === "a_encaisser" ? "a_faire" : tonEtape(etape)]!,
    suivante:
      suivante && passage?.ok && !passage.inchange
        ? {
            etape: suivante,
            libelle: libelleEtape(suivante, parcours),
            courrier: passage.courrier ? ANNONCE_COURRIER[passage.courrier] : null,
          }
        : null,
  };
}
const filtreActif =
  Boolean(filtres.q) ||
  Boolean(filtres.tag) ||
  Boolean(filtres.from) ||
  Boolean(filtres.to) ||
  Boolean(params.get("financial")) ||
  Boolean(params.get("fulfillment")) ||
  Boolean(params.get("etape"));
---

{flash && (
  <p class="mb-4 text-sm rounded bg-green-50 border border-green-200 px-3 py-2">
    {flash}
  </p>
)}
{erreurAction && (
  <p class="mb-4 text-sm rounded bg-red-50 border border-red-200 px-3 py-2">
    {erreurAction}
  </p>
)}
{error && <p class="text-red-600 text-sm">API injoignable : {error}</p>}

<section class="rounded-lg border border-bo-border bg-bo-surface">
  {/* Onglets : un clic = une question courante. */}
  <div class="flex flex-wrap items-center gap-1 border-b border-bo-border px-3 pt-3">
    {ONGLETS.filter(
      // Au stand, l'onglet « Archivées » ne s'affiche plus (19/11) : les
      // ventes se suppriment sans être archivées. Son adresse marche encore.
      (o) => !(channel === "salon" && o.cle === "archivees" && onglet.cle !== "archivees"),
    ).map((o) => (
      <a
        href={lienAvec({
          onglet: o.cle === "toutes" ? null : o.cle,
          financial: null,
          fulfillment: null,
          etape: null,
        })}
        class={`rounded-t px-3 py-2 text-sm ${
          o.cle === onglet.cle
            ? "bg-bo-bg font-medium text-bo-ink"
            : "text-bo-muted hover:bg-bo-bg/60"
        }`}
      >
        {o.label}
      </a>
    ))}
  </div>

  {/* Recherche + filtres fins. */}
  <form method="GET" class="flex flex-wrap items-end gap-3 px-4 py-3">
    {ongletActif !== "toutes" && (
      <input type="hidden" name="onglet" value={ongletActif} />
    )}
    <label class="flex-1 min-w-[240px]">
      <span class="mb-1 block text-xs text-bo-muted">
        Rechercher (n° de commande, client, e-mail, ville)
      </span>
      <input
        type="search"
        name="q"
        value={filtres.q ?? ""}
        placeholder="WEB-1042, Dupont, dupont@…"
        class="w-full rounded border border-bo-border px-3 py-2 text-sm"
      />
    </label>
    <label>
      <span class="mb-1 block text-xs text-bo-muted">Du</span>
      <input
        type="date"
        name="from"
        value={filtres.from ?? ""}
        class="rounded border border-bo-border px-3 py-2 text-sm"
      />
    </label>
    <label>
      <span class="mb-1 block text-xs text-bo-muted">Au</span>
      <input
        type="date"
        name="to"
        value={filtres.to ?? ""}
        class="rounded border border-bo-border px-3 py-2 text-sm"
      />
    </label>
    {estProprietaire && (
      <label>
        <span class="mb-1 block text-xs text-bo-muted">Étiquette</span>
        <select
          name="tag"
          class="rounded border border-bo-border px-3 py-2 text-sm"
        >
          <option value="">Toutes</option>
          {etiquettes.map((t) => (
            <option value={t.name} selected={filtres.tag === t.name}>
              {t.name} ({t.n})
            </option>
          ))}
        </select>
      </label>
    )}

    <details class="bo-menu relative">
      <summary class="rounded border border-bo-border px-3 py-2 text-sm">
        Statuts
        {(paiementCoches.length || traitementCoches.length) > 0 && (
          <span class="ml-1 text-bo-muted">
            ({paiementCoches.length + traitementCoches.length})
          </span>
        )}
      </summary>
      <div
        class="absolute right-0 z-20 mt-1 w-64 rounded-lg border border-bo-border bg-bo-surface p-3 shadow-lg"
      >
        <p class="mb-1 text-xs font-medium text-bo-muted">Statut</p>
        {FILTRES_ETAPE.map(([v, l]) => (
          <label class="flex items-center gap-2 py-0.5 text-sm">
            <input type="checkbox" name="etape" value={v} checked={traitementCoches.includes(v)} />
            {l}
          </label>
        ))}
        <p class="mt-2 mb-1 text-xs font-medium text-bo-muted">Remboursement</p>
        {FILTRES_PAIEMENT.map(([v, l]) => (
          <label class="flex items-center gap-2 py-0.5 text-sm">
            <input
              type="checkbox"
              name="financial"
              value={v}
              checked={paiementCoches.includes(v!)}
            />
            {l}
          </label>
        ))}
      </div>
    </details>

    <button class="rounded bg-bo-nav px-4 py-2 text-sm text-white">
      Filtrer
    </button>
    {filtreActif && (
      <a
        href={lienAvec({
          q: null,
          tag: null,
          from: null,
          to: null,
          financial: null,
          fulfillment: null,
          etape: null,
        })}
        class="px-2 py-2 text-sm text-bo-accent hover:underline"
      >
        Effacer
      </a>
    )}
    <a
      href={lienExport}
      class="ml-auto rounded border border-bo-border px-3 py-2 text-sm hover:bg-bo-bg"
    >
      Exporter en CSV
    </a>
  </form>

  {/* Barre d'actions groupées : n'apparaît qu'une fois des cases cochées. */}
  <form method="POST" id="bo-masse" class="hidden border-t border-bo-border bg-bo-bg px-4 py-2">
    <input type="hidden" name="_action" value="masse" />
    <input type="hidden" name="ids" id="bo-ids" />
    <input type="hidden" name="bulk" id="bo-bulk" />
    <input type="hidden" name="tags" id="bo-tags" />
    <div class="flex flex-wrap items-center gap-2 text-sm">
      <span id="bo-compte" class="font-medium"></span>
      {estProprietaire && (
        <>
          <button
            type="button"
            data-bulk="etape-suivante"
            data-confirme={
              channel === "salon"
                ? "Passer les ventes cochées à l'étape suivante ? Aucun courriel ne part : le client est sur place."
                : "Passer les commandes cochées à l'étape suivante ? Celles qui passent à « Envoyée » ou « Prête à retirer » préviennent leur client par courriel (sans numéro de suivi : pour un colis suivi, passez par sa fiche)."
            }
            class="rounded border border-bo-border bg-bo-surface px-3 py-1.5 hover:bg-bo-bg"
          >
            Étape suivante
          </button>
          <button type="button" data-bulk="tag" class="rounded border border-bo-border bg-bo-surface px-3 py-1.5 hover:bg-bo-bg">
            Ajouter une étiquette
          </button>
          <button type="button" data-bulk="untag" class="rounded border border-bo-border bg-bo-surface px-3 py-1.5 hover:bg-bo-bg">
            Retirer une étiquette
          </button>
        </>
      )}
      <button type="button" id="bo-bons" class="rounded border border-bo-border bg-bo-surface px-3 py-1.5 hover:bg-bo-bg">
        Bons de livraison
      </button>
      <button type="button" id="bo-export" class="rounded border border-bo-border bg-bo-surface px-3 py-1.5 hover:bg-bo-bg">
        Exporter la sélection
      </button>
      {!estProprietaire ? null : vueArchivees ? (
        <>
          <button
            type="button"
            data-bulk="restaurer"
            class="ml-auto rounded border border-bo-border bg-bo-surface px-3 py-1.5 hover:bg-bo-bg"
          >
            Restaurer
          </button>
          {/* Le ménage pour de bon, depuis la liste (18/11). */}
          <button
            type="button"
            data-bulk="supprimer"
            data-confirme="Supprimer DÉFINITIVEMENT les commandes cochées ? C'est sans retour : elles partent avec leurs lignes et leur journal. Seuls les paniers et les commandes jamais encaissées partent : une commande payée, facturée, remboursée ou expédiée reste archivée (elle doit être gardée), et le message vous le dira."
            class="rounded border border-red-300 bg-bo-surface px-3 py-1.5 text-red-700 hover:bg-red-50"
          >
            Supprimer définitivement
          </button>
        </>
      ) : (
        <>
        {/* Supprimer sans archiver d'abord (19/11). L'API garde ce qui doit
            l'être (commandes du site payées, facturées, remboursées…) et le
            message dit pourquoi ; une vente du stand part, même payée. */}
        <button
          type="button"
          data-bulk="supprimer"
          data-confirme={channel === "salon"
            ? "Supprimer DÉFINITIVEMENT les ventes cochées ? C'est sans retour : elles partent avec leurs lignes, leur journal et leurs fichiers d'impression."
            : "Supprimer DÉFINITIVEMENT les commandes cochées ? C'est sans retour. Seuls les paniers et les commandes jamais payées partent : une commande payée en ligne, facturée, remboursée ou expédiée est gardée, et le message vous le dira."}
          class="ml-auto rounded border border-red-300 bg-bo-surface px-3 py-1.5 text-red-700 hover:bg-red-50"
        >
          Supprimer définitivement
        </button>
        {/* Au stand, plus d'archivage (19/11) : on annule, ou on supprime. */}
        {channel !== "salon" && (
        <button
          type="button"
          data-bulk="archiver"
          data-confirme="Archiver les commandes sélectionnées ? Elles quittent cette liste et l'export, et se rangent dans l'onglet « Archivées », d'où elles se restaurent. La recherche continue de les trouver, marquées « Archivée ». Rien n'est effacé, et leur statut ne change pas : une vente archivée compte toujours dans vos chiffres. Pour qu'elle cesse d'y compter, annulez-la plutôt."
          class="rounded border border-bo-border bg-bo-surface px-3 py-1.5 hover:bg-bo-bg"
        >
          Archiver
        </button>
        )}
        </>
      )}
    </div>
  </form>

  {/* Les PDF d'impression, téléchargés depuis la liste (lib/impression-bo.ts).
      Rien ne s'y prépare d'office : la liste montre des commandes parties
      depuis longtemps ; un clic sur un fichier pas encore prêt le prépare, et
      le téléchargement part tout seul. */}
  <div
    class="overflow-x-auto"
    data-impression
    data-url-etat={apiUrl("/admin/print-files/etat")}
  >
    <p
      data-pdf-alerte
      hidden
      class="border-b border-bo-border bg-amber-50 px-4 py-2 text-xs text-amber-900"
    />
    <table class="w-full text-sm">
      <thead class="bg-bo-bg text-left text-bo-muted">
        <tr>
          <th class="w-8 px-3 py-2">
            <input type="checkbox" id="bo-tout" aria-label="Tout cocher" />
          </th>
          <th class="px-4 py-2 font-medium">Commande</th>
          <th class="px-4 py-2 font-medium">Date</th>
          <th class="px-4 py-2 font-medium">Client</th>
          <th class="px-4 py-2 font-medium">Statut</th>
          <th class="px-4 py-2 font-medium">Articles</th>
          {/* Des boutons, pas une valeur : rien à trier dans cette colonne. */}
          <th class="px-2 py-2 font-medium" data-sans-tri>Impression</th>
          <th class="px-4 py-2 font-medium">Livraison</th>
          {estProprietaire && <th class="px-4 py-2 font-medium">Étiquettes</th>}
          <th class="px-4 py-2 font-medium text-right">Total</th>
        </tr>
      </thead>
      <tbody>
        {orders.map((o) => {
          const p = BADGE_PAIEMENT[o.statutFinancier ?? "pending"] ?? {
            texte: o.status,
            classe: "bg-bo-bg text-bo-muted",
          };
          const t = BADGE_TRAITEMENT[o.statutExpedition ?? "unfulfilled"]!;
          const statut = statutDeLaLigne(o);
          const remb =
            o.statutFinancier === "refunded" || o.statutFinancier === "partially_refunded"
              ? BADGE_PAIEMENT[o.statutFinancier]!
              : null;
          return (
            <tr class="border-t border-bo-border hover:bg-bo-bg/50">
              <td class="px-3 py-2 align-top">
                <input type="checkbox" class="bo-coche" value={o.id} />
              </td>
              <td class="px-4 py-2 whitespace-nowrap align-top">
                <a
                  href={url(`/commandes/${o.id}`)}
                  class="font-medium text-bo-accent hover:underline"
                >
                  {o.number}
                </a>
              </td>
              <td
                class="px-4 py-2 whitespace-nowrap align-top text-bo-muted"
                data-tri={o.createdAt ?? ""}
              >
                {quand(o.createdAt)}
              </td>
              <td class="px-4 py-2 align-top">
                {o.customerName ? (
                  <>
                    <div>{o.customerName}</div>
                    {o.customerEmail && (
                      <div class="text-xs text-bo-muted">{o.customerEmail}</div>
                    )}
                  </>
                ) : (
                  <span class="text-bo-muted">Aucun client</span>
                )}
              </td>
              <td class="px-4 py-2 align-top">
                {/* UN statut (17/11) : l'étape de traitement, comme sur la
                    fiche. Une reprise de Shopify garde son ancien libellé. */}
                {statut ? (
                  <span
                    class={`inline-flex items-center gap-1.5 rounded-full px-2 py-0.5 text-xs ${statut.classe}`}
                  >
                    <span class="h-1.5 w-1.5 rounded-full bg-current opacity-70" />
                    {statut.texte}
                  </span>
                ) : (
                  <span
                    class={`inline-flex items-center gap-1.5 rounded-full px-2 py-0.5 text-xs ${p.classe}`}
                  >
                    <span class="h-1.5 w-1.5 rounded-full bg-current opacity-70" />
                    {p.texte} · {t.texte}
                  </span>
                )}
                {remb && (
                  <span class={`mt-1 block w-fit rounded-full px-2 py-0.5 text-xs ${remb.classe}`}>
                    {remb.texte}
                  </span>
                )}
                {/* Une vente du stand pas encore réglée (17/11) : Margaux la
                    marque payée d'ici, sans ouvrir la fiche. */}
                {estProprietaire && channel === "salon" && o.etapeTraitement === "a_encaisser" && (
                  <form method="POST" action={url(`/commandes/${o.id}`)} class="mt-1">
                    <input type="hidden" name="_action" value="encaisser" />
                    <input type="hidden" name="moyen" value="sur_place" />
                    <button class="rounded border border-bo-border px-2 py-0.5 text-xs hover:bg-bo-bg">
                      Marquer payée
                    </button>
                  </form>
                )}
                {/* L'étape d'après, d'un clic : l'action du matin. */}
                {estProprietaire && statut?.suivante && (
                  <form
                    method="POST"
                    class="mt-1"
                    data-confirmer={
                      statut.suivante.courrier
                        ? `${o.number} → « ${statut.suivante.libelle} » ? ${statut.suivante.courrier}`
                        : undefined
                    }
                  >
                    <input type="hidden" name="_action" value="etape" />
                    <input type="hidden" name="id" value={o.id} />
                    <input type="hidden" name="numero" value={o.number} />
                    <input type="hidden" name="etape" value={statut.suivante.etape} />
                    <button
                      class="rounded border border-bo-border px-2 py-0.5 text-xs hover:bg-bo-bg"
                      title={statut.suivante.courrier ?? "Aucun courriel."}
                    >
                      → {statut.suivante.libelle}
                      {statut.suivante.courrier ? " ✉" : ""}
                    </button>
                  </form>
                )}
                {/* Une vente du stand (19/11) : Margaux l'annule si le client
                    ne paie pas, ou la supprime (essais), sans ouvrir la fiche. */}
                {estProprietaire && channel === "salon" && !o.number?.startsWith("SHOP-") && o.etapeTraitement !== "annulee" && o.etapeTraitement !== "panier" && (
                  <details class="mt-1">
                    <summary class="w-fit cursor-pointer rounded border border-bo-border px-2 py-0.5 text-xs text-bo-muted hover:bg-bo-bg">
                      Annuler…
                    </summary>
                    <form
                      method="POST"
                      class="mt-1 flex flex-wrap items-center gap-1"
                      data-confirmer={`Annuler la vente ${o.number} ? Elle reste lisible mais ne compte plus dans vos chiffres. Aucun courriel n'est envoyé.`}
                    >
                      <input type="hidden" name="_action" value="annuler-vente" />
                      <input type="hidden" name="id" value={o.id} />
                      <select name="motif" class="rounded border border-bo-border px-1 py-0.5 text-xs">
                        <option value="impaye">Pas payée</option>
                        <option value="saisie">Erreur de saisie</option>
                        <option value="cliente">Le client a renoncé</option>
                        <option value="autre">Autre</option>
                      </select>
                      <button class="rounded border border-amber-400 px-2 py-0.5 text-xs text-amber-900 hover:bg-amber-50">
                        Annuler la vente
                      </button>
                    </form>
                  </details>
                )}
                {estProprietaire && channel === "salon" && !o.number?.startsWith("SHOP-") && o.etapeTraitement !== "panier" && (
                  <form
                    method="POST"
                    class="mt-1"
                    data-confirmer={`Supprimer DÉFINITIVEMENT la vente ${o.number} ? C'est sans retour : elle part avec ses lignes, son journal et son fichier d'impression.`}
                  >
                    <input type="hidden" name="_action" value="supprimer-vente" />
                    <input type="hidden" name="id" value={o.id} />
                    <input type="hidden" name="numero" value={o.number} />
                    <button class="rounded border border-red-300 px-2 py-0.5 text-xs text-red-700 hover:bg-red-50">
                      Supprimer
                    </button>
                  </form>
                )}
                {/* Payée avec les clés d'essai alors que la boutique encaisse
                    pour de vrai : sans ce mot, elle passe pour une vente. */}
                {o.payeeEnEssai && (
                  <span
                    class="mt-1 block w-fit rounded-full bg-amber-100 px-2 py-0.5 text-xs font-medium text-amber-900"
                    title="Payée avec les clés d'essai (Stripe test ou PayPal sandbox) : aucun argent reçu."
                  >
                    En ESSAI
                  </span>
                )}
              </td>
              <td class="px-4 py-2 whitespace-nowrap align-top text-bo-muted">
                {/* Les affiches elles-mêmes, en vignettes, comme dans le
                    panier (demande de la boutique). Rendues par le moteur du
                    fichier d'impression ; chargées au fil du défilement.

                    Au survol d'une vignette, ou au clavier quand le lien a
                    le focus, elle grandit sur place (`bo-vignette`, cf.
                    ApercuFlottant) : on reconnaît l'affiche sans ouvrir la commande.

                    Une ligne sans aperçu possible (commande importée) montre
                    « Aperçu indisponible » à sa place. Avant, l'image
                    disparaissait : la commande semblait avoir une affiche de
                    moins, et le « +N » ne tombait plus juste. */}
                {(o.apercus?.length ?? 0) > 0 && (
                  <a
                    href={url(`/commandes/${o.id}`)}
                    class="bo-vignettes mb-1 flex items-center gap-1"
                    title="Ouvrir la commande"
                    aria-label={`Ouvrir la commande ${o.number}`}
                  >
                    {o.apercus!.map((a) => (
                      <img
                        src={apiUrl(a)}
                        alt=""
                        loading="lazy"
                        width="34"
                        height="48"
                        class="bo-vignette h-12 w-[34px] rounded-sm border border-bo-border bg-bo-bg object-cover"
                        onerror="this.replaceWith(Object.assign(document.createElement('span'),{className:'inline-flex h-12 w-[34px] items-center justify-center rounded-sm border border-dashed border-bo-border bg-bo-bg px-0.5 text-center text-[8px] leading-tight text-bo-muted',textContent:'Aperçu indisponible'}))"
                      />
                    ))}
                    {(o.lignes ?? 0) > o.apercus!.length && (
                      <span class="text-xs">+{(o.lignes ?? 0) - o.apercus!.length}</span>
                    )}
                  </a>
                )}
                {o.articles ?? 0} article{(o.articles ?? 0) > 1 ? "s" : ""}
                {(o.expedies ?? 0) > 0 && (o.expedies ?? 0) < (o.articles ?? 0) && (
                  <span class="text-xs"> · {o.expedies} parti(s)</span>
                )}
              </td>
              <td class="px-2 py-2 align-top">
                {/* Les PDF d'impression sans ouvrir la commande (demande de la
                    boutique) : « PDF » pour une affiche seule, sinon un bouton
                    par affiche — « 1 », « 2 »…, dans l'ordre des vignettes —
                    et « Tout » pour l'archive. Seulement une fois payée, comme
                    sur la fiche. */}
                {o.status === "paid" && (o.affiches?.length ?? 0) > 0 ? (
                  <div
                    data-pdf-groupe
                    class={(o.affiches?.length ?? 0) > 1 ? "min-w-[8rem]" : undefined}
                  >
                    {/* Assez large pour « 1 » et « 2 » côte à côte, « Tout »
                        dessous : sinon le tableau, plus large que l'écran,
                        les empile un par ligne. Une affiche seule n'a que
                        « PDF », qui n'a pas besoin de place en plus. */}
                    <div class="flex flex-wrap items-center gap-1">
                      {o.affiches!.map((a, i) => {
                        const nom =
                          o.affiches!.length > 1
                            ? `Affiche ${i + 1} (${a.titre ?? "affiche personnalisée"}${a.format ? `, ${a.format}` : ""})`
                            : `${a.titre ?? "Affiche personnalisée"}${a.format ? ` (${a.format})` : ""}`;
                        return (
                          <a
                            href={apiUrl(`/admin/print-files/${a.id}`)}
                            download
                            data-pdf-ligne={a.id}
                            data-pdf-nom={nom}
                            data-pdf-court={o.affiches!.length > 1 ? `Affiche ${i + 1}` : "PDF"}
                            title={`${nom} : télécharger le PDF d'impression`}
                            aria-label={`${nom} : télécharger le PDF d'impression`}
                            class="bo-pdf bo-pdf-bouton"
                          >
                            <svg aria-hidden="true" viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v8M4.5 6.5 8 10l3.5-3.5M2.5 13.5h11" /></svg>
                            {o.affiches!.length > 1 ? i + 1 : "PDF"}
                          </a>
                        );
                      })}
                      {o.affiches!.length > 1 && (
                        <a
                          href={apiUrl(`/admin/orders/${o.id}/impression.zip`)}
                          download
                          data-pdf-tout
                          data-pdf-lignes={o.affiches!.map((a) => a.id).join(",")}
                          title={`Tout télécharger : les ${o.affiches!.length} PDF de la commande dans une archive .zip`}
                          aria-label={`Tout télécharger : les ${o.affiches!.length} PDF de la commande dans une archive .zip`}
                          class="bo-pdf bo-pdf-bouton"
                        >
                          <svg aria-hidden="true" viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v8M4.5 6.5 8 10l3.5-3.5M2.5 13.5h11" /></svg>
                          Tout
                        </a>
                      )}
                    </div>
                    <div data-pdf-messages class="bo-pdf-messages" aria-live="polite" />
                  </div>
                ) : (
                  <span class="text-bo-muted">—</span>
                )}
              </td>
              <td class="px-4 py-2 align-top text-bo-muted">
                {o.shippingLabel ?? "—"}
              </td>
              {estProprietaire && (
              <td class="px-4 py-2 align-top">
                {(o.tags ?? []).length ? (
                  <span class="flex flex-wrap gap-1">
                    {(o.tags ?? []).map((tag) => (
                      <a
                        href={lienAvec({ tag })}
                        class="rounded bg-bo-bg px-1.5 py-0.5 text-xs text-bo-muted hover:text-bo-ink"
                      >
                        {tag}
                      </a>
                    ))}
                  </span>
                ) : (
                  <span class="text-bo-muted">—</span>
                )}
              </td>
              )}
              <td class="px-4 py-2 text-right whitespace-nowrap align-top">
                {formatPrice(o.totalCents)}
                {(o.rembourseCents ?? 0) > 0 && (
                  <div class="text-xs text-violet-700">
                    − {formatPrice(o.rembourseCents ?? 0)} remboursé
                  </div>
                )}
              </td>
            </tr>
          );
        })}
        {orders.length === 0 && !error && (
          <tr>
            <td colspan={estProprietaire ? 11 : 10} class="px-4 py-6 text-center text-bo-muted">
              Aucune commande pour ces filtres.
            </td>
          </tr>
        )}
      </tbody>
    </table>
  </div>
</section>
<p class="mt-2 text-sm text-bo-muted">{orders.length} commande(s) affichée(s).</p>

{/* Les PDF d'impression de la colonne « Impression ». */}
<script>
  import "../lib/impression-bo.ts";
</script>

{/* La vignette en grand, au survol ou au clavier : cf. ApercuFlottant. */}
<ApercuFlottant />

<script is:inline define:vars={{ exportBase: lienExport, bonsBase: url("/commandes/bons") }}>
  // Sélection multiple : la barre d'actions n'existe que quand elle sert.
  const tout = document.getElementById("bo-tout");
  const cases = () => [...document.querySelectorAll(".bo-coche")];
  const barre = document.getElementById("bo-masse");
  const compte = document.getElementById("bo-compte");

  function selection() {
    return cases()
      .filter((c) => c.checked)
      .map((c) => c.value);
  }

  function rafraichir() {
    const n = selection().length;
    barre.classList.toggle("hidden", n === 0);
    compte.textContent = `${n} commande${n > 1 ? "s" : ""} sélectionnée${n > 1 ? "s" : ""}`;
    if (tout) tout.checked = n > 0 && n === cases().length;
  }

  tout?.addEventListener("change", () => {
    cases().forEach((c) => (c.checked = tout.checked));
    rafraichir();
  });
  cases().forEach((c) => c.addEventListener("change", rafraichir));

  // « → Envoyée ✉ » d'une ligne : l'étape qui écrit au client se confirme.
  document.querySelectorAll("form[data-confirmer]").forEach((f) => {
    f.addEventListener("submit", (e) => {
      if (!confirm(f.getAttribute("data-confirmer"))) e.preventDefault();
    });
  });

  // Les actions qui écrivent passent par le formulaire (POST), les autres
  // ouvrent simplement une URL avec les identifiants cochés.
  document.querySelectorAll("[data-bulk]").forEach((b) => {
    b.addEventListener("click", () => {
      const ids = selection();
      if (!ids.length) return;
      const quoi = b.dataset.bulk;
      // Une action qui retire des commandes de la liste s'annonce, et dit ce
      // qu'elle change — et ce qu'elle ne change pas.
      const avertissement = b.dataset.confirme;
      if (avertissement && !confirm(avertissement)) return;
      if (quoi === "tag" || quoi === "untag") {
        const saisie = prompt(
          quoi === "tag"
            ? "Étiquette(s) à ajouter, séparées par des virgules :"
            : "Étiquette(s) à retirer, séparées par des virgules :",
        );
        if (!saisie) return;
        document.getElementById("bo-tags").value = saisie;
      }
      document.getElementById("bo-ids").value = ids.join(",");
      document.getElementById("bo-bulk").value = quoi;
      barre.submit();
    });
  });

  document.getElementById("bo-export")?.addEventListener("click", () => {
    const ids = selection();
    if (!ids.length) return;
    window.location.href = `${exportBase}&ids=${ids.join(",")}`;
  });

  document.getElementById("bo-bons")?.addEventListener("click", () => {
    const ids = selection();
    if (!ids.length) return;
    window.open(`${bonsBase}?ids=${ids.join(",")}`, "_blank");
  });

  rafraichir();
</script>
