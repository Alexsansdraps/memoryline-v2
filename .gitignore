# Le rangement privé du serveur : les bordereaux transporteur — qui portent
# une adresse cliente et un code-barres payé — et les identifiants qu'Alexandra
# pose elle-même depuis le back-office. Ce dépôt est PUBLIC : ni les uns ni les
# autres n'y entrent, jamais, même par mégarde.
data/prive/

# Turborepo
.turbo
# Drizzle
.drizzle

# Dumps pg locaux (sauvegardes, ne pas versionner)
data/backups/

# Les sauvegardes locales du serveur : la base et les fichiers téléversés.
# Jamais versionnées, jamais dans une archive de déploiement.
sauvegardes/

