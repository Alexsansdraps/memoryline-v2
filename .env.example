# Base de données.
#  - vide ou absent : Postgres local du docker-compose (port hôte 5433)
#  - renseigné      : base hébergée ailleurs (Neon, Supabase, Render…).
#    Penser à ?sslmode=require, exigé par la plupart des hébergeurs.
DATABASE_URL="postgres://memoryline:memoryline@localhost:5433/memoryline"

# API
API_PORT=3000

# Chemin de l'export Shopify à importer (gitignored, cf. data/exports/)
IMPORT_DIR="./data/exports/shopify-2026-06-19"

# --- Paiement (canal web) -------------------------------------------------
# Laisser vide = moyen de paiement désactivé (le checkout le signale, la
# commande reste "pending"). Utiliser les clés de TEST tant qu'on développe.
#
# Stripe (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=""            # sk_test_… (serveur)
STRIPE_WEBHOOK_SECRET=""        # whsec_… (Dashboard > Webhooks, ou `stripe listen`)
PUBLIC_STRIPE_KEY=""            # pk_test_… (navigateur ; exposé au client)
#
# PayPal (https://developer.paypal.com/dashboard/applications/sandbox)
PAYPAL_CLIENT_ID=""             # serveur
PAYPAL_SECRET=""                # serveur
PAYPAL_ENV="sandbox"            # "sandbox" (test) ou "live" (prod)
PUBLIC_PAYPAL_CLIENT_ID=""      # navigateur (= PAYPAL_CLIENT_ID, exposé au client)

# --- Environnement de test (tunnel ngrok) ---------------------------------
# Jeton du compte ngrok (dashboard.ngrok.com > Your Authtoken).
NGROK_AUTHTOKEN=""
# Domaine statique offert par le plan gratuit (dashboard.ngrok.com > Domains),
# SANS le https:// — ex. "memoryline.ngrok-free.app".
NGROK_DOMAIN=""
# Origine publique = https:// + le domaine ci-dessus. Sert au canonical, aux
# balises Open Graph et à la liste CORS de l'API.
PUBLIC_ORIGIN=""
